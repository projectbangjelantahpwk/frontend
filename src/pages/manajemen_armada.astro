        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase mb-1"
            >Tanggal Service</label
          >
          <input
            type="date"
            id="srv_tgl"
            class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-blue-600 font-medium"
            required
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase mb-1"
            >Nama Bengkel</label
          >
          <input
            type="text"
            id="srv_bengkel"
            class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-blue-600"
            required
            placeholder="Contoh: Auto 2000 / Bengkel Jaya"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase mb-1"
            >Detail Perbaikan</label
          >
          <textarea
            id="srv_detail"
            rows="2"
            class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-blue-600"
            required
            placeholder="Contoh: Ganti oli mesin, ganti kampas rem depan..."
          ></textarea>
        </div>

        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase mb-1"
            >Total Biaya (Rp)</label
          >
          <input
            type="number"
            id="srv_biaya"
            min="0"
            class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-blue-600 font-mono font-bold text-gray-900"
            required
            placeholder="0"
          />
        </div>

        <!-- 🔥 TAMBAHAN: BLOK INTEGRASI KEUANGAN 🔥 -->
        <div class="border-t border-gray-200 mt-4 pt-4">
          <p
            class="text-xs font-bold text-blue-600 mb-3 uppercase flex items-center gap-1"
          >
            <i class="bi bi-wallet2"></i> Integrasi Keuangan (Opsional)
          </p>
          <label
            class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer mb-3 bg-blue-50/50 p-2 rounded-lg border border-blue-100"
          >
            <input
              type="checkbox"
              id="srv_integrasi"
              class="accent-blue-600 w-4 h-4"
              onchange="window.toggleIntegrasiKeuangan()"
            />
            <span class="font-semibold text-blue-900"
              >Masukkan ke tagihan Pengeluaran Ops</span
            >
          </label>

          <div
            id="container-integrasi-keuangan"
            class="hidden space-y-3 bg-gray-50 p-3 rounded-xl border border-gray-200"
          >
            <div>
              <label
                class="block text-[10px] font-bold text-gray-500 uppercase mb-1"
                >Siapa yang mengajukan/membawa uang?</label
              >
              <select
                id="srv_pengaju"
                class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600 font-medium"
              ></select>
            </div>
            <div>
              <label
                class="block text-[10px] font-bold text-gray-500 uppercase mb-1"
                >Sumber Dana</label
              >
              <select
                id="srv_sumber_dana"
                class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600 font-medium"
              >
                <option value="Uang Keuangan">Uang Keuangan</option>
                <option value="Uang Gudang">Uang Gudang</option>
              </select>
              <p class="text-[9px] text-gray-400 mt-1.5 italic leading-tight">
                *Catatan: Tagihan akan dikirim ke menu Pengeluaran dengan status
                "Menunggu" (Pending) agar bisa di-ACC oleh Keuangan terlebih
                dahulu.
              </p>
            </div>
          </div>
        </div>

        <div class="pt-2">
          <button
            type="submit"
            id="btn-save-service"
            class="w-full bg-blue-600 text-white font-bold py-3 rounded-xl hover:bg-blue-700 transition shadow-sm active:scale-95"
            >Simpan Riwayat Service</button
          >
        </div>
      </form>
    </div>
  </div>
  <script>
    import { uploadImageToImgbb } from "../lib/imgbb.js";
    // @ts-ignore
    window.uploadImageToImgbb = uploadImageToImgbb;
  </script>

  <script is:inline>
    // ==========================================
    // 1. INIT & GATEKEEPER
    // ==========================================
    document.addEventListener("DOMContentLoaded", async () => {
      if (!window.supabase)
        return console.error("Supabase Client tidak ditemukan!");

      const allowedRoles = ["owner", "hrd", "admin", "it"];
      const {
        data: { session },
      } = await window.supabase.auth.getSession();

      if (!session) return window.location.replace("/");
      const { data: prof } = await window.supabase
        .from("profiles")
        .select("role, nama")
        .eq("id", session.user.id)
        .single();

      if (!allowedRoles.includes(prof?.role)) {
        alert(`Akses Ditolak!`);
        return window.location.replace("/");
      }

      document.body.style.display = "block";

      // Setup Calendar Default
      const now = new Date();
      const yyyy = now.getFullYear();
      const mm = String(now.getMonth() + 1).padStart(2, "0");
      document.getElementById("filter-bulan-cek-mobil").value = `${yyyy}-${mm}`;
      document.getElementById("filter-bulan-cek-motor").value = `${yyyy}-${mm}`;

      // Tarik Semua Data
      await loadMobil();
      await loadMotor();
      await loadPengecekan();
      await loadPengecekanMotor();

      // Setup Filter Bulan Service & Tarik Datanya
      document.getElementById("filter-bulan-service").value = `${yyyy}-${mm}`;
      await loadService();

      // Pasang Formatter Plat
      setupPlatFormatter("mob_plat");
      setupPlatFormatter("mot_plat");
    });

    // ==========================================
    // 2. UI HELPERS (TABS & MODALS)
    // ==========================================
    window.switchTab = function (tabId) {
      [
        "armada-mobil",
        "armada-motor",
        "pengecekan-mobil",
        "pengecekan-motor",
        "service",
      ].forEach((id) => {
        document
          .getElementById(`tab-${id}`)
          .classList.remove("text-primary", "border-primary");
        document
          .getElementById(`tab-${id}`)
          .classList.add("text-on-surface-variant", "border-transparent");
        document.getElementById(`content-${id}`).classList.remove("active");
      });
      document
        .getElementById(`tab-${tabId}`)
        .classList.remove("text-on-surface-variant", "border-transparent");
      document
        .getElementById(`tab-${tabId}`)
        .classList.add("text-primary", "border-primary");
      document.getElementById(`content-${tabId}`).classList.add("active");
    };

    window.openModal = function (id) {
      const m = document.getElementById(id);
      if (!m) return;
      m.classList.remove("hidden");
      m.classList.add("flex");
      setTimeout(() => {
        m.classList.remove("opacity-0");
        m.querySelector("div").classList.remove("scale-95");
      }, 10);
    };

    window.closeModal = function (id) {
      const m = document.getElementById(id);
      m.classList.add("opacity-0");
      m.querySelector("div").classList.add("scale-95");
      setTimeout(() => {
        m.classList.add("hidden");
        m.classList.remove("flex");
      }, 300);
    };

    window.setupPlatFormatter = function (inputId) {
      const input = document.getElementById(inputId);
      if (input) {
        input.addEventListener("input", function (e) {
          let val = this.value.toUpperCase().replace(/[^A-Z0-9]/g, "");
          let result = "";
          const kodeWilayah = val.match(/^[A-Z]{1,2}/);
          if (kodeWilayah) {
            result += kodeWilayah[0];
            val = val.substring(kodeWilayah[0].length);
            const nomorPolisi = val.match(/^[0-9]{1,4}/);
            if (nomorPolisi) {
              result += " " + nomorPolisi[0];
              val = val.substring(nomorPolisi[0].length);
              const kodeSeri = val.match(/^[A-Z]{1,3}/);
              if (kodeSeri) result += " " + kodeSeri[0];
            }
          } else result = val;
          this.value = result;
        });
      }
    };

    window.kompresGambar = function (file, maxWidth = 800, quality = 0.7) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = function (event) {
          const img = new Image();
          img.src = event.target.result;
          img.onload = function () {
            const canvas = document.createElement("canvas");
            let width = img.width,
              height = img.height;
            if (width > maxWidth) {
              height = Math.round((height * maxWidth) / width);
              width = maxWidth;
            }
            canvas.width = width;
            canvas.height = height;
            canvas.getContext("2d").drawImage(img, 0, 0, width, height);
            canvas.toBlob(
              (blob) => {
                if (blob)
                  resolve(
                    new File(
                      [blob],
                      file.name.replace(/\.[^/.]+$/, "") + ".jpg",
                      { type: "image/jpeg", lastModified: Date.now() },
                    ),
                  );
                else reject(new Error("Gagal kompresi"));
              },
              "image/jpeg",
              quality,
            );
          };
          img.onerror = reject;
        };
        reader.onerror = reject;
      });
    };

    // ==========================================
    // 3. LOGIKA MOBIL (Data & Upload)
    // ==========================================
    window.allMobilData = [];

    // Setup Drag & Drop Mobil
    const setupUploaderMobil = () => {
      const dz = document.getElementById("dropZoneMobil"),
        fi = document.getElementById("mob_foto_file"),
        fn = document.getElementById("fileNameMobil"),
        pr = document.getElementById("previewMobil"),
        ph = document.getElementById("dropZonePlaceholder"),
        bh = document.getElementById("btnHapusPreview");
      if (dz && fi) {
        dz.addEventListener("click", () => fi.click());
        fi.addEventListener("change", (e) => {
          const file = e.target.files[0];
          if (file) {
            fn.innerText = "✓ Siap diupload: " + file.name;
            dz.classList.add("border-primary", "border-solid");
            dz.classList.remove("border-dashed", "border-gray-300");
            const reader = new FileReader();
            reader.onload = (ev) => {
              pr.src = ev.target.result;
              pr.classList.remove("hidden");
              ph.classList.add("hidden");
              bh.classList.remove("hidden");
            };
            reader.readAsDataURL(file);
          } else window.resetPreviewMobil();
        });
        window.resetPreviewMobil = function () {
          fi.value = "";
          fn.innerText = "";
          pr.src = "";
          pr.classList.add("hidden");
          ph.classList.remove("hidden");
          bh.classList.add("hidden");
          dz.classList.remove("border-primary", "border-solid");
          dz.classList.add("border-gray-300", "border-dashed");
        };
        if (bh)
          bh.addEventListener("click", (e) => {
            e.stopPropagation();
            window.resetPreviewMobil();
          });
      }
    };
    setupUploaderMobil();

    window.loadMobil = async function () {
      try {
        const { data, error } = await window.supabase
          .from("mobil")
          .select("*")
          .eq("is_active", true)
          .order("nama_kendaraan");
        if (error) throw error;
        const tbody = document.getElementById("tbody-mobil");
        if (!data || data.length === 0) {
          tbody.innerHTML =
            '<tr><td colspan="5" class="p-4 text-center text-gray-400">Belum ada armada mobil.</td></tr>';
          return;
        }

        window.allMobilData = data;
        tbody.innerHTML = data
          .map(
            (m) => `
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="p-3 text-center" data-label="Foto">${m.foto_kendaraan ? `<img src="${m.foto_kendaraan}" class="w-12 h-12 object-cover rounded-md mx-auto">` : `<div class="w-12 h-12 bg-gray-200 rounded-md mx-auto flex items-center justify-center text-gray-400"><i class="bi bi-car-front-fill"></i></div>`}</td>
                        <td class="p-3 font-mono font-bold text-gray-900" data-label="Plat Nomor"><span class="bg-gray-200 px-2 py-1 rounded text-sm">${m.plat_nomor}</span></td>
                        <td class="p-3 font-bold text-primary" data-label="Nama Kendaraan">${m.nama_kendaraan}</td>
                        <td class="p-3 text-gray-600" data-label="Jenis">${m.jenis_kendaraan}</td>
                        <td class="p-3 text-right" data-label="Aksi">
                            <div class="flex gap-2 justify-end">
                                <button onclick="window.editMobil('${m.id}')" class="bg-blue-50 text-blue-600 p-2 rounded hover:bg-blue-100 transition"><i class="bi bi-pencil-square"></i></button>
                                <button onclick="window.hapusMobil('${m.id}', '${m.nama_kendaraan}')" class="bg-red-50 text-red-600 p-2 rounded hover:bg-red-100 transition"><i class="bi bi-trash3"></i></button>
                            </div>
                        </td>
                    </tr>`,
          )
          .join("");
      } catch (e) {
        console.error(e);
      }
    };

    window.bukaModalTambahMobil = function () {
      document.getElementById("form-mobil").reset();
      document.getElementById("edit_mobil_id").value = "";
      document.querySelector("#modal-tambah-mobil h3").innerText =
        "Registrasi Mobil Baru";
      if (window.resetPreviewMobil) window.resetPreviewMobil();
      window.openModal("modal-tambah-mobil");
    };

    window.editMobil = function (id) {
      const m = window.allMobilData.find((x) => String(x.id) === String(id));
      if (!m) return;
      document.getElementById("edit_mobil_id").value = m.id;
      document.getElementById("mob_plat").value = m.plat_nomor;
      document.getElementById("mob_nama").value = m.nama_kendaraan;
      document.getElementById("mob_jenis").value = m.jenis_kendaraan;
      document.querySelector("#modal-tambah-mobil h3").innerText =
        "Edit Data Mobil";
      if (window.resetPreviewMobil) window.resetPreviewMobil();
      if (m.foto_kendaraan) {
        const pr = document.getElementById("previewMobil"),
          ph = document.getElementById("dropZonePlaceholder"),
          bh = document.getElementById("btnHapusPreview"),
          dz = document.getElementById("dropZoneMobil");
        pr.src = m.foto_kendaraan;
        pr.classList.remove("hidden");
        ph.classList.add("hidden");
        bh.classList.remove("hidden");
        dz.classList.add("border-primary", "border-solid");
        dz.classList.remove("border-gray-300", "border-dashed");
      }
      window.openModal("modal-tambah-mobil");
    };

    window.simpanMobil = async function (e) {
      e.preventDefault();
      const btn = document.getElementById("btn-save-mobil"),
        file = document.getElementById("mob_foto_file")?.files[0],
        editId = document.getElementById("edit_mobil_id").value;
      btn.innerText = "Menyimpan...";
      btn.disabled = true;
      try {
        let finalImage = null;
        if (file) {
          finalImage = await window.uploadImageToImgbb(
            await window.kompresGambar(file).catch(() => file),
          );
        }

        let payload = {
          plat_nomor: document.getElementById("mob_plat").value.toUpperCase(),
          nama_kendaraan: document.getElementById("mob_nama").value,
          jenis_kendaraan: document.getElementById("mob_jenis").value,
        };
        const pr = document.getElementById("previewMobil");
        if (finalImage) payload.foto_kendaraan = finalImage;
        else if (pr.src === "" || pr.classList.contains("hidden"))
          payload.foto_kendaraan = null;

        if (editId)
          await window.supabase.from("mobil").update(payload).eq("id", editId);
        else await window.supabase.from("mobil").insert([payload]);

        window.closeModal("modal-tambah-mobil");
        window.loadMobil();
      } catch (err) {
        alert(err.message);
      } finally {
        btn.innerText = "Simpan Ke Database";
        btn.disabled = false;
      }
    };

    window.hapusMobil = async function (id, nama) {
      if (!confirm(`Yakin ingin menghapus mobil ${nama}?`)) return;
      await window.supabase
        .from("mobil")
        .update({ is_active: false })
        .eq("id", id);
      window.loadMobil();
    };

    // ==========================================
    // 4. LOGIKA MOTOR (Data & Upload)
    // ==========================================
    window.allMotorData = [];

    const setupUploaderMotor = () => {
      const dz = document.getElementById("dropZoneMotor"),
        fi = document.getElementById("mot_foto_file"),
        fn = document.getElementById("fileNameMotor"),
        pr = document.getElementById("previewMotor"),
        ph = document.getElementById("dropZonePlaceholderMotor"),
        bh = document.getElementById("btnHapusPreviewMotor");
      if (dz && fi) {
        dz.addEventListener("click", () => fi.click());
        fi.addEventListener("change", (e) => {
          const file = e.target.files[0];
          if (file) {
            fn.innerText = "✓ Siap diupload: " + file.name;
            dz.classList.add("border-green-600", "border-solid");
            dz.classList.remove("border-dashed", "border-gray-300");
            const reader = new FileReader();
            reader.onload = (ev) => {
              pr.src = ev.target.result;
              pr.classList.remove("hidden");
              ph.classList.add("hidden");
              bh.classList.remove("hidden");
            };
            reader.readAsDataURL(file);
          } else window.resetPreviewMotor();
        });
        window.resetPreviewMotor = function () {
          fi.value = "";
          fn.innerText = "";
          pr.src = "";
          pr.classList.add("hidden");
          ph.classList.remove("hidden");
          bh.classList.add("hidden");
          dz.classList.remove("border-green-600", "border-solid");
          dz.classList.add("border-gray-300", "border-dashed");
        };
        if (bh)
          bh.addEventListener("click", (e) => {
            e.stopPropagation();
            window.resetPreviewMotor();
          });
      }
    };
    setupUploaderMotor();

    window.loadMotor = async function () {
      try {
        const { data, error } = await window.supabase
          .from("motor")
          .select("*")
          .eq("is_active", true)
          .order("nama_kendaraan");
        if (error) throw error;
        const tbody = document.getElementById("tbody-motor");
        if (!data || data.length === 0) {
          tbody.innerHTML =
            '<tr><td colspan="5" class="p-4 text-center text-gray-400">Belum ada armada motor.</td></tr>';
          return;
        }

        window.allMotorData = data;
        tbody.innerHTML = data
          .map(
            (m) => `
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="p-3 text-center" data-label="Foto">${m.foto_kendaraan ? `<img src="${m.foto_kendaraan}" class="w-12 h-12 object-cover rounded-md mx-auto">` : `<div class="w-12 h-12 bg-gray-200 rounded-md mx-auto flex items-center justify-center text-gray-400"><i class="bi bi-bicycle"></i></div>`}</td>
                        <td class="p-3 font-mono font-bold text-gray-900" data-label="Plat Nomor"><span class="bg-gray-200 px-2 py-1 rounded text-sm">${m.plat_nomor}</span></td>
                        <td class="p-3 font-bold text-green-700" data-label="Nama Kendaraan">${m.nama_kendaraan}</td>
                        <td class="p-3 text-gray-600" data-label="Jenis">${m.jenis_kendaraan}</td>
                        <td class="p-3 text-right" data-label="Aksi">
                            <div class="flex gap-2 justify-end">
                                <button onclick="window.editMotor('${m.id}')" class="bg-blue-50 text-blue-600 p-2 rounded hover:bg-blue-100 transition"><i class="bi bi-pencil-square"></i></button>
                                <button onclick="window.hapusMotor('${m.id}', '${m.nama_kendaraan}')" class="bg-red-50 text-red-600 p-2 rounded hover:bg-red-100 transition"><i class="bi bi-trash3"></i></button>
                            </div>
                        </td>
                    </tr>`,
          )
          .join("");
      } catch (e) {
        console.error(e);
      }
    };

    window.bukaModalTambahMotor = function () {
      document.getElementById("form-motor").reset();
      document.getElementById("edit_motor_id").value = "";
      document.querySelector("#modal-tambah-motor h3").innerText =
        "Registrasi Motor Baru";
      if (window.resetPreviewMotor) window.resetPreviewMotor();
      window.openModal("modal-tambah-motor");
    };

    window.editMotor = function (id) {
      const m = window.allMotorData.find((x) => String(x.id) === String(id));
      if (!m) return;
      document.getElementById("edit_motor_id").value = m.id;
      document.getElementById("mot_plat").value = m.plat_nomor;
      document.getElementById("mot_nama").value = m.nama_kendaraan;
      document.getElementById("mot_jenis").value = m.jenis_kendaraan;
      document.querySelector("#modal-tambah-motor h3").innerText =
        "Edit Data Motor";
      if (window.resetPreviewMotor) window.resetPreviewMotor();
      if (m.foto_kendaraan) {
        const pr = document.getElementById("previewMotor"),
          ph = document.getElementById("dropZonePlaceholderMotor"),
          bh = document.getElementById("btnHapusPreviewMotor"),
          dz = document.getElementById("dropZoneMotor");
        pr.src = m.foto_kendaraan;
        pr.classList.remove("hidden");
        ph.classList.add("hidden");
        bh.classList.remove("hidden");
        dz.classList.add("border-green-600", "border-solid");
        dz.classList.remove("border-gray-300", "border-dashed");
      }
      window.openModal("modal-tambah-motor");
    };

    window.simpanMotor = async function (e) {
      e.preventDefault();
      const btn = document.getElementById("btn-save-motor"),
        file = document.getElementById("mot_foto_file")?.files[0],
        editId = document.getElementById("edit_motor_id").value;
      btn.innerText = "Menyimpan...";
      btn.disabled = true;
      try {
        let finalImage = null;
        if (file) {
          finalImage = await window.uploadImageToImgbb(
            await window.kompresGambar(file).catch(() => file),
          );
        }

        let payload = {
          plat_nomor: document.getElementById("mot_plat").value.toUpperCase(),
          nama_kendaraan: document.getElementById("mot_nama").value,
          jenis_kendaraan: document.getElementById("mot_jenis").value,
        };
        const pr = document.getElementById("previewMotor");
        if (finalImage) payload.foto_kendaraan = finalImage;
        else if (pr.src === "" || pr.classList.contains("hidden"))
          payload.foto_kendaraan = null;

        if (editId)
          await window.supabase.from("motor").update(payload).eq("id", editId);
        else await window.supabase.from("motor").insert([payload]);

        window.closeModal("modal-tambah-motor");
        window.loadMotor();
      } catch (err) {
        alert(err.message);
      } finally {
        btn.innerText = "Simpan Ke Database";
        btn.disabled = false;
      }
    };

    window.hapusMotor = async function (id, nama) {
      if (!confirm(`Yakin ingin menghapus motor ${nama}?`)) return;
      await window.supabase
        .from("motor")
        .update({ is_active: false })
        .eq("id", id);
      window.loadMotor();
    };

    // ==========================================
    // 5. PENGECEKAN MOBIL
    // ==========================================
    window.loadPengecekan = async function () {
      const bln = document.getElementById("filter-bulan-cek-mobil").value;
      if (!bln) return;
      const [tahun, bulan] = bln.split("-");
      const tglAkhir = new Date(tahun, bulan, 0).getDate();
      try {
        const { data, error } = await window.supabase
          .from("pengecekan_mobil")
          .select("*, mobil:mobil_id(nama_kendaraan, plat_nomor)")
          .gte("tanggal", `${bln}-01`)
          .lte("tanggal", `${bln}-${tglAkhir}`)
          .order("tanggal", { ascending: false });
        const tbody = document.getElementById("tbody-pengecekan-mobil");
        if (!data || data.length === 0) {
          tbody.innerHTML =
            '<tr><td colspan="5" class="p-4 text-center text-gray-400">Belum ada data.</td></tr>';
          return;
        }

        tbody.innerHTML = data
          .map(
            (d) => `
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="p-3 font-mono font-bold text-gray-800" data-label="Tanggal & Sesi">${d.tanggal}<br><span class="text-[10px] bg-blue-100 text-blue-700 px-2 py-0.5 rounded">${d.waktu_cek || "Awal"}</span></td>
                        <td class="p-3 leading-tight" data-label="Mobil"><span class="font-bold text-primary">${d.mobil?.nama_kendaraan || "-"}</span><br><span class="text-[10px] bg-gray-200 px-1 rounded">${d.mobil?.plat_nomor || "-"}</span></td>
                        <td class="p-3 text-xs" data-label="Inspeksi">
                            <div class="grid grid-cols-2 gap-x-2 gap-y-1 max-w-[300px] text-gray-600">
                                <div>Bensin: <span class="font-bold text-gray-900">${d.bensin || "-"}</span></div>
                                <div>Oli: <span class="font-bold text-gray-900">${d.oli || "-"}</span></div>
                                <div>Radiator: <span class="font-bold text-gray-900">${d.radiator || "-"}</span></div>
                                <div>Ban: <span class="font-bold text-gray-900">${d.kondisi_ban || "-"}</span></div>
                            </div>
                            ${d.catatan ? `<div class="mt-2 text-[11px] text-gray-500 italic">📝 "${d.catatan}"</div>` : ""}
                        </td>
                        <td class="p-3 text-xs font-semibold text-gray-600" data-label="Petugas">${d.nama_pemeriksa}</td>
                        <td class="p-3 text-right" data-label="Verifikasi"><button onclick="window.hapusCekMobil('${d.id}')" class="text-red-500 hover:text-red-700 bg-red-50 px-2 py-1 text-xs font-bold rounded">Tolak</button></td>
                    </tr>`,
          )
          .join("");
      } catch (e) {
        console.error(e);
      }
    };
    window.hapusCekMobil = async function (id) {
      if (confirm("Tolak laporan mobil ini?")) {
        await window.supabase.from("pengecekan_mobil").delete().eq("id", id);
        window.loadPengecekan();
      }
    };

    // ==========================================
    // 6. PENGECEKAN MOTOR
    // ==========================================
    window.loadPengecekanMotor = async function () {
      const bln = document.getElementById("filter-bulan-cek-motor").value;
      if (!bln) return;
      const [tahun, bulan] = bln.split("-");
      const tglAkhir = new Date(tahun, bulan, 0).getDate();
      try {
        const { data, error } = await window.supabase
          .from("pengecekan_motor")
          .select("*, motor:motor_id(nama_kendaraan, plat_nomor)")
          .gte("tanggal", `${bln}-01`)
          .lte("tanggal", `${bln}-${tglAkhir}`)
          .order("tanggal", { ascending: false });

        const tbody = document.getElementById("tbody-pengecekan-motor");
        if (!data || data.length === 0) {
          tbody.innerHTML =
            '<tr><td colspan="5" class="p-4 text-center text-gray-400">Belum ada data inspeksi motor masuk.</td></tr>';
          return;
        }

        tbody.innerHTML = data
          .map(
            (d) => `
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="p-3 font-mono font-bold text-gray-800" data-label="Tanggal">${d.tanggal}</td>
                        <td class="p-3 leading-tight" data-label="Motor"><span class="font-bold text-green-700">${d.motor?.nama_kendaraan || "-"}</span><br><span class="text-[10px] bg-gray-200 px-1 rounded">${d.motor?.plat_nomor || "-"}</span></td>
                        <td class="p-3 text-xs" data-label="Inspeksi">
                            <div class="grid grid-cols-2 gap-x-2 gap-y-1 max-w-[300px] text-gray-600">
                                <div>🛣️ KM Brgkt: <span class="font-bold text-gray-900">${d.km_berangkat || "-"}</span></div>
                                <div>🏁 KM Plng: <span class="font-bold text-gray-900">${d.km_pulang || "-"}</span></div>
                                <div>🛑 Rem: <span class="font-bold text-gray-900">${d.rem || "-"}</span></div>
                                <div>🛢️ Oli: <span class="font-bold text-gray-900">${d.oli || "-"}</span></div>
                                <div>🌡️ Air Rad: <span class="font-bold text-gray-900">${d.air_radiator || "-"}</span></div>
                                <div>📯 Klakson: <span class="font-bold text-gray-900">${d.klakson || "-"}</span></div>
                                <div>🔍 Spion: <span class="font-bold text-gray-900">${d.spion || "-"}</span></div>
                                <div>💡 Sen: <span class="font-bold text-gray-900">${d.lampu_sen || "-"}</span></div>
                                <div>🚨 Lp. Rem: <span class="font-bold text-gray-900">${d.lampu_rem || "-"}</span></div>
                            </div>
                            ${d.catatan ? `<div class="mt-2 text-[11px] text-gray-500 italic p-1.5 bg-gray-50 border rounded">📝 "${d.catatan}"</div>` : ""}
                        </td>
                        <td class="p-3 text-xs font-semibold text-gray-600" data-label="Petugas">${d.nama_pemeriksa}</td>
                        <td class="p-3 text-right" data-label="Verifikasi"><button onclick="window.hapusCekMotor('${d.id}')" class="text-red-500 hover:text-red-700 bg-red-50 px-2 py-1 text-xs font-bold rounded">Tolak</button></td>
                    </tr>`,
          )
          .join("");
      } catch (e) {
        console.error(e);
      }
    };
    window.hapusCekMotor = async function (id) {
      if (confirm("Tolak laporan motor ini?")) {
        await window.supabase.from("pengecekan_motor").delete().eq("id", id);
        window.loadPengecekanMotor();
      }
    };
    // ==========================================
    // 7. MANAJEMEN RIWAYAT SERVICE
    // ==========================================
    window.loadService = async function () {
      const bln = document.getElementById("filter-bulan-service").value;
      if (!bln) return;
      const [tahun, bulan] = bln.split("-");
      const tglAkhir = new Date(tahun, bulan, 0).getDate();

      try {
        const { data, error } = await window.supabase
          .from("service_kendaraan")
          .select(
            "*, mobil:mobil_id(nama_kendaraan, plat_nomor), motor:motor_id(nama_kendaraan, plat_nomor)",
          )
          .gte("tanggal", `${bln}-01`)
          .lte("tanggal", `${bln}-${tglAkhir}`)
          .order("tanggal", { ascending: false });

        const tbody = document.getElementById("tbody-service");
        if (!data || data.length === 0) {
          tbody.innerHTML =
            '<tr><td colspan="6" class="p-4 text-center text-gray-400">Tidak ada riwayat service di bulan ini.</td></tr>';
          return;
        }

        tbody.innerHTML = data
          .map((d) => {
            const isMobil = d.tipe_kendaraan === "mobil";
            const armada = isMobil ? d.mobil : d.motor;
            const icon = isMobil
              ? '<i class="bi bi-car-front-fill text-blue-500"></i>'
              : '<i class="bi bi-bicycle text-green-500"></i>';

            return `
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="p-3 font-mono font-bold text-gray-800" data-label="Tanggal">${d.tanggal}</td>
                        <td class="p-3 leading-tight" data-label="Kendaraan">
                            <span class="font-bold text-gray-900">${icon} ${armada?.nama_kendaraan || "-"}</span><br>
                            <span class="text-[10px] bg-gray-200 px-1 rounded">${armada?.plat_nomor || "-"}</span>
                        </td>
                        <td class="p-3 text-sm font-semibold text-gray-700" data-label="Bengkel">${d.nama_bengkel || "-"}</td>
                        <td class="p-3 text-xs text-gray-600" data-label="Detail Perbaikan">
                            <div class="whitespace-pre-wrap max-w-xs break-words">${d.detail_service}</div>
                        </td>
                        <td class="p-3 font-mono font-bold text-red-600 text-right" data-label="Biaya">Rp ${d.biaya.toLocaleString("id-ID")}</td>
                        <td class="p-3 text-right" data-label="Aksi">
                            <button onclick="window.hapusService('${d.id}')" class="text-red-500 hover:text-red-700 bg-red-50 px-2 py-1 text-xs font-bold rounded" title="Hapus Data">Hapus</button>
                        </td>
                    </tr>`;
          })
          .join("");
      } catch (e) {
        console.error("Error load service:", e);
      }
    };

    window.toggleJenisService = function () {
      const jenis = document.querySelector(
        'input[name="srv_jenis"]:checked',
      ).value;
      const containerMobil = document.getElementById("container-srv-mobil");
      const containerMotor = document.getElementById("container-srv-motor");

      if (jenis === "mobil") {
        containerMobil.classList.remove("hidden");
        containerMotor.classList.add("hidden");
        document.getElementById("srv_mobil").required = true;
        document.getElementById("srv_motor").required = false;
      } else {
        containerMobil.classList.add("hidden");
        containerMotor.classList.remove("hidden");
        document.getElementById("srv_mobil").required = false;
        document.getElementById("srv_motor").required = true;
      }
    };

    // Fungsi Toggle UI Integrasi Keuangan
    window.toggleIntegrasiKeuangan = function () {
      const isChecked = document.getElementById("srv_integrasi").checked;
      const container = document.getElementById("container-integrasi-keuangan");
      if (isChecked) {
        container.classList.remove("hidden");
        document.getElementById("srv_pengaju").required = true;
        document.getElementById("srv_sumber_dana").required = true;
      } else {
        container.classList.add("hidden");
        document.getElementById("srv_pengaju").required = false;
        document.getElementById("srv_sumber_dana").required = false;
      }
    };

    window.bukaModalService = async function () {
      document.getElementById("form-service").reset();

      // Set Tanggal Hari Ini
      const now = new Date();
      const offset = now.getTimezoneOffset() * 60000;
      document.getElementById("srv_tgl").value = new Date(now - offset)
        .toISOString()
        .split("T")[0];

      // 1. Populate Dropdown Kendaraan
      let optMobil = '<option value="">-- Pilih Mobil --</option>';
      if (window.allMobilData)
        window.allMobilData.forEach(
          (m) =>
            (optMobil += `<option value="${m.id}">${m.nama_kendaraan} (${m.plat_nomor})</option>`),
        );
      document.getElementById("srv_mobil").innerHTML = optMobil;

      let optMotor = '<option value="">-- Pilih Motor --</option>';
      if (window.allMotorData)
        window.allMotorData.forEach(
          (m) =>
            (optMotor += `<option value="${m.id}">${m.nama_kendaraan} (${m.plat_nomor})</option>`),
        );
      document.getElementById("srv_motor").innerHTML = optMotor;

      // 2. Populate Dropdown Karyawan (Pengaju)
      try {
        const { data: users } = await window.supabase
          .from("profiles")
          .select("id, nama")
          .order("nama");
        let optUsers =
          '<option value="">-- Pilih Pengaju / Karyawan --</option>';
        if (users)
          users.forEach(
            (u) => (optUsers += `<option value="${u.id}">${u.nama}</option>`),
          );
        document.getElementById("srv_pengaju").innerHTML = optUsers;
      } catch (e) {
        console.error("Gagal load pengaju:", e);
      }

      // Reset Toggle
      window.toggleJenisService();
      window.toggleIntegrasiKeuangan();
      window.openModal("modal-tambah-service");
    };

    window.simpanService = async function (e) {
      e.preventDefault();
      const btn = document.getElementById("btn-save-service");
      btn.innerText = "Menyimpan...";
      btn.disabled = true;

      const jenis = document.querySelector(
        'input[name="srv_jenis"]:checked',
      ).value;
      const tanggalStr = document.getElementById("srv_tgl").value;
      const mobil_id =
        jenis === "mobil" ? document.getElementById("srv_mobil").value : null;
      const motor_id =
        jenis === "motor" ? document.getElementById("srv_motor").value : null;
      const nama_bengkel = document.getElementById("srv_bengkel").value;
      const detail_service = document.getElementById("srv_detail").value;
      const biaya = parseInt(document.getElementById("srv_biaya").value) || 0;

      const isIntegrasi = document.getElementById("srv_integrasi").checked;
      const pengaju_id = document.getElementById("srv_pengaju").value;
      const sumber_dana = document.getElementById("srv_sumber_dana").value;

      try {
        // LANGKAH 1: Simpan ke Riwayat Service Armada
        const { error: errService } = await window.supabase
          .from("service_kendaraan")
          .insert([
            {
              tanggal: tanggalStr,
              tipe_kendaraan: jenis,
              mobil_id: mobil_id,
              motor_id: motor_id,
              nama_bengkel: nama_bengkel,
              detail_service: detail_service,
              biaya: biaya,
            },
          ]);
        if (errService) throw errService;

        // LANGKAH 2: Integrasi ke Pengeluaran Ops (Jika dicentang & biaya > 0)
        if (isIntegrasi && biaya > 0) {
          btn.innerText = "Mengirim Tagihan ke Keuangan...";

          // A. Cari nama armada untuk ditaruh di Keterangan Pengeluaran
          let namaArmada = "";
          if (jenis === "mobil" && window.allMobilData) {
            const m = window.allMobilData.find(
              (x) => String(x.id) === String(mobil_id),
            );
            if (m) namaArmada = m.nama_kendaraan;
          } else if (jenis === "motor" && window.allMotorData) {
            const m = window.allMotorData.find(
              (x) => String(x.id) === String(motor_id),
            );
            if (m) namaArmada = m.nama_kendaraan;
          }

          // B. Cek apakah ada pengeluaran induk di hari yang sama untuk pengaju ini
          const { data: existingPeng } = await window.supabase
            .from("pengeluaran")
            .select("id")
            .eq("user_id", pengaju_id)
            .eq("tanggal", tanggalStr)
            .order("created_at", { ascending: false })
            .limit(1);

          let pengeluaranId;
          if (existingPeng && existingPeng.length > 0) {
            pengeluaranId = existingPeng[0].id; // Gabung ke nota hari ini
          } else {
            // Bikin pengeluaran induk baru
            const { data: newPeng, error: errNewPeng } = await window.supabase
              .from("pengeluaran")
              .insert({
                user_id: pengaju_id,
                tanggal: tanggalStr,
                total_harian: 0,
                status_approval: "Menunggu",
                sumber_dana: sumber_dana,
              })
              .select("id")
              .single();
            if (errNewPeng) throw errNewPeng;
            pengeluaranId = newPeng.id;
          }

          // C. Insert ke rincian pengeluaran dengan kategori 'Service'
          const textKeterangan = `Service ${namaArmada} di ${nama_bengkel} - Detail: ${detail_service}`;
          const { error: errRincian } = await window.supabase
            .from("rincian_pengeluaran")
            .insert({
              pengeluaran_id: pengeluaranId,
              nama_item: "Service",
              nominal: biaya,
              keterangan: textKeterangan,
            });
          if (errRincian) throw errRincian;
        }

        alert(
          isIntegrasi
            ? "Riwayat service dicatat & tagihan berhasil dikirim ke Pengeluaran!"
            : "Riwayat service berhasil dicatat!",
        );
        window.closeModal("modal-tambah-service");
        window.loadService(); // Refresh tabel
      } catch (err) {
        alert("Gagal menyimpan data: " + err.message);
      } finally {
        btn.innerText = "Simpan Riwayat Service";
        btn.disabled = false;
      }
    };

    window.hapusService = async function (id) {
      if (
        !confirm("Yakin ingin menghapus riwayat service ini secara permanen?")
      )
        return;
      try {
        const { error } = await window.supabase
          .from("service_kendaraan")
          .delete()
          .eq("id", id);
        if (error) throw error;
        window.loadService();
      } catch (err) {
        alert("Gagal menghapus data: " + err.message);
      }
    };
  </script>
</Layout>
