---
import GeneralLayout from "../layouts/Layout.astro";
import "bootstrap-icons/font/bootstrap-icons.css";

// Data untuk tabs menu
const menuTabs = [
  { id: "mitra", label: "Mitra", icon: "bi-person-lines-fill" },
  { id: "gudang", label: "Gudang Komoditas", icon: "bi-box-seam" },
  {
    id: "stock_harian",
    label: "Stok Gudang Harian",
    icon: "bi-clipboard-data",
  },
  { id: "gaji_manual", label: "Gaji Karyawan", icon: "bi-calendar-plus" },
  { id: "penjualan", label: "Penjualan Barang", icon: "bi-bag-check" },
  { id: "pengeluaran", label: "Pengeluaran Harian", icon: "bi-wallet2" },
];

// Status badge colors
const statusBadgeColors = {
  active: "bg-green-100 text-green-700",
  inactive: "bg-red-100 text-red-700",
};
---

<GeneralLayout title="Manajemen Inventory & Keuangan - Bang Jelantah">
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"
  />
  <script is:inline src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script
    is:inline
    src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.min.js"
  ></script>
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"
  />
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

  <style is:global>
    body {
      display: none;
    }
  </style>

  <!-- HEADER & TAB NAVIGATION -->
  <div class="mb-8 flex items-center justify-between flex-wrap gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        Manajemen Inventory & Keuangan
      </h1>
      <p class="text-gray-600">
        Kelola mitra, komoditas, pembelian, penjualan, dan pengeluaran harian.
      </p>
    </div>
    <div class="flex gap-3 flex-wrap">
      <!-- Import Excel Button -->
      <button
        id="importExcelBtn"
        class="flex items-center gap-2 px-6 py-2 bg-blue-700 text-white rounded-lg hover:bg-blue-800 transition font-medium"
      >
        <i class="bi bi-file-earmark-excel"></i>
        <span>Import Excel</span>
      </button>

      <!-- Download Template Button -->
      <button
        id="downloadTemplateBtn"
        class="flex items-center gap-2 px-6 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition font-medium"
      >
        <i class="bi bi-download"></i>
        <span>Template Excel</span>
      </button>

      <!-- Add Button (Original) -->
      <button
        id="openFormBtn"
        class="flex items-center gap-2 px-6 py-2 bg-green-700 text-white rounded-lg hover:bg-green-800 transition font-medium"
      >
        <i id="addIcon" class="bi bi-plus-circle-fill"></i>
        <span id="addBtnText">Tambah Data</span>
      </button>
    </div>
  </div>

  <!-- File Input Hidden untuk Import -->
  <input
    type="file"
    id="excelFileInput"
    accept=".xlsx,.xls"
    style="display:none;"
  />

  <!-- TAB MENU -->
  <div class="bg-white rounded-lg border border-gray-200 mb-6 shadow-sm">
    <div class="flex gap-2 p-4 flex-wrap">
      {
        menuTabs.map((tab) => (
          <button
            data-tab={tab.id}
            class={`tab-btn px-4 py-2 rounded-lg font-medium transition flex items-center gap-2 ${
              tab.id === "mitra"
                ? "bg-green-700 text-white"
                : "bg-gray-100 text-gray-700 hover:bg-gray-200"
            }`}
          >
            <i class={`bi ${tab.icon}`} />
            {tab.label}
          </button>
        ))
      }
    </div>
  </div>

  <!-- ========================================
       TABEL MITRA
       ======================================== -->
  <div id="mitra-tab" class="tab-content">
    <div
      class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm"
    >
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
                >Nama Mitra</th
              >
              <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
                >Alamat</th
              >
              <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
                >No. HP</th
              >
              <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
                >Rute Jemput</th
              >
              <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
                >Total Order</th
              >
              <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
                >Status</th
              >
              <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
                >Aksi</th
              >
            </tr>
          </thead>
          <tbody id="tabelMitra">
            <tr
              ><td colspan="7" class="text-center py-4 text-gray-500"
                >Memuat data mitra...</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ========================================
       TABEL GUDANG KOMODITAS
       ======================================== -->
  <div id="gudang-tab" class="tab-content hidden">
    <div
      class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm"
    >
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
                >Nama Komoditas</th
              >
              <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
                >Stok</th
              >
              <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
                >Satuan</th
              >
              <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
                >Aksi</th
              >
            </tr>
          </thead>
          <tbody id="tabelGudang">
            <tr
              ><td colspan="4" class="text-center py-4 text-gray-500"
                >Memuat data gudang...</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <!-- ========================================
       TABEL Stock GUdang Harian
       ======================================== -->
  <div id="stock_harian-tab" class="tab-content hidden">
    <div
      class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm"
    >
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="px-4 py-3 text-left font-bold text-gray-900"
                >Tanggal</th
              >
              <th class="px-4 py-3 text-left font-bold text-gray-900">Sumber</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Minyak (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Ampas (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Kriuk (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Spinner (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Tepung (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Total (kg)</th
              >
              <th class="px-4 py-3 text-left font-bold text-gray-900">Aksi</th>
            </tr>
          </thead>
          <tbody id="tabelStockHarian">
            <tr
              ><td colspan="9" class="text-center py-4 text-gray-500"
                >Memuat data stok harian...</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <!-- ========================================
       TABEL PEMBELIAN BARANG
       ======================================== -->
  <div id="pembelian-tab" class="tab-content hidden">
    <div
      class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm"
    >
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="px-4 py-3 text-left font-bold text-gray-900"
                >Tanggal</th
              >
              <th class="px-4 py-3 text-left font-bold text-gray-900">Sumber</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Minyak (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Ampas (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Kriuk (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Spinner (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Tepung (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900">Total</th
              >
              <th class="px-4 py-3 text-left font-bold text-gray-900">Aksi</th>
            </tr>
          </thead>
          <tbody id="tabelPembelian">
            <tr
              ><td colspan="9" class="text-center py-4 text-gray-500"
                >Memuat data pembelian...</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ========================================
       TABEL PENJUALAN BARANG
       ======================================== -->
  <div id="penjualan-tab" class="tab-content hidden">
    <div
      class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm"
    >
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="px-4 py-3 text-left font-bold text-gray-900"
                >Tanggal</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Minyak (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Ampas (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Kriuk (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Spinner (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Tepung (kg)</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900">Total</th
              >
              <th class="px-4 py-3 text-left font-bold text-gray-900">Aksi</th>
            </tr>
          </thead>
          <tbody id="tabelPenjualan">
            <tr
              ><td colspan="8" class="text-center py-4 text-gray-500"
                >Memuat data penjualan...</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ========================================
       TABEL PENGELUARAN HARIAN
       ======================================== -->
  <div id="pengeluaran-tab" class="tab-content hidden">
    <div
      class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm"
    >
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="px-4 py-3 text-left font-bold text-gray-900"
                >Tanggal</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900">Gaji</th>
              <th class="px-4 py-3 text-right font-bold text-gray-900">Makan</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900">Bonus</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Lembur</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Bensin</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900"
                >Listrik</th
              >
              <th class="px-4 py-3 text-right font-bold text-gray-900">Total</th
              >
              <th class="px-4 py-3 text-left font-bold text-gray-900">Aksi</th>
            </tr>
          </thead>
          <tbody id="tabelPengeluaran">
            <tr
              ><td colspan="9" class="text-center py-4 text-gray-500"
                >Memuat data pengeluaran...</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div id="gaji_manual-tab" class="tab-content hidden">
    <input type="hidden" id="manual_edit_slip_id" value="" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div
        class="bg-white p-6 rounded-lg border border-gray-200 shadow-sm max-w-5xl mx-auto mt-6"
      >
        <h2 class="text-xl font-bold text-gray-900 mb-2">
          <i class="bi bi-clock-history text-blue-600 mr-2"></i>Input Rekap Gaji
          Lampau
        </h2>
        <p class="text-sm text-gray-500 mb-6">
          Masukkan data gaji untuk tanggal sebelum hari ini. Tanggal yang sudah
          pernah diinput otomatis terkunci (abu-abu).
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
          <div class="lg:col-span-3">
            <form id="form-gaji-manual" class="space-y-4">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1"
                    >Pilih Karyawan</label
                  >
                  <select
                    id="manual_emp_id"
                    required
                    class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-blue-600 bg-gray-50"
                  >
                    <option value="" disabled selected
                      >-- Memuat Karyawan... --</option
                    >
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1"
                    >Periode Tanggal Gaji</label
                  >
                  <input
                    type="text"
                    id="manual_periode"
                    required
                    disabled
                    placeholder="Pilih Karyawan Dulu..."
                    class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-blue-600 bg-white disabled:bg-gray-200 disabled:cursor-not-allowed"
                  />
                </div>
              </div>

              <div
                class="border-t border-dashed border-gray-300 pt-4 grid grid-cols-2 gap-3"
              >
                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1"
                    >Gaji Pokok (Rp)</label
                  >
                  <input
                    type="number"
                    id="manual_gaji"
                    required
                    value="0"
                    class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1"
                    >Uang Lembur (Rp)</label
                  >
                  <input
                    type="number"
                    id="manual_lembur"
                    value="0"
                    class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1"
                    >Uang Makan (Rp)</label
                  >
                  <input
                    type="number"
                    id="manual_makan"
                    value="0"
                    class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1"
                    >Tunjangan Kesehatan (Rp)</label
                  >
                  <input
                    type="number"
                    id="manual_kesehatan"
                    value="0"
                    class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1"
                    >Bonus Tepat Waktu (Rp)</label
                  >
                  <input
                    type="number"
                    id="manual_bonus_tepat"
                    value="0"
                    class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1"
                    >Bonus Mingguan (Rp)</label
                  >
                  <input
                    type="number"
                    id="manual_bonus_mingguan"
                    value="0"
                    class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
                  />
                </div>

                <div class="col-span-2 mt-1">
                  <label class="block text-xs font-bold text-red-700 mb-1"
                    >Potongan Kasbon (Rp)</label
                  >
                  <input
                    type="number"
                    id="manual_kasbon"
                    value="0"
                    class="w-full border border-red-300 bg-red-50 text-red-900 font-bold rounded-lg p-2 text-sm outline-none focus:border-red-600"
                  />
                </div>
                <!-- 👉 TAMBAHAN: UANG TRANSPORT -->
                <div>
                  <label class="block text-xs font-bold text-gray-700 mb-1"
                    >Uang Transport (Rp)</label
                  >
                  <input
                    type="number"
                    id="manual_transport"
                    value="0"
                    class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
                  />
                </div>

                <!-- 👉 TAMBAHAN: UANG TALANGAN -->
                <div>
                  <label class="block text-xs font-bold text-blue-800 mb-1"
                    >Uang Talangan / Reimb (Rp)</label
                  >
                  <input
                    type="number"
                    id="manual_talangan"
                    value="0"
                    class="w-full border border-blue-300 bg-blue-50 text-blue-900 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
                  />
                </div>
              </div>

              <div
                class="bg-blue-50 p-4 rounded-xl border border-blue-200 mt-2 flex justify-between items-center"
              >
                <span class="text-sm font-bold text-blue-900"
                  >Total Diterima:</span
                >
                <span
                  id="manual_grandtotal"
                  class="text-2xl font-black font-mono text-blue-900">Rp 0</span
                >
              </div>

              <button
                type="submit"
                id="btn-submit-manual"
                class="w-full bg-gray-900 text-white font-bold py-3.5 rounded-xl hover:bg-black transition shadow-md flex justify-center items-center gap-2"
              >
                <i class="bi bi-cloud-arrow-up"></i> Simpan ke slip_gaji
              </button>
            </form>
          </div>

          <div
            class="lg:col-span-2 bg-gray-50 rounded-xl border border-gray-200 p-4 flex flex-col h-full max-h-[550px]"
          >
            <h3
              class="text-sm font-bold text-gray-800 mb-1 border-b border-gray-200 pb-2"
            >
              <i class="bi bi-journal-check text-green-600 mr-1"></i>Riwayat
              Gaji Karyawan
            </h3>
            <p
              id="label_riwayat_nama"
              class="text-xs font-bold text-blue-700 mb-3"
            >
              -
            </p>

            <div
              id="container_riwayat_manual"
              class="flex-1 overflow-y-auto custom-scrollbar space-y-2 pr-1"
            >
              <div class="text-center text-gray-400 text-xs mt-10 italic">
                <i class="bi bi-arrow-left-circle text-2xl block mb-2"></i>
                Silakan pilih karyawan di form sebelah kiri untuk melihat riwayat.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- =====================================
     MODAL IMPORT EXCEL
     ===================================== -->
  <div
    id="importModal"
    class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4"
  >
    <div class="bg-white rounded-2xl max-w-2xl w-full">
      <div
        class="bg-white border-b border-gray-100 px-6 py-4 flex items-center justify-between"
      >
        <h2 class="text-xl font-bold text-gray-900">Import Data dari Excel</h2>
        <button id="closeImportBtn" class="text-gray-400 hover:text-gray-600"
          ><i class="bi bi-x-lg text-xl"></i></button
        >
      </div>

      <div class="p-6 space-y-4">
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
          <p class="text-sm text-blue-900"><strong>Pilih Tabel:</strong></p>
          <select
            id="importTableSelect"
            class="w-full mt-2 px-4 py-2 border border-gray-300 rounded-lg outline-none focus:border-blue-700"
          >
            <option value="">-- Pilih Tabel --</option>
            <option value="mitra">Mitra</option>
            <option value="stock_gudang_harian">Stok Gudang Harian</option>
            <option value="pembelian_barang_harian">Pembelian Barang</option>
            <option value="penjualan_barang_harian">Penjualan Barang</option>
            <option value="pengeluaran_harian">Pengeluaran Harian</option>
          </select>
        </div>

        <div
          class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center cursor-pointer hover:border-blue-700 transition"
          id="dropZone"
        >
          <i class="bi bi-cloud-arrow-up text-4xl text-gray-400 mb-2"></i>
          <p class="text-sm font-medium text-gray-900">
            Drag & drop Excel file di sini
          </p>
          <p class="text-xs text-gray-500">atau</p>
          <button
            type="button"
            id="selectFileBtn"
            class="mt-2 px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700"
          >
            Pilih File
          </button>
        </div>

        <div
          id="importPreview"
          class="hidden bg-gray-50 border border-gray-200 rounded-lg p-4 max-h-80 overflow-y-auto"
        >
          <p class="text-xs font-bold text-gray-700 mb-2">
            Preview Data (10 baris pertama):
          </p>
          <div id="previewTable"></div>
        </div>

        <div class="flex gap-3">
          <button
            type="button"
            id="cancelImportBtn"
            class="flex-1 px-6 py-3 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 font-bold"
            >Batal</button
          >
          <button
            type="button"
            id="submitImportBtn"
            class="flex-1 px-6 py-3 bg-blue-700 text-white rounded-xl hover:bg-blue-800 font-bold"
            >Import Data</button
          >
        </div>
      </div>
    </div>
  </div>

  <!-- =====================================
     MODAL FORM UNIVERSAL
     ===================================== -->
  <div
    id="formModal"
    class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0"
  >
    <div
      class="bg-white rounded-2xl max-w-2xl w-full max-h-screen overflow-y-auto transform scale-95 transition-transform duration-300"
    >
      <div
        class="sticky top-0 bg-white border-b border-gray-100 px-6 py-4 flex items-center justify-between z-10"
      >
        <h2 id="modalTitle" class="text-xl font-bold text-gray-900">
          Tambah Data
        </h2>
        <button id="closeFormBtn" class="text-gray-400 hover:text-gray-600"
          ><i class="bi bi-x-lg text-xl"></i></button
        >
      </div>

      <form id="dynamicForm" class="p-6 space-y-6">
        <input type="hidden" id="editId" value="" />
        <input type="hidden" id="currentTab" value="mitra" />

        <!-- Kontainer untuk form fields yang dinamis -->
        <div id="formFieldsContainer"></div>

        <!-- Buttons -->
        <div class="flex gap-3 pt-4">
          <button
            type="button"
            id="cancelBtn"
            class="flex-1 px-6 py-3 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 font-bold transition"
            >Batal</button
          >
          <button
            type="submit"
            id="submitBtn"
            class="flex-1 px-6 py-3 bg-green-700 text-white rounded-xl hover:bg-green-800 font-bold transition shadow-sm"
            >Simpan</button
          >
        </div>
      </form>
    </div>
  </div>
  <script>
    // @ts-nocheck
    // Import di sini
    import { supabase } from "../lib/supabase.js";

    document.addEventListener("DOMContentLoaded", async function () {
      // === 🛡️ GATEKEEPER KEUANGAN ===
      const allowedRoles = ["owner", "keuangan", "hrd", "admin", "it"];
      const client = window.supabase || supabase;

      const {
        data: { session },
      } = await client.auth.getSession();
      if (!session) return window.location.replace("/");

      const { data: prof } = await client
        .from("profiles")
        .select("role")
        .eq("id", session.user.id)
        .single();
      if (!allowedRoles.includes(prof?.role)) {
        alert(
          `Akses Ditolak! Role Anda (${prof?.role || "Guest"}) dilarang masuk.`,
        );
        return window.location.replace("/");
      }
      document.body.style.display = "block";

      let currentTab = "mitra";

      // ===== TAB SWITCHING =====
      document.querySelectorAll(".tab-btn").forEach((btn) => {
        btn.addEventListener("click", function () {
          const tabId = this.getAttribute("data-tab");
          currentTab = tabId;
          document.getElementById("currentTab").value = tabId;

          // Update button styles
          document.querySelectorAll(".tab-btn").forEach((b) => {
            b.classList.remove("bg-green-700", "text-white");
            b.classList.add("bg-gray-100", "text-gray-700");
          });
          this.classList.remove("bg-gray-100", "text-gray-700");
          this.classList.add("bg-green-700", "text-white");

          // Tampilkan tab yang sesuai
          document.querySelectorAll(".tab-content").forEach((content) => {
            content.classList.add("hidden");
          });
          document.getElementById(`${tabId}-tab`).classList.remove("hidden");

          // Load data untuk tab yang dipilih
          if (tabId === "mitra") loadMitra();
          else if (tabId === "gudang") loadGudang();
          else if (tabId === "stock_harian") loadStockHarian();
          else if (tabId === "gaji_manual") initGajiManual();
          else if (tabId === "penjualan") loadPenjualan();
          else if (tabId === "pengeluaran") loadPengeluaran();
        });
      });

      // ===== LOAD DATA MITRA =====
      async function loadMitra() {
        const { data, error } = await supabase
          .from("mitra")
          .select("*")
          .order("created_at", { ascending: false });

        if (error) {
          console.error(error);
          document.getElementById("tabelMitra").innerHTML =
            '<tr><td colspan="7" class="text-center py-4 text-red-500 font-bold">Gagal memuat data!</td></tr>';
          return;
        }

        let html = "";
        data.forEach((item) => {
          const status = item.activated ? "Aktif" : "Nonaktif";
          const statusClass = item.activated
            ? "bg-green-100 text-green-700"
            : "bg-red-100 text-red-700";

          html += `
          <tr class="border-b border-gray-200 hover:bg-gray-50 transition">
            <td class="px-6 py-4 font-bold text-gray-900">${item.nama_mitra}</td>
            <td class="px-6 py-4 text-sm text-gray-700 max-w-[200px] truncate">${item.alamat || "-"}</td>
            <td class="px-6 py-4 text-sm text-gray-700">${item.nomor_hp || "-"}</td>
            <td class="px-6 py-4 text-sm text-gray-700">${item.rute_jemput || "-"}</td>
            <td class="px-6 py-4 font-bold text-gray-900">${item.total_order || 0}</td>
            <td class="px-6 py-4">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold ${statusClass}">
                ${status}
              </span>
            </td>
            <td class="px-6 py-4">
              <div class="flex gap-2">
                <button class="edit-mitra-btn px-3 py-1 text-blue-600 hover:bg-blue-50 border border-blue-200 rounded text-sm font-medium" data-id="${item.id}">
                  <i class="bi bi-pencil mr-1"></i>Edit
                </button>
                <button onclick="window.hapusData('mitra', ${item.id}, '${item.nama_mitra}')" class="px-3 py-1 text-red-600 hover:bg-red-50 border border-red-200 rounded text-sm font-medium">
                  <i class="bi bi-trash mr-1"></i>Hapus
                </button>
              </div>
            </td>
          </tr>
        `;
        });

        document.getElementById("tabelMitra").innerHTML = html;

        document.querySelectorAll(".edit-mitra-btn").forEach((btn) => {
          btn.addEventListener("click", function () {
            const id = this.getAttribute("data-id");
            editMitra(id);
          });
        });
      }

      // ===== LOAD DATA GUDANG =====
      async function loadGudang() {
        const { data, error } = await supabase
          .from("gudang_komoditas")
          .select("*")
          .order("nama_komoditas", { ascending: true });

