    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.default.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

    <script is:inline>
        // Cek Role Keamanan
        let currentUserRole = 'lapangan';
        // Penampung instance Tom Select
        let tomMitra, tomMotor, tomMobil, tomHelper, tomMobilPickup, tomDuetMobil, tomDuetDriver, tomDuetHelper;

        // =======================================================
        // FUNGSI GANTI TAB SAKTI (UI + LOGIKA TANGGAL)
        // =======================================================
        window.switchTab = function(tabId) {
            const tabs = ['pending', 'progress', 'history', 'rute'];
            
            // 1. Reset semua tab menjadi tidak aktif (Sembunyikan)
            tabs.forEach(id => {
                const btn = document.getElementById(`tab-${id}`);
                const content = document.getElementById(`content-${id}`);
                
                if (btn && content) {
                    btn.classList.remove('text-primary', 'border-primary');
                    btn.classList.add('text-on-surface-variant', 'border-transparent');
                    content.classList.remove('active');
                }
            });

            // 2. Aktifkan tab yang di-klik (Munculkan)
            const activeBtn = document.getElementById(`tab-${tabId}`);
            const activeContent = document.getElementById(`content-${tabId}`);
            
            if (activeBtn && activeContent) {
                activeBtn.classList.remove('text-on-surface-variant', 'border-transparent');
                activeBtn.classList.add('text-primary', 'border-primary');
                activeContent.classList.add('active');
            }

            // 3. Logika Filter Tanggal (Hanya muncul di Riwayat Selesai)
            const historySection = document.getElementById('filter-history-section');
            if (historySection) {
                if (tabId === 'history') {
                    historySection.classList.remove('hidden');
                } else {
                    historySection.classList.add('hidden');
                }
            }
            
            // 4. Jalankan ulang filter supaya rapi
            if (typeof window.applyMultiFilters === 'function') {
                setTimeout(window.applyMultiFilters, 50);
            }
        };

        document.addEventListener('DOMContentLoaded', async () => {

            if (!window.supabase) return console.error("Supabase Client tidak ditemukan!");
            // === 🛡️ GATEKEEPER OPERASIONAL ===
            // 1. Dapatkan Role Login
            const allowedRoles = ['owner', 'hrd', 'admin','it'];
            const client = window.supabase || supabase;

            const { data: { session } } = await client.auth.getSession();
            if (!session) return window.location.replace('/'); // Tendang kalau belum login

            const { data: prof } = await client.from('profiles').select('role, nama').eq('id', session.user.id).single();
            
            // 🔥 FIX: Update variabel global dengan role asli dari Supabase 🔥
            currentUserRole = prof?.role; 
            window.currentUserName = prof?.nama || 'Admin';

            if (!allowedRoles.includes(prof?.role)) {
                alert(`Akses Ditolak! Role Anda (${prof?.role || 'Guest'}) dilarang masuk ke halaman Operasional.`);
                return window.location.replace('/');
            }
            document.body.style.display = 'block'; // Buka gembok CSS, tampilkan layar!

            // 2. Fetch Data Jadwal Operasional
            async function loadOperasionalData() {
                const { data: jadwalPenjemputan, error: errJadwal } = await window.supabase
                    .from('penjemputan')
                    .select(`
                        id, status, tanggal, rute_penjemputan, kendaraan,
                        estimasi_minyak, estimasi_tepung, estimasi_kriuk, estimasi_spinner, estimasi_ampas, total_estimasi,
                        satuan_minyak, satuan_tepung, satuan_kriuk, satuan_spinner, satuan_ampas,
                        mitra ( id, nama_mitra, alamat, link_gmaps, nomor_hp ),
                        mobil ( id, nama_kendaraan, plat_nomor ),
                        driver:driver_id ( id, nama ),
                        helper:helper_id ( id, nama ),
                        transaksi ( 
                            id, 
                            transaksi_item:transaksi_item ( id, komoditas, volume, harga_unit ) 
                        )
                    `)
                    .order('tanggal', { ascending: false });

                if (errJadwal) {
                    alert("🚨 Gagal menarik data operasional!\nPesan: " + errJadwal.message);
                    return;
                }

                const pending = jadwalPenjemputan?.filter(j => j.status === 'Belum') || [];
                const onProgress = jadwalPenjemputan?.filter(j => j.status === 'OTW' || j.status === 'Proses') || [];
                const history = jadwalPenjemputan?.filter(j => j.status === 'Selesai') || [];

                // Update Notif Tab
                document.getElementById('count-pending').innerText = pending.length;
                document.getElementById('count-progress').innerText = onProgress.length;
                
                window.allJadwalPending = pending;
                // Render Tab Pending
                let htmlPending = '';
                if(pending.length > 0) {
                    pending.forEach(j => {
                        htmlPending += `
                        <tr class="hover:bg-surface-container-low transition-colors" data-rute="${j.rute_penjemputan || ''}" data-tanggal="${j.tanggal || ''}">
                            <td class="px-md py-md whitespace-nowrap font-semibold" data-label="Nama Mitra">${j.mitra?.nama_mitra || '-'}</td>
                            <td class="px-md py-md" data-label="Alamat">
                                <div class="text-xs font-bold text-gray-800 break-words max-w-[220px]" title="${j.mitra?.alamat || ''}">
                                    ${j.mitra?.alamat || '<span class="text-amber-600 font-normal italic text-[11px]">Teks alamat belum diisi (Data Lama)</span>'}
                                </div>
                                ${j.mitra?.link_gmaps ? `<a href="${j.mitra.link_gmaps}" target="_blank" class="text-blue-600 text-[11px] hover:underline flex items-center mt-1 font-semibold"><i class="bi bi-geo-alt-fill mr-1 text-red-500"></i> Google Maps</a>` : ''}
                            </td>
                            <td class="px-md py-md capitalize font-bold text-gray-700" data-label="Kendaraan">${j.kendaraan === 'mobil' ? (j.mobil ? `<span class="font-bold text-primary">${j.mobil.nama_kendaraan}</span><br><span class="text-[10px] bg-gray-200 px-1 rounded">${j.mobil.plat_nomor}</span>` : 'Mobil (Belum Diset)') : '<span class="font-bold text-gray-700">Motor</span>'}</td>
                            <td class="px-md py-md" data-label="Kurir">${j.driver?.nama || ''} ${j.helper?.nama ? '& ' + j.helper.nama : ''}</td>
                            <td class="px-md py-md" data-label="Status">
                                <span class="inline-flex items-center gap-xs px-2 py-1 rounded-full bg-amber-100 text-amber-800 font-label-sm text-[11px]"><span class="w-2 h-2 rounded-full bg-amber-500"></span> ${j.status}</span>
                            </td>
                            <td class="px-md py-md text-right" data-label="Aksi">
                                <div class="flex gap-2 justify-end">
                                    <button onclick="window.broadcastWAOperasional('${j.id}')" class="bg-green-50 text-green-600 border border-green-200 px-2 py-1 rounded text-[11px] font-bold hover:bg-green-100 transition shadow-sm" title="Broadcast WA Konfirmasi">
                                        <i class="bi bi-whatsapp text-sm"></i>
                                    </button>
                                    <button onclick="window.editPenjemputan('${j.id}')" class="bg-blue-50 text-blue-700 border border-blue-200 px-3 py-1 rounded text-[11px] font-bold hover:bg-blue-100 transition shadow-sm"><i class="bi bi-pencil-square mr-1"></i>Edit</button>
                                    <button onclick="window.hapusPenjemputan('${j.id}')" class="bg-red-50 text-red-600 border border-red-200 px-2 py-1 rounded text-[11px] font-bold hover:bg-red-100 transition shadow-sm" title="Hapus"><i class="bi bi-trash3"></i></button>
                                </div>
                            </td>
                        </tr>`;
                    });
                } else { htmlPending = '<tr><td colspan="6" class="p-4 text-center text-on-surface-variant">Tidak ada jadwal penjemputan baru.</td></tr>'; }
                document.getElementById('tbody-pending').innerHTML = htmlPending;

                // Render Tab Progress
                let htmlProgress = '';
                if(onProgress.length > 0) {
                    onProgress.forEach(j => {
                        htmlProgress += `
                        <tr class="hover:bg-surface-container-low transition-colors" data-rute="${j.rute_penjemputan || ''}" data-tanggal="${j.tanggal || ''}">
                            <td class="px-md py-md whitespace-nowrap font-semibold" data-label="Nama Mitra">${j.mitra?.nama_mitra || '-'}</td>
                            <td class="px-md py-md" data-label="Alamat">
                                <div class="text-xs font-bold text-gray-800 break-words max-w-[220px]" title="${j.mitra?.alamat || ''}">
                                    ${j.mitra?.alamat || '<span class="text-amber-600 font-normal italic text-[11px]">Teks alamat belum diisi (Data Lama)</span>'}
                                </div>
                                ${j.mitra?.link_gmaps ? `<a href="${j.mitra.link_gmaps}" target="_blank" class="text-blue-600 text-[11px] hover:underline flex items-center mt-1 font-semibold"><i class="bi bi-geo-alt-fill mr-1 text-red-500"></i> Google Maps</a>` : ''}
                            </td>
                            <td class="px-md py-md capitalize font-bold text-gray-700" data-label="Kendaraan">${j.kendaraan || '-'}</td>
                            <td class="px-md py-md" data-label="Kurir">${j.driver?.nama || ''} ${j.helper?.nama ? '& ' + j.helper.nama : ''}</td>
                            <td class="px-md py-md" data-label="Status">
                                <span class="inline-flex items-center gap-xs px-2 py-1 rounded-full bg-blue-100 text-blue-800 font-label-sm text-[11px]"><span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span> ${j.status}</span>
                            </td>
                            <td class="px-md py-md text-right" data-label="Aksi">
                                <div class="flex gap-2 justify-end">
                                    <button onclick="window.kembalikanKeBelum('${j.id}')" class="bg-amber-50 text-amber-700 border border-amber-200 px-3 py-1 rounded-full font-label-sm text-[11px] font-bold hover:bg-amber-100 transition shadow-sm" title="Tarik kembali ke Belum Diproses">
                                        <i class="bi bi-arrow-counterclockwise mr-1"></i> Batal Proses
                                    </button>
                                </div>
                            </td>
                        </tr>`;
                    });
                } else { htmlProgress = '<tr><td colspan="6" class="p-4 text-center text-on-surface-variant">Tidak ada armada yang sedang di perjalanan.</td></tr>'; }
                document.getElementById('tbody-progress').innerHTML = htmlProgress;

                // Render Tab History
                let htmlHistory = '';
                if(history.length > 0) {
                    history.forEach(j => {
    
                        // 🔥 PERBAIKAN: JANGAN HANYA AMBIL INDEX [0] 🔥
                        // Kita kumpulkan (push) semua item dari SELURUH row transaksi yang terikat
                        let items = [];
                        if (j.transaksi && j.transaksi.length > 0) {
                            j.transaksi.forEach(tx => {
                                if (tx.transaksi_item && tx.transaksi_item.length > 0) {
                                    items.push(...tx.transaksi_item);
                                }
                            });
                        }
                    
                        // PERHITUNGAN BERAT REAL: Jumlahkan semua volume di dalam kumpulan items
                        const totalRealKg = items.reduce((acc, curr) => acc + parseFloat(curr.volume || 0), 0);
                        
                        // RENDER RINCIAN KOMODITAS
                        let itemsHtml = '';
                        if(items.length > 0) {
                            items.forEach(item => {
                                itemsHtml += `<span class="inline-flex items-center gap-1 text-xs font-medium text-on-surface-variant bg-surface-container px-2 py-0.5 rounded border border-outline-variant w-fit mb-1">📦 <strong class="text-primary">${item.komoditas}:</strong> ${item.volume} Kg</span><br>`;
                            });
                        } else {
                            itemsHtml = '<span class="text-xs italic text-red-600">Data belum diinput lapangan</span>';
                        }
                    
                        htmlHistory += `
                        <tr class="hover:bg-surface-container-low transition-colors" data-rute="${j.rute_penjemputan || ''}" data-tanggal="${j.tanggal || ''}">
                            <td class="px-md py-md whitespace-nowrap font-semibold" data-label="Nama Mitra">${j.mitra?.nama_mitra || '-'}</td>
                            <td class="px-md py-md whitespace-nowrap" data-label="Tanggal Selesai">${j.tanggal}</td>
                            <td class="px-md py-md" data-label="Rincian Komoditas">${itemsHtml}</td>
                            <td class="px-md py-md font-bold text-right text-primary" data-label="Total Berat Real">${totalRealKg} KG</td>
                            <td class="px-md py-md" data-label="Status">
                                <span class="inline-flex items-center gap-xs px-2 py-1 rounded-full bg-emerald-100 text-emerald-800 font-label-sm text-[11px]">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Selesai
                                </span>
                            </td>
                        </tr>`;
                    });
                } else { htmlHistory = '<tr><td colspan="6" class="p-4 text-center text-on-surface-variant">Riwayat transaksi operasional kosong.</td></tr>'; }
                document.getElementById('tbody-history').innerHTML = htmlHistory;

                // 3. Fetch Dropdown Mitra & Tampilkan Detail Gmaps (Hanya yang Activated)
                const { data: daftarMitra } = await window.supabase
                    .from('mitra')
                    .select('id, nama_mitra, alamat, link_gmaps, rute_jemput')
                    .eq('activated', true) // 🔥 Menampilkan hanya yang activated = true
                    .order('nama_mitra', { ascending: true });
                            
                window.allMitra = daftarMitra || []; // Simpan global
                
                let optMitra = '<option value="">-- Pilih Mitra Pengumpul --</option>';
                window.allMitra.forEach(m => optMitra += `<option value="${m.id}">${m.nama_mitra} - ${(m.alamat || '').substring(0,30)}...</option>`);
                
                // Set innerHTML lalu inisialisasi Tom Select
                const elMitra = document.getElementById('input_mitra');
                elMitra.innerHTML = optMitra;
                
                if(tomMitra) tomMitra.destroy();
                tomMitra = new TomSelect(elMitra, { create: false, maxOptions: null });

                // Event Listener biar alamat & Gmaps muncul saat dipilih
                document.getElementById('input_mitra').addEventListener('change', function() {
                    const box = document.getElementById('detail_mitra_box');
                    const alamatTxt = document.getElementById('detail_alamat_mitra');
                    const gmapsBtn = document.getElementById('detail_gmaps_mitra');
                    
                    const selectedMitra = window.allMitra.find(m => String(m.id) === String(this.value));
                    
                    if(selectedMitra && (selectedMitra.alamat || selectedMitra.link_gmaps)) {
                        box.classList.remove('hidden');
                        const namaRute = selectedMitra.rute_jemput || 'Belum Diatur';
                        alamatTxt.innerHTML = `<span class="inline-block mb-1 px-2 py-0.5 bg-primary/10 text-primary font-bold text-[10px] rounded uppercase">RUTE: ${namaRute}</span><br/>${selectedMitra.alamat || 'Alamat tidak tersedia di sistem'}`;
                        if(selectedMitra.link_gmaps) {
                            gmapsBtn.href = selectedMitra.link_gmaps;
                            gmapsBtn.style.display = 'flex';
                        } else { gmapsBtn.style.display = 'none'; }
                    } else { box.classList.add('hidden'); }
                });

                // 4. FETCH DATA MOBIL UNTUK FORM PENJEMPUTAN
                const { data: mobilPickupData } = await window.supabase.from('mobil').select('id, nama_kendaraan, plat_nomor').eq('is_active', true);
                let optMobilPickup = '<option value="">-- Pilih Armada Mobil --</option>';
                if(mobilPickupData) mobilPickupData.forEach(m => optMobilPickup += `<option value="${m.id}">${m.nama_kendaraan} (${m.plat_nomor})</option>`);
                document.getElementById('input_mobil_pickup').innerHTML = optMobilPickup;
                
                if(tomMobilPickup) tomMobilPickup.destroy();
                tomMobilPickup = new TomSelect('#input_mobil_pickup', { create: false, maxOptions: null });

                // 5. Fetch Dropdown Karyawan & Filter Logic
                const { data: karyawanLapangan } = await window.supabase
                    .from('profiles')
                    .select('id, nama')
                    .order('nama', { ascending: true }); // Diurutkan berdasarkan nama agar rapi

                window.allKaryawan = karyawanLapangan || []; // Simpan global
                
                let optMotor = '<option value="">-- Pilih Kurir Motor --</option>';
                let optSupir = '<option value="">-- Pilih Supir Mobil --</option>';
                let optKenek = '<option value="">-- Tanpa Helper --</option>';
                
                window.allKaryawan.forEach(k => {
                    const namaLengkap = `${k.nama}`; // Teks tipe kendaraan dihapus
                    optMotor += `<option value="${k.id}">${namaLengkap}</option>`;
                    optSupir += `<option value="${k.id}">${namaLengkap}</option>`;
                    optKenek += `<option value="${k.id}">${namaLengkap}</option>`;
                });
                
               document.getElementById('input_driver_motor').innerHTML = optMotor;
                document.getElementById('input_driver_mobil').innerHTML = optSupir;
                document.getElementById('input_helper_mobil').innerHTML = optKenek;
                
                // Inisialisasi Searchable Kurir & Helper
                if(tomMotor) tomMotor.destroy();
                tomMotor = new TomSelect('#input_driver_motor', { create: false, maxOptions: null });
                
                if(tomMobil) tomMobil.destroy();
                tomMobil = new TomSelect('#input_driver_mobil', { create: false, maxOptions: null });
                
                if(tomHelper) tomHelper.destroy();
                tomHelper = new TomSelect('#input_helper_mobil', { create: false, maxOptions: null });

                // 🔥 LOGIKA MENCEGAH SUPIR DIPILIH LAGI JADI KENEK 🔥
                document.getElementById('input_driver_mobil').addEventListener('change', async function() {
            const selectedSupirId = this.value;
            const kenekSelect = document.getElementById('input_helper_mobil');
            const prevKenekId = kenekSelect.value; 
   
            // 1. Filter ulang daftar Helper agar nama supir nggak muncul ganda
            let newOptKenek = '<option value="">-- Tanpa Helper --</option>';
            window.allKaryawan.forEach(k => {
                if(k.id !== selectedSupirId) { 
                    newOptKenek += `<option value="${k.id}">${k.nama}</option>`;
                }
            });
            
            // 2. Refresh elemen dropdown Helper
            if(tomHelper) tomHelper.destroy();
            kenekSelect.innerHTML = newOptKenek;
            if(prevKenekId !== selectedSupirId) kenekSelect.value = prevKenekId;
            tomHelper = new TomSelect('#input_helper_mobil', { create: false, maxOptions: null });

            // ==========================================
            // 3. 🔥 PENCARIAN AUTO DUET BERDASARKAN DRIVER 🔥
            // ==========================================
            const tgl = document.getElementById('input_tanggal')?.value;
            
            if (selectedSupirId && tgl) {
                console.log(`🔎 Cari pasangan duet untuk Driver pada ${tgl}`);
                try {
                    const { data } = await window.supabase
                        .from('partner_kendaraan')
                        .select('helper_id, mobil_id') // ✅ FIX: Ganti dari 'mobil' jadi 'mobil_id'
                        .eq('tanggal', tgl)
                        .eq('driver_id', selectedSupirId)
                        .maybeSingle();

                    if (data) {
                        console.log("✅ Pasangan ditemukan! Auto-isi Helper dan Armada:", data);
                        if(data.helper_id) tomHelper.setValue(data.helper_id);
                        if(data.mobil_id && tomMobilPickup) tomMobilPickup.setValue(data.mobil_id); // ✅ FIX: Panggil data.mobil_id
                    } else {
                        console.log("ℹ️ Driver ini belum punya setingan duet di tanggal ini.");
                    }
                } catch(e) {
