    // PERBAIKAN: FUNGSI UNTUK MENAMPILKAN RIWAYAT GAJI (SLIP GAJI)
    // ====================================================================
    async function muatRiwayatGaji() {
        const container = document.getElementById('riwayat-gaji-container');
        if (!container) return;

        const start = document.getElementById('filter-gaji-start')?.value || awalTahun;
        const end = document.getElementById('filter-gaji-end')?.value || hariIni;

        // Bikin Kunci Cache Unik berdasarkan rentang tanggal
        const cacheKey = `riwayat_gaji_${start}_${end}`;
        const cachedData = localStorage.getItem(cacheKey);

        // FUNGSI RENDER (Dipisah biar bisa dipakai 2x: oleh Cache dan oleh Database)
        const renderHTML = (dataGaji) => {
            if (!dataGaji || dataGaji.length === 0) {
                container.innerHTML = `<p class="text-gray-500 text-sm italic py-4">Tidak ada riwayat pengeluaran gaji dari tanggal ${start} sampai ${end}.</p>`;
                return;
            }

            container.innerHTML = dataGaji.map(slip => {
                const isACC = slip.status === 'ACC' || slip.status_persetujuan === 'ACC';
                const inisial = slip.profiles?.nama ? slip.profiles.nama.substring(0, 2).toUpperCase() : 'KY';

                // Avatar pakai Foto Profil jika ada
                const avatarKomponen = slip.profiles?.foto_profil 
                    ? `<img src="${slip.profiles.foto_profil}" class="w-10 h-10 rounded-full object-cover border border-gray-200 shrink-0" />`
                    : `<div class="w-10 h-10 rounded-full bg-gray-100 border border-gray-200 flex items-center justify-center text-gray-600 font-bold text-xs shrink-0">${inisial}</div>`;

                return `
                    <div class="p-4 border border-gray-200 rounded-xl mb-3 bg-white shadow-sm flex gap-3 items-center">
                        ${avatarKomponen}
                        <div class="flex-1">
                            <div class="flex justify-between items-center">
                                <div>
                                    <p class="font-bold text-gray-900">${slip.profiles?.nama || 'Karyawan'}</p>
                                    <p class="text-xs text-gray-500">Periode: ${slip.periode || '-'}</p>
                                </div>
                                <span class="px-2 py-1 rounded text-xs font-bold ${isACC ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800'}">
                                    ${slip.status || 'Menunggu'}
                                </span>
                            </div>

                            ${isACC ? `
                                <div class="mt-2 text-xs space-y-1 border-t pt-2 border-dashed border-gray-300">
                                    <div class="flex justify-between"><span>Gaji Pokok:</span> <span>Rp ${Number(slip.gaji_karyawan || 0).toLocaleString('id-ID')}</span></div>
                                    <div class="flex justify-between"><span>Tunjangan:</span> <span>Rp ${Number(slip.tunjangan || 0).toLocaleString('id-ID')}</span></div>
                                    <div class="flex justify-between text-red-600"><span>Potongan Uang Jalan:</span> <span>-Rp ${Number(slip.uang_jalan || 0).toLocaleString('id-ID')}</span></div>
                                    <div class="flex justify-between font-bold text-green-700 mt-1 pt-1 border-t">
                                        <span>Total Pengeluaran (ACC):</span> 
                                        <span>Rp ${Number(slip.total_diterima || 0).toLocaleString('id-ID')}</span>
                                    </div>
                                </div>
                            ` : `
                                <div class="mt-2 text-xs text-amber-700 italic border-t pt-2 border-dashed border-gray-300">
                                    * Rincian disembunyikan sampai status disetujui (ACC).
                                </div>
                            `}
                        </div>
                    </div>
                `;
            }).join('');
        };

        // LANGKAH 1: Tampilkan Cache Lokal Langsung (Instan 0 Detik)
        if (cachedData) {
            renderHTML(JSON.parse(cachedData));
        } else {
            // Kalau cache bener-bener kosong, baru munculin teks loading
            container.innerHTML = '<p class="text-gray-500 text-sm italic animate-pulse">Memuat data riwayat gaji...</p>';
        }

        // LANGKAH 2: Tarik Data Fresh dari Supabase secara Diam-diam (Background)
        try {
            const { data: dataGaji, error } = await supabase
                .from('slip_gaji')
                .select(`*, profiles!inner(nama, role, foto_profil)`)
                .neq('profiles.role', 'owner')
                .gte('created_at', `${start} 00:00:00`)
                .lte('created_at', `${end} 23:59:59`)
                .order('created_at', { ascending: false });

            if (error) throw error;

            // Update Cache lokal dengan data terbaru dari database
            localStorage.setItem(cacheKey, JSON.stringify(dataGaji));
            
            // Render ulang layar dengan data paling fresh
            renderHTML(dataGaji);

        } catch (error) {
            console.error("Supabase Error:", error);
            
            // Kalau lagi offline dan gak ada cache sama sekali, baru munculin error merah
            if (!cachedData) {
                container.innerHTML = `
                    <div class="p-4 bg-red-50 text-red-700 rounded-xl text-xs">
                        <p class="font-bold">Gagal sinkronisasi data dengan server:</p>
                        <p class="italic mt-1">${error.message}</p>
                    </div>
                `;
            }
        }
    }
    document.getElementById('btn-filter-gaji')?.addEventListener('click', muatRiwayatGaji);
