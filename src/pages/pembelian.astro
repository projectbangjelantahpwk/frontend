                minute: "2-digit",
                timeZone: "Asia/Jakarta",
              })
            : "";
          const waktuTampil = jam ? `${jam} WIB` : "";

          // 🔥 PERBAIKAN 1: Parse ketat pakai parseFloat agar kebal dari nilai null/string (Anti-NaN)
          let subtotal = 0;
          let itemHtml = "";
          trx.transaksi_item?.forEach((i) => {
            const vol = parseFloat(i.volume) || 0;
            const hrg = parseFloat(i.harga_unit) || 0;
            const subItem = vol * hrg;
            subtotal += subItem;

            itemHtml += `<div class="flex justify-between text-gray-700"><span>${i.komoditas} (${vol}kg @ ${hrg})</span><span>Rp ${subItem.toLocaleString("id-ID")}</span></div>`;
          });

          // Amankan nilai DP dan Total
          const totalDP = parseFloat(trx.potongan_dp) || 0;
          const finalTotal = subtotal - totalDP;

          let infoBayarHtml = "";
          const m1 = trx.metode_bayar || "";
          const m2 = trx.metode_bayar_2 || "";
          const textMetode = m2 ? `${m1} & ${m2}` : m1;
          const m1Low = m1.toLowerCase();
          const m2Low = m2.toLowerCase();

          if (
            m1Low.includes("transfer") ||
            m2Low.includes("transfer") ||
            m1Low.includes("bank") ||
            m2Low.includes("bank")
          ) {
            infoBayarHtml = `
                        <div class="bg-blue-50 p-4 rounded-xl border border-blue-200 mb-4 mt-3">
                            <p class="text-xs font-bold text-blue-800 mb-2"><i class="bi bi-bank2 mr-1"></i> Informasi Transfer Bank/E-wallet (${textMetode})</p> 
                            
                            <div class="flex flex-col gap-2 text-sm bg-white p-3 rounded-lg border border-blue-100 shadow-sm">
                                <div class="flex justify-between items-center">
                                    <div><span class="text-gray-500 text-[10px] uppercase font-bold block">Atas Nama</span><span class="font-bold text-gray-900">${trx.atas_nama || "-"}</span></div>
<button data-action="salin" data-text="${trx.atas_nama || ""}" data-label="Atas Nama" class="text-blue-600 bg-blue-50 hover:bg-blue-100 p-2 rounded-lg transition-colors" title="Copy Atas Nama"><i class="bi bi-clipboard"></i></button>
                                </div>
                                <div class="w-full h-px bg-blue-50"></div>
                                <div class="flex justify-between items-center">
                                    <div><span class="text-gray-500 text-[10px] uppercase font-bold block">Nama Bank / E-Wallet</span><span class="font-bold text-gray-900">${trx.nama_bank || "-"}</span></div>
<button data-action="salin" data-text="${trx.nama_bank || ""}" data-label="Nama Bank" class="text-blue-600 bg-blue-50 hover:bg-blue-100 p-2 rounded-lg transition-colors" title="Copy Bank"><i class="bi bi-clipboard"></i></button>
                                </div>
                                <div class="w-full h-px bg-blue-50"></div>
                                <div class="flex justify-between items-center">
                                    <div><span class="text-gray-500 text-[10px] uppercase font-bold block">No. Rekening / No. HP</span><span class="font-mono font-bold text-lg text-blue-700">${trx.no_rek || "-"}</span></div>
<button data-action="salin" data-text="${trx.no_rek || ""}" data-label="No. Rekening" class="text-blue-600 bg-blue-50 hover:bg-blue-100 p-2 rounded-lg transition-colors" title="Copy No Rekening"><i class="bi bi-clipboard"></i></button>
                                </div>
                            </div>
                        </div>`;
          } else if (m1Low.includes("qris") || m2Low.includes("qris")) {
            infoBayarHtml = `
                        <div class="bg-purple-50 p-4 rounded-xl border border-purple-200 mb-4 mt-3">
                            <p class="text-xs font-bold text-purple-800 mb-2"><i class="bi bi-qr-code-scan mr-1"></i> Bukti Pembayaran QRIS (${textMetode})</p> 
                            ${
                              trx.photo_qris
                                ? `<a href="${trx.photo_qris}" target="_blank" class="block w-full h-36 bg-white rounded-lg border border-purple-200 overflow-hidden hover:opacity-90 transition shadow-sm"> 
                                <img src="${trx.photo_qris}" alt="QRIS" class="w-full h-full object-contain">
                             </a>
                             <p class="text-[11px] text-center text-purple-600 mt-2 font-medium italic">Klik gambar untuk memperbesar</p>`
                                : `<p class="text-xs text-red-500 italic bg-white p-2 rounded border border-red-100">Foto QRIS belum diunggah.</p>`
                            }
                        </div>`;
          } else {
            infoBayarHtml = `
                        <div class="bg-amber-50 p-4 rounded-xl border border-amber-200 mb-4 mt-3 flex items-start gap-3 shadow-sm">
                            <div class="bg-amber-200 p-2 rounded-full text-amber-700"> <i class="bi bi-cash-stack text-xl"></i></div>
                            <div>
                                 <p class="text-sm font-bold text-amber-900">Pembayaran ${textMetode}</p> 
                                 <p class="text-xs text-amber-800 leading-relaxed mt-1">Cek silang tabel <b>Pengeluaran (Dana Talang)</b> untuk kesesuaian nilai transaksi ini.</p> 
                            </div>
                        </div>`;
          }

          htmlVal += `
                <div class="bg-white rounded-xl border border-red-200 p-6 shadow-sm"> 
                    <div class="flex items-start justify-between mb-4 border-b border-gray-100 pb-4">
                        <div> 
                            <h3 class="font-bold text-gray-900 text-lg">${trx.penjemputan?.mitra?.nama_mitra || trx.nama_mitra_tidak_terdaftar || "Tanpa Nama Mitra"}</h3> 
                            <p class="text-sm text-gray-500 flex items-center gap-1.5">
                                Tgl Transaksi: ${trx.penjemputan?.tanggal || trx.tanggal_transaksi || "-"} 
                                ${jam ? `<span class="text-xs bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded font-mono font-bold">${waktuTampil}</span>` : ""}
                            </p>
                        </div>
                        <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-xs font-bold">Belum Lunas</span> 
                    </div>
                    
                    <div class="space-y-2 mb-2 text-sm"> ${itemHtml}
                        <div class="flex justify-between text-red-600 pt-2">
                            <span>Potongan DP</span><span>- Rp ${totalDP.toLocaleString("id-ID")}</span> 
                        </div>
                    </div>

                    ${infoBayarHtml}

                    ${(() => {
                      // 🔥 PERBAIKAN 2: Menggunakan variabel yang sudah di-parse di atas
                      const kelebihan = totalDP - subtotal;

                      return kelebihan > 0
                        ? `
                        <div class="border-t border-amber-200 pt-4 mb-6 bg-amber-50 p-4 rounded-lg border border-amber-200 -mx-6 px-6">
                          <div class="flex items-center gap-2 mb-2">
                            <i class="bi bi-info-circle-fill text-amber-600 text-lg"></i>
                            <p class="text-sm font-bold text-amber-900">Kelebihan DP</p>
                          </div>
                          <p class="text-xs text-amber-800 mb-2">Total DP yang dipotong lebih besar dari nilai subtotal transaksi ini.</p>
                          <p class="text-2xl font-black text-amber-700 font-mono">Rp ${kelebihan.toLocaleString("id-ID")}</p>
                          <p class="text-[11px] text-amber-800 mt-2 bg-amber-100/50 p-2.5 rounded border border-amber-200/60 leading-relaxed">
                            💡 <b>Tindakan:</b> Silakan kurangi sisa kelebihan DP ini secara manual di <b>Tabel Mitra</b> pada kolom <b>potongan_dp</b>.
                          </p>
                        </div>
                      `
                        : "";
                    })()}
                    
                    <div class="border-t border-gray-200 pt-4 mb-6"> 
                        <p class="text-sm text-gray-600 mb-1">Total Wajib Dibayar</p> 
                        <p class="text-3xl font-bold text-gray-900">Rp ${Number(trx.grand_total || 0).toLocaleString("id-ID")}</p>
                    </div>
                    
                    <div class="flex gap-3"> 
<button data-action="edit" data-id="${trx.id}" class="flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-blue-50 text-blue-700 border border-blue-200 rounded-xl hover:bg-blue-100 transition font-bold active:scale-95">
                            <i class="bi bi-pencil-square"></i> Edit Data 
                        </button>
                        <button data-action="validasi" data-id="${trx.id}" class="flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-green-700 text-white rounded-xl hover:bg-green-800 transition font-bold active:scale-95">
                            <i class="bi bi-check-circle"></i> Validasi Lunas 
                        </button>
                        <button data-action="hapus" data-id="${trx.id}" class="flex-none flex items-center justify-center px-4 py-3 bg-red-50 text-red-700 border border-red-200 rounded-xl hover:bg-red-100 transition font-bold active:scale-95" title="Hapus Data">
                            <i class="bi bi-trash3-fill"></i> Hapus Data
                        </button>
                    </div>
                </div>`;
        });
        valContainer.innerHTML =
          htmlVal ||
          '<p class="text-gray-500">Tidak ada transaksi yang menunggu validasi.</p>';

        const tbodyLunas = document.getElementById("riwayat-lunas-tbody");
        let htmlLunas = "";
        trxSelesai.forEach((t) => {
          const jam = t.created_at
            ? new Date(t.created_at).toLocaleTimeString("id-ID", {
                hour: "2-digit",
                minute: "2-digit",
                timeZone: "Asia/Jakarta",
              })
            : "";
          const waktuTampil = jam ? `${jam} WIB` : "";

          // 1. TAMBAHKAN BLOK KODE INI UNTUK GENERATE ID STRUK
          const dateObj = t.created_at ? new Date(t.created_at) : new Date();
          const yyyy = dateObj.getFullYear();
          const mm = String(dateObj.getMonth() + 1).padStart(2, "0");
          const dd = String(dateObj.getDate()).padStart(2, "0");
          const idStruk = `BJ-${yyyy}${mm}${dd}${t.id}`;

          // 2. Cek Metode Bayar
          let metodeText = `${t.metode_bayar || "-"}`;
          if (t.metode_bayar_2) metodeText += ` + ${t.metode_bayar_2}`;

          // 3. Buat elemen info bank KHUSUS kalau ada kata 'transfer' atau 'bank'
          let detailBankHtml = "";
          const m1Low = (t.metode_bayar || "").toLowerCase();
          const m2Low = (t.metode_bayar_2 || "").toLowerCase();

          if (
            m1Low.includes("transfer") ||
            m2Low.includes("transfer") ||
            m1Low.includes("bank") ||
            m2Low.includes("bank")
          ) {
            detailBankHtml = `
                    <div class="mt-2 p-2 bg-blue-50 rounded-lg border border-blue-100 text-xs shadow-sm">
                        <div class="font-bold text-blue-800"><i class="bi bi-bank2 mr-1"></i> ${t.nama_bank || "Bank Tidak Diisi"}</div>
                        <div class="font-mono text-blue-900 font-bold tracking-wide my-0.5">${t.no_rek || "-"}</div>
                        <div class="text-gray-600">a.n <span class="font-bold text-gray-800">${t.atas_nama || "-"}</span></div>
                    </div>`;
          }

          // 4. Render ke tabel
          htmlLunas += `
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 text-sm font-bold text-gray-900 align-top">${t.penjemputan?.mitra?.nama_mitra || t.nama_mitra_tidak_terdaftar || "Tanpa Nama Mitra"}</td>
                    <td class="px-6 py-4 text-sm text-gray-600 whitespace-nowrap align-top">
                        <div class="font-medium text-gray-900">${t.penjemputan?.tanggal || t.tanggal_transaksi || "-"}</div>
                        ${jam ? `<div class="text-[11px] text-gray-400 font-mono mt-0.5">${waktuTampil}</div>` : ""}
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-600 align-top w-1/3">
                        <div class="font-medium text-gray-800">${metodeText}</div>
                        ${detailBankHtml}
                    </td> 
                    <td class="px-6 py-4 text-sm font-bold text-green-700 text-right align-top">Rp ${Number(t.grand_total || 0).toLocaleString("id-ID")}</td>
                    <td class="px-6 py-4 text-center align-top">
<button data-action="kirim-wa" data-id="${t.id}" data-struk="${idStruk}" class="bg-green-600 hover:bg-green-700 text-white px-3 py-2 rounded-lg text-xs font-bold transition shadow-sm inline-flex items-center gap-1">
                            <i class="bi bi-whatsapp"></i> WA
                        </button>
                    </td>
                </tr>`;
        });
        tbodyLunas.innerHTML =
          htmlLunas ||
          '<tr><td colspan="4" class="text-center py-4">Data kosong</td></tr>';
      } catch (error) {
        console.error("Gagal load data:", error);
      }
    }

    // ==========================================
    // 2. TAB SWITCHING LOGIC
    // ==========================================
    const tabButtons = document.querySelectorAll(".tab-btn");
    const tabContents = document.querySelectorAll(".tab-content");

    tabButtons.forEach((button) => {
      button.addEventListener("click", function () {
        let tabName = this.getAttribute("data-tab");
        tabButtons.forEach((btn) => {
          btn.classList.remove("active", "border-green-700", "text-green-700");
          btn.classList.add("border-transparent", "text-gray-600");
        });
        tabContents.forEach((content) => {
          content.classList.add("hidden");
          content.classList.remove("block");
        });
        this.classList.add("active", "border-green-700", "text-green-700");
        this.classList.remove("border-transparent", "text-gray-600");

        const activeTab = document.getElementById(tabName);
        if (activeTab) {
          activeTab.classList.remove("hidden");
          activeTab.classList.add("block");
        }
      });
    });

    // ==========================================
    // 3. MODAL CONTROLS & FILTER
    // ==========================================
    window.openModal = function (id) {
      const m = document.getElementById(id);
      m.classList.remove("hidden");
      m.classList.add("flex");
      setTimeout(() => {
        m.classList.remove("opacity-0");
        m.querySelector("div").classList.remove("scale-95");
      }, 10);
    };
    window.closeModal = function (id) {
      const m = document.getElementById(id);
      m.classList.add("opacity-0");
      m.querySelector("div").classList.add("scale-95");
      setTimeout(() => {
        m.classList.add("hidden");
        m.classList.remove("flex");
      }, 300);
    };
    // ==========================================
    // FUNGSI COPY TEKS KE CLIPBOARD
    // ==========================================
    window.salinTeks = function (teks, label) {
      if (!teks || teks === "-")
        return alert(label + " kosong, tidak ada yang disalin!");

      navigator.clipboard
        .writeText(teks)
        .then(() => {
          alert("✅ " + label + " berhasil disalin:\n" + teks);
        })
        .catch((err) => {
          alert("❌ Gagal menyalin: " + err);
        });
    };
    window.filterTabelBeli = function () {
      const start = document.getElementById("filter-start-beli").value;
      const end = document.getElementById("filter-end-beli").value;
      const filterKomoditas = document.getElementById(
        "filter-komoditas-beli",
      ).value;

      // Peringatan jika user hanya mengisi salah satu tanggal (awal atau akhir saja)
      if ((start && !end) || (!start && end)) {
        return alert(
          "Pilih tanggal awal dan akhir untuk filter waktu, atau kosongkan keduanya jika hanya ingin memfilter komoditas!",
        );
      }

      document.querySelectorAll("#tabel-pembelian tbody tr").forEach((tr) => {
        // Abaikan baris "Memuat..." atau baris tabel kosong yang tidak memiliki atribut data
        if (!tr.hasAttribute("data-date")) return;

        const date = tr.getAttribute("data-date");
        const komoditas = tr.getAttribute("data-komoditas");

        let matchDate = true;
        if (start && end && date && date !== "-") {
          const d = new Date(date);
          const s = new Date(start);
          const e = new Date(end);
          e.setHours(23, 59, 59, 999);
          matchDate = d >= s && d <= e;
        }

        let matchKomoditas = true;
        if (filterKomoditas !== "Semua" && komoditas) {
          matchKomoditas = komoditas
            .toLowerCase()
            .includes(filterKomoditas.toLowerCase());
        }

        // Tampilkan baris HANYA JIKA lolos kedua filter (tanggal dan komoditas)
        if (matchDate && matchKomoditas) {
          tr.style.display = "";
        } else {
          tr.style.display = "none";
        }
      });

      window.hitungRingkasanPembelian();
    };

    // ==========================================
    // FUNGSI HITUNG RINGKASAN PEMBELIAN
    // ==========================================
    window.hitungRingkasanPembelian = function () {
      const elKg = document.getElementById("summary-total-kg");
      const elHargaSatuan = document.getElementById("summary-avg-harga-satuan");
      const elNominal = document.getElementById("summary-total-nominal");

      let totalKg = 0;
      let totalNominal = 0;
      let jumlahBaris = 0;

      // Hanya hitung baris yang VISIBLE (tidak ter-filter)
      document
        .querySelectorAll("#tabel-pembelian tbody tr[data-date]")
        .forEach((tr) => {
          // Skip jika baris ter-hidden oleh filter
          if (tr.style.display === "none") return;

          jumlahBaris++;

          // Ambil data langsung dari atribut HTML (lebih aman dan bebas bug format)
          const berat = parseFloat(tr.getAttribute("data-berat")) || 0;
          totalKg += berat;

          const subtotal = parseFloat(tr.getAttribute("data-subtotal")) || 0;
          totalNominal += subtotal;
        });

      // Hitung rata-rata harga per kg
      const rataHarga = totalKg > 0 ? totalNominal / totalKg : 0;

      // Update display
      if (elKg)
        elKg.innerText = totalKg > 0 ? totalKg.toLocaleString("id-ID") : "0";
      if (elHargaSatuan)
        elHargaSatuan.innerText =
          rataHarga > 0
            ? `Rp ${Math.round(rataHarga).toLocaleString("id-ID")}`
            : "Rp 0";
      if (elNominal)
        elNominal.innerText =
          totalNominal > 0
            ? `Rp ${totalNominal.toLocaleString("id-ID")}`
            : "Rp 0";
    };

    // ==========================================
    // 4. NAVIGASI STEP MODAL EDIT
    // ==========================================
    window.goToEditStep = function (step) {
      [1, 2, 3].forEach((num) => {
        const stepEl = document.getElementById(`edit-step-${num}`);
        const footerEl = document.getElementById(`footer-edit-${num}`);
        if (stepEl) {
          stepEl.classList.add("hidden");
          stepEl.classList.remove("flex");
        }
        if (footerEl) {
          footerEl.classList.add("hidden");
          footerEl.classList.remove("flex");
        }
      });

      const targetStep = document.getElementById(`edit-step-${step}`);
      const targetFooter = document.getElementById(`footer-edit-${step}`);
      if (targetStep) {
        targetStep.classList.remove("hidden");
        targetStep.classList.add("flex");
      }
      if (targetFooter) {
        targetFooter.classList.remove("hidden");
        targetFooter.classList.add("flex");
      }

      const indicator = document.getElementById("edit-step-indicator");
      if (indicator) {
        if (step === 1) indicator.innerText = "Langkah 1 dari 3: Data Pokok";
        if (step === 2)
          indicator.innerText = "Langkah 2 dari 3: Rincian Komoditas";
        if (step === 3)
          indicator.innerText = "Langkah 3 dari 3: Metode Pembayaran";
      }
    };

    // ==========================================
    // 5. AUTO KALKULASI & METODE BAYAR DINAMIS
    // ==========================================
    window.hitungTotalEdit = function () {
      let subtotal = 0;
      document.querySelectorAll(".edit-item-row").forEach((row) => {
        const vol = parseFloat(row.querySelector(".item_volume").value) || 0;
        const hrg = parseFloat(row.querySelector(".item_harga").value) || 0;
        subtotal += vol * hrg;
      });
      const dp = parseFloat(document.getElementById("edit_trx_dp").value) || 0;
      document.getElementById("edit_trx_grand_total").value = subtotal - dp;
    };

    const inputDp = document.getElementById("edit_trx_dp");
    if (inputDp) inputDp.addEventListener("input", window.hitungTotalEdit);

    window.toggleMitraManual = function () {
      const valMitra = document.getElementById("edit_trx_mitra_select").value;
      const container = document.getElementById("container_mitra_manual");
      const inputManual = document.getElementById("edit_nama_mitra_manual");

      if (valMitra === "0") {
        container.classList.remove("hidden");
        container.classList.add("block");
        inputManual.required = true;
      } else {
        container.classList.remove("block");
        container.classList.add("hidden");
        inputManual.required = false;
        inputManual.value = ""; // Reset isi jika pilih mitra terdaftar
      }
    };

    window.toggleMetode2 = function () {
      const isChecked = document.getElementById("cb_split_payment").checked;
      document.getElementById("container_metode_2").style.display = isChecked
        ? "block"
        : "none";
      document.getElementById("container_toggle_3").style.display = isChecked
        ? "block"
        : "none";

      // Kalau metode 2 dimatikan, otomatis reset dan matikan juga metode 3
      if (!isChecked) {
        document.getElementById("edit_metode_bayar_2").value =
          "Cash (Dana UMKM)";
        document.getElementById("cb_split_payment_3").checked = false;
        window.toggleMetode3();
      }
      window.renderMetodeDetails();
    };

    window.toggleMetode3 = function () {
      const isChecked = document.getElementById("cb_split_payment_3").checked;
      document.getElementById("container_metode_3").style.display = isChecked
        ? "block"
        : "none";
      if (!isChecked)
        document.getElementById("edit_metode_bayar_3").value =
          "Cash (Dana UMKM)";
      window.renderMetodeDetails();
    };

    window.renderMetodeDetails = function (trxData = null) {
      const m1 = document.getElementById("edit_metode_bayar").value;
      const isSplit2 = document.getElementById("cb_split_payment").checked;
      const isSplit3 = document.getElementById("cb_split_payment_3").checked;

      const m2 = isSplit2
        ? document.getElementById("edit_metode_bayar_2").value
        : "";
      const m3 = isSplit3
        ? document.getElementById("edit_metode_bayar_3").value
        : "";

      const hasBank =
        m1 === "Transfer" || m2 === "Transfer" || m3 === "Transfer";
      const hasQris = m1 === "QRIS" || m2 === "QRIS" || m3 === "QRIS";
      const hasDeposit =
        m1 === "Full Deposit" || m2 === "Full Deposit" || m3 === "Full Deposit";

      const payContainer = document.getElementById(
        "edit_payment_details_container",
      );
      let html = "";

      if (hasBank) {
        html += `
                <div class="p-4 bg-gray-50 border border-gray-200 rounded-xl space-y-3 shadow-sm">
                    <p class="text-xs font-bold text-gray-700 uppercase"><i class="bi bi-bank2"></i> Detail Transfer Bank/E-Wallet</p>
                    <input type="text" id="edit_atas_nama" placeholder="Atas Nama" value="${trxData?.atas_nama || ""}" class="w-full border border-gray-300 p-2.5 rounded-lg text-sm outline-none">
                    <input type="text" id="edit_nama_bank" placeholder="Nama Bank" value="${trxData?.nama_bank || ""}" class="w-full border border-gray-300 p-2.5 rounded-lg text-sm outline-none">
                    <input type="text" id="edit_no_rek" placeholder="No Rek" value="${trxData?.no_rek || ""}" class="w-full border border-gray-300 p-2.5 rounded-lg text-sm outline-none">
                </div>`;
      }
      if (hasQris) {
        html += `
                <div class="p-4 bg-gray-50 border border-gray-200 rounded-xl space-y-3 shadow-sm">
                    <p class="text-xs font-bold text-gray-700 uppercase"><i class="bi bi-qr-code"></i> Tautan QRIS</p>
                    <textarea id="edit_photo_qris_url" rows="2" placeholder="Link gambar QRIS" class="w-full border border-gray-300 p-2.5 rounded-lg text-xs outline-none">${trxData?.photo_qris || ""}</textarea> 
                </div>`;
      }

      if (hasDeposit) {
        html += `
                <div class="p-4 bg-teal-50 border border-teal-200 rounded-xl flex items-start gap-3 shadow-sm mb-3">
                    <div class="bg-teal-200 p-1.5 rounded-full text-teal-700 shrink-0"><i class="bi bi-wallet2"></i></div>
                    <div>
                        <p class="text-xs font-bold text-teal-900">Pembayaran via Deposit</p>
                        <p class="text-[10px] text-teal-800 mt-1 leading-relaxed">
                            Pembayaran transaksi ini akan memotong / dialihkan ke Saldo Deposit Mitra terkait.
                        </p>
                    </div>
                </div>`;
      }

      if (m1.includes("Cash") || m2.includes("Cash") || m3.includes("Cash")) {
        let sumber = [];
        if (
          m1 === "Cash (Dana UMKM)" ||
          m2 === "Cash (Dana UMKM)" ||
          m3 === "Cash (Dana UMKM)"
        )
          sumber.push("Dana UMKM");
        if (
          m1 === "Cash (Talangan Karyawan)" ||
          m2 === "Cash (Talangan Karyawan)" ||
          m3 === "Cash (Talangan Karyawan)"
        )
          sumber.push("Talangan Karyawan");

        let pesanTambahan = sumber.includes("Dana UMKM")
          ? '<span class="text-green-700">Dana UMKM aman, tidak perlu update rincian pengeluaran lagi.</span>'
          : '<span class="text-red-600">Perhatian: Pastikan talangan karyawan dicatat di Pengeluaran!</span>';

        html += `
                <div class="p-4 bg-amber-50 border border-amber-200 rounded-xl flex items-start gap-3 shadow-sm">
                    <div class="bg-amber-200 p-1.5 rounded-full text-amber-700 shrink-0"><i class="bi bi-cash-stack"></i></div>
                    <div>
                        <p class="text-xs font-bold text-amber-900">Pembayaran Tunai</p>
                        <p class="text-[10px] text-amber-800 mt-1 leading-relaxed">
                            Sumber Dana: <b>${sumber.join(" & ")}</b>.<br/>
                            ${pesanTambahan}
                        </p>
                    </div>
                </div>`;
      }
      payContainer.innerHTML = html;
    };

    // ==========================================
    // 6. VALIDASI & EDIT TRANSAKSI (FUNGSI UTAMA)
    // ==========================================
    window.validasiBayar = async function (trxId) {
      if (processingIds.has(trxId)) return;
      if (
        !confirm(
          "Tandai transaksi ini sudah dibayar LUNAS?\n\n(Perhatian: Stok gudang akan otomatis bertambah, dan rekap performa Mitra akan di-update)",
        )
      )
        return;
      if (!window.supabase) return;

      processingIds.add(trxId);
      try {
        const { error } = await window.supabase.rpc(
          "validasi_pembayaran_mitra",
          { p_trx_id: trxId },
        );
        if (error) throw error;

        alert(
          "Transaksi divalidasi Lunas. Stok Gudang, Performa Profil Mitra, dan Rekap Bulanan berhasil di-update otomatis.",
        );
        window.location.reload();
      } catch (err) {
        alert("Gagal memproses validasi & stok: " + err.message);
        processingIds.delete(trxId);
      }
    };

    // ==========================================
    // FUNGSI HAPUS TRANSAKSI
    // ==========================================
    window.hapusTransaksi = async function (trxId) {
      if (processingIds.has(trxId)) return;
      if (
        !confirm(
          "🚨 PERINGATAN KRITIS 🚨\n\nApakah Anda yakin ingin MENGHAPUS transaksi ini secara permanen?\n\nSistem akan secara otomatis:\n- Mengurangi stok gudang\n- Mengembalikan saldo deposit mitra (jika ada)\n- Menghapus riwayat talangan karyawan (jika ada)",
        )
      )
        return;

      if (!window.supabase) return;

      processingIds.add(trxId);
      try {
        const { error } = await window.supabase.rpc("hapus_transaksi_mitra", {
          p_trx_id: parseInt(trxId),
        });

        if (error) throw error;

        alert(
          "✅ Data transaksi berhasil dihapus beserta seluruh riwayat terkaitnya.",
        );
        window.location.reload();
      } catch (err) {
        console.error("Gagal hapus transaksi:", err);
        alert("❌ Gagal menghapus transaksi: " + err.message);
        processingIds.delete(trxId);
      }
    };

    window.bukaModalEditTrx = function (trxId) {
      window.goToEditStep(1);
      const trx = window.dataTransaksiGlobal.find(
        (t) => String(t.id) === String(trxId),
      );
      if (!trx) return alert("Data transaksi tidak ditemukan!");

      // Pengecekan aman (Defensif) sebelum isi value
      const elTrxId = document.getElementById("edit_trx_id");
      if (elTrxId) elTrxId.value = trx.id;

      const elPenjemputanId = document.getElementById("edit_penjemputan_id");
      if (elPenjemputanId) elPenjemputanId.value = trx.penjemputan_id || "";

      const elTrxTgl = document.getElementById("edit_trx_tgl");
      if (elTrxTgl)
        elTrxTgl.value =
          trx.penjemputan?.tanggal || trx.tanggal_transaksi || "";

      const elTrxDp = document.getElementById("edit_trx_dp");
      if (elTrxDp) elTrxDp.value = trx.potongan_dp || 0;

      let optMitra = "";
      const currentMitraId = trx.penjemputan?.mitra?.id || trx.mitra_id || null;
      const fallbackName =
        trx.nama_mitra_tidak_terdaftar || "Timbang Mandiri / Tidak Terdaftar";
      optMitra += `<option value="0" ${currentMitraId === null ? "selected" : ""}>${currentMitraId === null ? fallbackName : "Timbang Mandiri / Tidak Terdaftar"}</option>`;
      if (window.allMitraGlobal) {
        window.allMitraGlobal.forEach((m) => {
          const selected =
            currentMitraId && String(m.id) === String(currentMitraId)
              ? "selected"
              : "";
          optMitra += `<option value="${m.id}" ${selected}>${m.nama_mitra}</option>`;
        });
      }

      const elMitraSelect = document.getElementById("edit_trx_mitra_select");
      if (elMitraSelect) elMitraSelect.innerHTML = optMitra;

      const inputManual = document.getElementById("edit_nama_mitra_manual");
      if (inputManual) {
        if (currentMitraId === null) {
          inputManual.value = trx.nama_mitra_tidak_terdaftar || "";
        } else {
          inputManual.value = "";
        }
      }

      window.toggleMitraManual();

      let itemsHtml = "";
      if (trx.transaksi_item && trx.transaksi_item.length > 0) {
        trx.transaksi_item.forEach((item, index) => {
          itemsHtml += `
                <div class="edit-item-row p-4 bg-gray-50 border border-gray-200 rounded-xl relative space-y-3 shadow-sm">
                    <span class="inline-block bg-blue-100 text-blue-800 text-[10px] font-bold px-2 py-0.5 rounded-full border border-blue-200 mb-1">Barang Ke-${index + 1}: ${item.komoditas}</span> 
                    <input type="hidden" class="item_id" value="${item.id}"> 
                    
                    <div class="w-full">
                        <label class="block text-[10px] font-bold text-gray-500 uppercase">Berat (Kg)</label> 
                        <input type="number" step="0.1" class="item_volume w-full border border-gray-300 rounded-lg p-2 text-sm outline-none bg-white font-semibold" value="${item.volume}" oninput="window.hitungTotalEdit()" required>
                    </div>
                    <div class="w-full">
                        <label class="block text-[10px] font-bold text-gray-500 uppercase">Harga / Kg (Rp)</label> 
                        <input type="number" class="item_harga w-full border border-gray-300 rounded-lg p-2 text-sm outline-none bg-white font-semibold" value="${item.harga_unit}" oninput="window.hitungTotalEdit()" required>
                    </div>
                 </div>`;
        });
      } else {
        itemsHtml = `<p class="text-sm text-red-500 italic">Transaksi ini tidak memiliki rincian komoditas.</p>`;
      }

      const elItemsContainer = document.getElementById("edit_items_container");
      if (elItemsContainer) elItemsContainer.innerHTML = itemsHtml;

      const elGrandTotal = document.getElementById("edit_trx_grand_total");
      if (elGrandTotal) elGrandTotal.value = trx.grand_total || 0;

      let rawM1 = trx.metode_bayar || "";
      let rawM2 = trx.metode_bayar_2 || "";
      let rawM3 = trx.metode_bayar_3 || "";
      if (rawM1.includes("&")) {
        const splitData = rawM1.split("&").map((s) => s.trim());
        rawM1 = splitData[0] || "";
        rawM2 = splitData[1] || "";
        rawM3 = splitData[2] || "";
      }

      const mappingMetode = (val) => {
        if (!val) return null;
        val = val.toLowerCase();
        if (val.includes("talangan") || val.includes("karyawan"))
          return "Cash (Talangan Karyawan)";
        if (val.includes("transfer") || val.includes("bank")) return "Transfer";
        if (val.includes("qris")) return "QRIS";
        if (val.includes("deposit")) return "Full Deposit";
        return "Cash (Dana UMKM)";
      };

      const finalM1 = mappingMetode(rawM1) || "Cash (Dana UMKM)";
      const finalM2 = mappingMetode(rawM2);
      const finalM3 = mappingMetode(rawM3);

      const elMetodeBayar = document.getElementById("edit_metode_bayar");
      if (elMetodeBayar) elMetodeBayar.value = finalM1;

      const cbSplit = document.getElementById("cb_split_payment");
      const containerMetode2 = document.getElementById("container_metode_2");
      const elMetodeBayar2 = document.getElementById("edit_metode_bayar_2");
      const containerToggle3 = document.getElementById("container_toggle_3");

      if (finalM2) {
        if (cbSplit) cbSplit.checked = true;
        if (containerMetode2) containerMetode2.style.display = "block";
        if (elMetodeBayar2) elMetodeBayar2.value = finalM2;
        if (containerToggle3) containerToggle3.style.display = "block";
      } else {
        if (cbSplit) cbSplit.checked = false;
        if (containerMetode2) containerMetode2.style.display = "none";
        if (elMetodeBayar2) elMetodeBayar2.value = "Cash (Dana UMKM)";
        if (containerToggle3) containerToggle3.style.display = "none";
      }

      const cbSplit3 = document.getElementById("cb_split_payment_3");
      const containerMetode3 = document.getElementById("container_metode_3");
      const elMetodeBayar3 = document.getElementById("edit_metode_bayar_3");

      if (finalM3) {
        if (cbSplit3) cbSplit3.checked = true;
        if (containerMetode3) containerMetode3.style.display = "block";
        if (elMetodeBayar3) elMetodeBayar3.value = finalM3;
      } else {
        if (cbSplit3) cbSplit3.checked = false;
        if (containerMetode3) containerMetode3.style.display = "none";
        if (elMetodeBayar3) elMetodeBayar3.value = "Cash (Dana UMKM)";
      }

      window.renderMetodeDetails(trx);
      window.openModal("modal-edit-transaksi");
    };

    window.simpanEditTransaksi = async function (e) {
      e.preventDefault();
      if (!window.supabase) return;

      // 1. Ambil Tanggal (Wajib) secara aman
      const elTgl = document.getElementById("edit_trx_tgl");
      const tglBaru = elTgl ? elTgl.value : "";
      if (!tglBaru) {
        if (typeof window.goToEditStep === "function") window.goToEditStep(1);
        return alert("Tanggal transaksi wajib diisi!");
      }

      // 🔍 JARING PENGAMAN: Ambil ID Transaksi (Cek id 'edit_trx_id' atau 'edit_id')
      // Kita paksa diconvert ke Integer (Angka) biar dibaca BigInt oleh Supabase
      const rawTrxId =
        document.getElementById("edit_trx_id")?.value ||
        document.getElementById("edit_id")?.value;
      const trxId = rawTrxId ? parseInt(rawTrxId) : null;

      // Jika ID Utama ini tidak ketemu, kita batalkan proses daripada bikin database crash
      if (!trxId) {
        return alert(
          "❌ Gagal menyimpan: ID Transaksi tidak ditemukan atau kosong!",
        );
      }

      const btn = document.getElementById("btn-save-trx");
      if (btn) {
        btn.innerText = "Menyimpan...";
        btn.disabled = true;
      }

      try {
        // 2. TANGKAP DATA LAINNYA
        const penjemputanIdRaw = document.getElementById(
          "edit_penjemputan_id",
        )?.value;
        const penjemputanId = penjemputanIdRaw
          ? parseInt(penjemputanIdRaw)
          : null;

        const mitraIdRaw = document.getElementById(
          "edit_trx_mitra_select",
        )?.value;
        const mitraIdTerpilih =
          mitraIdRaw === "0" || !mitraIdRaw ? null : parseInt(mitraIdRaw);

        const namaMitraManualText =
          document.getElementById("edit_nama_mitra_manual")?.value || null;

        const dpBaru =
          parseFloat(document.getElementById("edit_trx_dp")?.value) || 0;
        const totalManual =
          parseFloat(document.getElementById("edit_trx_grand_total")?.value) ||
          0;

        // 3. AMBIL METODE BAYAR
        const m1 = document.getElementById("edit_metode_bayar")?.value || "";
        const isSplit = document.getElementById("cb_split_payment")?.checked;
        const m2 = isSplit
          ? document.getElementById("edit_metode_bayar_2")?.value || ""
          : "";

        // 4. AMBIL INFO BANK
        const namaBank =
          document.getElementById("edit_nama_bank")?.value || null;
        const noRek = document.getElementById("edit_no_rek")?.value || null;
        const atasNama =
          document.getElementById("edit_atas_nama")?.value || null;
        const photoQris =
          document.getElementById("edit_photo_qris_url")?.value || null;

        // 5. LOOPING ITEMS
        const itemsPayload = [];
        const itemRows = document.querySelectorAll(".edit-item-row");
        itemRows.forEach((row) => {
          const itemId = row.querySelector(".item_id")?.value;
          const volBaru =
            parseFloat(row.querySelector(".item_volume")?.value) || 0;
          const hargaBaru =
            parseFloat(row.querySelector(".item_harga")?.value) || 0;
          if (itemId)
            itemsPayload.push({
              id: parseInt(itemId),
              volume: volBaru,
              harga_unit: hargaBaru,
            });
        });

        // 6. TEMBAK DATABASE (Pastikan p_trx_id tertembak dengan angka valid)
        const { error } = await window.supabase.rpc("edit_transaksi_mitra", {
          p_trx_id: trxId, // 🔥 Diisi dengan angka Integer hasil convert di atas
          p_penjemputan_id: penjemputanId,
          p_mitra_id: mitraIdTerpilih,
          p_nama_mitra_tidak_terdaftar: namaMitraManualText,
          p_tanggal: tglBaru,
          p_potongan_dp: dpBaru,
          p_grand_total: totalManual,
          p_metode_bayar: m1,
          p_metode_bayar_2: m2,
          p_nama_bank: namaBank,
          p_no_rek: noRek,
          p_atas_nama: atasNama,
          p_photo_qris: photoQris,
          p_items: itemsPayload,
        });

        if (error) throw error;
        alert(
          "Mantap! Seluruh data transaksi & pembayaran berhasil di-update!",
        );
        window.location.reload();
      } catch (err) {
        console.error(err);
        alert("Gagal menyimpan transaksi: " + err.message);
        if (btn) {
          btn.innerText = "SIMPAN PERUBAHAN";
          btn.disabled = false;
        }
      }
    };
    // ==========================================
    // 7A. FUNGSI PENGISI DATA TEMPLATE STRUK HTML
    // ==========================================
    window.siapkanDataStruk = function (trx, idStruk) {
      // 1. Ambil data dasar
      const tanggalTrx =
        trx.penjemputan?.tanggal || trx.tanggal_transaksi || "-";
      const namaPenjual =
        trx.penjemputan?.mitra?.nama_mitra ||
        trx.nama_mitra_tidak_terdaftar ||
        "Tanpa Nama Mitra";
      const namaDriver = trx.driver?.nama || "Driver Tidak Diketahui";

      // 2. Tembak ke elemen HTML dasar
      document.getElementById("str-target-tanggal").innerText =
        `: ${tanggalTrx}`;
      document.getElementById("str-target-penjual").innerText =
        `: ${namaPenjual}`;
      document.getElementById("str-target-driver").innerText =
        `: ${namaDriver}`;
      document.getElementById("str-target-id").innerText = `ID: ${idStruk}`;

      // 3. Looping detail barang & hitung total kotor
      let detailBarangHtml = "";
      let totalKotor = 0;

      if (trx.transaksi_item && trx.transaksi_item.length > 0) {
        trx.transaksi_item.forEach((item) => {
          const sub = item.volume * item.harga_unit;
          totalKotor += sub;
          // Render baris HTML untuk setiap item (gaya inline CSS biar aman di-convert)
          detailBarangHtml += `
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 8px;">
                        <div style="display: flex; flex-direction: column;">
                            <span style="font-weight: 600; color: #333;">${item.komoditas}</span>
                            <span style="color: #666; font-size: 10px; margin-top: 2px;">${item.volume} kg x Rp ${item.harga_unit.toLocaleString("id-ID")}</span>
                        </div>
                        <div style="font-weight: 600;">Rp ${sub.toLocaleString("id-ID")}</div>
                    </div>
                `;
        });
      } else {
        detailBarangHtml = `<div style="font-size: 11px; font-style: italic; color: #999;">Tidak ada rincian barang</div>`;
      }
      document.getElementById("str-target-items").innerHTML = detailBarangHtml;

      // 4. Isi ringkasan pembayaran
      const dp = trx.potongan_dp || 0;
      const sisa = trx.grand_total || 0;
      let metodeText = `${trx.metode_bayar || "-"}`;
      if (trx.metode_bayar_2) metodeText += ` + ${trx.metode_bayar_2}`;

      document.getElementById("str-target-total").innerText =
        `Rp ${totalKotor.toLocaleString("id-ID")}`;
      document.getElementById("str-target-dp").innerText =
        `Rp ${dp.toLocaleString("id-ID")}`;
      document.getElementById("str-target-sisa").innerText =
        `Rp ${sisa.toLocaleString("id-ID")}`;
      document.getElementById("str-target-metode").innerText = metodeText;
    };

    // ==========================================
    // 7. GENERATE STRUK GAMBAR & KIRIM WHATSAPP
    // ==========================================
    window.kirimStrukWA = async function (trxId, idStruk) {
      const trx = window.riwayatLunasGlobal?.find(
        (t) => String(t.id) === String(trxId),
      );
      if (!trx) return alert("❌ Data transaksi tidak ditemukan!");

      let noHp = trx.penjemputan?.mitra?.nomor_hp || "";

      // JARING PENGAMAN: Kalau nomor HP kosong (misal mitra manual / timbang mandiri)
      if (!noHp) {
        // Munculkan popup input di layar kasir
        const inputHp = prompt(
          `⚠️ Nomor HP Mitra tidak ditemukan di database.\n\nSilakan masukkan nomor HP / WhatsApp tujuan untuk mengirim ID Struk ${idStruk}:`,
          "08",
        );

        // Kalau kasir klik cancel, batalkan proses
        if (inputHp === null) return;

        // Kalau kasir langsung klik OK tapi kosong
        if (!inputHp.trim() || inputHp === "08") {
          return alert("❌ Proses dibatalkan karena Nomor HP tidak diisi!");
        }

        noHp = inputHp;
      }

      // Bersihkan dan format nomor HP (Sama kayak kode lama lu)
      noHp = noHp.replace(/\D/g, "");
      if (noHp.startsWith("620")) noHp = "62" + noHp.substring(3);
      else if (noHp.startsWith("0")) noHp = "62" + noHp.substring(1);
      else if (noHp.startsWith("8")) noHp = "62" + noHp;

      // 1. Tembak data ke template HTML (Menggunakan fungsi Tahap 2)
      window.siapkanDataStruk(trx, idStruk);

      // 2. Persiapkan elemen agar bisa difoto html2canvas
      const targetEl = document.getElementById("struk-wa-template");
      const wrapper = targetEl.parentElement; // Ini div class="hidden" dari Tahap 1

      // Tampilkan sementara di luar layar (biar html2canvas bisa baca)
      wrapper.classList.remove("hidden");
      wrapper.style.position = "absolute";
      wrapper.style.top = "-9999px";
      wrapper.style.left = "-9999px";

      try {
        // 3. Render HTML menjadi Canvas
        const canvas = await html2canvas(targetEl, {
          scale: 2, // Resolusi 2x lipat biar teks struknya tajam / gak pecah
          useCORS: true, // Izin baca gambar/logo dari luar
          backgroundColor: "#ffffff",
        });

        // Kembalikan ke mode hidden
        wrapper.classList.add("hidden");
        wrapper.style.position = "";
        wrapper.style.top = "";
        wrapper.style.left = "";

        // 4. Ubah Canvas jadi Blob (File Gambar)
        canvas.toBlob(async (blob) => {
          if (!blob) return alert("Gagal membuat gambar struk!");

          const fileName = `${idStruk}.png`;
          const file = new File([blob], fileName, { type: "image/png" });
          // Ganti bagian const textWA yang lama dengan ini:
          const textWA = `Terima kasih Kak 🙏\nTransaksi sudah kami verifikasi dan berhasil diproses.\nKami sangat menghargai kepercayaan Kakak kepada Bang Jelantah Purwakarta. 😊\n\nID Struk: ${idStruk}`;

          // 5. CABANG LOGIKA: HP (Mobile) vs Laptop (Desktop)
          // Cek apakah browser support Web Share API (biasanya di HP)
          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            try {
              // Di HP: Akan muncul popup "Share via WhatsApp" bawaan HP (langsung sama gambarnya)
              await navigator.share({
                files: [file],
                title: "Struk Bang Jelantah",
                text: textWA,
              });
            } catch (err) {
              console.log("Share dibatalkan user:", err);
            }
          } else {
            // Fallback untuk Desktop/Laptop (WA Web gak support direct attachment via link)
            // a. Download gambar ke laptop otomatis
            const downloadUrl = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = downloadUrl;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(downloadUrl);

            // b. Kasih notif ke kasir & buka WA Web
            alert(
              '📥 Gambar struk otomatis ter-download ke laptop!\n\nSilakan klik "Attach / Lampirkan Gambar" di WhatsApp Web lalu pilih file gambar yang baru saja di-download.',
            );
            const waUrl = `https://wa.me/${noHp}?text=${encodeURIComponent(textWA)}`;
            window.open(waUrl, "_blank");
          }
        }, "image/png");
      } catch (error) {
        console.error("Error jepret struk:", error);
        alert("Terjadi kesalahan saat memproses gambar struk.");
        // Pastikan disembunyikan lagi kalau error
        wrapper.classList.add("hidden");
      }
    };
    // Event delegation for data-action buttons
    document.addEventListener("click", function (e) {
      const btn = e.target.closest("[data-action]");
      if (!btn) return;
      const action = btn.getAttribute("data-action");
      const id = btn.getAttribute("data-id");
      if (action === "salin") {
        window.salinTeks(
          btn.getAttribute("data-text"),
          btn.getAttribute("data-label"),
        );
      } else if (action === "edit") {
        window.bukaModalEditTrx(id);
      } else if (action === "validasi") {
        window.validasiBayar(id);
      } else if (action === "hapus") {
        window.hapusTransaksi(id);
      } else if (action === "kirim-wa") {
        window.kirimStrukWA(id, btn.getAttribute("data-struk"));
      }
    });

    await loadData();
  });
</script>
