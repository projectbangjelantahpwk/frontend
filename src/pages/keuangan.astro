    window.updateUangJalan = async function() {
        if(!window.supabase) return;
        const empId = document.getElementById('m_karyawan_id').value;
        const uangJalan = document.getElementById('m_input_uang_jalan').value;
        const periodeSekarang = new Date().toISOString().split('T')[0]; //YYYY-MM-DD
        
