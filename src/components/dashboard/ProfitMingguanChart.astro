---
// src/components/dashboard/ProfitMingguanChart.astro
---

<div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline-variant shadow-md flex flex-col min-h-[550px] hover:shadow-lg transition-all duration-300">
    
    <div class="flex flex-col xl:flex-row justify-between items-start xl:items-center gap-4 mb-6 border-b border-outline-variant pb-5">
        <div>
            <h3 class="font-headline-md text-on-surface flex items-center gap-2 font-bold">
                <i class="bi bi-graph-up-arrow text-primary"></i> Analisis Profit & Keuangan
            </h3>
            <p class="text-label-sm text-on-surface-variant font-medium">Perbandingan Bruto, Gaji, Pengeluaran & Profit Bersih Mingguan</p>
        </div>
        
        <div class="flex items-center gap-2 bg-surface-container-low p-2 rounded-xl border border-outline-variant shadow-inner">
            <span class="text-[10px] font-black text-on-surface-variant uppercase tracking-widest ml-1">Pilih Bulan:</span>
            <input type="month" id="profit-month-filter" class="bg-white border border-outline px-3 py-1.5 rounded-lg text-xs font-bold text-primary outline-none focus:ring-2 focus:ring-primary/20 cursor-pointer">
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 flex-grow">
        
        <div class="lg:col-span-8 flex flex-col h-full min-h-[350px]">
            <div class="flex gap-4 mb-4 flex-wrap">
                <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-blue-500"></span><span class="text-[10px] font-bold text-gray-500 uppercase">Bruto</span></div>
                <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-red-500"></span><span class="text-[10px] font-bold text-gray-500 uppercase">Pengeluaran</span></div>
                <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-orange-500"></span><span class="text-[10px] font-bold text-gray-500 uppercase">Total Gaji</span></div>
                <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-green-500"></span><span class="text-[10px] font-bold text-gray-500 uppercase">Net Profit</span></div>
            </div>
            <div class="relative flex-grow">
                <canvas id="canvasProfitMaster"></canvas>
            </div>
            <p class="text-[10px] text-center text-on-surface-variant mt-2 italic font-medium">💡 Tip: Klik salah satu titik W pada grafik untuk membedah rincian biaya.</p>
        </div>

        <div class="lg:col-span-4 bg-surface-container-low/50 rounded-2xl p-5 border border-outline-variant/50 flex flex-col">
            <div class="flex justify-between items-center mb-4 border-b border-outline-variant pb-3">
                <h4 id="detail-week-label" class="font-bold text-primary text-sm uppercase tracking-tighter">Pilih Minggu</h4>
                <span id="detail-status-tag" class="text-[9px] font-black bg-primary/10 text-primary px-2 py-0.5 rounded">KLIK CHART</span>
            </div>

            <div id="profit-detail-container" class="space-y-4 flex-grow overflow-y-auto custom-scrollbar max-h-[300px] pr-2">
                <div class="flex flex-col items-center justify-center h-full opacity-40 text-center py-10">
                    <i class="bi bi-cursor-fill text-3xl mb-2"></i>
                    <p class="text-xs font-bold">Pilih salah satu titik W pada grafik<br>untuk melihat rincian</p>
                </div>
            </div>

            <div class="mt-4 pt-4 border-t-2 border-dashed border-outline-variant">
                <div class="flex justify-between items-end">
                    <span class="text-[10px] font-bold text-on-surface-variant uppercase">Minggu Bersih (Profit)</span>
                    <span id="detail-net-profit" class="text-xl font-black text-green-600 font-mono">Rp 0</span>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    import { supabase } from '../../lib/supabase';
    import Chart from 'chart.js/auto';

    const formatRp = (n) => 'Rp ' + Number(n).toLocaleString('id-ID', { minimumFractionDigits: 0 });
    
    let chartInstance = null;
    let localProfitData = []; 

    const monthPicker = document.getElementById('profit-month-filter');
    const detailLabel = document.getElementById('detail-week-label');
    const detailContainer = document.getElementById('profit-detail-container');
    const netProfitTxt = document.getElementById('detail-net-profit');

    // 1. FETCH DATA LANGSUNG DARI TABEL profit_mingguan
    // 1. FETCH DATA LANGSUNG DARI TABEL profit_mingguan BERDASARKAN PERIODE
    async function fetchProfitMingguanData() {
        const blnRaw = monthPicker.value; // Format dari input HTML: "YYYY-MM"
        if (!blnRaw) return;

        try {
            // 🔥 KONSISTEN: Konversi dari YYYY-MM menjadi MM-YYYY sesuai format kolom periode di DB
            const parts = blnRaw.split('-');
            const formatDbPeriode = `${parts[1]}-${parts[0]}`; // Hasil: "06-2026"

            // 🔥 PERBAIKAN 1: Query sekarang langsung menyasar kolom 'periode' (jauh lebih cepat & aman)
            const { data, error } = await supabase
                .from('profit_mingguan')
                .select('*')
                .eq('periode', formatDbPeriode)
                .order('tanggal_mulai', { ascending: true });

            if (error) throw error;

            // 🔥 PERBAIKAN 2: weekLabel sekarang diambil langsung dari kolom 'minggu_ke' hasil kalkulasi DB
            localProfitData = (data || []).map((row) => {
                return {
                    weekLabel: row.minggu_ke, // Otomatis bernilai "W1", "W2", dst dari fungsi SQL baru kamu
                    tanggal_mulai: row.tanggal_mulai,
                    tanggal_selesai: row.tanggal_selesai,
                    total_bruto: parseFloat(row.total_bruto) || 0,
                    pengeluaran: parseFloat(row.pengeluaran) || 0,
                    total_gaji: parseFloat(row.total_gaji) || 0,
                    profit: parseFloat(row.profit) || 0
                };
            });

            renderProfitChart();
        } catch (e) { 
            console.error("🛑 Gagal memuat data profit_mingguan:", e); 
        }
    }

    // 2. BUILD LINE CHART MENGGUNAKAN CHART.JS
    function renderProfitChart() {
        const ctx = document.getElementById('canvasProfitMaster').getContext('2d');
        const labels = localProfitData.map(d => d.weekLabel); // Menggunakan label W hasil auto-suntik

        if (chartInstance) chartInstance.destroy();

        chartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    { label: 'Bruto', data: localProfitData.map(d => d.total_bruto), borderColor: '#3b82f6', tension: 0.2, pointRadius: 5 },
                    { label: 'Pengeluaran', data: localProfitData.map(d => d.pengeluaran), borderColor: '#ef4444', tension: 0.2 },
                    { label: 'Total Gaji', data: localProfitData.map(d => d.total_gaji), borderColor: '#f97316', tension: 0.2 },
                    { label: 'Net Profit', data: localProfitData.map(d => d.profit), borderColor: '#22c55e', borderWidth: 4, tension: 0.2, fill: true, backgroundColor: 'rgba(34, 197, 94, 0.03)' }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                onClick: (e, activeEls) => {
                    if (activeEls.length > 0) {
                        const index = activeEls[0].index;
                        showFinancialDetail(index);
                    }
                },
                scales: {
                    y: { 
                        ticks: { callback: (val) => 'Rp ' + (val / 1000000) + 'jt' },
                        grid: { color: '#f3f4f6' }
                    },
                    x: { grid: { display: false } }
                },
                plugins: { legend: { display: false } }
            }
        });
    }

    // 3. RENDER PROGRESS BAR SISI KANAN SAAT TITIK W DIKLIK
    function showFinancialDetail(idx) {
        const data = localProfitData[idx];
        if (!data) return;

        detailLabel.innerText = `Rincian ${data.weekLabel}`;
        document.getElementById('detail-status-tag').innerText = "TERPILIH";
        netProfitTxt.innerText = formatRp(data.profit);

        // Cari persentase beban terhadap bruto pendapatan kotor
        const pctGaji = data.total_bruto > 0 ? Math.round((data.total_gaji / data.total_bruto) * 100) : 0;
        const pctKeluar = data.total_bruto > 0 ? Math.round((data.pengeluaran / data.total_bruto) * 100) : 0;
        const pctProfit = data.total_bruto > 0 ? Math.round((data.profit / data.total_bruto) * 100) : 0;

        let html = `
            <div class="space-y-4 animate-in fade-in slide-in-from-right-4 duration-300">
                <div class="text-center bg-gray-100 py-1.5 px-3 rounded-lg border border-gray-200">
                    <p class="text-[9px] font-black text-gray-500 uppercase tracking-wider">Rentang Periode Asli</p>
                    <p class="text-xs font-mono font-bold text-gray-700">${data.tanggal_mulai} s/d ${data.tanggal_selesai}</p>
                </div>

                <div class="bg-blue-50 p-3 rounded-xl border border-blue-100">
                    <div class="flex justify-between text-[11px] font-black text-blue-700 uppercase mb-1"><span>Total Bruto</span><span>${formatRp(data.total_bruto)}</span></div>
                    <div class="h-1.5 bg-blue-200 rounded-full"><div class="h-full bg-blue-600 rounded-full" style="width: 100%"></div></div>
                </div>

                <div class="space-y-1">
                    <div class="flex justify-between text-[10px] font-bold text-orange-600 uppercase"><span>Beban Gaji</span><span>${formatRp(data.total_gaji)} (${pctGaji}%)</span></div>
                    <div class="h-1.5 bg-orange-100 rounded-full overflow-hidden">
                        <div class="h-full bg-orange-500 rounded-full" style="width: ${pctGaji > 100 ? 100 : pctGaji}%"></div>
                    </div>
                </div>

                <div class="space-y-1">
                    <div class="flex justify-between text-[10px] font-bold text-red-600 uppercase"><span>Beban Pengeluaran</span><span>${formatRp(data.pengeluaran)} (${pctKeluar}%)</span></div>
                    <div class="h-1.5 bg-red-100 rounded-full overflow-hidden">
                        <div class="h-full bg-red-500 rounded-full" style="width: ${pctKeluar > 100 ? 100 : pctKeluar}%"></div>
                    </div>
                </div>

                <div class="space-y-1 pt-2">
                    <div class="flex justify-between text-[10px] font-bold text-green-600 uppercase"><span>Profit Margin Ratio</span><span>${pctProfit}%</span></div>
                    <div class="h-1.5 bg-green-100 rounded-full overflow-hidden">
                        <div class="h-full bg-green-500 rounded-full" style="width: ${pctProfit < 0 ? 0 : (pctProfit > 100 ? 100 : pctProfit)}%"></div>
                    </div>
                </div>
            </div>
        `;
        detailContainer.innerHTML = html;
    }

    // Inisialisasi awal saat DOM siap
    document.addEventListener('DOMContentLoaded', () => {
        const now = new Date();
        // Pasang default input ke bulan berjalan
        monthPicker.value = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
        
        fetchProfitMingguanData();
        monthPicker.addEventListener('change', fetchProfitMingguanData);
    });
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 3px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 10px; }
</style>