        document.getElementById("tabelStockHarian").innerHTML =
          html ||
          '<tr><td colspan="9" class="text-center py-4 text-gray-500">Tidak ada data stok harian</td></tr>';
        document.querySelectorAll(".edit-stock-btn").forEach((btn) => {
          btn.addEventListener("click", function () {
            editStockHarian(this.getAttribute("data-id"));
