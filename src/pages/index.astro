---
// pages/index.astro
import Layout from '../layouts/Layout.astro';
import KPICard from '../components/dashboard/KPICard.astro';
import StokKomoditasChart from '../components/dashboard/StokKomoditasChart.astro';
import TransaksiKomoditasChart from '../components/dashboard/TransaksiKomoditasChart.astro';
import SumberTransaksiChart from '../components/dashboard/SumberTransaksiChart.astro';
import LeaderboardMitra from '../components/dashboard/LeaderboardMitra.astro';
import BestEmployees from '../components/dashboard/BestEmployees.astro';
import BukuKasHarian from '../components/dashboard/BukuKasHarian.astro';
import SalesMetricsWithProgress from '../components/dashboard/SalesMetricsWithProgress.astro';
import SalaryMetricsWithProgress from '../components/dashboard/SalaryMetricsWithProgress.astro';
import ExpenditureMetricsWithProgress from '../components/dashboard/ExpenditureMetricsWithProgress.astro';
import { supabase } from '../lib/supabase';

// Data Leaderboard
const { data: leaderboardRaw } = await supabase
  .from('mitra')
  .select('*')
  .order('total_transaksi', { ascending: false })
  .limit(5);

const leaderboardData = leaderboardRaw?.map((item, idx) => ({
  rank: idx + 1,
  name: item.nama_mitra,
  total: item.total_transaksi,
  revenue: `Rp ${(item.total_transaksi * 50000).toLocaleString('id-ID')}`,
  rating: 4.5 + (5 - idx) * 0.1,
  bgColor: idx === 0 ? "from-yellow-500/10 to-yellow-500/5" : idx === 1 ? "from-gray-400/10 to-gray-400/5" : idx === 2 ? "from-orange-600/10 to-orange-600/5" : "from-surface-container to-surface-container",
  rankColor: idx === 0 ? "bg-yellow-500" : idx === 1 ? "bg-gray-400" : idx === 2 ? "bg-orange-600" : "bg-surface-variant",
  rankBorderColor: idx === 0 ? "border-yellow-500/20" : idx === 1 ? "border-gray-400/20" : idx === 2 ? "border-orange-600/20" : "border-outline"
})) || [];

// Data Best Employees
const employeesData = [
  {
    category: "Paling Rajin Masuk",
    icon: "check_circle",
    iconBgColor: "bg-success/20",
    iconColor: "text-success",
    name: "Doni Hermawan",
    description: "28/30 hari hadir",
    percentage: "93.3%",
    percentageColor: "text-success",
    borderColor: "border-success/20",
    bgColor: "bg-success/5"
  },
  {
    category: "Paling Tepat Waktu",
    icon: "schedule",
    iconBgColor: "bg-primary/20",
    iconColor: "text-primary",
    name: "Hendra Sugito",
    description: "27/30 hari on-time",
    percentage: "90%",
    percentageColor: "text-primary",
    borderColor: "border-primary/20",
    bgColor: "bg-primary/5"
  },
  {
    category: "Rajin Tadarus Al-Quran",
    icon: "auto_stories",
    iconBgColor: "bg-secondary/20",
    iconColor: "text-secondary",
    name: "Fatimah Zahra",
    description: "25/30 hari tadarus",
    percentage: "83.3%",
    percentageColor: "text-secondary",
    borderColor: "border-secondary/20",
    bgColor: "bg-secondary/5"
  }
];

// Data Profit Mingguan
const { data: profitWeeklyRaw } = await supabase
  .from('rekap_penjualan_mingguan')
  .select('minggu_ke, periode, total_penjualan')
  .order('minggu_ke', { ascending: true })
  .limit(4);

const profitWeekly = profitWeeklyRaw?.map(item => ({
  label: `Minggu ${item.minggu_ke}`,
  value: `Rp ${(item.total_penjualan || 0).toLocaleString('id-ID')}`
})) || [];
---

<Layout title="Dashboard - Manajemen Bang Jelantah">
    <div class="min-h-screen bg-gradient-to-br from-surface via-surface-container-lowest to-surface">
        <div class="max-w-7xl mx-auto px-md py-lg space-y-lg">

            <!-- SECTION 1: KPI CARDS (5 KOLOM) -->
            <KPICard />

            <!-- SECTION 2: CHARTS GRID (3 AREA CHARTS) -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-lg">
                <StokKomoditasChart />
                <TransaksiKomoditasChart/>
                <SumberTransaksiChart/>
            </div>

            <!-- SECTION 3: LEADERBOARD & TOP PERFORMERS -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-lg">
                <LeaderboardMitra mitras={leaderboardData} />
                <BestEmployees employees={employeesData} />
            </div>

            <!-- SECTION 4: BUKU KAS HARIAN -->
            <BukuKasHarian />

            <!-- SECTION 5: METRICS DENGAN DATA REAL -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-lg">
                <SalaryMetricsWithProgress />
                <ExpenditureMetricsWithProgress />
                <SalesMetricsWithProgress />
            </div>

            <!-- SECTION 6: PROFIT MINGGUAN (Hidden untuk non-owner/IT) -->
            <div id="card-profit-margin" class="hidden bg-gradient-to-br from-success-container/30 to-surface-container-lowest rounded-2xl p-lg border border-outline-variant shadow-md hover:shadow-lg transition-shadow">
                <div class="flex justify-between items-center mb-lg">
                    <h3 class="font-headline-md text-on-surface">📈 Profit Mingguan</h3>
                    <span class="text-label-sm text-on-surface-variant">4 minggu</span>
                </div>

                <div class="w-full h-64 chart-grid relative rounded-lg overflow-hidden border border-surface-variant mb-lg">
                    <div class="absolute left-0 top-0 h-full flex flex-col justify-between py-2 px-2 text-label-xs font-label-sm text-on-surface-variant bg-surface-container-lowest/80 backdrop-blur-sm z-10">
                        <span>6.5M</span>
                        <span>5.0M</span>
                        <span>3.5M</span>
                        <span>2.0M</span>
                        <span>0</span>
                    </div>
                    
                    <svg class="w-full h-full absolute inset-0 pl-12 pt-4 pb-8 pr-4" preserveAspectRatio="none" viewBox="0 0 100 100">
                        <defs>
                            <linearGradient id="profitGradient" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="#2E7D32" stop-opacity="0.3"></stop>
                                <stop offset="100%" stop-color="#2E7D32" stop-opacity="0"></stop>
                            </linearGradient>
                        </defs>
                        <polygon fill="url(#profitGradient)" points="0,100 0,25 33.3,35 66.7,15 100,30 100,100"></polygon>
                        <polyline fill="none" points="0,25 33.3,35 66.7,15 100,30" stroke="#2E7D32" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></polyline>
                        <circle cx="0" cy="25" fill="#ffffff" r="2" stroke="#2E7D32" stroke-width="1.5"></circle>
                        <circle cx="33.3" cy="35" fill="#ffffff" r="2" stroke="#2E7D32" stroke-width="1.5"></circle>
                        <circle cx="66.7" cy="15" fill="#ffffff" r="2" stroke="#2E7D32" stroke-width="1.5"></circle>
                        <circle cx="100" cy="30" fill="#ffffff" r="2" stroke="#2E7D32" stroke-width="1.5"></circle>
                    </svg>
                    
                    <div class="absolute bottom-0 left-0 w-full flex justify-between pl-12 pr-4 py-1 text-label-xs font-label-sm text-on-surface-variant bg-surface-container-lowest/80 backdrop-blur-sm z-10">
                        <span>Minggu 1</span>
                        <span>Minggu 2</span>
                        <span>Minggu 3</span>
                        <span>Minggu 4</span>
                    </div>
                </div>

                <div class="space-y-sm">
                    {profitWeekly.map(item => (
                        <div class="flex justify-between items-center p-sm bg-success/5 rounded-lg border border-success/20">
                            <span class="text-label-sm">{item.label}</span>
                            <span class="font-bold text-success">{item.value}</span>
                        </div>
                    ))}
                </div>

                <div class="mt-md pt-md border-t border-outline-variant flex justify-between items-center">
                    <span class="text-label-md text-on-surface-variant">Total Sebulan</span>
                    <span class="text-headline-sm font-bold text-success">
                        {`Rp ${profitWeekly.reduce((acc, item) => {
                          const value = parseInt(item.value.replace(/[^\d]/g, '')) || 0;
                          return acc + value;
                        }, 0).toLocaleString('id-ID')}`}
                    </span>
                </div>
            </div>

        </div>
    </div>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', async () => {
            const client = window.supabase || supabase;
            if (!client) return;

            const { data: { session } } = await client.auth.getSession();
            if (!session) return;

            const { data: prof } = await client.from('profiles').select('role').eq('id', session.user.id).single();

            if (prof?.role === 'owner' || prof?.role === 'it') {
                const profitCard = document.getElementById('card-profit-margin');
                if (profitCard) {
                    profitCard.classList.remove('hidden');
                }
            }
        });
    </script>
</Layout>