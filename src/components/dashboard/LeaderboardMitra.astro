---
// LeaderboardMitra.astro
---

<div id="leaderboard-container">
    <div id="list-container">
        <p>Loading leaderboard...</p> 
    </div>
</div>

<script>
    import { supabase } from '../../lib/supabase'; 

    const listContainer = document.getElementById('list-container');
    const filterButtons = document.querySelectorAll('.filter-btn');

    // 1. Fungsi Fetch
    async function fetchLeaderboard(kategori = 'total_keseluruhan') {
        // Ini cara murni Javascript buat ngilangin error "possibly null"
        if (!listContainer) return; 

        listContainer.innerHTML = '<p class="text-center mt-4">Loading data...</p>';

        const now = new Date();
        const currentPeriode = `${String(now.getMonth() + 1).padStart(2, '0')} ${now.getFullYear()}`;

        const { data: dbData, error } = await supabase
            .from('leaderboard_bulanan_mitra')
            .select('*')
            .eq('periode', currentPeriode)
            .order(kategori, { ascending: false })
            .limit(5);

        if (error) {
            console.error("Gagal fetch leaderboard:", error);
            listContainer.innerHTML = '<p class="text-center text-red-500 mt-4">Gagal memuat data.</p>';
            return;
        }

        renderLeaderboard(dbData, kategori);
    }

    // 2. Fungsi Render HTML
    function renderLeaderboard(data: any[], kategori: string) {
        if (!listContainer) return;

        listContainer.innerHTML = ''; 

        if (!data || data.length === 0) {
            listContainer.innerHTML = '<p class="text-center mt-4">Belum ada data bulan ini.</p>';
            return;
        }

        // Tambahkan : any dan : number di sini
        data.forEach((mitra: any, index: number) => {
            const rank = index + 1;
            const value = mitra[kategori] || 0; 
            
            const cardHtml = `
                <div class="flex items-center gap-4 p-3 border-b border-outline last:border-0">
                    <div class="font-bold text-lg flex-shrink-0">
                        #${rank}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="font-semibold text-on-surface truncate">${mitra.nama_mitra}</p>
                        <p class="text-sm text-on-surface-variant">Total: ${value} KG</p>
                    </div>
                </div>
            `;
            listContainer.insertAdjacentHTML('beforeend', cardHtml);
        });
    }

    // 3. Logika Filter
    filterButtons.forEach(button => {
        button.addEventListener('click', (e) => {
            // Tambahkan "as HTMLElement" di akhir baris ini
            const btn = e.currentTarget as HTMLElement; 
            if (!btn) return; 
            
            const category = btn.getAttribute('data-category') || 'total_keseluruhan'; 

            filterButtons.forEach(b => b.classList.remove('active-styling'));
            btn.classList.add('active-styling');

            fetchLeaderboard(category);
        });
    });

    // 4. Jalankan pas pertama load
    fetchLeaderboard('total_keseluruhan'); 
</script>
