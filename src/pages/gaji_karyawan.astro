      document.getElementById("setup_uang_makan").value = setup.uang_makan || 0;
      document.getElementById("setup_bonus_tepat").value =
        setup.bonus_tepat_waktu || 0;
      document.getElementById("setup_uang_transport").value =
        setup.uang_transport || 0;
      document.getElementById("setup_bonus_mingguan").value =
        setup.bonus_mingguan || 0;
      document.getElementById("setup_potongan_absen").value =
        setup.potongan_bonus_mingguan || 0;
      document.getElementById("setup_uang_kesehatan").value =
        setup.uang_kesehatan || 0;
      document.getElementById("setup_uang_rapat").value = setup.uang_rapat || 0;
      document.getElementById("setup_uang_nginep").value =
        setup.uang_nginep || 0;

      // 🔥 PENEMPATAN KODE MAKAN MALAM & PENJEMPUTAN DI SINI 🔥
      const InpMakanMalam = document.getElementById("setup_uang_makan_malam");
      if (InpMakanMalam) InpMakanMalam.value = setup.uang_makan_malam || 0;

      const InpPenjemputan = document.getElementById("setup_bonus_penjemputan");
      if (InpPenjemputan) InpPenjemputan.value = setup.bonus_penjemputan || 0;

      // KASBON & TALANGAN
      const totalHutangKasbon = parseFloat(setup.kasbon) || 0;
      document.getElementById("info_total_kasbon").innerText =
        "Rp " + totalHutangKasbon.toLocaleString("id-ID");
      document.getElementById("potongan_kasbon_sekarang").value = "";
      document.getElementById("tambahan_talangan_sekarang").value = "";

      // CHECKBOX BYPASS & JERIGEN (Sudah Aman)
      const chkBypass = document.getElementById("chk_bypass_jam_kerja");
      if (chkBypass) chkBypass.checked = setup.bypass_jam_kerja || false;

      const chkJerigen = document.getElementById("chk_gaji_jerigen");
      if (chkJerigen) chkJerigen.checked = setup.is_gaji_jerigen || false;

      const chkJamBebas = document.getElementById("chk_jam_bebas");
      if (chkJamBebas) chkJamBebas.checked = setup.is_jam_bebas || false;

      // 🔥 PERBAIKAN ERROR VALUE JERIGEN 🔥
      // Pakai pengaman IF karena beberapa form jerigen sudah kita hapus dari HTML
      const InpTarifJerigen = document.getElementById("setup_tarif_jerigen");
      if (InpTarifJerigen) InpTarifJerigen.value = setup.tarif_jerigen || 0;

      const InpBonusJerigen = document.getElementById("setup_bonus_jerigen");
      if (InpBonusJerigen)
        InpBonusJerigen.value = setup.bonus_jerigen_manual || 0;

      // 1. Definisikan dulu fungsinya (dengan ID input yang sudah diupdate ke setup_gaji_pokok)
      window.toggleGajiJerigen = function () {
        const chkJerigen = document.getElementById("chk_gaji_jerigen");
        const opsiJerigen = document.getElementById("opsi_jerigen");
        const blokJamBebas = document.getElementById("blok_jam_bebas");

        if (chkJerigen && opsiJerigen) {
          const isJ = chkJerigen.checked;
          opsiJerigen.style.display = isJ ? "block" : "none";

          // 🔥 Sembunyikan Jam Bebas jika Jerigen dicentang
          if (blokJamBebas) blokJamBebas.style.display = isJ ? "none" : "block";

          const nonJerigenIds = [
            "setup_siklus_gaji",
            "setup_gaji_pokok",
            "setup_lembur_menit",
            "setup_uang_makan",
            "setup_uang_makan_malam",
            "setup_bonus_tepat",
            "setup_bonus_penjemputan",
            "setup_bonus_mingguan",
            "setup_potongan_absen",
            "setup_uang_transport",
            "setup_uang_rapat",
            "setup_uang_nginep",
            "setup_uang_kesehatan",
            "tambahan_talangan_sekarang",
          ];
          nonJerigenIds.forEach((id) => {
            const el = document.getElementById(id);
            if (el) {
              el.disabled = isJ;
              const wrapper =
                el.closest(".col-span-2, .col-span-1") || el.parentElement;
              if (wrapper) {
                if (isJ) wrapper.classList.add("hidden");
                else wrapper.classList.remove("hidden");
              }
            }
          });
        }
      };

      // 🔥 FUNGSI BARU: MODE JAM BEBAS 🔥
      window.toggleJamBebas = function () {
        const chkJamBebas = document.getElementById("chk_jam_bebas");
        const blokJerigen = document.getElementById("blok_jerigen");

        if (chkJamBebas) {
          const isJB = chkJamBebas.checked;

          // Sembunyikan Jerigen jika Jam Bebas dicentang
          if (blokJerigen) blokJerigen.style.display = isJB ? "none" : "block";

          // Trigger perubahan label Gaji Pokok
          window.ubahSiklusUI();
        }
      };

      // 2. Baru panggil fungsinya
      window.toggleGajiJerigen();
      window.toggleJamBebas();

      // 🔴 CEK APAKAH EDIT SLIP LAMA (dari riwayat) 🔴
      let slipLama = null;
      if (slipIdToEdit) {
        slipLama = (emp.slip_gaji || []).find(
          (s) => String(s.id) === String(slipIdToEdit),
        );
        console.log("📌 Edit slip spesifik:", slipLama);
      } else {
        const semuaDraf = (emp.slip_gaji || []).filter(
          (s) => s.status === "Menunggu",
        );

        // Urutkan descending (terbaru ke terlama) berdasarkan tanggal periode, lalu ambil index [0]
        slipLama = semuaDraf.sort(
          (a, b) => new Date(b.periode) - new Date(a.periode),
        )[0];

        console.log("📌 Edit slip draf fallback (Terbaru):", slipLama);
      }

      // 🔥 LOGIKA MESIN WAKTU DINAMIS BERDASARKAN SIKLUS 🔥
      const siklusAktif = document.getElementById("setup_siklus_gaji").value;
      const tglLokalObj = new Date(waktuLokal - offset);
      let tglMulai, tglAkhir;

      if (slipLama && slipLama.periode) {
        // ✅ AMBIL TANGGAL DARI SLIP DRAF
        const tglAkhirSlip = slipLama.periode;
        const dEnd = new Date(tglAkhirSlip + "T00:00:00");
        const dStart = new Date(dEnd);

        // 🔥 SESUAIKAN RENTANG TANGGAL BERDASARKAN SIKLUS
        if (siklusAktif === "Mingguan") {
          dStart.setDate(dEnd.getDate() - 6); // Tarik seminggu
        } else if (siklusAktif === "Bulanan") {
          dStart.setDate(1); // Tarik dari awal bulan
        }
        // Jika siklusAktif === "Harian", dStart tidak dikurangi (hanya hari itu saja / sehari kemarin)

        tglMulai = dStart.toISOString().split("T")[0];
        tglAkhir = tglAkhirSlip;

        console.log(
          `📅 EDIT DRAF (${siklusAktif}) - Tanggal dari slip:`,
          tglMulai,
          "sampai",
          tglAkhir,
        );
      } else {
        // 🔵 BUAT SLIP BARU - GUNAKAN KALKULASI OTOMATIS DENGAN ALL-CYCLE GRACE PERIOD
        const siklusAktif = document.getElementById("setup_siklus_gaji").value;

        // Ambil data waktu riil saat modal dibuka
        const sekarang = new Date();
        const jamSekarang = sekarang.getHours();
        const hariSekarang = sekarang.getDay() || 7; // 1 = Senin, 7 = Minggu
        const tanggalSekarang = sekarang.getDate();

        if (siklusAktif === "Harian") {
          // 🕒 GRACE PERIOD HARIAN: Jika di bawah jam 12 siang, default-kan ke hari KEMARIN.
          // Berguna banget buat nampung lemburan malam yang tembus jam 2 pagi.
          const targetHari = new Date(sekarang);
          if (jamSekarang < 12) {
            targetHari.setDate(sekarang.getDate() - 1);
          }

          const y = targetHari.getFullYear();
          const m = String(targetHari.getMonth() + 1).padStart(2, "0");
          const d = String(targetHari.getDate()).padStart(2, "0");

          tglMulai = `${y}-${m}-${d}`;
          tglAkhir = tglMulai;
        } else if (siklusAktif === "Bulanan") {
          // 📅 GRACE PERIOD BULANAN: Jika masih tanggal 1, 2, atau 3 awal bulan,
          // secara otomatis default-kan rentang ke BULAN LALU karena admin pasti mau rekap akhir bulan.
          const targetBulan = new Date(sekarang);
          if (tanggalSekarang <= 3) {
            targetBulan.setMonth(sekarang.getMonth() - 1);
          }

          const y = targetBulan.getFullYear();
          const m = String(targetBulan.getMonth() + 1).padStart(2, "0");

          tglMulai = `${y}-${m}-01`;
          const dAkhir = new Date(y, targetBulan.getMonth() + 1, 0);
          tglAkhir = `${y}-${m}-${String(dAkhir.getDate()).padStart(2, "0")}`;
        } else {
          // 🗓️ GRACE PERIOD MINGGUAN: Jika dibuka pada hari Senin atau Selasa,
          // otomatis mundurkan rentang kalkulasi ke MINGGU LALU (Senin s/d Minggu kemarin).
          const senin = new Date(sekarang);
          senin.setDate(sekarang.getDate() - (hariSekarang - 1));

          if (hariSekarang === 1 || hariSekarang === 2) {
            senin.setDate(senin.getDate() - 7);
          }

          const minggu = new Date(senin);
          minggu.setDate(senin.getDate() + 6);

          tglMulai = senin.toISOString().split("T")[0];
          tglAkhir = minggu.toISOString().split("T")[0];
        }

        console.log(
          `📅 SLIP BARU (${siklusAktif}) - Terpasang Grace Period:`,
          tglMulai,
          "s/d",
          tglAkhir,
        );
      }

      window.currentSalaryData = {
        empId: emp.id,
        tglMulai,
        tglAkhir,
        sisaKasbonDb: totalHutangKasbon,
        siklusGaji: siklusAktif, // Kirim data siklus ke Deno
      };

      window.dataLainLain = setup.lain_lain || [];
      if (typeof window.renderLainLain === "function") {
        window.renderLainLain();
      }

      // Cek slip draft
      const slip = (emp.slip_gaji || []).find(
        (s) => s.periode === tglAkhir && s.status === "Menunggu",
      );
      document.getElementById("m_slip_id").value = slip ? slip.id : "";

      window.kalkulasiRealtimeGaji();
      window.openModal("modal-detail-gaji");
    };

    window.kalkulasiRealtimeGaji = async function () {
      const d = window.currentSalaryData;
      if (!d) return;
      document.getElementById("m_total_gaji").innerText = "Menghitung...";
      document.getElementById("m_rincian_list").innerHTML =
        `<p class="text-center text-sm text-gray-500 py-4"><i class="bi bi-arrow-repeat animate-spin inline-block mr-2"></i> Sinkronisasi Kalkulator Server...</p>`;

      const potKasbonInput = document.getElementById(
        "potongan_kasbon_sekarang",
      ).value;
      const potonganManual =
        potKasbonInput === "" ? null : parseFloat(potKasbonInput);
      const talInput = document.getElementById(
        "tambahan_talangan_sekarang",
      ).value;
      const talanganManual = talInput === "" ? null : parseFloat(talInput);
      const jm = document.getElementById("input_jerigen_manual")?.value;

      // 🟢 1. TAMBAHKAN DUA BARIS INI DI SINI (Sebelum blok 'try')
      const isJamBebasAktif =
        document.getElementById("chk_jam_bebas")?.checked || false;
      const inputGajiPokok =
        parseFloat(document.getElementById("setup_gaji_pokok")?.value) || 0;

      try {
        const { data, error } = await window.supabase.functions.invoke(
          "gaji-karyawan",
          {
            body: {
              empId: d.empId,
              tglMulai: d.tglMulai,
              tglAkhir: d.tglAkhir,
              action: "kalkulasi",
              potonganKasbonManual: isNaN(potonganManual)
                ? null
                : potonganManual,
              tambahanTalanganManual: isNaN(talanganManual)
                ? null
                : talanganManual,
              siklusGaji: d.siklusGaji,
              jumlahJerigenManual: jm === "" ? null : parseFloat(jm),

              // 🟢 2. TAMBAHKAN DUA BARIS INI DI DALAM BODY PAYLOAD
              is_jam_bebas_manual: isJamBebasAktif,
              gaji_menit_manual: inputGajiPokok,

              // 🔥 1. INI WAJIB ADA BIAR DENO TAU ADA ITEM BARU 🔥
              lain_lain_manual: window.dataLainLain,
            },
          },
        );

        if (error) throw error;
        if (data && data.success === false) {
          throw new Error(data.error || "Gagal melakukan kalkulasi di server.");
        }

        const res = data?.data || {};
        console.log("ISI DATA DARI SERVER DENO: ", res);

        // 🔥 TAHAP 2: MUNCULKAN NOTIFIKASI KASBON DADAKAN DI FORM SETUP 🔥
        const alertKasbonUj = document.getElementById(
          "alert_kasbon_uang_jalan",
