      // Proses Baca File Excel saat file dipilih
      excelFileInput.addEventListener("change", async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const tableName = importTableSelect.value;
        if (!tableName) {
          alert("⚠️ Silakan pilih 'Tabel Tujuan' di dropdown terlebih dahulu!");
          excelFileInput.value = "";
          return;
        }

        try {
          selectFileBtn.innerText = "Membaca file...";

          // Injeksi Library Excel (Sama seperti fitur download)
          if (typeof window.XLSX === "undefined") {
            await new Promise((resolve, reject) => {
              const script = document.createElement("script");
              script.src =
                "https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js";
              script.onload = resolve;
              script.onerror = () =>
                reject(
                  new Error(
                    "Gagal memuat library Excel. Cek koneksi internet.",
                  ),
                );
              document.head.appendChild(script);
            });
          }

          // Mulai proses baca file menggunakan FileReader
          const reader = new FileReader();
          reader.onload = function (e) {
            const data = new Uint8Array(e.target.result);
            const workbook = window.XLSX.read(data, { type: "array" });
            const firstSheetName = workbook.SheetNames[0];
            const worksheet = workbook.Sheets[firstSheetName];

            // Konversi dari Sheet ke format JSON
            const jsonData = window.XLSX.utils.sheet_to_json(worksheet);

            if (jsonData.length === 0)
              return alert("❌ File Excel kosong atau format tidak sesuai.");

            importedData = jsonData;

            // Tampilkan Preview (Maksimal 10 baris pertama)
            importPreview.classList.remove("hidden");
            const previewData = jsonData.slice(0, 10);
            const headers = Object.keys(previewData[0]);
            let html =
              '<table class="w-full text-left text-xs bg-white border border-gray-200"><thead><tr class="bg-gray-100">';
            headers.forEach(
              (h) => (html += `<th class="p-2 border">${h}</th>`),
            );
            html += "</tr></thead><tbody>";

            previewData.forEach((row) => {
              html += "<tr>";
              headers.forEach(
                (h) =>
                  (html += `<td class="p-2 border truncate max-w-[100px]">${row[h] || ""}</td>`),
              );
              html += "</tr>";
            });
            html += "</tbody></table>";
            if (jsonData.length > 10)
              html += `<p class="mt-2 text-xs text-gray-500 italic">Menampilkan 10 dari total ${jsonData.length} baris.</p>`;

            previewTable.innerHTML = html;
            selectFileBtn.innerText = "Ganti File";
          };
          reader.readAsArrayBuffer(file);
        } catch (err) {
          console.error(err);
          alert("Error membaca Excel: " + err.message);
          selectFileBtn.innerText = "Pilih File";
        }
      });

