    // ==========================================
    onMessage(messaging, (payload) => {
      console.log("📬 Notifikasi diterima:", payload);

      const title = payload.notification?.title || "Pemberitahuan";
      const body = payload.notification?.body || "Anda memiliki pesan baru";
      const icon =
        payload.notification?.image ||
        "https://ui-avatars.com/api/?name=Bang+Jelantah&background=2e7d32&color=ffffff";

      // 🔊 MAINKAN SUARA
      playNotificationSound();

      // 👉 TAMBAHKAN BARIS INI: Masukkan ke kotak dropdown UI
      if (window.addNotifToList) window.addNotifToList(title, body);

      // 🔔 TAMPILKAN NOTIFIKASI BROWSER
      if ("Notification" in window && Notification.permission === "granted") {
        new Notification(title, {
