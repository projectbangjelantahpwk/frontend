        );
        link.classList.add(
          "text-on-surface-variant",
          "hover:bg-surface-container-low",
        );

        const href = link.getAttribute("href");
        const isActive =
          (currentPath === "/" && href === "/") ||
          (currentPath !== "/" && currentPath === href);

        if (isActive) {
          link.classList.remove(
            "text-on-surface-variant",
            "hover:bg-surface-container-low",
          );
          link.classList.add(
            "bg-primary-container",
            "text-on-primary-container",
            "font-bold",
          );
        }
      });
