---
import GeneralLayout from '../layouts/Layout.astro';
import 'bootstrap-icons/font/bootstrap-icons.css';
---

<GeneralLayout title="Keuangan - Manajemen Bang Jelantah">
    <style is:global>
        /* Mengunci layar menjadi blank (putih) sampai skrip memberi izin masuk */
        body { display: none; }
    </style>
  <div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Manajemen Keuangan</h1>
      <p class="text-gray-600">Kelola arus kas, penggajian, dan rekapitulasi slip gaji karyawan.</p>
    </div>
  </div>

  <div class="mb-6 border-b border-gray-200 overflow-x-auto hide-scrollbar">
    <div class="flex gap-8 min-w-max">
      <button class="tab-btn active px-4 py-3 font-medium transition border-b-2 border-green-700 text-green-700" data-tab="gaji">
        <i class="bi bi-wallet2 mr-2"></i> Gaji Karyawan
      </button>
      <button class="tab-btn px-4 py-3 font-medium transition border-b-2 border-transparent text-gray-600 hover:text-gray-900" data-tab="riwayat-gaji">
        <i class="bi bi-clock-history mr-2"></i> Riwayat Gaji Karyawan
      </button>
    </div>
  </div>

  <div id="gaji" class="tab-content block">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-3">
        <h2 class="text-xl font-bold text-gray-900">Rekapitulasi Gaji Karyawan</h2>
        
        <div class="bg-gray-100 p-1.5 rounded-xl flex overflow-x-auto hide-scrollbar w-full md:w-auto text-sm font-bold shadow-inner">
            <button onclick="window.filterTipeGaji('Semua')" class="filter-gaji-btn active bg-white shadow-sm px-4 py-2 rounded-lg text-green-700 whitespace-nowrap transition-all">Semua</button>
            <button onclick="window.filterTipeGaji('Harian')" class="filter-gaji-btn px-4 py-2 rounded-lg text-gray-500 hover:text-gray-900 whitespace-nowrap transition-all">Harian</button>
            <button onclick="window.filterTipeGaji('Mingguan')" class="filter-gaji-btn px-4 py-2 rounded-lg text-gray-500 hover:text-gray-900 whitespace-nowrap transition-all">Mingguan</button>
            <button onclick="window.filterTipeGaji('Bulanan')" class="filter-gaji-btn px-4 py-2 rounded-lg text-gray-500 hover:text-gray-900 whitespace-nowrap transition-all">Bulanan</button>
        </div>
    </div>
    <div id="gaji-karyawan-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <p class="text-gray-500">Memuat data gaji...</p>
    </div>
  </div>

  <div class="tab-content hidden" id="riwayat-gaji-tab">
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm mb-6">
      <h3 class="text-lg font-bold text-gray-900 mb-4">Filter Riwayat Gaji Tahun Berjalan</h3>

      <div class="flex flex-wrap gap-4 items-end">
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Dari Tanggal</label>
          <input type="date" id="filter-gaji-start" class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-700" />
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Sampai Tanggal</label>
          <input type="date" id="filter-gaji-end" class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-700" />
        </div>
        <button id="btn-filter-gaji" class="bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-800 transition">
          Saring Riwayat
        </button>
      </div>
    </div>

    <div id="riwayat-gaji-container" class="space-y-4">
      <p class="text-gray-500 text-sm italic">Pilih filter tanggal untuk memuat riwayat.</p>
    </div>
  </div>
</GeneralLayout>

<div id="modal-pengaturan-global" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0">
    <div class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
            <h3 class="font-bold text-lg text-gray-990">Pengaturan Gaji Global</h3>
            <button onclick="closeModal('modal-pengaturan-global')" class="text-gray-400 hover:text-gray-900"><i class="bi bi-x-lg"></i></button>
        </div>
        <form id="form-global-gaji" class="p-6 space-y-4">
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Uang Kesehatan (Rp)</label>
                <input type="number" id="g_kesehatan" value="0" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600">
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Bonus Tepat Waktu (Rp)</label>
                <input type="number" id="g_tepatwaktu" value="0" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600">
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Bonus Mingguan (Rp)</label>
                <input type="number" id="g_mingguan" value="0" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600">
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Tarif Lembur per Jam (Rp)</label>
                <input type="number" id="g_lembur" value="0" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600">
            </div>
            <button type="submit" class="w-full bg-gray-900 text-white font-bold py-3 rounded-xl hover:bg-black transition">Simpan Pengaturan</button>
        </form>
    </div>
</div>

<div id="modal-detail-gaji" class="fixed inset-0 bg-black/70 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0 backdrop-blur-sm">
    <div class="bg-gray-100 rounded-2xl w-full max-w-6xl overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[95vh] shadow-2xl border border-gray-200">
        
        <div class="p-4 border-b border-gray-200 flex justify-between items-center bg-white shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-green-100 text-green-700 flex items-center justify-center font-bold shadow-sm"><i class="bi bi-person-bounding-box text-xl"></i></div>
                <div>
                    <h3 class="font-bold text-lg text-gray-900" id="m_nama_karyawan">Nama Karyawan</h3>
                    <p class="text-[11px] text-gray-500 font-bold uppercase tracking-wider">Setup Parameter & Kalkulasi Gaji</p>
                </div>
            </div>
            <button onclick="closeModal('modal-detail-gaji')" class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-500 hover:bg-red-100 hover:text-red-600 transition"><i class="bi bi-x-lg text-lg"></i></button>
        </div>
        
        <div class="p-5 overflow-y-auto flex-1 grid grid-cols-1 lg:grid-cols-2 gap-6">
            <input type="hidden" id="m_karyawan_id">
            <input type="hidden" id="m_setup_id">
            <input type="hidden" id="m_slip_id">
            
            <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex flex-col">
                <h4 class="text-sm font-bold text-gray-900 mb-4 border-b border-gray-100 pb-3 flex items-center"><i class="bi bi-sliders text-blue-600 mr-2 text-lg"></i>Parameter Setup Personal</h4>
                
                <div class="grid grid-cols-2 gap-3 flex-1 overflow-y-auto pr-2 custom-scrollbar">
                    <div class="col-span-2 sm:col-span-1">
                        <label class="block text-xs font-bold text-blue-700 mb-1">Tipe Siklus Gaji</label>
                        <select id="setup_tipe_periode" class="w-full border border-blue-300 bg-blue-50 text-blue-900 rounded-lg p-2.5 text-sm outline-none focus:border-blue-600 font-bold">
                            <option value="Harian">Harian (Tiap Hari Masuk)</option>
                            <option value="Mingguan">Mingguan (Tiap Sabtu)</option>
                            <option value="Bulanan">Bulanan (Tiap Tgl 28)</option>
                        </select>
                    </div>
                    
                    <div class="col-span-2 sm:col-span-1">
                        <label class="block text-xs font-bold text-blue-700 mb-1">Gaji Pokok Full</label>
                        <input type="number" id="setup_gaji_menit" class="w-full border border-blue-300 bg-blue-50/50 text-blue-900 font-bold rounded-lg p-2.5 text-sm outline-none focus:border-blue-600" placeholder="Misal: 300000">
                        
                    </div>

                    <div class="col-span-2 sm:col-span-1">
                        <label class="block text-xs font-bold text-gray-700 mb-1">Uang Lembur per Menit (Rp)</label>
                        <input type="number" id="setup_lembur_menit" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600 font-medium">
                    </div>

                    <div class="col-span-2 sm:col-span-1">
                        <label class="block text-xs font-bold text-gray-700 mb-1">Bonus Tepat Wkt /Hari (Rp)</label>
                        <input type="number" id="setup_bonus_tepat" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600">
                    </div>
                    
                    <div class="col-span-2 sm:col-span-1">
                        <label class="block text-xs font-bold text-gray-700 mb-1">Bonus Mingguan Full (Rp)</label>
                        <input type="number" id="setup_bonus_mingguan" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600" placeholder="Misal: 50000">
                    </div>

                    <div class="col-span-2 sm:col-span-1">
                        <label class="block text-xs font-bold text-red-700 mb-1">Potongan Bonus/Hari Absen</label>
                        <input type="number" id="setup_potongan_absen" class="w-full border border-red-300 bg-red-50 text-red-900 rounded-lg p-2.5 text-sm outline-none focus:border-red-600 font-bold" placeholder="Misal: 5000">
                    </div>
                    
                    <div class="col-span-2 sm:col-span-1">
                        <div class="flex items-center justify-between mb-1">
                            <label class="text-xs font-bold text-gray-700">Uang Rapat (Rp)</label>
                            <div class="flex items-center gap-1.5"><input type="checkbox" id="chk_uang_rapat" onchange="window.kalkulasiRealtimeGaji()" class="w-3.5 h-3.5 text-blue-600 rounded cursor-pointer"><span class="text-[10px] text-gray-500 font-bold">Aktif</span></div>
                        </div>
                        <input type="number" id="setup_uang_rapat" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600">
                    </div>

                    <div class="col-span-2 sm:col-span-1">
                        <div class="flex items-center justify-between mb-1">
                            <label class="text-xs font-bold text-gray-700">Uang Nginep (Rp)</label>
                            <div class="flex items-center gap-1.5"><input type="checkbox" id="chk_uang_nginep" onchange="window.kalkulasiRealtimeGaji()" class="w-3.5 h-3.5 text-blue-600 rounded cursor-pointer"><span class="text-[10px] text-gray-500 font-bold">Aktif</span></div>
                        </div>
                        <input type="number" id="setup_uang_nginep" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600">
                    </div>

                    <div class="col-span-2 sm:col-span-1">
                        <div class="flex items-center justify-between mb-1">
                            <label class="text-xs font-bold text-gray-700">Uang Kesehatan (Rp)</label>
                            <div class="flex items-center gap-1.5"><input type="checkbox" id="chk_uang_kesehatan" onchange="window.kalkulasiRealtimeGaji()" class="w-3.5 h-3.5 text-blue-600 rounded cursor-pointer"><span class="text-[10px] text-gray-500 font-bold">Aktif</span></div>
                        </div>
                        <input type="number" id="setup_uang_kesehatan" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600">
                    </div>

                    <div class="col-span-2 sm:col-span-1 flex flex-col justify-end">
                        <div class="flex items-center justify-between bg-gray-50 border border-gray-200 p-2.5 rounded-lg h-[42px]">
                            <label class="text-xs font-bold text-gray-700"><i class="bi bi-book text-green-600 mr-1"></i> Tadarus</label>
                            <div class="flex items-center gap-1.5"><input type="checkbox" id="chk_tadarus_alquran" onchange="window.kalkulasiRealtimeGaji()" class="w-4 h-4 text-green-600 rounded cursor-pointer"><span class="text-[10px] text-gray-600 font-bold uppercase">Disetor</span></div>
                        </div>
                    </div>

                    <div class="col-span-2 border-t border-dashed border-gray-300 pt-3 mt-1"></div>

                    <div class="col-span-2 bg-red-50 p-3.5 rounded-xl border border-red-200 mt-2">
                        <div class="flex justify-between items-center mb-2.5">
                            <label class="text-xs font-bold text-red-800 uppercase flex items-center"><i class="bi bi-wallet2 mr-1"></i> Potong Kasbon Periode Ini</label>
                            <div class="text-[9px] font-black bg-red-200 text-red-900 px-2 py-1 rounded shadow-sm">
                                TOTAL HUTANG: <span id="info_total_kasbon" class="font-mono">Rp 0</span>
                            </div>
                        </div>
                        <input type="number" id="potongan_kasbon_sekarang" oninput="window.kalkulasiRealtimeGaji()" class="w-full border border-red-300 bg-white text-red-900 font-bold font-mono rounded-lg p-2.5 text-sm outline-none focus:border-red-600 shadow-inner" placeholder="Ketik nominal potongan...">
                    </div>

                    <div class="col-span-2 border-t border-gray-100 pt-2 mt-1">
                        <div class="flex items-center justify-between">
                            <label class="text-xs font-bold text-gray-700"><i class="bi bi-book text-green-600 mr-1"></i> Tadarus Al-Quran</label>
                            <div class="flex items-center gap-1.5"><input type="checkbox" id="chk_tadarus_alquran" onchange="window.kalkulasiRealtimeGaji()" class="w-4 h-4 text-green-600 rounded cursor-pointer"><span class="text-[10px] text-gray-600 font-bold uppercase">Sudah Disetor</span></div>
                        </div>
                    </div>
                </div>
                
                <div class="mt-4 pt-4 border-t border-gray-100 shrink-0">
                    <button onclick="simpanSetupGaji()" class="w-full bg-gray-900 text-white px-4 py-3 rounded-xl font-bold text-sm hover:bg-black transition shadow-md flex justify-center items-center gap-2">
                        <i class="bi bi-floppy"></i> Simpan Parameter Ke Database
                    </button>
                </div>
            </div>

            <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex flex-col relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-green-400 to-blue-500"></div>
                <h4 class="text-sm font-bold text-gray-900 mb-4 border-b border-gray-100 pb-3 flex items-center"><i class="bi bi-receipt-cutoff text-green-600 mr-2 text-lg"></i>Kalkulasi Slip Gaji Terkini</h4>
                
                <div class="flex-1 overflow-y-auto pr-2 custom-scrollbar">
                    <div class="space-y-3" id="m_rincian_list">
                        </div>
                </div>

                <div class="shrink-0 mt-4">
                    <div class="bg-gradient-to-br from-green-700 to-green-800 text-white p-5 rounded-xl flex justify-between items-center shadow-lg border border-green-600">
                        <span class="font-bold text-sm uppercase tracking-wider text-green-100">Total Diterima:</span>
                        <span class="text-3xl font-black font-mono tracking-tight" id="m_total_gaji">Rp 0</span>
                    </div>
                    
                    <div class="flex gap-3 mt-4">
                         <button id="btn-draf-gaji" onclick="simpanSlipGaji('Menunggu')" class="flex-1 bg-white border-2 border-gray-200 text-gray-700 font-bold py-3.5 rounded-xl hover:bg-gray-50 hover:border-gray-300 transition shadow-sm text-sm flex justify-center items-center gap-2">
                            <i class="bi bi-save"></i> Simpan Draf
                         </button>
                         <button id="btn-bayar-gaji" onclick="simpanSlipGaji('ACC')" class="flex-[1.5] bg-green-600 text-white font-bold py-3.5 rounded-xl hover:bg-green-700 transition shadow-md text-sm uppercase tracking-wider flex justify-center items-center gap-2">
                            <i class="bi bi-check2-circle text-lg"></i> Approve & Lunas
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="modal-kasir-gaji" class="fixed inset-0 bg-black/60 hidden items-center justify-center z-[60] p-4 transition-opacity opacity-0">
    <div class="bg-white rounded-2xl w-full max-w-sm overflow-hidden transform scale-95 transition-transform duration-300 shadow-2xl border border-gray-100">
        <div class="p-4 border-b border-gray-100 bg-blue-50 flex justify-between items-center">
            <div>
                <h3 class="font-bold text-base text-blue-900">Kasir Pembayaran Gaji</h3>
                <p class="text-[10px] font-bold text-blue-700 uppercase tracking-wider">Metode Split Payment Brankas</p>
            </div>
            <button onclick="closeModal('modal-kasir-gaji')" class="text-blue-400 hover:text-blue-900"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="p-5 space-y-4">
            <div class="bg-gray-100 p-3 rounded-xl text-center border border-gray-200 shadow-inner">
                <p class="text-xs text-gray-500 font-bold uppercase mb-1">Total Tagihan Gaji Lunas</p>
                <p class="text-2xl font-black text-gray-900 font-mono" id="kasir_total_tagihan">Rp 0</p>
            </div>
            <div class="space-y-3 bg-green-50/50 p-3 rounded-xl border border-green-100">
                <div>
                    <label class="block text-[10px] font-bold text-green-800 uppercase mb-1">Ambil dr Uang Keuangan</label>
                    <input type="number" id="kasir_keuangan" value="0" oninput="window.kalkulasiKasir()" class="w-full border border-green-300 rounded-lg p-2 text-sm font-bold text-green-900 outline-none focus:border-green-600 focus:ring-1 focus:ring-green-600 bg-white">
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-green-800 uppercase mb-1">Ambil dr Uang Gudang</label>
                    <input type="number" id="kasir_gudang" value="0" oninput="window.kalkulasiKasir()" class="w-full border border-green-300 rounded-lg p-2 text-sm font-bold text-green-900 outline-none focus:border-green-600 focus:ring-1 focus:ring-green-600 bg-white">
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-green-800 uppercase mb-1">Ambil dr Uang Owner</label>
                    <input type="number" id="kasir_owner" value="0" oninput="window.kalkulasiKasir()" class="w-full border border-green-300 rounded-lg p-2 text-sm font-bold text-green-900 outline-none focus:border-green-600 focus:ring-1 focus:ring-green-600 bg-white">
                </div>
            </div>
            <div class="flex justify-between items-center text-xs font-bold p-2.5 rounded-lg bg-red-50 border border-red-200 transition-colors" id="kasir_sisa_box">
                <span class="text-red-800">Sisa Belum Terbayar:</span>
                <span id="kasir_sisa" class="text-red-700 font-mono text-sm">Rp 0</span>
            </div>
            <button id="btn-eksekusi-bayar" onclick="window.eksekusiBayarGaji()" class="w-full bg-blue-700 text-white font-bold py-3.5 rounded-xl hover:bg-blue-800 disabled:opacity-50 disabled:cursor-not-allowed transition shadow-sm font-mono text-sm uppercase tracking-wide" disabled>
                <i class="bi bi-safe2 mr-2"></i> POTONG KAS & BAYAR
            </button>
        </div>
    </div>
</div>

<script is:inline>
  let dataGlobalGaji = null;
  let dataKaryawan = [];

  document.addEventListener('DOMContentLoaded', async () => {
      // === 🛡️ GATEKEEPER KEUANGAN ===
      const allowedRoles = ['owner', 'hrd', 'keuangan','it'];
      const client = window.supabase || supabase;
      
      const { data: { session } } = await client.auth.getSession();
      if (!session) return window.location.replace('/');
      
      const { data: prof } = await client.from('profiles').select('role').eq('id', session.user.id).single();
      
      if (!allowedRoles.includes(prof?.role)) {
          alert(`Akses Ditolak! Role Anda (${prof?.role || 'Guest'}) dilarang masuk ke Keuangan.`);
          return window.location.replace('/');
      }
      document.body.style.display = 'block';
      
      // Setup Batasan Tanggal Otomatis
      const tahunAktif = new Date().getFullYear();
      const awalTahun = `${tahunAktif}-01-01`; 
      const waktuLokal = new Date();
      const offset = waktuLokal.getTimezoneOffset() * 60000;
      const hariIni = new Date(waktuLokal - offset).toISOString().split('T')[0];

      const inputStart = document.getElementById('filter-gaji-start');
      const inputEnd = document.getElementById('filter-gaji-end');
      if (inputStart && inputEnd) {
          inputStart.min = awalTahun;
          inputStart.max = hariIni;
          inputStart.value = awalTahun; 

          inputEnd.min = awalTahun;
          inputEnd.max = hariIni;
          inputEnd.value = hariIni;
      }
    
    // ==========================================
    // 1. FETCH DATA KEUANGAN (CLIENT-SIDE)
    // ==========================================
    async function loadKeuanganData() {
        if(!window.supabase) return;
        try {
            const { data: listMitra } = await window.supabase.from('mitra').select('id, nama_mitra').order('nama_mitra', { ascending: true });
            window.allMitraGlobal = listMitra || [];
            const { data: globalGaji } = await window.supabase.from('pengaturan_gaji_global').select('*').single();
            dataGlobalGaji = globalGaji;
            if(globalGaji) {
                document.getElementById('g_kesehatan').value = globalGaji.uang_kesehatan || 0;
                document.getElementById('g_tepatwaktu').value = globalGaji.bonus_tepat_waktu || 0;
                document.getElementById('g_mingguan').value = globalGaji.bonus_mingguan || 0;
                document.getElementById('g_lembur').value = globalGaji.tarif_lembur_perjam || 0;
            }

            const { data: karyawan, error: errKaryawan } = await window.supabase
                .from('profiles')
                .select('id, nama, role, foto_profil, setup_gaji(*), presensi(tanggal, status_tiba, waktu_tiba, waktu_pulang), slip_gaji(*)')
                .neq('role', 'owner');

            if (errKaryawan) {
                alert("Error Supabase (Data Karyawan): " + errKaryawan.message);
                console.error("Detail Error:", errKaryawan);
            }

            dataKaryawan = karyawan || [];
            const contKaryawan = document.getElementById('gaji-karyawan-container');
            let htmlKaryawan = '';
            if(dataKaryawan.length > 0) {
                dataKaryawan.forEach(k => {
                    const jumlahHadir = k.presensi?.length || 0;
                    // 🔥 Ambil 2 huruf depan untuk inisial (misal: "Budi Santoso" -> "BS")
                    const inisial = k.nama ? k.nama.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'U';
                   
                    // 🔥 Beri warna hijau elegan khas Keuangan jika pakai inisial
                    const avatarKomponen = k.foto_profil 
                        ? `<img src="${k.foto_profil}" class="w-12 h-12 rounded-full object-cover border-2 border-green-200 shadow-sm shrink-0" />`
                        : `<div class="w-12 h-12 rounded-full bg-green-100 border border-green-200 flex items-center justify-center text-green-700 font-bold text-lg shadow-sm shrink-0">${inisial}</div>`;
                    
                    const peran = k.tipe_kendaraan ? k.tipe_kendaraan.replace('_', ' ') : (k.role || 'Karyawan');
                    const setup = k.setup_gaji && k.setup_gaji.length > 0 ? k.setup_gaji[0] : {};
                    const tarif = Number(setup.gaji_menit || 0).toLocaleString('id-ID');
                    
                    // 🔥 Trik narik tipe periode untuk ditaruh di Card Karyawan
                    const tipePeriode = setup.tipe_periode || 'Harian'; 

                    htmlKaryawan += `
                    <div class="karyawan-card bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden flex flex-col transition-all" data-periode="${tipePeriode}">
                        <div class="bg-gradient-to-r from-green-50 to-green-100 px-6 py-4 flex items-center justify-between border-b border-green-200">
                            <div class="flex items-center gap-4">
                                ${avatarKomponen} 
                                <div>
                                    <h3 class="font-bold text-gray-900 flex items-center gap-2">
                                        ${k.nama} 
                                        <span class="px-2 py-0.5 rounded text-[9px] font-black bg-blue-200 text-blue-800 uppercase tracking-wider shadow-sm">${tipePeriode}</span>
                                    </h3>
                                    <p class="text-xs font-semibold text-gray-600 capitalize mt-0.5">${peran}</p>
                                </div>
                            </div>
                        </div>
                        <div class="p-6 flex-1 flex flex-col">
                            <div class="space-y-2 mb-6 text-sm">
                                <div class="flex justify-between"><span class="text-gray-500">Gaji per Menit:</span> <span class="font-medium text-gray-900">Rp ${tarif}</span></div>
                                <div class="flex justify-between"><span class="text-gray-500">Hadir Bulan Ini:</span> <span class="font-medium text-green-600">${jumlahHadir} Hari</span></div>
                            </div>
                            <button onclick="window.openModalGaji('${k.id}')" class="mt-auto w-full flex items-center justify-center gap-2 px-4 py-3 bg-white border-2 border-green-700 text-green-700 rounded-xl font-bold hover:bg-green-50 transition active:scale-95">
                                <i class="bi bi-calculator"></i> Setup & Slip Gaji
                            </button>
                        </div>
                    </div>`;
                });
            } else {
                htmlKaryawan = '<p class="text-gray-500">Belum ada data karyawan.</p>';
            }
            contKaryawan.innerHTML = htmlKaryawan;

        } catch (error) {
            console.error("Gagal load data keuangan:", error);
        }
    }

    await loadKeuanganData();

    // ==========================================
    // 2. TAB SWITCHING LOGIC
    // ==========================================
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');
    tabButtons.forEach((button) => {
      button.addEventListener('click', function() {
        let tabName = this.getAttribute('data-tab');
        
        const tabIdMap = {
          'gaji': 'gaji',
          'riwayat-gaji': 'riwayat-gaji-tab',  
        };
        
        tabName = tabIdMap[tabName] || tabName;
        
        tabButtons.forEach((btn) => {
          btn.classList.remove('active', 'border-green-700', 'text-green-700');
          btn.classList.add('border-transparent', 'text-gray-600');
        });
        tabContents.forEach((content) => {
          content.classList.add('hidden');
          content.classList.remove('block');
        });
        
        this.classList.add('active', 'border-green-700', 'text-green-700');
        this.classList.remove('border-transparent', 'text-gray-600');
        
        const activeTab = document.getElementById(tabName);
        if(activeTab) {
          activeTab.classList.remove('hidden');
          activeTab.classList.add('block');
        } else {
          console.warn(`Tab dengan ID '${tabName}' tidak ditemukan!`);
        }
      });
    });

    // ==========================================
    // 3. MODAL CONTROLS & FUNCTIONS
    // ==========================================
    window.openModal = function(id) {
        const m = document.getElementById(id); if(!m) return;
        m.classList.remove('hidden'); m.classList.add('flex');
        setTimeout(() => { m.classList.remove('opacity-0'); const c = m.querySelector('div'); if(c) c.classList.remove('scale-95'); }, 10);
        
        // 🔥 Kunci body layar belakang biar gak bisa di-scroll
        document.body.style.overflow = 'hidden'; 
    };
    
    window.closeModal = function(id) {
        const m = document.getElementById(id); if(!m) return;
        m.classList.add('opacity-0'); const c = m.querySelector('div'); if(c) c.classList.add('scale-95');
        setTimeout(() => { m.classList.add('hidden'); m.classList.remove('flex'); }, 300);
        
        // 🔥 Lepas kunci scroll saat modal ditutup
        document.body.style.overflow = ''; 
    };

    // UPDATE PENGATURAN GLOBAL
    document.getElementById('form-global-gaji')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if(!window.supabase) return;
        const btn = e.target.querySelector('button[type="submit"]');
        btn.innerText = "Menyimpan...";
        
        try {
            await window.supabase.from('pengaturan_gaji_global').update({
                uang_kesehatan: document.getElementById('g_kesehatan').value,
                bonus_tepat_waktu: document.getElementById('g_tepatwaktu').value,
                bonus_mingguan: document.getElementById('g_mingguan').value,
                tarif_lembur_perjam: document.getElementById('g_lembur').value,
            }).eq('id', 1);
            alert('Pengaturan Global berhasil diperbarui!');
            window.location.reload();
        } catch (err) { alert(err.message); btn.innerText = "Simpan Pengaturan"; }
    });

    window.currentSalaryData = null;

    // BUKA MODAL DETAIL GAJI KARYAWAN
    // ==========================================
    // 🚀 ENGINE MESIN WAKTU & KALKULASI GAJI 🚀
    // ==========================================
    window.openModalGaji = async function(empId) {
        const emp = dataKaryawan.find(k => String(k.id) === String(empId));
        if(!emp) return alert('Data karyawan tidak ditemukan!');

        document.getElementById('m_karyawan_id').value = emp.id;
        document.getElementById('m_nama_karyawan').innerText = emp.nama;

        let setup = {};
        try {
            const { data: liveSetup } = await window.supabase.from('setup_gaji').select('*').eq('user_id', emp.id).maybeSingle();
            if(liveSetup) setup = liveSetup;
        } catch(e) { console.error("Gagal narik setup:", e); }

        document.getElementById('m_setup_id').value = setup.id || '';
        document.getElementById('setup_gaji_menit').value = setup.gaji_menit || 0;
        document.getElementById('setup_lembur_menit').value = setup.uang_lembur_menit || 0;
        document.getElementById('setup_uang_kesehatan').value = setup.uang_kesehatan || 0;
        document.getElementById('setup_uang_rapat').value = setup.uang_rapat || 0;
        document.getElementById('setup_uang_nginep').value = setup.uang_nginep || 0;
        document.getElementById('setup_bonus_tepat').value = setup.bonus_tepat_waktu || 0;
        document.getElementById('setup_bonus_mingguan').value = setup.bonus_mingguan || 0;
        
        document.getElementById('setup_tipe_periode').value = setup.tipe_periode || 'Harian';
        document.getElementById('setup_potongan_absen').value = setup.potongan_bonus_mingguan || 0;
        
        // Setup Kasbon UI Pintar
        const totalHutangKasbon = parseFloat(setup.kasbon) || 0;
        document.getElementById('info_total_kasbon').innerText = 'Rp ' + totalHutangKasbon.toLocaleString('id-ID');
        document.getElementById('potongan_kasbon_sekarang').value = ''; // Kosongkan awal mula
        
        document.getElementById('chk_uang_rapat').checked = setup.activate_uang_rapat || false;
        document.getElementById('chk_uang_nginep').checked = setup.activate_uang_nginep || false;
        document.getElementById('chk_uang_kesehatan').checked = setup.activate_uang_kesehatan || false;
        document.getElementById('chk_tadarus_alquran').checked = setup.tadarus_alquran || false;

        // 🔥 MESIN WAKTU (FILTER RENTANG TANGGAL) 🔥
        const tipePeriode = setup.tipe_periode || 'Harian';
        const tglLokalObj = new Date(waktuLokal - offset);
        const tglHariIni = tglLokalObj.toISOString().split('T')[0];
        
        let tglMulai = tglHariIni;
        let tglAkhir = tglHariIni;
        let teksPeriode = "Hari Ini (" + tglHariIni + ")";

        if (tipePeriode === 'Mingguan') {
            // Siklus dimulai dari MINGGU agar pembayaran masuk ke Sabtu berikutnya
            const day = tglLokalObj.getDay(); // 0=Minggu, 6=Sabtu
            const diff = tglLokalObj.getDate() - day; 
            const tglMinggu = new Date(tglLokalObj.setDate(diff));
            tglMulai = tglMinggu.toISOString().split('T')[0];
            teksPeriode = `Siklus Mingguan (${tglMulai} s/d ${tglAkhir})`;
        } else if (tipePeriode === 'Bulanan') {
            let m = tglLokalObj.getMonth(); let y = tglLokalObj.getFullYear();
            if (tglLokalObj.getDate() <= 28) {
                tglMulai = new Date(y, m - 1, 29).toISOString().split('T')[0];
            } else {
                tglMulai = new Date(y, m, 29).toISOString().split('T')[0];
            }
            teksPeriode = `Siklus Bulanan (${tglMulai} s/d ${tglAkhir})`;
        }

        // Ambil absensi sesuai rentang mesin waktu
        const presensiPeriode = (emp.presensi || []).filter(p => p.tanggal >= tglMulai && p.tanggal <= tglAkhir && p.status_tiba);
        
        // 🔥 MESIN PENGHITUNG HARI BIASA VS HARI MINGGU 🔥
        let hariKerjaNormal = 0; let hariMingguMasuk = 0;
        let totalNormalMenit = 0; let totalLemburMenit = 0; let tepatWaktuCount = 0; let totalMenitTelat = 0;
        
        const parseJamMenit = (timeStr) => { if(!timeStr) return null; const [h, m] = timeStr.split(':'); return (parseInt(h) * 60) + parseInt(m); };
        const JAM_MASUK_NORMAL = 8 * 60; const BATAS_PULANG_NORMAL = 17 * 60;

        presensiPeriode.forEach(p => {
            if (p.status_tiba === 'Tepat Waktu') tepatWaktuCount++;
            
            // Deteksi apakah ini absen di Hari Minggu (0)
            const isSunday = new Date(p.tanggal).getDay() === 0;
            if (isSunday) { hariMingguMasuk++; } else { hariKerjaNormal++; }

            let masuk = parseJamMenit(p.waktu_tiba) || JAM_MASUK_NORMAL;
            let pulang = p.waktu_pulang ? parseJamMenit(p.waktu_pulang) : masuk;
            if (masuk > JAM_MASUK_NORMAL) totalMenitTelat += (masuk - JAM_MASUK_NORMAL);
            let actualPulangNormal = Math.min(pulang, BATAS_PULANG_NORMAL);
            totalNormalMenit += Math.max(0, actualPulangNormal - masuk);
            if (pulang > BATAS_PULANG_NORMAL) totalLemburMenit += (pulang - BATAS_PULANG_NORMAL);
        });

        // Kehadiran untuk syarat bonus hanya dihitung dari Senin-Sabtu
        const kehadiranMingguIni = hariKerjaNormal; 
        const isSabtu = new Date(waktuLokal - offset).getDay() === 6;
        const slip = (emp.slip_gaji || []).find(s => s.periode === tglAkhir && s.status === 'Menunggu');
        document.getElementById('m_slip_id').value = slip ? slip.id : '';

        window.currentSalaryData = {
            empId: emp.id, tipePeriode, teksPeriode, tglAkhir,
            totalNormalMenit, totalLemburMenit, tepatWaktuCount, 
            hariKerjaNormal, hariMingguMasuk, totalMenitTelat, isSabtu, kehadiranMingguIni, sisaKasbonDb: totalHutangKasbon
        };

        window.kalkulasiRealtimeGaji();
        window.openModal('modal-detail-gaji');
    };

    window.kalkulasiRealtimeGaji = function() {
        const d = window.currentSalaryData; if(!d) return;

        // 🔥 PECAH GAJI OTOMATIS 🔥
        const paramGajiUtuh = parseFloat(document.getElementById('setup_gaji_menit').value) || 0;
        let tarifPokokHarian = 0;
        
        if (d.tipePeriode === 'Harian') tarifPokokHarian = paramGajiUtuh;
        else if (d.tipePeriode === 'Mingguan') tarifPokokHarian = paramGajiUtuh / 6; // Dibagi 6 Hari (Senin-Sabtu)
        else if (d.tipePeriode === 'Bulanan') tarifPokokHarian = paramGajiUtuh / 26; // Dibagi 26 Hari Normal
        
        const tarifLemburMenit = parseFloat(document.getElementById('setup_lembur_menit').value) || 0;
        const paramBonusMingguan = parseFloat(document.getElementById('setup_bonus_mingguan').value) || 0;
        const paramPotonganAbsen = parseFloat(document.getElementById('setup_potongan_absen').value) || 0;
        const valPotonganKasbon = parseFloat(document.getElementById('potongan_kasbon_sekarang').value) || 0;
        
        const isKesehatan = document.getElementById('chk_uang_kesehatan').checked;
        const isRapat = document.getElementById('chk_uang_rapat').checked;
        const isNginep = document.getElementById('chk_uang_nginep').checked;
        const isTadarus = document.getElementById('chk_tadarus_alquran').checked;

        // 1️⃣ GAJI POKOK NORMAL (Senin - Sabtu proporsional)
        const valGajiNormal = d.hariKerjaNormal * Math.round(tarifPokokHarian);
        
        // 2️⃣ GAJI EXTRA HARI MINGGU (Dibayar full per kedatangan pakai rate harian)
        const valGajiMinggu = d.hariMingguMasuk * Math.round(tarifPokokHarian);
        
        // Gaji Pokok Total untuk Database
        const valGaji = valGajiNormal + valGajiMinggu;

        // 3️⃣ BONUS TEPAT WAKTU 
        const valBonusTepat = d.tepatWaktuCount * (parseFloat(document.getElementById('setup_bonus_tepat').value) || 0);

        // 4️⃣ BONUS MINGGUAN (Sistem Potong Absen)
        let valBonusMingguan = 0; let labelBonusMingguan = '';
        if (d.tipePeriode === 'Mingguan' && d.isSabtu) {
            let hariAbsen = 6 - d.kehadiranMingguIni; 
            if (hariAbsen < 0) hariAbsen = 0;

            if (d.kehadiranMingguIni === 0) {
                valBonusMingguan = 0;
                labelBonusMingguan = 'Tidak Masuk Penuh';
            } else {
                valBonusMingguan = paramBonusMingguan - (hariAbsen * paramPotonganAbsen);
                if (valBonusMingguan < 0) valBonusMingguan = 0;
                labelBonusMingguan = hariAbsen === 0 ? 'Full 6 Hari' : `Dipotong ${hariAbsen} Hari Absen`;
            }
        }

        const valLembur = d.totalLemburMenit * tarifLemburMenit;
        const valKesehatan = isKesehatan ? (parseFloat(document.getElementById('setup_uang_kesehatan').value) || 0) : 0;
        const valRapat = isRapat ? (parseFloat(document.getElementById('setup_uang_rapat').value) || 0) : 0;
        const valNginep = isNginep ? (parseFloat(document.getElementById('setup_uang_nginep').value) || 0) : 0;
        
        const valDenda = 0; // Denda menit dihapus sesuai request

        // GRAND TOTAL
        let grandTotal = valGaji + valLembur + valKesehatan + valBonusTepat + valBonusMingguan + valRapat + valNginep - valPotonganKasbon;
        if(grandTotal < 0) grandTotal = 0; 

        d.finalState = { valGaji, valLembur, valKesehatan, valBonusTepat, valBonusMingguan, valRapat, valNginep, valDenda, valPotonganKasbon, grandTotal, isTadarus };
        
        const totalHariAbsen = d.hariKerjaNormal + d.hariMingguMasuk;

        document.getElementById('m_rincian_list').innerHTML = `
            <div class="bg-blue-50/50 p-2.5 rounded mb-3 border border-blue-200">
                <div class="text-[11px] font-bold text-blue-900 uppercase tracking-widest text-center"><i class="bi bi-calendar-range mr-1"></i> ${d.teksPeriode}</div>
                <div class="text-[10px] font-semibold text-blue-700 text-center mt-1">Total Absen: ${totalHariAbsen} Hari (Termasuk ${d.hariMingguMasuk} Hr Minggu)</div>
            </div>
            
            <div class="flex justify-between text-xs"><span>Gaji Pokok Normal (${d.hariKerjaNormal} Hari)</span> <span class="font-bold text-gray-900">Rp ${valGajiNormal.toLocaleString('id-ID')}</span></div>
            ${valGajiMinggu > 0 ? `<div class="flex justify-between text-xs text-purple-700 font-bold bg-purple-50 p-1 rounded"><span>⭐ Extra Masuk Hari Minggu (${d.hariMingguMasuk} Hari)</span> <span>+ Rp ${valGajiMinggu.toLocaleString('id-ID')}</span></div>` : ''}
            
            ${valLembur > 0 ? `<div class="flex justify-between text-xs"><span>Uang Lembur (${d.totalLemburMenit} mnt)</span> <span class="font-bold text-gray-900">Rp ${valLembur.toLocaleString('id-ID')}</span></div>` : ''}
            ${d.tepatWaktuCount > 0 ? `<div class="flex justify-between text-xs text-green-700"><span>Bonus Tepat Waktu (${d.tepatWaktuCount}x)</span> <span class="font-bold">+ Rp ${valBonusTepat.toLocaleString('id-ID')}</span></div>` : ''}
            ${valBonusMingguan > 0 ? `<div class="flex justify-between text-xs text-green-700"><span>Bonus Mingguan (${labelBonusMingguan})</span> <span class="font-bold">+ Rp ${valBonusMingguan.toLocaleString('id-ID')}</span></div>` : ''}
            ${isRapat ? `<div class="flex justify-between text-xs text-green-700"><span>Uang Rapat</span> <span class="font-bold">+ Rp ${valRapat.toLocaleString('id-ID')}</span></div>` : ''}
            ${isNginep ? `<div class="flex justify-between text-xs text-green-700"><span>Uang Nginep</span> <span class="font-bold">+ Rp ${valNginep.toLocaleString('id-ID')}</span></div>` : ''}
            
            ${valPotonganKasbon > 0 ? `<div class="flex justify-between text-xs text-red-600 font-bold border-t border-dashed border-gray-300 mt-2 pt-2"><span>Potongan Kasbon Periode Ini</span> <span>- Rp ${valPotonganKasbon.toLocaleString('id-ID')}</span></div>` : ''}
        `;
        document.getElementById('m_total_gaji').innerText = `Rp ${grandTotal.toLocaleString('id-ID')}`;
    };

    // FUNGSI PENJEMBATAN (Simpan Draf ATAU Lempar ke Kasir)
    window.simpanSlipGaji = async function(statusTarget) {
        if(statusTarget === 'ACC') {
            // LEMPAR KE KASIR SPLIT PAYMENT
            document.getElementById('kasir_total_tagihan').innerText = `Rp ${window.currentSalaryData.finalState.grandTotal.toLocaleString('id-ID')}`;
            document.getElementById('kasir_keuangan').value = window.currentSalaryData.finalState.grandTotal; // Default isi semua ke Keuangan
            document.getElementById('kasir_gudang').value = 0;
            document.getElementById('kasir_owner').value = 0;
            window.kalkulasiKasir();
            window.openModal('modal-kasir-gaji');
        } else {
            // SIMPAN SEBAGAI DRAF MENUNGGU
            if(!confirm("Simpan Slip Periode ini sebagai Draf (Menunggu)?")) return;
            window.eksekusiBayarGaji('Menunggu'); 
        }
    };

    // LOGIKA KASIR SPLIT PAYMENT (UI)
    window.kalkulasiKasir = function() {
        const uK = parseFloat(document.getElementById('kasir_keuangan').value) || 0;
        const uG = parseFloat(document.getElementById('kasir_gudang').value) || 0;
        const uO = parseFloat(document.getElementById('kasir_owner').value) || 0;
        
        const totalTagihan = window.currentSalaryData.finalState.grandTotal;
        const totalSplit = uK + uG + uO;
        const sisa = totalTagihan - totalSplit;

        const elSisa = document.getElementById('kasir_sisa');
        const boxSisa = document.getElementById('kasir_sisa_box');
        const btnBayar = document.getElementById('btn-eksekusi-bayar');

        elSisa.innerText = `Rp ${sisa.toLocaleString('id-ID')}`;

        if (sisa === 0) {
            boxSisa.classList.replace('bg-red-50', 'bg-green-50');
            boxSisa.classList.replace('border-red-200', 'border-green-200');
            elSisa.classList.replace('text-red-700', 'text-green-700');
            btnBayar.disabled = false;
        } else {
            boxSisa.classList.replace('bg-green-50', 'bg-red-50');
            boxSisa.classList.replace('border-green-200', 'border-red-200');
            elSisa.classList.replace('text-green-700', 'text-red-700');
            btnBayar.disabled = true;
        }
    };

    // EKSEKUSI PEMBAYARAN FINAL KE DATABASE
    window.eksekusiBayarGaji = async function(overrideStatus = 'ACC') {
        if(!window.supabase) return;
        const d = window.currentSalaryData; const fs = d.finalState;
        const slipId = document.getElementById('m_slip_id').value;
        const btnBayar = document.getElementById('btn-eksekusi-bayar');
        btnBayar.innerText = "Memproses..."; btnBayar.disabled = true;

        try {
            const uK = parseFloat(document.getElementById('kasir_keuangan').value) || 0;
            const uG = parseFloat(document.getElementById('kasir_gudang').value) || 0;
            const uO = parseFloat(document.getElementById('kasir_owner').value) || 0;

            const payloadSlip = {
                user_id: d.empId, periode: d.tglAkhir, gaji_karyawan: fs.valGaji, uang_lembur: fs.valLembur,
                bonus_tepat_waktu: fs.valBonusTepat, bonus_mingguan: fs.valBonusMingguan, uang_kesehatan: fs.valKesehatan,
                uang_rapat: fs.valRapat, uang_nginep: fs.valNginep, 
                potongan_telat: fs.valDenda, menit_telat: d.totalMenitTelat, // Simpan histori denda
                kasbon: fs.valPotonganKasbon, total_diterima: fs.grandTotal,
                status: overrideStatus, is_paid_by_admin: overrideStatus === 'ACC',
                kas_keuangan_terpakai: overrideStatus === 'ACC' ? uK : 0, // Split payment dicatat
                kas_gudang_terpakai: overrideStatus === 'ACC' ? uG : 0,
                kas_owner_terpakai: overrideStatus === 'ACC' ? uO : 0
            };

            // 1. Simpan Slip Gaji (Akan mentrigger pemotongan dompet otomatis di DB)
            if(slipId) await window.supabase.from('slip_gaji').update(payloadSlip).eq('id', slipId);
            else await window.supabase.from('slip_gaji').insert([payloadSlip]);

            // 2. Kurangi total hutang kasbon di profil karyawan (Jika ada kasbon yang dipotong)
            if(overrideStatus === 'ACC' && fs.valPotonganKasbon > 0) {
                const sisaHutangBaru = d.sisaKasbonDb - fs.valPotonganKasbon;
                await window.supabase.from('setup_gaji').update({ kasbon: sisaHutangBaru }).eq('user_id', d.empId);
            }

            alert(`✅ SUKSES LUNAS!\n\nGaji dibayarkan dari:\n- Keuangan: Rp ${uK.toLocaleString('id-ID')}\n- Gudang: Rp ${uG.toLocaleString('id-ID')}\n- Owner: Rp ${uO.toLocaleString('id-ID')}\n\n*Hutang kasbon karyawan otomatis berkurang (jika ada potongan).`);
            window.location.reload();
        } catch(err) {
            alert('Waduh gagal bayar: ' + err.message);
            btnBayar.innerText = "POTONG KAS & BAYAR"; btnBayar.disabled = false;
        }
    };

    window.updateJamAbsenManual = () => {
        const valTiba = document.getElementById('edit_absen_tiba').value;
        const valPulang = document.getElementById('edit_absen_pulang').value;
        if (!valTiba) return;

        window.currentSalaryData.jamTibaStr = valTiba + ":00";
        window.currentSalaryData.jamPulangStr = valPulang ? valPulang + ":00" : '-';

        let masukMenit = parseJamMenit(window.currentSalaryData.jamTibaStr);
        let pulangMenit = valPulang ? parseJamMenit(window.currentSalaryData.jamPulangStr) : masukMenit;

        let totalNormalMenit = 0;
        let totalLemburMenit = 0;
        const batasPulangNormalMenit = 17 * 60;
        let actualPulangNormal = Math.min(pulangMenit, batasPulangNormalMenit);
        totalNormalMenit = Math.max(0, actualPulangNormal - masukMenit);
        if (pulangMenit > batasPulangNormalMenit) {
            totalLemburMenit = (pulangMenit - batasPulangNormalMenit);
        }

        window.currentSalaryData.totalNormalMenit = totalNormalMenit;
        window.currentSalaryData.totalLemburMenit = totalLemburMenit;
        window.kalkulasiRealtimeGaji();
    };

    // FUNGSI SIMPAN SETUP KE DATABASE
    window.simpanSetupGaji = async function() {
        if(!window.supabase) return;
        const empId = document.getElementById('m_karyawan_id').value;
        const setupId = document.getElementById('m_setup_id').value;

        const payloadSetup = {
            user_id: empId,
            gaji_menit: parseFloat(document.getElementById('setup_gaji_menit').value) || 0,
            uang_lembur_menit: parseFloat(document.getElementById('setup_lembur_menit').value) || 0,
            bonus_tepat_waktu: parseFloat(document.getElementById('setup_bonus_tepat').value) || 0,
            bonus_mingguan: parseFloat(document.getElementById('setup_bonus_mingguan').value) || 0,
            uang_kesehatan: parseFloat(document.getElementById('setup_uang_kesehatan').value) || 0,
            uang_rapat: parseFloat(document.getElementById('setup_uang_rapat').value) || 0,
            uang_nginep: parseFloat(document.getElementById('setup_uang_nginep').value) || 0,
            kasbon: parseFloat(document.getElementById('setup_kasbon').value) || 0, // INSERT KASBON
            tipe_periode: document.getElementById('setup_tipe_periode').value, // Periode
            potongan_bonus_mingguan: parseFloat(document.getElementById('setup_potongan_absen').value) || 0,
            activate_uang_rapat: document.getElementById('chk_uang_rapat').checked,
            activate_uang_nginep: document.getElementById('chk_uang_nginep').checked,
            activate_uang_kesehatan: document.getElementById('chk_uang_kesehatan').checked,
            tadarus_alquran: document.getElementById('chk_tadarus_alquran').checked
        };
        try {
            if(setupId) {
                const { error } = await window.supabase.from('setup_gaji').update(payloadSetup).eq('id', setupId);
                if (error) throw error;
            } else {
                const { data, error } = await window.supabase.from('setup_gaji').insert([payloadSetup]).select().single();
                if (error) throw error;
                if(data) document.getElementById('m_setup_id').value = data.id;
            }
            alert('Mantap! Parameter Setup Gaji & Kasbon Berhasil Disimpan ke Database!');
            kalkulasiRealtimeGaji(); 
        } catch(err) { 
            console.error("Error Detail Supabase:", err);
            alert('Gagal simpan setup! Cek pesan ini:\n' + err.message); 
        }
    };

    // RIWAYAT GAJI LOADER
    async function muatRiwayatGaji() {
        const container = document.getElementById('riwayat-gaji-container');
        if (!container) return;

        const start = document.getElementById('filter-gaji-start')?.value || awalTahun;
        const end = document.getElementById('filter-gaji-end')?.value || hariIni;
        const cacheKey = `riwayat_gaji_${start}_${end}`;
        const cachedData = localStorage.getItem(cacheKey);

        const renderHTML = (dataGaji) => {
            if (!dataGaji || dataGaji.length === 0) {
                container.innerHTML = `<p class="text-gray-500 text-sm italic py-4">Tidak ada riwayat pengeluaran gaji dari tanggal ${start} sampai ${end}.</p>`;
                return;
            }

            container.innerHTML = dataGaji.map(slip => {
                const isACC = slip.status === 'ACC' || slip.status_persetujuan === 'ACC';
                // 🔥 Pastikan inisial ngambil per kata, bukan cuma potong string
                const inisial = slip.profiles?.nama ? slip.profiles.nama.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'KY';
                
                // 🔥 Beri sentuhan warna biru agar beda dengan tabel karyawan di atas
                const avatarKomponen = slip.profiles?.foto_profil 
                    ? `<img src="${slip.profiles.foto_profil}" class="w-10 h-10 rounded-full object-cover border-2 border-gray-200 shadow-sm shrink-0" />`
                    : `<div class="w-10 h-10 rounded-full bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-700 font-bold text-sm shadow-sm shrink-0">${inisial}</div>`;

                return `
                    <div class="p-4 border border-gray-200 rounded-xl mb-3 bg-white shadow-sm flex gap-3 items-center">
                        ${avatarKomponen}
                        <div class="flex-1">
                            <div class="flex justify-between items-center">
                                <div>
                                    <p class="font-bold text-gray-900">${slip.profiles?.nama || 'Karyawan'}</p>
                                    <p class="text-xs text-gray-500">Periode: ${slip.periode || '-'}</p>
                                </div>
                                <span class="px-2 py-1 rounded text-xs font-bold ${isACC ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800'}">
                                    ${slip.status || 'Menunggu'}
                                </span>
                            </div>
                            ${isACC ? `
                                <div class="mt-2 text-xs space-y-1 border-t pt-2 border-dashed border-gray-300">
                                    <div class="flex justify-between"><span>Gaji Pokok:</span> <span>Rp ${Number(slip.gaji_karyawan || 0).toLocaleString('id-ID')}</span></div>
                                    <div class="flex justify-between text-gray-500"><span>Uang Lembur:</span> <span>Rp ${Number(slip.uang_lembur || 0).toLocaleString('id-ID')}</span></div>
                                    <div class="flex justify-between text-green-700"><span>Total Bonus (Tepat Waktu, Mingguan, Sehat):</span> <span>+Rp ${Number((slip.bonus_tepat_waktu || 0) + (slip.bonus_mingguan || 0) + (slip.uang_kesehatan || 0)).toLocaleString('id-ID')}</span></div>
                                    ${Number(slip.kasbon || 0) > 0 ? `<div class="flex justify-between text-red-600 font-bold"><span>Potongan Kasbon:</span> <span>-Rp ${Number(slip.kasbon).toLocaleString('id-ID')}</span></div>` : ''}
                                    <div class="flex justify-between font-bold text-green-700 mt-1 pt-1 border-t">
                                        <span>Total Diterima (ACC):</span> 
                                        <span>Rp ${Number(slip.total_diterima || 0).toLocaleString('id-ID')}</span>
                                    </div>
                                </div>
                            ` : `
                                <div class="mt-2 text-xs text-amber-700 italic border-t pt-2 border-dashed border-gray-300">
                                    * Rincian disembunyikan sampai status disetujui (ACC).
                                </div>
                            `}
                        </div>
                    </div>`;
            }).join('');
        };

        if (cachedData) {
            renderHTML(JSON.parse(cachedData));
        } else {
            container.innerHTML = '<p class="text-gray-500 text-sm italic animate-pulse">Memuat data riwayat gaji...</p>';
        }

        try {
            const { data: dataGaji, error } = await supabase
                .from('slip_gaji')
                .select(`*, profiles!inner(nama, role, foto_profil)`)
                .neq('profiles.role', 'owner')
                .gte('created_at', `${start} 00:00:00`)
                .lte('created_at', `${end} 23:59:59`)
                .order('created_at', { ascending: false });
            if (error) throw error;

            localStorage.setItem(cacheKey, JSON.stringify(dataGaji));
            renderHTML(dataGaji);
        } catch (error) {
            console.error("Supabase Error:", error);
            if (!cachedData) {
                container.innerHTML = `
                    <div class="p-4 bg-red-50 text-red-700 rounded-xl text-xs">
                        <p class="font-bold">Gagal sinkronisasi data dengan server:</p>
                        <p class="italic mt-1">${error.message}</p>
                    </div>`;
            }
        }
    }
    document.getElementById('btn-filter-gaji')?.addEventListener('click', muatRiwayatGaji);
    window.filterTipeGaji = function(tipe) {
        document.querySelectorAll('.filter-gaji-btn').forEach(btn => {
            if (btn.innerText.includes(tipe) || (tipe === 'Semua' && btn.innerText === 'Semua')) {
                btn.classList.add('active', 'bg-white', 'shadow-sm', 'text-green-700');
                btn.classList.remove('text-gray-500');
            } else {
                btn.classList.remove('active', 'bg-white', 'shadow-sm', 'text-green-700');
                btn.classList.add('text-gray-500');
            }
        });
        
        document.querySelectorAll('.karyawan-card').forEach(card => {
            if (tipe === 'Semua' || card.getAttribute('data-periode') === tipe) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    };
  });
</script>