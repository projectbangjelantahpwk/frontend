            await loadOperasionalData();
            const btnFilterMulti = document.getElementById('btn-filter-multi');
            const dropdownMulti = document.getElementById('dropdown-filter-multi');
            const ruteCheckboxes = document.querySelectorAll('.filter-rute-cb');
            const startInput = document.getElementById('filter-start-date');
            const endInput = document.getElementById('filter-end-date');

            if(btnFilterMulti && dropdownMulti) {
                // Buka tutup menu
                btnFilterMulti.addEventListener('click', () => dropdownMulti.classList.toggle('hidden'));
                document.addEventListener('click', (e) => {
                    if (!btnFilterMulti.contains(e.target) && !dropdownMulti.contains(e.target)) {
                        dropdownMulti.classList.add('hidden');
                    }
                });
            }

            window.applyMultiFilters = function() {
                const checkedRoutes = Array.from(ruteCheckboxes).filter(cb => cb.checked).map(cb => cb.value.toLowerCase());
                const startVal = startInput?.value;
                const endVal = endInput?.value;
                
                const allRows = document.querySelectorAll('#tbody-pending tr, #tbody-progress tr, #tbody-history tr');

                allRows.forEach(row => {
                    // Abaikan baris loading "Memuat data..." atau pesan "Kosong"
                    if (row.children.length === 1 && row.cells[0].colSpan > 1) return; 

                    const rute = (row.getAttribute('data-rute') || '').toLowerCase();
                    const tanggal = row.getAttribute('data-tanggal') || ''; 
                    
                    // 🔥 FIX: Kalau rute di database belum diisi (kosong), loloskan saja biar gak hilang! 🔥
                    let isRuteSesuai = false;
                    if (rute === '') {
                        isRuteSesuai = true; 
                    } else {
                        isRuteSesuai = checkedRoutes.some(checked => rute.includes(checked));
                    }
                    
                    // Filter Tanggal KHUSUS untuk tabel Riwayat Selesai
                    let isTanggalSesuai = true; 
                    if (row.closest('#tbody-history') && tanggal) {
                        if (startVal && tanggal < startVal) isTanggalSesuai = false;
                        if (endVal && tanggal > endVal) isTanggalSesuai = false;
                    }

                    row.style.display = (isRuteSesuai && isTanggalSesuai) ? '' : 'none';
                });
            };

            // Trigger jalan otomatis saat input rute atau tanggal diubah
            ruteCheckboxes.forEach(cb => cb.addEventListener('change', window.applyMultiFilters));
            if(startInput) startInput.addEventListener('change', window.applyMultiFilters);
            if(endInput) endInput.addEventListener('change', window.applyMultiFilters);

        // =======================================================
        // FUNGSI GANTI TAB SAKTI (UI + LOGIKA TANGGAL)
        // =======================================================
        window.switchTab = function(tabId) {
            const tabs = ['pending', 'progress', 'history'];
            
            // 1. Reset semua tab menjadi tidak aktif (Sembunyikan)
            tabs.forEach(id => {
                const btn = document.getElementById(`tab-${id}`);
                const content = document.getElementById(`content-${id}`);
                
                if (btn && content) {
                    btn.classList.remove('text-primary', 'border-primary');
                    btn.classList.add('text-on-surface-variant', 'border-transparent');
                    content.classList.remove('active');
                }
            });

            // 2. Aktifkan tab yang di-klik (Munculkan)
            const activeBtn = document.getElementById(`tab-${tabId}`);
            const activeContent = document.getElementById(`content-${tabId}`);
            
            if (activeBtn && activeContent) {
                activeBtn.classList.remove('text-on-surface-variant', 'border-transparent');
                activeBtn.classList.add('text-primary', 'border-primary');
                activeContent.classList.add('active');
            }

            // 3. Logika Filter Tanggal (Hanya muncul di Riwayat Selesai)
            const historySection = document.getElementById('filter-history-section');
            if (historySection) {
                if (tabId === 'history') {
                    historySection.classList.remove('hidden');
                } else {
                    historySection.classList.add('hidden');
                }
            }
            
            // 4. Jalankan ulang filter supaya rapi
            if (typeof window.applyMultiFilters === 'function') {
                setTimeout(window.applyMultiFilters, 50);
            }
        };

        const isAllowed = () => ['owner', 'hrd', 'admin'].includes(currentUserRole);

        // ==========================================
        // 1. BUAT PENJEMPUTAN BARU (KOSONGKAN FORM)
        // ==========================================
        window.tambahPenjemputan = function() {
            if(!isAllowed()) return alert('Akses Ditolak: Hanya Admin, HRD, dan Owner yang diizinkan menerbitkan penugasan!');
            
            document.getElementById('edit_penjemputan_id').value = '';
            document.getElementById('modal-title-pickup').innerText = "Tugaskan Jadwal Baru";
            
            // Reset isian HTML manual
            document.getElementById('input_mitra').value = '';
            document.getElementById('detail_mitra_box').classList.add('hidden');
            document.getElementById('input_tanggal').valueAsDate = new Date();
            document.getElementById('input-wilayah').value = '';
            document.getElementById('input_dp').value = '';
            
            const estimasiIds = ['est-minyak', 'est-tepung', 'est-kriuk', 'est-spinner', 'est-ampas'];
            estimasiIds.forEach(id => { const el = document.getElementById(id); if(el) el.value = '0'; });

            window.setVehicle('motor');
            document.getElementById('new-pickup-modal').classList.add('active');
        };

        // ==========================================
        // 2. EDIT PENJEMPUTAN (ISI OTOMATIS DATA LAMA)
        // ==========================================
        window.editPenjemputan = function(id) {
            if(!isAllowed()) return alert('Akses Ditolak!');
            
            const p = window.allJadwalPending.find(x => x.id == id);
            if(!p) return alert("Data tidak ditemukan di sesi ini, silakan refresh halaman.");

            document.getElementById('edit_penjemputan_id').value = id;
            document.getElementById('modal-title-pickup').innerText = "Edit Jadwal Penugasan";

            // Tempel data Utama
            document.getElementById('input_mitra').value = p.mitra?.id || '';
            document.getElementById('input_mitra').dispatchEvent(new Event('change')); // Trigger Gmaps box
            document.getElementById('input_tanggal').value = p.tanggal;
            document.getElementById('input-wilayah').value = p.rute_penjemputan || '';

            // Tempel Kendaraan & Kurir
            window.setVehicle(p.kendaraan === 'mobil' ? 'mobil' : 'motor');
            if(p.kendaraan === 'mobil') {
                document.getElementById('input_driver_mobil').value = p.driver?.id || '';
                document.getElementById('input_driver_mobil').dispatchEvent(new Event('change')); // Trigger helper options
                setTimeout(() => { document.getElementById('input_helper_mobil').value = p.helper?.id || ''; }, 100);
            } else {
                document.getElementById('input_driver_motor').value = p.driver?.id || '';
            }

            // Tempel Rincian & DP
            const tx = p.transaksi?.[0];
            document.getElementById('input_dp').value = tx?.potongan_dp || '';
            
            const estimasiIds = ['est-minyak', 'est-tepung', 'est-kriuk', 'est-spinner', 'est-ampas'];
            estimasiIds.forEach(eid => document.getElementById(eid).value = '0');

            if(tx && tx.transaksi_item) {
                tx.transaksi_item.forEach(item => {
                    const k = item.komoditas.toLowerCase();
                    if(k.includes('minyak')) document.getElementById('est-minyak').value = item.volume;
                    else if(k.includes('tepung')) document.getElementById('est-tepung').value = item.volume;
                    else if(k.includes('kriuk')) document.getElementById('est-kriuk').value = item.volume;
                    else if(k.includes('spinner')) document.getElementById('est-spinner').value = item.volume;
                    else if(k.includes('ampas')) document.getElementById('est-ampas').value = item.volume;
                });
            }

            document.getElementById('new-pickup-modal').classList.add('active');
        };

        // ==========================================
        // 3. HAPUS PENJEMPUTAN (DELETE CASCADE BERANTAI)
        // ==========================================
        window.hapusPenjemputan = async function(id) {
            if(!isAllowed()) return alert('Akses Ditolak!');
            if(!confirm("Yakin ingin membatalkan/menghapus penugasan ini secara permanen?")) return;

            try {
                const p = window.allJadwalPending.find(x => x.id == id);
                if(p && p.transaksi && p.transaksi[0]) {
                    const txId = p.transaksi[0].id;
                    // Hapus Item dulu
                    await window.supabase.from('transaksi_item').delete().eq('transaksi_id', txId);
                    // Hapus Induk Transaksi
                    await window.supabase.from('transaksi').delete().eq('id', txId);
                }
                // Terakhir hapus Jadwal Utamanya
                const { error } = await window.supabase.from('penjemputan').delete().eq('id', id);
                if(error) throw error;
                
                alert('Jadwal berhasil dihapus!');
                window.location.reload();
            } catch(e) {
                alert('Gagal menghapus jadwal: ' + e.message);
            }
        };

        window.closeModal = function() {
            document.getElementById('new-pickup-modal').classList.remove('active');
