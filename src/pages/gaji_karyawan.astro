            ${res.valRapat > 0 ? `<div class="flex justify-between text-xs text-teal-700 mt-1"><span>Uang Rapat</span> <span class="font-bold">+ Rp ${res.valRapat.toLocaleString("id-ID")}</span></div>` : ""}
