            ${res.valTalangan > 0 ? `<div class="flex justify-between text-xs text-green-700 font-bold border-t border-dashed border-gray-300 mt-2 pt-2"><span>Uang Talangan (Reimbursement)</span> <span>+ Rp ${res.valTalangan.toLocaleString("id-ID")}</span></div>` : ""}

            ${res.potonganKasbonDasar > 0 ? `<div class="flex justify-between text-xs text-red-600 font-bold border-t border-dashed border-gray-300 mt-2 pt-2"><span>Potongan Kasbon (Hutang Dasar)</span> <span>- Rp ${res.potonganKasbonDasar.toLocaleString("id-ID")}</span></div>` : ""}
            
            ${res.kasbonUangJalan > 0 ? `<div class="flex justify-between text-xs text-red-700 font-black bg-red-100/80 p-2 rounded-lg mt-1 border border-red-200 shadow-sm"><span>⚠️ Kasbon Uang Jalan (Dadakan)</span> <span>- Rp ${res.kasbonUangJalan.toLocaleString("id-ID")}</span></div>` : ""}
            
            ${htmlLainLainPreview}
        `;

        document.getElementById("m_total_gaji").innerText =
