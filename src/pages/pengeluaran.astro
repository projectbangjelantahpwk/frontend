    // 3. Fungsi Eksekusi Simpan Perubahan Single Item ke Server
    window.simpanEditItemSingle = async function(e) {
        e.preventDefault();
        if(!window.supabase) return;

        const btnSave = document.getElementById('btn-save-peng');
        btnSave.innerText = "Menyimpan...";
        btnSave.disabled = true;

        try {
            const form = document.getElementById('form-edit-pengeluaran');
            const pengeluaranId = form.dataset.pengId; // Tarik ID Induk

            const row = document.querySelector('.peng-item-row');
            const rincianId = row.getAttribute('data-id');
            const kategoriTerpilih = row.querySelector('.peng_item_select').value;
            const nominalBaru = parseFloat(row.querySelector('.peng_item_nominal').value) || 0;
            const teksCustom = row.querySelector('.peng_item_custom').value.trim();
            const keteranganBaru = row.querySelector('.edit_item_keterangan').value.trim();
            
            // 🔥 Tangkap nilai sumber dana yang baru dipilih
            const sumberDanaBaru = row.querySelector('.edit_sumber_dana').value; 

            let finalNamaItem = kategoriTerpilih === 'Lain-lain' ? (teksCustom || 'Lain-lain') : kategoriTerpilih;

            // Update data rinciannya
            const { error: errRincian } = await window.supabase
                .from('rincian_pengeluaran')
                .update({
                    nama_item: finalNamaItem,
                    nominal: nominalBaru,
                    keterangan: keteranganBaru || null
                })
                .eq('id', rincianId);

            if(errRincian) throw errRincian;

            // Update sumber dananya di tabel induk (pengeluaran)
            if(pengeluaranId) {
                const { error: errInduk } = await window.supabase
                    .from('pengeluaran')
                    .update({ sumber_dana: sumberDanaBaru })
                    .eq('id', pengeluaranId);
                    
                if(errInduk) throw errInduk;
            }

            alert("Koreksi Rincian dan Sumber Dana berhasil diperbarui!");
            window.location.reload();
        } catch(err) {
            alert("Gagal memperbarui item: " + err.message);
            btnSave.innerText = "SIMPAN PERUBAHAN DATA"; btnSave.disabled = false;
        }
    };

