    // FUNGSI UNTUK MENGUBAH LABEL UI BERDASARKAN SIKLUS
    window.ubahSiklusUI = function () {
      const siklus = document.getElementById("setup_siklus_gaji").value;
      const labelGaji = document.getElementById("label_gaji_pokok");

      if (siklus === "Bulanan") labelGaji.innerText = "Gaji Pokok Bulanan (Rp)";
      else if (siklus === "Harian")
        labelGaji.innerText = "Gaji Pokok Harian (Rp)";
      else labelGaji.innerText = "Gaji Pokok Mingguan (Rp)";

      if (window.currentSalaryData) {
        window.currentSalaryData.siklusGaji = siklus;

        // 🔥 CARA AMAN AMBIL TANGGAL HARI INI (Tanpa hitung-hitungan offset yang bikin eror)
        const today = new Date();
        const year = today.getFullYear();
        const month = String(today.getMonth() + 1).padStart(2, "0");
        const day = String(today.getDate()).padStart(2, "0");
        const strHariIni = `${year}-${month}-${day}`;

        let tglMulai, tglAkhir;

        if (siklus === "Bulanan") {
          tglMulai = `${year}-${month}-01`;
          // Tembak akhir bulan dengan trik hari ke-0 bulan depan
          const dAkhir = new Date(year, today.getMonth() + 1, 0);
          tglAkhir = `${year}-${month}-${String(dAkhir.getDate()).padStart(2, "0")}`;
        } else if (siklus === "Harian") {
          // Fix Mutlak Hari Ini
          tglMulai = strHariIni;
          tglAkhir = strHariIni;
        } else {
          // Siklus Mingguan
          const h = today.getDay() || 7; // Hari ini (1-7, 1=Senin)
          const senin = new Date(today);
          senin.setDate(today.getDate() - (h - 1));

          const mSenin = String(senin.getMonth() + 1).padStart(2, "0");
          const dSenin = String(senin.getDate()).padStart(2, "0");
          tglMulai = `${senin.getFullYear()}-${mSenin}-${dSenin}`;

          const minggu = new Date(senin);
          minggu.setDate(senin.getDate() + 6); // Tarik 6 hari ke depan (Sampai Minggu)

          const mMinggu = String(minggu.getMonth() + 1).padStart(2, "0");
          const dMinggu = String(minggu.getDate()).padStart(2, "0");
          tglAkhir = `${minggu.getFullYear()}-${mMinggu}-${dMinggu}`;
        }

        window.currentSalaryData.tglMulai = tglMulai;
        window.currentSalaryData.tglAkhir = tglAkhir;
      }
    };

