    // 🔥 Buka Modal Detail Absen (untuk approval)
    // 🔥 Buka Modal Detail Absen (untuk approval)
    window.bukaModalDetailAbsen = function (idAbsen) {
      const p = window.currentEmployee?.presensi?.find(
        (x) => String(x.id) === String(idAbsen),
      );
      if (!p) return alert("Data absensi tidak ditemukan!");

      document.getElementById("det_abs_id").value = p.id;
      document.getElementById("det_abs_tgl").innerText = p.tanggal || "-";
      document.getElementById("det_abs_masuk").innerText = p.waktu_tiba
        ? p.waktu_tiba.substring(0, 5)
        : "-";
      document.getElementById("det_abs_pulang").innerText = p.waktu_pulang
        ? p.waktu_pulang.substring(0, 5)
        : "-";

      // Isi input jam untuk diedit
      document.getElementById("det_abs_edit_masuk").value = p.waktu_tiba || "";
      document.getElementById("det_abs_edit_pulang").value =
        p.waktu_pulang || "";

      // 🔥 TAMPILKAN STATUS CENTANGAN TERBARU DARI DATABASE
      document.getElementById("det_abs_edit_tadarus").checked =
        p.is_tadarus || false;
      document.getElementById("det_abs_edit_rapat").checked =
        p.is_rapat || false;
      document.getElementById("det_abs_edit_nginep").checked =
        p.is_nginep || false;

      // 🔥 FUNGSI KALKULATOR LIVE LEMBUR (LINTAS HARI)
      const parseJam = (t) => {
        if (!t) return null;
        const [h, m] = t.split(":");
        return parseInt(h) * 60 + parseInt(m);
      };

      const hitungLemburLive = () => {
        let mStr = document.getElementById("det_abs_edit_masuk").value;
        let pStr = document.getElementById("det_abs_edit_pulang").value;
        const infoLembur = document.getElementById("det_abs_info_lembur");

        let mM = parseJam(mStr);
        let pM = parseJam(pStr);

        if (mM !== null && pM !== null) {
          if (pM < mM) pM += 24 * 60; // Logika Lintas Hari
          // ✅ BARU - Menampilkan MENIT tanpa pembulatan
          if (pM > 17 * 60) {
            let menit = pM - 17 * 60; // Langsung dalam menit
            document.getElementById("det_abs_jam_lembur").innerText =
              menit + " Menit";
            infoLembur.classList.remove("hidden");
            return;
          }
        }
        infoLembur.classList.add("hidden");
      };

      // Panggil saat pertama buka, dan jadikan responsif saat diketik
      hitungLemburLive();
      document.getElementById("det_abs_edit_masuk").oninput = hitungLemburLive;
      document.getElementById("det_abs_edit_pulang").oninput = hitungLemburLive;

      // Ganti warna badge
      const setBadge = (elId, status) => {
        const el = document.getElementById(elId);
        el.innerText = status || "-";
        if (status === "Telat")
          el.className =
            "inline-block mt-2 text-[10px] px-2 py-0.5 rounded-full bg-red-100 text-red-700 font-bold uppercase tracking-wider";
        else
          el.className =
            "inline-block mt-2 text-[10px] px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 font-bold uppercase tracking-wider";
      };

      setBadge("det_abs_status_masuk", p.status_tiba);
      setBadge("det_abs_status_pulang", p.status_pulang);

      // Suntikkan tombol foto
      const containerFoto = document.getElementById("det_abs_foto_container");
      if (containerFoto) {
        containerFoto.innerHTML = `
                    <div class="flex gap-2">
                        ${
                          p.foto_tiba
                            ? `<button onclick="window.lihatFotoAbsen('${p.id}', 'tiba')" class="flex-1 bg-blue-50 text-blue-700 text-xs font-bold py-2.5 rounded-lg hover:bg-blue-100 transition border border-blue-200 shadow-sm active:scale-95">📸 Lihat Foto Tiba</button>`
                            : `<button class="flex-1 bg-gray-50 text-gray-400 text-xs font-bold py-2.5 rounded-lg border border-gray-200 cursor-not-allowed">📸 Foto Tiba Kosong</button>`
                        }
                        ${
                          p.foto_pulang
                            ? `<button onclick="window.lihatFotoAbsen('${p.id}', 'pulang')" class="flex-1 bg-green-50 text-green-700 text-xs font-bold py-2.5 rounded-lg hover:bg-green-100 transition border border-green-200 shadow-sm active:scale-95">📸 Lihat Foto Pulang</button>`
                            : `<button class="flex-1 bg-gray-50 text-gray-400 text-xs font-bold py-2.5 rounded-lg border border-gray-200 cursor-not-allowed">📸 Foto Pulang Kosong</button>`
                        }
                    </div>
                `;
      }

      openModal("modal-detail-absen");
    };

    // 🔥 FUNGSI APPROVE PRESENSI
    window.approvePresensi = async function (status) {
      if (
        !confirm(
          `Yakin ingin ${status === "Disetujui" ? "MENYETUJUI" : "MENOLAK"} presensi ini?`,
        )
      )
        return;

      const id = document.getElementById("det_abs_id").value;
      const jamMasuk = document.getElementById("det_abs_edit_masuk").value;
      const jamPulang = document.getElementById("det_abs_edit_pulang").value;

      // 🔥 TANGKAP NILAI KETIGA CHECKBOX
      const isTadarus = document.getElementById("det_abs_edit_tadarus").checked;
      const isRapat = document.getElementById("det_abs_edit_rapat").checked;
      const isNginep = document.getElementById("det_abs_edit_nginep").checked;

      if (!jamMasuk || !jamPulang) {
        alert("Mohon isi jam masuk dan jam pulang!");
        return;
      }

      try {
        const { error } = await supabase
          .from("presensi")
          .update({
            status_approval: status,
            waktu_tiba: jamMasuk,
            waktu_pulang: jamPulang,
            is_tadarus: isTadarus,
            is_rapat: isRapat, // 🔥 SIMPAN KE DB
            is_nginep: isNginep, // 🔥 SIMPAN KE DB
          })
          .eq("id", id);

        if (error) throw error;

        alert(`Presensi berhasil ${status.toLowerCase()}!`);
        closeModal("modal-detail-absen");

        // Refresh data (dengan select tambahan kolom)
        const currentEmpId = window.currentEmployee.id;
        const { data: freshData } = await supabase
          .from("profiles")
          .select(
            "id, id_lapangan, nama, nomor_hp, foto_profil, role, presensi(id, tanggal, waktu_tiba, waktu_pulang, status_tiba, status_pulang, status_approval, foto_tiba, foto_pulang, is_tadarus, is_rapat, is_nginep), izin_karyawan(id, tanggal, tipe_izin, status_pengajuan, alasan, foto_bukti, jam_rencana_keluar)",
          )
          .order("nama", { ascending: true });

        if (freshData) {
          window.daftarKaryawan = freshData;
          window.currentEmployee = freshData.find((k) => k.id === currentEmpId);
          renderKaryawan(window.daftarKaryawan);
          filterRiwayat();
        }
      } catch (err) {
        alert("Gagal approve presensi: " + err.message);
      }
    };

    // 🔥 Buka Modal Detail Izin (untuk approval)
    window.bukaModalDetailIzin = function (izinId) {
      const iz = window.currentEmployee?.izin_karyawan?.find(
        (x) => String(x.id) === String(izinId),
      );
      if (!iz) return alert("Data berkas izin tidak ditemukan!");

      document.getElementById("detail_izin_id").value = iz.id;
      document.getElementById("detail_izin_alasan").value = iz.alasan || "";
      document.getElementById("detail_izin_foto_edit").value =
        iz.foto_bukti || "";

      const wrapJam = document.getElementById("wrapper_jam_keluar");
      if (iz.jam_rencana_keluar) {
        wrapJam.classList.remove("hidden");
        document.getElementById("detail_izin_jam_keluar").innerText =
          iz.jam_rencana_keluar.substring(0, 5);
      } else {
        wrapJam.classList.add("hidden");
      }

      const imgContainer = document.getElementById(
        "detail_izin_foto_container",
      );
      if (iz.foto_bukti) {
        imgContainer.innerHTML = `
                    <a href="${iz.foto_bukti}" target="_blank" class="block mt-2 hover:opacity-90 transition">
                        <img src="${iz.foto_bukti}" alt="Berkas Lampiran" class="w-full h-44 object-contain bg-gray-100 rounded-xl border border-gray-200 shadow-sm" />
                    </a>
                    <p class="text-[10px] text-center text-gray-500 mt-1.5 italic">Klik gambar untuk memperbesar</p>
                `;
      } else {
        imgContainer.innerHTML = `
                    <div class="p-4 bg-gray-50 border border-gray-200 border-dashed rounded-xl text-center text-xs text-gray-400 italic mt-1">
                        Karyawan tidak menyertakan foto bukti lampiran.
                    </div>
                `;
      }

      // ✅ KODE BARU (tampil untuk semua izin/sakit/pulang cepat)
      const containerAksi = document.getElementById(
        "detail_izin_aksi_container",
      );
      const typeIzin = String(iz.tipe_izin || "")
        .toLowerCase()
        .trim();

      // Tampilkan tombol jika tipe izin adalah: izin, sakit, atau izin pulang cepat
      if (
        typeIzin === "izin" ||
        typeIzin === "sakit" ||
        typeIzin === "izin pulang cepat"
      ) {
        containerAksi.classList.remove("hidden");
      } else {
        containerAksi.classList.add("hidden");
      }

      openModal("modal-detail-izin");
    };

    // 🔥 FUNGSI APPROVE IZIN
    window.approveIzin = async function (status) {
      if (
        !confirm(
          `Yakin ingin ${status === "Disetujui" ? "MENYETUJUI" : "MENOLAK"} pengajuan izin ini?`,
        )
      )
        return;

      const idIzin = document.getElementById("detail_izin_id").value;
      const alasanBaru = document.getElementById("detail_izin_alasan").value;
      const fotoBaru = document.getElementById("detail_izin_foto_edit").value;

      try {
        const { error: errorIzin } = await supabase
          .from("izin_karyawan")
          .update({
            status_pengajuan: status,
            alasan: alasanBaru,
            foto_bukti: fotoBaru || undefined,
          })
          .eq("id", idIzin);

        if (errorIzin) throw errorIzin;

        alert(`Pengajuan izin berhasil ${status.toLowerCase()}!`);
        closeModal("modal-detail-izin");

        // Refresh data
        const currentEmpId = window.currentEmployee.id;
        const { data: freshData } = await supabase
          .from("profiles")
          .select(
            "id, id_lapangan, nama, nomor_hp, foto_profil, role, presensi(id, tanggal, waktu_tiba, waktu_pulang, status_tiba, status_pulang, status_approval, foto_tiba, foto_pulang), izin_karyawan(id, tanggal, tipe_izin, status_pengajuan, alasan, foto_bukti, jam_rencana_keluar)",
          )
          .order("nama", { ascending: true });

        if (freshData) {
          window.daftarKaryawan = freshData;
          window.currentEmployee = freshData.find((k) => k.id === currentEmpId);
          renderKaryawan(window.daftarKaryawan);
          filterRiwayat();
        }
      } catch (err) {
        alert("Gagal approve izin: " + err.message);
      }
    };

    // Kontrol Modal
    window.openModal = function (id) {
      const m = document.getElementById(id);
      if (!m) return;
      m.classList.remove("hidden");
      m.classList.add("flex");
      setTimeout(() => {
        m.classList.remove("opacity-0");
        const isi = m.querySelector("div");
        if (isi) isi.classList.remove("scale-95");
      }, 10);
    };

    window.closeModal = function (id) {
      const m = document.getElementById(id);
      if (!m) return;
      m.classList.add("opacity-0");
      const isi = m.querySelector("div");
      if (isi) isi.classList.add("scale-95");
      setTimeout(() => {
        m.classList.add("hidden");
        m.classList.remove("flex");
      }, 300);
    };

    // Init
    document.addEventListener("DOMContentLoaded", async () => {
      const allowedRoles = ["owner", "hrd", "keuangan", "it"];
      const client = window.supabase || supabase;

      const {
        data: { session },
      } = await client.auth.getSession();
      if (!session) return window.location.replace("/");

      const { data: prof } = await client
        .from("profiles")
        .select("role")
        .eq("id", session.user.id)
        .single();
      if (!allowedRoles.includes(prof?.role)) {
        alert(`Akses Ditolak! Data karyawan terbatas untuk Owner & HRD.`);
        return window.location.replace("/");
      }
      document.body.style.display = "block";

      fetchKaryawan();
    });
  </script>
</Layout>
