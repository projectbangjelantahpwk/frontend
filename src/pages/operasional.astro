        window.setVehicle = function(type) {
            document.getElementById('tipe_kendaraan_input').value = type;
            const btnMotor = document.getElementById('btn-motor');
            const btnMobil = document.getElementById('btn-mobil');
            const selectMotor = document.getElementById('kurir-motor-select');
            const selectMobil = document.getElementById('kurir-mobil-select');

            if (type === 'motor') {
                btnMotor.className = 'flex-1 py-2 rounded-md font-label-sm bg-surface shadow text-primary font-bold transition-all';
                btnMobil.className = 'flex-1 py-2 rounded-md font-label-sm text-on-surface-variant hover:bg-surface-variant transition-all';
                selectMotor.classList.replace('hidden', 'block');
                selectMobil.classList.replace('flex', 'hidden');
                document.getElementById('input_driver_motor').required = true;
                document.getElementById('input_driver_mobil').required = false;
            } else {
                btnMobil.className = 'flex-1 py-2 rounded-md font-label-sm bg-surface shadow text-primary font-bold transition-all';
                btnMotor.className = 'flex-1 py-2 rounded-md font-label-sm text-on-surface-variant hover:bg-surface-variant transition-all';
                selectMotor.classList.replace('block', 'hidden');
                selectMobil.classList.replace('hidden', 'flex');
                document.getElementById('input_driver_motor').required = false;
                document.getElementById('input_driver_mobil').required = true;
            }
        };

        // SUBMIT TUGAS BARU
        // SUBMIT TUGAS BARU ATAU UPDATE
        document.getElementById('formPenjemputan')?.addEventListener('submit', async function(e) {
            e.preventDefault();
                
            if(!isAllowed()) return alert('Akses Ditolak!');
            
            const btn = document.getElementById('btnSubmitPenjemputan');
            btn.innerHTML = 'Menyimpan...'; btn.disabled = true;

            try {
                const editId = document.getElementById('edit_penjemputan_id').value;
                const tipeKendaraan = document.getElementById('tipe_kendaraan_input').value;
                const mitra_id = document.getElementById('input_mitra').value;
                const tanggal = document.getElementById('input_tanggal').value;
                const dpValue = document.getElementById('input_dp').value;
                const wilayah = document.getElementById('input-wilayah').value;
                
                let driver_id = null; let helper_id = null;
                if (tipeKendaraan === 'motor') {
                    driver_id = document.getElementById('input_driver_motor').value;
                } else {
                    driver_id = document.getElementById('input_driver_mobil').value;
                    const helper = document.getElementById('input_helper_mobil').value;
                    if(helper) helper_id = helper;
                }

                if (!window.supabase) throw new Error("Supabase Client tidak ditemukan!");

                // Tarik Rincian Komoditas dari Input HTML
                const inputEstimasi = [
                    { id: 'est-minyak', komoditas: 'Minyak Jelantah Kotor' },
                    { id: 'est-tepung', komoditas: 'Tepung' },
                    { id: 'est-kriuk', komoditas: 'Kriuk' },
                    { id: 'est-spinner', komoditas: 'Spinner' },
                    { id: 'est-ampas', komoditas: 'Ampas' }
                ];
                const itemsToInsertRaw = [];
                inputEstimasi.forEach(item => {
                    const parsedVol = parseFloat(document.getElementById(item.id).value) || 0;
                    if (parsedVol > 0) itemsToInsertRaw.push({ komoditas: item.komoditas, volume: parsedVol });
                });

                // ==========================
                // JALUR A: UPDATE JADWAL (EDIT)
                // ==========================
                if (editId) {
                    // Update Penjemputan
                    const { error: errUpdate } = await window.supabase.from('penjemputan').update({
                        mitra_id: parseInt(mitra_id), driver_id: driver_id, helper_id: helper_id || null,
                        tanggal: tanggal, kendaraan: tipeKendaraan, rute_penjemputan: wilayah
                    }).eq('id', editId);
                    if (errUpdate) throw errUpdate;

                    const p = window.allJadwalPending.find(x => x.id == editId);
                    let txId = p?.transaksi?.[0]?.id;

                    if (txId) {
                        // Update Transaksi Induk & Bersihkan Item Lama
                        await window.supabase.from('transaksi').update({ kalkulator_user_id: driver_id, potongan_dp: dpValue ? parseFloat(dpValue) : 0 }).eq('id', txId);
                        await window.supabase.from('transaksi_item').delete().eq('transaksi_id', txId);
                    } else {
                        // Buat Transaksi Baru Kalau Entah Kenapa Datanya Bolong
                        const {data: newTx} = await window.supabase.from('transaksi').insert([{
                            penjemputan_id: editId, kalkulator_user_id: driver_id, potongan_dp: dpValue ? parseFloat(dpValue) : 0, subtotal: 0, grand_total: 0
                        }]).select().single();
                        txId = newTx.id;
                    }

                    // Suntik Item Baru
                    if(itemsToInsertRaw.length > 0) {
                        const items = itemsToInsertRaw.map(i => ({ transaksi_id: txId, komoditas: i.komoditas, volume: i.volume }));
                        await window.supabase.from('transaksi_item').insert(items);
                    }
                    
                    alert('Jadwal berhasil diperbarui!');

                // ==========================
                // JALUR B: INSERT JADWAL BARU
                // ==========================
                } else {
                    const { data: pickupData, error: errPickup } = await window.supabase.from('penjemputan').insert([{
                        mitra_id: parseInt(mitra_id), driver_id: driver_id, helper_id: helper_id || null,
                        tanggal: tanggal, kendaraan: tipeKendaraan, rute_penjemputan: wilayah, status: 'Belum'
                    }]).select().single();
                    if (errPickup) throw errPickup;

                    const { data: txData, error: errTx } = await window.supabase.from('transaksi').insert([{
                        penjemputan_id: pickupData.id, kalkulator_user_id: driver_id, potongan_dp: dpValue ? parseFloat(dpValue) : 0, subtotal: 0, grand_total: 0
                    }]).select().single();
                    if (errTx) throw errTx;

                    if(itemsToInsertRaw.length > 0) {
                        const items = itemsToInsertRaw.map(i => ({ transaksi_id: txData.id, komoditas: i.komoditas, volume: i.volume }));
                        await window.supabase.from('transaksi_item').insert(items);
                    }
                    alert('Tugas penjemputan baru berhasil diterbitkan!');
                }

                window.location.reload();
            } catch (error) {
                alert('Gagal memproses penugasan: ' + error.message);
                btn.innerHTML = 'Kirim Perintah Jalan'; btn.disabled = false;
            }
        });
    });
    function nextStep() {
    // Validasi singkat sebelum ke step 2 (opsional, biar rapi)
    const mitra = document.getElementById('input_mitra').value;
    const tanggal = document.getElementById('input_tanggal').value;
    const wilayah = document.getElementById('input-wilayah').value;

    if(!mitra || !tanggal || !wilayah) {
        alert("Harap lengkapi Lokasi Mitra, Tanggal, dan Wilayah terlebih dahulu!");
        return;
    }

    // Sembunyikan Step 1 & Footernya
    document.getElementById('form-step-1').classList.replace('flex', 'hidden');
    document.getElementById('footer-step-1').classList.replace('flex', 'hidden');
    
    // Munculkan Step 2 & Footernya
    document.getElementById('form-step-2').classList.replace('hidden', 'flex');
    document.getElementById('footer-step-2').classList.replace('hidden', 'flex');
}

function prevStep() {
    // Sembunyikan Step 2 & Footernya
    document.getElementById('form-step-2').classList.replace('flex', 'hidden');
    document.getElementById('footer-step-2').classList.replace('flex', 'hidden');
    
    // Munculkan Step 1 & Footernya
    document.getElementById('form-step-1').classList.replace('hidden', 'flex');
    document.getElementById('footer-step-1').classList.replace('hidden', 'flex');
}
    </script>
</Layout>