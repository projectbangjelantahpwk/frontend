---
import GeneralLayout from '../layouts/Layout.astro';
import 'bootstrap-icons/font/bootstrap-icons.css';
---

<GeneralLayout title="Pusat Informasi - Bang Jelantah">
    <style is:global>
        /* Mengunci layar menjadi blank (putih) sampai skrip memberi izin masuk */
        body { display: none; }
    </style>

    <div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Pusat Informasi & Pengumuman</h1>
            <p class="text-gray-600">Kelola papan pengumuman yang akan tampil di dashboard karyawan.</p>
        </div>
        
        <div class="flex justify-end w-full md:w-auto md:ml-auto">
            <button onclick="window.bukaModalTambah()" class="bg-green-700 text-white px-5 py-2.5 rounded-xl text-sm font-bold hover:bg-green-800 transition shadow-sm flex items-center gap-2 w-full md:w-auto justify-center">
                <i class="bi bi-plus-circle-fill"></i> Buat Pengumuman Baru
            </button>
        </div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm">
        <div class="overflow-x-auto max-h-[600px]">
            <table class="w-full text-left" id="tabel-pengumuman">
                <thead class="bg-gray-50 sticky top-0">
                    <tr>
                        <th class="px-6 py-4 text-sm font-bold text-gray-900 w-24 text-center">Urutan</th>
                        <th class="px-6 py-4 text-sm font-bold text-gray-900">Isi Pengumuman</th>
                        <th class="px-6 py-4 text-sm font-bold text-gray-900 text-center w-32">Status</th>
                        <th class="px-6 py-4 text-sm font-bold text-gray-900 text-center w-40">Aksi</th>
                    </tr>
                </thead>
                <tbody id="pengumuman-tbody" class="divide-y divide-gray-200">
                    <tr><td colspan="4" class="text-center py-6 text-gray-500 font-medium">Memuat data pengumuman...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</GeneralLayout>

<div id="modal-pengumuman" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0">
    <div class="bg-white rounded-2xl w-full max-w-lg overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh]">
        <div class="p-5 border-b border-gray-100 flex justify-between items-center bg-blue-50 shrink-0">
            <div>
                <h3 id="modal-title" class="font-bold text-lg text-gray-900">Buat Pengumuman</h3>
                <p class="text-xs text-blue-700 font-medium">Pesan akan langsung terlihat oleh karyawan jika aktif</p>
            </div>
            <button type="button" onclick="window.tutupModal()" class="text-gray-400 hover:text-gray-900"><i class="bi bi-x-lg"></i></button>
        </div>
        
        <form id="form-pengumuman" onsubmit="window.simpanPengumuman(event)" class="p-6 overflow-y-auto flex-1 space-y-5">
            <input type="hidden" id="form_id">
            
            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Isi Pesan / Catatan <span class="text-red-500">*</span></label>
                
                <textarea id="form_isi" rows="3" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-blue-600 font-medium bg-gray-50 focus:bg-white transition" placeholder="Ketik pengumuman di sini..." required oninput="window.kalkulasiLayarHP(this)"></textarea>
                
                <div class="flex justify-between items-start mt-1.5 px-1">
                    <p id="indikator-hp" class="text-[10px] font-bold text-gray-400"><i class="bi bi-phone"></i> Tampilan HP: Kosong</p>
                    <p id="counter-huruf" class="text-[10px] text-gray-500 font-mono font-bold">0 / 105 Huruf</p>
                </div>
                <p id="warning-hp" class="text-[9.5px] text-orange-600 mt-1 hidden italic leading-tight">
                    *Teks melebihi 3 baris HP! Aplikasi Android akan otomatis memecahnya menjadi beberapa slide agar tetap muat di layar.
                </p>
            </div>
            
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Urutan Tampil</label>
                    <input type="number" id="form_urutan" value="1" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-blue-600 font-mono font-bold text-blue-800 bg-gray-50 focus:bg-white transition" required>
                    <p class="text-[10px] text-gray-500 mt-1 italic">Angka terkecil tampil paling atas</p>
                </div>
                
                <div class="flex flex-col justify-center">
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Status Visibilitas</label>
                    <label class="flex items-center gap-2 cursor-pointer mt-1">
                        <input type="checkbox" id="form_aktif" checked class="w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-600" />
                        <span class="text-sm font-bold text-gray-800">Aktif & Tampilkan</span>
                    </label>
                </div>
            </div>

            <button type="submit" id="btn-submit" class="w-full bg-blue-700 text-white font-bold py-3.5 rounded-xl hover:bg-blue-800 transition shadow-sm mt-4">
                SIMPAN PENGUMUMAN
            </button>
        </form>
    </div>
</div>

<script is:inline>
document.addEventListener('DOMContentLoaded', async () => {
    // === 🛡️ GATEKEEPER MANAJEMEN ===
    const allowedRoles = ['owner', 'admin', 'hrd', 'it'];
    const client = window.supabase;
    
    const { data: { session } } = await client.auth.getSession();
    if (!session) return window.location.replace('/'); 
    
    const { data: prof } = await client.from('profiles').select('role').eq('id', session.user.id).single();

    if (!allowedRoles.includes(prof?.role)) {
        alert(`Akses Ditolak! Role Anda (${prof?.role || 'Guest'}) tidak diizinkan mengelola Pusat Informasi.`);
        return window.location.replace('/');
    }
    
    // Tampilkan halaman jika lolos pengecekan
    document.body.style.display = 'block'; 

    // ==========================================
    // 1. FETCH DATA PENGUMUMAN
    // ==========================================
    async function loadData() {
        try {
            const { data, error } = await window.supabase
                .from('pusat_informasi')
                .select('*')
                .order('urutan', { ascending: true })
                .order('created_at', { ascending: false });

            if (error) throw error;

            const tbody = document.getElementById('pengumuman-tbody');
            let html = '';

            if (!data || data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center py-8 text-gray-400 font-medium italic">Belum ada data pengumuman.</td></tr>';
                return;
            }

            data.forEach(item => {
                const tglFormat = new Date(item.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                
                // Format teks agar line-break (\n) menjadi <br> di HTML
                const pesanHtml = item.isi_pesan.replace(/\n/g, '<br>');

                const statusBadge = item.is_active 
                    ? `<span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-bold border border-green-200"><i class="bi bi-eye-fill mr-1"></i> Aktif</span>`
                    : `<span class="bg-gray-100 text-gray-600 px-3 py-1 rounded-full text-xs font-bold border border-gray-300"><i class="bi bi-eye-slash-fill mr-1"></i> Disembunyikan</span>`;

                html += `
                <tr class="hover:bg-blue-50/50 transition-colors border-b border-gray-100">
                    <td class="px-6 py-4 align-top text-center">
                        <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-blue-100 text-blue-700 font-black text-sm border border-blue-200">
                            ${item.urutan || 0}
                        </span>
                    </td>
                    <td class="px-6 py-4 align-top">
                        <div class="text-sm text-gray-800 font-medium mb-2">${pesanHtml}</div>
                        <div class="text-[10px] text-gray-400 font-mono"><i class="bi bi-clock-history"></i> ${tglFormat}</div>
                    </td>
                    <td class="px-6 py-4 align-top text-center whitespace-nowrap">
                        ${statusBadge}
                    </td>
                    <td class="px-6 py-4 align-top text-center whitespace-nowrap">
                        <div class="flex items-center justify-center gap-2">
                            <button onclick="window.bukaModalEdit('${item.id}')" class="bg-blue-50 text-blue-700 px-3 py-1.5 rounded-lg text-xs font-bold border border-blue-200 hover:bg-blue-100 transition">
                                <i class="bi bi-pencil-square"></i> Edit
                            </button>
                            <button onclick="window.hapusPengumuman('${item.id}')" class="bg-red-50 text-red-600 px-3 py-1.5 rounded-lg text-xs font-bold border border-red-200 hover:bg-red-100 transition">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>`;
            });

            tbody.innerHTML = html;
        } catch (error) {
            console.error("Gagal load data:", error);
            alert("Gagal mengambil data pengumuman.");
        }
    }

    // Panggil fungsi load pertama kali
    await loadData();

    // ==========================================
    // 2. KONTROL MODAL
    // ==========================================
    const modal = document.getElementById('modal-pengumuman');
    
    window.tutupModal = function() {
        modal.classList.add('opacity-0');
        modal.querySelector('div').classList.add('scale-95');
        setTimeout(() => { modal.classList.add('hidden'); modal.classList.remove('flex'); }, 300);
    }

    function bukaModalAnimasi() {
        modal.classList.remove('hidden'); 
        modal.classList.add('flex');
        setTimeout(() => { modal.classList.remove('opacity-0'); modal.querySelector('div').classList.remove('scale-95'); }, 10);
    }

    window.bukaModalTambah = function() {
        document.getElementById('form_id').value = '';
        document.getElementById('form_isi').value = '';
        document.getElementById('form_urutan').value = '1';
        document.getElementById('form_aktif').checked = true;
        document.getElementById('modal-title').innerText = 'Buat Pengumuman Baru';
        document.getElementById('btn-submit').innerText = 'SIMPAN PENGUMUMAN';
        window.kalkulasiLayarHP(document.getElementById('form_isi'));
        bukaModalAnimasi();
    }

    window.bukaModalEdit = async function(id) {
        try {
            const { data, error } = await window.supabase.from('pusat_informasi').select('*').eq('id', id).single();
            if (error) throw error;

            document.getElementById('form_id').value = data.id;
            document.getElementById('form_isi').value = data.isi_pesan;
            document.getElementById('form_urutan').value = data.urutan;
            document.getElementById('form_aktif').checked = data.is_active;
            window.kalkulasiLayarHP(document.getElementById('form_isi'));
            document.getElementById('modal-title').innerText = 'Edit Pengumuman';
            document.getElementById('btn-submit').innerText = 'PERBARUI DATA';
            
            bukaModalAnimasi();
        } catch (error) {
            alert("Gagal memuat data untuk di-edit.");
        }
    }

    // ==========================================
    // 3. SIMPAN & HAPUS DATA
    // ==========================================
    window.simpanPengumuman = async function(e) {
        e.preventDefault();
        
        const btn = document.getElementById('btn-submit');
        btn.innerText = "Memproses...";
        btn.disabled = true;

        const id = document.getElementById('form_id').value;
        const isi = document.getElementById('form_isi').value.trim();
        const urutan = parseInt(document.getElementById('form_urutan').value) || 0;
        const is_active = document.getElementById('form_aktif').checked;

        try {
            const payload = {
                isi_pesan: isi,
                urutan: urutan,
                is_active: is_active
            };

            if (id) {
                // UPDATE DATA
                const { error } = await window.supabase.from('pusat_informasi').update(payload).eq('id', id);
                if (error) throw error;
                alert("Pengumuman berhasil diperbarui!");
            } else {
                // INSERT DATA BARU
                const { error } = await window.supabase.from('pusat_informasi').insert([payload]);
                if (error) throw error;
                alert("Pengumuman baru berhasil ditambahkan!");
            }

            window.tutupModal();
            loadData(); // Refresh tabel

        } catch (error) {
            alert("Terjadi kesalahan: " + error.message);
        } finally {
            btn.disabled = false;
        }
    }

    window.hapusPengumuman = async function(id) {
        if (!confirm("Yakin ingin menghapus pengumuman ini secara permanen?")) return;

        try {
            const { error } = await window.supabase.from('pusat_informasi').delete().eq('id', id);
            if (error) throw error;
            
            alert("Data berhasil dihapus.");
            loadData();
        } catch (error) {
            alert("Gagal menghapus data: " + error.message);
        }
    }
    // ==========================================
    // 4. RULE KALKULASI LAYAR ANDROID (3 BARIS)
    // ==========================================
    window.kalkulasiLayarHP = function(el) {
        const jmlHuruf = el.value.length;
        const counter = document.getElementById('counter-huruf');
        const indikator = document.getElementById('indikator-hp');
        const warning = document.getElementById('warning-hp');
        
        counter.innerText = `${jmlHuruf} Huruf`;
        
        // Asumsi: 1 Baris Android = ~35 huruf. Maksimal 3 baris = 105 huruf.
        const maxHurufSatuSlide = 105; 

        if (jmlHuruf === 0) {
            indikator.innerHTML = `<i class="bi bi-phone"></i> Tampilan HP: Kosong`;
            indikator.className = "text-[10px] font-bold text-gray-400";
            warning.classList.add('hidden');
            counter.classList.replace('text-red-600', 'text-gray-500');
        } else if (jmlHuruf <= maxHurufSatuSlide) {
            indikator.innerHTML = `<i class="bi bi-phone"></i> Tampilan HP: Pas 1 Slide ✓`;
            indikator.className = "text-[10px] font-bold text-green-600";
            warning.classList.add('hidden');
            counter.classList.replace('text-red-600', 'text-gray-500');
        } else {
            const jmlSlide = Math.ceil(jmlHuruf / maxHurufSatuSlide);
            indikator.innerHTML = `<i class="bi bi-phone"></i> Tampilan HP: Terpecah ${jmlSlide} Slide ⚠️`;
            indikator.className = "text-[10px] font-bold text-orange-600";
            warning.classList.remove('hidden');
            counter.classList.replace('text-gray-500', 'text-red-600');
        }
    };
});
</script>