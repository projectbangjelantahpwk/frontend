          return;
        }
        let html = "";
        data.forEach((item) => {
          html += `
          <tr class="border-b border-gray-200 hover:bg-gray-50 transition">
            <td class="px-4 py-3 font-medium text-gray-900">${item.tanggal}</td>
            <td class="px-4 py-3 text-gray-700">${item.sumber || "-"}</td>
