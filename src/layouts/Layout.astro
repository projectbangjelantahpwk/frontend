        // ==========================================
// 🔔 LOGIKA TAMPILAN (UI) NOTIFIKASI
// ==========================================
function initNotifUI() {
    const notifBadge = document.getElementById('notif-badge');
    const notifBtn = document.getElementById('notif-btn');
    const notifDropdown = document.getElementById('notif-dropdown');
    const notifList = document.getElementById('notif-list');
    const clearNotif = document.getElementById('clear-notif');

    // Toggle Buka/Tutup Dropdown
    notifBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        notifBadge?.classList.add('hidden');
        notifDropdown?.classList.toggle('hidden');
    });

    // Tutup jika klik di luar kotak
    window.addEventListener('click', (e) => {
        if (!notifBtn?.contains(e.target) && !notifDropdown?.contains(e.target)) {
            notifDropdown?.classList.add('hidden');
        }
    });

    // Tombol bersihkan notifikasi
    clearNotif?.addEventListener('click', () => {
        if(notifList) {
            notifList.innerHTML = '<p id="empty-notif" class="text-xs text-on-surface-variant text-center py-4">Belum ada notifikasi baru.</p>';
        }
    });
}

// Fungsi global agar bisa dipanggil oleh FCM saat pesan masuk
window.addNotifToList = function(title, body) {
    const notifList = document.getElementById('notif-list');
    const emptyMsg = document.getElementById('empty-notif');
    if (emptyMsg) emptyMsg.remove();

    const waktu = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
    const notifItem = document.createElement('div');
    notifItem.className = 'p-3 bg-surface-container-low hover:bg-surface-container rounded-lg cursor-pointer transition-colors border-l-4 border-primary mb-1';
    notifItem.innerHTML = `
        <p class="font-bold text-sm text-on-surface">${title}</p>
        <p class="text-xs text-on-surface-variant mt-1">${body}</p>
        <p class="text-[10px] text-outline mt-2 text-right">${waktu}</p>
    `;
    notifList?.prepend(notifItem);
}

        function initSidebar() {
            const hamburgerBtn = document.getElementById('hamburger-btn');
            const sidebar = document.getElementById('sidebar');
            const closeBtn = document.getElementById('close-sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            const navLinks = document.querySelectorAll('[data-nav]');
            const currentPath = window.location.pathname;

            function openSidebar() {
                if (!sidebar || !overlay) return;
                sidebar.classList.add('active');
                overlay.classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            function closeSidebar() {
                if (!sidebar || !overlay) return;
                sidebar.classList.remove('active');
                overlay.classList.remove('active');
                document.body.style.overflow = '';
            }

            // @ts-ignore
            window.closeAppSidebar = closeSidebar;

            hamburgerBtn?.addEventListener('click', openSidebar);
            closeBtn?.addEventListener('click', closeSidebar);
            overlay?.addEventListener('click', closeSidebar);

            navLinks.forEach((link) => {
                link.classList.remove('bg-primary-container', 'text-on-primary-container', 'font-bold');
                link.classList.add('text-on-surface-variant', 'hover:bg-surface-container-low');
                
                const href = link.getAttribute('href');
                const isActive =
                    (currentPath === '/' && href === '/') ||
                    (currentPath !== '/' && currentPath === href);

                if (isActive) {
                    link.classList.remove('text-on-surface-variant', 'hover:bg-surface-container-low');
                    link.classList.add('bg-primary-container', 'text-on-primary-container', 'font-bold');
                }
            });
        }

        async function renderAuthUI(session) {
            const loggedOutView = document.getElementById('auth-logged-out');
            const loggedInView = document.getElementById('auth-logged-in');
            const sidebarFooter = document.getElementById('sidebar-footer');
            const hamburgerBtn = document.getElementById('hamburger-btn');
            const avatarImg = document.getElementById('user-avatar');

            if (session) {
                loggedOutView?.classList.add('hidden');
                loggedOutView?.classList.remove('flex');

                loggedInView?.classList.remove('hidden');
                loggedInView?.classList.add('flex');

                hamburgerBtn?.classList.remove('hidden');
                hamburgerBtn?.classList.add('flex');

                sidebarFooter?.classList.remove('hidden');

                // LOGIKA CACHE HEMAT API (HANYA FETCH JIKA BELUM ADA)
                if (avatarImg) {
                    const cacheKey = `profile_${session.user.id}`;
                    const cachedString = localStorage.getItem(cacheKey);

                    // 1. TAMPILKAN CACHE DULU: Render instan tanpa nunggu loading database
                    if (cachedString) {
                        const profile = JSON.parse(cachedString);
                        updateAvatarElement(avatarImg, profile.nama, profile.foto_profil);
                    }

                    // 2. CEK UPDATE DIAM-DIAM: Tarik data terbaru dari Supabase di *background*
                    try {
                        const { data: profileData, error } = await supabase
                            .from('profiles')
                            .select('nama, foto_profil')
                            .eq('id', session.user.id)
                            .single();
                            
                        if (!error && profileData) {
                            // Cek apakah data dari database BERBEDA dengan memori lokal
                            const isDataChanged = !cachedString || 
                                JSON.parse(cachedString).foto_profil !== profileData.foto_profil ||
                                JSON.parse(cachedString).nama !== profileData.nama;

                            // 3. JIKA ADA FOTO/NAMA BARU: Timpa cache lama & ubah gambar di layar!
                            if (isDataChanged) {
                                localStorage.setItem(cacheKey, JSON.stringify(profileData));
                                updateAvatarElement(avatarImg, profileData.nama, profileData.foto_profil);
                            }
                        }
                    } catch (err) {
                        console.error("Gagal mengecek update profil:", err);
                    }
                }
                return;
            }

            // Kondisi saat User Logout (Hapus Cache)
            if (session === null) {
                // Cari key profile lokal lalu hapus saat logout
                const semuaKey = Object.keys(localStorage);
                semuaKey.forEach(key => {
                    if (key.startsWith('profile_')) localStorage.removeItem(key);
                });
            }

            loggedOutView?.classList.remove('hidden');
            loggedOutView?.classList.add('flex');

            loggedInView?.classList.add('hidden');
            loggedInView?.classList.remove('flex');

            hamburgerBtn?.classList.add('hidden');
            hamburgerBtn?.classList.remove('flex');

            sidebarFooter?.classList.add('hidden');
            // @ts-ignore
            window.closeAppSidebar?.();
        }

        // Helper fungsi pembantu untuk mengganti attribute src pada tag img
        function updateAvatarElement(element, nama, urlFoto) {
            if (urlFoto) {
                element.setAttribute('src', urlFoto);
            } else {
                const namaUser = nama || 'Karyawan';
                element.setAttribute('src', `https://ui-avatars.com/api/?name=${encodeURIComponent(namaUser)}&background=2e7d32&color=ffffff`);
            }
        }

        async function initAuthCheck() {
            const requireAuth = document.body.dataset.requireAuth === 'true';
            const currentPath = window.location.pathname;

            const { data, error } = await supabase.auth.getSession();
            const session = data?.session ?? null;

            if (error) {
                console.error('Gagal membaca session Supabase:', error.message);
            }

            // JIKA BELUM LOGIN: Layar tetap 'display: none', langsung tendang!
            if (requireAuth && !session && currentPath !== '/login') {
                window.location.replace('/login');
                return; // Proses berhenti di sini, jadi WebSocket nggak akan terpicu!
            }

            // 🔥 JIKA LOLOS AUTH: Buka gembok layarnya!
            if (requireAuth) {
                document.body.style.display = 'block';
            }

            renderAuthUI(session);

            // 🔥 JALANKAN WEBSOCKET HANYA JIKA USER SUDAH VALID LOGIN 🔥
            if (session) {
                console.log('🔌 Session valid, starting realtime...');
                setTimeout(() => {
                    if (window.supabase) {
                        initRealtimeNotifications();
                    }
                }, 1000);
            }
        }

        function initLogout() {
            const logoutButton = document.getElementById('btn-logout');

            logoutButton?.addEventListener('click', async () => {
                logoutButton.setAttribute('disabled', 'true');

                const { error } = await supabase.auth.signOut();

                if (error) {
                    console.error('Gagal logout:', error.message);
                    logoutButton.removeAttribute('disabled');
                    return;
                }
                window.location.replace('/login');
            });
        }

        runWhenReady(() => {
            initSidebar();
            initAuthCheck();
            initLogout();
            initNotifUI();
            //initRealtimeNotifications(); // Menjalankan Notifikasi Real-Time
        });
    </script>
    <!-- Script Integrasi FCM -->
    <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import { getMessaging, getToken, onMessage } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-messaging.js";

    const firebaseConfig = {
      apiKey: "AIzaSyBhSvulo8KRVoe7Fo09dL6t6aqmfSS1yRE",
      authDomain: "project-bang-jelantah.firebaseapp.com",
      projectId: "project-bang-jelantah",
      storageBucket: "project-bang-jelantah.firebasestorage.app",
      messagingSenderId: "422054168481",
      appId: "1:422054168481:web:9e8159f56b2de70778ade0"
    };

    const app = initializeApp(firebaseConfig);
    const messaging = getMessaging(app);

    // ==========================================
    // 1️⃣ MINTA IZIN & DAPATKAN FCM TOKEN
    // ==========================================
    async function requestFCMToken() {
        try {
            const permission = await Notification.requestPermission();
            if (permission === 'granted') {
                const currentToken = await getToken(messaging, { 
                    vapidKey: 'BIIKobK9kr74tDXdL7WeThrFqbh_aG7B-X_gMS-wOYToaVqI_uAJQQo5WUmVG8uL2OUN2NU6-qMojh_j7KF1xYQ' 
                });
                
                if (currentToken) {
                    console.log('✅ FCM Token berhasil didapat');
                    
                    // 🔥 SIMPAN TOKEN KE SUPABASE (JANGAN BOROS!)
                    // Hanya update jika token baru/berbeda
                    saveFCMTokenToDatabase(currentToken);
                }
            }
        } catch (error) {
            console.error('❌ Error FCM:', error);
        }
    }

    // Simpan token ke database (dengan check duplikasi)
    async function saveFCMTokenToDatabase(token) {
        try {
            const { data: sessionData } = await window.supabase.auth.getSession();
            if (!sessionData?.session?.user?.id) return;

            const userId = sessionData.session.user.id;

            // Cek token lama
            const { data: profile } = await window.supabase
                .from('profiles')
                .select('fcm_token')
                .eq('id', userId)
                .single();

            // Hanya update jika berbeda (HEMAT QUOTA!)
            if (profile?.fcm_token !== token) {
                await window.supabase
                    .from('profiles')
                    .update({ fcm_token: token })
                    .eq('id', userId);
                console.log('✅ Token FCM disimpan ke database');
            }
        } catch (error) {
            console.error('❌ Error save token:', error);
        }
    }

    // ==========================================
    // 2️⃣ TANGKAP NOTIF SAAT BROWSER TERBUKA
    // ==========================================
    onMessage(messaging, (payload) => {
        console.log('📬 Notifikasi diterima:', payload);
        
        const title = payload.notification?.title || 'Pemberitahuan';
        const body = payload.notification?.body || 'Anda memiliki pesan baru';
        const icon = payload.notification?.image || 'https://ui-avatars.com/api/?name=Bang+Jelantah&background=2e7d32&color=ffffff';

        // 🔊 MAINKAN SUARA
        playNotificationSound();

        // 👉 TAMBAHKAN BARIS INI: Masukkan ke kotak dropdown UI
        if(window.addNotifToList) window.addNotifToList(title, body);

        // 🔔 TAMPILKAN NOTIFIKASI BROWSER
        if ('Notification' in window && Notification.permission === 'granted') {
            new Notification(title, {
                body: body,
                icon: icon,
                tag: 'notification',
                badge: '/3.png'
            });
        }

        // 🎨 UPDATE UI (Nyalakan titik merah di lonceng)
        const notifBadge = document.getElementById('notif-badge');
        if(notifBadge) notifBadge.classList.remove('hidden');
    });

    // ==========================================
    // 3️⃣ FUNGSI MAINKAN SUARA NOTIFIKASI
    // ==========================================
    function playNotificationSound() {
        try {
            // Coba pakai audio file dulu
            const audio = new Audio('/sound/notification.mp3');
            audio.volume = 1.0;
            audio.play().catch(() => {
                // Fallback ke Web Audio jika file tidak ada
                playWebAudioBeep();
            });
        } catch (error) {
            playWebAudioBeep();
        }
    }

    // Web Audio API Beep sebagai fallback
    function playWebAudioBeep() {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            
            // Beep 1
            const osc1 = ctx.createOscillator();
            const gain1 = ctx.createGain();
            osc1.connect(gain1);
            gain1.connect(ctx.destination);
            osc1.frequency.value = 1000;
            osc1.type = 'square';
            gain1.gain.setValueAtTime(0.5, ctx.currentTime);
            gain1.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.2);
            osc1.start(ctx.currentTime);
            osc1.stop(ctx.currentTime + 0.2);

            // Beep 2 (delay)
            const osc2 = ctx.createOscillator();
            const gain2 = ctx.createGain();
            osc2.connect(gain2);
            gain2.connect(ctx.destination);
            osc2.frequency.value = 1200;
            osc2.type = 'square';
            gain2.gain.setValueAtTime(0.5, ctx.currentTime + 0.25);
            gain2.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.45);
            osc2.start(ctx.currentTime + 0.25);
            osc2.stop(ctx.currentTime + 0.45);
        } catch (error) {
            console.warn('Suara tidak bisa diputar:', error);
        }
    }

    // ==========================================
    // 4️⃣ REGISTER SERVICE WORKER
    // ==========================================
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/firebase-messaging-sw.js')
            .then((registration) => {
                console.log('✅ Service Worker registered');
            })
            .catch((err) => {
                console.error('❌ Service Worker error:', err);
            });
    }

    // ==========================================
    // 5️⃣ JALANKAN SAAT PAGE LOAD
    // ==========================================
    window.addEventListener('load', () => {
        // Check session dulu
        window.supabase?.auth.getSession().then(({ data: { session } }) => {
            if (session) {
                requestFCMToken();
            }
        });
    });
</script>
