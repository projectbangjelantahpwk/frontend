---
// src/components/dashboard/SumberTransaksiChart.astro
---

<div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline-variant shadow-md flex flex-col h-full hover:shadow-lg transition-shadow duration-300">
    
    <div class="mb-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h3 class="font-headline-md text-on-surface font-bold text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">
                Rincian Transaksi Harian
            </h3>
            <p class="text-label-sm text-on-surface-variant font-medium" id="teks-ringkasan">Bulan Ini</p>
        </div>
        
        <div class="flex flex-col sm:flex-row items-end sm:items-center gap-3 w-full sm:w-auto">
            <div class="text-right w-full sm:w-auto flex sm:block justify-between items-center bg-primary/5 sm:bg-transparent p-2 sm:p-0 rounded-lg">
                <span class="text-label-xs text-primary/80 uppercase tracking-wider block mb-0 sm:mb-1 font-bold">Total Rupiah</span>
                <span id="total-rp-sumber" class="text-title-md font-black text-primary">Rp 0</span>
            </div>
            
            <div class="bg-surface-variant/20 p-2 rounded-xl border border-surface-variant/50 focus-within:border-primary/50 focus-within:ring-2 focus-within:ring-primary/10 transition-all shadow-inner w-full sm:w-auto">
                <input type="month" id="month-sumber" class="w-full text-label-md bg-transparent border-none outline-none text-on-surface font-bold cursor-pointer focus:ring-0" />
            </div>
        </div>
    </div>

    <div class="w-full border border-gray-100 rounded-xl overflow-hidden mb-md flex-grow shadow-sm">
        <div class="max-h-[350px] overflow-y-auto hide-scrollbar bg-gray-50/30">
            <table class="w-full text-left border-collapse">
                <thead class="bg-surface-variant/40 text-[10px] uppercase text-on-surface-variant sticky top-0 font-bold tracking-wider z-10 backdrop-blur-sm">
                    <tr>
                        <th class="p-3 border-b whitespace-nowrap">Tanggal</th>
                        <th class="p-3 border-b text-right whitespace-nowrap">Volume (Kg)</th>
                        <th class="p-3 border-b text-right whitespace-nowrap hidden sm:table-cell">Harga/Kg</th>
                        <th class="p-3 border-b text-right whitespace-nowrap">Rupiah (Rp)</th>
                    </tr>
                </thead>
                <tbody id="tbody-harian" class="text-sm bg-white">
                    </tbody>
            </table>
        </div>
    </div>

    <div class="mt-auto border-t border-outline-variant/60 pt-md flex flex-col gap-5">
        
        <div class="flex flex-col gap-1.5">
            <span class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest text-center">Pilih Sumber</span>
            <div class="flex flex-wrap justify-center gap-2">
                <button data-sumber="Semua" class="btn-sumber px-4 py-1.5 rounded-full text-xs font-bold transition-all duration-300 bg-primary text-white shadow-sm scale-105">
                    Semua
                </button>
                <button data-sumber="Facebook" class="btn-sumber px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-[#1877F2]/20 hover:text-[#1877F2]">
                    Facebook
                </button>
                <button data-sumber="TikTok" class="btn-sumber px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-gray-200 hover:text-black">
                    TikTok
                </button>
                <button data-sumber="Lainnya" class="btn-sumber px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-purple-100 hover:text-purple-700">
                    Lainnya
                </button>
            </div>
        </div>

        <div class="flex flex-col gap-1.5">
            <span class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest text-center">Pilih Komoditas</span>
            <div class="flex flex-wrap justify-center gap-2">
                <button data-komoditas="Minyak Jelantah" class="btn-komoditas px-3 py-1.5 rounded-full text-[11px] font-bold transition-all duration-300 bg-surface-variant/80 text-on-surface shadow-sm scale-105">
                    Minyak Jelantah
                </button>
                <button data-komoditas="Ampas" class="btn-komoditas px-3 py-1.5 rounded-full text-[11px] font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface">
                    Ampas
                </button>
                <button data-komoditas="Keriuk" class="btn-komoditas px-3 py-1.5 rounded-full text-[11px] font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface">
                    Keriuk
                </button>
                <button data-komoditas="Tepung" class="btn-komoditas px-3 py-1.5 rounded-full text-[11px] font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface">
                    Tepung
                </button>
                <button data-komoditas="Spinner" class="btn-komoditas px-3 py-1.5 rounded-full text-[11px] font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface">
                    Spinner
                </button>
            </div>
        </div>

    </div>

</div>

<script>
    import { supabase } from '../../lib/supabase';
    
    const formatRp = (number) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(number || 0);
    const formatVol = (number) => new Intl.NumberFormat('id-ID', { maximumFractionDigits: 2 }).format(number || 0);

    async function initTabelBulanan() {
        let currentSumber = 'Semua';
        let currentCommodity = 'Minyak Jelantah';
        let dataGlobal = []; 

        const kolomDatabase = {
            'Minyak Jelantah': { rp: 'minyak_jelantah_rp', vol: 'minyak_jelantah_vol' },
            'Ampas': { rp: 'ampas_rp', vol: 'ampas_vol' },
            'Keriuk': { rp: 'kriuk_rp', vol: 'kriuk_vol' }, // Sesuai ejaan SQL kriuk
            'Tepung': { rp: 'tepung_rp', vol: 'tepung_vol' },
            'Spinner': { rp: 'spinner_rp', vol: 'spinner_vol' }
        };

        const monthInput = document.getElementById('month-sumber');
        const btnsSumber = document.querySelectorAll('.btn-sumber');
        const btnsKomoditas = document.querySelectorAll('.btn-komoditas');
        const tbody = document.getElementById('tbody-harian');
        const elTotalRp = document.getElementById('total-rp-sumber');
        const teksRingkasan = document.getElementById('teks-ringkasan');

        // Set default bulan ke saat ini
        const now = new Date();
        const mm = String(now.getMonth() + 1).padStart(2, '0');
        const yyyy = now.getFullYear();
        monthInput.value = `${yyyy}-${mm}`;

        async function fetchDataSebulan() {
            const val = monthInput.value;
            if(!val) return;

            const [y, m] = val.split('-');
            const lastDay = new Date(y, m, 0).getDate(); // Cari tau bulan ini 30 atau 31 hari
            const startDate = `${y}-${m}-01`;
            const endDate = `${y}-${m}-${lastDay}`;

            const kolomAktif = kolomDatabase[currentCommodity];
            
            // Tarik seluruh data di bulan tersebut
            const { data, error } = await supabase.from('sumber_transaksi_harian')
                .select(`tanggal, sumber, ${kolomAktif.rp}, ${kolomAktif.vol}`)
                .gte('tanggal', startDate)
                .lte('tanggal', endDate);
                
            if (!error && data) {
                dataGlobal = data;
                renderTabel(lastDay, y, m);
            }
        }

        function renderTabel(lastDay, year, month) {
            tbody.innerHTML = '';
            const kolomAktif = kolomDatabase[currentCommodity];
            let grandTotalRp = 0;
            let grandTotalVol = 0;

            // Wadah untuk nampung hitungan per tanggal (1 sampai 31)
            let rekapHarian = Array.from({ length: lastDay }, () => ({ rp: 0, vol: 0 }));

            // Kelompokkan data dari database ke array rekapHarian
            dataGlobal.forEach(item => {
                // Filter Sumber
                const isMatchSumber = currentSumber === 'Semua' || 
                                      (currentSumber === 'Lainnya' ? (item.sumber !== 'Facebook' && item.sumber !== 'TikTok') : item.sumber === currentSumber);
                
                if (isMatchSumber) {
                    const rp = Number(item[kolomAktif.rp] || 0);
                    const vol = Number(item[kolomAktif.vol] || 0);
                    const dayIdx = parseInt(item.tanggal.split('-')[2]) - 1; // Index 0 untuk Tgl 1

                    rekapHarian[dayIdx].rp += rp;
                    rekapHarian[dayIdx].vol += vol;
                    grandTotalRp += rp;
                    grandTotalVol += vol;
                }
            });

            // Cetak Baris HTML dari tanggal 1 sampai akhir bulan
            for (let i = 0; i < lastDay; i++) {
                const tglNum = i + 1;
                const dataHariIni = rekapHarian[i];
                const hrg = dataHariIni.vol > 0 ? (dataHariIni.rp / dataHariIni.vol) : 0;
                
                // Highlight baris jika ada transaksi
                const bgClass = dataHariIni.vol > 0 ? 'bg-green-50/50' : '';
                const textClass = dataHariIni.vol > 0 ? 'text-gray-900 font-bold' : 'text-gray-400';

                tbody.innerHTML += `
                    <tr class="border-b border-gray-100 transition-colors hover:bg-surface-variant/20 ${bgClass}">
                        <td class="p-3 whitespace-nowrap">
                            <span class="inline-block w-6 text-center bg-gray-100 rounded text-xs font-bold mr-2">${tglNum}</span>
                        </td>
                        <td class="p-3 text-right font-medium ${textClass}">${formatVol(dataHariIni.vol)} <span class="text-[10px]">Kg</span></td>
                        <td class="p-3 text-right text-xs text-gray-500 hidden sm:table-cell">${formatRp(hrg)}</td>
                        <td class="p-3 text-right font-medium ${dataHariIni.rp > 0 ? 'text-primary font-bold' : 'text-gray-400'}">${formatRp(dataHariIni.rp)}</td>
                    </tr>
                `;
            }

            // Tembak Total Keseluruhan ke UI Atas
            elTotalRp.textContent = formatRp(grandTotalRp);
            teksRingkasan.innerHTML = `Total <b>${formatVol(grandTotalVol)} Kg</b> (${currentCommodity} - ${currentSumber})`;
        }

        // --- EVENT LISTENERS ---
        
        // 1. Ganti Bulan
        monthInput.addEventListener('change', fetchDataSebulan);

        // 2. Klik Filter Sumber (Facebook, TikTok, dll)
        btnsSumber.forEach(btn => {
            btn.addEventListener('click', (e) => {
                currentSumber = e.target.getAttribute('data-sumber');
                
                // Ubah Warna Tombol Sumber Aktif
                btnsSumber.forEach(b => {
                    b.className = "btn-sumber px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface";
                });
                
                // Custom warna aktif berdasarkan platform
                let activeColor = "bg-primary text-white"; // Semua
                if(currentSumber === 'Facebook') activeColor = "bg-[#1877F2] text-white";
                if(currentSumber === 'TikTok') activeColor = "bg-gray-900 text-white";
                if(currentSumber === 'Lainnya') activeColor = "bg-purple-600 text-white";
                
                e.target.className = `btn-sumber px-4 py-1.5 rounded-full text-xs font-bold transition-all duration-300 shadow-sm scale-105 ${activeColor}`;
                
                // Langsung render ulang tabel tanpa harus loading database lagi
                const val = monthInput.value;
                const [y, m] = val.split('-');
                renderTabel(new Date(y, m, 0).getDate(), y, m);
            });
        });

        // 3. Klik Filter Komoditas (Minyak, Ampas, dll)
        btnsKomoditas.forEach(btn => {
            btn.addEventListener('click', (e) => {
                currentCommodity = e.target.getAttribute('data-komoditas');
                
                btnsKomoditas.forEach(b => {
                    b.className = "btn-komoditas px-3 py-1.5 rounded-full text-[11px] font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface";
                });
                e.target.className = "btn-komoditas px-3 py-1.5 rounded-full text-[11px] font-bold transition-all duration-300 bg-surface-variant/80 text-on-surface shadow-sm scale-105";
                
                // Harus fetch ulang karena kolom yang ditarik beda
                fetchDataSebulan();
            });
        });

        // Tembak data pas pertama kali buka
        fetchDataSebulan();
    }

    document.addEventListener('DOMContentLoaded', initTabelBulanan);
</script>