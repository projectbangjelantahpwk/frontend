                dana_talang: parseFloat(row["Dana Talang"]) || 0,
                lain_lain: parseFloat(row["Lain-lain"]) || 0,
              };
            }
            return mappedRow;
          });

          // Tembak massal (Bulk Insert) ke Supabase
          const { error } = await window.supabase
            .from(tableName)
            .insert(payload);
          if (error) throw error;

          alert(`✅ ${payload.length} data berhasil di-import!`);
          tutupImport();

          // Refresh tabel sesuai yang aktif
          if (tableName === "mitra") loadMitra();
          else if (tableName === "pembelian_barang_harian") loadPembelian();
          else if (tableName === "penjualan_barang_harian") loadPenjualan();
          else if (tableName === "pengeluaran_harian") loadPengeluaran();
        } catch (err) {
          console.error(err);
          alert("❌ Gagal Import Database: " + err.message);
