    // ==========================================
    // EKSEKUSI SIMPAN DATA PERUBAHAN KE DB
    // ==========================================
    window.simpanEditTransaksi = async function(e) {
        e.preventDefault();
        if(!window.supabase) return;

        const btn = document.getElementById('btn-save-trx');
        btn.innerText = "Menyimpan..."; btn.disabled = true;

        const trxId = document.getElementById('edit_trx_id').value;
        const penjemputanId = document.getElementById('edit_penjemputan_id').value;

        // 🔥 LOGIKA BARU: Jika milih "0" (Timbang Mandiri), simpan sebagai null agar aman dari foreign key error
        const mitraIdRaw = document.getElementById('edit_trx_mitra_select').value;
        const mitraIdTerpilih = mitraIdRaw === "0" ? null : parseInt(mitraIdRaw);
        
        const tglBaru = document.getElementById('edit_trx_tgl').value;
        const dpBaru = parseFloat(document.getElementById('edit_trx_dp').value) || 0;
        const totalManual = parseFloat(document.getElementById('edit_trx_grand_total').value) || 0;
        
        const metode = document.getElementById('edit_metode_bayar').value;

        try {
            // 1. Update relasi Tanggal & Mitra Terpilih ke tabel Induk Penjemputan
            if(penjemputanId) {
                const { error: errPenjemputan } = await window.supabase.from('penjemputan')
                    .update({ 
                        tanggal: tglBaru,
                        mitra_id: mitraIdTerpilih // Otomatis ter-update jadi null jika mas bro milih Timbang Mandiri
                    })
                    .eq('id', penjemputanId);
                if(errPenjemputan) throw errPenjemputan;
            }

            // 2. Loop & Update Rincian Berat dan Harga Komoditas
            const itemRows = document.querySelectorAll('.edit-item-row');
            const updateItemPromises = [];
            
            itemRows.forEach(row => {
                const itemId = row.querySelector('.item_id').value;
                const komoditasNama = row.querySelector('.item_komoditas').value;
                const volBaru = parseFloat(row.querySelector('.item_volume').value) || 0;
                const hargaBaru = parseFloat(row.querySelector('.item_harga').value) || 0;

                if(itemId) {
                    const updateTask = window.supabase.from('transaksi_item')
                        .update({
                            komoditas: komoditasNama,
                            volume: volBaru,
                            harga_unit: hargaBaru
                        })
                        .eq('id', itemId);
                    updateItemPromises.push(updateTask);
                }
            });

            if(updateItemPromises.length > 0) {
                await Promise.all(updateItemPromises);
            }

            // 3. Update DP, Total Transaksi, & Berkas Bayar Form 3 ke tabel Transaksi
            if(trxId) {
                let payloadUpdate = {
                    potongan_dp: dpBaru,
                    grand_total: totalManual // Murni ambil hasil ketikan manual mas bro
                };

                // Sisipkan detail berdasarkan isi metode
                if(metode === 'Bank') {
                    payloadUpdate.nama_bank = document.getElementById('edit_bank_nama')?.value || '';
                    payloadUpdate.no_rek = document.getElementById('edit_bank_rek')?.value || '';
                    payloadUpdate.atas_nama = document.getElementById('edit_bank_an')?.value || '';
                } else if(metode === 'QRIS') {
                    payloadUpdate.photo_qris = document.getElementById('edit_qris_url')?.value || '';
                }

                const { error: errTrx } = await window.supabase.from('transaksi').update(payloadUpdate).eq('id', trxId);
                if(errTrx) throw errTrx;
            }

            alert('Mantap bro! Seluruh data mitra, rincian barang, totalan harga, dan berkas transfer berhasil di-update!');
            window.location.reload();

        } catch (err) {
            alert('Gagal menyimpan perubahan transaksi: ' + err.message);
            btn.innerText = "Simpan Perubahan"; btn.disabled = false;
        }
    };
</script>