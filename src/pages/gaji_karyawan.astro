      }

      const html = `
      <div class="flex justify-between border-b border-gray-100 pb-1 mb-1">
        <span class="text-gray-600">Gaji Pokok</span> 
        <span class="font-bold text-gray-900">Rp ${Number(slip.gaji_karyawan || 0).toLocaleString("id-ID")}</span>
      </div>
      ${Number(slip.uang_lembur || 0) > 0 ? `<div class="flex justify-between border-b border-gray-100 pb-1 mb-1"><span class="text-gray-600">Uang Lembur</span> <span class="font-bold text-gray-900">+Rp ${Number(slip.uang_lembur || 0).toLocaleString("id-ID")}</span></div>` : ""}
      ${Number(slip.uang_makan || 0) > 0 ? `<div class="flex justify-between border-b border-gray-100 pb-1 mb-1"><span class="text-gray-600">Uang Makan</span> <span class="font-bold text-gray-900">+Rp ${Number(slip.uang_makan || 0).toLocaleString("id-ID")}</span></div>` : ""}
      ${Number(slip.uang_makan_malam || 0) > 0 ? `<div class="flex justify-between border-b border-gray-100 pb-1 mb-1"><span class="text-gray-600">Makan Malam</span> <span class="font-bold text-gray-900">+Rp ${Number(slip.uang_makan_malam || 0).toLocaleString("id-ID")}</span></div>` : ""}
      ${totalBonus > 0 ? `<div class="flex justify-between border-b border-gray-100 pb-1 mb-1"><span class="text-green-700">Total Bonus</span> <span class="font-bold text-green-700">+Rp ${totalBonus.toLocaleString("id-ID")}</span></div>` : ""}
      ${Number(slip.kasbon || 0) > 0 ? `<div class="flex justify-between border-b border-gray-100 pb-1 mb-1"><span class="text-red-600 font-bold">Potongan Kasbon</span> <span class="font-bold text-red-600">-Rp ${Number(slip.kasbon || 0).toLocaleString("id-ID")}</span></div>` : ""}
      
      <!-- INJECT LAIN-LAIN DI SINI -->
      ${htmlLainLain}
    `;

      document.getElementById("prev_rincian_konten").innerHTML = html;
      document.getElementById("prev_grand_total").innerText =
        `Rp ${Number(slip.total_diterima || 0).toLocaleString("id-ID")}`;

      window.openModal("modal-preview-slip");
    };

    window.bukaKasirMassal = function () {
      const checkboxes = document.querySelectorAll(".batch-checkbox:checked");
      if (checkboxes.length === 0) return;

      let total = 0;
      window.batchSelectedIds = []; // Simpan ID slip untuk dieksekusi nanti

      checkboxes.forEach((cb) => {
        total += parseFloat(cb.getAttribute("data-total")) || 0;
        window.batchSelectedIds.push(cb.value);
      });

      // Gunakan ulang modal Kasir
      document.getElementById("kasir_owner").value = total;
      document.getElementById("kasir_keuangan").value = 0;
      document.getElementById("kasir_gudang").value = 0;
      window.kalkulasiKasir();

      // Hijack tombol eksekusi untuk mode massal
      const btn = document.getElementById("btn-eksekusi-bayar");
