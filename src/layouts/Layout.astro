        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getMessaging, getToken, onMessage } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-messaging.js";

        // ⚠️ GANTI DENGAN CONFIG DARI FIREBASE CONSOLE LU ⚠️
        const firebaseConfig = {
          apiKey: "AIzaSyBhSvulo8KRVoe7Fo09dL6t6aqmfSS1yRE",
          authDomain: "project-bang-jelantah.firebaseapp.com",
          projectId: "project-bang-jelantah",
          storageBucket: "project-bang-jelantah.firebasestorage.app",
          messagingSenderId: "422054168481",
          appId: "1:422054168481:web:9e8159f56b2de70778ade0"
        };

        const app = initializeApp(firebaseConfig);
        const messaging = getMessaging(app);

        // Minta Izin & Dapatkan Token
        async function requestFCMToken() {
            try {
                const permission = await Notification.requestPermission();
                if (permission === 'granted') {
                    // ⚠️ GANTI VAPID KEY DI BAWAH INI ⚠️
                    const currentToken = await getToken(messaging, { 
                        vapidKey: 'VAPID_KEY_LU_DARI_FIREBASE_CONSOLE' 
                    });
                    
                    if (currentToken) {
                        console.log('✅ FCM Token sukses didapatkan:', currentToken);
                        
                        /* 
                         * TODO MASA DEPAN: 
                         * Lu bisa kirim 'currentToken' ini ke Supabase table 'profiles', 
                         * biar server backend lu tau harus kirim notif ke token mana 
                         * saat ada transaksi atau pengajuan baru.
                         */
                    }
                }
            } catch (error) {
                console.error('❌ Gagal mendapatkan FCM token:', error);
            }
        }

        // Tangkap notifikasi dari Firebase saat user SEDANG ngebuka webnya (Foreground)
        onMessage(messaging, (payload) => {
            console.log("Notifikasi Foreground FCM masuk: ", payload);
            
            // Nyalakan titik merah di lonceng UI
            const notifBadge = document.getElementById('notif-badge');
            if(notifBadge) notifBadge.classList.remove('hidden');
        });

        // 1. Daftarkan Service Worker
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/firebase-messaging-sw.js')
            .then((registration) => console.log('✅ [Sistem] Service Worker terdaftar!'))
            .catch((err) => console.error('❌ [Sistem] Gagal daftar Service Worker:', err));
        }

        // 2. Klik lonceng dengan laporan lengkap
        document.getElementById('notif-btn')?.addEventListener('click', async () => {
            console.log('🔔 [Sistem] Lonceng diklik! Mengecek status izin saat ini:', Notification.permission);
            
            try {
                // Minta izin ke browser
                const permission = await Notification.requestPermission();
                console.log('🔔 [Sistem] Hasil permintaan izin:', permission);

                if (permission === 'granted') {
                    console.log('⏳ [Sistem] Izin diberikan, sedang menghubungi Firebase untuk ambil Token...');
                    
                    // ⚠️ PASTIKAN VAPID KEY LU UDAH BENAR DI SINI ⚠️
                    const currentToken = await getToken(messaging, { 
                        vapidKey: 'VAPID_KEY_LU_DARI_FIREBASE_CONSOLE' 
                    });
                    
                    if (currentToken) {
                        console.log('✅ [SUKSES] FCM Token didapatkan:', currentToken);
                        alert("Berhasil terhubung ke FCM! Cek console untuk lihat Token.");
                    } else {
                        console.log('❌ [GAGAL] Token tidak didapat. Periksa VAPID Key lu.');
                    }
                } else {
                    console.log('❌ [GAGAL] User menolak izin notifikasi.');
                }
            } catch (err) {
                console.error('❌ [ERROR] Terjadi masalah fatal saat request token:', err);
            }
        });
    </script>
