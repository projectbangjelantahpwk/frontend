        document.getElementById('setup_gaji_menit').value = setup.gaji_menit || 0;
        document.getElementById('setup_lembur_menit').value = setup.uang_lembur_menit || 0;
        document.getElementById('setup_uang_kesehatan').value = setup.uang_kesehatan || 0;
        document.getElementById('setup_uang_makan').value = setup.uang_makan || 0;
        document.getElementById('setup_bonus_tepat').value = setup.bonus_tepat_waktu || 0;
        document.getElementById('setup_bonus_mingguan').value = setup.bonus_mingguan || 0;

        // Checkbox yang murni dari Database Setup
        document.getElementById('chk_uang_kesehatan').checked = setup.activate_uang_kesehatan || false;
        document.getElementById('chk_bonus_mingguan').checked = setup.activate_bonus_mingguan || false;

        const tglHariIni = new Date().toISOString().split('T')[0]; 
        const slip = (emp.slip_gaji || []).find(s => s.periode === tglHariIni && s.status === 'Menunggu');
        document.getElementById('m_slip_id').value = slip ? slip.id : '';

        // --- MENGHITUNG WAKTU KERJA PER MENIT ---
        let totalNormalMenit = 0;
        let totalLemburMenit = 0;
        let tepatWaktuCount = 0;

        const parseJamMenit = (timeStr) => {
            if(!timeStr) return null;
            const [h, m] = timeStr.split(':');
            return (parseInt(h) * 60) + parseInt(m);
        };

        const presensiHariIni = (emp.presensi || []).filter(p => p.tanggal === tglHariIni);
        let hariMasuk = presensiHariIni.length > 0 ? 1 : 0; 

        presensiHariIni.forEach(p => {
            // 🔥 LOGIKA TEPAT WAKTU DIAMBIL DARI ABSENSI 🔥
            if (p.status_tiba === 'Tepat Waktu') tepatWaktuCount++;
            
            let masukMenit = parseJamMenit(p.waktu_masuk) || (8*60);  
            let pulangMenit = parseJamMenit(p.waktu_pulang) || (17*60); 
            let batasPulangNormalMenit = 17 * 60; 

            let actualPulangNormal = Math.min(pulangMenit, batasPulangNormalMenit);
            let kerjaNormal = Math.max(0, actualPulangNormal - masukMenit);
            totalNormalMenit += kerjaNormal;

            if (pulangMenit > batasPulangNormalMenit) {
                totalLemburMenit += (pulangMenit - batasPulangNormalMenit);
            }
        });

        // 🔥 OTOMATISASI CHECKBOX BONUS TEPAT WAKTU DI UI 🔥
        const chkBonusTepat = document.getElementById('chk_bonus_tepat');
        chkBonusTepat.checked = tepatWaktuCount > 0;
        chkBonusTepat.disabled = true; // Kunci biar gak bisa dimanipulasi manual

        window.currentSalaryData = {
            empId: emp.id,
            totalNormalMenit,
            totalLemburMenit,
            tepatWaktuCount,
            hariMasuk,
            tglHariIni
        };

        kalkulasiRealtimeGaji();
        window.openModal('modal-detail-gaji');
    };

    // FUNGSI KALKULASI REAL-TIME
    // FUNGSI KALKULASI REAL-TIME
    window.kalkulasiRealtimeGaji = function() {
        const d = window.currentSalaryData;
        if(!d) return;

        const tarifMenit = parseFloat(document.getElementById('setup_gaji_menit').value) || 0;
        const tarifLemburMenit = parseFloat(document.getElementById('setup_lembur_menit').value) || 0;
        const valUangMakan = parseFloat(document.getElementById('setup_uang_makan').value) || 0;
        
        const isKesehatan = document.getElementById('chk_uang_kesehatan').checked;
        const isBonusMingguan = document.getElementById('chk_bonus_mingguan').checked;

        // Perhitungan Matematika
        const valGaji = d.totalNormalMenit * tarifMenit;
        const valLembur = d.totalLemburMenit * tarifLemburMenit;
        
        const valKesehatan = isKesehatan ? (parseFloat(document.getElementById('setup_uang_kesehatan').value) || 0) : 0;
        const valBonusMingguan = isBonusMingguan ? (parseFloat(document.getElementById('setup_bonus_mingguan').value) || 0) : 0;
        
        // 🔥 BONUS TEPAT WAKTU OTOMATIS DIKALIKAN JIKA DIA TEPAT WAKTU 🔥
        const valBonusTepat = d.tepatWaktuCount * (parseFloat(document.getElementById('setup_bonus_tepat').value) || 0);

        const grandTotal = valGaji + valLembur + valUangMakan + valKesehatan + valBonusTepat + valBonusMingguan;
        
        d.finalState = { valGaji, valLembur, valUangMakan, valKesehatan, valBonusTepat, valBonusMingguan, grandTotal };

        document.getElementById('m_rincian_list').innerHTML = `
            <div class="flex justify-between"><span>Gaji Karyawan (${d.totalNormalMenit} mnt)</span> <span class="font-medium text-gray-900">Rp ${valGaji.toLocaleString('id-ID')}</span></div>
            <div class="flex justify-between"><span>Uang Lembur (${d.totalLemburMenit} mnt)</span> <span class="font-medium text-gray-900">Rp ${valLembur.toLocaleString('id-ID')}</span></div>
            <div class="flex justify-between"><span>Uang Makan</span> <span class="font-medium text-gray-900">Rp ${valUangMakan.toLocaleString('id-ID')}</span></div>
            ${isKesehatan ? `<div class="flex justify-between text-green-700"><span>Uang Kesehatan</span> <span>+ Rp ${valKesehatan.toLocaleString('id-ID')}</span></div>` : ''}
            ${d.tepatWaktuCount > 0 ? `<div class="flex justify-between text-green-700"><span>Bonus Tepat Waktu (${d.tepatWaktuCount}x)</span> <span>+ Rp ${valBonusTepat.toLocaleString('id-ID')}</span></div>` : ''}
            ${isBonusMingguan ? `<div class="flex justify-between text-green-700"><span>Bonus Mingguan</span> <span>+ Rp ${valBonusMingguan.toLocaleString('id-ID')}</span></div>` : ''}
        `;
        document.getElementById('m_total_gaji').innerText = `Rp ${grandTotal.toLocaleString('id-ID')}`;
    };

