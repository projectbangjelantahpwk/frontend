    window.pilihKomponenDropdownRiwayat = function (index, elemenSelect) {
      const namaTerpilih = elemenSelect.value;
      const masterData = window.pilihanMasterKomponen?.find(
        (m) => m.nama_komponen === namaTerpilih,
