---
import Layout from "../layouts/Layout.astro";
import "bootstrap-icons/font/bootstrap-icons.css";
---

<Layout title="Kemitraan - Manajemen Bang Jelantah">
  <style is:global>
    /* Mengunci layar menjadi blank (putih) sampai skrip memberi izin masuk */
    body {
      display: none;
    }
  </style>
  <div class="max-w-7xl mx-auto flex flex-col h-full gap-lg">
    <div class="content-view flex flex-col gap-lg" id="view-kemitraan">
      <div
        class="flex flex-col md:flex-row md:items-end justify-between gap-md mb-2"
      >
        <header>
          <h2
            class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary"
          >
            Kemitraan
          </h2>
          <p class="font-body-md text-body-md text-on-surface-variant mt-xs">
            Manajemen relasi dan pendaftaran mitra pengumpul.
          </p>
        </header>
        <div
          class="w-full md:w-auto flex flex-col md:flex-row items-center gap-3 z-20"
        >
          <div class="relative inline-block text-left w-full md:w-auto">
            <button
              onclick="window.toggleDropdownFilter()"
              class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-surface-container-lowest border border-outline-variant text-on-surface-variant rounded-full font-label-sm font-bold hover:bg-surface-container transition-colors shadow-sm"
            >
              <i class="bi bi-funnel-fill"></i> Filter
            </button>

            <div
              id="dropdown-filter-mitra"
              class="hidden absolute right-0 mt-2 w-72 origin-top-right rounded-xl bg-surface-container-lowest border border-outline-variant shadow-lg p-4 flex flex-col gap-3 transition-all z-[60]"
            >
              <div>
                <label
                  class="block text-[10px] font-bold text-on-surface-variant uppercase tracking-wider mb-1"
                  >Rute Penjemputan</label
                >
                <select
                  id="filter-rute-mitra"
                  onchange="window.applySearchMitra()"
                  class="w-full h-10 px-3 rounded-lg border border-outline-variant bg-surface-container text-sm outline-none focus:border-primary"
                >
                  <option value="">-- Semua Rute --</option>
                </select>
              </div>
              <div>
                <label
                  class="block text-[10px] font-bold text-on-surface-variant uppercase tracking-wider mb-1"
                  >Jenis Pelanggan</label
                >
                <select
                  id="filter-jenis-mitra"
                  onchange="window.applySearchMitra()"
                  class="w-full h-10 px-3 rounded-lg border border-outline-variant bg-surface-container text-sm outline-none focus:border-primary"
                >
                  <option value="">-- Semua Jenis --</option>
                  <option value="Rumah Tangga">Rumah Tangga / Perorangan</option
                  >
                  <option value="Restoran/Rumah Makan"
                    >Restoran / Rumah Makan</option
                  >
                  <option value="MBG">MBG</option>
                  <option value="Pengepul Kecil">Pengepul Kecil</option>
                  <option value="Pabrik/Industri">Pabrik / Industri</option>
                  <option value="Lainnya">Lainnya</option>
                </select>
              </div>
              <div class="flex justify-between gap-2 mt-1">
                <button
                  onclick="window.resetFilterMitra(event)"
                  class="flex-1 h-9 border border-outline-variant text-on-surface-variant font-bold text-xs rounded-lg hover:bg-surface-container-low transition-colors"
                  >Reset</button
                >
                <button
                  onclick="window.toggleDropdownFilter()"
                  class="flex-1 h-9 bg-primary text-on-primary font-bold text-xs rounded-lg hover:bg-surface-tint transition-colors shadow-sm"
                  >Tutup</button
                >
              </div>
            </div>
          </div>

          <div
            class="w-full md:w-auto flex items-center bg-surface-container-lowest rounded-full px-sm h-11 border border-outline-variant focus-within:border-primary focus-within:ring-1 focus-within:ring-primary transition-all shadow-sm"
          >
            <span
              class="material-symbols-outlined text-on-surface-variant ml-sm"
              >search</span
            >
            <input
              type="text"
              id="input-search-mitra"
              oninput="window.applySearchMitra()"
              class="bg-transparent border-none focus:ring-0 text-on-surface w-full md:w-64 font-body-md text-sm h-full placeholder:text-on-surface-variant outline-none px-2"
              placeholder="Cari nama, no hp..."
            />
          </div>
        </div>
      </div>

      <div class="flex flex-col flex-1 gap-md">
        <div
          class="flex overflow-x-auto border-b border-outline-variant scrollbar-hide"
        >
          <button
            class="tab-btn px-md py-sm font-label-lg text-label-lg border-b-2 border-transparent text-on-surface-variant hover:text-primary whitespace-nowrap"
            data-tab="mitra-langganan">Mitra Langganan</button
          >
          <button
            class="tab-btn px-md py-sm font-label-lg text-label-lg border-b-2 border-transparent text-on-surface-variant hover:text-primary whitespace-nowrap"
            data-tab="mitra-tidak-aktif">Mitra Tidak Aktif</button
          >
          <button
            class="tab-btn px-md py-sm font-label-lg text-label-lg border-b-2 border-transparent text-on-surface-variant hover:text-primary whitespace-nowrap"
            data-tab="rekening-mitra">Rekening Mitra</button
          >
        </div>

        <div class="tab-content block" id="tab-mitra-langganan">
          <div
            class="md:hidden flex flex-col gap-md"
            id="mitra-langganan-mobile"
          >
          </div>
          <div
            class="hidden md:block overflow-x-auto bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm"
          >
            <table class="w-full text-left border-collapse min-w-[800px]">
              <thead>
                <tr
                  class="border-b border-outline-variant bg-surface-container-low"
                >
                  <th
                    class="p-md w-12 text-center font-label-lg text-on-surface-variant font-semibold"
                    >No</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold"
                    >Nama</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold"
                    >Rute</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold"
                    >No HP</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold"
                    >Jenis Pelanggan</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold text-center"
                    >Alamat</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold text-center"
                    >Deposit</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold text-center"
                    >Jml Transaksi</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold"
                    >Riwayat Follow Up</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold text-right"
                    >Aksi</th
                  >
                </tr>
              </thead>
              <tbody
                class="divide-y divide-outline-variant"
                id="mitra-langganan-tbody"
              >
                <tr
                  ><td
                    colspan="5"
                    class="p-md text-center text-on-surface-variant"
                    >Memuat...</td
                  ></tr
                >
              </tbody>
            </table>
          </div>
        </div>

        <div class="tab-content hidden" id="tab-mitra-tidak-aktif">
          <div
            class="md:hidden flex flex-col gap-md"
            id="mitra-tidak-aktif-mobile"
          >
          </div>
          <div
            class="hidden md:block overflow-x-auto bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm"
          >
            <table class="w-full text-left border-collapse min-w-[800px]">
              <thead>
                <tr
                  class="border-b border-outline-variant bg-surface-container-low"
                >
                  <th
                    class="p-md w-12 text-center font-label-lg text-on-surface-variant font-semibold"
                    >No</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold"
                    >Nama</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold"
                    >No HP</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold text-center"
                    >Jml Transaksi</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold"
                    >Riwayat Follow Up</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold"
                    >Tgl Nonaktif</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold text-right"
                    >Aksi</th
                  >
                </tr>
              </thead>
              <tbody
                class="divide-y divide-outline-variant opacity-75"
                id="mitra-tidak-aktif-tbody"
              >
                <tr
                  ><td
                    colspan="5"
                    class="p-md text-center text-on-surface-variant"
                    >Memuat...</td
                  ></tr
                >
              </tbody>
            </table>
          </div>
        </div>

        <div class="tab-content hidden" id="tab-rekening-mitra">
          <div class="flex justify-between items-center mb-4">
            <h3 class="font-headline-md text-on-surface">
              Data Rekening Mitra
            </h3>
            <div class="flex items-center gap-2">
              <select
                id="filter-bank"
                onchange="window.applySearchMitra()"
                class="h-10 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-sm outline-none focus:border-primary"
              >
                <option value="">Semua Bank</option>
              </select>
              <!-- Sebelumnya: onclick="window.openModal('modal-tambah-rekening')" -->
              <button
                onclick="window.bukaModalTambahRekening()"
                class="bg-primary text-on-primary px-4 py-2 rounded-full font-label-lg flex items-center gap-2 shadow-sm hover:bg-surface-tint hover:shadow-md hover:-translate-y-0.5 transition-all active:translate-y-0"
              >
                <span class="material-symbols-outlined text-[20px]">add</span> Tambah
              </button>
            </div>
          </div>

          <div
            class="md:hidden flex flex-col gap-md"
            id="rekening-mitra-mobile"
          >
          </div>

          <div
            class="hidden md:block overflow-x-auto bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm"
          >
            <table class="w-full text-left border-collapse min-w-[800px]">
              <thead>
                <tr
                  class="border-b border-outline-variant bg-surface-container-low"
                >
                  <th
                    class="p-md w-12 text-center font-label-lg text-on-surface-variant font-semibold"
                    >No</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold"
                    >Nama Mitra</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold"
                    >Atas Nama</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold"
                    >Nama Bank</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold"
                    >No. Rekening</th
                  >
                  <th
                    class="p-md font-label-lg text-on-surface-variant font-semibold text-right"
                    >Aksi</th
                  >
                </tr>
              </thead>
              <tbody
                class="divide-y divide-outline-variant"
                id="rekening-mitra-tbody"
              >
                <tr
                  ><td
                    colspan="5"
                    class="p-md text-center text-on-surface-variant"
                    >Memuat...</td
                  ></tr
                >
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    class="fixed inset-0 z-[60] bg-on-background/50 hidden flex items-center justify-center p-container-margin opacity-0 transition-opacity duration-300"
    id="modal-edit-mitra"
  >
    <div
      class="relative w-full max-w-md transform scale-95 transition-transform duration-300"
    >
      <button
        class="absolute -top-12 right-0 md:-right-14 md:top-0 w-10 h-10 flex items-center justify-center bg-white text-gray-700 hover:text-red-600 hover:bg-gray-50 rounded-full shadow-lg border border-gray-200 transition-all z-10"
        onclick="closeModal('modal-edit-mitra')"
      >
        <span class="material-symbols-outlined">close</span>
      </button>

      <div
        class="bg-surface-container-lowest rounded-xl shadow-xl p-lg max-h-[85vh] overflow-y-auto scrollbar-hide relative"
      >
        <h3 class="font-headline-md text-headline-md text-on-surface mb-sm">
          Edit Mitra Langganan
        </h3>

        <form class="flex flex-col gap-md" id="form-edit-mitra">
          <input type="hidden" id="edit_mitra_id" />

          <div>
            <label
              class="block font-label-sm text-label-sm text-on-surface-variant mb-xs"
              >Nama Lengkap Toko/Mitra</label
            >
            <input
              id="edit_mitra_nama"
              class="w-full h-12 px-sm rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface focus:ring-2 focus:ring-primary outline-none"
              required
            />
          </div>
          <div>
            <label
              class="block font-label-sm text-label-sm text-on-surface-variant mb-xs"
              >No HP</label
            >
            <input
              id="edit_mitra_hp"
              class="w-full h-12 px-sm rounded-lg border border-outline-variant bg-surface-container text-on-surface outline-none font-bold"
              readonly
            />
          </div>
          <div>
            <label
              class="block font-label-sm text-label-sm text-on-surface-variant mb-xs"
              >Rute Penjemputan</label
            >
            <select
              id="edit_mitra_rute"
              class="w-full h-12 px-sm rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface focus:ring-2 focus:ring-primary outline-none"
              required
            >
              <option value="">-- Memuat Rute... --</option>
            </select>
          </div>
          <div>
            <label
              class="block font-label-sm text-label-sm text-on-surface-variant mb-xs"
              >Jenis Pelanggan</label
            >
            <select
              id="edit_mitra_jenis"
              class="w-full h-12 px-sm rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface focus:ring-2 focus:ring-primary outline-none"
              required
            >
              <option value="Rumah Tangga">Rumah Tangga / Perorangan</option>
              <option value="Restoran/Rumah Makan"
                >Restoran / Rumah Makan</option
              >
              <option value="MBG">MBG</option>
              <option value="Pengepul Kecil">Pengepul Kecil</option>
              <option value="Pabrik/Industri">Pabrik / Industri</option>
              <option value="Lainnya">Lainnya</option>
            </select>
          </div>
          <div>
            <label
              class="block font-label-sm text-label-sm text-on-surface-variant mb-xs"
              >Saldo Deposit (Rp)</label
            >
            <input
              id="edit_mitra_deposit"
              type="number"
              class="w-full h-12 px-sm rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface focus:ring-2 focus:ring-primary outline-none font-mono font-bold text-green-700"
              placeholder="0"
              required
            />
          </div>
          <div>
            <label
              class="block font-label-sm text-label-sm text-on-surface-variant mb-xs"
              >Alamat Lengkap</label
            >
            <textarea
              id="edit_mitra_alamat"
              class="w-full p-sm rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface focus:ring-2 focus:ring-primary outline-none resize-none"
              rows="2"
              required></textarea>
          </div>
          <div>
            <label
              class="block font-label-sm text-label-sm text-on-surface-variant mb-xs"
              >Link Google Maps</label
            >
            <input
              id="edit_mitra_gmaps"
              type="url"
              class="w-full h-12 px-sm rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface focus:ring-2 focus:ring-primary outline-none"
              required
            />
          </div>
          <div class="mt-sm flex justify-end gap-sm pt-2">
            <button
              class="px-md h-touch-target rounded-full font-label-lg text-primary hover:bg-surface-container-low transition-colors"
              onclick="closeModal('modal-edit-mitra')"
              type="button">Batal</button
            >
            <button
              class="px-md h-touch-target bg-primary text-on-primary rounded-full font-label-lg hover:bg-surface-tint shadow-sm transition-colors"
              type="submit"
              id="btn-submit-edit-mitra">Simpan Perubahan</button
            >
          </div>
        </form>
      </div>
    </div>
  </div>
  <div
    class="fixed inset-0 z-[60] bg-on-background/50 hidden flex items-center justify-center p-container-margin opacity-0 transition-opacity duration-300"
    id="modal-tambah-rekening"
  >
    <div
      class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-md p-lg transform scale-95 transition-transform duration-300 relative"
    >
      <button
        class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center text-on-surface-variant hover:bg-surface-container-low rounded-full transition-colors"
        onclick="closeModal('modal-tambah-rekening')"
      >
        <span class="material-symbols-outlined">close</span>
      </button>
      <h3 class="font-headline-md text-headline-md text-on-surface mb-sm">
        Tambah Rekening
      </h3>
      <form class="flex flex-col gap-md mt-4" id="form-tambah-rekening">
        <div class="relative">
          <label class="block font-label-sm text-on-surface-variant mb-xs"
            >Pilih Mitra</label
          >
          <input
            type="text"
            id="input_search_mitra_rekening"
            class="w-full h-12 px-sm rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface focus:ring-2 focus:ring-primary outline-none cursor-text"
            placeholder="Ketik nama mitra..."
            autocomplete="off"
          />
          <input type="hidden" id="input_mitra_id_rekening" required />

          <div
            id="dropdown_mitra_rekening"
            class="hidden absolute z-[70] left-0 right-0 mt-1 max-h-48 overflow-y-auto bg-surface-container-lowest border border-outline-variant rounded-lg shadow-lg scrollbar-hide"
          >
          </div>
        </div>
        <div>
          <label class="block font-label-sm text-on-surface-variant mb-xs"
            >Nama Bank</label
          >
          <input
            id="input_bank_rekening"
            class="w-full h-12 px-sm rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface outline-none focus:ring-2 focus:ring-primary"
            placeholder="Contoh: BCA, Mandiri"
            required
          />
        </div>
        <div>
          <label class="block font-label-sm text-on-surface-variant mb-xs"
            >No. Rekening</label
          >
          <input
            id="input_norek_rekening"
            type="number"
            class="w-full h-12 px-sm rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface outline-none focus:ring-2 focus:ring-primary"
            placeholder="Masukkan angka rekening"
            required
          />
        </div>
        <div>
          <label class="block font-label-sm text-on-surface-variant mb-xs"
            >Atas Nama</label
          >
          <input
            id="input_an_rekening"
            class="w-full h-12 px-sm rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface outline-none focus:ring-2 focus:ring-primary"
            placeholder="Sesuai buku tabungan"
            required
          />
        </div>
        <div class="mt-sm flex justify-end gap-sm">
          <button
            class="px-md py-2 rounded-full font-label-lg text-primary hover:bg-surface-container-low transition-colors"
            onclick="closeModal('modal-tambah-rekening')"
            type="button">Batal</button
          >
          <button
            class="px-md py-2 bg-primary text-on-primary rounded-full font-label-lg hover:bg-surface-tint shadow-sm transition-colors"
            type="submit"
            id="btn-submit-rekening">Simpan</button
          >
        </div>
      </form>
    </div>
  </div>

  <div
    class="fixed inset-0 z-[60] bg-on-background/50 hidden flex items-center justify-center p-container-margin opacity-0 transition-opacity duration-300"
    id="modal-edit-rekening"
  >
    <div
      class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-md p-lg transform scale-95 transition-transform duration-300 relative"
    >
      <button
        class="absolute top-4 right-4 text-on-surface-variant hover:bg-surface-container-low rounded-full transition-colors"
        onclick="closeModal('modal-edit-rekening')"
      >
        <span class="material-symbols-outlined">close</span>
      </button>
      <h3 class="font-headline-md text-on-surface mb-sm">Edit Rekening</h3>
      <form class="flex flex-col gap-md mt-4" id="form-edit-rekening">
        <input type="hidden" id="edit_rekening_id" />
        <div>
          <label class="block font-label-sm text-on-surface-variant mb-xs"
            >Nama Mitra</label
          >
          <input
            id="edit_mitra_nama_rekening"
            class="w-full h-12 px-sm rounded-lg bg-surface-container text-on-surface outline-none font-bold"
            readonly
          />
        </div>
        <div>
          <label class="block font-label-sm text-on-surface-variant mb-xs"
            >Nama Bank</label
          >
          <input
            id="edit_bank_rekening"
            class="w-full h-12 px-sm rounded-lg border border-outline-variant outline-none focus:ring-primary"
            required
          />
        </div>
        <div>
          <label class="block font-label-sm text-on-surface-variant mb-xs"
            >No. Rekening</label
          >
          <input
            id="edit_norek_rekening"
            type="number"
            class="w-full h-12 px-sm rounded-lg border border-outline-variant outline-none focus:ring-primary"
            required
          />
        </div>
        <div>
          <label class="block font-label-sm text-on-surface-variant mb-xs"
            >Atas Nama</label
          >
          <input
            id="edit_an_rekening"
            class="w-full h-12 px-sm rounded-lg border border-outline-variant outline-none focus:ring-primary"
            required
          />
        </div>
        <div class="mt-sm flex justify-end gap-sm">
          <button
            class="px-md py-2 rounded-full text-primary hover:bg-surface-container-low"
            onclick="closeModal('modal-edit-rekening')"
            type="button">Batal</button
          >
          <button
            class="px-md py-2 bg-primary text-on-primary rounded-full hover:bg-surface-tint"
            type="submit"
            id="btn-submit-edit-rekening">Update</button
          >
        </div>
      </form>
    </div>
  </div>
  <!-- ================= ASIDE FOLLOW UP ================= -->
  <!-- Overlay -->
  <div
    id="overlay-aside-fu"
    class="fixed inset-0 bg-on-background/50 z-[65] hidden opacity-0 transition-opacity duration-300"
    onclick="window.tutupAsideFU()"
  >
  </div>

  <!-- Panel Aside -->
  <aside
    id="aside-fu"
    class="fixed top-0 right-0 h-full w-full md:w-[400px] bg-surface-container-lowest z-[70] transform translate-x-full transition-transform duration-300 shadow-2xl flex flex-col"
  >
    <div
      class="flex items-center justify-between p-4 border-b border-outline-variant bg-surface-container-low"
    >
      <h3 class="font-headline-md text-on-surface">Update Follow Up</h3>
      <button
        onclick="window.tutupAsideFU()"
        class="w-10 h-10 flex items-center justify-center text-on-surface-variant hover:bg-surface-container-highest rounded-full transition-colors"
      >
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    <div class="p-lg flex-1 overflow-y-auto">
      <div
        class="mb-6 p-4 bg-primary-container/30 border border-primary/20 rounded-xl"
      >
        <p class="font-label-sm text-primary mb-1">Mitra yang di-follow up:</p>
        <p
          id="fu_nama_mitra"
          class="font-headline-sm text-on-surface font-bold"
        >
          Nama Mitra
        </p>
      </div>

      <form id="form-fu-mitra" class="flex flex-col gap-md">
        <input type="hidden" id="fu_mitra_id" />

        <div>
          <label class="block font-label-sm text-on-surface-variant mb-xs"
            >Tanggal Follow Up</label
          >
          <input
            type="date"
            id="fu_tanggal"
            class="w-full h-12 px-sm rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface focus:ring-2 focus:ring-primary outline-none"
            required
          />
        </div>

        <div>
          <label class="block font-label-sm text-on-surface-variant mb-xs"
            >Catatan / Keterangan</label
          >
          <textarea
            id="fu_keterangan"
            rows="5"
            class="w-full p-sm rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface focus:ring-2 focus:ring-primary outline-none resize-none"
            placeholder="Tulis hasil obrolan atau keterangan follow up di sini..."
            required></textarea>
        </div>

        <div class="mt-6">
          <button
            type="submit"
            id="btn-submit-fu"
            class="w-full h-12 bg-primary text-on-primary rounded-full font-label-lg hover:bg-surface-tint shadow-sm transition-colors flex items-center justify-center gap-2"
          >
            <span class="material-symbols-outlined text-[20px]">save</span> Simpan
            Catatan
          </button>
        </div>
      </form>
    </div>
  </aside>
  <script is:inline>
    // ==========================================
    // FITUR PENCARIAN GLOBAL SAKTI (BULLETPROOF)
    // ==========================================
    window.applySearchMitra = function () {
      const searchInput = document.getElementById("input-search-mitra");
      if (!searchInput) return;

      // Hapus spasi berlebih di awal/akhir kata
      const keyword = searchInput.value.toLowerCase().trim();

      // Sapu bersih semua baris dan kartu di SEMUA TAB
      const items = document.querySelectorAll(`
                    #mitra-baru-tbody tr, #mitra-baru-mobile > div,
                    #mitra-langganan-tbody tr, #mitra-langganan-mobile > div,
                    #mitra-tidak-aktif-tbody tr, #mitra-tidak-aktif-mobile > div,
                    #leaderboard-live-list > div
                `);

      items.forEach((item) => {
        // Abaikan baris "Memuat data..." biar sistem nggak error
        if (item.querySelector("td[colspan]")) return;
        if (item.classList.contains("col-span-full")) return;

        const text = item.textContent.toLowerCase();

        // Kalau kotak pencarian kosong, kembalikan semua data
        if (keyword === "") {
          item.style.display = "";
        } else {
          // Sembunyikan yang tidak cocok, munculkan yang cocok
          item.style.display = text.includes(keyword) ? "" : "none";
        }
      });
    };
    document.addEventListener("DOMContentLoaded", async () => {
      if (!window.supabase) return console.error("Supabase tidak terhubung!");

      // === TAMBAHAN: CEK ROLE USER YANG LOGIN ===
      // === 🛡️ GATEKEEPER KEUANGAN ===
      const allowedRoles = ["owner", "hrd", "admin", "keuangan", "it"];
      const client = window.supabase || supabase;

      const {
        data: { session },
      } = await client.auth.getSession();
      if (!session) return window.location.replace("/"); // Tendang kalau belum login

      const { data: prof } = await client
        .from("profiles")
        .select("role")
        .eq("id", session.user.id)
        .single();
      if (!allowedRoles.includes(prof?.role)) {
        alert(
          `Akses Ditolak! Role Anda (${prof?.role || "Guest"}) dilarang masuk ke Keuangan.`,
        );
        return window.location.replace("/");
      }
      document.body.style.display = "block"; // Buka gembok CSS, tampilkan layar!

      // ==========================================
      // 1. TAB LOGIC
      // ==========================================
      const tabBtns = document.querySelectorAll(".tab-btn");
      const tabContents = document.querySelectorAll(".tab-content");

      tabBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          // Reset semua warna tombol tab
          tabBtns.forEach((b) => {
            b.classList.remove("border-primary", "text-primary", "active");
            b.classList.add("border-transparent", "text-on-surface-variant");
          });
          // Aktifkan warna tombol tab yang diklik
          btn.classList.remove("border-transparent", "text-on-surface-variant");
          btn.classList.add("border-primary", "text-primary", "active");

          // Sembunyikan semua isi tab
          tabContents.forEach((content) => {
            content.classList.add("hidden");
            content.classList.remove("block"); // Pastikan class block dihapus
          });

          // Tampilkan isi tab yang sesuai dengan data-tab
          const targetId = btn.getAttribute("data-tab");
          const targetElement = document.getElementById(`tab-${targetId}`);

          if (targetElement) {
            targetElement.classList.remove("hidden");
            targetElement.classList.add("block");
          }

          // 🌟 KHUSUS LEADERBOARD: Render ulang data live setiap tabnya dibuka 🌟
          if (
            targetId === "top_leaderboard" &&
            typeof window.generateLeaderboard === "function"
          ) {
            window.generateLeaderboard();
          }

          // Terapkan ulang filter pencarian secara otomatis saat pindah tab
          if (typeof window.applySearchMitra === "function") {
            setTimeout(window.applySearchMitra, 50);
          }
        });
      });

      // ==========================================
      // 2. FETCH DATA & RENDER CSR
      // ==========================================
      // ==========================================
      // 2. FETCH DATA & RENDER CSR (VERSI BERSIH)
      // ==========================================
      async function loadDataKemitraan() {
        // 0. Ambil Data Rute Sekali di Awal (Untuk Modal Edit)
        const { data: ruteData } = await window.supabase
          .from("rute_jemput")
          .select("id, nama_rute")
          .eq("status", "Aktif");

        let optRute = '<option value="">-- Pilih Rute / Wilayah --</option>';
        if (ruteData) {
          ruteData.forEach(
            (r) =>
              (optRute += `<option value="${r.nama_rute}">${r.nama_rute}</option>`),
          );
        }

        // Tempelkan ke dropdown form Edit (Karena form tambah prospek dkk udah pindah)
        const elEditRute = document.getElementById("edit_mitra_rute");
        if (elEditRute) elEditRute.innerHTML = optRute;

        const elFilterRute = document.getElementById("filter-rute-mitra");
        if (elFilterRute)
          elFilterRute.innerHTML = optRute.replace(
            "-- Pilih Rute / Wilayah --",
            "-- Semua Rute --",
          );

        // ==========================================
        // FITUR AUTO BROADCAST WA MITRA LANGGANAN
        // ==========================================
        window.broadcastWA = function (hp, nama) {
          if (!hp || hp === "-")
            return alert(`Nomor HP untuk mitra ${nama} tidak ditemukan!`);

          // Sapu bersih karakter non-angka
          let waNumber = hp.replace(/\D/g, "");

          // Jika nomor diawali angka '0', ubah paksa jadi kode Indonesia '62'
          if (waNumber.startsWith("0")) {
            waNumber = "62" + waNumber.substring(1);
          }

          const textPesan = `Halo Kak ${nama},\n\nKami dari *BANG JELANTAH PURWAKARTA* ingin menginformasikan jadwal penjemputan komoditas.\n\nApakah ada stok minyak jelantah atau kargo lainnya yang siap kami angkut hari ini? Mohon infonya ya Kak, terima kasih! 😊🙏`;
          const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(textPesan)}`;
          window.open(waLink, "_blank");
        };

        // B. Mitra Langganan
        const { data: langganan, error: errLang } = await window.supabase
          .from("mitra")
          .select(
            "id, nama_mitra, rute_jemput, nomor_hp, alamat, link_gmaps, total_order, total_transaksi, activated, sumber_mitra, tgl_terakhir_fu, keterangan_fu, created_at, deposit, jenis_pelanggan, tgl_transaksi_pertama",
          )
          .eq("activated", true)
          .order("created_at", { ascending: false });

        if (errLang) {
          alert("Gagal ambil data Langganan: " + errLang.message);
          console.error("Detail Error Langganan:", errLang);
        }

        window.allMitraLangganan = langganan || [];
        let htmlLangMobile = "";
        let htmlLangTable = "";
        let chartDataByMonth = {
          Jan: 0,
          Feb: 0,
          Mar: 0,
          Apr: 0,
          May: 0,
          Jun: 0,
          Jul: 0,
          Aug: 0,
          Sep: 0,
          Oct: 0,
          Nov: 0,
          Dec: 0,
        };

        if (langganan && langganan.length > 0) {
          langganan.forEach((l, index) => {
            // Data untuk Grafik
            if (l.created_at) {
              const date = new Date(l.created_at);
              const monthIndex = date.getMonth();
              const monthKeys = Object.keys(chartDataByMonth);
              chartDataByMonth[monthKeys[monthIndex]] += 1;
            }

            // 📱 TAMPILAN MOBILE CARD (SUDAH RESPONSIVE & MOBILE FIRST)
            htmlLangMobile += `
            <div class="mitra-item bg-surface-container-lowest border border-outline-variant rounded-lg p-md flex flex-col gap-sm shadow-sm relative" data-rute="${l.rute_jemput || ""}" data-jenis="${l.jenis_pelanggan || ""}">
                <button onclick="window.nonaktifkanMitra('${l.id}', '${l.nama_mitra.replace(/'/g, "\\'")}')" class="absolute top-4 right-4 text-error hover:bg-error-container rounded-full p-1 transition-colors" title="Nonaktifkan Mitra">
                    <span class="material-symbols-outlined text-[20px]">person_off</span>
                </button>
                <div class="border-b border-outline-variant pb-sm">
                    <p class="font-headline-md text-on-surface font-semibold pr-8">${l.nama_mitra}</p>
                </div>
                <div><span class="text-[10px] bg-primary/10 text-primary px-2 py-0.5 rounded uppercase mt-1 inline-block">${l.rute_jemput || "Tanpa Rute"}</span></div>
                <div class="grid grid-cols-2 gap-sm pt-xs">
                    <div><p class="font-label-sm text-on-surface-variant">No HP</p><p class="font-body-md text-on-surface">${l.nomor_hp || "-"}</p></div>
                    <div><p class="font-label-sm text-on-surface-variant">Jenis Mitra</p><p class="font-body-md text-on-surface">${l.jenis_pelanggan || "Lainnya"}</p></div>
                    <div><p class="font-label-sm text-on-surface-variant">Transaksi</p><p class="font-body-md text-on-surface">${l.total_order || 0}x</p></div>
                    <div><p class="font-label-sm text-on-surface-variant">Deposit</p><p class="font-body-md text-green-700 font-bold">Rp ${Number(l.deposit || 0).toLocaleString("id-ID")}</p></div>
                </div>
                
                <div class="col-span-2 mt-2 p-3 bg-surface-container-low border border-outline-variant/50 rounded-lg relative group">
                    <button onclick="window.bukaAsideFU('${l.id}', '${l.nama_mitra.replace(/'/g, "\\'")}', '${l.tgl_terakhir_fu || ""}', '${(l.keterangan_fu || "").replace(/'/g, "\\'")}')" class="absolute top-2 right-2 w-8 h-8 flex items-center justify-center bg-surface-container-highest text-primary rounded-full hover:bg-primary-container transition-colors shadow-sm">
                        <span class="material-symbols-outlined text-[16px]">edit_note</span>
                    </button>
                    <p class="font-label-sm text-on-surface-variant mb-1">Riwayat Follow Up</p>
                    <p class="font-body-md text-on-surface text-sm leading-tight pr-8">
                        ${l.tgl_terakhir_fu ? `<span class="font-bold text-primary">${new Date(l.tgl_terakhir_fu).toLocaleDateString("id-ID")}</span> - ` : ""} 
                        ${l.keterangan_fu || "Belum ada riwayat follow up."}
                    </p>
                </div>

                <div class="grid grid-cols-2 gap-2 mt-xs pt-2 border-t border-outline-variant/40">
                    <button onclick="window.broadcastWA('${l.nomor_hp}', '${l.nama_mitra.replace(/'/g, "\\'")}')" class="h-10 bg-[#25D366] text-white rounded-full font-label-lg flex items-center justify-center gap-1 shadow-xs hover:bg-[#1ebd5a] transition-colors">
                        <i class="bi bi-whatsapp"></i> Chat WA
                    </button>
                    <button onclick="window.bukaEditMitra('${l.id}')" class="h-10 bg-surface-container text-primary rounded-full font-label-lg flex items-center justify-center gap-1 hover:bg-primary-container transition-colors">
                        <span class="material-symbols-outlined text-[16px]">edit</span> Edit
                    </button>
                </div>
            </div>`;

            // 🏢 TAMPILAN TABEL DESKTOP
            htmlLangTable += `
            <tr class="mitra-item hover:bg-surface-container-low transition-colors group" data-rute="${l.rute_jemput || ""}" data-jenis="${l.jenis_pelanggan || ""}">
                <td class="p-md text-center text-sm font-bold text-on-surface-variant">${index + 1}</td>
                <td class="p-md font-body-md text-on-surface font-semibold">${l.nama_mitra}</td>
                <td><span class="text-[10px] bg-primary/10 text-primary px-2 py-0.5 rounded uppercase mt-1 inline-block">${l.rute_jemput || "Tanpa Rute"}</span></td>
                <td class="p-md font-body-md text-on-surface">${l.nomor_hp || "-"}</td>
                <td class="p-md font-body-md text-on-surface">${l.jenis_pelanggan || "Lainnya"}</td>
                <td class="p-md text-center"><a class="text-primary inline-block p-1 rounded-full hover:bg-primary-container" href="${l.link_gmaps || "#"}" target="_blank"><span class="material-symbols-outlined text-[20px]">location_on</span></a></td>
                <td class="p-md text-center font-mono font-bold text-green-700">Rp ${Number(l.deposit || 0).toLocaleString("id-ID")}</td>
                <td class="p-md text-center font-body-md">${l.total_order || 0}x</td>
                
                <td class="p-md text-sm relative group/fu cursor-pointer hover:bg-surface-container-highest transition-colors rounded-lg" onclick="window.bukaAsideFU('${l.id}', '${l.nama_mitra.replace(/'/g, "\\'")}', '${l.tgl_terakhir_fu || ""}', '${(l.keterangan_fu || "").replace(/'/g, "\\'")}')">
                    <div class="flex items-start justify-between gap-2">
                        <div>
                            ${l.tgl_terakhir_fu ? `<span class="font-bold block text-xs text-primary">${new Date(l.tgl_terakhir_fu).toLocaleDateString("id-ID")}</span>` : "-"}
                            <span class="text-on-surface-variant truncate max-w-[150px] inline-block" title="${l.keterangan_fu || ""}">
                                ${l.keterangan_fu || "Belum ada riwayat"}
                            </span>
                        </div>
                        <span class="material-symbols-outlined text-[16px] text-primary opacity-0 group-hover/fu:opacity-100 transition-opacity">edit_note</span>
                    </div>
                </td>
                
                <td class="p-md text-right flex justify-end gap-2 items-center">
                    <button onclick="window.broadcastWA('${l.nomor_hp}', '${l.nama_mitra.replace(/'/g, "\\'")}')" class="w-10 h-10 flex items-center justify-center bg-surface-container text-[#25D366] rounded-full hover:bg-[#25D366]/15 opacity-0 group-hover:opacity-100 transition-opacity" title="Kirim WA Broadcast">
                        <i class="bi bi-whatsapp text-[18px]"></i>
                    </button>
                    <button onclick="window.bukaEditMitra('${l.id}')" class="w-10 h-10 flex items-center justify-center bg-surface-container text-primary rounded-full hover:bg-primary-container opacity-0 group-hover:opacity-100 transition-opacity" title="Edit Mitra">
                        <span class="material-symbols-outlined text-[18px]">edit</span>
                    </button>
                    <button onclick="window.nonaktifkanMitra('${l.id}', '${l.nama_mitra.replace(/'/g, "\\'")}')" class="w-10 h-10 flex items-center justify-center bg-surface-container text-error rounded-full hover:bg-error-container opacity-0 group-hover:opacity-100 transition-opacity" title="Pindah ke Tidak Aktif">
                        <span class="material-symbols-outlined text-[18px]">person_off</span>
                    </button>
                </td>
            </tr>`;
          });
        } else {
          const empty =
            '<p class="text-on-surface-variant text-center p-md">Tidak ada mitra langganan.</p>';
          htmlLangMobile = empty;
          htmlLangTable = `<tr><td colspan="10">${empty}</td></tr>`;
        }

        const elLangMobile = document.getElementById("mitra-langganan-mobile");
        const elLangTbody = document.getElementById("mitra-langganan-tbody");
        if (elLangMobile) elLangMobile.innerHTML = htmlLangMobile;
        if (elLangTbody) elLangTbody.innerHTML = htmlLangTable;

        if (typeof renderChart === "function") {
          renderChart(chartDataByMonth);
        }

        // C. Mitra Tidak Aktif
        const { data: nonaktif } = await window.supabase
          .from("mitra")
          .select("*")
          .eq("activated", false)
          .order("created_at", { ascending: false });

        let htmlNonMobile = "";
        let htmlNonTable = "";
        if (nonaktif && nonaktif.length > 0) {
          nonaktif.forEach((n, index) => {
            const dateOnly = n.created_at
              ? new Date(n.created_at).toLocaleDateString("id-ID")
              : "-";
            htmlNonMobile += `
                        <div class="mitra-item bg-surface-container-lowest border border-outline-variant rounded-lg p-md flex flex-col gap-sm shadow-sm opacity-75" data-rute="${n.rute_jemput || ""}" data-sumber="${n.sumber_mitra || ""}" data-jenis="${n.jenis_pelanggan || ""}">
                            <div class="border-b border-outline-variant pb-sm"><p class="font-headline-md text-on-surface-variant font-semibold">${n.nama_mitra}</p></div>
                            <div class="grid grid-cols-2 gap-sm pt-xs">
                                <div><p class="font-label-sm text-on-surface-variant">No HP</p><p class="font-body-md text-on-surface-variant">${n.nomor_hp || "-"}</p></div>
                                <div><p class="font-label-sm text-on-surface-variant">Tgl Nonaktif</p><p class="font-body-md text-on-surface-variant">${dateOnly}</p></div>
                            </div>
                            <button class="mt-sm w-full h-touch-target bg-surface-container text-primary rounded-full font-label-lg border border-primary hover:bg-primary-container transition-colors flex items-center justify-center gap-xs" onclick="window.aktifkanMitra('${n.id}', '${n.nama_mitra}')">
                                <span class="material-symbols-outlined text-[20px]">person_check</span> Aktifkan Kembali
                            </button>
                        </div>`;

            htmlNonTable += `
                        <tr class="mitra-item hover:bg-surface-container-low transition-colors" data-rute="${n.rute_jemput || ""}" data-sumber="${n.sumber_mitra || ""}" data-jenis="${n.jenis_pelanggan || ""}">
                            <td class="p-md text-center text-sm font-bold text-on-surface-variant">${index + 1}</td>
                            <td class="p-md font-body-md text-on-surface-variant font-semibold">${n.nama_mitra}</td>
                            <td class="p-md font-body-md text-on-surface-variant">${n.nomor_hp || "-"}</td>
                            <td class="p-md text-center font-body-md text-on-surface-variant">${n.total_order || 0}x</td>
                            <td class="p-md font-body-md text-on-surface-variant">${dateOnly}</td>
                            <td class="p-md text-right">
                                <button class="px-md py-sm bg-surface-container text-primary rounded-full font-label-lg border border-primary hover:bg-primary-container transition-colors inline-flex items-center gap-xs h-10" onclick="window.aktifkanMitra('${n.id}', '${n.nama_mitra}')">
                                    Aktifkan Kembali
                                </button>
                            </td>
                        </tr>`;
          });
        } else {
          const empty =
            '<p class="text-on-surface-variant text-center p-md">Tidak ada mitra tidak aktif.</p>';
          htmlNonMobile = empty;
          htmlNonTable = `<tr><td colspan="5">${empty}</td></tr>`;
        }

        const elNonMobile = document.getElementById("mitra-tidak-aktif-mobile");
        const elNonTbody = document.getElementById("mitra-tidak-aktif-tbody");
        if (elNonMobile) elNonMobile.innerHTML = htmlNonMobile;
        if (elNonTbody) elNonTbody.innerHTML = htmlNonTable;
      }

      // Jalankan Render CSR
      await loadDataKemitraan();

      // ==========================================
      // LOGIKA ASIDE FOLLOW UP
      // ==========================================
      window.bukaAsideFU = function (id, nama, tglLama, ketLama) {
        document.getElementById("fu_mitra_id").value = id;
        document.getElementById("fu_nama_mitra").innerText = nama;

        // Auto isi tanggal ke hari ini kalau belum ada riwayat sebelumnya
        const tglHariIni = new Date().toISOString().split("T")[0];
        document.getElementById("fu_tanggal").value = tglLama || tglHariIni;
        document.getElementById("fu_keterangan").value = ketLama || "";

        const aside = document.getElementById("aside-fu");
        const overlay = document.getElementById("overlay-aside-fu");

        overlay.classList.remove("hidden");
        void overlay.offsetWidth; // trigger reflow
        overlay.classList.remove("opacity-0");
        aside.classList.remove("translate-x-full");
        document.body.style.overflow = "hidden"; // Kunci scroll layar utama
      };

      window.tutupAsideFU = function () {
        const aside = document.getElementById("aside-fu");
        const overlay = document.getElementById("overlay-aside-fu");

        aside.classList.add("translate-x-full");
        overlay.classList.add("opacity-0");

        setTimeout(() => {
          overlay.classList.add("hidden");
          document.body.style.overflow = ""; // Lepas scroll layar utama
        }, 300);
      };

      // Submit form Follow Up
      document
        .getElementById("form-fu-mitra")
        ?.addEventListener("submit", async (e) => {
          e.preventDefault();
          const btn = document.getElementById("btn-submit-fu");
          btn.innerHTML =
            '<span class="material-symbols-outlined text-[20px] animate-spin">sync</span> Menyimpan...';
          btn.disabled = true;

          try {
            const id = document.getElementById("fu_mitra_id").value;
            const payload = {
              tgl_terakhir_fu: document.getElementById("fu_tanggal").value,
              keterangan_fu: document.getElementById("fu_keterangan").value,
            };

            const { error } = await window.supabase
              .from("mitra")
              .update(payload)
              .eq("id", id);

            if (error) throw error;

            alert("Follow up berhasil dicatat!");
            window.location.reload();
          } catch (err) {
            alert("Gagal menyimpan: " + err.message);
            btn.innerHTML =
              '<span class="material-symbols-outlined text-[20px]">save</span> Simpan Catatan';
            btn.disabled = false;
          }
        });

      // ==========================================
      // 4. LOGIKA MODAL & AKSI DATABASE
      // ==========================================
      window.openModal = function (id) {
        const modal = document.getElementById(id);
        if (!modal) return;

        modal.classList.remove("hidden");
        void modal.offsetWidth;
        modal.classList.remove("opacity-0");
        const isi = modal.querySelector("div");
        if (isi) isi.classList.remove("scale-95");

        // 🔥 Kunci body layar belakang biar gak bocor scroll-nya
        document.body.style.overflow = "hidden";
      };

      window.closeModal = function (id) {
        const modal = document.getElementById(id);
        if (!modal) return;

        modal.classList.add("opacity-0");
        const isi = modal.querySelector("div");
        if (isi) isi.classList.add("scale-95");

        setTimeout(() => {
          modal.classList.add("hidden");
