    // LOGIKA KASIR SPLIT PAYMENT (UI)
    window.kalkulasiKasir = function () {
      const uK =
        parseFloat(document.getElementById("kasir_keuangan").value) || 0;
      const uG = parseFloat(document.getElementById("kasir_gudang").value) || 0;
      const uO = parseFloat(document.getElementById("kasir_owner").value) || 0;

      const totalTagihan = window.currentSalaryData.finalState.grandTotal;
      const totalSplit = uK + uG + uO;
      const sisa = totalTagihan - totalSplit;

      const elSisa = document.getElementById("kasir_sisa");
      const boxSisa = document.getElementById("kasir_sisa_box");
      const btnBayar = document.getElementById("btn-eksekusi-bayar");

      elSisa.innerText = `Rp ${sisa.toLocaleString("id-ID")}`;

      if (sisa === 0) {
        boxSisa.classList.replace("bg-red-50", "bg-green-50");
        boxSisa.classList.replace("border-red-200", "border-green-200");
        elSisa.classList.replace("text-red-700", "text-green-700");
        btnBayar.disabled = false;
      } else {
        boxSisa.classList.replace("bg-green-50", "bg-red-50");
        boxSisa.classList.replace("border-green-200", "border-red-200");
        elSisa.classList.replace("text-green-700", "text-red-700");
        btnBayar.disabled = true;
      }
    };

    // EKSEKUSI PEMBAYARAN FINAL KE DATABASE
    window.eksekusiBayarGaji = async function (overrideStatus = "ACC") {
      if (!window.supabase) return;
      const d = window.currentSalaryData;
      const btnBayar = document.getElementById("btn-eksekusi-bayar");
      btnBayar.innerText = "Memproses Ke Server...";
      btnBayar.disabled = true;

      const potKasbonInput = document.getElementById(
        "potongan_kasbon_sekarang",
      ).value;
      const potonganManual =
        potKasbonInput === "" ? null : parseFloat(potKasbonInput);

      try {
        // 🔥 TEMBAK DENO DENGAN BERBAGAI PECAHAN RINCIAN DAN ID ADMIN
        // 🔥 TEMBAK DENO DENGAN BERBAGAI PECAHAN RINCIAN
        const { data, error } = await window.supabase.functions.invoke(
          "gaji-karyawan",
          {
            // <--- UBAH DISINI
            body: {
              empId: d.empId,
              tglMulai: d.tglMulai,
              tglAkhir: d.tglAkhir,
              action: "bayar",
              statusTarget: overrideStatus,
              adminId: currentUserId,
              potonganKasbonManual: isNaN(potonganManual)
                ? null
                : potonganManual,
              siklusGaji: d.siklusGaji, // Pastikan ini ikut terkirim
            },
          },
        );

        if (error) throw error;

        alert(
          `✅ SUKSES LUNAS!\n\nGaji berhasil dibayar dari Uang Keuangan. Rincian gaji pokok, lembur, kesehatan, total bonus, dan kasbon otomatis pecah di modul Pengeluaran.`,
        );
        window.location.reload();
      } catch (err) {
        alert(
          "Gagal memproses pembayaran gaji: " +
            (err.message || "Terjadi kesalahan di server Deno."),
        );
        btnBayar.innerText = "POTONG KAS & BAYAR";
        btnBayar.disabled = false;
      }
    };

    window.updateJamAbsenManual = () => {
      const valTiba = document.getElementById("edit_absen_tiba").value;
      const valPulang = document.getElementById("edit_absen_pulang").value;
      if (!valTiba) return;

      window.currentSalaryData.jamTibaStr = valTiba + ":00";
      window.currentSalaryData.jamPulangStr = valPulang
        ? valPulang + ":00"
        : "-";

      let masukMenit = parseJamMenit(window.currentSalaryData.jamTibaStr);
      let pulangMenit = valPulang
        ? parseJamMenit(window.currentSalaryData.jamPulangStr)
        : masukMenit;

      let totalNormalMenit = 0;
      let totalLemburMenit = 0;
      const batasPulangNormalMenit = 17 * 60;
      let actualPulangNormal = Math.min(pulangMenit, batasPulangNormalMenit);
      totalNormalMenit = Math.max(0, actualPulangNormal - masukMenit);
      if (pulangMenit > batasPulangNormalMenit) {
        totalLemburMenit = pulangMenit - batasPulangNormalMenit;
      }

      window.currentSalaryData.totalNormalMenit = totalNormalMenit;
      window.currentSalaryData.totalLemburMenit = totalLemburMenit;
      window.kalkulasiRealtimeGaji();
    };

    // FUNGSI SIMPAN SETUP KE DATABASE
    window.simpanSetupGaji = async function () {
      if (!window.supabase) return;
      const empId = document.getElementById("m_karyawan_id").value;
      const setupId = document.getElementById("m_setup_id").value;

      // ✅ SEKARANG MURNI MINGGUAN & ID ELEMEN DIPASTIKAN VALID
      const payloadSetup = {
        user_id: empId,
        siklus_gaji: document.getElementById("setup_siklus_gaji").value, // TAMBAHAN BARU
        gaji_menit:
          parseFloat(document.getElementById("setup_gaji_pokok")?.value) || 0,
        uang_lembur_menit:
          parseFloat(document.getElementById("setup_lembur_menit")?.value) || 0,
        uang_makan:
          parseFloat(document.getElementById("setup_uang_makan")?.value) || 0,
        bonus_tepat_waktu:
          parseFloat(document.getElementById("setup_bonus_tepat")?.value) || 0,
        bonus_mingguan:
          parseFloat(document.getElementById("setup_bonus_mingguan")?.value) ||
          0,
        uang_kesehatan:
          parseFloat(document.getElementById("setup_uang_kesehatan")?.value) ||
          0,
        uang_rapat:
          parseFloat(document.getElementById("setup_uang_rapat")?.value) || 0,
        uang_nginep:
          parseFloat(document.getElementById("setup_uang_nginep")?.value) || 0,
        kasbon:
          parseFloat(
            document.getElementById("setup_kasbon")?.value ||
              window.currentSalaryData?.sisaKasbonDb,
          ) || 0,
        potongan_bonus_mingguan:
          parseFloat(document.getElementById("setup_potongan_absen")?.value) ||
          0,
        bypass_jam_kerja:
          document.getElementById("chk_bypass_jam_kerja")?.checked || false,
        is_gaji_jerigen:
          document.getElementById("chk_gaji_jerigen")?.checked || false,
        tarif_jerigen:
          parseFloat(document.getElementById("setup_tarif_jerigen")?.value) ||
          0,
        bonus_jerigen_manual:
          parseFloat(document.getElementById("setup_bonus_jerigen")?.value) ||
          0,
      };

      try {
        if (setupId) {
          const { error } = await window.supabase
            .from("setup_gaji")
            .update(payloadSetup)
            .eq("id", setupId);
          if (error) throw error;
        } else {
          const { data, error } = await window.supabase
            .from("setup_gaji")
            .insert([payloadSetup])
            .select()
            .single();
          if (error) throw error;
          if (data) document.getElementById("m_setup_id").value = data.id;
        }
        alert("Mantap! Parameter Setup Gaji Bulanan Berhasil Disimpan!");
        window.kalkulasiRealtimeGaji();
      } catch (err) {
        console.error("Error Detail Supabase:", err);
        alert("Gagal simpan setup! Periksa kesalahan: " + err.message);
      }
    };

    // RIWAYAT GAJI LOADER
    async function muatRiwayatGaji() {
      const container = document.getElementById("riwayat-gaji-container");
      if (!container) return;

      const start =
        document.getElementById("filter-gaji-start")?.value || awalTahun;
      const end = document.getElementById("filter-gaji-end")?.value || hariIni;
      const cacheKey = `riwayat_gaji_${start}_${end}`;
      const cachedData = localStorage.getItem(cacheKey);

      const renderHTML = (dataGaji) => {
        if (!dataGaji || dataGaji.length === 0) {
          container.innerHTML = `<p class="text-gray-500 text-sm italic py-4">Tidak ada riwayat pengeluaran gaji dari tanggal ${start} sampai ${end}.</p>`;
          return;
        }

        container.innerHTML = dataGaji
          .map((slip) => {
            const isACC =
              slip.status === "ACC" || slip.status_persetujuan === "ACC";
            // 🔥 Pastikan inisial ngambil per kata, bukan cuma potong string
            const inisial = slip.profiles?.nama
              ? slip.profiles.nama
                  .split(" ")
                  .map((n) => n[0])
                  .join("")
                  .substring(0, 2)
                  .toUpperCase()
              : "KY";

            // 🔥 Beri sentuhan warna biru agar beda dengan tabel karyawan di atas
            const avatarKomponen = slip.profiles?.foto_profil
              ? `<img src="${slip.profiles.foto_profil}" class="w-10 h-10 rounded-full object-cover border-2 border-gray-200 shadow-sm shrink-0" />`
              : `<div class="w-10 h-10 rounded-full bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-700 font-bold text-sm shadow-sm shrink-0">${inisial}</div>`;

            return `
                    <div class="p-4 border border-gray-200 rounded-xl mb-3 bg-white shadow-sm flex gap-3 items-center">
                        ${avatarKomponen}
                        <div class="flex-1">
                            <div class="flex justify-between items-center">
                                <div>
                                    <p class="font-bold text-gray-900">${slip.profiles?.nama || "Karyawan"}</p>
                                    <p class="text-xs text-gray-500">Periode: ${slip.periode || "-"}</p>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-1 rounded text-xs font-bold ${isACC ? "bg-green-100 text-green-800" : "bg-amber-100 text-amber-800"}">
                                        ${slip.status || "Menunggu"}
                                    </span>
                                    <button onclick="window.bukaEditRiwayat(${slip.id})" class="text-blue-600 hover:text-blue-800 bg-blue-50 px-2 py-1 rounded text-xs border border-blue-200 transition" title="Koreksi Slip">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </button>
                                </div>
                            </div>
                            ${
                              isACC
                                ? `
                                <div class="mt-2 text-xs space-y-1 border-t pt-2 border-dashed border-gray-300">
                                    <div class="flex justify-between"><span>Gaji Pokok:</span> <span>Rp ${Number(slip.gaji_karyawan || 0).toLocaleString("id-ID")}</span></div>
                                    <div class="flex justify-between text-gray-500"><span>Uang Lembur:</span> <span>Rp ${Number(slip.uang_lembur || 0).toLocaleString("id-ID")}</span></div>
                                    <div class="flex justify-between text-gray-500"><span>Uang Makan:</span> <span>Rp ${Number(slip.uang_makan || 0).toLocaleString("id-ID")}</span></div>
                                    <div class="flex justify-between text-green-700"><span>Total Bonus (Tepat Waktu, Mingguan, Sehat):</span> <span>+Rp ${Number((slip.bonus_tepat_waktu || 0) + (slip.bonus_mingguan || 0) + (slip.uang_kesehatan || 0)).toLocaleString("id-ID")}</span></div>
                                    ${Number(slip.kasbon || 0) > 0 ? `<div class="flex justify-between text-red-600 font-bold"><span>Potongan Kasbon:</span> <span>-Rp ${Number(slip.kasbon).toLocaleString("id-ID")}</span></div>` : ""}
                                    <div class="flex justify-between font-bold text-green-700 mt-1 pt-1 border-t">
                                        <span>Total Diterima (ACC):</span> 
                                        <span>Rp ${Number(slip.total_diterima || 0).toLocaleString("id-ID")}</span>
                                    </div>
                                </div>
                            `
                                : `
                                <div class="mt-2 text-xs text-amber-700 italic border-t pt-2 border-dashed border-gray-300">
                                    * Rincian disembunyikan sampai status disetujui (ACC).
                                </div>
                            `
                            }
                        </div>
                    </div>`;
          })
          .join("");
      };

      if (cachedData) {
        renderHTML(JSON.parse(cachedData));
      } else {
        container.innerHTML =
          '<p class="text-gray-500 text-sm italic animate-pulse">Memuat data riwayat gaji...</p>';
      }

      try {
        const { data: dataGaji, error } = await supabase
          .from("slip_gaji")
          .select(`*, profiles!inner(nama, role, foto_profil)`)
          .neq("profiles.role", "owner")
          .gte("created_at", `${start} 00:00:00`)
          .lte("created_at", `${end} 23:59:59`)
          .order("created_at", { ascending: false });
        if (error) throw error;

        localStorage.setItem(cacheKey, JSON.stringify(dataGaji));
        renderHTML(dataGaji);
      } catch (error) {
        console.error("Supabase Error:", error);
        if (!cachedData) {
          container.innerHTML = `
                    <div class="p-4 bg-red-50 text-red-700 rounded-xl text-xs">
                        <p class="font-bold">Gagal sinkronisasi data dengan server:</p>
                        <p class="italic mt-1">${error.message}</p>
                    </div>`;
        }
      }
    }
    document
      .getElementById("btn-filter-gaji")
