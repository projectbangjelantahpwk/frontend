          )
        ) {
          opsiHTML += `<option value="${item.nama_item}" selected>${item.nama_item} (Data Lama)</option>`;
        }

        const rowHTML = `
          <div class="p-2.5 rounded-lg border border-gray-200 bg-gray-50 flex flex-col sm:flex-row gap-2 transition-all">
            <div class="w-full sm:w-2/5">
              <select class="w-full border-gray-300 rounded p-1.5 text-xs outline-none focus:border-blue-500 font-bold text-gray-700 shadow-inner" onchange="window.pilihKomponenDropdownACC(${index}, this)">
                ${opsiHTML}
              </select>
            </div>
            <div class="w-full sm:w-1/4">
              <select class="w-full border rounded p-1.5 text-xs outline-none font-bold ${colorClass}" onchange="window.updateLainLainACC(${index}, 'tipe', this.value)">
                <option value="penambahan" ${isNambah ? "selected" : ""}>+ Nambah</option>
                <option value="potongan" ${!isNambah ? "selected" : ""}>- Potong</option>
              </select>
            </div>
            <div class="w-full sm:w-1/3 flex gap-2">
              <input type="number" placeholder="Nominal" class="w-full border-gray-300 rounded p-1.5 text-xs outline-none focus:border-blue-500 shadow-inner font-mono font-bold" value="${item.nominal || ""}" oninput="window.updateLainLainACC(${index}, 'nominal', this.value)" />
              <button type="button" onclick="window.hapusLainLainACC(${index})" class="bg-red-100 text-red-600 px-2.5 rounded hover:bg-red-200 transition-colors shadow-sm flex items-center justify-center">
                <i class="bi bi-trash"></i>
              </button>
            </div>
          </div>`;
        container.insertAdjacentHTML("beforeend", rowHTML);
      });
    };

    window.pilihKomponenDropdownACC = function (index, el) {
      const val = el.value;
      const master = window.pilihanMasterKomponen?.find(
        (m) => m.nama_komponen === val,
      );
      if (master) {
        window.dataLainLainACC[index].nama_item = master.nama_komponen;
        window.dataLainLainACC[index].tipe = master.tipe_default;
      } else {
        window.dataLainLainACC[index].nama_item = val;
      }
      window.renderLainLainACC();
      window.hitungTotalEditRiwayat();
    };

    window.tambahBarisLainLainACC = function () {
      window.dataLainLainACC.push({
        id: Date.now().toString(),
        nama_item: "",
        tipe: "penambahan",
        nominal: 0,
      });
      window.renderLainLainACC();
      window.hitungTotalEditRiwayat();
    };

    window.updateLainLainACC = function (index, field, value) {
      window.dataLainLainACC[index][field] =
        field === "nominal" ? parseFloat(value) || 0 : value;
      if (field === "tipe") window.renderLainLainACC();
      window.hitungTotalEditRiwayat();
    };

    window.hapusLainLainACC = function (index) {
      window.dataLainLainACC.splice(index, 1);
      window.renderLainLainACC();
      window.hitungTotalEditRiwayat();
    };
    // ==========================================
    // 🚀 FITUR FINAL: EKSEKUSI BAYAR MASSAL (BATCH APPROVAL)
    // ==========================================
    window.eksekusiBayarMassal = async function () {
      if (!window.batchSelectedIds || window.batchSelectedIds.length === 0)
        return;

      const btn = document.getElementById("btn-eksekusi-bayar");
      btn.innerText = "Memproses Massal... Jangan Tutup Browser!";
      btn.disabled = true;

      try {
        // 1. Ambil Inputan Split Payment Kasir
        const vKeu =
          parseFloat(document.getElementById("kasir_keuangan").value) || 0;
        const vGud =
          parseFloat(document.getElementById("kasir_gudang").value) || 0;
        const vOwn =
          parseFloat(document.getElementById("kasir_owner").value) || 0;
        const totalBayarKasir = vKeu + vGud + vOwn;

        // 2. Potong Kas Perusahaan Secara Global
        const { data: kasLama, error: errKas } = await window.supabase
          .from("kas_perusahaan")
          .select("*")
          .eq("id", 1)
          .single();
        if (errKas) throw errKas;

        if (
          kasLama.uang_keuangan < vKeu ||
          kasLama.uang_gudang < vGud ||
          kasLama.uang_owner < vOwn
        ) {
          throw new Error(
            "❌ Saldo di salah satu Kas Perusahaan tidak mencukupi!",
          );
        }

        await window.supabase
          .from("kas_perusahaan")
          .update({
            uang_keuangan: kasLama.uang_keuangan - vKeu,
            uang_gudang: kasLama.uang_gudang - vGud,
            uang_owner: kasLama.uang_owner - vOwn,
          })
          .eq("id", 1);

        // 3. Eksekusi Pembayaran Tiap Slip Terpilih (Looping)
        for (const slipId of window.batchSelectedIds) {
          const slip = window.currentFilteredRiwayat.find(
            (s) => String(s.id) === String(slipId),
          );
          if (!slip) continue;

          // a. Update Status Slip jadi LUNAS (ACC) dan Pecah Proporsi Kasir
          await window.supabase
            .from("slip_gaji")
            .update({
              status: "ACC",
              // Proporsikan pencatatan kas agar akurat per slip
              kas_keuangan_terpakai:
                totalBayarKasir > 0
                  ? (vKeu / totalBayarKasir) * slip.total_diterima
                  : 0,
              kas_owner_terpakai:
                totalBayarKasir > 0
                  ? (vOwn / totalBayarKasir) * slip.total_diterima
                  : 0,
              kas_gudang_terpakai:
                totalBayarKasir > 0
                  ? (vGud / totalBayarKasir) * slip.total_diterima
                  : 0,
            })
            .eq("id", slipId);

          // b. Kurangi Hutang Asli di 'setup_gaji' & Lunaskan 'Kasbon Uang Jalan'
          if (slip.kasbon > 0) {
            // Tarik data setup gaji
            const { data: setup } = await window.supabase
              .from("setup_gaji")
              .select("id, kasbon")
              .eq("user_id", slip.user_id)
              .single();

            if (setup) {
              const sisaHutangBaru = Math.max(
                0,
                (parseFloat(setup.kasbon) || 0) - slip.kasbon,
              );
              await window.supabase
                .from("setup_gaji")
                .update({ kasbon: sisaHutangBaru })
                .eq("id", setup.id);
            }

            // Sinkronisasi Kasbon Uang Jalan Dadakan biar nggak ketagih 2x
            const dEnd = new Date(slip.periode);
            const dStart = new Date(dEnd);
            dStart.setDate(dEnd.getDate() - 6); // Asumsi rentang waktu 1 minggu
            const tglMulai = dStart.toISOString().split("T")[0];

            const { data: listP } = await window.supabase
              .from("pengeluaran")
              .select("id")
              .eq("user_id", slip.user_id)
              .gte("tanggal", tglMulai)
              .lte("tanggal", slip.periode);

            if (listP && listP.length > 0) {
              const arrIds = listP.map((p) => p.id);
              await window.supabase
                .from("rincian_pengeluaran")
                .update({ keterangan_bayar: true })
                .in("pengeluaran_id", arrIds)
                .eq("nama_item", "Kasbon Uang Jalan")
                .eq("keterangan_bayar", false);
            }
          }
        }

        alert(
          `✅ SIKAT HABIS! ${window.batchSelectedIds.length} Slip Gaji (Draf) berhasil dibayar secara massal!`,
        );
        window.location.reload();
      } catch (err) {
        alert("🚨 GAGAL PROSES MASSAL:\n\n" + err.message);
        btn.innerText = "BAYAR MASSAL";
        btn.disabled = false;
      }
    };
  });
</script>
