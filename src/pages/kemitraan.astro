                } else {
                    const empty = '<p class="text-on-surface-variant text-center p-md">Tidak ada mitra langganan.</p>';
                    htmlLangMobile = empty; htmlLangTable = `<tr><td colspan="5">${empty}</td></tr>`;
                }
                document.getElementById('mitra-langganan-mobile').innerHTML = htmlLangMobile;
                document.getElementById('mitra-langganan-tbody').innerHTML = htmlLangTable;
                if (typeof renderChart === 'function') {
                    renderChart(chartDataByMonth); 
                } // Update Chart realtime!

                // C. Mitra Tidak Aktif
                const { data: nonaktif } = await window.supabase.from('mitra')
                    .select('*')
                    .eq('activated', false)
                    .order('created_at', { ascending: false });
                
                let htmlNonMobile = '';
                let htmlNonTable = '';
                if(nonaktif && nonaktif.length > 0) {
                    nonaktif.forEach(n => {
                        const dateOnly = n.created_at ? new Date(n.created_at).toLocaleDateString('id-ID') : '-';
                        htmlNonMobile += `
                        <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-md flex flex-col gap-sm shadow-sm opacity-75">
                            <div class="border-b border-outline-variant pb-sm"><p class="font-headline-md text-on-surface-variant font-semibold">${n.nama_mitra}</p></div>
                            <div class="grid grid-cols-2 gap-sm pt-xs">
                                <div><p class="font-label-sm text-on-surface-variant">No HP</p><p class="font-body-md text-on-surface-variant">${n.nomor_hp || '-'}</p></div>
                                <div><p class="font-label-sm text-on-surface-variant">Tgl Nonaktif</p><p class="font-body-md text-on-surface-variant">${dateOnly}</p></div>
                            </div>
                            <button class="mt-sm w-full h-touch-target bg-surface-container text-primary rounded-full font-label-lg border border-primary hover:bg-primary-container transition-colors flex items-center justify-center gap-xs" onclick="window.aktifkanMitra('${n.id}', '${n.nama_mitra}')">
                                <span class="material-symbols-outlined text-[20px]">person_check</span> Aktifkan Kembali
                            </button>
                        </div>`;
                        
                        htmlNonTable += `
                        <tr class="hover:bg-surface-container-low transition-colors">
                            <td class="p-md font-body-md text-on-surface-variant font-semibold">${n.nama_mitra}</td>
                            <td class="p-md font-body-md text-on-surface-variant">${n.nomor_hp || '-'}</td>
                            <td class="p-md text-center font-body-md text-on-surface-variant">${n.total_order || 0}x</td>
                            <td class="p-md font-body-md text-on-surface-variant">${dateOnly}</td>
                            <td class="p-md text-right">
                                <button class="px-md py-sm bg-surface-container text-primary rounded-full font-label-lg border border-primary hover:bg-primary-container transition-colors inline-flex items-center gap-xs h-10" onclick="window.aktifkanMitra('${n.id}', '${n.nama_mitra}')">
                                    Aktifkan Kembali
                                </button>
                            </td>
                        </tr>`;
                    });
                } else {
                    const empty = '<p class="text-on-surface-variant text-center p-md">Tidak ada mitra tidak aktif.</p>';
                    htmlNonMobile = empty; htmlNonTable = `<tr><td colspan="5">${empty}</td></tr>`;
                }
                document.getElementById('mitra-tidak-aktif-mobile').innerHTML = htmlNonMobile;
                document.getElementById('mitra-tidak-aktif-tbody').innerHTML = htmlNonTable;
            }

            // Jalankan Render CSR
            await loadDataKemitraan();

            // ==========================================
            // 4. LOGIKA MODAL & AKSI DATABASE
            // ==========================================
            window.openModal = function(id) {
                const modal = document.getElementById(id);
                modal.classList.remove('hidden'); void modal.offsetWidth;
                modal.classList.remove('opacity-0'); modal.querySelector('div').classList.remove('scale-95');
            };

            window.closeModal = function(id) {
                const modal = document.getElementById(id);
                modal.classList.add('opacity-0'); modal.querySelector('div').classList.add('scale-95');
                setTimeout(() => modal.classList.add('hidden'), 300);
            };

            // A. TAMBAH PROSPEK BARU
            // TAMBAHAN: TAMBAH LANGGANAN LANGSUNG (INPUT MANUAL)
            document.getElementById('form-tambah-langganan').addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = document.getElementById('btn-submit-tambah-langganan');
                btn.innerText = "Menyimpan..."; btn.disabled = true;

                const hp = document.getElementById('tambah_langganan_hp').value;

                try {
                    // 1. Simpan ke tabel Mitra (Langganan)
                    await window.supabase.from('mitra').insert([{
                        nama_mitra: document.getElementById('tambah_langganan_nama').value,
                        rute_jemput: document.getElementById('tambah_langganan_rute').value,
                        nomor_hp: hp,
                        alamat: document.getElementById('tambah_langganan_alamat').value,
                        link_gmaps: document.getElementById('tambah_langganan_gmaps').value, // <--- UBAH JADI GMAPS
                        total_order: 0,
                        total_transaksi: 0,
                        activated: true
                    }]);
                    
                    // 2. HAPUS otomatis dari prospek (mitra_baru) biar nyambung alurnya!
                    await window.supabase.from('mitra_baru').delete().eq('nomor_hp', hp);

                    alert('Prospek berhasil dikonversi menjadi Mitra Langganan!');
                    window.location.reload();
                } catch(err) { 
                    alert(err.message); 
                    btn.innerText = "Simpan & Konversi"; 
                    btn.disabled = false; 
                }
            });

            document.getElementById('form-tambah-prospek').addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = document.getElementById('btn-submit-prospek');
                btn.innerText = "Menyimpan..."; btn.disabled = true;

                try {
                    await window.supabase.from('mitra_baru').insert([{
                        nomor_hp: document.getElementById('input_hp_baru').value,
                        sumber_customer: document.getElementById('input_sumber_baru').value,
                        follow_up_ke: 1
                    }]);
                    alert('Prospek baru berhasil disimpan!');
                    window.location.reload();
                } catch(err) { alert(err.message); btn.innerText = "Simpan Prospek"; btn.disabled = false; }
            });

            // B. KONVERSI (PROSPEK -> LANGGANAN)
            window.openModalKonversi = function(hp) {
                document.getElementById('konversi_hp').value = hp;
                window.openModal('conversionModal');
            };

            // FUNGSI TAMBAH FOLLOW UP PROSPEK
            window.tambahFollowUp = async function(hp, currentCount) {
                // Konfirmasi singkat biar gak salah pencet
                if(!confirm(`Catat riwayat telah mem-follow up kontak ${hp} ini?`)) return;

                try {
                    const nextCount = currentCount + 1;
                    const { error } = await window.supabase.from('mitra_baru')
                        .update({ follow_up_ke: nextCount })
                        .eq('nomor_hp', hp);
                    
                    if(error) throw error;
                    
                    window.location.reload(); // Refresh halaman biar angkanya nambah
                } catch(err) {
                    alert("Gagal menambah jumlah follow up: " + err.message);
                }
            };

            // CARI DAN PASTIKAN BAGIAN INI DI SCRIPT LU SUDAH SEPERTI INI:
            // TIMPA LISTENER SUBMIT FORM KONVERSI PROSPEK
            document.getElementById('formKonversiLangganan').addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = document.getElementById('btn-submit-konversi');
                btn.innerText = "Memproses..."; btn.disabled = true;
                const hp = document.getElementById('konversi_hp').value;

                try {
                    // 1. Simpan ke tabel mitra (TANGKAP ERROR-NYA!)
                    const { error: insertError } = await window.supabase.from('mitra').insert([{
                        nama_mitra: document.getElementById('konversi_nama').value,
                        rute_jemput: document.getElementById('konversi_rute').value,
                        nomor_hp: hp,
                        alamat: document.getElementById('konversi_alamat').value,
                        link_gmaps: document.getElementById('konversi_gmaps').value,
                        total_order: 0,
                        total_transaksi: 0,
                        activated: true
                    }]);
                    
                    // JIKA INSERT GAGAL, LEMPAR ERROR DAN BERHENTI DI SINI! (Data Prospek Aman)
                    if (insertError) throw insertError;

                    // 2. Jika insert lolos, baru Hapus dari prospek
                    const { error: deleteError } = await window.supabase.from('mitra_baru').delete().eq('nomor_hp', hp);
                    
                    // JIKA DELETE GAGAL, KASIH TAU
                    if (deleteError) throw deleteError;
                    
                    alert('Berhasil! Prospek dikonversi menjadi Mitra Langganan.');
                    window.location.reload();
                } catch(err) { 
                    // Nanti bakal ketahuan aslinya error Supabase lu apa dari sini
                    alert('Gagal Konversi: ' + err.message); 
                    btn.innerText = "Simpan & Pindahkan"; 
                    btn.disabled = false; 
                }
            });

            // C. NONAKTIFKAN MITRA (LANGGANAN -> TIDAK AKTIF)
            window.nonaktifkanMitra = async function(id, nama) {
                if(!confirm(`Yakin ingin menonaktifkan ${nama}? Data akan dipindah ke tab Tidak Aktif.`)) return;
                try {
                    const { error } = await window.supabase.from('mitra')
                        .update({ activated: false })
                        .eq('id', id);
                        
                    if(error) throw error;
                    alert(`${nama} berhasil dinonaktifkan.`);
                    window.location.reload();
                } catch(err) { alert(err.message); }
            };

            // D. AKTIFKAN MITRA (TIDAK AKTIF -> LANGGANAN)
            window.aktifkanMitra = async function(id, nama) {
                if(!confirm(`Aktifkan kembali ${nama} menjadi Langganan?`)) return;
                try {
                    const { error } = await window.supabase.from('mitra')
                        .update({ activated: true })
                        .eq('id', id);

                    if(error) throw error;
                    alert(`${nama} kembali menjadi Mitra Langganan.`);
                    window.location.reload();
                } catch(err) { alert(err.message); }
            };
        });

        // ==========================================
            // FITUR PINDAH STATUS MITRA (AKTIF <-> NONAKTIF)
            // ==========================================
            window.nonaktifkanMitra = async function(id, nama) {
                if(!confirm(`Yakin ingin menonaktifkan ${nama}? Data akan dipindah ke tab Tidak Aktif.`)) return;
                try {
                    const { error } = await window.supabase.from('mitra')
                        .update({ activated: false })
                        .eq('id', id);
                    if(error) throw error;
                    alert(`${nama} berhasil dinonaktifkan.`);
                    window.location.reload();
                } catch(err) { 
                    alert('Gagal memproses: ' + err.message); 
                }
            };

            window.aktifkanMitra = async function(id, nama) {
                if(!confirm(`Aktifkan kembali ${nama} menjadi Langganan?`)) return;
                try {
                    const { error } = await window.supabase.from('mitra')
                        .update({ activated: true })
                        .eq('id', id);
                    if(error) throw error;
                    alert(`${nama} kembali menjadi Mitra Langganan.`);
                    window.location.reload();
                } catch(err) { 
                    alert('Gagal memproses: ' + err.message); 
                }
            };

        // FUNGSI BUKA MODAL EDIT MITRA & SIMPAN EDIT
            window.bukaEditMitra = function(id) {
                const mitra = window.allMitraLangganan.find(m => m.id == id);
                if(!mitra) return;
                document.getElementById('edit_mitra_id').value = mitra.id;
                document.getElementById('edit_mitra_nama').value = mitra.nama_mitra;
                document.getElementById('edit_mitra_hp').value = mitra.nomor_hp || '';
                // Ubah dari mitra.id_rutejemput menjadi mitra.rute_jemput
                document.getElementById('edit_mitra_rute').value = mitra.rute_jemput || '';
                document.getElementById('edit_mitra_alamat').value = mitra.alamat || '';
                document.getElementById('edit_mitra_gmaps').value = mitra.link_gmaps || '';
                window.openModal('modal-edit-mitra');
            };

            document.getElementById('form-edit-mitra')?.addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = document.getElementById('btn-submit-edit-mitra');
                btn.innerText = 'Menyimpan...'; btn.disabled = true;
                try {
                    const id = document.getElementById('edit_mitra_id').value;
                    const payload = {
                        nama_mitra: document.getElementById('edit_mitra_nama').value,
                        rute_jemput: document.getElementById('edit_mitra_rute').value, // <-- Pake rute_jemput
                        alamat: document.getElementById('edit_mitra_alamat').value,
                        link_gmaps: document.getElementById('edit_mitra_gmaps').value,
                    };
                    const { error } = await window.supabase.from('mitra').update(payload).eq('id', id);
                    if(error) throw error;
                    
                    alert('Data Mitra berhasil diupdate!');
                    window.location.reload();
                } catch(err) {
                    alert('Gagal update: ' + err.message);
                    btn.innerText = 'Simpan Perubahan'; btn.disabled = false;
                }
            });
            // ==========================================
            // LOGIKA LIVE TOP 5 LEADERBOARD (KOTAK UTAMA)
            // ==========================================
            const tglSkrg = new Date();
            const bulanSkrg = `${tglSkrg.getFullYear()}-${String(tglSkrg.getMonth() + 1).padStart(2, '0')}`;
            const inputPeriode = document.getElementById('input-periode-leaderboard');
            
            if(inputPeriode) {
                inputPeriode.value = bulanSkrg;
                // Begitu input bulan diganti oleh user, sistem langsung menghitung ulang secara otomatis dan real-time
                inputPeriode.addEventListener('change', () => window.generateLeaderboard());
            }

            // Wadah penyimpanan sementara hasil kalkulasi biar pindah tab/filter jadi kilat
            window.leaderboardCache = { "Juara Umum": [], "Minyak Jelantah": [], "Ampas": [], "Kriuk": [], "Tepung": [], "Spinner": [] };

            window.generateLeaderboard = async function() {
                const periode = document.getElementById('input-periode-leaderboard').value;
                if (!periode || !window.supabase) return;

                try {
                    const { data: rekapData, error } = await window.supabase
                        .from('rekap_bulanan_mitra').select('mitra_id, komoditas, total_kg, mitra(nama_mitra)').eq('periode', periode);
                    
                    if(error) throw error;

                    // Reset Cache
                    window.leaderboardCache = { "Juara Umum": [], "Minyak Jelantah": [], "Ampas": [], "Kriuk": [], "Tepung": [], "Spinner": [] };
                    const totalUmumMap = {};

                    rekapData.forEach(r => {
                        const kg = parseFloat(r.total_kg) || 0;
                        const nama = r.mitra?.nama_mitra || 'Mitra Lapangan';
                        
                        // 1. Masukkan ke Kategori Komoditas (Normalisasi nama agar masuk ke cache)
                        for (let kat in window.leaderboardCache) {
                            if (r.komoditas.toLowerCase().includes(kat.toLowerCase())) {
                                window.leaderboardCache[kat].push({ nama, kg, id: r.mitra_id });
                            }
                        }

                        // 2. Hitung Juara Umum (Total Semua Komoditas Digabung)
                        if (!totalUmumMap[r.mitra_id]) totalUmumMap[r.mitra_id] = { nama, kg: 0, id: r.mitra_id };
                        totalUmumMap[r.mitra_id].kg += kg;
                    });

                    window.leaderboardCache["Juara Umum"] = Object.values(totalUmumMap);

                    // 4. Tampilkan data default (Sesuai filter dropdown yang lagi aktif)
                    window.renderLeaderboardSesuaiFilter();

                } catch (e) { console.error("Gagal Generate Leaderboard:", e); }
            };

            // Variabel Pencatat Tab Aktif Saat Ini
            window.activeLeaderboardKat = 'Juara Umum';

            // Fungsi Mengubah Tampilan Tab & Trigger Data
            window.changeLeaderboardTab = function(btn, kategori) {
                window.activeLeaderboardKat = kategori;
                
                // Reset semua warna tab kembali ke pasif
                document.querySelectorAll('.leaderboard-tab-btn').forEach(b => {
                    b.classList.remove('bg-white', 'shadow-sm', 'text-primary', 'font-bold');
                    b.classList.add('text-on-surface-variant', 'font-medium');
                });
                
                // Beri highlight putih menyala di tab yang diklik
                btn.classList.add('bg-white', 'shadow-sm', 'text-primary', 'font-bold');
                btn.classList.remove('text-on-surface-variant', 'font-medium');
                
                // Render ulang kartunya sesuai kategori baru
                window.renderLeaderboardSesuaiFilter();
            };

            // Fungsi Merender Kartu Grid ke Layar
            window.renderLeaderboardSesuaiFilter = function() {
                const kategori = window.activeLeaderboardKat; // Ambil dari variabel Tab
                const container = document.getElementById('leaderboard-live-list');
                if (!container) return;

                // Sortir kargo terbesar, ambil Top 5
                const data = (window.leaderboardCache[kategori] || []).sort((a, b) => b.kg - a.kg).slice(0, 5);

                if (data.length === 0) {
                    container.innerHTML = `<p class="text-xs text-on-surface-variant italic text-center py-10 col-span-full border-2 border-dashed border-outline-variant rounded-xl">Belum ada penyetor di kategori ${kategori} pada bulan ini.</p>`;
                    return;
                }

                container.innerHTML = data.map((m, i) => {
                    let bgMedali = 'bg-surface-variant text-on-surface-variant border-outline-variant';
                    let iconMedali = '';
                    if(i === 0) { bgMedali = 'bg-yellow-500 text-white font-bold border-yellow-600'; iconMedali = '🥇 '; }
                    else if(i === 1) { bgMedali = 'bg-slate-400 text-white font-bold border-slate-500'; iconMedali = '🥈 '; }
                    else if(i === 2) { bgMedali = 'bg-amber-700 text-white font-bold border-amber-800'; iconMedali = '🥉 '; }

                    return `
                    <div class="flex items-center justify-between bg-surface-container-lowest p-4 rounded-2xl border border-outline-variant shadow-xs hover:border-primary/50 transition-all duration-200 animate-in fade-in slide-in-from-bottom-2">
                        <div class="flex items-center gap-3 min-w-0">
                            <span class="w-8 h-8 flex items-center justify-center rounded-full text-xs ${bgMedali} shrink-0 shadow-xs">#${i + 1}</span>
                            <div class="truncate">
                                <p class="text-sm font-bold text-on-surface truncate leading-tight">${iconMedali}${m.nama}</p>
                                <p class="text-[10px] text-on-surface-variant font-bold uppercase tracking-wider mt-0.5">${kategori}</p>
                            </div>
                        </div>
                        <div class="text-right shrink-0 ml-2">
                            <span class="font-mono text-xs font-bold text-green-700 bg-green-50 border border-green-100 px-3 py-1.5 rounded-xl shadow-sm block">${m.kg.toFixed(1)} Kg</span>
                        </div>
                    </div>`;
                }).join('');
                // Filter ulang kartu-kartu juara jika kotak pencarian sedang terisi
                if (typeof window.applySearchMitra === 'function') {
                    setTimeout(window.applySearchMitra, 50);
                }
            };

            // Fungsi Kurir: Menghapus data ranking lama di bulan itu, lalu menyuntikkan ranking Top 5 yang baru
            window.syncLeaderboardToDB = async function(periode) {
                const payload = [];
                for (let kat in window.leaderboardCache) {
                    const top5 = window.leaderboardCache[kat].sort((a, b) => b.kg - a.kg).slice(0, 5);
                    top5.forEach((m, i) => {
                        payload.push({ periode, mitra_id: m.id, tingkat: i+1, jenisnya: kat, total_kg: m.kg });
                    });
                }
                
                // Bersihkan dulu data bulan tersebut biar gak numpuk/double
                await window.supabase.from('top_leaderboard').delete().eq('periode', periode);
                // Tembak data terbarunya
                if (payload.length > 0) await window.supabase.from('top_leaderboard').insert(payload);
            };

            // Pemicu Render Otomatis Saat Pertama Kali Halaman Terbuka
            if(inputPeriode) window.generateLeaderboard();
    </script>
</Layout>