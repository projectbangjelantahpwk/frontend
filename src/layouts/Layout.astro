  <script>
    import { supabase } from "../lib/supabase.js";

    // ==========================================
    // 🔥 LOGIKA REALTIME NOTIFICATIONS (BARU)
    // ==========================================
    function initRealtimeNotifications() {
      if (!window.supabase) {
        console.warn("⏳ Waiting for Supabase...");
        setTimeout(() => initRealtimeNotifications(), 500);
        return;
      }

      console.log("🚀 Initializing Realtime Notifications...");

      let retryCount = 0;
      const MAX_RETRIES = 3;
      let channel = null;

      function setupChannel() {
        try {
          if (channel) {
            console.log("🧹 Cleaning old channel...");
            channel.unsubscribe();
            channel = null;
          }

          console.log("🔌 Setting up WebSocket channel...");
          channel = window.supabase.channel("dashboard-notifications", {
            config: {
              broadcast: { self: true },
              presence: { key: "notifications" },
            },
          });

          // ✅ TAMBAH SEMUA LISTENERS DULU (SEBELUM SUBSCRIBE!)

          // 1️⃣ TRANSAKSI
          channel.on(
            "postgres_changes",
            { event: "UPDATE", schema: "public", table: "transaksi" },
            async (payload) => {
              try {
                console.log("📡 [TRANSAKSI] Update:", payload);
                const newData = payload.new;
                const oldData = payload.old || {};

                if (
                  newData.status === "Selesai" &&
                  oldData.status !== "Selesai"
                ) {
                  const { data: relasi } = await window.supabase
                    .from("transaksi")
                    .select("metode_bayar, penjemputan(mitra(nama_mitra))")
                    .eq("id", newData.id)
                    .single();

                  const namaMitra =
                    relasi?.penjemputan?.mitra?.nama_mitra || "Mitra";
                  const metode = relasi?.metode_bayar || "Kas/Transfer";

                  window.addNotifToList(
                    "✅ Pembayaran Selesai!",
                    `Setoran dari ${namaMitra} - ${metode}`,
                  );
                }
              } catch (error) {
                console.error("❌ Error EVENT 1:", error);
              }
            },
          );

          window.eksekusiTransferKas = async function (e) {
            e.preventDefault();
            if (!window.supabase) return;

            // 🛡️ ANTI-CRASH & ANTI-DUPLIKAT ID
            // Sistem akan mencari kotak isian yang benar-benar diketik angkanya
            let inputNominal = null;
            let selSumber = null;
            let selTujuan = null;

            document.querySelectorAll("#tf_nominal").forEach((el) => {
              if (el.value) inputNominal = el;
            });
            document.querySelectorAll("#tf_sumber").forEach((el) => {
              if (el.offsetWidth > 0) selSumber = el;
            });
            document.querySelectorAll("#tf_tujuan").forEach((el) => {
              if (el.offsetWidth > 0) selTujuan = el;
            });

            // Fallback kalau cuma ada 1 di layar
            if (!inputNominal)
              inputNominal = document.getElementById("tf_nominal");
            if (!selSumber) selSumber = document.getElementById("tf_sumber");
            if (!selTujuan) selTujuan = document.getElementById("tf_tujuan");

            const nominal = parseFloat(inputNominal.value) || 0;
            const sumber = selSumber.value;
            const tujuan = selTujuan.value;

            const labelSumber = selSumber.options[selSumber.selectedIndex].text;
            const labelTujuan = selTujuan.options[selTujuan.selectedIndex].text;

            if (sumber === tujuan)
              return alert("❌ Dompet asal dan tujuan tidak boleh sama!");
            if (nominal <= 0)
              return alert(
                "❌ Nominal transfer harus lebih dari Rp 0!\n(Pastikan ketik angka tanpa titik, contoh: 500000)",
              );

            if (
              !confirm(
                `Yakin ingin memindahkan dana sebesar Rp ${nominal.toLocaleString("id-ID")} dari ${labelSumber} ke ${labelTujuan}?`,
              )
            )
              return;

            const btn =
              e.target.querySelector('button[type="submit"]') ||
              document.getElementById("btn-submit-tf");
            const textLama = btn.innerHTML;
            btn.innerHTML =
              '<i class="bi bi-hourglass-split"></i> MEMPROSES...';
            btn.disabled = true;

            try {
              // 1. Tarik saldo terkini dari database
              const { data: kasLama, error: errCek } = await window.supabase
                .from("kas_perusahaan")
                .select("*")
                .eq("id", 1)
                .single();
              if (errCek) throw errCek;

              const saldoSumber = parseFloat(kasLama[sumber]) || 0;
              const saldoTujuan = parseFloat(kasLama[tujuan]) || 0;

              // 2. Sensor Anti-Minus
              if (saldoSumber < nominal) {
                throw new Error(
                  `Saldo [${labelSumber}] tidak mencukupi!\nSisa Saldo: Rp ${saldoSumber.toLocaleString("id-ID")}`,
                );
              }

              // 3. Kalkulasi Otomatis Saldo Kas
              const payloadKas = {};
              payloadKas[sumber] = saldoSumber - nominal;
              payloadKas[tujuan] = saldoTujuan + nominal;
              payloadKas.updated_at = new Date().toISOString();

              // 4. Eksekusi Update Kas Perusahaan
              const { error: errUpdate } = await window.supabase
                .from("kas_perusahaan")
                .update(payloadKas)
                .eq("id", 1);
              if (errUpdate) throw errUpdate;

              // 5. Catat ke Tabel Riwayat
              const {
                data: { user },
              } = await window.supabase.auth.getUser();
              await window.supabase.from("riwayat_transfer_kas").insert({
                user_id: user?.id,
                sumber: labelSumber,
                tujuan: labelTujuan,
                nominal: nominal,
              });

              alert(
                `✅ BERHASIL!\n\nDana Rp ${nominal.toLocaleString("id-ID")} telah sukses dipindahkan.`,
              );

              // 🔥 Reset isian agar bisa transfer lagi
              inputNominal.value = "";

              // 🔥 Refresh tampilan dan riwayat live
              if (typeof window.loadRiwayatTransfer === "function")
                await window.loadRiwayatTransfer();
              if (typeof window.loadDataKas === "function")
                window.loadDataKas();
            } catch (err) {
              alert("❌ GAGAL TRANSFER: " + err.message);
            } finally {
              btn.innerHTML = textLama;
              btn.disabled = false;
            }
          };

          // 2️⃣ PRESENSI
          channel.on(
            "postgres_changes",
            { event: "UPDATE", schema: "public", table: "presensi" },
            async (payload) => {
              try {
                const newData = payload.new;
                const oldData = payload.old || {};

                const isWaktuPulangDiisi =
                  newData.waktu_pulang && !oldData.waktu_pulang;
                const statusAlerts = [
                  "Pulang",
                  "Izin",
                  "Izin Pulang Cepat",
                  "Sakit",
                ];
                const isStatusTibaTrigger =
                  statusAlerts.includes(newData.status_tiba) &&
                  newData.status_tiba !== oldData.status_tiba;
                const isStatusPulangTrigger =
                  statusAlerts.includes(newData.status_pulang) &&
                  newData.status_pulang !== oldData.status_pulang;

                if (
                  isWaktuPulangDiisi ||
                  isStatusTibaTrigger ||
                  isStatusPulangTrigger
                ) {
                  const { data: user } = await window.supabase
                    .from("profiles")
                    .select("nama")
                    .eq("id", newData.user_id)
                    .single();
                  const namaKaryawan = user?.nama || "Karyawan";
                  let title = "",
                    pesan = "";

                  if (newData.status_tiba === "Sakit") {
                    title = "⚠️ Sakit";
                    pesan = `${namaKaryawan} sakit`;
                  } else if (newData.status_pulang === "Pulang") {
                    title = "👋 Pulang";
                    pesan = `${namaKaryawan} pulang`;
                  }

                  if (pesan) window.addNotifToList(title, pesan);
                }
              } catch (error) {
                console.error("❌ Error EVENT 2:", error);
              }
            },
          );

          // 3️⃣ PENGELUARAN
          channel.on(
            "postgres_changes",
            { event: "INSERT", schema: "public", table: "pengeluaran" },
            (payload) => {
              window.addNotifToList(
                "💸 Pengeluaran",
                `Rp ${Number(payload.new.total_harian).toLocaleString("id-ID")}`,
              );
            },
          );

          // 4️⃣ PENJUALAN OLAHAN
          channel.on(
            "postgres_changes",
            { event: "INSERT", schema: "public", table: "penjualan_olahan" },
            (payload) => {
              const pembeli = payload.new.pembeli || "Distributor";
              window.addNotifToList("📦 Penjualan", `Ke ${pembeli}`);
            },
          );

          // 5️⃣ GUDANG MASUK
          channel.on(
            "postgres_changes",
            { event: "INSERT", schema: "public", table: "gudang_mutasi" },
            (payload) => {
              if (payload.new.jenis_mutasi === "Masuk") {
                const komoditas =
                  payload.new.komoditas_id?.replace(/_/g, " ") || "Barang";
                window.addNotifToList(
                  "🚛 Gudang Masuk",
                  `${komoditas} +${payload.new.jumlah}kg`,
                );
              }
            },
          );

          // ✅ BARU SUBSCRIBE SETELAH SEMUA LISTENER DITAMBAH!
          channel.subscribe((status) => {
            if (status === "SUBSCRIBED") {
              console.log("✅ WebSocket Connected!");
              retryCount = 0;
            } else if (status === "CHANNEL_ERROR") {
              console.warn(`⚠️ Error, retry ${retryCount}/${MAX_RETRIES}`);
              if (retryCount < MAX_RETRIES) {
                retryCount++;
                setTimeout(() => setupChannel(), 5000);
              }
            }
          });
        } catch (error) {
          console.error("❌ Fatal error:", error);
          if (retryCount < MAX_RETRIES) {
            retryCount++;
            setTimeout(() => setupChannel(), 5000);
          }
        }
      }

      // Setup saat session ready
      window.supabase.auth.getSession().then(({ data: { session } }) => {
        if (session) {
          console.log("✅ Session ready, starting WebSocket");
          setTimeout(() => setupChannel(), 1000);
        }
      });
    }

    function runWhenReady(callback) {
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", callback, { once: true });
        return;
      }
      callback();
    }

    // 👇 TARUH KODE STERILNYA TEPAT DI SINI (DI LUAR FUNGSI) 👇
    //document.addEventListener('contextmenu', function(e) {
    //    e.preventDefault();
    //}, false);
    //
    //document.addEventListener('keydown', function(e) {
    //    if (e.key === 'F12' || (e.ctrlKey && e.shiftKey && e.key === 'I')) {
    //        e.preventDefault();
    //    }
    //});

    // ==========================================
    // 🔔 LOGIKA TAMPILAN (UI) NOTIFIKASI
    // ==========================================
    function initNotifUI() {
      const notifBadge = document.getElementById("notif-badge");
      const notifBtn = document.getElementById("notif-btn");
      const notifDropdown = document.getElementById("notif-dropdown");
      const notifList = document.getElementById("notif-list");
      const clearNotif = document.getElementById("clear-notif");

      // Toggle Buka/Tutup Dropdown
      notifBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        notifBadge?.classList.add("hidden");
        notifDropdown?.classList.toggle("hidden");
      });

      // Tutup jika klik di luar kotak
      window.addEventListener("click", (e) => {
        if (
          !notifBtn?.contains(e.target) &&
          !notifDropdown?.contains(e.target)
        ) {
          notifDropdown?.classList.add("hidden");
        }
      });

      // Tombol bersihkan notifikasi
      clearNotif?.addEventListener("click", () => {
        if (notifList) {
          notifList.innerHTML =
            '<p id="empty-notif" class="text-xs text-on-surface-variant text-center py-4">Belum ada notifikasi baru.</p>';
        }
      });
    }

    // Fungsi global agar bisa dipanggil oleh FCM saat pesan masuk
    window.addNotifToList = function (title, body) {
      const notifList = document.getElementById("notif-list");
      const emptyMsg = document.getElementById("empty-notif");
      if (emptyMsg) emptyMsg.remove();

      const waktu = new Date().toLocaleTimeString("id-ID", {
        hour: "2-digit",
        minute: "2-digit",
      });
      const notifItem = document.createElement("div");
      notifItem.className =
        "p-3 bg-surface-container-low hover:bg-surface-container rounded-lg cursor-pointer transition-colors border-l-4 border-primary mb-1";
      notifItem.innerHTML = `
        <p class="font-bold text-sm text-on-surface">${title}</p>
        <p class="text-xs text-on-surface-variant mt-1">${body}</p>
        <p class="text-[10px] text-outline mt-2 text-right">${waktu}</p>
    `;
      notifList?.prepend(notifItem);
    };

    function initSidebar() {
      const hamburgerBtn = document.getElementById("hamburger-btn");
      const sidebar = document.getElementById("sidebar");
      const closeBtn = document.getElementById("close-sidebar");
      const overlay = document.getElementById("sidebar-overlay");
      const navLinks = document.querySelectorAll("[data-nav]");
      const currentPath = window.location.pathname;

      function openSidebar() {
        if (!sidebar || !overlay) return;
        sidebar.classList.add("active");
        overlay.classList.add("active");
        document.body.style.overflow = "hidden";
      }

      function closeSidebar() {
        if (!sidebar || !overlay) return;
        sidebar.classList.remove("active");
        overlay.classList.remove("active");
        document.body.style.overflow = "";
      }

      // @ts-ignore
      window.closeAppSidebar = closeSidebar;

