    // ==========================================
    // CRUD REKENING
    // ==========================================
    // Insert Form
    document
      .getElementById("form-tambah-rekening")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = document.getElementById("btn-submit-rekening");
        const mitraId = document.getElementById(
          "input_mitra_id_rekening",
        ).value;

        if (!mitraId)
          return alert(
            "Mitra tidak valid! Pastikan pilih dari daftar Dropdown.",
          );

        btn.innerText = "Menyimpan...";
        btn.disabled = true;
        try {
          const payload = {
            mitra_id: mitraId,
            nama_bank: document.getElementById("input_bank_rekening").value,
            no_rek: document.getElementById("input_norek_rekening").value,
            atas_nama: document.getElementById("input_an_rekening").value,
          };

          console.log("🔍 [DETEKTIF] Payload yang mau dikirim:", payload);

          // Tambahkan .select() di akhir agar Supabase WAJIB mengembalikan respon
          const { data, error } = await window.supabase
            .from("rek_mitra")
            .insert([payload])
            .select();

          // 1. Tangkap error bawaan Supabase
          if (error) {
            console.error("🚨 [DETEKTIF] Error dari Supabase:", error);
            throw error;
          }

          // 2. Tangkap silent fail (Biasanya karena RLS memblokir insert)
          if (!data || data.length === 0) {
            console.error(
              "🚨 [DETEKTIF] Data ditolak secara diam-diam oleh RLS!",
            );
            throw new Error(
              "Data ditolak oleh database (Silent Fail). Cek kebijakan RLS (Row Level Security) di tabel rek_mitra!",
            );
          }

          console.log("✅ [DETEKTIF] Sukses! Data berhasil masuk:", data);
          alert("Rekening berhasil ditambah!");
          window.location.reload();
        } catch (err) {
          console.error("🛑 [DETEKTIF] ERROR TERTANGKAP:", err);
          // Tampilkan pesan error sejelas-jelasnya di popup
          alert("Gagal: " + (err.message || JSON.stringify(err)));

          btn.innerText = "Simpan";
          btn.disabled = false;
        }
      });

    // Buka Edit
    window.bukaEditRekening = function (id) {
      const rek = window.allRekening.find((r) => r.id == id);
      if (!rek) return;

      document.getElementById("edit_rekening_id").value = rek.id;
      document.getElementById("edit_mitra_nama_rekening").value =
        rek.mitra?.nama_mitra || "";
      document.getElementById("edit_bank_rekening").value = rek.nama_bank;
      document.getElementById("edit_norek_rekening").value = rek.no_rek;
      document.getElementById("edit_an_rekening").value = rek.atas_nama;

      window.openModal("modal-edit-rekening");
    };

    // Update Form
    document
      .getElementById("form-edit-rekening")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = document.getElementById("btn-submit-edit-rekening");
        btn.innerText = "Updating...";
        btn.disabled = true;

        try {
          const id = document.getElementById("edit_rekening_id").value;
          const payload = {
            nama_bank: document.getElementById("edit_bank_rekening").value,
            no_rek: document.getElementById("edit_norek_rekening").value,
            atas_nama: document.getElementById("edit_an_rekening").value,
          };
          const { error } = await window.supabase
            .from("rek_mitra")
            .update(payload)
            .eq("id", id);
          if (error) throw error;

          alert("Berhasil diupdate!");
          window.location.reload();
        } catch (err) {
          alert("Gagal: " + err.message);
          btn.innerText = "Update";
          btn.disabled = false;
        }
      });

    // Delete Logic
    window.hapusRekening = async function (id, nama) {
      if (!confirm(`Hapus rekening untuk mitra ${nama}?`)) return;
      try {
        const { error } = await window.supabase
          .from("rek_mitra")
          .delete()
          .eq("id", id);
        if (error) throw error;
        alert("Terhapus!");
        window.location.reload();
      } catch (err) {
        alert(err.message);
      }
    };

    // Sinkronin Search Global dengan Dropdown Filter Bank
    const oldApplySearchMitra = window.applySearchMitra;
    window.applySearchMitra = function () {
      oldApplySearchMitra(); // Jalankan search lama

      const isTabRekening = document
        .getElementById("tab-rekening-mitra")
        ?.classList.contains("block");
      if (isTabRekening) {
        const keyword = (
          document.getElementById("input-search-mitra")?.value || ""
        )
          .toLowerCase()
          .trim();
        const filterBank =
          document.getElementById("filter-bank")?.value.toLowerCase() || "";
        const items = document.querySelectorAll(".rekening-item");

        items.forEach((item) => {
          const itemBank = item.getAttribute("data-bank") || "";
          const text = item.textContent.toLowerCase();

          let match = true;
          if (filterBank && itemBank !== filterBank) match = false;
          if (keyword && !text.includes(keyword)) match = false;

          item.style.display = match ? "" : "none";
        });
      }
    };

    // 👇 PASTE KODE BARU DI SINI (MENGGANTIKAN KODE YANG DIHAPUS DI ATAS) 👇
    // ==========================================
    // LOGIKA DROPDOWN FILTER & SEARCH
    // ==========================================
    window.toggleDropdownFilter = function (e) {
      if (e) e.preventDefault();
      document
        .getElementById("dropdown-filter-mitra")
        ?.classList.toggle("hidden");
    };

    document.addEventListener("click", function (event) {
      const dropdown = document.getElementById("dropdown-filter-mitra");
      const isClickInsideBtn = event.target.closest(
        'button[onclick*="toggleDropdownFilter"]',
      );
      if (!isClickInsideBtn && dropdown && !dropdown.contains(event.target)) {
        dropdown.classList.add("hidden");
      }
    });

    window.resetFilterMitra = function (e) {
      if (e) e.preventDefault();
      const elRute = document.getElementById("filter-rute-mitra");
      const elSumber = document.getElementById("filter-sumber-mitra");
      const elJenis = document.getElementById("filter-jenis-mitra");

      if (elRute) elRute.value = "";
      if (elSumber) elSumber.value = "";
      if (elJenis) elJenis.value = "";

      window.applySearchMitra();
    };

    window.applySearchMitra = function () {
      const keyword = (
        document.getElementById("input-search-mitra")?.value || ""
      )
        .toLowerCase()
        .trim();

      // Ambil nilai dari dropdown
      const filterRute = (
        document.getElementById("filter-rute-mitra")?.value || ""
      ).toLowerCase();
      const filterSumber = (
        document.getElementById("filter-sumber-mitra")?.value || ""
      ).toLowerCase();
      const filterJenis = (
        document.getElementById("filter-jenis-mitra")?.value || ""
      ).toLowerCase();

      const filterBank =
        document.getElementById("filter-bank")?.value.toLowerCase() || "";

      // 1. Jika Sedang Buka Tab Rekening (Beda filter)
      const isTabRekening = document
        .getElementById("tab-rekening-mitra")
        ?.classList.contains("block");
      if (isTabRekening) {
        const rekItems = document.querySelectorAll(".rekening-item");
        rekItems.forEach((item) => {
          const itemBank = item.getAttribute("data-bank") || "";
          const text = item.textContent.toLowerCase();
          let match = true;
          if (filterBank && itemBank !== filterBank) match = false;
          if (keyword && !text.includes(keyword)) match = false;
          item.style.display = match ? "" : "none";
        });
        return;
      }

      // 2. Filter Mitra Langganan & Tidak Aktif
      const items = document.querySelectorAll(".mitra-item");
      items.forEach((item) => {
        // Abaikan baris placeholder "Memuat data..."
        if (
          item.querySelector("td[colspan]") ||
          item.classList.contains("col-span-full")
        )
          return;

        const text = item.textContent.toLowerCase();
        const itemRute = (item.getAttribute("data-rute") || "").toLowerCase();
        const itemSumber = (
          item.getAttribute("data-sumber") || ""
        ).toLowerCase();
        const itemJenis = (item.getAttribute("data-jenis") || "").toLowerCase();

        let match = true;

        // Cek kecocokan (Jika filter tidak kosong, cek apakah sama dengan data item)
        if (keyword && !text.includes(keyword)) match = false;
        if (filterRute && itemRute !== filterRute) match = false;
        if (filterSumber && itemSumber !== filterSumber) match = false;
        if (filterJenis && itemJenis !== filterJenis) match = false;

        item.style.display = match ? "" : "none";
      });
    };
    // 👆 ------------------------------------------------------------- 👆

    // Trigger fetch rekening (Ini biarin aja di bawahnya)
    document.addEventListener("DOMContentLoaded", () => {
      setTimeout(loadDataRekening, 1000);
    });
  </script>
</Layout>
