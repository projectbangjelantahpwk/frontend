---
import GeneralLayout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import 'bootstrap-icons/font/bootstrap-icons.css';

// 1. Fetch Riwayat Performa Iklan dari Supabase
const { data: performaHistory } = await supabase
  .from('performa_iklan')
  .select('*')
  .order('created_at', { ascending: false });

// 2. Fetch Riwayat Pengeluaran Iklan dari Supabase
const { data: spendingHistory } = await supabase
  .from('pengeluaran_iklan')
  .select('*')
  .order('created_at', { ascending: false });

const platforms = [
  { label: 'TikTok', value: 'TikTok' },
  { label: 'Facebook Reels', value: 'Facebook' },
  { label: 'YouTube Shorts', value: 'YouTube' },
  { label: 'Instagram', value: 'Instagram' }
];

const adPlatforms = [
  { label: 'TikTok Ads', value: 'TikTok Ads' },
  { label: 'Meta Ads (FB/IG)', value: 'Meta Ads (FB/IG)' },
  { label: 'Google Ads', value: 'Google Ads' }
];

const tabs = [
  { id: 'performa', label: 'Input Performa Iklan', icon: 'bar-chart' },
  { id: 'pengeluaran', label: 'Pengeluaran Biaya Ads', icon: 'credit-card' }
];

// Helper UI Warna Platform
const getStatusColor = (platform) => {
    if(platform.includes('TikTok')) return 'bg-gray-100 text-gray-800';
    if(platform.includes('Instagram')) return 'bg-pink-100 text-pink-700';
    if(platform.includes('Facebook')) return 'bg-blue-100 text-blue-700';
    if(platform.includes('YouTube')) return 'bg-red-100 text-red-700';
    return 'bg-green-100 text-green-700';
}
const getPlatformIcon = (platform) => {
    if(platform.includes('TikTok')) return 'tiktok';
    if(platform.includes('Instagram')) return 'instagram';
    if(platform.includes('Facebook')) return 'facebook';
    if(platform.includes('YouTube')) return 'youtube';
    return 'Megaphone';
}
---

<GeneralLayout title="Periklanan - Manajemen Bang Jelantah">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Manajemen Periklanan & Promosi</h1>
    <p class="text-gray-600">Kelola performa iklan digital dan pengeluaran promosi secara terpusat.</p>
  </div>

  <div class="mb-6 border-b border-gray-200">
    <div class="flex gap-8">
      {tabs.map((tab) => (
        <button
          class={`tab-button px-4 py-3 font-medium transition border-b-2 flex items-center gap-2 ${
            tab.id === 'performa'
              ? 'border-green-700 text-green-700'
              : 'border-transparent text-gray-600 hover:text-gray-900'
          }`}
          data-tab={tab.id}
        >
          <i class={`bi bi-${tab.icon}`}></i>
          {tab.label}
        </button>
      ))}
    </div>
  </div>

  <div>
    <div id="performa-tab" class="tab-content block">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-1 bg-white rounded-lg border border-gray-200 p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-6">Data Metrik Performa</h3>

          <form id="performaForm" class="space-y-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Platform Iklan</label>
              <select id="p_platform" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-700 focus:ring-2 focus:ring-green-100">
                {platforms.map((p) => <option value={p.value}>{p.label}</option>)}
              </select>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Waktu Tayang</label>
              <input type="date" id="p_tanggal" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-700 focus:ring-2 focus:ring-green-100" required />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2"><i class="bi bi-eye"></i> Jangkauan / Reach</label>
              <div class="flex gap-2">
                <input type="number" id="reachInput" placeholder="Masukkan jumlah" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-700 focus:ring-2 focus:ring-green-100" required />
                <span class="flex items-center px-3 py-2 bg-gray-100 rounded-lg text-sm text-gray-600">Orang</span>
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2"><i class="bi bi-chat-bubble"></i> Jumlah Tanya / Leads</label>
              <input type="number" id="leadsInput" placeholder="Masukkan jumlah" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-700 focus:ring-2 focus:ring-green-100" required />
            </div>

            <div class="bg-gray-50 p-4 rounded-lg flex justify-between items-center">
              <p class="text-sm text-gray-600 mb-1">Conversion Rate:</p>
              <p id="conversionRate" class="text-2xl font-bold text-gray-900">0%</p>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Bukti Screenshot</label>
              <div id="dropZone" class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center cursor-pointer hover:border-green-700 hover:bg-green-50 transition">
                <i class="bi bi-cloud-upload text-3xl text-gray-400 mb-2"></i>
                <p class="text-sm text-gray-600 mb-1">Tarik & Lepas Gambar</p>
                <p class="text-xs text-gray-500">atau klik untuk memilih file (JPG, PNG)</p>
                <input type="file" id="fileInput" accept="image/jpeg,image/png" class="hidden" />
              </div>
              <p id="fileName" class="text-sm text-gray-600 mt-2"></p>
            </div>

            <button type="submit" id="btnSubmitPerforma" class="w-full flex items-center justify-center gap-2 px-6 py-3 bg-green-700 text-white rounded-lg hover:bg-green-800 transition font-bold active:scale-95">
              <i class="bi bi-cloud-arrow-up"></i> Simpan Performa
            </button>
          </form>
        </div>

        <div class="lg:col-span-2 bg-white rounded-lg border border-gray-200 p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-6">Riwayat Performa Tersimpan</h3>
          <div class="space-y-4 max-h-[700px] overflow-y-auto pr-2">
            {performaHistory?.map((item) => {
              const cvr = item.reach > 0 ? ((item.leads / item.reach) * 100).toFixed(1) : 0;
              return (
              <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition">
                <div class="flex items-start justify-between mb-4">
                  <div class="flex items-center gap-4">
                    <div class={`w-12 h-12 rounded-lg ${getStatusColor(item.platform)} flex items-center justify-center text-xl`}>
                      <i class={`bi bi-${getPlatformIcon(item.platform)}`}></i>
                    </div>
                    <div>
                      <h4 class="font-bold text-gray-900">{item.platform}</h4>
                      <p class="text-sm text-gray-600">{item.waktu_tayang}</p>
                    </div>
                  </div>
                  {item.bukti_url && (
                    <a href={item.bukti_url} target="_blank" class="text-xs font-bold text-blue-600 hover:underline">
                      <i class="bi bi-image"></i> Lihat Bukti
                    </a>
                  )}
                </div>

                <div class="grid grid-cols-3 gap-4">
                  <div class="bg-gray-50 rounded-lg p-3">
                    <p class="text-xs text-gray-600 mb-1">Reach</p>
                    <p class="text-lg font-bold text-gray-900">{Number(item.reach).toLocaleString('id-ID')}</p>
                  </div>
                  <div class="bg-gray-50 rounded-lg p-3">
                    <p class="text-xs text-gray-600 mb-1">Leads</p>
                    <p class="text-lg font-bold text-gray-900">{Number(item.leads).toLocaleString('id-ID')}</p>
                  </div>
                  <div class="bg-green-50 rounded-lg p-3 border border-green-100">
                    <p class="text-xs text-green-700 mb-1 font-bold">Conversion Rate</p>
                    <p class="text-lg font-bold text-green-700">{cvr}%</p>
                  </div>
                </div>
              </div>
            )})}
            {performaHistory?.length === 0 && <p class="text-center text-gray-500 py-4">Belum ada riwayat performa.</p>}
          </div>
        </div>
      </div>
    </div>

    <div id="pengeluaran-tab" class="tab-content hidden">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-1 bg-white rounded-lg border border-gray-200 p-6 h-fit">
          <h3 class="text-lg font-bold text-gray-900 mb-6">Input Pengeluaran Iklan</h3>

          <form id="pengeluaranForm" class="space-y-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Bulan & Tahun (Periode)</label>
              <input type="month" id="ads_periode" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-700 focus:ring-2 focus:ring-green-100" required />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Platform Iklan</label>
              <select id="ads_platform" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-700 focus:ring-2 focus:ring-green-100">
                {adPlatforms.map((p) => <option value={p.value}>{p.label}</option>)}
              </select>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Total Biaya (Rp)</label>
              <div class="flex gap-2">
                <span class="flex items-center px-4 py-2 bg-gray-100 rounded-lg text-sm font-bold text-gray-600">Rp</span>
                <input type="number" id="biayaInput" placeholder="Masukkan nominal" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-700 focus:ring-2 focus:ring-green-100 font-bold" required />
              </div>
            </div>

            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
              <div class="flex gap-3">
                <i class="bi bi-info-circle text-blue-600 flex-shrink-0 mt-0.5"></i>
                <p class="text-sm text-blue-700">
                  Data pengeluaran biaya Ads ini akan tersimpan ke dalam database dan dapat diaudit secara berkala.
                </p>
              </div>
            </div>

            <button type="submit" id="btnSubmitPengeluaran" class="w-full flex items-center justify-center gap-2 px-6 py-3 bg-green-700 text-white rounded-lg hover:bg-green-800 transition font-bold active:scale-95">
              <i class="bi bi-credit-card"></i> Input Biaya Ads
            </button>
          </form>
        </div>

        <div class="lg:col-span-2 bg-white rounded-lg border border-gray-200 p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-6">Riwayat Pengeluaran Ads</h3>

          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="bg-gray-50 border-b border-gray-200">
                  <th class="px-6 py-4 text-left text-sm font-bold text-gray-900">Periode</th>
                  <th class="px-6 py-4 text-left text-sm font-bold text-gray-900">Platform</th>
                  <th class="px-6 py-4 text-left text-sm font-bold text-gray-900 text-right">Total Biaya</th>
                  <th class="px-6 py-4 text-left text-sm font-bold text-gray-900 text-center">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {spendingHistory?.map((item) => (
                  <tr class="hover:bg-gray-50 transition">
                    <td class="px-6 py-4 text-sm font-bold text-gray-900">{item.periode}</td>
                    <td class="px-6 py-4 text-sm text-gray-600">{item.platform}</td>
                    <td class="px-6 py-4 text-sm font-bold text-red-600 text-right">Rp {Number(item.biaya).toLocaleString('id-ID')}</td>
                    <td class="px-6 py-4 text-sm text-center">
                      <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700">
                        <i class="bi bi-check-circle-fill"></i> {item.status_sinkronisasi}
                      </span>
                    </td>
                  </tr>
                ))}
                {spendingHistory?.length === 0 && <tr><td colspan="4" class="px-6 py-8 text-center text-gray-500">Belum ada riwayat pengeluaran tercatat.</td></tr>}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</GeneralLayout>

<script>
  import { supabase } from '../lib/supabase.js';
  import { uploadImageToFreeimage } from '../lib/freeimage.js';

  document.addEventListener('DOMContentLoaded', () => {
    
    // TAB SWITCHING
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabContents = document.querySelectorAll('.tab-content');

    tabButtons.forEach((button) => {
      button.addEventListener('click', function() {
        const tabId = this.getAttribute('data-tab');
        tabButtons.forEach((btn) => {
          btn.classList.remove('border-green-700', 'text-green-700');
          btn.classList.add('border-transparent', 'text-gray-600');
        });
        this.classList.remove('border-transparent', 'text-gray-600');
        this.classList.add('border-green-700', 'text-green-700');

        tabContents.forEach((content) => {
          content.classList.add('hidden');
          content.classList.remove('block');
        });
        document.getElementById(`${tabId}-tab`)?.classList.remove('hidden');
        document.getElementById(`${tabId}-tab`)?.classList.add('block');
      });
    });

    // FILE UPLOAD HANDLER UI
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const fileName = document.getElementById('fileName');

    dropZone?.addEventListener('click', () => fileInput?.click());
    dropZone?.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-green-700', 'bg-green-50'); });
    dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('border-green-700', 'bg-green-50'));
    dropZone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-green-700', 'bg-green-50');
      if (e.dataTransfer?.files.length > 0) {
        fileInput.files = e.dataTransfer.files;
        updateFileName();
      }
    });

    fileInput?.addEventListener('change', updateFileName);

    function updateFileName() {
      if (fileInput.files && fileInput.files.length > 0) {
        if(fileName) {
            fileName.textContent = `✓ File siap: ${fileInput.files[0].name}`;
            fileName.classList.add('text-green-600', 'font-bold');
        }
      }
    }

    // CONVERSION RATE CALCULATOR
    const reachInput = document.getElementById('reachInput') as HTMLInputElement;
    const leadsInput = document.getElementById('leadsInput') as HTMLInputElement;
    const conversionRateDisplay = document.getElementById('conversionRate');

    function calculateConversionRate() {
      const reach = parseFloat(reachInput.value) || 0;
      const leads = parseFloat(leadsInput.value) || 0;
      
      if (reach > 0 && conversionRateDisplay) {
        const rate = ((leads / reach) * 100).toFixed(2);
        conversionRateDisplay.textContent = rate + '%';
        if (parseFloat(rate) >= 1) conversionRateDisplay.className = 'text-2xl font-bold text-green-600';
        else if (parseFloat(rate) >= 0.5) conversionRateDisplay.className = 'text-2xl font-bold text-yellow-600';
        else conversionRateDisplay.className = 'text-2xl font-bold text-red-600';
      } else if (conversionRateDisplay) {
        conversionRateDisplay.textContent = '0%';
        conversionRateDisplay.className = 'text-2xl font-bold text-gray-900';
      }
    }

    reachInput?.addEventListener('input', calculateConversionRate);
    leadsInput?.addEventListener('input', calculateConversionRate);

    // SUBMIT PERFORMA IKLAN (DENGAN FREEIMAGE UPLOAD)
    document.getElementById('performaForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const btn = document.getElementById('btnSubmitPerforma') as HTMLButtonElement;
      btn.innerHTML = "Memproses...";
      btn.disabled = true;

      try {
        let imageUrl = null;
        
        // Cek jika ada gambar yang di-upload
        if (fileInput.files && fileInput.files.length > 0) {
            imageUrl = await uploadImageToFreeimage(fileInput.files[0]);
        }

        // Insert ke Supabase
        const { error } = await supabase.from('performa_iklan').insert([{
            platform: (document.getElementById('p_platform') as HTMLSelectElement).value,
            waktu_tayang: (document.getElementById('p_tanggal') as HTMLInputElement).value,
            reach: parseInt(reachInput.value),
            leads: parseInt(leadsInput.value),
            bukti_url: imageUrl
        }]);

        if (error) throw error;

        alert('Data Performa Iklan berhasil disimpan!');
        window.location.reload();
      } catch (err: any) {
        alert('Gagal: ' + err.message);
        btn.innerHTML = "Simpan Performa";
        btn.disabled = false;
      }
    });

    // SUBMIT PENGELUARAN IKLAN
    document.getElementById('pengeluaranForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const btn = document.getElementById('btnSubmitPengeluaran') as HTMLButtonElement;
      btn.innerHTML = "Menyimpan...";
      btn.disabled = true;

      try {
        const { error } = await supabase.from('pengeluaran_iklan').insert([{
            periode: (document.getElementById('ads_periode') as HTMLInputElement).value,
            platform: (document.getElementById('ads_platform') as HTMLSelectElement).value,
            biaya: parseFloat((document.getElementById('biayaInput') as HTMLInputElement).value)
        }]);

        if (error) throw error;

        alert('Pengeluaran berhasil dicatat!');
        window.location.reload();
      } catch (err: any) {
        alert('Gagal: ' + err.message);
        btn.innerHTML = "Input Biaya Ads";
        btn.disabled = false;
      }
    });

  });
</script>