    // ==========================================
    window.exportSlipPotonganFilter = async function () {
      try {
        if (typeof html2canvas === "undefined") {
          return alert(
            "❌ Library html2canvas belum ter-load. Silakan refresh halaman!",
          );
        }

        const dataTerfilter = window.currentFilteredRiwayat;
        if (!dataTerfilter || dataTerfilter.length === 0) {
          return alert(
            "⚠️ Tidak ada data riwayat yang cocok dengan filter untuk diunduh!",
          );
        }

        // 1️⃣ Akumulasi nilai khusus potongan dari data ACC
        let totalKasbon = 0;
        let namaKaryawan = "";
        let akumulasiPotonganLain = {};

        dataTerfilter.forEach((slip) => {
          const isACC =
            slip.status === "ACC" || slip.status_persetujuan === "ACC";
          if (!isACC) return;

          totalKasbon += Number(slip.kasbon || 0);

          if (!namaKaryawan && slip.profiles?.nama) {
            namaKaryawan = slip.profiles.nama;
          }

          if (slip.lain_lain && slip.lain_lain.length > 0) {
            slip.lain_lain.forEach((item) => {
              if (item.tipe === "potongan") {
                const key = item.nama_item;
                if (!akumulasiPotonganLain[key]) {
                  akumulasiPotonganLain[key] = 0;
                }
                akumulasiPotonganLain[key] += Number(item.nominal) || 0;
              }
            });
          }
        });

        const totalPotonganLain = Object.values(akumulasiPotonganLain).reduce(
          (a, b) => a + b,
          0,
        );
        const grandTotalPotongan = totalKasbon + totalPotonganLain;

        // Cek jika tidak ada potongan sama sekali
        if (grandTotalPotongan === 0) {
          return alert(
            "✅ Karyawan ini tidak memiliki catatan potongan (Kasbon/Lainnya) pada periode filter ini.",
          );
