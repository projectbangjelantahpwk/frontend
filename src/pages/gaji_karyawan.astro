<script
  src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"
  is:inline></script>
<script is:inline>
  let dataGlobalGaji = null;
  let dataKaryawan = [];
  let currentUserId = null;

  document.addEventListener("DOMContentLoaded", async () => {
    // === 🛡️ GATEKEEPER KEUANGAN ===
    const allowedRoles = ["owner", "hrd", "keuangan", "it"];
    const client = window.supabase || supabase;

    const {
      data: { session },
    } = await client.auth.getSession();
    if (!session) return window.location.replace("/");
    currentUserId = session.user.id;

    const { data: prof } = await client
      .from("profiles")
      .select("role")
      .eq("id", session.user.id)
      .single();

    if (!allowedRoles.includes(prof?.role)) {
      alert(
        `Akses Ditolak! Role Anda (${prof?.role || "Guest"}) dilarang masuk ke Keuangan.`,
      );
      return window.location.replace("/");
    }
    document.body.style.display = "block";

    // Setup Batasan Tanggal Otomatis
    const tahunAktif = new Date().getFullYear();
    const awalTahun = `${tahunAktif}-01-01`;
    const waktuLokal = new Date();
    const offset = waktuLokal.getTimezoneOffset() * 60000;
    const hariIni = new Date(waktuLokal - offset).toISOString().split("T")[0];

    const inputStart = document.getElementById("filter-gaji-start");
    const inputEnd = document.getElementById("filter-gaji-end");
    if (inputStart && inputEnd) {
      inputStart.min = awalTahun;
      inputStart.max = hariIni;
      inputStart.value = awalTahun;

      inputEnd.min = awalTahun;
      inputEnd.max = hariIni;
      inputEnd.value = hariIni;
    }

    // ==========================================
    // 1. FETCH DATA KEUANGAN (CLIENT-SIDE)
    // ==========================================
    async function loadKeuanganData() {
      if (!window.supabase) return;
      try {
        const { data: listMitra } = await window.supabase
          .from("mitra")
          .select("id, nama_mitra")
          .order("nama_mitra", { ascending: true });
        window.allMitraGlobal = listMitra || [];
        const { data: globalGaji } = await window.supabase
          .from("pengaturan_gaji_global")
          .select("*")
          .single();
        dataGlobalGaji = globalGaji;
        if (globalGaji) {
          document.getElementById("g_kesehatan").value =
            globalGaji.uang_kesehatan || 0;
          document.getElementById("g_tepatwaktu").value =
            globalGaji.bonus_tepat_waktu || 0;
          document.getElementById("g_mingguan").value =
            globalGaji.bonus_mingguan || 0;
          document.getElementById("g_lembur").value =
            globalGaji.tarif_lembur_perjam || 0;
        }

        const { data: karyawan, error: errKaryawan } = await window.supabase
          .from("profiles")
          .select(
            "id, nama, role, foto_profil, setup_gaji(*), presensi(tanggal, status_tiba, waktu_tiba, waktu_pulang), slip_gaji(*)",
          )
          .neq("role", "owner");

        if (errKaryawan) {
          alert("Error Supabase (Data Karyawan): " + errKaryawan.message);
          console.error("Detail Error:", errKaryawan);
        }

        dataKaryawan = karyawan || [];
        const contKaryawan = document.getElementById("gaji-karyawan-container");
        let htmlKaryawan = "";

        // 🟢 1. BUAT VARIABEL UNTUK MENDETEKSI BULAN INI (Format: YYYY-MM)
        const tglSekarang = new Date();
        const prefixBulanIni = `${tglSekarang.getFullYear()}-${String(tglSekarang.getMonth() + 1).padStart(2, "0")}`;

        if (dataKaryawan.length > 0) {
          dataKaryawan.forEach((k) => {
            // 🟢 2. FILTER DATA PRESENSI HANYA UNTUK BULAN INI
            const presensiBulanIni = (k.presensi || []).filter(
              (p) => p.tanggal && p.tanggal.startsWith(prefixBulanIni),
            );
            const jumlahHadir = presensiBulanIni.length;

            // 🔥 Ambil 2 huruf depan untuk inisial (misal: "Budi Santoso" -> "BS")
            const inisial = k.nama
              ? k.nama
                  .split(" ")
                  .map((n) => n[0])
                  .join("")
                  .substring(0, 2)
                  .toUpperCase()
              : "U";

            // 🔥 Beri warna hijau elegan khas Keuangan jika pakai inisial
            const avatarKomponen = k.foto_profil
              ? `<img src="${k.foto_profil}" class="w-12 h-12 rounded-full object-cover border-2 border-green-200 shadow-sm shrink-0" />`
              : `<div class="w-12 h-12 rounded-full bg-green-100 border border-green-200 flex items-center justify-center text-green-700 font-bold text-lg shadow-sm shrink-0">${inisial}</div>`;

            const peran = k.tipe_kendaraan
              ? k.tipe_kendaraan.replace("_", " ")
              : k.role || "Karyawan";
            const setup =
              k.setup_gaji && k.setup_gaji.length > 0 ? k.setup_gaji[0] : {};
            const tarif = Number(
              setup.gaji_menit || setup.gaji_pokok || 0,
            ).toLocaleString("id-ID");

            // 🟢 1. TARIK SIKLUS DARI DATABASE (Default Mingguan)
            const siklusAktif = setup.siklus_gaji || "Mingguan";

            const badgeBypass = setup.bypass_jam_kerja
              ? `<span class="px-2 py-0.5 rounded text-[9px] font-black bg-purple-100 text-purple-700 border border-purple-200 uppercase tracking-wider shadow-sm flex items-center gap-0.5 font-sans"><i class="bi bi-lightning-charge-fill"></i> Gaji Flat</span>`
              : "";

            // 🟢 2. INJECT SIKLUS KE DATA-PERIODE DAN BADGE TULISAN
            htmlKaryawan += `
                    <div class="karyawan-card bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden flex flex-col transition-all" data-periode="${siklusAktif}">
                        <div class="bg-gradient-to-r from-green-50 to-green-100 px-6 py-4 flex items-center justify-between border-b border-green-200">
                            <div class="flex items-center gap-4">
                                ${avatarKomponen} 
                                <div>
                                    <h3 class="font-bold text-gray-900 flex items-center gap-1.5 flex-wrap">
                                        ${k.nama} 
                                        <span class="px-2 py-0.5 rounded text-[9px] font-black bg-blue-200 text-blue-800 uppercase tracking-wider shadow-sm">${siklusAktif.toUpperCase()}</span>
                                        ${badgeBypass}
                                    </h3>
                                    <p class="text-xs font-semibold text-gray-600 capitalize mt-0.5">${peran}</p>
                                </div>
                            </div>
                        </div>
                        <div class="p-6 flex-1 flex flex-col">
                            <div class="space-y-2 mb-6 text-sm">
                                <div class="flex justify-between"><span class="text-gray-500">Gaji per ${siklusAktif}:</span> <span class="font-medium text-gray-900">Rp ${tarif}</span></div>
                                <div class="flex justify-between"><span class="text-gray-500">Hadir Bulan Ini:</span> <span class="font-medium text-green-600">${jumlahHadir} Hari</span></div>
                            </div>
                            <button onclick="window.openModalGaji('${k.id}')" class="mt-auto w-full flex items-center justify-center gap-2 px-4 py-3 bg-white border-2 border-green-700 text-green-700 rounded-xl font-bold hover:bg-green-50 transition active:scale-95">
                                <i class="bi bi-calculator"></i> Setup & Slip Gaji
                            </button>
                        </div>
                    </div>`;
          });
        } else {
          htmlKaryawan =
            '<p class="text-gray-500">Belum ada data karyawan.</p>';
        }
        contKaryawan.innerHTML = htmlKaryawan;

        // TAMBAHAN: Isi dropdown filter riwayat otomatis
        const filterUserEl = document.getElementById("filter-gaji-user");
        if (filterUserEl && dataKaryawan.length > 0) {
          let userOptions = '<option value="semua">Semua Karyawan</option>';
          dataKaryawan.forEach((k) => {
            userOptions += `<option value="${k.id}">${k.nama}</option>`;
          });
          filterUserEl.innerHTML = userOptions;
        }
      } catch (error) {
        console.error("Gagal load data keuangan:", error);
      }
    }

    await loadKeuanganData();

    // ==========================================
    // 2. TAB SWITCHING LOGIC
    // ==========================================
    const tabButtons = document.querySelectorAll(".tab-btn");
    const tabContents = document.querySelectorAll(".tab-content");
    tabButtons.forEach((button) => {
      button.addEventListener("click", function () {
        let tabName = this.getAttribute("data-tab");

        const tabIdMap = {
          gaji: "gaji",
          "riwayat-gaji": "riwayat-gaji-tab",
        };

        tabName = tabIdMap[tabName] || tabName;

        tabButtons.forEach((btn) => {
          btn.classList.remove("active", "border-green-700", "text-green-700");
          btn.classList.add("border-transparent", "text-gray-600");
        });
        tabContents.forEach((content) => {
          content.classList.add("hidden");
          content.classList.remove("block");
        });

        this.classList.add("active", "border-green-700", "text-green-700");
        this.classList.remove("border-transparent", "text-gray-600");

        const activeTab = document.getElementById(tabName);
        if (activeTab) {
          activeTab.classList.remove("hidden");
          activeTab.classList.add("block");
        } else {
          console.warn(`Tab dengan ID '${tabName}' tidak ditemukan!`);
        }
      });
    });

    // ==========================================
    // 3. MODAL CONTROLS & FUNCTIONS
    // ==========================================
    window.openModal = function (id) {
      const m = document.getElementById(id);
      if (!m) return;
      m.classList.remove("hidden");
      m.classList.add("flex");
      setTimeout(() => {
        m.classList.remove("opacity-0");
        const c = m.querySelector("div");
        if (c) c.classList.remove("scale-95");
      }, 10);

      // 🔥 Kunci body layar belakang biar gak bisa di-scroll
      document.body.style.overflow = "hidden";
    };

    window.closeModal = function (id) {
      const m = document.getElementById(id);
      if (!m) return;
      m.classList.add("opacity-0");
      const c = m.querySelector("div");
      if (c) c.classList.add("scale-95");
      setTimeout(() => {
        m.classList.add("hidden");
        m.classList.remove("flex");
      }, 300);

      // 🔥 Lepas kunci scroll saat modal ditutup
      document.body.style.overflow = "";
    };

    // UPDATE PENGATURAN GLOBAL
    document
      .getElementById("form-global-gaji")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!window.supabase) return;
        const btn = e.target.querySelector('button[type="submit"]');
        btn.innerText = "Menyimpan...";

        try {
          await window.supabase
            .from("pengaturan_gaji_global")
            .update({
              uang_kesehatan: document.getElementById("g_kesehatan").value,
              bonus_tepat_waktu: document.getElementById("g_tepatwaktu").value,
              bonus_mingguan: document.getElementById("g_mingguan").value,
              tarif_lembur_perjam: document.getElementById("g_lembur").value,
            })
            .eq("id", 1);
          alert("Pengaturan Global berhasil diperbarui!");
          window.location.reload();
        } catch (err) {
          alert(err.message);
          btn.innerText = "Simpan Pengaturan";
        }
      });

    window.currentSalaryData = null;

    // FUNGSI UNTUK MENGUBAH LABEL UI BERDASARKAN SIKLUS
    window.ubahSiklusUI = function () {
      const siklus = document.getElementById("setup_siklus_gaji").value;
      const labelGaji = document.getElementById("label_gaji_pokok");

      // Deteksi apakah jam bebas aktif
      const chkJamBebas = document.getElementById("chk_jam_bebas");
      const isJB = chkJamBebas ? chkJamBebas.checked : false;

      // 🔥 LOGIKA LABEL BARU
      if (isJB) {
        labelGaji.innerText = "Gaji Pokok per Menit (Rp)";
      } else {
        if (siklus === "Bulanan")
          labelGaji.innerText = "Gaji Pokok Bulanan (Rp)";
        else if (siklus === "Harian")
          labelGaji.innerText = "Gaji Pokok Harian (Rp)";
        else labelGaji.innerText = "Gaji Pokok Mingguan (Rp)";
      }

      if (window.currentSalaryData) {
        window.currentSalaryData.siklusGaji = siklus;

        const today = new Date();
        const year = today.getFullYear();
        const month = String(today.getMonth() + 1).padStart(2, "0");
        const day = String(today.getDate()).padStart(2, "0");
        const strHariIni = `${year}-${month}-${day}`;

        let tglMulai, tglAkhir;

        if (siklus === "Bulanan") {
          tglMulai = `${year}-${month}-01`;
          const dAkhir = new Date(year, today.getMonth() + 1, 0);
          tglAkhir = `${year}-${month}-${String(dAkhir.getDate()).padStart(2, "0")}`;
        } else if (siklus === "Harian") {
          tglMulai = strHariIni;
          tglAkhir = strHariIni;
        } else {
          const h = today.getDay() || 7;
          const senin = new Date(today);
          senin.setDate(today.getDate() - (h - 1));
          const mSenin = String(senin.getMonth() + 1).padStart(2, "0");
          const dSenin = String(senin.getDate()).padStart(2, "0");
          tglMulai = `${senin.getFullYear()}-${mSenin}-${dSenin}`;
          const minggu = new Date(senin);
          minggu.setDate(senin.getDate() + 6);
          const mMinggu = String(minggu.getMonth() + 1).padStart(2, "0");
          const dMinggu = String(minggu.getDate()).padStart(2, "0");
          tglAkhir = `${minggu.getFullYear()}-${mMinggu}-${dMinggu}`;
        }
        window.currentSalaryData.tglMulai = tglMulai;
        window.currentSalaryData.tglAkhir = tglAkhir;
      }
    };

    // PERBARUI FUNGSI MESIN WAKTU
    window.openModalGaji = async function (empId, slipIdToEdit = null) {
      const emp = dataKaryawan.find((k) => String(k.id) === String(empId));
      if (!emp) return alert("Data karyawan tidak ditemukan!");

