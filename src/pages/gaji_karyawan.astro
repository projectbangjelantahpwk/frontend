            alertKasbonUj.innerHTML = `⚠️ <b>PERHATIAN:</b> Sistem mendeteksi adanya <b>Kasbon Uang Jalan (Dadakan)</b> sebesar <b class="font-mono text-red-900">Rp ${res.kasbonUangJalan.toLocaleString("id-ID")}</b> pada rentang tanggal ini. Angka tersebut akan otomatis ditambahkan ke total potongan slip gaji di sebelah kanan.`;
            alertKasbonUj.classList.remove("hidden");
          } else {
            alertKasbonUj.classList.add("hidden");
          }
        }

        const isJerigen = document.getElementById("chk_gaji_jerigen")?.checked;
        const isJamBebas = document.getElementById("chk_jam_bebas")?.checked;
        if (isJerigen && document.getElementById("info_total_jerigen_minggu")) {
          document.getElementById("info_total_jerigen_minggu").innerText =
            `${res.jumlahJerigen || 0} Pcs`;
        }

        d.finalState = { grandTotal: res.grandTotal || 0 };

        const labelGajiPokok = isJerigen
          ? `Gaji Jerigen (${res.jumlahJerigen || 0} Pcs)`
          : isJamBebas
