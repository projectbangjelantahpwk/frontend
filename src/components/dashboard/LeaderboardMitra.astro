---
import { supabase } from '../../lib/supabase'; // Pastikan path Supabase lu bener

// 1. Tentukan periode bulan ini (Format MM YYYY menyesuaikan update database terbaru)
const now = new Date();
const currentPeriode = `${String(now.getMonth() + 1).padStart(2, '0')} ${now.getFullYear()}`;

// 2. Fetch data Server-Side HANYA untuk bulan berjalan
const { data: dbData, error } = await supabase
    .from('leaderboard_mingguan')
    .select('*')
    .eq('periode', currentPeriode);

if (error) {
    console.error("Gagal fetch leaderboard:", error);
}

// 3. Kalkulasi agregasi (Sum) per Mitra untuk 1 bulan
const aggregatedMap = new Map();

(dbData || []).forEach(row => {
    const id = row.mitra_id;
    
    // Kalau mitra belum ada di map, buat kerangkanya
    if (!aggregatedMap.has(id)) {
        aggregatedMap.set(id, {
            mitra_id: id,
            nama_mitra: row.nama_mitra || 'Mitra Tanpa Nama',
            minyak_jelantah: 0, ampas: 0, kriuk: 0, tepung: 0, spinner: 0, total_keseluruhan: 0
        });
    }
    
    // Akumulasikan nilai dari tiap minggu ke total bulanan
    const mitra = aggregatedMap.get(id);
    mitra.minyak_jelantah += Number(row.minyak_jelantah_kg || 0);
    mitra.ampas += Number(row.ampas_kg || 0);
    mitra.kriuk += Number(row.kriuk_kg || 0);
    mitra.tepung += Number(row.tepung_kg || 0);
    mitra.spinner += Number(row.spinner_kg || 0);
});

// 4. Hitung Grand Total (total_keseluruhan) tiap mitra dan ubah ke Array
const finalData = Array.from(aggregatedMap.values()).map(mitra => {
    mitra.total_keseluruhan = mitra.minyak_jelantah + mitra.ampas + mitra.kriuk + mitra.tepung + mitra.spinner;
    return mitra;
});
---

<div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline-variant shadow-md hover:shadow-lg transition-shadow">
    <div class="mb-lg">
        <h3 class="font-headline-md text-on-surface mb-md">🏆 Top 5 Mitra Terbaik</h3>
        <div class="flex gap-sm flex-wrap" id="leaderboard-filters">
            <button data-category="total_keseluruhan" class="filter-btn px-md py-sm rounded-full bg-primary text-on-primary font-label-sm active">Semua</button>
            <button data-category="minyak_jelantah" class="filter-btn px-md py-sm rounded-full border border-outline text-on-surface font-label-sm hover:bg-surface-container">Minyak</button>
            <button data-category="ampas" class="filter-btn px-md py-sm rounded-full border border-outline text-on-surface font-label-sm hover:bg-surface-container">Ampas</button>
            <button data-category="kriuk" class="filter-btn px-md py-sm rounded-full border border-outline text-on-surface font-label-sm hover:bg-surface-container">Kriuk</button>
            <button data-category="spinner" class="filter-btn px-md py-sm rounded-full border border-outline text-on-surface font-label-sm hover:bg-surface-container">Spinner</button>
            <button data-category="tepung" class="filter-btn px-md py-sm rounded-full border border-outline text-on-surface font-label-sm hover:bg-surface-container">Tepung</button>
        </div>
    </div>
    
    <div class="space-y-sm" id="leaderboard-list"></div>

    <script id="mitra-data" type="application/json" set:html={JSON.stringify(finalData)}></script>
</div>

<script>
    // 1. Ambil elemen dan data dari DOM
    const rawDataElement = document.getElementById('mitra-data');
    const mitras = rawDataElement ? JSON.parse(rawDataElement.textContent || '[]') : [];
    
    const listContainer = document.getElementById('leaderboard-list');
    const filterButtons = document.querySelectorAll('.filter-btn');

    // 2. Fungsi untuk menentukan gaya visual berdasarkan peringkat
    function getRankStyle(rank) {
        if (rank === 1) return { bg: "from-yellow-500/10 to-yellow-500/5", color: "bg-yellow-500" };
        if (rank === 2) return { bg: "from-gray-400/10 to-gray-400/5", color: "bg-gray-400" };
        if (rank === 3) return { bg: "from-orange-600/10 to-orange-600/5", color: "bg-orange-600" };
        return { bg: "from-surface-container to-surface-container", color: "bg-surface-variant" };
    }

    // 3. Fungsi utama untuk merender Top 5 berdasarkan Kategori
    function renderLeaderboard(category) {
        if (!listContainer) return;
        
        // Filter yang nilainya di atas 0, lalu Sortir descending, lalu ambil Top 5
        const top5Mitras = [...mitras]
            .filter(mitra => (mitra[category] || 0) > 0) // 🔥 TAMBAHAN INI
            .sort((a, b) => (b[category] || 0) - (a[category] || 0))
            .slice(0, 5);
        
        listContainer.innerHTML = '';
        
        // 🔥 TAMBAHAN LOGIKA KOSONG: Kalau setelah difilter ternyata datanya 0
        if (top5Mitras.length === 0) {
            listContainer.innerHTML = `<p class="text-sm text-center text-on-surface-variant italic py-4">Belum ada penyetor di kategori ini.</p>`;
            return;
        }
    
        top5Mitras.forEach((mitra, index) => {
            const rank = index + 1;
            const style = getRankStyle(rank);
            const value = mitra[category] || 0;
            const unit = category === 'total_keseluruhan' ? 'Total' : 'Item';

            const cardHtml = `
                <div class="flex items-center gap-md p-md bg-gradient-to-r ${style.bg} rounded-xl border hover:border-opacity-40 transition-colors">
                    <div class="flex items-center justify-center w-10 h-10 rounded-full ${style.color} text-white font-bold text-lg flex-shrink-0">
                        ${rank}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="font-semibold text-on-surface truncate">${mitra.nama_mitra}</p>
                        <p class="text-label-sm text-on-surface-variant">${unit}: ${value} KG</p>
                    </div>
                </div>
            `;
            listContainer.insertAdjacentHTML('beforeend', cardHtml);
        });
    }

    // 4. Logika klik tombol filter
    filterButtons.forEach(button => {
        button.addEventListener('click', (e) => {
            const btn = e.currentTarget;
            const category = btn.getAttribute('data-category');

            // Reset styling untuk semua tombol
            filterButtons.forEach(b => {
                b.classList.remove('bg-primary', 'text-on-primary', 'active');
                b.classList.add('border', 'border-outline', 'text-on-surface', 'hover:bg-surface-container');
            });

            // Set styling aktif untuk tombol yang diklik
            btn.classList.add('bg-primary', 'text-on-primary', 'active');
            btn.classList.remove('border', 'border-outline', 'text-on-surface', 'hover:bg-surface-container');

            // Render ulang leaderboard
            renderLeaderboard(category);
        });
    });

    // 5. Render awal saat halaman dimuat (Kategori: Semua)
    renderLeaderboard('total_keseluruhan');
</script>