    // =========================================================

    // 1. Logika Buka/Tutup Dropdown
    window.toggleDropdownFilter = function (e) {
      if (e) e.preventDefault();
      document
        .getElementById("dropdown-filter-prospek")
        ?.classList.toggle("hidden");
    };

    // Menutup dropdown otomatis jika user klik area kosong di luar kotak
    document.addEventListener("click", function (event) {
      const dropdown = document.getElementById("dropdown-filter-prospek");
      const isClickInsideBtn = event.target.closest(
        'button[onclick*="toggleDropdownFilter"]',
      );
      if (!isClickInsideBtn && dropdown && !dropdown.contains(event.target)) {
        dropdown.classList.add("hidden");
      }
    });

    // 2. Mesin Utama: Menyatukan Filter Dropdown + Kolom Search Teks
    window.applyFilterProspek = function (e) {
      if (e) e.preventDefault();

      const filterTgl =
        document.getElementById("filter-tgl-prospek")?.value || "";
      const filterFu =
        document.getElementById("filter-fu-prospek")?.value || "";
      const keyword = (
        document.getElementById("input-search-mitra")?.value || ""
      )
        .toLowerCase()
        .trim();
      const items = document.querySelectorAll(".prospek-item");

      items.forEach((item) => {
        const itemTgl = item.getAttribute("data-tgl") || "";
        const itemFu = parseInt(item.getAttribute("data-fu")) || 1;
        const itemSumber = item.getAttribute("data-sumber") || ""; // Ambil atribut data-sumber
        const text = item.textContent.toLowerCase();

        let match = true;

        // Syarat A: Kecocokan Tanggal
        if (filterTgl && itemTgl !== filterTgl) match = false;

        // Syarat B: Kecocokan Angka Follow Up
        if (filterFu) {
          if (filterFu === "5" && itemFu < 5) match = false;
          else if (filterFu !== "5" && itemFu !== parseInt(filterFu))
            match = false;
        }

        // Syarat C: Kecocokan Sumber Mitra (Case Insensitive)
        // Kita ubah keduanya jadi huruf kecil agar kebal dari tipe penulisan "Instagram" vs "instagram"
        if (
          filterSumber &&
          itemSumber.toLowerCase() !== filterSumber.toLowerCase()
        )
          match = false;

        // Syarat D: Kecocokan Kata Kunci di Kolom Search
        if (keyword && !text.includes(keyword)) match = false;

        // Eksekusi: Tampilkan jika lulus semua syarat!
        item.style.display = match ? "" : "none";
      });

      // Tutup kotak dropdown setelah sukses filter
      document
        .getElementById("dropdown-filter-prospek")
        ?.classList.add("hidden");
    };

    // 3. Tombol Reset Filter Dropdown
    window.resetFilterProspek = function (e) {
      if (e) e.preventDefault();
      if (document.getElementById("filter-tgl-prospek"))
        document.getElementById("filter-tgl-prospek").value = "";
      if (document.getElementById("filter-fu-prospek"))
        document.getElementById("filter-fu-prospek").value = "";
      if (document.getElementById("filter-sumber-prospek"))
        document.getElementById("filter-sumber-prospek").value = ""; // Reset opsi sumber mitra

      // Panggil ulang mesin utama
      window.applyFilterProspek();
    };

    // Menutup dropdown otomatis jika user klik area kosong di luar kotak
    document.addEventListener("click", function (event) {
