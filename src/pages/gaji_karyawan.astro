      const jm = document.getElementById("input_jerigen_manual")?.value;

      try {
        const { data, error } = await window.supabase.functions.invoke(
          "gaji-karyawan",
          {
            body: {
              empId: d.empId,
              tglMulai: d.tglMulai,
              tglAkhir: d.tglAkhir,
              action: "kalkulasi",
              potonganKasbonManual: isNaN(potonganManual)
                ? null
                : potonganManual,
              tambahanTalanganManual: isNaN(talanganManual)
                ? null
