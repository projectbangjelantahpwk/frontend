      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = document.getElementById("btn-submit-kas");
        const textLama = btn.innerText;
        btn.innerText = "Menyimpan...";
        btn.disabled = true;

        try {
          const payload = {
            uang_gudang:
              parseFloat(document.getElementById("input_uang_gudang").value) ||
              0,
            uang_keuangan:
              parseFloat(
                document.getElementById("input_uang_keuangan").value,
              ) || 0,
            updated_at: new Date().toISOString(),
          };

          // Hanya update kolom uang_owner jika inputnya tidak sedang disembunyikan (artinya dia owner)
          const inputContainerOwner = document.getElementById(
            "input-container-owner",
          );
          if (
            inputContainerOwner &&
            !inputContainerOwner.classList.contains("hidden")
          ) {
            payload.uang_owner =
              parseFloat(document.getElementById("input_uang_owner").value) ||
              0;
          }

          const { error } = await window.supabase
            .from("kas_perusahaan")
            .update(payload)
            .eq("id", 1);
          if (error) throw error;

          alert("✅ Berhasil memperbarui saldo kas perusahaan!");
          window.loadDataKas(); // Perbarui seluruh tampilan UI secara real-time
          window.tutupModalKas();
        } catch (err) {
          alert("Gagal menyimpan saldo: " + err.message);
        } finally {
          btn.innerText = textLama;
          btn.disabled = false;
        }
      });
  </script>
</html>
