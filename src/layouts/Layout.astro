    const app = initializeApp(firebaseConfig);
    const messaging = getMessaging(app);

    // ==========================================
    // 1️⃣ MINTA IZIN & DAPATKAN FCM TOKEN
    // ==========================================
    async function requestFCMToken() {
      try {
        const permission = await Notification.requestPermission();
        if (permission === "granted") {
          const currentToken = await getToken(messaging, {
            vapidKey:
              "BIIKobK9kr74tDXdL7WeThrFqbh_aG7B-X_gMS-wOYToaVqI_uAJQQo5WUmVG8uL2OUN2NU6-qMojh_j7KF1xYQ",
          });

          if (currentToken) {
            console.log("✅ FCM Token berhasil didapat");

            // 🔥 SIMPAN TOKEN KE SUPABASE (JANGAN BOROS!)
