            : `Gaji Pokok Proporsional (${res.hariKerjaNormal || 0} Hari)`;

        const labelBonus = isJerigen
          ? `Bonus Jerigen (Mode Khusus)`
          : `Bonus Tambahan`;

        // 🔥 2. BIKIN LOOPING HTML UNTUK KOMPONEN DINAMIS 🔥
