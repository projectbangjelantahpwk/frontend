    <script is:inline>
        // ==========================================
            // FITUR PENCARIAN GLOBAL SAKTI (BULLETPROOF)
            // ==========================================
            window.applySearchMitra = function() {
                const searchInput = document.getElementById('input-search-mitra');
                if(!searchInput) return;
                
                // Hapus spasi berlebih di awal/akhir kata
                const keyword = searchInput.value.toLowerCase().trim();
                
                // Sapu bersih semua baris dan kartu di SEMUA TAB
                const items = document.querySelectorAll(`
                    #mitra-baru-tbody tr, #mitra-baru-mobile > div,
                    #mitra-langganan-tbody tr, #mitra-langganan-mobile > div,
                    #mitra-tidak-aktif-tbody tr, #mitra-tidak-aktif-mobile > div,
                    #leaderboard-live-list > div
                `);

                items.forEach(item => {
                    // Abaikan baris "Memuat data..." biar sistem nggak error
                    if (item.querySelector('td[colspan]')) return;
                    if (item.classList.contains('col-span-full')) return; 

                    const text = item.textContent.toLowerCase();
                    
                    // Kalau kotak pencarian kosong, kembalikan semua data
                    if (keyword === '') {
                        item.style.display = ''; 
                    } else {
                        // Sembunyikan yang tidak cocok, munculkan yang cocok
                        item.style.display = text.includes(keyword) ? '' : 'none';
                    }
                });
            };
        document.addEventListener('DOMContentLoaded', async () => {
            if(!window.supabase) return console.error('Supabase tidak terhubung!');

            // === TAMBAHAN: CEK ROLE USER YANG LOGIN ===
            // === 🛡️ GATEKEEPER KEUANGAN ===
            const allowedRoles = ['owner', 'hrd', 'admin','keuangan','it'];
            const client = window.supabase || supabase;

            const { data: { session } } = await client.auth.getSession();
            if (!session) return window.location.replace('/'); // Tendang kalau belum login

            const { data: prof } = await client.from('profiles').select('role').eq('id', session.user.id).single();
            if (!allowedRoles.includes(prof?.role)) {
                alert(`Akses Ditolak! Role Anda (${prof?.role || 'Guest'}) dilarang masuk ke Keuangan.`);
                return window.location.replace('/');
            }
            document.body.style.display = 'block'; // Buka gembok CSS, tampilkan layar!

            // ==========================================
            // 1. TAB LOGIC
            // ==========================================
            const tabBtns = document.querySelectorAll('.tab-btn');
            const tabContents = document.querySelectorAll('.tab-content');

            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    // Reset semua warna tombol tab
                    tabBtns.forEach(b => {
                        b.classList.remove('border-primary', 'text-primary', 'active');
                        b.classList.add('border-transparent', 'text-on-surface-variant');
                    });
                    // Aktifkan warna tombol tab yang diklik
                    btn.classList.remove('border-transparent', 'text-on-surface-variant');
                    btn.classList.add('border-primary', 'text-primary', 'active');
                    
                    // Sembunyikan semua isi tab
                    tabContents.forEach(content => {
                        content.classList.add('hidden');
                        content.classList.remove('block'); // Pastikan class block dihapus
                    });
                    
                    // Tampilkan isi tab yang sesuai dengan data-tab
                    const targetId = btn.getAttribute('data-tab');
                    const targetElement = document.getElementById(`tab-${targetId}`);
                    
                    if(targetElement) {
                        targetElement.classList.remove('hidden');
                        targetElement.classList.add('block');
                    }

                    // 🌟 KHUSUS LEADERBOARD: Render ulang data live setiap tabnya dibuka 🌟
                    if (targetId === 'top_leaderboard' && typeof window.generateLeaderboard === 'function') {
                        window.generateLeaderboard();
                    }

                    // Terapkan ulang filter pencarian secara otomatis saat pindah tab
                    if (typeof window.applySearchMitra === 'function') {
                        setTimeout(window.applySearchMitra, 50);
                    }
                });
            });

            // ==========================================
            // 2. FETCH DATA & RENDER CSR
            // ==========================================
            async function loadDataKemitraan() {
                // 0. Ambil Data Rute Sekali di Awal
                const { data: ruteData } = await window.supabase.from('rute_jemput').select('id, nama_rute').eq('status', 'Aktif');
                let optRute = '<option value="">-- Pilih Rute / Wilayah --</option>';
                if (ruteData) ruteData.forEach(r => optRute += `<option value="${r.nama_rute}">${r.nama_rute}</option>`);
                
                // Tempelkan ke semua dropdown form
                document.getElementById('konversi_rute').innerHTML = optRute;
                document.getElementById('tambah_langganan_rute').innerHTML = optRute;
                document.getElementById('edit_mitra_rute').innerHTML = optRute;

                // A. Mitra Baru (Prospek)
                const { data: prospek } = await window.supabase
                    .from('mitra_baru')
                    .select('*, riwayat_follow_up(created_at)') // 🔥 SUNTIKKAN JOIN TABEL RIWAYAT
                    .order('created_at', { ascending: false });
                            
                let htmlProspekMobile = '';
                let htmlProspekTable = '';

                // ==========================================
                // FITUR AUTO BROADCAST WA MITRA LANGGANAN
                // ==========================================
                window.broadcastWA = function(hp, nama) {
                    // ✅ BENAR (Pakai spasi)
                    if (!hp || hp === '-') return alert(`Nomor HP untuk mitra ${nama} tidak ditemukan!`);

                    // Sapu bersih karakter non-angka
                    let waNumber = hp.replace(/\D/g, '');

                    // Jika nomor diawali angka '0', ubah paksa jadi kode Indonesia '62'
                    if (waNumber.startsWith('0')) {
                        waNumber = '62' + waNumber.substring(1);
                    }

                    // Template pesan broadcast otomatis (bisa kamu ganti teksnya sesuka hati)
                    const textPesan = `Halo Kak ${nama},\n\nKami dari *BANG JELANTAH PURWAKARTA* ingin menginformasikan jadwal penjemputan komoditas.\n\nApakah ada stok minyak jelantah atau kargo lainnya yang siap kami angkut hari ini? Mohon infonya ya Kak, terima kasih! 😊🙏`;

                    // Satukan link API WhatsApp resmi
                    const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(textPesan)}`;

                    // Buka chat otomatis di tab baru browser
                    window.open(waLink, '_blank');
                };
                            
                if(prospek && prospek.length > 0) {
                    prospek.forEach((p,index) => {
                        const sumber = p.sumber_customer || 'Lainnya';
                        const currentFollowUp = p.follow_up_ke || 1; 
                        
                        let tanggalInput = '-';
                        let rawDate = ''; 

                        // 🔥 AMBIL TANGGAL DARI RIWAYAT FOLLOW UP TERAKHIR 🔥
                        if (p.riwayat_follow_up && p.riwayat_follow_up.length > 0) {
                            // Sortir dari yang paling baru (descending) lalu ambil urutan ke-[0]
                            const sortedRiwayat = p.riwayat_follow_up.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
                            const lastRiwayat = sortedRiwayat[0];
                            
                            const dateObj = new Date(lastRiwayat.created_at);
                            const day = String(dateObj.getDate()).padStart(2, '0');
                            const month = String(dateObj.getMonth() + 1).padStart(2, '0'); 
                            const year = dateObj.getFullYear();
                            
                            tanggalInput = `${day}-${month}-${year}`; // Format DD-MM-YYYY (Untuk Tampilan)
                            rawDate = `${year}-${month}-${day}`;      // Format YYYY-MM-DD (Untuk Mesin Filter)
                        } 
                        // Fallback jika belum punya riwayat (ambil dari tanggal prospek dibuat)
                        else if (p.created_at) {
                            const dateObj = new Date(p.created_at);
                            const day = String(dateObj.getDate()).padStart(2, '0');
                            const month = String(dateObj.getMonth() + 1).padStart(2, '0'); 
                            const year = dateObj.getFullYear();
                            
                            tanggalInput = `${day}-${month}-${year}`;
                            rawDate = `${year}-${month}-${day}`;
                        }
                        
                        // Tampilan Card untuk Mobile
                        htmlProspekMobile += `
                        <div class="prospek-item bg-surface-container-lowest border border-outline-variant rounded-lg p-md flex flex-col gap-sm shadow-sm" data-tgl="${rawDate}" data-fu="${currentFollowUp}">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-xs text-on-surface-variant mt-1 font-medium">Tgl Follow Up: <span class="font-bold text-primary">${tanggalInput}</span></p>
                                    <p class="font-label-sm text-label-sm text-on-surface-variant">No HP</p>
                                    <p class="font-body-md text-on-surface font-semibold">${p.nomor_hp}</p>
                                    <p class="text-xs text-on-surface-variant mt-1 font-medium">Follow up ke: <span class="font-bold text-secondary">${currentFollowUp}</span></p>
                                </div>
                                <span class="px-xs py-xs bg-primary-container text-on-primary-container rounded font-label-sm text-xs">${sumber}</span>
                            </div>
