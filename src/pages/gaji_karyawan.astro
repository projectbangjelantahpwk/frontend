          slipLembur.parentElement.style.display = "table-row";
        } else {
          slipLembur.parentElement.style.display = "none";
        }

        // Makan
        const slipMakan = document.getElementById("slip-makan");
        if (Number(slip.uang_makan || 0) > 0) {
          slipMakan.innerText = `Rp ${Number(slip.uang_makan || 0).toLocaleString("id-ID")}`;
          slipMakan.parentElement.style.display = "table-row";
        } else {
          slipMakan.parentElement.style.display = "none";
        }

        // Makan Malam
        const slipMakanMalam = document.getElementById("slip-makan-malam");
        if (Number(slip.uang_makan_malam || 0) > 0) {
          slipMakanMalam.innerText = `Rp ${Number(slip.uang_makan_malam || 0).toLocaleString("id-ID")}`;
          slipMakanMalam.parentElement.style.display = "table-row";
        } else {
          slipMakanMalam.parentElement.style.display = "none";
        }

        // 🔴 BONUS DIRINCI - TAMPIL HANYA JIKA > 0
        const slipBonusTepat = document.getElementById("slip-bonus-tepat");
        if (Number(slip.bonus_tepat_waktu || 0) > 0) {
          slipBonusTepat.innerText = `Rp ${Number(slip.bonus_tepat_waktu || 0).toLocaleString("id-ID")}`;
          slipBonusTepat.parentElement.style.display = "table-row";
        } else {
          slipBonusTepat.parentElement.style.display = "none";
        }

        const slipBonusMingguan = document.getElementById(
          "slip-bonus-mingguan",
        );
        if (Number(slip.bonus_mingguan || 0) > 0) {
          slipBonusMingguan.innerText = `Rp ${Number(slip.bonus_mingguan || 0).toLocaleString("id-ID")}`;
          slipBonusMingguan.parentElement.style.display = "table-row";
        } else {
          slipBonusMingguan.parentElement.style.display = "none";
        }

        const slipBonusKesehatan = document.getElementById(
          "slip-bonus-kesehatan",
        );
        if (Number(slip.uang_kesehatan || 0) > 0) {
          slipBonusKesehatan.innerText = `Rp ${Number(slip.uang_kesehatan || 0).toLocaleString("id-ID")}`;
          slipBonusKesehatan.parentElement.style.display = "table-row";
        } else {
          slipBonusKesehatan.parentElement.style.display = "none";
        }

        const slipBonusRapat = document.getElementById("slip-bonus-rapat");
        if (Number(slip.uang_rapat || 0) > 0) {
          slipBonusRapat.innerText = `Rp ${Number(slip.uang_rapat || 0).toLocaleString("id-ID")}`;
          slipBonusRapat.parentElement.style.display = "table-row";
        } else {
          slipBonusRapat.parentElement.style.display = "none";
        }

        const slipBonusNginep = document.getElementById("slip-bonus-nginep");
        if (Number(slip.uang_nginep || 0) > 0) {
          slipBonusNginep.innerText = `Rp ${Number(slip.uang_nginep || 0).toLocaleString("id-ID")}`;
          slipBonusNginep.parentElement.style.display = "table-row";
        } else {
          slipBonusNginep.parentElement.style.display = "none";
        }

        const slipBonusPenjemputan = document.getElementById(
          "slip-bonus-penjemputan",
        );
        if (Number(slip.bonus_penjemputan || 0) > 0) {
          slipBonusPenjemputan.innerText = `Rp ${Number(slip.bonus_penjemputan || 0).toLocaleString("id-ID")}`;
          slipBonusPenjemputan.parentElement.style.display = "table-row";
        } else {
          slipBonusPenjemputan.parentElement.style.display = "none";
        }

        // Total (selalu tampil)
        document.getElementById("slip-total").innerText =
          `Rp ${Number(slip.total_diterima || 0).toLocaleString("id-ID")}`;

        // 2️⃣ Siapkan template
        const templateEl = document.getElementById("template-slip-gambar");
        if (!templateEl) {
          return alert("❌ Template slip tidak ditemukan di halaman!");
        }

        const wrapper = templateEl.parentElement;
        wrapper.classList.remove("hidden");
        wrapper.style.position = "absolute";
        wrapper.style.top = "-9999px";
        wrapper.style.left = "-9999px";

        // 3️⃣ Render ke Canvas dengan timeout
        const canvas = await Promise.race([
          html2canvas(templateEl, {
            scale: 2,
            backgroundColor: "#ffffff",
            useCORS: true,
            allowTaint: true,
            logging: false,
          }),
          new Promise((_, reject) =>
            setTimeout(
              () => reject(new Error("Timeout membuat gambar")),
              10000,
            ),
          ),
        ]);

        // 4️⃣ Download file PNG
        const link = document.createElement("a");
        const safeName = (slip.profiles?.nama || "Karyawan")
          .replace(/[^a-z0-9\-_\s]/gi, "")
          .slice(0, 20);
        link.download = `Slip_${safeName}_${slip.periode}.png`;
        link.href = canvas.toDataURL("image/png", 0.95);

        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        alert(
          `✅ Slip PNG berhasil diunduh!\n\nNama: ${safeName}\nPeriode: ${slip.periode}`,
        );
      } catch (err) {
        console.error("Download Slip Error:", err);
        alert(
          `❌ GAGAL DOWNLOAD SLIP PNG:\n\n${err.message || "Error tidak diketahui"}`,
        );
      } finally {
        // Sembunyikan template
        const templateEl = document.getElementById("template-slip-gambar");
        if (templateEl && templateEl.parentElement) {
          const wrapper = templateEl.parentElement;
          wrapper.classList.add("hidden");
          wrapper.style.position = "";
          wrapper.style.top = "";
          wrapper.style.left = "";
        }
      }
