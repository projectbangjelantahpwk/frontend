---
interface Props {
  title: string;
  requireAuth?: boolean;
}

const { title, requireAuth = true } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/5.png" />
    <script
      is:inline
      src="https://cdn.tailwindcss.com?plugins=forms,container-queries"
    ></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />

    <script is:inline id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "surface-tint": "#1b6d24",
              "on-tertiary-fixed": "#311300",
              "tertiary-fixed": "#ffdcc6",
              "secondary-fixed": "#acf4a4",
              outline: "#707a6c",
              "secondary-container": "#acf4a4",
              secondary: "#2a6b2c",
              "surface-container-lowest": "#ffffff",
              "inverse-on-surface": "#f2f0f0",
              "surface-container": "#efeded",
              "primary-container": "#2e7d32",
              "on-secondary-fixed": "#002203",
              "on-secondary-container": "#307231",
              background: "#fbf9f9",
              tertiary: "#884200",
              "error-container": "#ffdad6",
              error: "#ba1a1a",
              primary: "#0d631b",
              "on-tertiary": "#ffffff",
              "surface-container-high": "#e9e8e7",
              "on-primary-fixed-variant": "#005312",
              "on-surface-variant": "#40493d",
              surface: "#fbf9f9",
              "on-surface": "#1b1c1c",
              "on-tertiary-container": "#ffeee6",
              "tertiary-fixed-dim": "#ffb786",
              "on-secondary": "#ffffff",
              "surface-bright": "#fbf9f9",
              "on-primary-container": "#cbffc2",
              "surface-dim": "#dbdad9",
              "surface-container-highest": "#e3e2e2",
              "on-tertiary-fixed-variant": "#723600",
              "inverse-primary": "#88d982",
              "tertiary-container": "#ad5600",
              "on-primary": "#ffffff",
              "secondary-fixed-dim": "#91d78a",
              "on-secondary-fixed-variant": "#0c5216",
              "outline-variant": "#bfcaba",
              "primary-fixed-dim": "#88d982",
              "surface-container-low": "#f5f3f3",
              "on-background": "#1b1c1c",
              "surface-variant": "#e3e2e2",
              "on-error-container": "#93000a",
              "on-error": "#ffffff",
              "inverse-surface": "#303031",
              "primary-fixed": "#a3f69c",
              "on-primary-fixed": "#002204",
            },
            borderRadius: {
              DEFAULT: "0.125rem",
              lg: "0.25rem",
              xl: "0.5rem",
              full: "0.75rem",
            },
            spacing: {
              md: "16px",
              lg: "24px",
              xs: "4px",
              "container-margin": "16px",
              gutter: "12px",
              base: "8px",
              xl: "32px",
              "touch-target": "48px",
              sm: "8px",
              safe: "env(safe-area-inset-bottom)",
            },
            fontFamily: {
              "body-lg": ["Inter", "sans-serif"],
              "label-sm": ["Inter", "sans-serif"],
              "label-lg": ["Inter", "sans-serif"],
              "headline-lg": ["Inter", "sans-serif"],
              "display-data": ["Inter", "sans-serif"],
              "headline-md": ["Inter", "sans-serif"],
              "body-md": ["Inter", "sans-serif"],
              "headline-lg-mobile": ["Inter", "sans-serif"],
            },
          },
        },
      };
    </script>
    <style is:global>
      /* 🛡️ GLOBAL AUTH BLOCKER: Sembunyikan layar jika butuh login */
      body[data-require-auth="true"] {
        display: none;
      }
      .material-symbols-outlined {
        font-variation-settings:
          "FILL" 0,
          "wght" 400,
          "GRAD" 0,
          "opsz" 24;
      }
      .material-symbols-outlined[data-weight="fill"] {
        font-variation-settings: "FILL" 1;
      }

      /* Animasi Transisi Sidebar & Overlay */
      .sidebar {
        transform: translateX(-100%);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .sidebar.active {
        transform: translateX(0);
      }

      .sidebar-overlay {
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .sidebar-overlay.active {
        opacity: 1;
        visibility: visible;
      }
    </style>
  </head>
  <body
    class="bg-background text-on-background min-h-screen font-body-lg text-body-lg overflow-x-hidden"
    data-require-auth={requireAuth ? "true" : "false"}
  >
    <header
      class="fixed top-0 left-0 w-full z-40 flex justify-between items-center px-4 md:px-lg h-16 bg-surface-container-lowest border-b border-outline-variant shadow-sm"
    >
      <div class="flex items-center gap-2 md:gap-4">
        <button
          id="hamburger-btn"
          class="hidden w-10 h-10 items-center justify-center text-on-surface-variant hover:bg-surface-container-low transition-colors rounded-full focus:outline-none"
        >
          <span class="material-symbols-outlined text-[24px]">menu</span>
        </button>

        <a href="/" class="flex items-center gap-2 group text-decoration-none">
          <div
            class="w-10 h-10 rounded-lg bg-white flex items-center justify-center shadow-sm group-hover:shadow transition-all overflow-hidden p-1"
          >
            <img src="/5.png" alt="Logo" class="w-full h-full object-contain" />
          </div>
          <div class="flex items-baseline">
            <h1
              class="text-xl md:text-2xl font-bold text-on-surface tracking-tight"
            >
              BangJelantah
            </h1>
            <span
              class="hidden sm:inline-block ml-1.5 text-sm font-medium text-on-surface-variant uppercase tracking-widest"
              >CMS</span
            >
          </div>
        </a>
      </div>

      <div class="flex items-center gap-1 md:gap-2">
        <div id="auth-logged-out" class="hidden items-center gap-2">
          <a
            href="/login"
            class="hidden sm:flex items-center px-4 py-2 text-sm font-semibold text-primary hover:bg-surface-container-low rounded-full transition-colors"
          >
            Masuk
          </a>
        </div>

        <div id="auth-logged-in" class="hidden items-center gap-1 md:gap-2">
          <div id="desktop-kas-widget" class="hidden items-center gap-2">
            <div
              class="flex items-center gap-1.5 bg-surface-container-low px-3 py-1.5 rounded-full border border-outline-variant shadow-sm"
            >
              <span class="material-symbols-outlined text-[18px] text-primary"
                >warehouse</span
              >
              <span
                class="text-[10px] uppercase tracking-wider text-on-surface-variant font-bold opacity-70"
                >Gudang:</span
              >
              <span
                id="teks-kas-gudang"
                class="font-mono text-xs font-bold text-primary">Rp 0</span
              >
            </div>

            <div
              class="flex items-center gap-1.5 bg-surface-container-low px-3 py-1.5 rounded-full border border-outline-variant shadow-sm"
            >
              <span class="material-symbols-outlined text-[18px] text-secondary"
                >payments</span
              >
              <span
                class="text-[10px] uppercase tracking-wider text-on-surface-variant font-bold opacity-70"
                >Keuangan:</span
              >
              <span
                id="teks-kas-keuangan"
                class="font-mono text-xs font-bold text-secondary">Rp 0</span
              >
            </div>

            <div
              id="box-kas-owner"
              class="hidden items-center gap-1.5 bg-surface-container-low px-3 py-1.5 rounded-full border border-outline-variant shadow-sm"
            >
              <span
                class="material-symbols-outlined text-[18px] text-purple-600"
                >account_balance_wallet</span
              >
              <span
                class="text-[10px] uppercase tracking-wider text-on-surface-variant font-bold opacity-70"
                >Owner:</span
              >
              <span
                id="teks-kas-owner"
                class="font-mono text-xs font-bold text-purple-600">Rp 0</span
              >
            </div>

            <button
              id="btn-edit-kas"
              onclick="window.bukaModalKas()"
              class="w-8 h-8 flex items-center justify-center bg-surface-container-low border border-outline-variant text-on-surface-variant hover:text-primary hover:bg-surface-container rounded-full shadow-sm transition-colors"
              style="display: none;"
              title="Edit Saldo Kas"
            >
              <span class="material-symbols-outlined text-[16px]">edit</span>
            </button>
          </div>
          <div
            id="mobile-sticky-kas"
            class="hidden fixed bottom-4 left-4 right-4 z-50 bg-surface-container-lowest border border-outline-variant rounded-xl shadow-2xl p-3 items-center justify-between"
          >
            <div class="flex items-center gap-2 w-full justify-around">
              <div class="flex items-center gap-2 flex-1 justify-center">
                <span class="material-symbols-outlined text-[20px] text-primary"
                  >warehouse</span
                >
                <div class="flex flex-col">
                  <span
                    class="text-[9px] uppercase tracking-wider text-on-surface-variant font-bold opacity-60 leading-none mb-0.5"
                    >Gudang</span
                  >
                  <span
                    id="teks-kas-gudang-mobile"
                    class="font-mono text-xs font-bold text-primary">Rp 0</span
                  >
                </div>
              </div>

              <div class="w-[1px] h-6 bg-outline-variant"></div>

              <div class="flex items-center gap-2 flex-1 justify-center">
                <span
                  class="material-symbols-outlined text-[20px] text-secondary"
                  >payments</span
                >
                <div class="flex flex-col">
                  <span
                    class="text-[9px] uppercase tracking-wider text-on-surface-variant font-bold opacity-60 leading-none mb-0.5"
                    >Keuangan</span
                  >
                  <span
                    id="teks-kas-keuangan-mobile"
                    class="font-mono text-xs font-bold text-secondary"
                    >Rp 0</span
                  >
                </div>
              </div>

              <div
                id="divider-kas-owner-mobile"
                class="hidden w-[1px] h-6 bg-outline-variant"
              >
              </div>

              <div
                id="box-kas-owner-mobile"
                class="hidden items-center gap-2 flex-1 justify-center"
              >
                <span
                  class="material-symbols-outlined text-[20px] text-purple-600"
                  >account_balance_wallet</span
                >
                <div class="flex flex-col">
                  <span
                    class="text-[9px] uppercase tracking-wider text-on-surface-variant font-bold opacity-60 leading-none mb-0.5"
                    >Owner</span
                  >
                  <span
                    id="teks-kas-owner-mobile"
                    class="font-mono text-xs font-bold text-purple-600"
                    >Rp 0</span
                  >
                </div>
              </div>
            </div>

            <button
              id="btn-edit-kas-mobile"
              onclick="window.bukaModalKas()"
              class="w-8 h-8 flex items-center justify-center bg-primary text-on-primary rounded-full shadow-md ml-2 transition-transform active:scale-95"
              style="display: none;"
            >
              <span class="material-symbols-outlined text-[16px]">edit</span>
            </button>
          </div>

          <button
            id="btn-edit-kas-mobile"
            onclick="window.bukaModalKas()"
            class="w-8 h-8 flex items-center justify-center bg-primary text-on-primary rounded-full shadow-md ml-2 transition-transform active:scale-95"
            style="display: none;"
          >
            <span class="material-symbols-outlined text-[16px]">edit</span>
          </button>
        </div>

        <!-- BUNGKUS LONCENG DENGAN DIV RELATIVE -->
        <div class="relative">
          <button
            id="notif-btn"
            class="relative w-10 h-10 hidden sm:flex items-center justify-center text-on-surface-variant hover:bg-surface-container-low transition-colors rounded-full"
            type="button"
            aria-label="Notifikasi"
          >
            <span class="material-symbols-outlined">notifications</span>
            <span
              id="notif-badge"
              class="hidden absolute top-2 right-2.5 w-2.5 h-2.5 bg-error rounded-full outline outline-2 outline-surface-container-lowest"
            ></span>
          </button>

          <!-- KOTAK DROPDOWN NOTIFIKASI -->
          <div
            id="notif-dropdown"
            class="hidden absolute right-0 mt-2 w-80 bg-surface-container-lowest rounded-xl shadow-lg border border-outline-variant overflow-hidden z-50"
          >
            <div
              class="p-3 border-b border-outline-variant bg-surface-container-low flex justify-between items-center"
            >
              <h3 class="font-bold text-sm text-on-surface">
                Notifikasi Terbaru
              </h3>
              <button
                id="clear-notif"
                class="text-xs text-primary hover:underline font-medium"
                >Bersihkan</button
              >
            </div>
            <div id="notif-list" class="max-h-80 overflow-y-auto p-2 space-y-1">
              <p
                id="empty-notif"
                class="text-xs text-on-surface-variant text-center py-4"
              >
                Belum ada notifikasi baru.
              </p>
            </div>
          </div>
        </div>

        <div
          class="ml-2 w-9 h-9 rounded-full overflow-hidden border-2 border-primary-container cursor-pointer hover:opacity-90 transition-opacity"
        >
          <img
            id="user-avatar"
            alt="User Avatar"
            class="w-full h-full object-cover"
            src="https://ui-avatars.com/api/?name=Bang+Jelantah&background=2e7d32&color=ffffff"
          />
        </div>
      </div>
    </header>
  </body>

  <div class="relative">
    <div
      id="sidebar-overlay"
      class="sidebar-overlay fixed inset-0 bg-on-surface/40 backdrop-blur-sm z-[50]"
    >
    </div>

    <nav
      id="sidebar"
      class="sidebar fixed left-0 top-0 w-[280px] h-screen z-[60] bg-surface-container-lowest border-r border-outline-variant shadow-2xl flex flex-col p-4 overflow-y-auto"
    >
      <div class="flex items-center justify-between mb-6 pt-2 px-2">
        <div class="flex items-center gap-2">
          <div
            class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-on-primary"
          >
            <img src="/3.png" alt="Logo" class="w-full h-full object-contain" />
          </div>
          <span class="font-bold text-lg text-primary tracking-tight"
            >BJPWK-CMS</span
          >
        </div>
        <button
          id="close-sidebar"
          class="w-8 h-8 flex items-center justify-center text-on-surface-variant hover:bg-surface-container-low transition-colors rounded-full"
          type="button"
          aria-label="Tutup sidebar"
        >
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>

      <div class="flex-1 flex flex-col gap-1">
        <p
          class="px-3 py-2 text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1"
        >
          Menu Utama
        </p>

        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]" data-weight="fill"
            >dashboard</span
          >
          <span class="font-medium text-sm">Dashboard</span>
        </a>
        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/kemitraan"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]">handshake</span>
          <span class="font-medium text-sm">Kemitraan</span>
        </a>
        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/pengumuman"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]">info</span>
          <span class="font-medium text-sm">Pengumaman</span>
        </a>

        <p
          class="px-3 py-2 text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1"
        >
          Operasional
        </p>

        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/manajemen_armada"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]">garage</span>
          <span class="font-medium text-sm">Kendaraan</span>
        </a>
        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/penjemputan"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]"
            >local_shipping</span
          >
          <span class="font-medium text-sm">Penjemputan</span>
        </a>
        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/live-map"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]">map</span>
          <span class="font-medium text-sm">Peta</span>
        </a>
        <p
          class="px-3 py-2 text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1"
        >
          Gudang
        </p>
        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/gudang"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]">inventory_2</span>
          <span class="font-medium text-sm">Gudang</span>
        </a>
        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/InventoryGudang"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]">inventory_2</span>
          <span class="font-medium text-sm">Peralatan Gudang</span>
        </a>
        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/pengolahan-external"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]">factory</span>
          <span class="font-medium text-sm">Pengolahan Eksternal</span>
        </a>

        <p
          class="px-3 py-2 text-xs font-semibold text-on-surface-variant uppercase tracking-wider mt-4 mb-1"
        >
          Karyawan
        </p>

        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/karyawan"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]">people</span>
          <span class="font-medium text-sm">Karyawan</span>
        </a>
        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/gaji_karyawan"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]">payments</span>
          <span class="font-medium text-sm">Gajian Karyawan</span>
        </a>
        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/benefit_karyawan"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]"
            >health_and_safety</span
          >
          <span class="font-medium text-sm">Benefit Karyawan</span>
        </a>

        <p
          class="px-3 py-2 text-xs font-semibold text-on-surface-variant uppercase tracking-wider mt-4 mb-1"
        >
          Manajemen
        </p>

        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/pembelian"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]"
            >shopping_cart_checkout</span
          >
          <span class="font-medium text-sm">Pembelian Barang</span>
        </a>
        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/penjualan"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]">trending_up</span>
          <span class="font-medium text-sm">Penjualan Barang</span>
        </a>
        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/pengeluaran"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]"
            >account_balance_wallet</span
          >
          <span class="font-medium text-sm">Pengeluaran</span>
        </a>
        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/pemasukan"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]"
            >monetization_on</span
          >
          <span class="font-medium text-sm">Pemasukan</span>
        </a>

        <p
          class="px-3 py-2 text-xs font-semibold text-on-surface-variant uppercase tracking-wider mt-4 mb-1"
        >
          Periklanan
        </p>

        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/periklanan"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]">campaign</span>
          <span class="font-medium text-sm">Periklanan</span>
        </a>

        <p
          class="px-3 py-2 text-xs font-semibold text-on-surface-variant uppercase tracking-wider mt-4 mb-1"
        >
          Administrasi
        </p>

        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/hak-akses"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]"
            >manage_accounts</span
          >
          <span class="font-medium text-sm">Hak Akses</span>
        </a>
        <a
          class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl active:scale-[0.98] transition-all"
          href="/database"
          data-nav
        >
          <span class="material-symbols-outlined text-[22px]">inventory</span>
          <span class="font-medium text-sm">Manajemen Database</span>
        </a>
      </div>

      <div
        id="sidebar-footer"
        class="hidden mt-6 pt-4 border-t border-outline-variant"
      >
        <button
          id="btn-logout"
          class="w-full flex items-center justify-center gap-2 bg-error-container text-on-error-container px-4 py-3 rounded-xl font-medium text-sm hover:opacity-90 transition-opacity active:scale-[0.98]"
          type="button"
        >
          <span class="material-symbols-outlined text-[20px]">logout</span>
          <span>Akhiri Sesi</span>
        </button>
      </div>
    </nav>
  </div>
  <div
    class="fixed inset-0 z-[70] bg-black/50 hidden flex items-center justify-center p-4 opacity-0 transition-opacity duration-300"
    id="modal-transfer-kas"
