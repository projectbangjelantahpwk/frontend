---
import GeneralLayout from "../layouts/Layout.astro";
import "bootstrap-icons/font/bootstrap-icons.css";
---

<GeneralLayout title="Keuangan - Manajemen Bang Jelantah">
  <style is:global>
    /* Mengunci layar menjadi blank (putih) sampai skrip memberi izin masuk */
    body {
      display: none;
    }
  </style>
  <div
    class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-4"
  >
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Manajemen Keuangan</h1>
      <p class="text-gray-600">
        Kelola arus kas, penggajian, dan rekapitulasi slip gaji karyawan.
      </p>
    </div>
  </div>

  <div class="mb-6 border-b border-gray-200 overflow-x-auto hide-scrollbar">
    <div class="flex gap-8 min-w-max">
      <button
        class="tab-btn active px-4 py-3 font-medium transition border-b-2 border-green-700 text-green-700"
        data-tab="gaji"
      >
        <i class="bi bi-wallet2 mr-2"></i> Gaji Karyawan
      </button>
      <button
        class="tab-btn px-4 py-3 font-medium transition border-b-2 border-transparent text-gray-600 hover:text-gray-900"
        data-tab="riwayat-gaji"
      >
        <i class="bi bi-clock-history mr-2"></i> Riwayat Gaji Karyawan
      </button>
    </div>
  </div>

  <div id="gaji" class="tab-content block">
    <div
      class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-3"
    >
      <h2 class="text-xl font-bold text-gray-900">
        Rekapitulasi Gaji Karyawan
      </h2>

      <div
        class="bg-gray-100 p-1.5 rounded-xl flex overflow-x-auto hide-scrollbar w-full md:w-auto text-sm font-bold shadow-inner"
      >
        <button
          class="filter-gaji-btn active bg-white shadow-sm px-4 py-2 rounded-lg text-green-700 whitespace-nowrap transition-all"
          >Siklus Mingguan</button
        >
      </div>
    </div>
    <div
      id="gaji-karyawan-container"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      <p class="text-gray-500">Memuat data gaji...</p>
    </div>
  </div>

  <div class="tab-content hidden" id="riwayat-gaji-tab">
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm mb-6">
      <h3 class="text-lg font-bold text-gray-900 mb-4">
        Filter Riwayat Gaji Tahun Berjalan
      </h3>

      <div class="flex flex-wrap gap-4 items-end">
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1"
            >Dari Tanggal</label
          >
          <input
            type="date"
            id="filter-gaji-start"
            class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-700"
          />
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1"
            >Sampai Tanggal</label
          >
          <input
            type="date"
            id="filter-gaji-end"
            class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-700"
          />
        </div>
        <button
          id="btn-filter-gaji"
          class="bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-800 transition"
        >
          Saring Riwayat
        </button>
      </div>
    </div>

    <div id="riwayat-gaji-container" class="space-y-4">
      <p class="text-gray-500 text-sm italic">
        Pilih filter tanggal untuk memuat riwayat.
      </p>
    </div>
  </div>
</GeneralLayout>

<div
  id="modal-pengaturan-global"
  class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0"
>
  <div
    class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300"
  >
    <div
      class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50"
    >
      <h3 class="font-bold text-lg text-gray-990">Pengaturan Gaji Global</h3>
      <button
        onclick="closeModal('modal-pengaturan-global')"
        class="text-gray-400 hover:text-gray-900"
        ><i class="bi bi-x-lg"></i></button
      >
    </div>
    <form id="form-global-gaji" class="p-6 space-y-4">
      <div>
        <label class="block text-sm font-bold text-gray-700 mb-1"
          >Uang Kesehatan (Rp)</label
        >
        <input
          type="number"
          id="g_kesehatan"
          value="0"
          class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600"
        />
      </div>
      <div>
        <label class="block text-sm font-bold text-gray-700 mb-1"
          >Bonus Tepat Waktu (Rp)</label
        >
        <input
          type="number"
          id="g_tepatwaktu"
          value="0"
          class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600"
        />
      </div>
      <div>
        <label class="block text-sm font-bold text-gray-700 mb-1"
          >Bonus Mingguan (Rp)</label
        >
        <input
          type="number"
          id="g_mingguan"
          value="0"
          class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600"
        />
      </div>
      <div>
        <label class="block text-sm font-bold text-gray-700 mb-1"
          >Tarif Lembur per Jam (Rp)</label
        >
        <input
          type="number"
          id="g_lembur"
          value="0"
          class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600"
        />
      </div>
      <button
        type="submit"
        class="w-full bg-gray-900 text-white font-bold py-3 rounded-xl hover:bg-black transition"
        >Simpan Pengaturan</button
      >
    </form>
  </div>
</div>

<div
  id="modal-detail-gaji"
  class="fixed inset-0 bg-black/70 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0 backdrop-blur-sm"
>
  <div
    class="bg-gray-100 rounded-2xl w-full max-w-6xl overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[95vh] shadow-2xl border border-gray-200"
  >
    <div
      class="p-4 border-b border-gray-200 flex justify-between items-center bg-white shrink-0"
    >
      <div class="flex items-center gap-3">
        <div
          class="w-10 h-10 rounded-full bg-green-100 text-green-700 flex items-center justify-center font-bold shadow-sm"
        >
          <i class="bi bi-person-bounding-box text-xl"></i>
        </div>
        <div>
          <h3 class="font-bold text-lg text-gray-900" id="m_nama_karyawan">
            Nama Karyawan
          </h3>
          <p
            class="text-[11px] text-gray-500 font-bold uppercase tracking-wider"
          >
            Setup Parameter & Kalkulasi Gaji
          </p>
        </div>
      </div>
      <button
        onclick="closeModal('modal-detail-gaji')"
        class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-500 hover:bg-red-100 hover:text-red-600 transition"
        ><i class="bi bi-x-lg text-lg"></i></button
      >
    </div>

    <div
      class="p-5 overflow-y-auto flex-1 grid grid-cols-1 lg:grid-cols-2 gap-6"
    >
      <input type="hidden" id="m_karyawan_id" />
      <input type="hidden" id="m_setup_id" />
      <input type="hidden" id="m_slip_id" />
      <input type="hidden" id="setup_kasbon" value="0" />

      <div
        class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex flex-col"
      >
        <h4
          class="text-sm font-bold text-gray-900 mb-4 border-b border-gray-100 pb-3 flex items-center"
        >
          <i class="bi bi-sliders text-blue-600 mr-2 text-lg"></i>Parameter
          Setup Personal
        </h4>

        <div
          class="grid grid-cols-2 gap-3 flex-1 overflow-y-auto pr-2 custom-scrollbar"
        >
          <!-- TAMBAHKAN DROPDOWN SIKLUS GAJI DISINI -->
          <div class="col-span-2">
            <label class="block text-xs font-bold text-blue-900 mb-1"
              ><i class="bi bi-calendar-week"></i> Siklus Pembayaran Gaji</label
            >
            <select
              id="setup_siklus_gaji"
              onchange="window.ubahSiklusUI(); window.kalkulasiRealtimeGaji();"
              class="w-full border border-blue-300 bg-blue-50 text-blue-900 font-bold rounded-lg p-2.5 text-sm outline-none focus:border-blue-600 cursor-pointer"
            >
              <option value="Mingguan">Siklus Mingguan</option>
              <option value="Bulanan">Siklus Bulanan</option>
              <option value="Harian">Siklus Harian</option>
            </select>
          </div>

          <div class="col-span-2 sm:col-span-1">
            <!-- LABEL INI AKAN BERUBAH OTOMATIS OLEH JS -->
            <label
              id="label_gaji_pokok"
              class="block text-xs font-bold text-blue-700 mb-1"
              >Gaji Pokok Mingguan (Rp)</label
            >
            <input
              type="number"
              id="setup_gaji_pokok"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-blue-300 bg-blue-50/50 text-blue-900 font-bold rounded-lg p-2.5 text-sm outline-none focus:border-blue-600"
              placeholder="Misal: 3000000"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Uang Lembur per Jam (Rp)</label
            >
            <input
              type="number"
              id="setup_lembur_menit"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600 font-medium"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Uang Makan per Hari (Rp)</label
            >
            <input
              type="number"
              id="setup_uang_makan"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
              placeholder="0"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Bonus Tepat Waktu /Hari (Rp)</label
            >
            <input
              type="number"
              id="setup_bonus_tepat"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Bonus Mingguan Full (Rp)</label
            >
            <input
              type="number"
              id="setup_bonus_mingguan"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
              placeholder="Misal: 50000"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-red-700 mb-1"
              >Potongan Bonus/Hari Absen</label
            >
            <input
              type="number"
              id="setup_potongan_absen"
              class="w-full border border-red-300 bg-red-50 text-red-900 rounded-lg p-2.5 text-sm outline-none focus:border-red-600 font-bold"
              placeholder="Misal: 5000"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Tarif Uang Rapat /Hadir (Rp)</label
            >
            <input
              type="number"
              id="setup_uang_rapat"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
              placeholder="Misal: 50000"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Tarif Uang Nginep /Malam (Rp)</label
            >
            <input
              type="number"
              id="setup_uang_nginep"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
              placeholder="Misal: 150000"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Tunjangan Kesehatan (Rp)</label
            >
            <input
              type="number"
              id="setup_uang_kesehatan"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
              placeholder="0"
            />
          </div>

          <div
            class="col-span-2 bg-purple-50 p-3.5 rounded-xl border border-purple-200 mt-2"
          >
            <label class="flex items-center justify-between cursor-pointer">
              <div class="pr-4">
                <span
                  class="text-xs font-black text-purple-900 uppercase tracking-wide block"
                  ><i class="bi bi-lightning-charge-fill mr-1"></i> Mode Gaji Flat
                  / Jam Fleksibel</span
                >
                <span
                  class="text-[10px] text-purple-700 block font-semibold mt-0.5 leading-relaxed"
                  >Aktifkan untuk karyawan khusus. Jam kerja berantakan/lintas
                  hari tetap dihitung hadir normal & lembur otomatis dimatikan
                  (0 Jam).</span
                >
              </div>
              <input
                type="checkbox"
                id="chk_bypass_jam_kerja"
                onchange="window.kalkulasiRealtimeGaji()"
                class="w-4 h-4 text-purple-600 rounded focus:ring-purple-500 cursor-pointer shrink-0"
              />
            </label>
          </div>
          <div
            class="col-span-2 bg-orange-50 p-3.5 rounded-xl border border-orange-200 mt-2"
          >
            <label class="flex items-center justify-between cursor-pointer">
              <div class="pr-4">
                <span
                  class="text-xs font-black text-orange-900 uppercase tracking-wide block"
                  ><i class="bi bi-inbox-fill mr-1"></i> Mode Gaji Per Jerigen</span
                >
                <span
                  class="text-[10px] text-orange-700 block font-semibold mt-0.5 leading-relaxed"
                  >Gaji otomatis dihitung dari jumlah jerigen di gudang minggu
                  ini. Gaji pokok harian dimatikan.</span
                >
              </div>
              <input
                type="checkbox"
                id="chk_gaji_jerigen"
                onchange="window.toggleGajiJerigen(); window.kalkulasiRealtimeGaji();"
                class="w-4 h-4 text-orange-600 rounded focus:ring-orange-500 cursor-pointer shrink-0"
              />
            </label>

            <div
              id="opsi_jerigen"
              class="hidden mt-3 pt-3 border-t border-orange-200"
            >
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label
                    class="block text-[10px] font-bold text-orange-800 mb-1"
                    >Tarif per Jerigen (Rp)</label
                  >
                  <input
                    type="number"
                    id="setup_tarif_jerigen"
                    onchange="window.kalkulasiRealtimeGaji()"
                    class="w-full border border-orange-300 rounded-lg p-2 text-sm font-bold text-orange-900 outline-none focus:border-orange-600 shadow-inner"
                    placeholder="Misal: 5000"
                  />
                </div>
                <div>
                  <label
                    class="block text-[10px] font-bold text-orange-800 mb-1"
                    >Bonus Jerigen Pribadi (Rp)</label
                  >
                  <input
                    type="number"
                    id="setup_bonus_jerigen"
                    onchange="window.kalkulasiRealtimeGaji()"
                    class="w-full border border-orange-300 rounded-lg p-2 text-sm font-bold text-orange-900 outline-none focus:border-orange-600 shadow-inner"
                    placeholder="Misal: 50000"
                  />
                </div>
              </div>
              <div
                class="mt-3 text-xs font-bold bg-orange-100 text-orange-900 p-2.5 rounded-lg flex justify-between items-center border border-orange-200"
              >
                <span
                  ><i class="bi bi-box-seam mr-1"></i> Jerigen Terkumpul Minggu Ini:</span
                >
                <span
                  id="info_total_jerigen_minggu"
                  class="text-lg font-black font-mono">0 Pcs</span
                >
              </div>
            </div>
          </div>

          <div
            class="col-span-2 border-t border-dashed border-gray-300 pt-3 mt-1"
          >
          </div>

          <div
            class="col-span-2 bg-red-50 p-3.5 rounded-xl border border-red-200 mt-2"
          >
            <div class="flex justify-between items-center mb-2.5">
              <label
                class="text-xs font-bold text-red-800 uppercase flex items-center"
                ><i class="bi bi-wallet2 mr-1"></i> Potong Kasbon Periode Ini</label
              >
              <div
                class="text-[9px] font-black bg-red-200 text-red-900 px-2 py-1 rounded shadow-sm"
              >
                TOTAL HUTANG: <span id="info_total_kasbon" class="font-mono"
                  >Rp 0</span
                >
              </div>
            </div>
            <input
              type="number"
              id="potongan_kasbon_sekarang"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-red-300 bg-white text-red-900 font-bold font-mono rounded-lg p-2.5 text-sm outline-none focus:border-red-600 shadow-inner"
              placeholder="Ketik nominal potongan..."
            />
          </div>
        </div>

        <div class="mt-4 pt-4 border-t border-gray-100 shrink-0">
          <button
            onclick="simpanSetupGaji()"
            class="w-full bg-gray-900 text-white px-4 py-3 rounded-xl font-bold text-sm hover:bg-black transition shadow-md flex justify-center items-center gap-2"
          >
            <i class="bi bi-floppy"></i> Simpan Parameter Ke Database
          </button>
        </div>
      </div>

      <div
        class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex flex-col relative overflow-hidden"
      >
        <div
          class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-green-400 to-blue-500"
        >
        </div>
        <h4
          class="text-sm font-bold text-gray-900 mb-4 border-b border-gray-100 pb-3 flex items-center"
        >
          <i class="bi bi-receipt-cutoff text-green-600 mr-2 text-lg"
          ></i>Kalkulasi Slip Gaji Terkini
        </h4>

        <div class="flex-1 overflow-y-auto pr-2 custom-scrollbar">
          <div class="space-y-3" id="m_rincian_list"></div>
        </div>

        <div class="shrink-0 mt-4">
          <div
            class="bg-gradient-to-br from-green-700 to-green-800 text-white p-5 rounded-xl flex justify-between items-center shadow-lg border border-green-600"
          >
            <span
              class="font-bold text-sm uppercase tracking-wider text-green-100"
              >Total Diterima:</span
            >
            <span
              class="text-3xl font-black font-mono tracking-tight"
              id="m_total_gaji">Rp 0</span
            >
          </div>

          <div class="flex gap-3 mt-4">
            <button
              id="btn-draf-gaji"
              onclick="simpanSlipGaji('Menunggu')"
              class="flex-1 bg-white border-2 border-gray-200 text-gray-700 font-bold py-3.5 rounded-xl hover:bg-gray-50 hover:border-gray-300 transition shadow-sm text-sm flex justify-center items-center gap-2"
            >
              <i class="bi bi-save"></i> Simpan Draf
            </button>
            <button
              id="btn-bayar-gaji"
              onclick="simpanSlipGaji('ACC')"
              class="flex-[1.5] bg-green-600 text-white font-bold py-3.5 rounded-xl hover:bg-green-700 transition shadow-md text-sm uppercase tracking-wider flex justify-center items-center gap-2"
            >
              <i class="bi bi-check2-circle text-lg"></i> Approve & Lunas
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div
  id="modal-kasir-gaji"
  class="fixed inset-0 bg-black/60 hidden items-center justify-center z-[60] p-4 transition-opacity opacity-0"
>
  <div
    class="bg-white rounded-2xl w-full max-w-sm overflow-hidden transform scale-95 transition-transform duration-300 shadow-2xl border border-gray-100"
  >
    <div
      class="p-4 border-b border-gray-100 bg-blue-50 flex justify-between items-center"
    >
      <div>
        <h3 class="font-bold text-base text-blue-900">Kasir Pembayaran Gaji</h3>
        <p class="text-[10px] font-bold text-blue-700 uppercase tracking-wider">
          Metode Split Payment Brankas
        </p>
      </div>
      <button
        onclick="closeModal('modal-kasir-gaji')"
        class="text-blue-400 hover:text-blue-900"
        ><i class="bi bi-x-lg"></i></button
      >
    </div>
    <div class="p-5 space-y-4">
      <div
        class="bg-gray-100 p-3 rounded-xl text-center border border-gray-200 shadow-inner"
      >
        <p class="text-xs text-gray-500 font-bold uppercase mb-1">
          Total Tagihan Gaji Lunas
        </p>
        <p
          class="text-2xl font-black text-gray-900 font-mono"
          id="kasir_total_tagihan"
        >
          Rp 0
        </p>
      </div>
      <div
        class="space-y-3 bg-green-50/50 p-3 rounded-xl border border-green-100"
      >
        <div>
          <label
            class="block text-[10px] font-bold text-green-800 uppercase mb-1"
            >Ambil dr Uang Keuangan</label
          >
          <input
            type="number"
            id="kasir_keuangan"
            value="0"
            oninput="window.kalkulasiKasir()"
            class="w-full border border-green-300 rounded-lg p-2 text-sm font-bold text-green-900 outline-none focus:border-green-600 focus:ring-1 focus:ring-green-600 bg-white"
          />
        </div>
        <div>
          <label
            class="block text-[10px] font-bold text-green-800 uppercase mb-1"
            >Ambil dr Uang Gudang</label
          >
          <input
            type="number"
            id="kasir_gudang"
            value="0"
            oninput="window.kalkulasiKasir()"
            class="w-full border border-green-300 rounded-lg p-2 text-sm font-bold text-green-900 outline-none focus:border-green-600 focus:ring-1 focus:ring-green-600 bg-white"
          />
        </div>
        <div>
          <label
            class="block text-[10px] font-bold text-green-800 uppercase mb-1"
            >Ambil dr Uang Owner</label
          >
          <input
            type="number"
            id="kasir_owner"
            value="0"
            oninput="window.kalkulasiKasir()"
            class="w-full border border-green-300 rounded-lg p-2 text-sm font-bold text-green-900 outline-none focus:border-green-600 focus:ring-1 focus:ring-green-600 bg-white"
          />
        </div>
      </div>
      <div
        class="flex justify-between items-center text-xs font-bold p-2.5 rounded-lg bg-red-50 border border-red-200 transition-colors"
        id="kasir_sisa_box"
      >
        <span class="text-red-800">Sisa Belum Terbayar:</span>
        <span id="kasir_sisa" class="text-red-700 font-mono text-sm">Rp 0</span>
      </div>
      <button
        id="btn-eksekusi-bayar"
        onclick="window.eksekusiBayarGaji()"
        class="w-full bg-blue-700 text-white font-bold py-3.5 rounded-xl hover:bg-blue-800 disabled:opacity-50 disabled:cursor-not-allowed transition shadow-sm font-mono text-sm uppercase tracking-wide"
        disabled
      >
        <i class="bi bi-safe2 mr-2"></i> POTONG KAS & BAYAR
      </button>
    </div>
  </div>
</div>
<div
  id="modal-edit-riwayat"
  class="fixed inset-0 bg-black/60 hidden items-center justify-center z-[70] p-4 transition-opacity opacity-0"
>
  <div
    class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300"
  >
    <div
      class="p-4 border-b border-gray-100 bg-blue-50 flex justify-between items-center"
    >
      <div>
        <h3 class="font-bold text-base text-blue-900">Koreksi Riwayat Gaji</h3>
        <p
          class="text-[10px] font-bold text-blue-700 uppercase tracking-wider"
          id="edit_riwayat_nama"
        >
          -
        </p>
      </div>
      <button
        onclick="closeModal('modal-edit-riwayat')"
        class="text-blue-400 hover:text-blue-900"
        ><i class="bi bi-x-lg"></i></button
      >
    </div>
    <div class="p-5 overflow-y-auto max-h-[70vh] space-y-3">
      <input type="hidden" id="er_slip_id" />
      <input type="hidden" id="er_status" />
      <input type="hidden" id="er_total_lama" />

      <div>
        <label class="block text-xs font-bold text-gray-700 mb-1"
          >Gaji Pokok Bulanan (Rp)</label
        >
        <input
          type="number"
          id="er_gaji"
          oninput="window.hitungTotalEditRiwayat()"
          class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
        />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1"
            >Uang Lembur per Menit (Rp)</label
          >
          <input
            type="number"
            id="er_lembur"
            oninput="window.hitungTotalEditRiwayat()"
            class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
          />
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-700 mb-1"
            >Uang Makan per Hari (Rp)</label
          >
          <input
            type="number"
            id="er_makan"
            oninput="window.hitungTotalEditRiwayat()"
            class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
          />
        </div>
        <div>
          <label class="block text-xs font-bold text-green-700 mb-1"
            >Total Bonus (Rp)</label
          >
          <input
            type="number"
            id="er_bonus"
            oninput="window.hitungTotalEditRiwayat()"
            class="w-full border border-green-300 bg-green-50 rounded-lg p-2 text-sm outline-none focus:border-green-600"
          />
        </div>
        <div>
          <label class="block text-xs font-bold text-red-700 mb-1"
            >Potongan Kasbon (Rp)</label
          >
          <input
            type="number"
            id="er_kasbon"
            oninput="window.hitungTotalEditRiwayat()"
            class="w-full border border-red-300 bg-red-50 rounded-lg p-2 text-sm outline-none focus:border-red-600"
          />
        </div>
      </div>

      <div
        class="mt-4 bg-gray-100 p-3 rounded-xl border border-gray-200 text-center shadow-inner"
      >
        <p class="text-xs text-gray-500 font-bold uppercase mb-1">
          Total Final Diubah Menjadi
        </p>
        <p
          class="text-2xl font-black text-gray-900 font-mono"
          id="er_total_baru"
        >
          Rp 0
        </p>
        <p class="text-[9px] text-orange-600 font-bold mt-1 italic">
          *Jika status sudah LUNAS, selisih nominal otomatis
          ditarik/dikembalikan ke Kas Keuangan.
        </p>
      </div>

      <button
        id="btn-save-er"
        onclick="window.simpanEditRiwayat()"
        class="w-full mt-2 bg-blue-700 text-white font-bold py-3 rounded-xl hover:bg-blue-800 transition shadow-sm font-mono text-sm uppercase tracking-wide"
      >
        <i class="bi bi-floppy mr-2"></i> Simpan Koreksi Slip
      </button>
    </div>
  </div>
</div>
<script is:inline>
  let dataGlobalGaji = null;
  let dataKaryawan = [];

  document.addEventListener("DOMContentLoaded", async () => {
    // === 🛡️ GATEKEEPER KEUANGAN ===
    const allowedRoles = ["owner", "hrd", "keuangan", "it"];
    const client = window.supabase || supabase;

    const {
      data: { session },
    } = await client.auth.getSession();
    if (!session) return window.location.replace("/");

    const { data: prof } = await client
      .from("profiles")
      .select("role")
      .eq("id", session.user.id)
      .single();

    if (!allowedRoles.includes(prof?.role)) {
      alert(
        `Akses Ditolak! Role Anda (${prof?.role || "Guest"}) dilarang masuk ke Keuangan.`,
      );
      return window.location.replace("/");
    }
    document.body.style.display = "block";

    // Setup Batasan Tanggal Otomatis
    const tahunAktif = new Date().getFullYear();
    const awalTahun = `${tahunAktif}-01-01`;
    const waktuLokal = new Date();
    const offset = waktuLokal.getTimezoneOffset() * 60000;
    const hariIni = new Date(waktuLokal - offset).toISOString().split("T")[0];

    const inputStart = document.getElementById("filter-gaji-start");
    const inputEnd = document.getElementById("filter-gaji-end");
    if (inputStart && inputEnd) {
      inputStart.min = awalTahun;
      inputStart.max = hariIni;
      inputStart.value = awalTahun;

      inputEnd.min = awalTahun;
      inputEnd.max = hariIni;
      inputEnd.value = hariIni;
    }

    // ==========================================
    // 1. FETCH DATA KEUANGAN (CLIENT-SIDE)
    // ==========================================
    async function loadKeuanganData() {
      if (!window.supabase) return;
      try {
        const { data: listMitra } = await window.supabase
          .from("mitra")
          .select("id, nama_mitra")
          .order("nama_mitra", { ascending: true });
        window.allMitraGlobal = listMitra || [];
        const { data: globalGaji } = await window.supabase
          .from("pengaturan_gaji_global")
          .select("*")
          .single();
        dataGlobalGaji = globalGaji;
        if (globalGaji) {
          document.getElementById("g_kesehatan").value =
            globalGaji.uang_kesehatan || 0;
          document.getElementById("g_tepatwaktu").value =
            globalGaji.bonus_tepat_waktu || 0;
          document.getElementById("g_mingguan").value =
            globalGaji.bonus_mingguan || 0;
          document.getElementById("g_lembur").value =
            globalGaji.tarif_lembur_perjam || 0;
        }

        const { data: karyawan, error: errKaryawan } = await window.supabase
          .from("profiles")
          .select(
            "id, nama, role, foto_profil, setup_gaji(*), presensi(tanggal, status_tiba, waktu_tiba, waktu_pulang), slip_gaji(*)",
          )
          .neq("role", "owner");

        if (errKaryawan) {
          alert("Error Supabase (Data Karyawan): " + errKaryawan.message);
          console.error("Detail Error:", errKaryawan);
        }

        dataKaryawan = karyawan || [];
        const contKaryawan = document.getElementById("gaji-karyawan-container");
        let htmlKaryawan = "";
        if (dataKaryawan.length > 0) {
          dataKaryawan.forEach((k) => {
            const jumlahHadir = k.presensi?.length || 0;
            // 🔥 Ambil 2 huruf depan untuk inisial (misal: "Budi Santoso" -> "BS")
            const inisial = k.nama
              ? k.nama
                  .split(" ")
                  .map((n) => n[0])
                  .join("")
                  .substring(0, 2)
                  .toUpperCase()
              : "U";

            // 🔥 Beri warna hijau elegan khas Keuangan jika pakai inisial
            const avatarKomponen = k.foto_profil
              ? `<img src="${k.foto_profil}" class="w-12 h-12 rounded-full object-cover border-2 border-green-200 shadow-sm shrink-0" />`
              : `<div class="w-12 h-12 rounded-full bg-green-100 border border-green-200 flex items-center justify-center text-green-700 font-bold text-lg shadow-sm shrink-0">${inisial}</div>`;

            const peran = k.tipe_kendaraan
              ? k.tipe_kendaraan.replace("_", " ")
              : k.role || "Karyawan";
            const setup =
              k.setup_gaji && k.setup_gaji.length > 0 ? k.setup_gaji[0] : {};
            const tarif = Number(setup.gaji_menit || 0).toLocaleString("id-ID");

            // 🔥 TAHAP 2: BIKIN BADGE INDIKATOR GAJI FLAT / BYPASS
            const badgeBypass = setup.bypass_jam_kerja
              ? `<span class="px-2 py-0.5 rounded text-[9px] font-black bg-purple-100 text-purple-700 border border-purple-200 uppercase tracking-wider shadow-sm flex items-center gap-0.5 font-sans"><i class="bi bi-lightning-charge-fill"></i> Gaji Flat</span>`
              : "";

            htmlKaryawan += `
                    <div class="karyawan-card bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden flex flex-col transition-all" data-periode="Bulanan">
                        <div class="bg-gradient-to-r from-green-50 to-green-100 px-6 py-4 flex items-center justify-between border-b border-green-200">
                            <div class="flex items-center gap-4">
                                ${avatarKomponen} 
                                <div>
                                    <h3 class="font-bold text-gray-900 flex items-center gap-1.5 flex-wrap">
                                        ${k.nama} 
                                        <span class="px-2 py-0.5 rounded text-[9px] font-black bg-blue-200 text-blue-800 uppercase tracking-wider shadow-sm">MINGGUAN</span>
                                        ${badgeBypass}
                                    </h3>
                                    <p class="text-xs font-semibold text-gray-600 capitalize mt-0.5">${peran}</p>
                                </div>
                            </div>
                        </div>
                        <div class="p-6 flex-1 flex flex-col">
                            <div class="space-y-2 mb-6 text-sm">
                                <div class="flex justify-between"><span class="text-gray-500">Gaji per Mingguan:</span> <span class="font-medium text-gray-900">Rp ${tarif}</span></div>
                                <div class="flex justify-between"><span class="text-gray-500">Hadir Bulan Ini:</span> <span class="font-medium text-green-600">${jumlahHadir} Hari</span></div>
                            </div>
                            <button onclick="window.openModalGaji('${k.id}')" class="mt-auto w-full flex items-center justify-center gap-2 px-4 py-3 bg-white border-2 border-green-700 text-green-700 rounded-xl font-bold hover:bg-green-50 transition active:scale-95">
                                <i class="bi bi-calculator"></i> Setup & Slip Gaji
                            </button>
                        </div>
                    </div>`;
          });
        } else {
          htmlKaryawan =
            '<p class="text-gray-500">Belum ada data karyawan.</p>';
        }
        contKaryawan.innerHTML = htmlKaryawan;
      } catch (error) {
        console.error("Gagal load data keuangan:", error);
      }
    }

    await loadKeuanganData();

    // ==========================================
    // 2. TAB SWITCHING LOGIC
    // ==========================================
    const tabButtons = document.querySelectorAll(".tab-btn");
    const tabContents = document.querySelectorAll(".tab-content");
    tabButtons.forEach((button) => {
      button.addEventListener("click", function () {
        let tabName = this.getAttribute("data-tab");

        const tabIdMap = {
          gaji: "gaji",
          "riwayat-gaji": "riwayat-gaji-tab",
        };

        tabName = tabIdMap[tabName] || tabName;

        tabButtons.forEach((btn) => {
          btn.classList.remove("active", "border-green-700", "text-green-700");
          btn.classList.add("border-transparent", "text-gray-600");
        });
        tabContents.forEach((content) => {
          content.classList.add("hidden");
          content.classList.remove("block");
        });

        this.classList.add("active", "border-green-700", "text-green-700");
        this.classList.remove("border-transparent", "text-gray-600");

        const activeTab = document.getElementById(tabName);
        if (activeTab) {
          activeTab.classList.remove("hidden");
          activeTab.classList.add("block");
        } else {
          console.warn(`Tab dengan ID '${tabName}' tidak ditemukan!`);
        }
      });
    });

    // ==========================================
    // 3. MODAL CONTROLS & FUNCTIONS
    // ==========================================
    window.openModal = function (id) {
      const m = document.getElementById(id);
      if (!m) return;
      m.classList.remove("hidden");
      m.classList.add("flex");
      setTimeout(() => {
        m.classList.remove("opacity-0");
        const c = m.querySelector("div");
        if (c) c.classList.remove("scale-95");
      }, 10);

      // 🔥 Kunci body layar belakang biar gak bisa di-scroll
      document.body.style.overflow = "hidden";
    };

    window.closeModal = function (id) {
      const m = document.getElementById(id);
      if (!m) return;
      m.classList.add("opacity-0");
      const c = m.querySelector("div");
      if (c) c.classList.add("scale-95");
      setTimeout(() => {
        m.classList.add("hidden");
        m.classList.remove("flex");
      }, 300);

      // 🔥 Lepas kunci scroll saat modal ditutup
      document.body.style.overflow = "";
    };

    // UPDATE PENGATURAN GLOBAL
    document
      .getElementById("form-global-gaji")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!window.supabase) return;
        const btn = e.target.querySelector('button[type="submit"]');
        btn.innerText = "Menyimpan...";

        try {
          await window.supabase
            .from("pengaturan_gaji_global")
            .update({
              uang_kesehatan: document.getElementById("g_kesehatan").value,
              bonus_tepat_waktu: document.getElementById("g_tepatwaktu").value,
              bonus_mingguan: document.getElementById("g_mingguan").value,
              tarif_lembur_perjam: document.getElementById("g_lembur").value,
            })
            .eq("id", 1);
          alert("Pengaturan Global berhasil diperbarui!");
          window.location.reload();
        } catch (err) {
          alert(err.message);
          btn.innerText = "Simpan Pengaturan";
        }
      });

    window.currentSalaryData = null;

    // FUNGSI UNTUK MENGUBAH LABEL UI BERDASARKAN SIKLUS
    window.ubahSiklusUI = function () {
      const siklus = document.getElementById("setup_siklus_gaji").value;
      const labelGaji = document.getElementById("label_gaji_pokok");

      if (siklus === "Bulanan") {
        labelGaji.innerText = "Gaji Pokok Bulanan (Rp)";
      } else if (siklus === "Harian") {
        labelGaji.innerText = "Gaji Pokok Harian (Rp)";
      } else {
        labelGaji.innerText = "Gaji Pokok Mingguan (Rp)";
      }
    };

    // PERBARUI FUNGSI MESIN WAKTU
    window.openModalGaji = async function (empId) {
      const emp = dataKaryawan.find((k) => String(k.id) === String(empId));
      if (!emp) return alert("Data karyawan tidak ditemukan!");

      document.getElementById("m_karyawan_id").value = emp.id;
      document.getElementById("m_nama_karyawan").innerText = emp.nama;

      let setup = {};
      try {
        const { data: liveSetup } = await window.supabase
          .from("setup_gaji")
          .select("*")
          .eq("user_id", emp.id)
          .maybeSingle();
        if (liveSetup) setup = liveSetup;
      } catch (e) {
        console.error("Gagal narik setup:", e);
      }

      document.getElementById("m_setup_id").value = setup.id || "";

      // SUNTIK SIKLUS & GAJI POKOK
      document.getElementById("setup_siklus_gaji").value =
        setup.siklus_gaji || "Mingguan";
      document.getElementById("setup_gaji_pokok").value =
        setup.gaji_menit || setup.gaji_pokok || 0;
      window.ubahSiklusUI(); // Panggil fungsi ubah label

      document.getElementById("setup_lembur_menit").value =
        setup.uang_lembur_menit || 0;
      document.getElementById("setup_uang_makan").value = setup.uang_makan || 0;
      document.getElementById("setup_bonus_tepat").value =
        setup.bonus_tepat_waktu || 0;
      document.getElementById("setup_bonus_mingguan").value =
        setup.bonus_mingguan || 0;
      document.getElementById("setup_potongan_absen").value =
        setup.potongan_bonus_mingguan || 0;
      document.getElementById("setup_uang_kesehatan").value =
        setup.uang_kesehatan || 0;
      document.getElementById("setup_uang_rapat").value = setup.uang_rapat || 0;
      document.getElementById("setup_uang_nginep").value =
        setup.uang_nginep || 0;

      const totalHutangKasbon = parseFloat(setup.kasbon) || 0;
      document.getElementById("info_total_kasbon").innerText =
        "Rp " + totalHutangKasbon.toLocaleString("id-ID");
      document.getElementById("potongan_kasbon_sekarang").value = "";

      document.getElementById("chk_bypass_jam_kerja").checked =
        setup.bypass_jam_kerja || false;
      document.getElementById("chk_gaji_jerigen").checked =
        setup.is_gaji_jerigen || false;
      document.getElementById("setup_tarif_jerigen").value =
        setup.tarif_jerigen || 0;
      document.getElementById("setup_bonus_jerigen").value =
        setup.bonus_jerigen_manual || 0;

      // 1. Definisikan dulu fungsinya (dengan ID input yang sudah diupdate ke setup_gaji_pokok)
      window.toggleGajiJerigen = function () {
        const chkJerigen = document.getElementById("chk_gaji_jerigen");
        const opsiJerigen = document.getElementById("opsi_jerigen");
        const inpGaji = document.getElementById("setup_gaji_pokok"); // ID sudah disesuaikan

        if (chkJerigen && opsiJerigen && inpGaji) {
          const isJ = chkJerigen.checked;
          opsiJerigen.style.display = isJ ? "block" : "none";
          inpGaji.disabled = isJ;
          isJ
            ? inpGaji.classList.add("opacity-50", "bg-gray-100")
            : inpGaji.classList.remove("opacity-50", "bg-gray-100");
        }
      };

      // 2. Baru panggil fungsinya
      window.toggleGajiJerigen();

      // 🔥 LOGIKA MESIN WAKTU DINAMIS BERDASARKAN SIKLUS 🔥
      const siklusAktif = document.getElementById("setup_siklus_gaji").value;
      const tglLokalObj = new Date(waktuLokal - offset);
      let tglMulai, tglAkhir;

      if (siklusAktif === "Bulanan") {
        // SET KE TANGGAL 1 SAMPAI AKHIR BULAN INI
        const tahun = tglLokalObj.getFullYear();
        const bulan = tglLokalObj.getMonth();
        const tglSatu = new Date(tahun, bulan, 1);
        const tglAkhirBulan = new Date(tahun, bulan + 1, 0); // Hari terakhir bulan ini

        // Format ulang dengan timezone offset agar tidak meleset
        tglMulai = new Date(tglSatu.getTime() - offset)
          .toISOString()
          .split("T")[0];
        tglAkhir = new Date(tglAkhirBulan.getTime() - offset)
          .toISOString()
          .split("T")[0];
      } else if (siklusAktif === "Harian") {
        // HARI INI SAJA
        tglMulai = tglLokalObj.toISOString().split("T")[0];
        tglAkhir = tglMulai;
      } else {
        // DEFAULT: MINGGUAN (Senin ke Sabtu/Minggu)
        const day = tglLokalObj.getDay() || 7;
        tglLokalObj.setHours(0, 0, 0, 0);
        const senin = new Date(tglLokalObj);
        senin.setDate(tglLokalObj.getDate() - (day - 1));
        const sabtu = new Date(senin);
        sabtu.setDate(senin.getDate() + 6); // Set sampai hari Minggu

        tglMulai = senin.toISOString().split("T")[0];
        tglAkhir = sabtu.toISOString().split("T")[0];
      }

      window.currentSalaryData = {
        empId: emp.id,
        tglMulai,
        tglAkhir,
        sisaKasbonDb: totalHutangKasbon,
        siklusGaji: siklusAktif, // Kirim data siklus ke Deno
      };

      // Cek slip draft
      const slip = (emp.slip_gaji || []).find(
        (s) => s.periode === tglAkhir && s.status === "Menunggu",
      );
      document.getElementById("m_slip_id").value = slip ? slip.id : "";

      window.kalkulasiRealtimeGaji();
      window.openModal("modal-detail-gaji");
    };

    window.kalkulasiRealtimeGaji = async function () {
      const d = window.currentSalaryData;
      if (!d) return;

      // Tampilkan loading muter di layar
      document.getElementById("m_total_gaji").innerText = "Menghitung...";
      document.getElementById("m_rincian_list").innerHTML =
        `<p class="text-center text-sm text-gray-500 py-4"><i class="bi bi-arrow-repeat animate-spin inline-block mr-2"></i> Sinkronisasi Kalkulator Server...</p>`;

      const potKasbonInput = document.getElementById(
        "potongan_kasbon_sekarang",
      ).value;
      const potonganManual =
        potKasbonInput === "" ? null : parseFloat(potKasbonInput);

      try {
        // 🔥 MINTA DENO BUAT NGITUNGIN 🔥
        const { data, error } = await window.supabase.functions.invoke(
          "gaji-karyawan",
          {
            // <--- UBAH DISINI
            body: {
              empId: d.empId,
              tglMulai: d.tglMulai,
              tglAkhir: d.tglAkhir,
              action: "kalkulasi",
              potonganKasbonManual: isNaN(potonganManual)
                ? null
                : potonganManual,
              siklusGaji: d.siklusGaji, // Pastikan ini ikut terkirim
            },
          },
        );

        if (error) throw error;
        const res = data.data; // Tangkap hasil matang dari server

        // 🔥 HIJACK KALKULASI JIKA MODE JERIGEN AKTIF 🔥
        const isJerigen = document.getElementById("chk_gaji_jerigen").checked;
        const tarifJ =
          parseFloat(document.getElementById("setup_tarif_jerigen").value) || 0;
        const bonusJ =
          parseFloat(document.getElementById("setup_bonus_jerigen").value) || 0;
        const totalJ = window.currentSalaryData.totalJerigenMinggu || 0;

        if (isJerigen) {
          // 1. Ganti Gaji Pokok menjadi Total Jerigen x Tarif
          res.valGajiNormal = totalJ * tarifJ;
          // 2. Timpa Bonus Mingguan otomatis dengan Bonus Pribadi
          res.valBonusMingguan = bonusJ;
          // 3. Kalkulasi ulang Grand Total
          res.grandTotal =
            res.valGajiNormal +
            res.valBonusMingguan +
            (res.valLembur || 0) +
            (res.valMakan || 0) +
            (res.valBonusTepat || 0) +
            (res.valKesehatan || 0) +
            (res.valRapat || 0) +
            (res.valNginep || 0) -
            (res.valPotonganKasbon || 0);
        }

        // Simpan state final yang udah di-hijack
        d.finalState = {
          grandTotal: res.grandTotal,
          valGajiNormal: res.valGajiNormal,
          valBonusMingguan: res.valBonusMingguan,
        };

        // Modifikasi Label UI
        const labelGajiPokok = isJerigen
