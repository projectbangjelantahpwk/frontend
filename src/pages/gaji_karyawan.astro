      document.getElementById("prev_nama_periode").innerText =
        `${slip.profiles?.nama || "Unknown"} | ${slip.periode}`;

      const totalBonus =
        Number(slip.bonus_tepat_waktu || 0) +
        Number(slip.bonus_mingguan || 0) +
        Number(slip.uang_kesehatan || 0) +
        Number(slip.bonus_penjemputan || 0) +
        Number(slip.uang_rapat || 0) +
        Number(slip.uang_nginep || 0);

      // 🔥 RENDER KOMPONEN DINAMIS (LAIN-LAIN) 🔥
      let htmlLainLain = "";
      if (slip.lain_lain && slip.lain_lain.length > 0) {
