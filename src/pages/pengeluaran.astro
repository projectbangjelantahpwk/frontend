    window.simpanEditPengeluaran = async function(e) {
        e.preventDefault();
        if(!window.supabase) return;

        const idInduk = document.getElementById('edit_peng_id').value;
        const tanggalBaru = document.getElementById('edit_peng_tgl').value;
        const btnSave = document.getElementById('btn-save-peng');

        btnSave.innerText = "Menyimpan Data...";
        btnSave.disabled = true;

        try {
            const itemRows = document.querySelectorAll('.peng-item-row');
            const batchPromises = [];

            itemRows.forEach(row => {
                const rincianId = row.getAttribute('data-id');
                const kategoriTerpilih = row.querySelector('.peng_item_select').value;
                const nominalBaru = parseFloat(row.querySelector('.peng_item_nominal').value) || 0;
                const teksCustom = row.querySelector('.peng_item_custom').value.trim();
                const keteranganBaru = row.querySelector('.edit_item_keterangan').value.trim();

                let finalNamaItem = kategoriTerpilih === 'Lain-lain' ? (teksCustom || 'Lain-lain') : kategoriTerpilih;
                
                // Update rinciannya saja, sisanya Trigger DB yang atur totalnya
                const task = window.supabase.from('rincian_pengeluaran').update({
                    nama_item: finalNamaItem,
                    nominal: nominalBaru,
                    keterangan: keteranganBaru || null
                }).eq('id', rincianId);
                batchPromises.push(task);
            });

            // Hanya update tanggal di tabel induk
            const { error: errInduk } = await window.supabase.from('pengeluaran').update({
                tanggal: tanggalBaru
            }).eq('id', idInduk);
            
            if(errInduk) throw errInduk;

            if(batchPromises.length > 0) {
                await Promise.all(batchPromises);
            }

            alert("Mantap! Data rincian dikoreksi dan total disesuaikan server.");
            window.location.reload();
        } catch(err) {
            console.error(err);
            alert("Gagal memperbarui pengeluaran: " + err.message);
            btnSave.innerText = "SIMPAN PERUBAHAN DATA"; btnSave.disabled = false;
        }
    };

