---
import Layout from "../layouts/Layout.astro"; // Sesuaikan path folder Layout lu
import "bootstrap-icons/font/bootstrap-icons.css";
---

<Layout title="Leaderboard Mitra - Kemitraan">
  <div class="max-w-7xl mx-auto flex flex-col h-full gap-lg p-4 md:p-6">
    <!-- 1. HEADER & FILTER BULAN -->
    <div
      class="flex flex-col md:flex-row justify-between items-start md:items-center gap-md mb-4"
    >
      <div>
        <h1
          class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-primary"
        >
          Papan Peringkat
        </h1>
        <p class="font-body-md text-body-md text-on-surface-variant mt-xs">
          Pantau peringkat dan jumlah setoran komoditas seluruh mitra.
        </p>
      </div>

      <div class="w-full md:w-auto flex items-center gap-3">
        <label
          class="text-xs font-bold text-on-surface-variant hidden md:block"
        >
          Pilih Bulan:
        </label>
        <div class="relative min-w-[150px] shrink-0">
          <input
            type="month"
            id="input-periode-leaderboard"
            class="w-full h-11 px-3 py-2 text-sm font-bold rounded-full bg-surface-container-lowest text-primary border border-outline-variant outline-none cursor-pointer text-center block shadow-sm transition-all hover:border-primary font-mono focus:ring-1 focus:ring-primary"
            title="Ubah Periode"
          />
        </div>
      </div>
    </div>

    <!-- 2. KONTEN UTAMA LEADERBOARD -->
    <div class="flex flex-col flex-1 gap-md">
      <div
        class="bg-surface-container-lowest rounded-xl border border-outline-variant p-md md:p-lg flex flex-col shadow-sm"
      >
        <!-- TOMBOL FILTER KOMODITAS -->
        <div
          class="flex flex-nowrap items-center overflow-x-auto hide-scrollbar bg-surface-container-low p-1.5 rounded-xl border border-outline-variant gap-1 shadow-inner w-full mb-6"
        >
          <button
            onclick="window.changeLeaderboardTab(this, 'Juara Umum')"
            class="leaderboard-tab-btn flex-1 px-3 py-2.5 text-xs font-bold rounded-lg bg-white shadow-sm text-primary transition-all whitespace-nowrap text-center"
            >🏆 Umum</button
          >
          <button
            onclick="window.changeLeaderboardTab(this, 'Minyak Jelantah')"
            class="leaderboard-tab-btn flex-1 px-3 py-2.5 text-xs font-medium rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest transition-all whitespace-nowrap text-center"
            >Minyak</button
          >
          <button
            onclick="window.changeLeaderboardTab(this, 'Ampas')"
            class="leaderboard-tab-btn flex-1 px-3 py-2.5 text-xs font-medium rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest transition-all whitespace-nowrap text-center"
            >Ampas</button
          >
          <button
            onclick="window.changeLeaderboardTab(this, 'Kriuk')"
            class="leaderboard-tab-btn flex-1 px-3 py-2.5 text-xs font-medium rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest transition-all whitespace-nowrap text-center"
            >Kriuk</button
          >
          <button
            onclick="window.changeLeaderboardTab(this, 'Tepung')"
            class="leaderboard-tab-btn flex-1 px-3 py-2.5 text-xs font-medium rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest transition-all whitespace-nowrap text-center"
            >Tepung</button
          >
          <button
            onclick="window.changeLeaderboardTab(this, 'Spinner')"
            class="leaderboard-tab-btn flex-1 px-3 py-2.5 text-xs font-medium rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest transition-all whitespace-nowrap text-center"
            >Spinner</button
          >
        </div>

        <!-- GRID KARTU JUARA -->
        <div
          id="leaderboard-live-list"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-md overflow-y-auto min-h-[200px]"
        >
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    // ==========================================
    // 1. INISIALISASI VARIABEL & WAKTU
    // ==========================================
    const tglSkrg = new Date();
    const bulanSkrg = `${tglSkrg.getFullYear()}-${String(tglSkrg.getMonth() + 1).padStart(2, "0")}`;
    const inputPeriode = document.getElementById("input-periode-leaderboard");

    if (inputPeriode) {
      inputPeriode.value = bulanSkrg;
      // Auto-refresh saat bulan diganti
      inputPeriode.addEventListener("change", () =>
        window.generateLeaderboard(),
      );
    }

    // Wadah penyimpanan data agar pindah tab kategori secepat kilat
    window.leaderboardCache = {
      "Juara Umum": [],
      "Minyak Jelantah": [],
      Ampas: [],
      Kriuk: [],
      Tepung: [],
      Spinner: [],
    };

    window.activeLeaderboardKat = "Juara Umum";

    // ==========================================
    // 2. OTENTIKASI & TRIGGER PERTAMA
    // ==========================================
    document.addEventListener("DOMContentLoaded", async () => {
      if (!window.supabase) return console.error("Supabase tidak terhubung!");

      // --- CEK ROLE & KEAMANAN ---
      const allowedRoles = ["owner", "hrd", "admin", "keuangan", "it"];
      const client = window.supabase || supabase;
      const {
        data: { session },
      } = await client.auth.getSession();

      if (!session) return window.location.replace("/");

      const { data: prof } = await client
        .from("profiles")
        .select("role")
        .eq("id", session.user.id)
        .single();

      if (!allowedRoles.includes(prof?.role)) {
        alert(
          `Akses Ditolak! Role Anda (${prof?.role || "Guest"}) dilarang masuk ke halaman ini.`,
        );
        return window.location.replace("/");
      }

      // Buka gembok layar jika lolos pengecekan
      document.body.style.display = "block";

      // Tembak fetch data pertama kali halaman dimuat
      if (inputPeriode) window.generateLeaderboard();
    });

    // ==========================================
    // 3. FUNGSI FETCH DATA LEADERBOARD
    // ==========================================
    window.generateLeaderboard = async function () {
      const rawPeriode = document.getElementById(
        "input-periode-leaderboard",
      )?.value;
      if (!rawPeriode || !window.supabase) return;

      const periodeDB = rawPeriode;
      const container = document.getElementById("leaderboard-live-list");

      // Tampilkan status loading
      if (container) {
        container.innerHTML =
          '<p class="text-sm text-on-surface-variant italic text-center py-10 col-span-full">Menghitung peringkat live...</p>';
      }

      try {
        // Tarik data kumulatif mingguan sesuai periode bulan (YYYY-MM)
        const { data: rekapData, error } = await window.supabase
          .from("rekap_kumulatif_mingguan_mitra")
          .select("*")
          .eq("periode", periodeDB);

        if (error) throw error;

        // Reset Cache
        window.leaderboardCache = {
          "Juara Umum": [],
          "Minyak Jelantah": [],
          Ampas: [],
          Kriuk: [],
          Tepung: [],
          Spinner: [],
        };

        // Agregasi Data per Mitra
        const aggregatedData = {};
        rekapData.forEach((row) => {
          if (!aggregatedData[row.mitra_id]) {
            aggregatedData[row.mitra_id] = {
              id: row.mitra_id,
              nama: row.nama_mitra || "Mitra Lapangan",
              minyak: 0,
              ampas: 0,
              kriuk: 0,
              tepung: 0,
              spinner: 0,
            };
          }

          aggregatedData[row.mitra_id].minyak += Number(
            row.minyak_jelantah || 0,
          );
          aggregatedData[row.mitra_id].ampas += Number(row.ampas || 0);
          aggregatedData[row.mitra_id].kriuk += Number(row.kriuk || 0);
          aggregatedData[row.mitra_id].tepung += Number(row.tepung || 0);
          aggregatedData[row.mitra_id].spinner += Number(row.spinner || 0);
        });

        // Masukkan Hasil Agregasi ke Kategori Masing-masing
        Object.values(aggregatedData).forEach((r) => {
          const totalUmum = r.minyak + r.ampas + r.kriuk + r.tepung + r.spinner;

          if (totalUmum > 0)
            window.leaderboardCache["Juara Umum"].push({
              nama: r.nama,
              kg: totalUmum,
              id: r.id,
            });
          if (r.minyak > 0)
            window.leaderboardCache["Minyak Jelantah"].push({
              nama: r.nama,
              kg: r.minyak,
              id: r.id,
            });
          if (r.ampas > 0)
            window.leaderboardCache["Ampas"].push({
              nama: r.nama,
              kg: r.ampas,
              id: r.id,
            });
          if (r.kriuk > 0)
            window.leaderboardCache["Kriuk"].push({
              nama: r.nama,
              kg: r.kriuk,
              id: r.id,
            });
          if (r.tepung > 0)
            window.leaderboardCache["Tepung"].push({
              nama: r.nama,
              kg: r.tepung,
              id: r.id,
            });
          if (r.spinner > 0)
            window.leaderboardCache["Spinner"].push({
              nama: r.nama,
              kg: r.spinner,
              id: r.id,
            });
        });

        // Render sesuai tab yang aktif (default: Juara Umum)
        window.renderLeaderboardSesuaiFilter();
      } catch (e) {
        console.error("Gagal Generate Leaderboard:", e);
        if (container) {
          container.innerHTML =
            '<p class="text-sm text-error italic text-center py-10 col-span-full">Gagal memuat data peringkat dari server.</p>';
        }
      }
    };

    // ==========================================
    // 4. FUNGSI NAVIGASI TAB KATEGORI
    // ==========================================
    window.changeLeaderboardTab = function (btn, kategori) {
      window.activeLeaderboardKat = kategori;

      // Reset warna tab
      document.querySelectorAll(".leaderboard-tab-btn").forEach((b) => {
        b.classList.remove(
          "bg-white",
          "shadow-sm",
          "text-primary",
          "font-bold",
        );
        b.classList.add("text-on-surface-variant", "font-medium");
      });

      // Highlight tab yang diklik
      btn.classList.add("bg-white", "shadow-sm", "text-primary", "font-bold");
      btn.classList.remove("text-on-surface-variant", "font-medium");

      window.renderLeaderboardSesuaiFilter();
    };

    // ==========================================
    // 5. FUNGSI RENDER GRID JUARA KE LAYAR
    // ==========================================
    window.renderLeaderboardSesuaiFilter = function () {
      const kategori = window.activeLeaderboardKat;
      const container = document.getElementById("leaderboard-live-list");
      if (!container) return;

      // Ambil top 5 terbesar berdasarkan kategori
      const data = (window.leaderboardCache[kategori] || [])
        .sort((a, b) => b.kg - a.kg)
        .slice(0, 5);

      if (data.length === 0) {
        container.innerHTML = `<p class="text-xs text-on-surface-variant italic text-center py-10 col-span-full border-2 border-dashed border-outline-variant rounded-xl">Belum ada penyetor di kategori ${kategori} pada bulan ini.</p>`;
        return;
      }

      container.innerHTML = data
        .map((m, i) => {
          let bgMedali =
            "bg-surface-variant text-on-surface-variant border-outline-variant";
          let iconMedali = "";

          if (i === 0) {
            bgMedali =
              "bg-yellow-500 text-white font-bold border-yellow-600 shadow-sm";
            iconMedali = "🥇 "; // Medali Emas
          } else if (i === 1) {
            bgMedali =
              "bg-slate-400 text-white font-bold border-slate-500 shadow-sm";
            iconMedali = "🥈 "; // Medali Perak
          } else if (i === 2) {
            bgMedali =
              "bg-amber-700 text-white font-bold border-amber-800 shadow-sm";
            iconMedali = "🥉 "; // Medali Perunggu
          }

          return `
          <div class="flex items-center justify-between bg-surface-container-lowest p-4 rounded-2xl border border-outline-variant shadow-xs hover:border-primary/50 transition-all duration-200 animate-in fade-in slide-in-from-bottom-2">
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-8 h-8 flex items-center justify-center rounded-full text-xs ${bgMedali} shrink-0">${i + 1}</span>
              <div class="truncate">
                <p class="text-sm font-bold text-on-surface truncate leading-tight">${iconMedali}${m.nama}</p>
                <p class="text-[10px] text-on-surface-variant font-bold uppercase tracking-wider mt-0.5">${kategori}</p>
              </div>
            </div>
            <div class="text-right shrink-0 ml-2">
              <span class="font-mono text-xs font-bold text-green-700 bg-green-50 border border-green-100 px-3 py-1.5 rounded-xl shadow-sm block">${m.kg.toFixed(1)} Kg</span>
            </div>
          </div>`;
        })
        .join("");
    };
  </script>
</Layout>
