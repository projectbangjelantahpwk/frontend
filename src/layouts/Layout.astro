    async function renderAuthUI(session) {
      const loggedOutView = document.getElementById("auth-logged-out");
      const loggedInView = document.getElementById("auth-logged-in");
      const sidebarFooter = document.getElementById("sidebar-footer");
      const hamburgerBtn = document.getElementById("hamburger-btn");
      const avatarImg = document.getElementById("user-avatar");

      if (session) {
        loggedOutView?.classList.add("hidden");
        loggedOutView?.classList.remove("flex");

        loggedInView?.classList.remove("hidden");
        loggedInView?.classList.add("flex");

        hamburgerBtn?.classList.remove("hidden");
        hamburgerBtn?.classList.add("flex");

        sidebarFooter?.classList.remove("hidden");

        // LOGIKA CACHE HEMAT API (HANYA FETCH JIKA BELUM ADA)
        if (avatarImg) {
          const cacheKey = `profile_${session.user.id}`;
          const cachedString = localStorage.getItem(cacheKey);

          // 1. TAMPILKAN CACHE DULU: Render instan tanpa nunggu loading database
          if (cachedString) {
            const profile = JSON.parse(cachedString);
            updateAvatarElement(avatarImg, profile.nama, profile.foto_profil);
          }

          // 2. CEK UPDATE DIAM-DIAM: Tarik data terbaru dari Supabase di *background*
          try {
            const { data: profileData, error } = await supabase
              .from("profiles")
              .select("nama, foto_profil")
              .eq("id", session.user.id)
              .single();

            if (!error && profileData) {
              // Cek apakah data dari database BERBEDA dengan memori lokal
              const isDataChanged =
                !cachedString ||
                JSON.parse(cachedString).foto_profil !==
                  profileData.foto_profil ||
                JSON.parse(cachedString).nama !== profileData.nama;

              // 3. JIKA ADA FOTO/NAMA BARU: Timpa cache lama & ubah gambar di layar!
              if (isDataChanged) {
                localStorage.setItem(cacheKey, JSON.stringify(profileData));
                updateAvatarElement(
                  avatarImg,
                  profileData.nama,
                  profileData.foto_profil,
                );
              }
            }
          } catch (err) {
            console.error("Gagal mengecek update profil:", err);
          }
        }
        return;
      }

      // Kondisi saat User Logout (Hapus Cache)
      if (session === null) {
        // Cari key profile lokal lalu hapus saat logout
        const semuaKey = Object.keys(localStorage);
        semuaKey.forEach((key) => {
          if (key.startsWith("profile_")) localStorage.removeItem(key);
        });
      }

      loggedOutView?.classList.remove("hidden");
      loggedOutView?.classList.add("flex");

      loggedInView?.classList.add("hidden");
      loggedInView?.classList.remove("flex");

      hamburgerBtn?.classList.add("hidden");
      hamburgerBtn?.classList.remove("flex");

      sidebarFooter?.classList.add("hidden");
      // @ts-ignore
      window.closeAppSidebar?.();
    }

    // Helper fungsi pembantu untuk mengganti attribute src pada tag img
    function updateAvatarElement(element, nama, urlFoto) {
      if (urlFoto) {
        element.setAttribute("src", urlFoto);
      } else {
        const namaUser = nama || "Karyawan";
        element.setAttribute(
          "src",
          `https://ui-avatars.com/api/?name=${encodeURIComponent(namaUser)}&background=2e7d32&color=ffffff`,
        );
      }
    }

    async function initAuthCheck() {
      const requireAuth = document.body.dataset.requireAuth === "true";
      const currentPath = window.location.pathname;

      const { data, error } = await supabase.auth.getSession();
      const session = data?.session ?? null;

      if (error) {
        console.error("Gagal membaca session Supabase:", error.message);
      }

      // JIKA BELUM LOGIN: Layar tetap 'display: none', langsung tendang!
      if (requireAuth && !session && currentPath !== "/login") {
        window.location.replace("/login");
        return; // Proses berhenti di sini, jadi WebSocket nggak akan terpicu!
      }

      // 🔥 JIKA LOLOS AUTH: Buka gembok layarnya!
      if (requireAuth) {
        document.body.style.display = "block";
      }

      renderAuthUI(session);

      // 🔥 JALANKAN WEBSOCKET HANYA JIKA USER SUDAH VALID LOGIN 🔥
      if (session) {
        console.log("🔌 Session valid, starting realtime...");
        setTimeout(() => {
          if (window.supabase) {
            initRealtimeNotifications();
          }
        }, 1000);
      }
    }

    function initLogout() {
      const logoutButton = document.getElementById("btn-logout");

      logoutButton?.addEventListener("click", async () => {
        logoutButton.setAttribute("disabled", "true");

        const { error } = await supabase.auth.signOut();

        if (error) {
          console.error("Gagal logout:", error.message);
          logoutButton.removeAttribute("disabled");
          return;
        }
        window.location.replace("/login");
      });
    }

    // ==========================================
    // LOGIKA FETCH & UPDATE KAS PERUSAHAAN (STICKY)
    // ==========================================
    async function loadDataKas() {
      try {
        const { data, error } = await window.supabase
          .from("kas_perusahaan")
          .select("uang_gudang, uang_owner")
          .eq("id", 1)
          .single();

        if (error) throw error;

        const inputGudang = document.getElementById("input_uang_gudang");
        const inputOwner = document.getElementById("input_uang_owner");

        if (inputGudang) inputGudang.value = data?.uang_gudang || 0;
        if (inputOwner) inputOwner.value = data?.uang_owner || 0;

        window.kalkulasiTotalKas();
      } catch (err) {
        console.error("Gagal load data kas:", err);
      }
    }

    window.loadRiwayatTransfer = async function () {
      console.log("🔍 [DEBUG] Memulai penarikan riwayat transfer...");

      // 🔥 ANTI-CRASH: Cari SEMUA kontainer, jaga-jaga kalau ada HTML duplikat!
      const containers = document.querySelectorAll("#list-riwayat-transfer");
      console.log(
        "🔍 [DEBUG] Jumlah kotak riwayat yang ditemukan di HTML:",
        containers.length,
      );

      if (containers.length === 0) {
        return console.error(
          "❌ [DEBUG] Elemen dengan ID 'list-riwayat-transfer' TIDAK DITEMUKAN!",
        );
      }

      try {
        const client =
          window.supabase ||
          (typeof supabase !== "undefined" ? supabase : null);
        if (!client) throw new Error("Koneksi Supabase belum siap!");

        const { data, error } = await client
          .from("riwayat_transfer_kas")
          .select("*")
          .order("created_at", { ascending: false })
          .limit(5);

        if (error) throw error;
        console.log("🔍 [DEBUG] Data riwayat dari database:", data);

        let htmlToInject = "";
        if (!data || data.length === 0) {
          htmlToInject =
            '<p class="text-gray-400 italic text-center py-4 text-[11px]">Belum ada riwayat mutasi.</p>';
        } else {
          data.forEach((r) => {
            const tgl = new Date(r.created_at).toLocaleString("id-ID", {
              dateStyle: "short",
              timeStyle: "short",
            });
            const strSumber = r.sumber || "";
            const strTujuan = r.tujuan || "";
            const formatNama = (col) =>
              col
                .replace("uang_", "Uang ")
                .replace(/\b\w/g, (c) => c.toUpperCase());

            htmlToInject += `
                    <div class="bg-gray-50 border border-gray-200 p-2 rounded-lg flex justify-between items-center shadow-sm mb-2">
                        <div>
                            <p class="font-bold text-gray-800 text-[11px]">${formatNama(strSumber)} <i class="bi bi-arrow-right text-blue-600 font-black"></i> ${formatNama(strTujuan)}</p>
                            <p class="text-[9px] text-gray-400 mt-0.5">Admin • ${tgl}</p>
                        </div>
                        <span class="font-mono text-[11px] font-black text-green-700">+ Rp ${Number(r.nominal).toLocaleString("id-ID")}</span>
                    </div>`;
          });
        }

        // 🔥 SUNTIK KE SEMUA KOTAK RIWAYAT YANG DITEMUKAN
        containers.forEach((container, index) => {
          container.innerHTML = htmlToInject;
          console.log(
            `✅ [DEBUG] Kotak riwayat ke-${index + 1} berhasil di-update ke layar!`,
          );
        });
      } catch (err) {
        console.error("❌ [DEBUG] Error saat eksekusi:", err);
        containers.forEach((container) => {
          container.innerHTML = `<p class="text-red-500 text-center py-4 text-[11px] font-bold">Gagal memuat: ${err.message}</p>`;
        });
      }
    };

    // Auto-Kalkulasi format Rupiah setiap kali diketik
    window.kalkulasiTotalKas = function () {
      const elGudang = document.getElementById("input_uang_gudang");
      const elOwner = document.getElementById("input_uang_owner");
      const elTeks = document.getElementById("teks_total_kas");

      const gudang = elGudang ? parseFloat(elGudang.value) || 0 : 0;
      const owner = elOwner ? parseFloat(elOwner.value) || 0 : 0;
      const total = gudang + owner;

      if (elTeks) {
        elTeks.innerText = new Intl.NumberFormat("id-ID", {
          style: "currency",
          currency: "IDR",
          minimumFractionDigits: 0,
        }).format(total);
      }
    };

    // Pasang event listener untuk input pengetikan realtime
    document
      .getElementById("input_uang_gudang")
      ?.addEventListener("input", window.kalkulasiTotalKas);
    document
      .getElementById("input_uang_owner")
      ?.addEventListener("input", window.kalkulasiTotalKas);

    // Eksekusi Update ke Database saat Form di-Submit
    document
      .getElementById("form-kas-perusahaan")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = document.getElementById("btn-submit-kas");
        if (!btn) return;

        const textLama = btn.innerText;
        btn.innerText = "Menyimpan...";
        btn.disabled = true;

        try {
          const payload = {
            uang_gudang:
              parseFloat(document.getElementById("input_uang_gudang").value) ||
              0,
            uang_owner:
              parseFloat(document.getElementById("input_uang_owner").value) ||
              0,
            updated_at: new Date().toISOString(),
          };

          const { error } = await window.supabase
            .from("kas_perusahaan")
            .update(payload)
            .eq("id", 1);
          if (error) throw error;

          alert("✅ Saldo Kas Perusahaan berhasil diperbarui!");
          // Otomatis tutup/minimize body widget setelah sukses simpan
          document.getElementById("sticky-kas-body")?.classList.add("hidden");
        } catch (err) {
          alert("Gagal menyimpan saldo: " + err.message);
        } finally {
          btn.innerText = textLama;
          btn.disabled = false;
        }
      });

    runWhenReady(() => {
      initSidebar();
      initAuthCheck();
      initLogout();
      initNotifUI();
      //initRealtimeNotifications(); // Menjalankan Notifikasi Real-Time
    });
