---
import GeneralLayout from "../layouts/Layout.astro";
import "bootstrap-icons/font/bootstrap-icons.css";
---

<GeneralLayout title="Keuangan - Manajemen Bang Jelantah">
  <style is:global>
    /* Mengunci layar menjadi blank (putih) sampai skrip memberi izin masuk */
    body {
      display: none;
    }
  </style>
  <div
    class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-4"
  >
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Manajemen Keuangan</h1>
      <p class="text-gray-600">
        Kelola arus kas, penggajian, dan rekapitulasi slip gaji karyawan.
      </p>
    </div>
  </div>

  <div class="mb-6 border-b border-gray-200 overflow-x-auto hide-scrollbar">
    <div class="flex gap-8 min-w-max">
      <button
        class="tab-btn active px-4 py-3 font-medium transition border-b-2 border-green-700 text-green-700"
        data-tab="gaji"
      >
        <i class="bi bi-wallet2 mr-2"></i> Gaji Karyawan
      </button>
      <button
        class="tab-btn px-4 py-3 font-medium transition border-b-2 border-transparent text-gray-600 hover:text-gray-900"
        data-tab="riwayat-gaji"
      >
        <i class="bi bi-clock-history mr-2"></i> Riwayat Gaji Karyawan
      </button>
    </div>
  </div>

  <div id="gaji" class="tab-content block">
    <div
      class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-3"
    >
      <h2 class="text-xl font-bold text-gray-900">
        Rekapitulasi Gaji Karyawan
      </h2>

      <div
        class="bg-gray-100 p-1.5 rounded-xl flex overflow-x-auto hide-scrollbar w-full md:w-auto text-sm font-bold shadow-inner"
      >
        <button
          class="filter-gaji-btn active bg-white shadow-sm px-4 py-2 rounded-lg text-green-700 whitespace-nowrap transition-all"
          >Siklus Mingguan</button
        >
      </div>
    </div>
    <div
      id="gaji-karyawan-container"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      <p class="text-gray-500">Memuat data gaji...</p>
    </div>
  </div>

  <div class="tab-content hidden" id="riwayat-gaji-tab">
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm mb-6">
      <h3 class="text-lg font-bold text-gray-900 mb-4">
        Filter Riwayat Gaji Tahun Berjalan
      </h3>

      <div class="flex flex-wrap gap-4 items-end">
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1"
            >Dari Tanggal</label
          >
          <input
            type="date"
            id="filter-gaji-start"
            class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-700"
          />
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1"
            >Sampai Tanggal</label
          >
          <input
            type="date"
            id="filter-gaji-end"
            class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-700"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1"
            >Karyawan</label
          >
          <select
            id="filter-gaji-user"
            class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-700 min-w-[150px]"
          >
            <option value="semua">Semua Karyawan</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1"
            >Item Gaji</label
          >
          <select
            id="filter-gaji-item"
            class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-700 min-w-[150px]"
          >
            <option value="semua">Semua (Grand Total)</option>
            <option value="gaji_karyawan">Gaji Pokok</option>
            <option value="uang_lembur">Uang Lembur</option>
            <option value="uang_makan">Uang Makan</option>
            <option value="uang_transport">Uang Transport</option>
            <option value="uang_talangan">Uang Talangan</option>
            <option value="uang_rapat">Uang Rapat</option>
            <option value="bonus"
              >Total Bonus (Mingguan/Tepat Waktu/Sehat)</option
            >
            <option value="potongan_bonus_mingguan"
              >Potongan Bonus/Hari Absen</option
            >
            <option value="kasbon">Potongan Kasbon</option>
          </select>
        </div>

        <div class="flex gap-2">
          <button
            id="btn-filter-gaji"
            class="bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-800 transition shadow-sm"
          >
            <i class="bi bi-funnel"></i> Filter
          </button>
          <button
            onclick="window.exportExcelRiwayat()"
            class="bg-emerald-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-emerald-700 transition shadow-sm"
            title="Download Excel"
          >
            <i class="bi bi-file-earmark-excel"></i> Excel
          </button>
          <button
            onclick="window.exportSlipAkumulasiFilter()"
            class="bg-cyan-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-cyan-700 transition shadow-sm ml-2"
            title="Download Slip PNG - Data Terakumulasi Sesuai Filter"
          >
            <i class="bi bi-images"></i> Image (Akumulasi)
          </button>
        </div>
      </div>
    </div>

    <div id="riwayat-gaji-container" class="space-y-4">
      <p class="text-gray-500 text-sm italic">
        Pilih filter tanggal untuk memuat riwayat.
      </p>
    </div>

    <div
      class="bg-blue-50 p-4 rounded-xl border border-blue-200 flex justify-between items-center mt-6 shadow-sm"
    >
      <span class="font-bold text-blue-900 uppercase tracking-wider text-sm"
        ><i class="bi bi-calculator mr-2"></i>Total Akumulasi Filter:</span
      >
      <span
        id="riwayat-total-akumulasi"
        class="text-2xl font-black text-blue-700 font-mono">Rp 0</span
      >
    </div>
  </div>
</GeneralLayout>

<div
  id="modal-pengaturan-global"
  class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0"
>
  <div
    class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300"
  >
    <div
      class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50"
    >
      <h3 class="font-bold text-lg text-gray-990">Pengaturan Gaji Global</h3>
      <button
        onclick="closeModal('modal-pengaturan-global')"
        class="text-gray-400 hover:text-gray-900"
        ><i class="bi bi-x-lg"></i></button
      >
    </div>
    <form id="form-global-gaji" class="p-6 space-y-4">
      <div>
        <label class="block text-sm font-bold text-gray-700 mb-1"
          >Uang Kesehatan (Rp)</label
        >
        <input
          type="number"
          id="g_kesehatan"
          value="0"
          class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600"
        />
      </div>
      <div>
        <label class="block text-sm font-bold text-gray-700 mb-1"
          >Bonus Tepat Waktu (Rp)</label
        >
        <input
          type="number"
          id="g_tepatwaktu"
          value="0"
          class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600"
        />
      </div>
      <div>
        <label class="block text-sm font-bold text-gray-700 mb-1"
          >Bonus Mingguan (Rp)</label
        >
        <input
          type="number"
          id="g_mingguan"
          value="0"
          class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600"
        />
      </div>
      <div>
        <label class="block text-sm font-bold text-gray-700 mb-1"
          >Tarif Lembur per Menit (Rp)</label
        >
        <input
          type="number"
          id="g_lembur"
          value="0"
          class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600"
        />
      </div>
      <button
        type="submit"
        class="w-full bg-gray-900 text-white font-bold py-3 rounded-xl hover:bg-black transition"
        >Simpan Pengaturan</button
      >
    </form>
  </div>
</div>

<div
  id="modal-detail-gaji"
  class="fixed inset-0 bg-black/70 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0 backdrop-blur-sm"
>
  <div
    class="bg-gray-100 rounded-2xl w-full max-w-6xl overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[95vh] shadow-2xl border border-gray-200"
  >
    <div
      class="p-4 border-b border-gray-200 flex justify-between items-center bg-white shrink-0"
    >
      <div class="flex items-center gap-3">
        <div
          class="w-10 h-10 rounded-full bg-green-100 text-green-700 flex items-center justify-center font-bold shadow-sm"
        >
          <i class="bi bi-person-bounding-box text-xl"></i>
        </div>
        <div>
          <h3 class="font-bold text-lg text-gray-900" id="m_nama_karyawan">
            Nama Karyawan
          </h3>
          <p
            class="text-[11px] text-gray-500 font-bold uppercase tracking-wider"
          >
            Setup Parameter & Kalkulasi Gaji
          </p>
        </div>
      </div>
      <button
        onclick="closeModal('modal-detail-gaji')"
        class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-500 hover:bg-red-100 hover:text-red-600 transition"
        ><i class="bi bi-x-lg text-lg"></i></button
      >
    </div>

    <div
      class="p-5 overflow-y-auto flex-1 grid grid-cols-1 lg:grid-cols-2 gap-6"
    >
      <input type="hidden" id="m_karyawan_id" />
      <input type="hidden" id="m_setup_id" />
      <input type="hidden" id="m_slip_id" />
      <input type="hidden" id="setup_kasbon" value="0" />

      <div
        class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex flex-col"
      >
        <h4
          class="text-sm font-bold text-gray-900 mb-4 border-b border-gray-100 pb-3 flex items-center"
        >
          <i class="bi bi-sliders text-blue-600 mr-2 text-lg"></i>Parameter
          Setup Personal
        </h4>

        <div
          class="grid grid-cols-2 gap-3 flex-1 overflow-y-auto pr-2 custom-scrollbar"
        >
          <!-- TAMBAHKAN DROPDOWN SIKLUS GAJI DISINI -->
          <div class="col-span-2">
            <label class="block text-xs font-bold text-blue-900 mb-1"
              ><i class="bi bi-calendar-week"></i> Siklus Pembayaran Gaji</label
            >
            <select
              id="setup_siklus_gaji"
              onchange="window.ubahSiklusUI(); window.kalkulasiRealtimeGaji();"
              class="w-full border border-blue-300 bg-blue-50 text-blue-900 font-bold rounded-lg p-2.5 text-sm outline-none focus:border-blue-600 cursor-pointer"
            >
              <option value="Mingguan">Siklus Mingguan</option>
              <option value="Bulanan">Siklus Bulanan</option>
              <option value="Harian">Siklus Harian</option>
            </select>
          </div>

          <div class="col-span-2 sm:col-span-1">
            <!-- LABEL INI AKAN BERUBAH OTOMATIS OLEH JS -->
            <label
              id="label_gaji_pokok"
              class="block text-xs font-bold text-blue-700 mb-1"
              >Gaji Pokok Mingguan (Rp)</label
            >
            <input
              type="number"
              id="setup_gaji_pokok"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-blue-300 bg-blue-50/50 text-blue-900 font-bold rounded-lg p-2.5 text-sm outline-none focus:border-blue-600"
              placeholder="Misal: 3000000"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Uang Lembur per Menit (Rp)</label
            >
            <input
              type="number"
              id="setup_lembur_menit"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600 font-medium"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Uang Makan per Hari (Rp)</label
            >
            <input
              type="number"
              id="setup_uang_makan"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
              placeholder="0"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Uang Makan Malam (Rp)</label
            >
            <input
              type="number"
              id="setup_uang_makan_malam"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
              placeholder="0"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Bonus Tepat Waktu /Hari (Rp)</label
            >
            <input
              type="number"
              id="setup_bonus_tepat"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Bonus Penjemputan (Rp)</label
            >
            <input
              type="number"
              id="setup_bonus_penjemputan"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
              placeholder="0"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Bonus Mingguan Full (Rp)</label
            >
            <input
              type="number"
              id="setup_bonus_mingguan"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
              placeholder="Misal: 50000"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-red-700 mb-1"
              >Potongan Bonus/Hari Absen</label
            >
            <input
              type="number"
              id="setup_potongan_absen"
              class="w-full border border-red-300 bg-red-50 text-red-900 rounded-lg p-2.5 text-sm outline-none focus:border-red-600 font-bold"
              placeholder="Misal: 5000"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Uang Transport per Hari (Rp)</label
            >
            <input
              type="number"
              id="setup_uang_transport"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
              placeholder="0"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Tarif Uang Rapat /Hadir (Rp)</label
            >
            <input
              type="number"
              id="setup_uang_rapat"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
              placeholder="Misal: 50000"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Tarif Uang Nginep /Malam (Rp)</label
            >
            <input
              type="number"
              id="setup_uang_nginep"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
              placeholder="Misal: 150000"
            />
          </div>

          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Tunjangan Kesehatan (Rp)</label
            >
            <input
              type="number"
              id="setup_uang_kesehatan"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-600"
              placeholder="0"
            />
          </div>

          <div
            class="col-span-2 bg-purple-50 p-3.5 rounded-xl border border-purple-200 mt-2"
          >
            <label class="flex items-center justify-between cursor-pointer">
              <div class="pr-4">
                <span
                  class="text-xs font-black text-orange-900 uppercase tracking-wide block"
                >
                  <i class="bi bi-inbox-fill mr-1"></i> Mode Gaji Per Jerigen
                </span>
                <span
                  class="text-[10px] text-orange-700 block font-semibold mt-0.5 leading-relaxed"
                >
                  Gaji otomatis dihitung dari jumlah jerigen di gudang minggu
                  ini. Gaji pokok harian dimatikan.
                </span>
              </div>
              <input
                type="checkbox"
                id="chk_gaji_jerigen"
                onchange="window.toggleGajiJerigen(); window.kalkulasiRealtimeGaji();"
                class="w-4 h-4 text-orange-600 rounded focus:ring-orange-500 cursor-pointer shrink-0"
              />
            </label>

            <div
              id="opsi_jerigen"
              class="hidden mt-3 pt-3 border-t border-orange-200"
            >
              <div class="grid grid-cols-2 gap-3">
                <div class="col-span-2 sm:col-span-1">
                  <label
                    class="block text-[10px] font-bold text-orange-800 mb-1"
                  >
                    Tarif per Jerigen (Rp)
                  </label>
                  <input
                    type="number"
                    id="setup_tarif_jerigen"
                    onchange="window.kalkulasiRealtimeGaji()"
                    class="w-full border border-orange-300 rounded-lg p-2 text-sm font-bold text-orange-900 outline-none focus:border-orange-600 shadow-inner"
                    placeholder="Misal: 5000"
                  />
                </div>

                <div class="col-span-2 sm:col-span-1">
                  <label class="block text-xs font-bold text-orange-700 mb-1"
                    >Input Jerigen Manual (Pcs)</label
                  >
                  <input
                    type="number"
                    id="input_jerigen_manual"
                    oninput="window.kalkulasiRealtimeGaji()"
                    class="w-full border border-orange-300 bg-orange-50 rounded-lg p-2 text-sm outline-none focus:border-orange-600"
                    placeholder="Opsional..."
                  />
                </div>
              </div>

              <div
                class="mt-3 text-xs font-bold bg-orange-100 text-orange-900 p-2.5 rounded-lg flex justify-between items-center border border-orange-200"
              >
                <span
                  ><i class="bi bi-box-seam mr-1"></i> Total Jerigen Periode Ini:</span
                >
                <span
                  id="info_total_jerigen_minggu"
                  class="text-lg font-black font-mono">0 Pcs</span
                >
              </div>
            </div>
          </div>

          <div
            class="col-span-2 border-t border-dashed border-gray-300 pt-3 mt-1"
          >
          </div>

          <!-- KEMBALIKAN BLOK KASBON YANG HILANG DI SINI -->
          <div
            class="col-span-2 bg-red-50 p-3.5 rounded-xl border border-red-200 mt-2"
          >
            <div class="flex justify-between items-center mb-2.5">
              <label
                class="text-xs font-bold text-red-800 uppercase flex items-center"
                ><i class="bi bi-wallet2 mr-1"></i> Potong Kasbon Periode Ini</label
              >
              <div
                class="text-[9px] font-black bg-red-200 text-red-900 px-2 py-1 rounded shadow-sm"
              >
                TOTAL HUTANG: <span id="info_total_kasbon" class="font-mono"
                  >Rp 0</span
                >
              </div>
            </div>
            <input
              type="number"
              id="potongan_kasbon_sekarang"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-red-300 bg-white text-red-900 font-bold font-mono rounded-lg p-2.5 text-sm outline-none focus:border-red-600 shadow-inner"
              placeholder="Ketik nominal potongan..."
            />
          </div>

          <!-- BLOK UANG TALANGAN (TETAP ADA DI BAWAH KASBON) -->
          <div
            class="col-span-2 bg-blue-50 p-3.5 rounded-xl border border-blue-200 mt-2"
          >
            <label
              class="text-xs font-bold text-blue-800 uppercase flex items-center mb-2.5"
              ><i class="bi bi-cash-coin mr-1"></i> Uang Talangan / Reimbursement</label
            >
            <input
              type="number"
              id="tambahan_talangan_sekarang"
              onchange="window.kalkulasiRealtimeGaji()"
              class="w-full border border-blue-300 bg-white text-blue-900 font-bold font-mono rounded-lg p-2.5 text-sm outline-none focus:border-blue-600 shadow-inner"
              placeholder="Nominal Talangan (Opsional)..."
            />
          </div>
        </div>

        <div class="mt-4 pt-4 border-t border-gray-100 shrink-0">
          <button
            onclick="simpanSetupGaji()"
            class="w-full bg-gray-900 text-white px-4 py-3 rounded-xl font-bold text-sm hover:bg-black transition shadow-md flex justify-center items-center gap-2"
          >
            <i class="bi bi-floppy"></i> Simpan Parameter Ke Database
          </button>
        </div>
      </div>

      <div
        class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm flex flex-col relative overflow-hidden"
      >
        <div
          class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-green-400 to-blue-500"
        >
        </div>
        <h4
          class="text-sm font-bold text-gray-900 mb-4 border-b border-gray-100 pb-3 flex items-center"
        >
          <i class="bi bi-receipt-cutoff text-green-600 mr-2 text-lg"
          ></i>Kalkulasi Slip Gaji Terkini
        </h4>

        <div class="flex-1 overflow-y-auto pr-2 custom-scrollbar">
          <div class="space-y-3" id="m_rincian_list"></div>
        </div>

        <div class="shrink-0 mt-4">
          <div
            class="bg-gradient-to-br from-green-700 to-green-800 text-white p-5 rounded-xl flex justify-between items-center shadow-lg border border-green-600"
          >
            <span
              class="font-bold text-sm uppercase tracking-wider text-green-100"
              >Total Diterima:</span
            >
            <span
              class="text-3xl font-black font-mono tracking-tight"
              id="m_total_gaji">Rp 0</span
            >
          </div>

          <div class="flex gap-3 mt-4">
            <button
              id="btn-draf-gaji"
              onclick="simpanSlipGaji('Menunggu')"
