        // 3️⃣ Siapkan template
        const templateEl = document.getElementById("template-slip-gambar");
        if (!templateEl) {
          return alert("❌ Template slip tidak ditemukan di halaman!");
        }

        const wrapper = templateEl.parentElement;
        wrapper.classList.remove("hidden");
        wrapper.style.position = "absolute";
        wrapper.style.top = "-9999px";
        wrapper.style.left = "-9999px";

        // 4️⃣ Render ke Canvas
        const canvas = await Promise.race([
          html2canvas(templateEl, {
            scale: 2,
            backgroundColor: "#ffffff",
            useCORS: true,
            allowTaint: true,
            logging: false,
          }),
          new Promise((_, reject) =>
            setTimeout(
              () => reject(new Error("Timeout membuat gambar")),
              10000,
            ),
          ),
        ]);

        // 5️⃣ Download file PNG
        const link = document.createElement("a");
        const safeName = (namaKaryawan || "Akumulasi")
          .replace(/[^a-z0-9\-_\s]/gi, "")
          .slice(0, 20);
        link.download = `Slip_${safeName}_AKUMULASI_${new Date().toISOString().split("T")[0]}.png`;
        link.href = canvas.toDataURL("image/png", 0.95);

        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        alert(
          `✅ Slip PNG Akumulasi berhasil diunduh!\n\nNama: ${safeName}\nTotal Periode: ${dataTerfilter.length}\nGrand Total: Rp ${grandTotal.toLocaleString("id-ID")}`,
        );
      } catch (err) {
        console.error("Export Akumulasi Error:", err);
        alert(
          `❌ GAGAL EXPORT AKUMULASI PNG:\n\n${err.message || "Error tidak diketahui"}`,
        );
      } finally {
        // Sembunyikan template
        const templateEl = document.getElementById("template-slip-gambar");
        if (templateEl && templateEl.parentElement) {
          const wrapper = templateEl.parentElement;
          wrapper.classList.add("hidden");
          wrapper.style.position = "";
          wrapper.style.top = "";
          wrapper.style.left = "";
        }
      }
    };

    // RIWAYAT GAJI LOADER
    async function muatRiwayatGaji() {
      const container = document.getElementById("riwayat-gaji-container");
      const elTotal = document.getElementById("riwayat-total-akumulasi");
      if (!container) return;

      const start =
        document.getElementById("filter-gaji-start")?.value || awalTahun;
      const end = document.getElementById("filter-gaji-end")?.value || hariIni;

      // Ambil value dari filter baru
      const filterUser =
        document.getElementById("filter-gaji-user")?.value || "semua";
      const filterItem =
        document.getElementById("filter-gaji-item")?.value || "semua";

      const cacheKey = `riwayat_gaji_${start}_${end}`;
      const cachedData = localStorage.getItem(cacheKey);

      const renderHTML = (semuaDataGaji) => {
        if (!semuaDataGaji || semuaDataGaji.length === 0) {
          container.innerHTML = `<p class="text-gray-500 text-sm italic py-4">Tidak ada riwayat pengeluaran gaji dari tanggal ${start} sampai ${end}.</p>`;
          if (elTotal) elTotal.innerText = "Rp 0";
          return;
        }

        // 1. FILTERING BY USER
        let dataGaji = semuaDataGaji;

        if (filterUser !== "semua") {
          // Asumsi relasi user_id atau slip.profiles.id
          dataGaji = dataGaji.filter(
            (slip) =>
              String(slip.user_id) === String(filterUser) ||
              String(slip.profiles?.id) === String(filterUser),
          );
        }

        // ✅ PINDAHKAN KE SINI
        // Simpan data ke variabel global SETELAH filter nama selesai diterapkan
        window.currentFilteredRiwayat = dataGaji;

        // 2. MENGHITUNG TOTAL TANPA ASUMSI
        let totalAkumulasi = 0;
        dataGaji.forEach((slip) => {
          // Cuma hitung yang udah ACC
          const isACC =
            slip.status === "ACC" || slip.status_persetujuan === "ACC";
          if (!isACC) return;

          if (filterItem === "semua") {
            totalAkumulasi += Number(slip.total_diterima || 0); // Murni grand total
          } else if (filterItem === "bonus") {
            totalAkumulasi +=
              Number(slip.bonus_tepat_waktu || 0) +
              Number(slip.bonus_mingguan || 0) +
              Number(slip.uang_kesehatan || 0);
          } else if (filterItem === "kasbon") {
            totalAkumulasi += Number(slip.kasbon || 0);
          } else {
            // Dinamis sesuai value select (gaji_karyawan, uang_lembur, uang_makan)
            totalAkumulasi += Number(slip[filterItem] || 0);
          }
        });

        // Update UI Total
        if (elTotal)
          elTotal.innerText = `Rp ${totalAkumulasi.toLocaleString("id-ID")}`;

        if (dataGaji.length === 0) {
          container.innerHTML = `<p class="text-gray-500 text-sm italic py-4">Tidak ada data untuk kombinasi filter ini.</p>`;
          return;
        }

        // 3. RENDER KARTU SLIP
        container.innerHTML = dataGaji
          .map((slip) => {
            const isACC =
              slip.status === "ACC" || slip.status_persetujuan === "ACC";
            const inisial = slip.profiles?.nama
              ? slip.profiles.nama
                  .split(" ")
                  .map((n) => n[0])
                  .join("")
                  .substring(0, 2)
                  .toUpperCase()
              : "KY";
            const avatarKomponen = slip.profiles?.foto_profil
              ? `<img src="${slip.profiles.foto_profil}" class="w-10 h-10 rounded-full object-cover border-2 border-gray-200 shadow-sm shrink-0" />`
              : `<div class="w-10 h-10 rounded-full bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-700 font-bold text-sm shadow-sm shrink-0">${inisial}</div>`;

            // Highlight item kalau filter bukan 'semua'
            let highlightText = "";
            if (isACC && filterItem !== "semua") {
              let valHighlight = 0;
              let namaItem = "";
              if (filterItem === "bonus") {
                valHighlight =
                  Number(slip.bonus_tepat_waktu || 0) +
                  Number(slip.bonus_mingguan || 0) +
                  Number(slip.uang_kesehatan || 0);
                namaItem = "Total Bonus";
              } else if (filterItem === "kasbon") {
                valHighlight = Number(slip.kasbon || 0);
                namaItem = "Potongan Kasbon";
              } else {
                valHighlight = Number(slip[filterItem] || 0);
                namaItem = filterItem.replace("_", " ").toUpperCase();
              }

              highlightText = `<div class="mt-2 bg-blue-50 p-2 rounded text-xs font-bold text-blue-800 border border-blue-200">Kandungan ${namaItem}: Rp ${valHighlight.toLocaleString("id-ID")}</div>`;
            }

            // Tambahkan deteksi status Menunggu untuk checkbox
            const isMenunggu = slip.status === "Menunggu";
            const checkboxHtml = isMenunggu
              ? `<input type="checkbox" class="batch-checkbox w-5 h-5 text-blue-600 rounded focus:ring-blue-500 cursor-pointer border-gray-300 shadow-sm transition" value="${slip.id}" data-total="${slip.total_diterima || 0}" onchange="window.hitungBatch()">`
              : ``;

            return `
                    <div class="p-4 border border-gray-200 rounded-xl mb-3 bg-white shadow-sm flex gap-3 items-center hover:border-blue-300 transition-colors">
                        <!-- Tampilkan Checkbox jika status Menunggu -->
                        ${checkboxHtml}
                        
                        ${avatarKomponen}
                        <div class="flex-1">
                            <div class="flex justify-between items-center">
                                <div>
                                    <p class="font-bold text-gray-900">${slip.profiles?.nama || "Karyawan"}</p>
                                    <p class="text-xs text-gray-500">Periode: ${slip.periode || "-"}</p>
                                </div>
                                <div class="flex items-center gap-2 flex-wrap justify-end">
                                    <span class="px-2 py-1 rounded text-[10px] font-black uppercase tracking-wider ${isACC ? "bg-green-100 text-green-800" : "bg-amber-100 text-amber-800"}">
                                        ${slip.status || "Menunggu"}
                                    </span>
                                    
                                    ${
                                      isMenunggu
                                        ? `
                                    <!-- Tombol Preview Khusus Status Menunggu -->
                                    <button onclick="window.previewSlip('${slip.id}')" class="text-blue-600 hover:bg-blue-50 px-2.5 py-1.5 rounded-lg text-xs font-bold border border-blue-200 transition flex items-center gap-1.5 shadow-sm" title="<button onclick="window.previewSlip('${slip.id}')" class="text-blue-600 hover:bg-blue-50 px-2.5 py-1.5 rounded-lg text-xs font-bold border border-blue-200 transition flex items-center gap-1.5 shadow-sm" title="Cek Rincian">
          <i class="bi bi-eye"></i> Preview
      </button>
      
      <button onclick="window.openEditSlipModal('${slip.id}')" class="text-amber-600 hover:bg-amber-50 px-2.5 py-1.5 rounded text-xs font-bold border border-amber-200 transition flex items-center gap-1.5 shadow-sm">
          <i class="bi bi-pencil-square"></i> Koreksi Draf
      </button>
      `
                                        : `
      <button onclick="window.bukaEditRiwayat('${slip.id}')" class="text-gray-600 hover:bg-gray-100 px-2.5 py-1.5 rounded text-xs border border-gray-200 transition flex items-center gap-1.5">
        <i class="bi bi-pencil-square"></i> Koreksi
      </button>
                                    <!-- Tombol Default Jika Sudah ACC -->
                                    <button onclick="window.bukaEditRiwayat('${slip.id}')" class="text-gray-600 hover:bg-gray-100 px-2 py-1 rounded text-xs border border-gray-200 transition">
                                      <i class="bi bi-pencil-square"></i> Koreksi
                                    </button>
                                    <button onclick="window.downloadSlipGambar('${slip.id}')" class="text-emerald-600 hover:bg-emerald-50 px-2 py-1 rounded text-xs border border-emerald-200 transition" title="Unduh Gambar Slip">
                                        <i class="bi bi-image"></i>
                                    </button>
                                    `
                                    }
                                </div>
                            </div>
                            
                            <!-- Rincian hanya tampil di kartu jika sudah ACC -->
                            ${
                              isACC
                                ? `
                                <div class="mt-3 text-xs space-y-1.5 border-t pt-3 border-dashed border-gray-200">
                                    <div class="flex justify-between"><span>Gaji Pokok:</span> <span>Rp ${Number(slip.gaji_karyawan || 0).toLocaleString("id-ID")}</span></div>
                                    <div class="flex justify-between text-gray-500"><span>Uang Lembur:</span> <span>Rp ${Number(slip.uang_lembur || 0).toLocaleString("id-ID")}</span></div>
                                    <div class="flex justify-between text-green-700 font-medium"><span>Total Bonus:</span> <span>+Rp ${Number((slip.bonus_tepat_waktu || 0) + (slip.bonus_mingguan || 0) + (slip.uang_kesehatan || 0)).toLocaleString("id-ID")}</span></div>
                                    ${Number(slip.kasbon || 0) > 0 ? `<div class="flex justify-between text-red-600 font-bold"><span>Potongan Kasbon:</span> <span>-Rp ${Number(slip.kasbon).toLocaleString("id-ID")}</span></div>` : ""}
                                    <div class="flex justify-between font-black text-green-700 mt-2 pt-2 border-t border-green-100">
                                        <span>Total Diterima (ACC):</span> 
                                        <span>Rp ${Number(slip.total_diterima || 0).toLocaleString("id-ID")}</span>
                                    </div>
                                </div>
                                ${highlightText}
                            `
                                : ``
                            }
                        </div>
                    </div>`;
          })
          .join("");
      };

      if (cachedData) {
        renderHTML(JSON.parse(cachedData));
      } else {
        container.innerHTML =
          '<p class="text-gray-500 text-sm italic animate-pulse">Memuat data riwayat gaji...</p>';
        if (elTotal) elTotal.innerText = "Menghitung...";
      }

      try {
        const { data: dataGaji, error } = await supabase
          .from("slip_gaji")
          .select(`*, profiles!inner(id, nama, role, foto_profil)`)
          .neq("profiles.role", "owner")
          .gte("created_at", `${start} 00:00:00`)
          .lte("created_at", `${end} 23:59:59`)
          .order("created_at", { ascending: false });
        if (error) throw error;

        localStorage.setItem(cacheKey, JSON.stringify(dataGaji));
        renderHTML(dataGaji);
      } catch (error) {
        console.error("Supabase Error:", error);
        if (!cachedData) {
          container.innerHTML = `
                    <div class="p-4 bg-red-50 text-red-700 rounded-xl text-xs">
                        <p class="font-bold">Gagal sinkronisasi data dengan server:</p>
                        <p class="italic mt-1">${error.message}</p>
                    </div>`;
        }
      }
    }
    document
      .getElementById("btn-filter-gaji")
      ?.addEventListener("click", muatRiwayatGaji);
    window.filterTipeGaji = function (tipe) {
      document.querySelectorAll(".filter-gaji-btn").forEach((btn) => {
        if (
          btn.innerText.includes(tipe) ||
          (tipe === "Semua" && btn.innerText === "Semua")
        ) {
          btn.classList.add(
            "active",
            "bg-white",
            "shadow-sm",
            "text-green-700",
          );
          btn.classList.remove("text-gray-500");
        } else {
          btn.classList.remove(
            "active",
            "bg-white",
            "shadow-sm",
            "text-green-700",
          );
          btn.classList.add("text-gray-500");
        }
      });

      document.querySelectorAll(".karyawan-card").forEach((card) => {
        if (tipe === "Semua" || card.getAttribute("data-periode") === tipe) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    };

    // ==========================================
    // 🔥 FITUR KOREKSI RIWAYAT GAJI 🔥
    // ==========================================
    window.bukaEditRiwayat = async function (id) {
      if (!window.supabase) return;
      try {
        const { data: slip, error } = await window.supabase
          .from("slip_gaji")
          .select("*, profiles(nama)")
          .eq("id", id)
          .single();
        if (error || !slip) throw new Error("Data slip tidak ditemukan!");

        // 🔥 1. HITUNG RENTANG TANGGAL MINGGUAN (Senin s/d Minggu) DARI slip.periode 🔥
        const tglAkhir = slip.periode;
        const dEnd = new Date(tglAkhir);
        const dStart = new Date(dEnd);
        dStart.setDate(dEnd.getDate() - 6);
        const tglMulai = dStart.toISOString().split("T")[0];

        // 🔥 2. AMBIL DATA JERIGEN SEMINGGU PENUH SESUAI USER_ID & RENTANG TANGGAL 🔥
        const { data: jerigenData } = await window.supabase
          .from("tata_kelola_jerigen")
          .select("jumlah_jerigen")
          .eq("user_id", slip.user_id)
          .gte("tanggal", tglMulai)
          .lte("tanggal", tglAkhir);

        let totalJerigenPcs = 0;
        if (jerigenData && jerigenData.length > 0) {
          totalJerigenPcs = jerigenData.reduce(
            (sum, item) => sum + (parseInt(item.jumlah_jerigen) || 0),
            0,
          );
        } else {
          totalJerigenPcs = slip.jumlah_jerigen || 0;
        }

        // 🔥 3. AMBIL TARIF LANGSUNG MUTLAK DARI setup_gaji 🔥
        const { data: setup } = await window.supabase
          .from("setup_gaji")
          .select("tarif_jerigen")
          .eq("user_id", slip.user_id)
          .maybeSingle();

        // Murni dari setup_gaji, abaikan slip.tarif_jerigen
        const tarifJerigenFinal = setup?.tarif_jerigen || 0;

        document.getElementById("er_slip_id").value = slip.id;
        document.getElementById("edit_riwayat_nama").innerText =
          `Karyawan: ${slip.profiles?.nama || "Unknown"} | ${slip.periode}`;
        document.getElementById("er_status").value = slip.status;

        // 🔥 4. SUNTIKKAN SEMUA DATA YANG SUDAH VALID KE INPUT FORM MODAL 🔥
        document.getElementById("er_gaji").value = slip.gaji_karyawan || 0;
        document.getElementById("er_jumlah_jerigen").value = totalJerigenPcs;

        // Tarif sekarang dipastikan 100% dari setup_gaji
        document.getElementById("er_tarif_jerigen").value = tarifJerigenFinal;

        document.getElementById("er_lembur").value = slip.uang_lembur || 0;
        document.getElementById("er_makan").value = slip.uang_makan || 0;
        document.getElementById("er_makan_malam").value =
          slip.uang_makan_malam || 0;
        document.getElementById("er_bonus_penjemputan").value =
          slip.bonus_penjemputan || 0;
        document.getElementById("er_bonus_tepat_waktu").value =
          slip.bonus_tepat_waktu || 0;
        document.getElementById("er_bonus_mingguan").value =
          slip.bonus_mingguan || 0;
        document.getElementById("er_uang_kesehatan").value =
          slip.uang_kesehatan || 0;
        document.getElementById("er_kasbon").value = slip.kasbon || 0;
        document.getElementById("er_total_lama").value =
          slip.total_diterima || 0;

        // Opsional: Jika ingin Gaji Pokok langsung menghitung ulang berdasarkan tarif jerigen setup terbaru
        // Anda bisa memanggil window.kalkulasiGajiJerigenEdit(); di sini
        window.hitungTotalEditRiwayat();
        window.openModal("modal-edit-riwayat");
      } catch (err) {
        alert(err.message);
      }
    };

    window.hitungTotalEditRiwayat = function () {
      // 🟢 GUARD: Cek semua element dulu
      const requiredIds = [
        "er_gaji",
        "er_lembur",
        "er_makan",
        "er_makan_malam",
        "er_bonus_penjemputan",
        "er_bonus_tepat_waktu",
        "er_bonus_mingguan",
        "er_uang_kesehatan",
        "er_kasbon",
        "er_total_baru",
      ];

      const missingIds = requiredIds.filter(
        (id) => !document.getElementById(id),
      );
      if (missingIds.length > 0) {
        console.warn("⚠️ Element tidak ditemukan di modal:", missingIds);
        return 0; // Return 0 jika ada yang missing
      }

      // Ambil nilai dari semua field
      const gaji = parseFloat(document.getElementById("er_gaji").value) || 0;
      const lembur =
        parseFloat(document.getElementById("er_lembur").value) || 0;
      const makan = parseFloat(document.getElementById("er_makan").value) || 0;
      const makanMalam =
        parseFloat(document.getElementById("er_makan_malam").value) || 0;
      const jemput =
        parseFloat(document.getElementById("er_bonus_penjemputan").value) || 0;
      const tepatWaktu =
        parseFloat(document.getElementById("er_bonus_tepat_waktu").value) || 0;
      const mingguan =
        parseFloat(document.getElementById("er_bonus_mingguan").value) || 0;
      const kesehatan =
        parseFloat(document.getElementById("er_uang_kesehatan").value) || 0;
      const kasbon =
        parseFloat(document.getElementById("er_kasbon").value) || 0;

      // Jumlahkan semuanya
      let total =
        gaji +
        lembur +
        makan +
        makanMalam +
        jemput +
        tepatWaktu +
        mingguan +
        kesehatan -
        kasbon;
      if (total < 0) total = 0;

      document.getElementById("er_total_baru").innerText =
        `Rp ${total.toLocaleString("id-ID")}`;
      return total;
    };

    window.kalkulasiGajiJerigenEdit = function () {
      // 🟢 TAMBAH GUARD: Cek apakah element ada dulu
      const elJerigen = document.getElementById("er_jumlah_jerigen");
      const elTarif = document.getElementById("er_tarif_jerigen");
      const elGaji = document.getElementById("er_gaji");

      if (!elJerigen || !elTarif || !elGaji) {
        console.warn(
          "⚠️ Element modal edit riwayat belum siap! IDs: er_jumlah_jerigen, er_tarif_jerigen, er_gaji",
        );
        return; // Exit aman, jangan crash
      }

      const jumlahJerigen = parseInt(elJerigen.value) || 0;
      const tarifJerigen = parseFloat(elTarif.value) || 0;

      // Jika ada input jerigen atau tarif, otomatis kalikan dan masukkan ke Gaji Pokok
      if (jumlahJerigen > 0 || tarifJerigen > 0) {
        elGaji.value = jumlahJerigen * tarifJerigen;
      }

      // Update grand total
      window.hitungTotalEditRiwayat();
    };

    window.simpanEditRiwayat = async function () {
      if (!confirm("Yakin ingin menyimpan koreksi gaji ini?")) return;
      if (!window.supabase) return;

      const btn = document.getElementById("btn-save-er");
      btn.innerText = "Memproses...";
      btn.disabled = true;

      try {
        const slipId = document.getElementById("er_slip_id").value;
        const status = document.getElementById("er_status").value;
        const totalLama =
          parseFloat(document.getElementById("er_total_lama").value) || 0;
        const totalBaru = window.hitungTotalEditRiwayat();

        // 🔥 3. SIAPKAN PAYLOAD UNTUK UPDATE KE DATABASE 🔥
        const payload = {
          gaji_karyawan:
            parseFloat(document.getElementById("er_gaji").value) || 0,
          jumlah_jerigen:
            parseInt(document.getElementById("er_jumlah_jerigen").value) || 0, // Simpan jerigen ke slip_gaji
          tarif_jerigen:
            parseFloat(document.getElementById("er_tarif_jerigen").value) || 0,
          uang_lembur:
            parseFloat(document.getElementById("er_lembur").value) || 0,
          uang_makan:
            parseFloat(document.getElementById("er_makan").value) || 0,
          uang_makan_malam:
            parseFloat(document.getElementById("er_makan_malam").value) || 0,
          bonus_penjemputan:
            parseFloat(document.getElementById("er_bonus_penjemputan").value) ||
            0,
          bonus_tepat_waktu:
            parseFloat(document.getElementById("er_bonus_tepat_waktu").value) ||
            0,
          bonus_mingguan:
            parseFloat(document.getElementById("er_bonus_mingguan").value) || 0,
          uang_kesehatan:
            parseFloat(document.getElementById("er_uang_kesehatan").value) || 0,
          kasbon: parseFloat(document.getElementById("er_kasbon").value) || 0,
          total_diterima: totalBaru,
        };

        // 🔥 LOGIKA KEUANGAN (Tetap sama seperti aslinya)
        if (status === "ACC" || status === "Disetujui") {
          const selisih = totalBaru - totalLama;
          if (selisih !== 0) {
            const { data: kasData } = await window.supabase
              .from("kas_perusahaan")
              .select("uang_keuangan")
              .eq("id", 1)
              .single();
            let saldoKeuangan = parseFloat(kasData?.uang_keuangan) || 0;

            if (selisih > 0 && saldoKeuangan < selisih) {
              throw new Error(
                `Saldo Uang Keuangan tidak cukup untuk nombokin selisih Rp ${selisih.toLocaleString("id-ID")}`,
              );
            }

            await window.supabase
              .from("kas_perusahaan")
              .update({ uang_keuangan: saldoKeuangan - selisih })
              .eq("id", 1);

            payload.kas_keuangan_terpakai = totalBaru;
          }
        }

        // Update database Slip Gaji
        await window.supabase
          .from("slip_gaji")
          .update(payload)
          .eq("id", slipId);

        alert("✅ Mantap! Riwayat Slip Gaji berhasil dikoreksi.");
        window.location.reload();
      } catch (err) {
        alert("Gagal koreksi gaji: " + err.message);
        btn.innerText = "SIMPAN KOREKSI SLIP";
        btn.disabled = false;
      }
    };
    // ==========================================
    // 🔧 FITUR EDIT SLIP GAJI (MODAL TERPISAH)
    // ==========================================

    window.openEditSlipModal = async function (slipId) {
      if (!window.supabase) return;
      try {
        const slip = window.currentFilteredRiwayat.find(
          (s) => String(s.id) === String(slipId),
        );
        if (!slip) return alert("❌ Slip tidak ditemukan!");

        // Ambil parameter dari tabel setup
        const { data: setup } = await window.supabase
          .from("setup_gaji")
          .select("is_gaji_jerigen, tarif_jerigen")
          .eq("user_id", slip.user_id)
          .maybeSingle();

        const isJerigen = setup?.is_gaji_jerigen || false;
        const tarifJerigen = setup?.tarif_jerigen || 0;

        // Isi UI Text
        document.getElementById("edit-emp-name").innerText =
          slip.profiles?.nama || "N/A";
        document.getElementById("edit-slip-periode").innerText = slip.periode;

        // Reset semua input ke value default
        document.getElementById("edit_jumlah_jerigen").value =
          slip.jumlah_jerigen || 0;
        document.getElementById("edit_kasbon").value = slip.kasbon || 0;
        document.getElementById("edit_bonus_manual").value = 0; // Mulai dari 0 untuk draf

        // Simpan parameter hitung di window
        window.editSlipData = {
          slipId: slip.id,
          originalGrandTotal: slip.total_diterima,
          originalBonusTepat: slip.bonus_tepat_waktu || 0,
          originalBonusMingguan: slip.bonus_mingguan || 0,
          originalBonusKesehatan: slip.uang_kesehatan || 0,
          isJerigen: isJerigen,
          tarifJerigen: tarifJerigen,
        };

        // Tampilkan/Sembunyikan form berdasarkan Mode Jerigen
        const wrapJerigen = document.getElementById("wrap_edit_jerigen");
        const wrapBonus = document.getElementById("wrap_edit_bonus");
        const wrapBreakdown = document.getElementById("edit_bonus_breakdown");

        if (isJerigen) {
          wrapJerigen.classList.remove("hidden");
          wrapBonus.classList.add("hidden");
          wrapBreakdown.classList.add("hidden");
        } else {
          wrapJerigen.classList.add("hidden");
          wrapBonus.classList.remove("hidden");
          wrapBreakdown.classList.remove("hidden");
        }

        window.hitungTotalEditSlip();
        window.openModal("modal-edit-slip");
      } catch (err) {
        alert("❌ Error: " + err.message);
      }
    };

    // --- 2. Fungsi Hitung Otomatis Saat Ngetik ---
    window.hitungTotalEditSlip = function () {
      if (!window.editSlipData) return;

      const isJerigen = window.editSlipData.isJerigen || false;
      const jumlahJerigen =
        parseInt(document.getElementById("edit_jumlah_jerigen").value) || 0;
      const kasbon =
        parseFloat(document.getElementById("edit_kasbon").value) || 0;

      let newGrandTotal = 0;

      if (isJerigen) {
        const tarif = window.editSlipData.tarifJerigen || 0;
        newGrandTotal = jumlahJerigen * tarif - kasbon;
      } else {
        const bonusManual =
          parseFloat(document.getElementById("edit_bonus_manual").value) || 0;

        // Karena lembur manual sudah dihapus, penambahnya cuma bonus manual
        newGrandTotal =
          window.editSlipData.originalGrandTotal + (bonusManual - kasbon);

        // Render breakdown visual
        const bTepat = window.editSlipData.originalBonusTepat || 0;
        const bMinggu = window.editSlipData.originalBonusMingguan || 0;
        const bSehat = window.editSlipData.originalBonusKesehatan || 0;
        const tBonus = bTepat + bMinggu + bSehat;

        document.getElementById("edit_bonus_breakdown").innerHTML = `
        <div class="text-xs space-y-1">
          <p class="font-bold text-amber-900 mb-2">📊 Bonus Sistem (Tidak Berubah)</p>
          <div class="flex justify-between text-amber-800"><span>Kehadiran Tepat Waktu:</span> <span>Rp ${bTepat.toLocaleString("id-ID")}</span></div>
          <div class="flex justify-between text-amber-800"><span>Bonus Mingguan:</span> <span>Rp ${bMinggu.toLocaleString("id-ID")}</span></div>
          <div class="flex justify-between text-amber-800"><span>Uang Kesehatan:</span> <span>Rp ${bSehat.toLocaleString("id-ID")}</span></div>
          <div class="border-t border-amber-200 pt-1.5 mt-1.5 flex justify-between font-black text-amber-900">
            <span>Total Bonus Sistem:</span> <span>Rp ${tBonus.toLocaleString("id-ID")}</span>
          </div>
        </div>`;
      }

      document.getElementById("edit_grand_total_preview").innerText =
        `Rp ${Math.max(0, newGrandTotal).toLocaleString("id-ID")}`;
    };

    // --- 3. Fungsi Simpan Ke Database ---
    window.submitEditSlip = async function () {
      if (!window.editSlipData) return alert("❌ Data slip tidak ditemukan!");
      if (!confirm("Yakin simpan draf koreksi ini?")) return;

      const isJerigen = window.editSlipData.isJerigen || false;
      const jumlahJerigen =
        parseInt(document.getElementById("edit_jumlah_jerigen").value) || 0;
      const kasbon =
        parseFloat(document.getElementById("edit_kasbon").value) || 0;

      let newTotal = 0;
      let payloadUpdate = {
        jumlah_jerigen: jumlahJerigen,
        kasbon: kasbon,
        uang_lembur_tambahan: 0, // Pastikan mutlak 0 supaya database bersih
      };

      if (isJerigen) {
        const tarif = window.editSlipData.tarifJerigen || 0;
        newTotal = jumlahJerigen * tarif - kasbon;
        payloadUpdate.gaji_karyawan = jumlahJerigen * tarif;
      } else {
        const bonusManual =
          parseFloat(document.getElementById("edit_bonus_manual").value) || 0;
        newTotal =
          window.editSlipData.originalGrandTotal + (bonusManual - kasbon);
      }

      payloadUpdate.total_diterima = Math.max(0, newTotal);

      const { error } = await window.supabase
        .from("slip_gaji")
        .update(payloadUpdate)
        .eq("id", window.editSlipData.slipId);

      if (error) {
        alert("❌ Gagal update draf: " + error.message);
        return;
      }

      alert("✅ Draf slip berhasil dikoreksi!");
      window.closeModal("modal-edit-slip");
      document.getElementById("btn-filter-gaji")?.click(); // Refresh riwayat otomatis
    };
    // ==========================================
    // ⚡ FITUR BATCH APPROVAL & PREVIEW
    // ==========================================

    window.hitungBatch = function () {
      const checkboxes = document.querySelectorAll(".batch-checkbox:checked");
      let total = 0;

      checkboxes.forEach((cb) => {
        total += parseFloat(cb.getAttribute("data-total")) || 0;
      });

      document.getElementById("batch-count").innerText = checkboxes.length;
      document.getElementById("batch-total").innerText =
        "Rp " + total.toLocaleString("id-ID");

      const bar = document.getElementById("batch-action-bar");
      if (checkboxes.length > 0) {
        bar.classList.remove("hidden");
        bar.style.display = "flex"; // Paksa flex
        setTimeout(() => bar.classList.remove("translate-y-full"), 10);
      } else {
        bar.classList.add("translate-y-full");
        setTimeout(() => {
          bar.classList.add("hidden");
          bar.style.display = "none";
        }, 300);
      }
    };

    window.previewSlip = function (slipId) {
      // Ambil data dari cache riwayat
      const slip = window.currentFilteredRiwayat.find(
        (s) => String(s.id) === String(slipId),
      );
      if (!slip) return alert("Data tidak ditemukan!");

      document.getElementById("prev_nama_periode").innerText =
        `${slip.profiles?.nama || "Unknown"} | ${slip.periode}`;

      const totalBonus =
        Number(slip.bonus_tepat_waktu || 0) +
        Number(slip.bonus_mingguan || 0) +
        Number(slip.uang_kesehatan || 0) +
        Number(slip.bonus_penjemputan || 0) +
        Number(slip.uang_rapat || 0) +
        Number(slip.uang_nginep || 0);

      const html = `
      <div class="flex justify-between border-b border-gray-100 pb-1 mb-1">
        <span class="text-gray-600">Gaji Pokok</span> 
        <span class="font-bold text-gray-900">Rp ${Number(slip.gaji_karyawan || 0).toLocaleString("id-ID")}</span>
      </div>
      ${Number(slip.uang_lembur || 0) > 0 ? `<div class="flex justify-between border-b border-gray-100 pb-1 mb-1"><span class="text-gray-600">Uang Lembur</span> <span class="font-bold text-gray-900">+Rp ${Number(slip.uang_lembur || 0).toLocaleString("id-ID")}</span></div>` : ""}
      ${Number(slip.uang_makan || 0) > 0 ? `<div class="flex justify-between border-b border-gray-100 pb-1 mb-1"><span class="text-gray-600">Uang Makan</span> <span class="font-bold text-gray-900">+Rp ${Number(slip.uang_makan || 0).toLocaleString("id-ID")}</span></div>` : ""}
      ${Number(slip.uang_makan_malam || 0) > 0 ? `<div class="flex justify-between border-b border-gray-100 pb-1 mb-1"><span class="text-gray-600">Makan Malam</span> <span class="font-bold text-gray-900">+Rp ${Number(slip.uang_makan_malam || 0).toLocaleString("id-ID")}</span></div>` : ""}
      ${totalBonus > 0 ? `<div class="flex justify-between border-b border-gray-100 pb-1 mb-1"><span class="text-green-700">Total Bonus</span> <span class="font-bold text-green-700">+Rp ${totalBonus.toLocaleString("id-ID")}</span></div>` : ""}
      ${Number(slip.kasbon || 0) > 0 ? `<div class="flex justify-between border-b border-gray-100 pb-1 mb-1"><span class="text-red-600 font-bold">Potongan Kasbon</span> <span class="font-bold text-red-600">-Rp ${Number(slip.kasbon || 0).toLocaleString("id-ID")}</span></div>` : ""}
    `;

      document.getElementById("prev_rincian_konten").innerHTML = html;
      document.getElementById("prev_grand_total").innerText =
        `Rp ${Number(slip.total_diterima || 0).toLocaleString("id-ID")}`;

      window.openModal("modal-preview-slip");
    };

    window.bukaKasirMassal = function () {
      const checkboxes = document.querySelectorAll(".batch-checkbox:checked");
      if (checkboxes.length === 0) return;

      let total = 0;
      window.batchSelectedIds = []; // Simpan ID slip untuk dieksekusi nanti

      checkboxes.forEach((cb) => {
        total += parseFloat(cb.getAttribute("data-total")) || 0;
        window.batchSelectedIds.push(cb.value);
      });

      // Gunakan ulang modal Kasir
      document.getElementById("kasir_total_tagihan").innerText =
        `Rp ${total.toLocaleString("id-ID")}`;
      document.getElementById("kasir_keuangan").value = total;
      document.getElementById("kasir_gudang").value = 0;
      document.getElementById("kasir_owner").value = 0;
      window.kalkulasiKasir();

      // Hijack tombol eksekusi untuk mode massal
      const btn = document.getElementById("btn-eksekusi-bayar");
      btn.onclick = window.eksekusiBayarMassal; // Kita bikin fungsi ini di tahap backend nanti
      btn.innerHTML = `<i class="bi bi-safe2 mr-2"></i> BAYAR MASSAL (${checkboxes.length} SLIP)`;

      window.openModal("modal-kasir-gaji");
    };
  });
</script>
