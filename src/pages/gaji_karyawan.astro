    // ==========================================
    // 🔥 FITUR KOREKSI RIWAYAT GAJI 🔥
    // ==========================================
    window.bukaEditRiwayat = async function (id) {
      if (!window.supabase) return;

      try {
        const { data: slip, error } = await window.supabase
          .from("slip_gaji")
          .select("*, profiles(nama)")
          .eq("id", id)
          .single();
        if (error || !slip) throw new Error("Data slip tidak ditemukan!");

        document.getElementById("er_slip_id").value = slip.id;
        document.getElementById("edit_riwayat_nama").innerText =
          `Karyawan: ${slip.profiles?.nama || "Unknown"} | ${slip.periode}`;
        document.getElementById("er_status").value = slip.status;

        // Total bonus gabungan (Biar gampang diedit)
        const totalBonus =
          (slip.bonus_tepat_waktu || 0) +
          (slip.bonus_mingguan || 0) +
          (slip.uang_kesehatan || 0) +
          (slip.uang_rapat || 0) +
          (slip.uang_nginep || 0);

        document.getElementById("er_gaji").value = slip.gaji_karyawan || 0;
        document.getElementById("er_lembur").value = slip.uang_lembur || 0;
        document.getElementById("er_makan").value = slip.uang_makan || 0;
        document.getElementById("er_bonus").value = totalBonus;
        document.getElementById("er_kasbon").value = slip.kasbon || 0;

        document.getElementById("er_total_lama").value =
          slip.total_diterima || 0;

        window.hitungTotalEditRiwayat();
        window.openModal("modal-edit-riwayat");
      } catch (err) {
        alert(err.message);
      }
    };

    window.hitungTotalEditRiwayat = function () {
      const gaji = parseFloat(document.getElementById("er_gaji").value) || 0;
      const lembur =
        parseFloat(document.getElementById("er_lembur").value) || 0;
      const makan = parseFloat(document.getElementById("er_makan").value) || 0;
      const bonus = parseFloat(document.getElementById("er_bonus").value) || 0;
      const kasbon =
        parseFloat(document.getElementById("er_kasbon").value) || 0;

      let total = gaji + lembur + makan + bonus - kasbon;
      if (total < 0) total = 0;

      document.getElementById("er_total_baru").innerText =
        `Rp ${total.toLocaleString("id-ID")}`;
      return total;
    };

    window.simpanEditRiwayat = async function () {
      if (!confirm("Yakin ingin menyimpan koreksi gaji ini?")) return;
      if (!window.supabase) return;

      const btn = document.getElementById("btn-save-er");
      btn.innerText = "Memproses...";
      btn.disabled = true;

      try {
        const slipId = document.getElementById("er_slip_id").value;
        const status = document.getElementById("er_status").value;
        const totalLama =
          parseFloat(document.getElementById("er_total_lama").value) || 0;
        const totalBaru = window.hitungTotalEditRiwayat();

        // Siapkan Data Update Slip
        const payload = {
          gaji_karyawan:
            parseFloat(document.getElementById("er_gaji").value) || 0,
          uang_lembur:
            parseFloat(document.getElementById("er_lembur").value) || 0,
          uang_makan:
            parseFloat(document.getElementById("er_makan").value) || 0,
          bonus_mingguan:
            parseFloat(document.getElementById("er_bonus").value) || 0, // Pukul rata bonus masuk ke sini
          bonus_tepat_waktu: 0,
          uang_kesehatan: 0,
          uang_rapat: 0,
          uang_nginep: 0, // Reset pecahan bonus
          kasbon: parseFloat(document.getElementById("er_kasbon").value) || 0,
          total_diterima: totalBaru,
        };

        // 🔥 LOGIKA KEUANGAN: Jika slip sudah LUNAS (ACC), kita sesuaikan Kas Perusahaan
        if (status === "ACC" || status === "Disetujui") {
          const selisih = totalBaru - totalLama;
          if (selisih !== 0) {
            // Ambil saldo kas saat ini
            const { data: kasData } = await window.supabase
              .from("kas_perusahaan")
              .select("uang_keuangan")
              .eq("id", 1)
              .single();
            let saldoKeuangan = parseFloat(kasData?.uang_keuangan) || 0;

            if (selisih > 0 && saldoKeuangan < selisih) {
              throw new Error(
                `Saldo Uang Keuangan tidak cukup untuk nombokin selisih Rp ${selisih.toLocaleString("id-ID")}`,
              );
            }

            // Sesuaikan dompet (Jika tagihan nambah, kas berkurang. Jika tagihan berkurang, kas nambah)
            await window.supabase
              .from("kas_perusahaan")
              .update({
                uang_keuangan: saldoKeuangan - selisih,
              })
              .eq("id", 1);

            // Update catatan dompet terpakai di slip_gaji
            payload.kas_keuangan_terpakai = totalBaru;
            payload.kas_gudang_terpakai = 0;
            payload.kas_owner_terpakai = 0;
          }
        }

        // Update database Slip Gaji
        await window.supabase
          .from("slip_gaji")
          .update(payload)
          .eq("id", slipId);

        alert("✅ Mantap! Riwayat Slip Gaji berhasil dikoreksi.");
        window.location.reload();
      } catch (err) {
        alert("Gagal koreksi gaji: " + err.message);
        btn.innerText = "SIMPAN KOREKSI SLIP";
        btn.disabled = false;
      }
    };
  });
</script>
