            window.renderLeaderboardSesuaiFilter = function() {
                const kategori = window.activeLeaderboardKat;
                const container = document.getElementById('leaderboard-live-list');
                if (!container) return;

                // Sortir kargo terbesar, ambil Top 5
                const data = (window.leaderboardCache[kategori] || []).sort((a, b) => b.kg - a.kg).slice(0, 5);
                
                if (data.length === 0) {
                    container.innerHTML = `<p class="text-xs text-on-surface-variant italic text-center py-10 col-span-full border-2 border-dashed border-outline-variant rounded-xl">Belum ada penyetor di kategori ${kategori} pada bulan ini.</p>`;
                    return;
                }

                container.innerHTML = data.map((m, i) => {
                    let bgMedali = 'bg-surface-variant text-on-surface-variant border-outline-variant';
                    let iconMedali = '';
                    if(i === 0) { bgMedali = 'bg-yellow-500 text-white font-bold border-yellow-600'; iconMedali = '🥇 '; }
                    else if(i === 1) { bgMedali = 'bg-slate-400 text-white font-bold border-slate-500'; iconMedali = '🥈 '; }
                    else if(i === 2) { bgMedali = 'bg-amber-700 text-white font-bold border-amber-800'; iconMedali = '🥉 '; }

                    return `
