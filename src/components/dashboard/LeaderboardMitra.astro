---
// LeaderboardMitra.astro
---

<div
  class="bg-surface-container-lowest rounded-3xl p-6 border border-outline-variant shadow-lg hover:shadow-xl transition-shadow duration-300"
>
  <div
    class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6"
  >
    <div>
      <h2 class="text-2xl font-bold text-on-surface flex items-center gap-2">
        🏆 Top 5 Mitra
      </h2>
      <p class="text-sm text-on-surface-variant mt-1">
        Berdasarkan total setoran
      </p>
    </div>

    <div
      class="flex items-center gap-2 bg-surface-container py-1.5 px-2 rounded-full border border-outline-variant"
    >
      <button
        id="prev-month"
        class="p-1.5 rounded-full hover:bg-surface-variant text-on-surface transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
        >
      </button>
      <span
        class="text-sm font-bold text-on-surface w-24 text-center tracking-wide"
        id="periode-label"
      >
        Memuat...
      </span>
      <button
        id="next-month"
        class="p-1.5 rounded-full hover:bg-surface-variant text-on-surface transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
        >
      </button>
    </div>
  </div>

  <div class="flex flex-wrap gap-2 mb-6 pb-2 overflow-x-auto hide-scrollbar">
    <button
      class="filter-btn px-4 py-2 text-sm rounded-full font-semibold transition-all duration-200"
      data-category="total_keseluruhan">Semua</button
    >
    <button
      class="filter-btn px-4 py-2 text-sm rounded-full border border-outline text-on-surface hover:bg-surface-container font-medium transition-all duration-200"
      data-category="minyak_jelantah">Minyak Jelantah</button
    >
    <button
      class="filter-btn px-4 py-2 text-sm rounded-full border border-outline text-on-surface hover:bg-surface-container font-medium transition-all duration-200"
      data-category="minyak_asting">Minyak Asting</button
    >
    <button
      class="filter-btn px-4 py-2 text-sm rounded-full border border-outline text-on-surface hover:bg-surface-container font-medium transition-all duration-200"
      data-category="minyak_semi">Minyak Semi</button
    >
    <button
      class="filter-btn px-4 py-2 text-sm rounded-full border border-outline text-on-surface hover:bg-surface-container font-medium transition-all duration-200"
      data-category="ampas">Ampas</button
    >
    <button
      class="filter-btn px-4 py-2 text-sm rounded-full border border-outline text-on-surface hover:bg-surface-container font-medium transition-all duration-200"
      data-category="kriuk">Kriuk</button
    >
    <button
      class="filter-btn px-4 py-2 text-sm rounded-full border border-outline text-on-surface hover:bg-surface-container font-medium transition-all duration-200"
      data-category="tepung">Tepung</button
    >
    <button
      class="filter-btn px-4 py-2 text-sm rounded-full border border-outline text-on-surface hover:bg-surface-container font-medium transition-all duration-200"
      data-category="spinner">Spinner</button
    >
  </div>

  <div id="list-container" class="space-y-3 min-h-75">
    <div class="flex h-full min-h-62.5 items-center justify-center">
      <p class="text-on-surface-variant animate-pulse font-medium">
        Menyiapkan Leaderboard...
      </p>
    </div>
  </div>
</div>

<script>
  import { supabase } from "../../lib/supabase";

  // Elemen DOM
  const listContainer = document.getElementById("list-container");
  const filterButtons = document.querySelectorAll(".filter-btn");
  const prevMonthBtn = document.getElementById("prev-month");
  const nextMonthBtn = document.getElementById("next-month");
  const periodeLabel = document.getElementById("periode-label");

  // State Aplikasi
  const realCurrentDate = new Date(); // Patokan bulan asli hari ini
  let viewDate = new Date(); // Bulan yang sedang dilihat user
  let activeCategory = "total_keseluruhan"; // Kategori default

  const namaBulan = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "Mei",
    "Jun",
    "Jul",
    "Agt",
    "Sep",
    "Okt",
    "Nov",
    "Des",
  ];

  // 1. Fungsi Update UI Navigasi Bulan
  function updateMonthUI() {
    if (!periodeLabel || !nextMonthBtn) return;

    // Cek apakah viewDate sama dengan bulan saat ini
    const isCurrentMonth =
      viewDate.getMonth() === realCurrentDate.getMonth() &&
      viewDate.getFullYear() === realCurrentDate.getFullYear();

    // Label teks
    if (isCurrentMonth) {
      periodeLabel.textContent = "Bulan Ini";
      nextMonthBtn.setAttribute("disabled", "true"); // Kunci navigasi ke depan
    } else {
      periodeLabel.textContent = `${namaBulan[viewDate.getMonth()]} ${viewDate.getFullYear()}`;
      nextMonthBtn.removeAttribute("disabled"); // Buka navigasi ke depan
    }
  }

  // 2. Fungsi Fetch Data dari Supabase
  async function fetchLeaderboard() {
    if (!listContainer) return;

    // Tampilkan Loading
    listContainer.innerHTML = `
            <div class="flex min-h-[250px] flex-col items-center justify-center gap-3">
                <div class="w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
                <p class="text-on-surface-variant font-medium text-sm">Memuat data mitra...</p>
            </div>
        `;

    // Format ke MM YYYY (Misal: "06 2026")
    const currentPeriode = `${String(viewDate.getMonth() + 1).padStart(2, "0")} ${viewDate.getFullYear()}`;

    const { data: dbData, error } = await supabase
      .from("leaderboard_bulanan_mitra")
      .select("*")
      .eq("periode", currentPeriode)
      .order(activeCategory, { ascending: false })
      .limit(5);

    if (error) {
      console.error("Gagal fetch leaderboard:", error);
      listContainer.innerHTML =
        '<p class="text-center text-error mt-8 font-medium">Gagal memuat data dari server.</p>';
      return;
    }

    renderLeaderboard(dbData);
  }

  // 3. Fungsi Render Tabel/List Premium
  function renderLeaderboard(data: any[]) {
    if (!listContainer) return;
    listContainer.innerHTML = "";

    if (!data || data.length === 0) {
      listContainer.innerHTML = `
                <div class="flex flex-col min-h-[250px] items-center justify-center text-center px-4 bg-surface-container/30 rounded-2xl border border-dashed border-outline-variant">
                    <span class="text-4xl mb-3">📭</span>
                    <p class="text-on-surface font-semibold">Belum ada transaksi</p>
                    <p class="text-on-surface-variant text-sm mt-1">Tidak ada data setoran untuk bulan ini.</p>
                </div>
            `;
      return;
    }

    // Cari nilai tertinggi untuk bikin efek visual bar-chart
    const maxValue = Math.max(...data.map((m: any) => m[activeCategory] || 0));

    // Render List
    data.forEach((mitra: any, index: number) => {
      const rank = index + 1;
      const value = mitra[activeCategory] || 0;
      const percentage = maxValue > 0 ? (value / maxValue) * 100 : 0;

      // Logika Visual Medali Peringkat
      let rankStyle = "bg-surface-variant text-on-surface-variant";
      let rankIcon = `#${rank}`;
      let borderStyle = "border-outline-variant";

      if (rank === 1) {
        rankStyle = "bg-amber-100 text-amber-700 shadow-sm shadow-amber-200"; // Emas
        rankIcon = "🥇";
        borderStyle = "border-amber-200 bg-amber-50/30";
      } else if (rank === 2) {
        rankStyle = "bg-slate-200 text-slate-700 shadow-sm shadow-slate-300"; // Perak
        rankIcon = "🥈";
        borderStyle = "border-slate-200 bg-slate-50/50";
      } else if (rank === 3) {
        rankStyle = "bg-orange-100 text-orange-800 shadow-sm shadow-orange-200"; // Perunggu
        rankIcon = "🥉";
        borderStyle = "border-orange-200 bg-orange-50/30";
      }

      const cardHtml = `
                <div class="relative flex items-center gap-4 p-4 border ${borderStyle} rounded-2xl hover:scale-[1.01] transition-transform duration-200 overflow-hidden group bg-surface">
                    
                    <div class="absolute left-0 bottom-0 top-0 bg-primary/5 -z-10 transition-all duration-700 ease-out group-hover:bg-primary/10" style="width: ${percentage}%"></div>

                    <div class="font-bold text-xl flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center ${rankStyle} z-10">
                        ${rankIcon}
                    </div>
                    
                    <div class="flex-1 min-w-0 z-10">
                        <p class="font-bold text-on-surface truncate text-lg">${mitra.nama_mitra}</p>
                        <p class="text-sm text-on-surface-variant flex items-center gap-1 mt-0.5">
                            Total disetor: <span class="font-bold text-primary">${value.toLocaleString("id-ID")} KG</span>
                        </p>
                    </div>
                </div>
            `;
      listContainer.insertAdjacentHTML("beforeend", cardHtml);
    });
  }

  // 4. Event Listeners Navigasi Bulan
  if (prevMonthBtn) {
    prevMonthBtn.addEventListener("click", () => {
      // Mundur 1 bulan
      viewDate.setMonth(viewDate.getMonth() - 1);
      updateMonthUI();
      fetchLeaderboard();
    });
  }

  if (nextMonthBtn) {
    nextMonthBtn.addEventListener("click", () => {
      // Cek biar nggak bisa nembus ke masa depan
      const isCurrentMonth =
        viewDate.getMonth() === realCurrentDate.getMonth() &&
        viewDate.getFullYear() === realCurrentDate.getFullYear();
      if (isCurrentMonth) return;

      // Maju 1 bulan
      viewDate.setMonth(viewDate.getMonth() + 1);
      updateMonthUI();
      fetchLeaderboard();
    });
  }

  // 5. Event Listeners Filter Komoditas
  filterButtons.forEach((button) => {
    button.addEventListener("click", (e) => {
      // Tambahkan "as HTMLElement" di sini
      const btn = e.currentTarget as HTMLElement;
      if (!btn) return;

      // Sekarang getAttribute tidak akan error (Baris 207)
      activeCategory = btn.getAttribute("data-category") || "total_keseluruhan";

      filterButtons.forEach((b) => {
        b.classList.remove("bg-primary", "text-on-primary", "border-primary");
        b.classList.add("border-outline", "text-on-surface", "border");
      });

      // Sekarang classList tidak akan error (Baris 214 & 215)
      btn.classList.add("bg-primary", "text-on-primary", "border-primary");
      btn.classList.remove("border-outline", "text-on-surface");

      fetchLeaderboard();
    });
  });

  // 6. Jalankan Pertama Kali (Inisialisasi)
  const defaultBtn = document.querySelector(
    '[data-category="total_keseluruhan"]',
  );
  if (defaultBtn) {
    defaultBtn.classList.add("bg-primary", "text-on-primary", "border-primary");
    defaultBtn.classList.remove("border-outline", "text-on-surface");
  }

  updateMonthUI();
  fetchLeaderboard();
</script>

<style>
  /* Sembunyikan scrollbar di filter button supaya rapi di HP */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
