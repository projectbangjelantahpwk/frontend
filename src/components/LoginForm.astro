---
import 'bootstrap-icons/font/bootstrap-icons.css';
---

<form id="loginForm">
  <div class="form-group">
    <label class="form-label" for="username">Username / ID Lapangan</label>
    <div class="input-icon">
      <i class="bi bi-person"></i>
      <input
        type="text"
        id="username"
        name="username"
        class="form-input"
        placeholder="Masukkan username anda"
        required
      />
    </div>
  </div>

  <div class="form-group">
    <label class="form-label" for="password">Password</label>
    <div class="input-icon">
      <i class="bi bi-lock" id="togglePassword"></i>
      <input
        type="password"
        id="password"
        name="password"
        class="form-input"
        placeholder="Masukkan password anda"
        required
      />
    </div>
  </div>

  <div class="remember-forgot">
    <div class="checkbox-wrapper">
      <input type="checkbox" id="remember" name="remember" />
      <label for="remember" style="cursor: pointer; margin: 0;">Ingat saya</label>
    </div>
    <a href="#" class="forgot-link">Lupa Password?</a>
  </div>

  <button type="submit" class="submit-btn" id="submitBtn">
    Masuk
  </button>
  
  <div id="errorMessage" style="display: none; color: #dc2626; font-size: 14px; margin-top: 12px; padding: 12px; background-color: #fee2e2; border-radius: 6px;"></div>

  <div id="loadingIndicator" style="display: none; text-align: center; margin-top: 16px;">
    <p style="color: #6b7280; font-size: 14px;">Sedang memproses...</p>
  </div>
</form>

<script>
  // 1. IMPORT KONEKSI SUPABASE
  // PASTIKAN file ini benar-benar ada di folder src/lib/supabase.js
  import { supabase } from '../lib/supabase.js';

  // Biar aman, kita jalankan script setelah seluruh elemen HTML selesai di-load
  document.addEventListener('DOMContentLoaded', () => {
    
    // 2. TOGGLE VISIBILITAS PASSWORD
    const passwordInput = document.getElementById('password');
    const lockIcon = document.getElementById('togglePassword');
    
    if (lockIcon && passwordInput) {
      lockIcon.style.cursor = 'pointer';
      lockIcon.addEventListener('click', function() {
        if (passwordInput.type === 'password') {
          passwordInput.type = 'text';
          this.classList.remove('bi-lock');
          this.classList.add('bi-lock-fill');
        } else {
          passwordInput.type = 'password';
          this.classList.remove('bi-lock-fill');
          this.classList.add('bi-lock');
        }
      });
    }

    // 3. LOGIKA LOGIN SUPABASE
    const loginForm = document.getElementById('loginForm');
    const errorMessage = document.getElementById('errorMessage');
    const loadingIndicator = document.getElementById('loadingIndicator');
    const submitBtn = document.getElementById('submitBtn');

    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        // NAH! Ini yang nahan biar URL nggak berubah jadi ?username=...
        e.preventDefault(); 

        // Reset UI state
        if (errorMessage) errorMessage.style.display = 'none';
        if (loadingIndicator) loadingIndicator.style.display = 'block';
        if (submitBtn) submitBtn.disabled = true;

        // Ambil value dari input form
        const usernameInput = document.getElementById('username').value.trim();
        const passwordInputVal = document.getElementById('password').value;

        // TRIK SUPABASE: Ubah username jadi format email dummy
        const dummyEmail = `${usernameInput}@bangjelantah.local`.toLowerCase();

        try {
          // Tembak API Supabase
          const { data, error } = await supabase.auth.signInWithPassword({
            email: dummyEmail,
            password: passwordInputVal,
          });

          if (error) {
            throw error;
          }

          // Jika sukses, lempar user ke halaman Dashboard
          window.location.href = '/';
          
        } catch (error) {
          // Tangani error dan tampilkan di UI
          if (errorMessage) {
            errorMessage.textContent = error.message === 'Invalid login credentials' 
              ? 'Username atau password salah!' 
              : error.message;
            errorMessage.style.display = 'block';
          }
        } finally {
          // Kembalikan tombol seperti semula
          if (loadingIndicator) loadingIndicator.style.display = 'none';
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    }
  });
</script>