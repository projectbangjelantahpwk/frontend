      </div>
      <div class="w-full sm:w-1/4">
        <select class="w-full border rounded p-1.5 text-xs outline-none font-bold ${colorClass}" 
                onchange="window.updateLainLainRiwayat(${index}, 'tipe', this.value)">
          <option value="penambahan" ${isPenambahan ? "selected" : ""}>+ Nambah</option>
          <option value="potongan" ${!isPenambahan ? "selected" : ""}>- Potong</option>
        </select>
      </div>
      <div class="w-full sm:w-1/3 flex gap-2">
        <input type="number" placeholder="Nominal (Rp)" 
               class="w-full border-gray-300 rounded p-1.5 text-xs outline-none focus:border-blue-500 shadow-inner font-mono font-bold" 
               value="${item.nominal || ""}" oninput="window.updateLainLainRiwayat(${index}, 'nominal', this.value)" />
        
        <button type="button" onclick="window.hapusLainLainRiwayat(${index})" class="bg-red-100 text-red-600 px-2.5 rounded hover:bg-red-200 transition-colors shadow-sm flex items-center justify-center">
          <i class="bi bi-trash"></i>
        </button>
      </div>
    </div>`;
        container.insertAdjacentHTML("beforeend", rowHTML);
      });
