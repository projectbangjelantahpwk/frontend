---
import Layout from "../layouts/Layout.astro";
import "bootstrap-icons/font/bootstrap-icons.css";
---

<Layout title="Manajemen Armada - Bang Jelantah">
  <style is:global>
    body {
      display: none;
    } /* Kunci layar sampai verifikasi role beres */
  </style>
  <style>
    .tab-content {
      display: none;
    }
    .tab-content.active {
      display: block;
    }

    /* Mobile Table Cards Style */
    @media (max-width: 768px) {
      .mobile-table-card thead {
        display: none;
      }
      .mobile-table-card tbody tr {
        display: flex;
        flex-direction: column;
        margin-bottom: 1rem;
        border: 1px solid #e0e4d6;
        border-radius: 0.75rem;
        background-color: #ffffff;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      }
      .mobile-table-card tbody td {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
        padding: 12px 16px;
        border-bottom: 1px solid #f0f2ec;
        font-size: 13px;
        text-align: right;
        gap: 16px;
      }
      .mobile-table-card tbody td:last-child {
        border-bottom: none;
        background-color: #fdfdf5;
        align-items: center;
        justify-content: flex-end;
      }
      .mobile-table-card tbody td::before {
        content: attr(data-label);
        font-weight: 700;
        color: #5d624c;
        font-size: 11px;
        text-transform: uppercase;
        text-align: left;
        flex-shrink: 0;
        width: 35%;
      }
      .mobile-table-card tbody td > div,
      .mobile-table-card tbody td > span,
      .mobile-table-card tbody td > img {
        word-break: break-word;
        text-align: right;
        justify-content: flex-end;
      }
    }
  </style>

  <div class="max-w-7xl mx-auto flex flex-col h-full">
    <!-- HEADER -->
    <div
      class="mb-lg flex flex-col md:flex-row md:items-end justify-between gap-md"
    >
      <div>
        <h1
          class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary"
        >
          Manajemen Armada
        </h1>
        <p class="font-body-md text-body-md text-on-surface-variant mt-xs">
          Pendaftaran kendaraan & verifikasi pengecekan operasional
        </p>
      </div>
      <div
        class="flex flex-wrap gap-2 w-full md:w-auto mt-4 md:mt-0"
        id="action-buttons-container"
      >
        <button
          id="btn-tambah-mobil"
          onclick="window.bukaModalTambahMobil()"
          class="bg-primary text-on-primary font-label-lg rounded-full px-4 py-2 hover:opacity-90 transition-all shadow-sm flex items-center gap-2"
        >
          <i class="bi bi-truck"></i> Tambah Mobil
        </button>
        <button
          id="btn-tambah-motor"
          onclick="window.bukaModalTambahMotor()"
          class="bg-green-600 text-white font-label-lg rounded-full px-4 py-2 hover:bg-green-700 transition-all shadow-sm flex items-center gap-2"
        >
          <i class="bi bi-bicycle"></i> Tambah Motor
        </button>
        <button
          id="btn-tambah-service"
          onclick="window.bukaModalService()"
          class="bg-blue-600 text-white font-label-lg rounded-full px-4 py-2 hover:bg-blue-700 transition-all shadow-sm flex items-center gap-2"
        >
          <i class="bi bi-tools"></i> Input Service
        </button>
      </div>
    </div>

    <!-- TABS -->
    <div
      class="flex border-b border-outline-variant mb-md overflow-x-auto hide-scrollbar"
    >
      <button
        class="px-md py-sm font-label-lg text-primary border-b-2 border-primary whitespace-nowrap"
        id="tab-armada-mobil"
        onclick="window.switchTab('armada-mobil')">Armada Mobil</button
      >
      <button
        class="px-md py-sm font-label-lg text-on-surface-variant border-b-2 border-transparent hover:bg-surface-container-low transition-colors whitespace-nowrap"
        id="tab-armada-motor"
        onclick="window.switchTab('armada-motor')">Armada Motor</button
      >
      <button
        class="px-md py-sm font-label-lg text-on-surface-variant border-b-2 border-transparent hover:bg-surface-container-low transition-colors whitespace-nowrap"
        id="tab-pengecekan-mobil"
        onclick="window.switchTab('pengecekan-mobil')">Cek Mobil</button
      >
      <button
        class="px-md py-sm font-label-lg text-on-surface-variant border-b-2 border-transparent hover:bg-surface-container-low transition-colors whitespace-nowrap"
        id="tab-pengecekan-motor"
        onclick="window.switchTab('pengecekan-motor')">Cek Motor</button
      >
      <button
        class="px-md py-sm font-label-lg text-on-surface-variant border-b-2 border-transparent hover:bg-surface-container-low transition-colors whitespace-nowrap"
        id="tab-service"
        onclick="window.switchTab('service')">Riwayat Service</button
      >
    </div>

    <!-- TAB 1: DATA MOBIL -->
    <div class="tab-content active" id="content-armada-mobil">
      <div
        class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden flex flex-col"
      >
        <div class="overflow-x-auto">
          <table
            class="w-full text-left border-collapse mobile-table-card md:min-w-[800px]"
          >
            <thead>
              <tr
                class="bg-surface-container-low border-b border-outline-variant"
              >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase w-20 text-center"
                  >Foto</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                  >Plat Nomor</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                  >Nama Kendaraan</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                  >Jenis</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase text-right"
                  >Aksi</th
                >
              </tr>
            </thead>
            <tbody
              class="divide-y divide-outline-variant font-body-md text-on-surface bg-surface-container-lowest"
              id="tbody-mobil"
            >
              <tr
                ><td colspan="5" class="p-4 text-center text-on-surface-variant"
                  >Memuat data armada...</td
                ></tr
              >
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 2: DATA MOTOR -->
    <div class="tab-content" id="content-armada-motor">
      <div
        class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden flex flex-col"
      >
        <div class="overflow-x-auto">
          <table
            class="w-full text-left border-collapse mobile-table-card md:min-w-[800px]"
          >
            <thead>
              <tr
                class="bg-surface-container-low border-b border-outline-variant"
              >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase w-20 text-center"
                  >Foto</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                  >Plat Nomor</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                  >Nama Motor</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                  >Jenis</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase text-right"
                  >Aksi</th
                >
              </tr>
            </thead>
            <tbody
              class="divide-y divide-outline-variant font-body-md text-on-surface bg-surface-container-lowest"
              id="tbody-motor"
            >
              <tr
                ><td colspan="5" class="p-4 text-center text-on-surface-variant"
                  >Memuat data armada motor...</td
                ></tr
              >
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 3: RIWAYAT PENGECEKAN MOBIL -->
    <div class="tab-content" id="content-pengecekan-mobil">
      <div
        class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden flex flex-col"
      >
        <div
          class="p-3 bg-surface-container-low border-b border-outline-variant flex justify-between items-center"
        >
          <h3 class="font-bold text-sm">Laporan Pengecekan Mobil</h3>
          <input
            type="month"
            id="filter-bulan-cek-mobil"
            onchange="window.loadPengecekan()"
            class="border border-outline-variant rounded-md px-2 py-1 text-xs outline-none focus:border-primary"
          />
        </div>
        <div class="overflow-x-auto">
          <table
            class="w-full text-left border-collapse mobile-table-card md:min-w-[900px]"
          >
            <thead>
              <tr
                class="bg-surface-container-low border-b border-outline-variant"
              >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                  >Tanggal & Sesi</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                  >Mobil</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                  >Hasil Inspeksi</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                  >Petugas Lapangan</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase text-right"
                  >Verifikasi</th
                >
              </tr>
            </thead>
            <tbody
              class="divide-y divide-outline-variant font-body-md text-on-surface bg-surface-container-lowest"
              id="tbody-pengecekan-mobil"
            >
              <tr
                ><td colspan="5" class="p-4 text-center text-on-surface-variant"
                  >Memuat histori pengecekan...</td
                ></tr
              >
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 4: RIWAYAT PENGECEKAN MOTOR -->
    <div class="tab-content" id="content-pengecekan-motor">
      <div
        class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden flex flex-col"
      >
        <div
          class="p-3 bg-surface-container-low border-b border-outline-variant flex justify-between items-center"
        >
          <h3 class="font-bold text-sm">Laporan Pengecekan Motor</h3>
          <input
            type="month"
            id="filter-bulan-cek-motor"
            onchange="window.loadPengecekanMotor()"
            class="border border-outline-variant rounded-md px-2 py-1 text-xs outline-none focus:border-primary"
          />
        </div>
        <div class="overflow-x-auto">
          <table
            class="w-full text-left border-collapse mobile-table-card md:min-w-[900px]"
          >
            <thead>
              <tr
                class="bg-surface-container-low border-b border-outline-variant"
              >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                  >Tanggal</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                  >Motor</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                  >Hasil Inspeksi</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                  >Petugas Lapangan</th
                >
                <th
                  class="px-md py-sm font-label-sm text-on-surface-variant uppercase text-right"
                  >Verifikasi</th
                >
              </tr>
            </thead>
            <tbody
              class="divide-y divide-outline-variant font-body-md text-on-surface bg-surface-container-lowest"
              id="tbody-pengecekan-motor"
            >
              <tr
                ><td colspan="5" class="p-4 text-center text-on-surface-variant"
                  >Memuat histori pengecekan motor...</td
                ></tr
              >
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <!-- TAB 5: RIWAYAT SERVICE -->
  <div class="tab-content" id="content-service">
    <div
      class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden flex flex-col"
    >
      <div
        class="p-3 bg-surface-container-low border-b border-outline-variant flex justify-between items-center"
      >
        <h3 class="font-bold text-sm">Riwayat & Biaya Service</h3>
        <input
          type="month"
          id="filter-bulan-service"
          onchange="window.loadService()"
          class="border border-outline-variant rounded-md px-2 py-1 text-xs outline-none focus:border-primary"
        />
      </div>
      <div class="overflow-x-auto">
        <table
          class="w-full text-left border-collapse mobile-table-card md:min-w-225"
        >
          <thead>
            <tr
              class="bg-surface-container-low border-b border-outline-variant"
            >
              <th
                class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                >Tanggal</th
              >
              <th
                class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                >Kendaraan</th
              >
              <th
                class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                >Nama Bengkel</th
              >
              <th
                class="px-md py-sm font-label-sm text-on-surface-variant uppercase"
                >Detail Perbaikan</th
              >
              <th
                class="px-md py-sm font-label-sm text-on-surface-variant uppercase text-right"
                >Biaya (Rp)</th
              >
              <th
                class="px-md py-sm font-label-sm text-on-surface-variant uppercase text-right"
                >Aksi</th
              >
            </tr>
          </thead>
          <tbody
            class="divide-y divide-outline-variant font-body-md text-on-surface bg-surface-container-lowest"
            id="tbody-service"
          >
            <tr
              ><td colspan="6" class="p-4 text-center text-on-surface-variant"
                >Memuat riwayat service...</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <!-- ================= MODAL TAMBAH MOBIL ================= -->
  <div
    class="fixed inset-0 z-50 bg-black/50 hidden items-center justify-center p-4 opacity-0 transition-opacity"
    id="modal-tambah-mobil"
  >
    <div
      class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh]"
    >
      <div
        class="p-5 border-b border-gray-100 flex justify-between items-center bg-gray-50 shrink-0"
      >
        <h3 class="font-bold text-lg">Registrasi Mobil Baru</h3>
        <button
          type="button"
          onclick="window.closeModal('modal-tambah-mobil')"
          class="text-gray-400 hover:text-gray-900"
          ><i class="bi bi-x-lg"></i></button
        >
      </div>
      <form
        id="form-mobil"
        onsubmit="window.simpanMobil(event)"
        class="p-6 space-y-4 overflow-y-auto"
      >
        <input type="hidden" id="edit_mobil_id" value="" />
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase mb-1"
            >Plat Nomor</label
          >
          <input
            type="text"
            id="mob_plat"
            class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-primary uppercase"
            required
            placeholder="Contoh: T 1234 ABC"
          />
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase mb-1"
            >Nama Kendaraan</label
          >
          <input
            type="text"
            id="mob_nama"
            class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-primary"
            required
            placeholder="Contoh: Grand Max Hitam"
          />
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase mb-1"
            >Jenis Kendaraan</label
          >
          <select
            id="mob_jenis"
            class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-primary"
          >
            <option value="Pickup">Pickup</option>
            <option value="Box">Mobil Box</option>
            <option value="Engkel">Truk Engkel</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase mb-1"
            >Foto Kendaraan</label
          >
          <div
            id="dropZoneMobil"
            class="relative border-2 border-dashed border-gray-300 rounded-xl p-6 text-center cursor-pointer hover:border-primary hover:bg-primary/5 transition bg-surface-container-lowest overflow-hidden h-40 flex flex-col items-center justify-center"
          >
            <div id="dropZonePlaceholder">
              <i class="bi bi-cloud-upload text-3xl text-gray-400 mb-2 block"
              ></i>
              <p class="text-sm text-gray-600 mb-1">Tarik & Lepas Gambar</p>
              <p class="text-xs text-gray-500">
                atau klik untuk memilih (JPG, PNG)
              </p>
            </div>
            <img
              id="previewMobil"
              src=""
              alt="Preview"
              class="hidden absolute inset-0 w-full h-full object-cover z-10"
            />
            <input
              type="file"
              id="mob_foto_file"
              accept="image/jpeg,image/png"
              class="hidden"
            />
          </div>
          <div class="flex justify-between items-center mt-2">
            <p
              id="fileNameMobil"
              class="text-sm text-primary font-bold truncate"
            >
            </p>
            <button
              type="button"
              id="btnHapusPreview"
              class="hidden text-xs text-red-500 hover:text-red-700 font-bold px-2 py-1 bg-red-50 hover:bg-red-100 rounded transition"
              title="Batal pilih foto">Hapus Foto</button
            >
          </div>
        </div>
        <div class="pt-2">
          <button
            type="submit"
            id="btn-save-mobil"
            class="w-full bg-primary text-white font-bold py-3 rounded-xl hover:opacity-90 transition shadow-sm"
            >Simpan Ke Database</button
          >
        </div>
      </form>
    </div>
  </div>

  <!-- ================= MODAL TAMBAH MOTOR ================= -->
  <div
    class="fixed inset-0 z-50 bg-black/50 hidden items-center justify-center p-4 opacity-0 transition-opacity"
    id="modal-tambah-motor"
  >
    <div
      class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh]"
    >
      <div
        class="p-5 border-b border-gray-100 flex justify-between items-center bg-gray-50 shrink-0"
      >
        <h3 class="font-bold text-lg">Registrasi Motor Baru</h3>
        <button
          type="button"
          onclick="window.closeModal('modal-tambah-motor')"
          class="text-gray-400 hover:text-gray-900"
          ><i class="bi bi-x-lg"></i></button
        >
      </div>
      <form
        id="form-motor"
        onsubmit="window.simpanMotor(event)"
        class="p-6 space-y-4 overflow-y-auto"
      >
        <input type="hidden" id="edit_motor_id" value="" />
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase mb-1"
            >Plat Nomor</label
          >
          <input
            type="text"
            id="mot_plat"
            class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600 uppercase"
            required
            placeholder="Contoh: T 5678 XYZ"
          />
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase mb-1"
            >Nama Motor</label
          >
          <input
            type="text"
            id="mot_nama"
            class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600"
            required
            placeholder="Contoh: Honda Beat 2021"
          />
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase mb-1"
            >Jenis Kendaraan</label
          >
          <select
            id="mot_jenis"
            class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600"
          >
            <option value="Matic">Matic</option>
            <option value="Bebek">Bebek</option>
            <option value="Kopling">Kopling</option>
            <option value="Roda Tiga">Roda Tiga / Tossa</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-500 uppercase mb-1"
            >Foto Motor</label
          >
          <div
            id="dropZoneMotor"
            class="relative border-2 border-dashed border-gray-300 rounded-xl p-6 text-center cursor-pointer hover:border-green-600 hover:bg-green-50 transition bg-surface-container-lowest overflow-hidden h-40 flex flex-col items-center justify-center"
          >
            <div id="dropZonePlaceholderMotor">
              <i class="bi bi-cloud-upload text-3xl text-gray-400 mb-2 block"
              ></i>
              <p class="text-sm text-gray-600 mb-1">Tarik & Lepas Gambar</p>
              <p class="text-xs text-gray-500">
                atau klik untuk memilih (JPG, PNG)
              </p>
            </div>
            <img
              id="previewMotor"
              src=""
              alt="Preview"
              class="hidden absolute inset-0 w-full h-full object-cover z-10"
            />
            <input
              type="file"
              id="mot_foto_file"
              accept="image/jpeg,image/png"
              class="hidden"
            />
          </div>
          <div class="flex justify-between items-center mt-2">
            <p
              id="fileNameMotor"
              class="text-sm text-green-600 font-bold truncate"
            >
            </p>
            <button
              type="button"
              id="btnHapusPreviewMotor"
              class="hidden text-xs text-red-500 hover:text-red-700 font-bold px-2 py-1 bg-red-50 hover:bg-red-100 rounded transition"
              title="Batal pilih foto">Hapus Foto</button
            >
          </div>
        </div>
        <div class="pt-2">
          <button
            type="submit"
            id="btn-save-motor"
            class="w-full bg-green-600 text-white font-bold py-3 rounded-xl hover:bg-green-700 transition shadow-sm"
            >Simpan Ke Database</button
          >
        </div>
      </form>
    </div>
  </div>
  <!-- ================= MODAL TAMBAH SERVICE ================= -->
  <div
    class="fixed inset-0 z-50 bg-black/50 hidden items-center justify-center p-4 opacity-0 transition-opacity"
    id="modal-tambah-service"
  >
    <div
      class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh]"
    >
      <div
        class="p-5 border-b border-gray-100 flex justify-between items-center bg-blue-50 shrink-0"
      >
        <div>
          <h3 class="font-bold text-lg text-gray-900">Input Catatan Service</h3>
          <p class="text-xs text-blue-800 font-medium">
            Rekap pengeluaran bengkel untuk armada
          </p>
        </div>
        <button
          type="button"
          onclick="window.closeModal('modal-tambah-service')"
          class="text-gray-400 hover:text-gray-900"
          ><i class="bi bi-x-lg"></i></button
        >
      </div>
      <form
        id="form-service"
        onsubmit="window.simpanService(event)"
        class="p-6 space-y-4 overflow-y-auto"
      >
        <input type="hidden" id="edit_service_id" value="" />

        <div class="flex gap-4 mb-2">
          <label
            class="flex items-center gap-2 text-sm text-gray-700 font-bold cursor-pointer"
          >
            <input
              type="radio"
              name="srv_jenis"
              value="mobil"
              checked
              onchange="window.toggleJenisService()"
              class="accent-blue-600 w-4 h-4"
            /> Mobil
          </label>
          <label
            class="flex items-center gap-2 text-sm text-gray-700 font-bold cursor-pointer"
          >
            <input
              type="radio"
              name="srv_jenis"
              value="motor"
              onchange="window.toggleJenisService()"
              class="accent-blue-600 w-4 h-4"
            /> Motor
          </label>
        </div>

        <div id="container-srv-mobil">
          <label class="block text-xs font-bold text-gray-500 uppercase mb-1"
            >Pilih Mobil</label
          >
          <select
            id="srv_mobil"
            class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-blue-600 font-medium"
          ></select>
        </div>

        <div id="container-srv-motor" class="hidden">
          <label class="block text-xs font-bold text-gray-500 uppercase mb-1"
            >Pilih Motor</label
          >
          <select
            id="srv_motor"
            class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-blue-600 font-medium"
          ></select>
