              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Ampas</label>
                <input type="number" step="0.01" name="ampas" value="${data?.ampas || 0}" class="w-full px-4 py-2 border border-gray-300 rounded-lg" />
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Kriuk</label>
                <input type="number" step="0.01" name="kriuk" value="${data?.kriuk || 0}" class="w-full px-4 py-2 border border-gray-300 rounded-lg" />
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Spinner</label>
                <input type="number" step="0.01" name="spinner" value="${data?.spinner || 0}" class="w-full px-4 py-2 border border-gray-300 rounded-lg" />
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Tepung</label>
                <input type="number" step="0.01" name="tepung" value="${data?.tepung || 0}" class="w-full px-4 py-2 border border-gray-300 rounded-lg" />
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1 text-blue-700">Total Keseluruhan Kg</label>
                <input type="number" step="0.01" name="total_kg" value="${data?.total_kg || 0}" class="w-full px-4 py-2 border border-blue-300 bg-blue-50 rounded-lg outline-none focus:border-blue-700 font-bold text-blue-700" />
              </div>
            </div>
          </div>
        </div>
      `;
      }

