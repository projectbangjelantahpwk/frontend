        const container = document.getElementById("formFieldsContainer");
        container.innerHTML = `
        <div class="space-y-4">
          <h3 class="text-sm font-bold text-gray-900 border-b pb-2">Data Stok Gudang Harian</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Tanggal</label>
              <input type="date" name="tanggal" value="${data?.tanggal || ""}" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:border-green-700" required />
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Sumber</label>
              <input type="text" name="sumber" value="${data?.sumber || ""}" placeholder="Asal/sumber stok" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:border-green-700" required />
            </div>
          </div>
          <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
