---
import GeneralLayout from '../layouts/Layout.astro';
import 'bootstrap-icons/font/bootstrap-icons.css';
---

<GeneralLayout title="Pengeluaran Ops - Manajemen Bang Jelantah">
    <style is:global>
        /* Mengunci layar menjadi blank (putih) sampai skrip memberi izin masuk */
        body { display: none; }
    </style>

  <div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Pengeluaran Operasional</h1>
      <p class="text-gray-600">Kelola dan catat dana talang operasional karyawan serta driver lapangan.</p>
    </div>
  </div>

  <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm mb-6 flex flex-wrap gap-4 items-center relative z-20">
    <div>
        <label class="block text-xs font-bold text-gray-600 mb-1">Mulai Tanggal</label>
        <input type="date" id="filter-start-pengeluaran" class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-600">
    </div>
    <div>
        <label class="block text-xs font-bold text-gray-600 mb-1">Sampai Tanggal</label>
        <input type="date" id="filter-end-pengeluaran" class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-600">
    </div>
    <div class="flex gap-2 items-center">
        <button onclick="filterTabelPengeluaran()" class="bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-green-800">Filter Data</button>
        
        <div class="group relative cursor-help">
            <div class="w-9 h-9 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center border border-blue-200 hover:bg-blue-100 transition shadow-sm">
                <i class="bi bi-info-circle-fill text-lg"></i>
            </div>
            <div class="absolute left-0 md:left-auto md:right-0 top-full mt-2 w-64 bg-white border border-gray-200 shadow-xl rounded-xl p-4 hidden group-hover:block transition-all z-50">
                <h4 class="text-xs font-bold text-gray-800 mb-3 border-b border-gray-100 pb-2"><i class="bi bi-palette mr-1 text-blue-500"></i> Panduan Warna Item</h4>
                <ul class="text-[11px] space-y-2.5 font-medium text-gray-600">
                    <li class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-gray-800 shadow-sm"></span> <b>Hitam / Gelap:</b> Item sudah di-ACC (Selesai).</li>
                    <li class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-red-600 shadow-sm"></span> <b class="text-red-600">Merah:</b> Nombok / Kasbon (Belum ACC).</li>
                    <li class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-blue-500 shadow-sm"></span> <b class="text-blue-600">Biru:</b> Dana Uang Jalan otomatis.</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="flex justify-end w-full md:w-auto md:ml-auto">
        <button onclick="window.bukaModalTambahPengeluaran()" class="bg-green-700 text-white px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-green-800 transition shadow-sm flex items-center gap-2 w-full md:w-auto justify-center">
            <i class="bi bi-plus-circle-fill"></i> Input Pengeluaran
        </button>
    </div>
</div>

  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm">
      <div class="overflow-x-auto max-h-[600px]">
          <table class="w-full text-left" id="tabel-pengeluaran">
              <thead class="bg-gray-50 sticky top-0">
                  <tr>
                      <th class="px-6 py-4 text-sm font-bold text-gray-900 whitespace-nowrap">Jam</th>
                      <th class="px-6 py-4 text-sm font-bold text-gray-900 whitespace-nowrap">Pengaju</th>
                      <th class="px-6 py-4 text-sm font-bold text-gray-900">Rincian</th>
                      <th class="px-6 py-4 text-sm font-bold text-gray-900 text-center">Aksi</th>
                  </tr>
              </thead>
              <tbody id="pengeluaran-tbody" class="divide-y divide-gray-200">
                  <tr><td colspan="4" class="text-center py-4 text-gray-500">Memuat...</td></tr>
              </tbody>
          </table>
      </div>
  </div>
</GeneralLayout>

<div id="modal-edit-pengeluaran" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0">
    <div class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh]">
        <div class="p-5 border-b border-gray-100 flex justify-between items-center bg-green-50 shrink-0">
            <div>
                <h3 class="font-bold text-lg text-gray-900">Edit Pengeluaran Ops</h3>
                <p class="text-xs text-green-700 font-medium">Koreksi kesalahan input kategori & nominal karyawan</p>
            </div>
            <button type="button" onclick="closeModal('modal-edit-pengeluaran')" class="text-gray-400 hover:text-gray-900"><i class="bi bi-x-lg"></i></button>
        </div>
        
        <form id="form-edit-pengeluaran" onsubmit="window.simpanEditPengeluaran(event)" class="p-5 overflow-y-auto flex-1 space-y-4">
            <input type="hidden" id="edit_peng_id">
            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Tanggal Operasional</label>
                <input type="date" id="edit_peng_tgl" class="w-full border border-gray-300 rounded-xl p-2.5 text-sm outline-none focus:border-green-600 font-medium" required>
            </div>
            
            <div class="border-t pt-3">
                <label class="block text-xs font-bold text-gray-900 uppercase mb-2">Daftar Item Rincian</label>
                <div id="edit_peng_items_container" class="space-y-3"></div>
            </div>

            <div class="bg-gray-100 p-3 rounded-xl border border-gray-200 font-bold text-xs flex justify-between items-center mt-2">
                <span>TOTAL KAS HARIAN:</span>
                <span id="edit_peng_total_text" class="text-green-700 text-base font-mono">Rp 0</span>
            </div>

            <button type="submit" id="btn-save-peng" class="w-full bg-green-700 text-white font-bold py-3 rounded-xl hover:bg-green-800 transition shadow-sm font-mono">
                SIMPAN PERUBAHAN DATA
            </button>
        </form>
    </div>
</div>

<div id="modal-tambah-pengeluaran" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0">
    <div class="bg-white rounded-2xl w-full max-w-xl overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh]">
        <div class="p-5 border-b border-gray-100 flex justify-between items-center bg-green-700 shrink-0 text-white">
            <div>
                <h3 class="font-bold text-lg">Input Pengeluaran Mandiri (Admin)</h3>
                <p class="text-xs text-green-100 font-medium">Catat pengeluaran operasional langsung ke akun karyawan</p>
            </div>
            <button type="button" onclick="closeModal('modal-tambah-pengeluaran')" class="text-white/70 hover:text-white"><i class="bi bi-x-lg"></i></button>
        </div>
        
        <form id="form-tambah-pengeluaran" onsubmit="window.eksekusiTambahPengeluaran(event)" class="p-5 overflow-y-auto flex-1 space-y-4">
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Pilih Karyawan / Driver</label>
                    <select id="add_peng_user_id" class="w-full border border-gray-300 rounded-xl p-2.5 text-sm outline-none focus:border-green-600 bg-white font-medium" required></select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Tanggal Nota</label>
                    <input type="date" id="add_peng_tgl" class="w-full border border-gray-300 rounded-xl p-2.5 text-sm outline-none focus:border-green-600 font-medium" required>
                </div>
            </div>
            
            <div class="border-t pt-3">
                <div class="flex justify-between items-center mb-2">
                    <label class="block text-xs font-bold text-gray-900 uppercase">Item Rincian Barang</label>
                    <button type="button" onclick="window.tambahBarisItemBaru()" class="text-xs bg-blue-50 text-blue-700 px-2.5 py-1 rounded-lg border border-blue-200 font-bold hover:bg-blue-100"><i class="bi bi-plus"></i> Tambah Item</button>
                </div>
                <div id="add_peng_items_container" class="space-y-3"></div>
            </div>

            <div class="bg-gray-100 p-3 rounded-xl border border-gray-200 font-bold text-xs flex justify-between items-center mt-2">
                <span>TOTAL AKUMULASI PENGELUARAN:</span>
                <span id="add_peng_total_text" class="text-green-700 text-base font-mono">Rp 0</span>
            </div>

            <div class="mt-3 mb-1">
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Sumber Dana (Diambil Dari Kas Mana?)</label>
                <select id="add_sumber_dana" class="w-full border border-gray-300 rounded-xl p-2.5 text-sm outline-none focus:border-green-600 bg-white font-medium shadow-sm" required>
                    <option value="Uang Keuangan">Uang Keuangan</option>
                    <option value="Uang Gudang">Uang Gudang</option>
                </select>
            </div>

            <button type="submit" id="btn-submit-tambah-peng" class="w-full bg-green-700 text-white font-bold py-3 rounded-xl hover:bg-green-800 transition shadow-sm font-mono">
                SIMPAN SEMUA DATA KE SERVER
            </button>
        </form>
    </div>
</div>

<script is:inline>
  const masterKategoriOps = ['Bensin', 'Parkir', 'Uang Makan', 'Uang Jalan', 'E-Toll', 'Admin', 'Bongkar', 'Satpam', 'Service', 'Listrik', 'Karung', 'Plastik', 'Jasa Spinner', 'Lain-lain'];
  
  document.addEventListener('DOMContentLoaded', async () => {
      // === 🛡️ GATEKEEPER KEUANGAN ===
      const allowedRoles = ['owner', 'hrd', 'keuangan', 'admin'];
      const client = window.supabase || supabase;
      
      const { data: { session } } = await client.auth.getSession();
      if (!session) return window.location.replace('/'); 
      
      const { data: prof } = await client.from('profiles').select('role').eq('id', session.user.id).single();
      
      if (!allowedRoles.includes(prof?.role)) {
          alert(`Akses Ditolak! Role Anda (${prof?.role || 'Guest'}) dilarang masuk ke Keuangan.`);
          return window.location.replace('/');
      }
      document.body.style.display = 'block'; 

    // ==========================================
    // 1. FETCH DATA PENGELUARAN
    // ==========================================
    async function loadDataPengeluaran() {
        if(!window.supabase) return;
        try {
            const { data: pengeluaran } = await window.supabase.from('pengeluaran')
                .select('*, profiles(nama), rincian_pengeluaran(*)')
                .order('tanggal', { ascending: false })
                .order('updated_at', { ascending: false });

            const tbodyPengeluaran = document.getElementById('pengeluaran-tbody');
            let htmlPeng = '';
            let currentDate = ''; 

            pengeluaran?.forEach(p => {
                // 1. HEADER TANGGAL SEBAGAI PEMBATAS
                if (p.tanggal !== currentDate) {
                    currentDate = p.tanggal;
                    const dateObj = new Date(currentDate);
                    const tglFormat = dateObj.toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' });
                    
                    htmlPeng += `
                    <tr class="bg-gray-100/80 border-y border-gray-200 shadow-[inset_0_1px_0_rgba(255,255,255,1)]">
                        <td colspan="4" class="px-6 py-3 text-xs font-black text-gray-800 uppercase tracking-widest">
                            <i class="bi bi-calendar-day-fill mr-1 text-green-700 text-sm"></i> ${tglFormat}
                        </td>
                    </tr>`;
                }

                // 2. JAM UPDATE
                const timestamp = p.updated_at || p.created_at || null;
                const jamStr = timestamp ? new Date(timestamp).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' }) : '-';

                // 3. LOOPING PER ITEM DENGAN LOGIKA WARNA BARU
                p.rincian_pengeluaran?.forEach(r => {
                    const ketHtml = r.keterangan ? `<div class="text-[10px] text-gray-400 mt-0.5 line-clamp-1">${r.keterangan}</div>` : '';
                    
                    // Prioritas Status: Ambil dari rincian (jika ada), kalau kosong baru dari induk (p)
                    const itemStatus = r.status_approval || p.status_approval || 'Menunggu';

                    let textColor, nominalColor, badgeStatus;

                    // 🔥 LOGIKA WARNA (SESUAI REQUEST: HITAM JIKA ACC, MERAH JIKA BELUM) 🔥
                    if (itemStatus === 'Disetujui' && r.nama_item === 'Uang Jalan' && Number(r.nominal) > 0) {
                            statusBtn += `
                            <div class="mt-2 pt-2 border-t border-gray-200 w-full">
                                <button onclick="window.simpanSisaUangJalan('${r.id}', ${r.nominal}, '${p.sumber_dana || 'Uang Keuangan'}', '${p.id}')" class="bg-purple-50 text-purple-700 px-2 py-1.5 rounded text-[10px] font-bold hover:bg-purple-100 border border-purple-200 transition w-full shadow-sm flex items-center justify-center gap-1" title="Setor sisa uang ke laci Gudang">
                                    <i class="bi bi-safe2"></i> Simpan Uang
                                </button>
                            </div>`;
                    } else {
                        // BELUM DI-ACC / NOMBOK -> MERAH (Kecuali Uang Jalan = Biru)
                        if (r.nama_item === 'Uang Jalan') {
                            textColor = 'text-blue-600 font-bold';
                            nominalColor = 'text-blue-700 font-mono font-bold';
                            badgeStatus = `<span class="text-[9px] font-bold text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded border border-blue-200 ml-2 uppercase">Uang Jalan</span>`;
                        } else {
                            textColor = 'text-red-600 font-bold';
                            nominalColor = 'text-red-600 font-mono font-bold';
                            badgeStatus = `<span class="text-[9px] font-bold text-red-600 bg-red-50 px-1.5 py-0.5 rounded border border-red-200 ml-2 uppercase">Pending</span>`;
                        }
                    }

                    // Logika tombol aksi per item
                    // 🔥 LOGIKA TOMBOL AKSI PER ITEM (SUDAH DIBUNGKUS BACKTICK DENGAN BENAR) 🔥
                    let statusBtn = '';
                    if(itemStatus === 'Menunggu') {
                        statusBtn = `
                        <div class="flex flex-col gap-1.5">
                            <button onclick="window.approveItemDirect('${r.id}', 'Disetujui', '${p.sumber_dana || ''}', '${p.id}')" class="bg-green-50 text-green-700 px-2.5 py-1.5 rounded text-[11px] font-bold hover:bg-green-100 border border-green-200 text-left transition"><i class="bi bi-check2-circle mr-1"></i> ACC Item</button>
                            <div class="grid grid-cols-2 gap-1.5">
                                <button onclick="window.bukaModalEditItemDirect('${r.id}', '${r.nama_item}', ${r.nominal}, '${r.keterangan || ''}', '${p.sumber_dana || 'Uang Keuangan'}', '${p.id}')" class="bg-blue-50 text-blue-700 px-2 py-1 rounded text-[10px] font-bold hover:bg-blue-100 border border-blue-200 transition" title="Edit"><i class="bi bi-pencil-square"></i></button>
                                <button onclick="window.hapusItemPengeluaran('${r.id}')" class="bg-red-50 text-red-600 px-2 py-1 rounded text-[10px] font-bold hover:bg-red-100 border border-red-200 transition" title="Hapus"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>`;
                    } else {
                        const color = itemStatus === 'Disetujui' ? 'bg-gray-100 text-gray-700 border-gray-300' : 'bg-red-100 text-red-700 border-red-200';
                        statusBtn = `
                        <div class="flex flex-col gap-1 items-center justify-center">
                            <span class="inline-flex px-3 py-1 rounded text-[11px] font-bold border ${color}">${itemStatus}</span>
                            ${itemStatus === 'Ditolak' ? `<button onclick="window.hapusItemPengeluaran('${r.id}')" class="text-red-500 text-[10px] hover:text-red-700 mt-1 font-bold"><i class="bi bi-trash"></i> Hapus</button>` : ''}
                        </div>`;

                        // 🔥 TAMBAHAN TOMBOL SIMPAN SISA UANG JALAN 🔥
                        // Syarat muncul: Sudah di-ACC, namanya 'Uang Jalan', dan saldonya masih > 0
                        if (itemStatus === 'Disetujui' && r.nama_item === 'Uang Jalan' && Number(r.nominal) > 0) {
                            statusBtn += `
                            <div class="mt-2 pt-2 border-t border-gray-200 w-full">
                                <button onclick="window.simpanSisaUangJalan('${r.id}', ${r.nominal}, '${p.sumber_dana || 'Uang Keuangan'}')" class="bg-purple-50 text-purple-700 px-2 py-1.5 rounded text-[10px] font-bold hover:bg-purple-100 border border-purple-200 transition w-full shadow-sm flex items-center justify-center gap-1" title="Setor sisa uang ke laci Gudang">
                                    <i class="bi bi-safe2"></i> Simpan Uang
                                </button>
                            </div>`;
                        }
                    }

                    htmlPeng += `
                    <tr class="hover:bg-white transition-colors border-b border-gray-100" data-date="${p.tanggal}">
                        <td class="px-6 py-4 text-sm align-middle whitespace-nowrap font-mono text-gray-400 font-semibold">${jamStr}</td>
                        <td class="px-6 py-4 text-sm align-middle whitespace-nowrap">
                            <div class="text-gray-700 font-semibold"><i class="bi bi-person-fill text-gray-300 mr-1"></i> ${p.profiles?.nama || 'Unknown'}</div>
                            ${p.sumber_dana ? `<div class="mt-1.5 inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-purple-50 text-purple-700 border border-purple-200"><i class="bi bi-wallet2"></i> ${p.sumber_dana}</div>` : ''}
                        </td>
                        <td class="px-6 py-4 text-sm align-middle">
                            <div class="flex justify-between items-start gap-4">
                                <div class="${textColor}">
                                    <div class="flex items-center">
                                        <span class="text-sm tracking-tight">${r.nama_item}</span>
                                        ${badgeStatus}
                                    </div>
                                    ${ketHtml}
                                </div>
                                <div class="text-right whitespace-nowrap">
                                    <span class="${nominalColor} text-sm">Rp ${Number(r.nominal).toLocaleString('id-ID')}</span>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-3 text-xs align-middle w-32">${statusBtn}</td>
                    </tr>`;
                });
            });

            tbodyPengeluaran.innerHTML = htmlPeng || '<tr><td colspan=\"4\" class=\"text-center py-6 text-gray-400 font-medium italic\">Data mutasi pengeluaran kosong</td></tr>';
        } catch (error) {
            console.error("Gagal load data pengeluaran:", error);
        }
    }

    await loadDataPengeluaran();

    // ==========================================
    // MODAL UTILS & FILTER
    // ==========================================
    window.openModal = function(id) {
        const m = document.getElementById(id);
        m.classList.remove('hidden'); m.classList.add('flex');
        setTimeout(() => { m.classList.remove('opacity-0'); m.querySelector('div').classList.remove('scale-95'); }, 10);
    }
    
    window.closeModal = function(id) {
        const m = document.getElementById(id);
        m.classList.add('opacity-0'); m.querySelector('div').classList.add('scale-95');
        setTimeout(() => { m.classList.add('hidden'); m.classList.remove('flex'); }, 300);
    }

    window.filterTabelPengeluaran = function() {
        const start = document.getElementById('filter-start-pengeluaran').value;
        const end = document.getElementById('filter-end-pengeluaran').value;
        if(!start || !end) return alert("Pilih tanggal awal dan akhir!");
        document.querySelectorAll('#tabel-pengeluaran tbody tr').forEach(tr => {
            const date = tr.getAttribute('data-date');
            if(date) tr.style.display = (date >= start && date <= end) ? '' : 'none';
        });
    };

    // ==========================================
    // APPROVAL & HAPUS (Refactored)
    // ==========================================
    window.approvePengeluaran = async function(id, statusText) {
        if(!confirm(`Yakin ingin mengubah status menjadi ${statusText}?`)) return;
        if(!window.supabase) return;
        try {
            await window.supabase.from('pengeluaran').update({ status_approval: statusText }).eq('id', id);
            window.location.reload();
        } catch (err) { alert(err.message); }
    };

    // ==========================================
    // 🔥 AKSI OPERASIONAL LANGSUNG PER-ITEM TUNGGAL 🔥
    // ==========================================
    
    // 1. Fungsi Setujui / Tolak Per Item
    window.approveItemDirect = async function(rincianId, statusText, currentSumberDana, pengeluaranId) {
        if(!window.supabase) return;
        
        let finalSumberDana = currentSumberDana;
        
        // 🔎 DETEKSI: Jika admin klik SETUJUI dan ternyata data lama / sumber dana masih kosong
        if (statusText === 'Disetujui' && (!finalSumberDana || finalSumberDana === 'null' || finalSumberDana.trim() === '')) {
            
            // Suguhkan pop-up pilihan dompet kas langsung ke admin
            const pilihan = prompt(
                "⚠️ DATA LAMA TERDETEKSI: Sumber Dana pengeluaran ini masih kosong!\n\n" +
                "Silakan ketik angka pilihan kas di bawah ini untuk memotong saldo:\n" +
                "1. Uang Keuangan\n" +
                "2. Uang Gudang\n" +
                "3. Uang Owner\n\n" +
                "Ketik angka (1 / 2 / 3) lalu klik OK:"
            );
            
            if (pilihan === '1') finalSumberDana = 'Uang Keuangan';
            else if (pilihan === '2') finalSumberDana = 'Uang Gudang';
            else if (pilihan === '3') finalSumberDana = 'Uang Owner';
            else {
                alert("Proses Dibatalkan! Item lama tidak bisa di-ACC sebelum menentukan asal Sumber Dananya.");
                return;
            }
            
            // Update terlebih dahulu tabel induk (pengeluaran) agar trigger tahu kas mana yang dipotong
            const { error: errInduk } = await window.supabase
                .from('pengeluaran')
                .update({ sumber_dana: finalSumberDana })
                .eq('id', pengeluaranId);
                
            if (errInduk) {
                alert("Gagal menyuntikkan data sumber dana baru ke server: " + errInduk.message);
                return;
            }
        }
        
        // Konfirmasi akhir sebelum eksekusi pemotongan saldo kas perusahaan
        if(!confirm(`Yakin ingin menyetujui item rincian ini? Saldo [${finalSumberDana}] akan otomatis terpotong.`)) return;
        
        try {
            const { error } = await window.supabase
                .from('rincian_pengeluaran')
                .update({ status_approval: statusText })
                .eq('id', rincianId);
                
            if(error) throw error;
            
            alert(`Sukses! Status berhasil diubah dan saldo ${finalSumberDana} otomatis terpotong.`);
            window.location.reload();
        } catch (err) { 
            alert("Gagal memproses persetujuan item: " + err.message); 
        }
    };

    // 2. Fungsi Buka Modal Edit Khusus Item Ini Saja
    window.bukaModalEditItemDirect = function(rincianId, namaItem, nominal, keterangan, sumberDana, pengeluaranId) {
        document.getElementById('edit_peng_id').value = rincianId; 
        document.querySelector('#modal-edit-pengeluaran h3').innerText = "Koreksi Item Rincian";
        
        // Simpan ID Induk ke form agar bisa diambil saat save
        document.getElementById('form-edit-pengeluaran').dataset.pengId = pengeluaranId;
        
        const isKategoriDasar = masterKategoriOps.includes(namaItem);
        const selectValue = isKategoriDasar ? namaItem : 'Lain-lain';
