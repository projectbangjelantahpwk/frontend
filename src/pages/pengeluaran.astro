    // Tetap ada untuk UI aja (user lihat total sebelum submit)
    window.hitungTotalTambahPeng = function() {
        let total = 0;
        document.querySelectorAll('.add_item_nominal').forEach(input => {
            total += parseFloat(input.value) || 0;
        });
        document.getElementById('add_peng_total_text').innerText = 'Rp ' + total.toLocaleString('id-ID');
    };

    window.eksekusiTambahPengeluaran = async function(e) {
        e.preventDefault();
        if(!window.supabase) return;

        const userId = document.getElementById('add_peng_user_id').value;
        const tanggalStr = document.getElementById('add_peng_tgl').value;
        const sumberDana = document.getElementById('add_sumber_dana').value; 
        
        const btnSubmit = document.getElementById('btn-submit-tambah-peng');
        const itemRows = document.querySelectorAll('.add-item-row');
        if(!userId) return alert('Pilih nama karyawannya dulu!');
        if(itemRows.length === 0) return alert('Tambahkan rincian item-nya minimal satu baris!');
        
        btnSubmit.innerText = "Memproses Pengeluaran...";
        btnSubmit.disabled = true;

        try {
            const rincianItems = [];
            let countUangJalan = 0;
            let totalNominalPengajuan = 0; // 🔥 Variabel baru untuk menghitung total uang yang mau diminta

            itemRows.forEach(row => {
                const kategori = row.querySelector('.add_item_select').value;
                const nominal = parseFloat(row.querySelector('.add_item_nominal').value) || 0;
                const keterangan = row.querySelector('.add_item_keterangan').value.trim();

                if(kategori === 'Uang Jalan') countUangJalan++;
                totalNominalPengajuan += nominal; // Tambahkan ke total

                rincianItems.push({ 
                    nama_item: kategori, 
                    nominal: nominal, 
                    keterangan: keterangan || null 
                });
            });

            // =================================================================
            // 🔥 SENSOR CEK SALDO KAS PERUSAHAAN (ANTI MINUS & ANTI NOL) 🔥
            // =================================================================
            const { data: dataKas, error: errKas } = await window.supabase
                .from('kas_perusahaan')
                .select('*')
                .eq('id', 1)
                .single();

            if (dataKas) {
                let saldoAktif = 0;
                if (sumberDana === 'Uang Keuangan') saldoAktif = dataKas.uang_keuangan || 0;
                else if (sumberDana === 'Uang Gudang') saldoAktif = dataKas.uang_gudang || 0;
                else if (sumberDana === 'Uang Owner') saldoAktif = dataKas.uang_owner || 0;

                // 1. Blokir jika kas benar-benar kosong (0)
                if (saldoAktif <= 0 && totalNominalPengajuan > 0) {
                    btnSubmit.innerText = "SIMPAN SEMUA DATA KE SERVER"; btnSubmit.disabled = false;
                    return alert(`❌ DITOLAK! Saldo dompet [${sumberDana}] saat ini kosong (Rp 0). Tidak bisa melakukan pengeluaran!`);
                }

                // 2. Blokir jika kas ada, tapi TIDAK CUKUP (mencegah minus)
                if (saldoAktif < totalNominalPengajuan) {
                    btnSubmit.innerText = "SIMPAN SEMUA DATA KE SERVER"; btnSubmit.disabled = false;
                    return alert(`❌ DITOLAK! Saldo dompet [${sumberDana}] tidak mencukupi untuk tagihan ini!\n\nSisa Saldo Kas: Rp ${saldoAktif.toLocaleString('id-ID')}\nTotal Pengajuan: Rp ${totalNominalPengajuan.toLocaleString('id-ID')}\n\nSilakan kurangi nominal atau pilih dompet kas lain.`);
                }
            }
            // =================================================================

            // 🛡️ 1. CEGAH DOBEL DI DALAM 1 FORM
            if(countUangJalan > 1) {
                btnSubmit.innerText = "SIMPAN SEMUA DATA KE SERVER"; btnSubmit.disabled = false;
                return alert("ERROR: Jangan memasukkan item 'Uang Jalan' lebih dari 1 kali dalam sekali pengajuan!");
            }

            // 🛡️ 2. CEGAH DOBEL LINTAS DOMPET (Cek riwayat di database)
            if (countUangJalan > 0) {
                const { data: pengInduk } = await window.supabase
                    .from('pengeluaran')
                    .select('id')
                    .eq('user_id', userId)
                    .eq('tanggal', tanggalStr);

                if (pengInduk && pengInduk.length > 0) {
                    const pengIds = pengInduk.map(p => p.id);
                    const { data: cekUj } = await window.supabase
                        .from('rincian_pengeluaran')
                        .select('id')
                        .in('pengeluaran_id', pengIds)
                        .eq('nama_item', 'Uang Jalan')
                        .limit(1);

                    if (cekUj && cekUj.length > 0) {
                        btnSubmit.innerText = "SIMPAN SEMUA DATA KE SERVER"; btnSubmit.disabled = false;
                        return alert("DITOLAK! Karyawan ini sudah menerima 'Uang Jalan' hari ini. Jika ada biaya tambahan (seperti Bensin/Tol), silakan input TANPA menyertakan item 'Uang Jalan' agar langsung memotong dompet yang dipilih.");
                    }
                }
            }

            // LANGKAH A: Cek ketersediaan induk (Berdasarkan User + Tanggal + Sumber Dana)
            const { data: existing, error: errCheck } = await window.supabase
                .from('pengeluaran')
                .select('id')
                .eq('user_id', userId)
                .eq('tanggal', tanggalStr)
                .eq('sumber_dana', sumberDana)
                .maybeSingle();
            
            if(errCheck) throw errCheck;

            let pengeluaranId;
            if (existing) {
                pengeluaranId = existing.id;
            } else {
                const { data: inserted, error: errInsert } = await window.supabase.from('pengeluaran')
                    .insert({ 
                        user_id: userId, 
                        tanggal: tanggalStr, 
                        total_harian: 0, 
                        status_approval: 'Menunggu',
                        sumber_dana: sumberDana 
                    }) 
                    .select('id').single();
                if(errInsert) throw errInsert;
                pengeluaranId = inserted.id;
            }

            // LANGKAH B: Masukkan semua array pecahan rincian ke DB
            const rincianFinalToInsert = rincianItems.map(item => ({
                pengeluaran_id: pengeluaranId,
                nama_item: item.nama_item,
                nominal: item.nominal,
                keterangan: item.keterangan
            }));
            
            const { error: errRincian } = await window.supabase.from('rincian_pengeluaran').insert(rincianFinalToInsert);
            if(errRincian) throw errRincian;
            
            alert("Mantap! Seluruh data sukses dicatat dan divalidasi.");
            window.location.reload();
        } catch (err) {
            console.error(err);
            alert("Gagal menambahkan pengeluaran: " + err.message);
            btnSubmit.innerText = "SIMPAN SEMUA DATA KE SERVER"; btnSubmit.disabled = false;
        }
    };
    // ==========================================
    // 🔥 FUNGSI KEMBALIKAN SISA UANG JALAN KE GUDANG 🔥
    // ==========================================
    window.simpanSisaUangJalan = async function(rincianId, sisaNominalSistem, sumberDanaAsli, pengeluaranId) {
        // 1. Munculkan Pop-Up Interaktif nanya uang fisik yang ada di tangan
        const inputNominal = prompt(
            `Sisa Uang Jalan di sistem adalah: Rp ${sisaNominalSistem.toLocaleString('id-ID')}\n\n` +
            `Berapa jumlah uang fisik yang BENAR-BENAR DISETOR oleh driver ke Laci Gudang? (Ketik angkanya saja):`,
            sisaNominalSistem
        );

        if (inputNominal === null) return; // Dibatalkan oleh admin
        
        // Bersihkan inputan dari titik/koma dan jadikan angka
        const setorFisik = parseInt(inputNominal.replace(/[^0-9]/g, '')) || 0;

        if (setorFisik > sisaNominalSistem) {
            return alert("❌ Gagal! Nominal setor tidak boleh lebih besar dari sisa uang jalan di sistem.");
        }

        const selisihKasbon = sisaNominalSistem - setorFisik;

        let msgConfirm = `Rincian Penutupan:\n- Setor uang fisik: Rp ${setorFisik.toLocaleString('id-ID')} (Masuk Uang Gudang)`;
        if (selisihKasbon > 0) {
            msgConfirm += `\n- Kurang setor: Rp ${selisihKasbon.toLocaleString('id-ID')} ⚠️\n\nSistem akan OTOMATIS mencatat selisih ini sebagai KASBON dan memotong gaji driver!`;
        }
        msgConfirm += `\n\nLanjutkan proses?`;

        if (!confirm(msgConfirm)) return;

        try {
            // LANGKAH A: Nol-kan sisa Uang Jalan.
            // (Trigger database akan otomatis me-refund seluruh uang ini ke dompet asalnya terlebih dahulu)
            const { error: errUpdate } = await window.supabase
                .from('rincian_pengeluaran')
                .update({
                    nominal: 0,
                    nama_item: 'Uang Jalan (Masuk Gudang)',
                    keterangan: `Ditutup. Fisik: Rp ${setorFisik.toLocaleString('id-ID')} | Kasbon: Rp ${selisihKasbon.toLocaleString('id-ID')}`
                })
                .eq('id', rincianId);

            if (errUpdate) throw errUpdate;

            // LANGKAH B: Pindahkan Uang FISIK-nya saja ke Uang Gudang
            if (sumberDanaAsli !== 'Uang Gudang' && setorFisik > 0) {
                const { data: kas } = await window.supabase.from('kas_perusahaan').select('*').eq('id', 1).single();
                if(kas) {
                    let uk = Number(kas.uang_keuangan) || 0;
                    let uo = Number(kas.uang_owner) || 0;
                    let ug = Number(kas.uang_gudang) || 0;

                    // Tarik uang fisiknya dari dompet asal
                    if (sumberDanaAsli === 'Uang Keuangan') uk -= setorFisik;
                    else if (sumberDanaAsli === 'Uang Owner') uo -= setorFisik;
                    
                    // Masukkan ke dompet gudang
                    ug += setorFisik;

                    await window.supabase.from('kas_perusahaan')
                        .update({ uang_keuangan: uk, uang_owner: uo, uang_gudang: ug })
                        .eq('id', 1);
                }
            }

            // LANGKAH C: Eksekusi Kasbon (Jika ada selisih uang hilang)
            if (selisihKasbon > 0) {
                const { error: errKasbon } = await window.supabase
                    .from('rincian_pengeluaran')
                    .insert({
                        pengeluaran_id: pengeluaranId,
                        nama_item: 'Kasbon - Kurang Setor Uang Jalan',
                        nominal: selisihKasbon,
                        keterangan: 'Otomatis dari sistem karena fisik yang disetor kurang',
                        keterangan_bayar: true,
                        status_approval: 'Disetujui' // 🔥 Langsung di-ACC supaya Trigger Gaji bekerja!
                    });
                    
                if (errKasbon) throw errKasbon;
            }

            alert("Mantap! Buku harian driver sukses ditutup dan disinkronisasi ke Kas & Gaji.");
            window.location.reload();
        } catch(e) {
            alert("Gagal memproses penyetoran sisa uang: " + e.message);
        }
    };
  });
</script>