                <td class="p-md font-mono font-bold">${r.no_rek}</td>
                <td class="p-md text-right flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                    <button onclick="window.bukaEditRekening('${r.id}')" class="w-10 h-10 bg-surface-container text-primary rounded-full hover:bg-primary-container"><span class="material-symbols-outlined text-[18px]">edit</span></button>
                    <button onclick="window.hapusRekening('${r.id}', '${namaMitra}')" class="w-10 h-10 bg-surface-container text-error rounded-full hover:bg-error-container"><span class="material-symbols-outlined text-[18px]">delete</span></button>
                </td>
            </tr>`;
        });
    } else {
        const empty = '<p class="text-center p-md text-on-surface-variant">Belum ada data rekening.</p>';
        htmlMob = empty; htmlTab = `<tr><td colspan="5">${empty}</td></tr>`;
    }

    document.getElementById('rekening-mitra-mobile').innerHTML = htmlMob;
    document.getElementById('rekening-mitra-tbody').innerHTML = htmlTab;

    // Trigger render filter bank setelah data beres dimuat
    window.renderFilterBank(); 
}

// 2. Logika Dinamis Filter Bank
window.renderFilterBank = function() {
    const filterSelect = document.getElementById('filter-bank');
    if (!filterSelect || window.allRekening.length === 0) return;

    const uniqueBanks = [...new Set(window.allRekening.map(r => r.nama_bank))].filter(Boolean);
    let htmlOptions = '<option value="">Semua Bank</option>';
    uniqueBanks.forEach(bank => {
        htmlOptions += `<option value="${bank}">${bank}</option>`;
    });
    
    const previousSelection = filterSelect.value;
    filterSelect.innerHTML = htmlOptions;
    if (uniqueBanks.includes(previousSelection)) {
        filterSelect.value = previousSelection;
    }
};

// ==========================================
// LOGIC SEARCHABLE DROPDOWN MITRA
// ==========================================
const inputSearchMitra = document.getElementById('input_search_mitra_rekening');
const dropdownMitra = document.getElementById('dropdown_mitra_rekening');
const inputMitraId = document.getElementById('input_mitra_id_rekening');

window.renderDropdownMitra = function(keyword = '') {
    if (!dropdownMitra || !window.allMitraLangganan) return;
    
    const filtered = window.allMitraLangganan.filter(m => 
        (m.nama_mitra || '').toLowerCase().includes(keyword.toLowerCase())
    );
    
    if (filtered.length === 0) {
        dropdownMitra.innerHTML = '<div class="p-3 text-sm text-on-surface-variant text-center">Mitra tidak ditemukan</div>';
        return;
    }

    dropdownMitra.innerHTML = filtered.map(m => `
        <div class="p-3 text-sm text-on-surface hover:bg-surface-container cursor-pointer transition-colors border-b border-outline-variant last:border-b-0" 
             onclick="window.pilihMitraRekening('${m.id}', '${m.nama_mitra.replace(/'/g, "\\'")}')">
            ${m.nama_mitra}
        </div>
    `).join('');
};

window.pilihMitraRekening = function(id, nama) {
    if(inputMitraId) inputMitraId.value = id;
    if(inputSearchMitra) inputSearchMitra.value = nama;
    dropdownMitra?.classList.add('hidden');
};

if (inputSearchMitra) {
    inputSearchMitra.addEventListener('focus', () => {
        window.renderDropdownMitra(inputSearchMitra.value);
        dropdownMitra.classList.remove('hidden');
    });

    inputSearchMitra.addEventListener('input', (e) => {
        window.renderDropdownMitra(e.target.value);
        dropdownMitra.classList.remove('hidden');
        inputMitraId.value = ''; 
    });
}

document.addEventListener('click', (e) => {
    if (inputSearchMitra && dropdownMitra) {
        if (!inputSearchMitra.contains(e.target) && !dropdownMitra.contains(e.target)) {
            dropdownMitra.classList.add('hidden');
        }
    }
});

// Update reset form di fungsi openModal lama lu biar input pencarian ikut bersih
window.bukaModalTambahRekening = function() {
    // 1. Reset Form & State
    document.getElementById('form-tambah-rekening').reset();
    const inputMitraId = document.getElementById('input_mitra_id_rekening');
    const dropdownMitra = document.getElementById('dropdown_mitra_rekening');
    
    if (inputMitraId) inputMitraId.value = '';
    if (dropdownMitra) dropdownMitra.classList.add('hidden');
    
    // 2. Panggil fungsi modal bawaan
    window.openModal('modal-tambah-rekening');
};

// ==========================================
// CRUD REKENING
// ==========================================
// Insert Form
document.getElementById('form-tambah-rekening')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btn-submit-rekening');
    const mitraId = document.getElementById('input_mitra_id_rekening').value;
    
    if(!mitraId) return alert('Mitra tidak valid! Pastikan pilih dari daftar Dropdown.');

    btn.innerText = "Menyimpan..."; btn.disabled = true;
    try {
        const payload = {
            mitra_id: mitraId,
            nama_bank: document.getElementById('input_bank_rekening').value,
            no_rek: document.getElementById('input_norek_rekening').value,
            atas_nama: document.getElementById('input_an_rekening').value
        };
        
        console.log("🔍 [DETEKTIF] Payload yang mau dikirim:", payload);

        // Tambahkan .select() di akhir agar Supabase WAJIB mengembalikan respon
        const { data, error } = await window.supabase
            .from('rek_mitra')
            .insert([payload])
            .select();

        // 1. Tangkap error bawaan Supabase
        if (error) {
            console.error("🚨 [DETEKTIF] Error dari Supabase:", error);
            throw error;
        }

        // 2. Tangkap silent fail (Biasanya karena RLS memblokir insert)
        if (!data || data.length === 0) {
            console.error("🚨 [DETEKTIF] Data ditolak secara diam-diam oleh RLS!");
            throw new Error("Data ditolak oleh database (Silent Fail). Cek kebijakan RLS (Row Level Security) di tabel rek_mitra!");
        }

        console.log("✅ [DETEKTIF] Sukses! Data berhasil masuk:", data);
        alert('Rekening berhasil ditambah!');
        window.location.reload();
    } catch (err) {
        console.error("🛑 [DETEKTIF] ERROR TERTANGKAP:", err);
        // Tampilkan pesan error sejelas-jelasnya di popup
        alert('Gagal: ' + (err.message || JSON.stringify(err)));
        
        btn.innerText = "Simpan";
        btn.disabled = false;
    }
});

// Buka Edit
window.bukaEditRekening = function(id) {
    const rek = window.allRekening.find(r => r.id == id);
    if(!rek) return;
    
    document.getElementById('edit_rekening_id').value = rek.id;
    document.getElementById('edit_mitra_nama_rekening').value = rek.mitra?.nama_mitra || '';
    document.getElementById('edit_bank_rekening').value = rek.nama_bank;
    document.getElementById('edit_norek_rekening').value = rek.no_rek;
    document.getElementById('edit_an_rekening').value = rek.atas_nama;
    
    window.openModal('modal-edit-rekening');
};

// Update Form
document.getElementById('form-edit-rekening')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btn-submit-edit-rekening');
    btn.innerText = 'Updating...'; btn.disabled = true;
    
    try {
        const id = document.getElementById('edit_rekening_id').value;
        const payload = {
            nama_bank: document.getElementById('edit_bank_rekening').value,
            no_rek: document.getElementById('edit_norek_rekening').value,
            atas_nama: document.getElementById('edit_an_rekening').value
        };
        const { error } = await window.supabase.from('rek_mitra').update(payload).eq('id', id);
        if (error) throw error;
        
        alert('Berhasil diupdate!');
        window.location.reload();
    } catch(err) {
        alert('Gagal: ' + err.message);
        btn.innerText = 'Update'; btn.disabled = false;
    }
});

// Delete Logic
window.hapusRekening = async function(id, nama) {
    if(!confirm(`Hapus rekening untuk mitra ${nama}?`)) return;
    try {
        const { error } = await window.supabase.from('rek_mitra').delete().eq('id', id);
        if(error) throw error;
        alert('Terhapus!');
        window.location.reload();
    } catch(err) { alert(err.message); }
};

// Sinkronin Search Global dengan Dropdown Filter Bank
const oldApplySearchMitra = window.applySearchMitra;
window.applySearchMitra = function() {
    oldApplySearchMitra(); // Jalankan search lama
    
    const isTabRekening = document.getElementById('tab-rekening-mitra')?.classList.contains('block');
    if (isTabRekening) {
        const keyword = (document.getElementById('input-search-mitra')?.value || '').toLowerCase().trim();
        const filterBank = document.getElementById('filter-bank')?.value.toLowerCase() || '';
        const items = document.querySelectorAll('.rekening-item');

        items.forEach(item => {
            const itemBank = item.getAttribute('data-bank') || '';
            const text = item.textContent.toLowerCase();
            
            let match = true;
            if (filterBank && itemBank !== filterBank) match = false;
            if (keyword && !text.includes(keyword)) match = false;
            
            item.style.display = match ? '' : 'none';
        });
    }
};

// Trigger fetch rekening
document.addEventListener('DOMContentLoaded', () => {
    setTimeout(loadDataRekening, 1000); 
});
