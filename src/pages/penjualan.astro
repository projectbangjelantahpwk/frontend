---
import GeneralLayout from '../layouts/Layout.astro';
import 'bootstrap-icons/font/bootstrap-icons.css';
---

<GeneralLayout title="Penjualan Olahan - Manajemen Bang Jelantah">
    <style is:global>
        body { display: none; }
    </style>

    <div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Penjualan Olahan</h1>
            <p class="text-gray-600">Manajemen distributor/buyer pabrik dan pencatatan transaksi keluar harian multi-item.</p>
        </div>
    </div>

    <div class="mb-6 border-b border-gray-200 overflow-x-auto hide-scrollbar">
        <div class="flex gap-8 min-w-max">
            <button class="tab-btn active px-4 py-3 font-bold transition border-b-2 border-green-700 text-green-700" data-tab="tab-distributor">
                <i class="bi bi-buildings mr-2"></i> Data Distributor / Buyer
            </button>
            <button class="tab-btn px-4 py-3 font-medium transition border-b-2 border-transparent text-gray-600 hover:text-gray-900" data-tab="tab-riwayat">
                <i class="bi bi-clock-history mr-2"></i> Riwayat Penjualan
            </button>
        </div>
    </div>

    <div id="tab-distributor" class="tab-content block">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-900">Daftar Kontak Pabrik & Distributor</h2>
            <button onclick="window.openModal('modal-tambah-distributor')" class="flex items-center gap-2 px-4 py-2 bg-blue-700 text-white rounded-lg font-medium hover:bg-blue-800 transition shadow-sm">
                <i class="bi bi-plus-circle"></i> Tambah Distributor
            </button>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-6 py-4 text-sm font-bold text-gray-900">Nama Perusahaan / Buyer</th>
                            <th class="px-6 py-4 text-sm font-bold text-gray-900">No. HP</th>
                            <th class="px-6 py-4 text-sm font-bold text-gray-900">Alamat Kirim</th>
                            <th class="px-6 py-4 text-sm font-bold text-gray-900 text-center">Maps</th>
                            <th class="px-6 py-4 text-sm font-bold text-gray-900 text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="distributor-tbody" class="divide-y divide-gray-100">
                        <tr><td colspan="4" class="text-center py-4 text-gray-500">Memuat data distributor...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="tab-riwayat" class="tab-content hidden">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-900">Riwayat Transaksi Keluar</h2>
            <button onclick="window.bukaModalPenjualan()" class="flex items-center gap-2 px-4 py-2 bg-green-700 text-white rounded-lg font-medium hover:bg-green-800 transition shadow-sm">
                <i class="bi bi-cart-plus"></i> Catat Penjualan Baru
            </button>
        </div>

        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm mb-6 flex flex-wrap gap-4 items-end">
            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">Mulai Tanggal</label>
                <input type="date" id="filter-start-jual" class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-600">
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">Sampai Tanggal</label>
                <input type="date" id="filter-end-jual" class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-600">
            </div>
            <button onclick="window.filterTabelPenjualan()" class="bg-gray-800 text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-gray-900">Set Tanggal</button>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-4 py-3 text-sm font-bold text-gray-900 whitespace-nowrap">Tanggal</th>
                            <th class="px-4 py-3 text-sm font-bold text-gray-900">Distributor / Buyer</th>
                            <th class="px-4 py-3 text-sm font-bold text-gray-900">Komoditas</th>
                            <th class="px-4 py-3 text-sm font-bold text-gray-900 text-right">Volume</th>
                            <th class="px-4 py-3 text-sm font-bold text-gray-900 text-right">Harga Satuan</th>
                            <th class="px-4 py-3 text-sm font-bold text-gray-900">Keterangan</th> 
                            <th class="px-4 py-3 text-sm font-bold text-gray-900 text-right">Grand Total</th>
                            <th class="px-4 py-3 text-sm font-bold text-gray-900 text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="penjualan-tbody" class="divide-y divide-gray-100">
                        <tr><td colspan="7" class="text-center py-4 text-gray-500">Memuat riwayat transaksi...</td></tr>
                    </tbody>
                    <tfoot class="bg-gray-50 border-t border-gray-200 hidden" id="footer-total-jual">
                        <tr>
                            <td colspan="6" class="px-6 py-4 text-sm font-bold text-gray-900 text-right">TOTAL PENDAPATAN TERFILTER:</td>
                            <td class="px-6 py-4 text-lg font-bold text-green-700 text-right" id="text-total-jual">Rp 0</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div id="modal-tambah-distributor" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-[60] p-4 transition-opacity opacity-0">
        <div class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-blue-50">
                <h3 class="font-bold text-lg text-gray-900">Registrasi Distributor Baru</h3>
                <button onclick="window.closeModal('modal-tambah-distributor')" class="text-gray-400 hover:text-gray-900"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="form-distributor" class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Nama Perusahaan / Buyer</label>
                    <input type="text" id="dist_nama" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-blue-600" required>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Nomor Handphone</label>
                    <input type="text" id="dist_hp" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-blue-600" required>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Alamat Gudang / Kantor</label>
                    <textarea id="dist_alamat" rows="2" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-blue-600" required></textarea>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Link Google Maps Location</label>
                    <input type="url" id="dist_gmaps" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-blue-600">
                </div>
                <button type="submit" class="w-full bg-blue-700 text-white font-bold py-3 rounded-xl hover:bg-blue-800 transition mt-2">Daftarkan Buyer</button>
            </form>
        </div>
    </div>

    <div id="modal-edit-distributor" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-[60] p-4 transition-opacity opacity-0">
        <div class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-yellow-50">
                <h3 class="font-bold text-lg text-gray-900">Edit Data Distributor</h3>
                <button onclick="window.closeModal('modal-edit-distributor')" class="text-gray-400 hover:text-gray-900"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="form-edit-distributor" class="p-6 space-y-4">
                <input type="hidden" id="edit_dist_id">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Nama Perusahaan / Buyer</label>
                    <input type="text" id="edit_dist_nama" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-yellow-600" required>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Nomor Handphone</label>
                    <input type="text" id="edit_dist_hp" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-yellow-600" required>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Alamat Gudang / Kantor</label>
                    <textarea id="edit_dist_alamat" rows="2" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-yellow-600" required></textarea>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Link Google Maps Location</label>
                    <input type="url" id="edit_dist_gmaps" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-yellow-600">
                </div>
                <button type="submit" class="w-full bg-yellow-600 text-white font-bold py-3 rounded-xl hover:bg-yellow-700 transition mt-2">Simpan Perubahan</button>
            </form>
        </div>
    </div>

    <div id="modal-tambah-penjualan" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-[60] p-4 transition-opacity opacity-0">
        <div class="bg-white rounded-2xl w-full max-w-lg overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh]">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-green-50 shrink-0">
                <div>
                    <h3 class="font-bold text-lg text-gray-900">Form Transaksi Keluar</h3>
                    <p id="pj-step-indicator" class="text-xs font-bold text-green-700 mt-0.5">Langkah 1 dari 2: Data Pokok</p>
                </div>
                <button onclick="window.closeModal('modal-tambah-penjualan')" class="text-gray-400 hover:text-gray-900"><i class="bi bi-x-lg"></i></button>
            </div>
            
            <form id="form-penjualan" class="p-6 overflow-y-auto flex-1 flex flex-col justify-between">
                
                <div id="pj-step-1" class="flex flex-col gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Tanggal Transaksi</label>
                        <input type="date" id="pj_tgl" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600 font-medium" required>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Distributor / Pembeli</label>
                        <select id="pj_distributor" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600 bg-white font-medium" required>
                            <option value="">-- Memuat... --</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Tujuan Kas Masuk</label>
                        <select id="pj_tujuan_kas" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600 bg-green-50 font-bold text-green-800" required>
                            <option value="uang_keuangan">Uang Keuangan</option>
                            <option value="uang_gudang">Uang Gudang</option>
                            <option value="uang_owner">Uang Owner</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Keterangan Umum (Opsional)</label>
                        <textarea id="pj_keterangan" rows="2" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600" placeholder="Misal: Nomor PO, Catatan Pengiriman, dsb..."></textarea>
                    </div>
                </div>

                <div id="pj-step-2" class="hidden flex-col gap-4">
                    <div class="flex justify-between items-center mb-1">
                        <label class="block text-xs font-bold text-gray-700">Rincian Barang Dijual</label>
                        <button type="button" onclick="window.tambahBarisBarang()" class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded font-bold hover:bg-green-200">+ Tambah Barang</button>
                    </div>
                    
                    <div id="pj-items-container" class="space-y-3"></div>

                    <div class="bg-gray-900 p-4 rounded-xl text-right mt-2 shadow-sm">
                        <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block mb-1">Grand Total Transaksi</span>
                        <span class="font-bold text-3xl text-green-400 font-mono" id="pj_total_display">Rp 0</span>
                    </div>
                </div>

                <div id="pj-footer-1" class="mt-8 flex justify-end shrink-0">
                    <button type="button" onclick="window.cekDanLanjut(1, 2)" class="w-12 h-12 bg-gray-900 text-white font-bold rounded-xl hover:bg-black transition text-xl flex items-center justify-center shadow-sm active:scale-95">
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
                
                <div id="pj-footer-2" class="mt-8 hidden justify-between items-center shrink-0">
                    <button type="button" onclick="window.navigasiStepPj(1)" class="w-12 h-12 bg-gray-100 text-gray-700 font-bold rounded-xl hover:bg-gray-200 border border-gray-200 transition text-xl flex items-center justify-center active:scale-95">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <button type="submit" id="btn-save-pj" class="w-12 h-12 bg-green-600 text-white font-bold rounded-xl hover:bg-green-700 transition text-xl flex items-center justify-center shadow-sm active:scale-95">
                        <i class="bi bi-floppy-fill"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <div id="modal-edit-penjualan" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-[60] p-4 transition-opacity opacity-0">
        <div class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-yellow-50">
                <h3 class="font-bold text-lg text-gray-900">Edit Riwayat Transaksi</h3>
                <button onclick="window.closeModal('modal-edit-penjualan')" class="text-gray-400 hover:text-gray-900"><i class="bi bi-x-lg"></i></button>
            </div>
            <input type="hidden" id="edit_pj_id">
                <input type="hidden" id="edit_pj_komoditas_id">
                <input type="hidden" id="edit_pj_old_vol">
                <input type="hidden" id="edit_pj_old_total">
                <input type="hidden" id="edit_pj_old_kas">
                
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Tanggal Transaksi</label>
                    <input type="date" id="edit_pj_tgl" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-yellow-600" required>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Distributor / Pembeli</label>
                    <select id="edit_pj_distributor" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-yellow-600 bg-white" required></select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Tujuan Kas Masuk</label>
                    <select id="edit_pj_tujuan_kas" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-yellow-600 bg-white" required>
                        <option value="uang_keuangan">Kas Keuangan</option>
                        <option value="uang_gudang">Kas Gudang</option>
                        <option value="uang_owner">Kas Owner</option>
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">Volume (Kg)</label>
                        <input type="number" step="0.1" id="edit_pj_vol" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-yellow-600 font-bold" required>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">Harga (Rp)</label>
                        <input type="number" id="edit_pj_hrg" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-yellow-600 font-bold" required>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Keterangan Tambahan</label>
                    <textarea id="edit_pj_keterangan" rows="2" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-yellow-600"></textarea>
                </div>
                <button type="submit" class="w-full bg-yellow-600 text-white font-bold py-3 rounded-xl hover:bg-yellow-700 transition mt-2 shadow-sm">Simpan Perubahan</button>
            </form>
        </div>
    </div>
</GeneralLayout>

<script>
    import { supabase } from '../lib/supabase';
    
    // Supabase Global Setup
    window.supabase = supabase;
    
    // Variabel Global Opsi Komoditas
    window.opsiKomoditasHtml = '<option value="">Pilih...</option>';

    document.addEventListener('DOMContentLoaded', async () => {
        const allowedRoles = ['owner', 'hrd', 'keuangan', 'admin','it'];
        const client = window.supabase; 
        
        const { data: { session } } = await client.auth.getSession();
        if (!session) return window.location.replace('/');
        
        const { data: prof } = await client.from('profiles').select('role').eq('id', session.user.id).single();
        if (!allowedRoles.includes(prof?.role)) {
            alert("Akses Ditolak!");
            return window.location.replace('/');
        }
        document.body.style.display = 'block';

        // ==========================================
        // 1. PINDAH KE ATAS: KONTROL MODAL & NAVIGASI
        // ==========================================
        window.openModal = function(id) {
            const m = document.getElementById(id);
            if(!m) return;
            m.classList.remove('hidden'); m.classList.add('flex');
            setTimeout(() => { m.classList.remove('opacity-0'); m.querySelector('div').classList.remove('scale-95'); }, 10);
        }
        
        window.closeModal = function(id) {
            const m = document.getElementById(id);
            if(!m) return;
            m.classList.add('opacity-0'); m.querySelector('div').classList.add('scale-95');
            setTimeout(() => { m.classList.add('hidden'); m.classList.remove('flex'); }, 300);
        }

        window.bukaModalEditDistributor = async function(id) {
            if(!window.supabase) return;
            const { data: d, error } = await window.supabase.from('distributor').select('*').eq('id', id).single();
            if(error || !d) return alert("Gagal mengambil data distributor!");

            document.getElementById('edit_dist_id').value = d.id;
            document.getElementById('edit_dist_nama').value = d.nama;
            document.getElementById('edit_dist_hp').value = d.nomor_hp || '';
            document.getElementById('edit_dist_alamat').value = d.alamat || '';
            document.getElementById('edit_dist_gmaps').value = d.link_gmaps || '';

            window.openModal('modal-edit-distributor');
        };

        window.hapusDistributor = async function(id, nama) {
            const pesan = `YAKIN INGIN MENGHAPUS DISTRIBUTOR "${nama}"?\n\n⚠️ PERINGATAN KERAS: Semua riwayat transaksi akan ikut terhapus dan stok yang pernah dijual ke buyer ini akan OTOMATIS DIKEMBALIKAN ke gudang!`;
            if(!confirm(pesan)) return;

            try {
                // 1. Tarik semua data penjualan yang nyangkut di distributor ini
                const { data: jualList } = await client.from('penjualan_olahan').select('id, komoditas_id, volume').eq('distributor_id', id);

                // 2. Kembalikan stok satu per satu (Revert Batal Jual)
                if (jualList && jualList.length > 0) {
                    for (let p of jualList) {
                        const { data: g } = await client.from('gudang_komoditas').select('stok').eq('id', p.komoditas_id).single();
                        await client.from('gudang_komoditas').update({ stok: g.stok + p.volume }).eq('id', p.komoditas_id);
                        
                        await client.from('gudang_mutasi').insert([{ 
                            jenis_mutasi: 'Masuk', 
                            komoditas_id: p.komoditas_id, 
                            jumlah: p.volume, 
                            keterangan: `Batal Jual (Distributor ${nama} Dihapus)` 
                        }]);
                    }
                }

                // 3. Baru hapus distributornya (otomatis hapus riwayat jual di database karena cascade)
                const { error } = await client.from('distributor').delete().eq('id', id);
                if (error) throw error;
                
                alert('Distributor dihapus dan semua stok yang terkait berhasil dikembalikan ke gudang!');
                window.location.reload();
            } catch(err) { alert("Gagal menghapus: " + err.message); }
        };

        window.bukaModalPenjualan = function() {
            document.getElementById('pj-items-container').innerHTML = '';
            window.tambahBarisBarang(); 
            document.getElementById('pj_keterangan').value = '';
            window.navigasiStepPj(1);
            window.openModal('modal-tambah-penjualan');
        }

        // Fungsi untuk membuka modal Edit Penjualan
        window.bukaModalEditPenjualan = function(id, tgl, distId, komId, vol, hrg, ket, oldTotal, oldKas) {
            document.getElementById('edit_pj_id').value = id;
            document.getElementById('edit_pj_tgl').value = tgl;
            document.getElementById('edit_pj_komoditas_id').value = komId;
            document.getElementById('edit_pj_old_vol').value = vol;
            document.getElementById('edit_pj_vol').value = vol;
            document.getElementById('edit_pj_hrg').value = hrg;
            document.getElementById('edit_pj_keterangan').value = ket === 'null' ? '' : ket;
            document.getElementById('edit_pj_distributor').innerHTML = document.getElementById('pj_distributor').innerHTML;
            document.getElementById('edit_pj_distributor').value = distId;
            
            // 🔥 Isi value kas dan total uang lama
            document.getElementById('edit_pj_old_total').value = oldTotal;
            document.getElementById('edit_pj_old_kas').value = oldKas;
            document.getElementById('edit_pj_tujuan_kas').value = oldKas;

            window.openModal('modal-edit-penjualan');
        };

        // Eksekusi Submit Perubahan Penjualan
        document.getElementById('form-edit-penjualan')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.innerText = "Menyimpan..."; btn.disabled = true;

            const id = document.getElementById('edit_pj_id').value;
            const komId = document.getElementById('edit_pj_komoditas_id').value;
            const oldVol = parseFloat(document.getElementById('edit_pj_old_vol').value) || 0;
            const newVol = parseFloat(document.getElementById('edit_pj_vol').value) || 0;
            const tgl = document.getElementById('edit_pj_tgl').value;
            const distId = document.getElementById('edit_pj_distributor').value;
            const hrg = parseFloat(document.getElementById('edit_pj_hrg').value) || 0;
            const ket = document.getElementById('edit_pj_keterangan').value || null;
            
            const newTotal = newVol * hrg;
            const oldTotal = parseFloat(document.getElementById('edit_pj_old_total').value) || 0;
            const oldKas = document.getElementById('edit_pj_old_kas').value;
            const newKas = document.getElementById('edit_pj_tujuan_kas').value;

            try {
                // 1. Update data pokok transaksi (Termasuk tujuan_kas baru)
                const { error: errPj } = await client.from('penjualan_olahan').update({
                    tanggal: tgl,
                    distributor_id: distId,
                    volume: newVol,
                    harga_satuan: hrg,
                    total_harga: newTotal,
                    keterangan: ket,
                    tujuan_kas: newKas // 🔥 Menyimpan brankas kas baru ke DB
                }).eq('id', id);

                if (errPj) throw errPj;

                // 2. Kalkulasi cerdas untuk selisih gudang
                const selisihVol = newVol - oldVol; 
                if (selisihVol !== 0) {
                    const { data: g } = await client.from('gudang_komoditas').select('stok').eq('id', komId).single();
                    await client.from('gudang_komoditas').update({ stok: g.stok - selisihVol }).eq('id', komId);
                    
                    const jenisMutasi = selisihVol > 0 ? 'Keluar' : 'Masuk';
                    await client.from('gudang_mutasi').insert([{
                        jenis_mutasi: jenisMutasi,
                        komoditas_id: komId,
                        jumlah: -selisihVol, 
                        keterangan: 'Revisi Transaksi Penjualan'
                    }]);
                }

                // 🔥 3. PENYESUAIAN SALDO KAS (ANTI SALDO GAIB) 🔥
                const { data: dbKas, error: errFetchKas } = await client.from('kas_perusahaan').select('*').eq('id', 1).single();
                if (errFetchKas) throw errFetchKas;

                let payloadUang = {};
                
                if (oldKas === newKas) {
                    // Skenario A: Jika brankas kas tidak diubah (tetap keuangan/gudang/owner)
                    // Rumus: Saldo saat ini dikurangi total uang lama, lalu ditambah total uang baru
                    payloadUang[newKas] = (Number(dbKas[newKas]) || 0) - oldTotal + newTotal;
                } else {
                    // Skenario B: Jika brankas kas dipindahkan (misal dari Keuangan pindah ke Owner)
                    payloadUang[oldKas] = (Number(dbKas[oldKas]) || 0) - oldTotal; // Tarik/kurangi nominal dari laci lama
                    payloadUang[newKas] = (Number(dbKas[newKas]) || 0) + newTotal; // Masukkan nominal penuh ke laci baru
                }
                payloadUang['updated_at'] = new Date().toISOString();

                // Tembak pembaharuan saldo kas ke Supabase
                const { error: errUpdateKas } = await client.from('kas_perusahaan').update(payloadUang).eq('id', 1);
                if (errUpdateKas) throw errUpdateKas;

                alert('✅ Transaksi berhasil diubah, stok gudang & saldo brankas kas telah disesuaikan!');
                window.location.reload();

            } catch (err) {
                alert("🚨 Gagal menyimpan perubahan: " + err.message);
                btn.innerText = "Simpan Perubahan"; btn.disabled = false;
            }
        });

        window.hapusPenjualan = async function(idPenjualan, komId, vol) {
            if(!confirm('Yakin ingin membatalkan transaksi ini?\n\nStok barang akan otomatis dikembalikan ke gudang dan dicatat sebagai Mutasi Masuk.')) return;

            try {
                // 1. Tarik stok gudang saat ini
                const { data: g } = await client.from('gudang_komoditas').select('stok').eq('id', komId).single();
                
                // 2. Kembalikan / Tambahkan volumenya
                await client.from('gudang_komoditas').update({ stok: g.stok + vol }).eq('id', komId);
                
                // 3. Catat di log mutasi sebagai Batal Jual / Masuk
                await client.from('gudang_mutasi').insert([{ 
                    jenis_mutasi: 'Masuk', 
                    komoditas_id: komId, 
                    jumlah: vol, 
                    keterangan: 'Pembatalan Penjualan (Hapus Riwayat)' 
                }]);
                
                // 4. Hapus riwayat penjualannya
                const { error } = await client.from('penjualan_olahan').delete().eq('id', idPenjualan);
                if (error) throw error;
                
                // 🔥 5. TARIK KEMBALI UANG DARI KAS 🔥
                const { data: kasSisa } = await client.from('kas_perusahaan').select(tujuanKas).eq('id', 1).single();
                let pullKas = {};
                pullKas[tujuanKas] = (Number(kasSisa[tujuanKas]) || 0) - totalHarga;
                await client.from('kas_perusahaan').update(pullKas).eq('id', 1);
                
                alert('Transaksi dibatalkan! Stok dan Saldo Kas sudah dikembalikan.');
                window.location.reload();
            } catch(err) {
                alert("Gagal membatalkan transaksi: " + err.message);
            }
        };

        window.navigasiStepPj = function(stepNum) {
            const steps = [1, 2]; // Sekarang cuma 2 step
            steps.forEach(num => {
                document.getElementById(`pj-step-${num}`)?.classList.replace('flex', 'hidden');
                document.getElementById(`pj-footer-${num}`)?.classList.replace('flex', 'hidden');
            });
            document.getElementById(`pj-step-${stepNum}`)?.classList.replace('hidden', 'flex');
            document.getElementById(`pj-footer-${stepNum}`)?.classList.replace('hidden', 'flex');

            const ind = document.getElementById('pj-step-indicator');
            if(stepNum === 1) ind.innerText = "Langkah 1 dari 2: Data Pokok";
            if(stepNum === 2) ind.innerText = "Langkah 2 dari 2: Rincian Barang & Total";
        }

        window.cekDanLanjut = function(currentStep, nextStep) {
            if (currentStep === 1) {
                const tgl = document.getElementById('pj_tgl').value;
                const dist = document.getElementById('pj_distributor').value;
                if (!tgl || !dist) {
                    alert("Harap isi Tanggal Transaksi dan Distributor terlebih dahulu!");
                    return; 
                }
            }
            window.navigasiStepPj(nextStep);
        };

        window.kalkulasiTotalPj = function() {
            let grandTotal = 0;
            document.querySelectorAll('.pj-item-row').forEach(row => {
                const v = parseFloat(row.querySelector('.pj-input-vol').value) || 0;
                const h = parseFloat(row.querySelector('.pj-input-hrg').value) || 0;
                grandTotal += (v * h);
            });
            document.getElementById('pj_total_display').innerText = `Rp ${grandTotal.toLocaleString('id-ID')}`;
        }

        window.tambahBarisBarang = function() {
            const container = document.getElementById('pj-items-container');
            const div = document.createElement('div');
            div.className = 'pj-item-row bg-gray-50 border border-gray-200 p-3 rounded-xl flex flex-wrap gap-2 items-end shadow-sm';
            div.innerHTML = `
                <div class="flex-1 min-w-[120px]">
                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Komoditas</label>
                    <select class="pj-input-komoditas w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-green-600 bg-white" required>
                        ${window.opsiKomoditasHtml}
                    </select>
                </div>
                <div class="w-[80px]">
                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Vol (Kg)</label>
                    <input type="number" step="0.1" class="pj-input-vol w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-green-600 font-bold" required oninput="window.kalkulasiTotalPj()">
                </div>
                <div class="w-[100px]">
                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Harga (Rp)</label>
                    <input type="number" class="pj-input-hrg w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-green-600 font-bold" required oninput="window.kalkulasiTotalPj()">
                </div>
                <button type="button" onclick="this.parentElement.remove(); window.kalkulasiTotalPj();" class="w-8 h-[38px] bg-red-100 text-red-600 rounded flex items-center justify-center hover:bg-red-200 transition">
                    <i class="bi bi-trash"></i>
                </button>
            `;
            container.appendChild(div);
        }

        // ==========================================
        // 2. PINDAH KE ATAS: SUBMIT FORM & TAB LOGIC
        // ==========================================
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabContents = document.querySelectorAll('.tab-content');

        tabBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const targetId = this.getAttribute('data-tab');
                tabBtns.forEach(b => {
                    b.classList.remove('active', 'border-green-700', 'text-green-700', 'font-bold');
                    b.classList.add('border-transparent', 'text-gray-600', 'font-medium');
                });
                tabContents.forEach(c => {
                    c.classList.remove('block');
                    c.classList.add('hidden');
                });
                this.classList.add('active', 'border-green-700', 'text-green-700', 'font-bold');
                this.classList.remove('border-transparent', 'text-gray-600', 'font-medium');
                document.getElementById(targetId)?.classList.replace('hidden', 'block');
            });
        });

        document.getElementById('form-distributor')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.innerText = "Menyimpan..."; btn.disabled = true;
            try {
                await client.from('distributor').insert([{
                    nama: document.getElementById('dist_nama').value,
                    nomor_hp: document.getElementById('dist_hp').value,
                    alamat: document.getElementById('dist_alamat').value,
                    link_gmaps: document.getElementById('dist_gmaps').value || null
                }]);
                alert('Distributor berhasil disimpan!'); window.location.reload();
            } catch(err) { alert(err.message); btn.innerText = "Daftarkan Buyer"; btn.disabled = false; }
        });

        document.getElementById('form-penjualan')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btn-save-pj');
            btn.innerHTML = `<i class="bi bi-hourglass-split"></i>`; btn.disabled = true;

            try {
                const tgl = document.getElementById('pj_tgl').value;
                const distId = document.getElementById('pj_distributor').value;
                const ket = document.getElementById('pj_keterangan').value || null;
                const tujuanKas = document.getElementById('pj_tujuan_kas').value; // 🔥 Tangkap pilihan kas

                const itemsToInsert = [];
                const mutasiLog = [];
                let totalPendapatanSemua = 0; // 🔥 Tampung grand total penjualan

                document.querySelectorAll('.pj-item-row').forEach(row => {
                    const komId = row.querySelector('.pj-input-komoditas').value;
                    const vol = parseFloat(row.querySelector('.pj-input-vol').value) || 0;
                    const hrg = parseFloat(row.querySelector('.pj-input-hrg').value) || 0;
                 
                    if(komId && vol > 0) {
                        const totHrg = vol * hrg;
                        totalPendapatanSemua += totHrg; // Akumulasi uang masuk
                        
                        itemsToInsert.push({ 
                            tanggal: tgl, 
                            distributor_id: distId, 
                            keterangan: ket,
                            komoditas_id: komId, 
                            volume: vol, 
                            harga_satuan: hrg, 
                            total_harga: totHrg,
                            tujuan_kas: tujuanKas // 🔥 Simpan ke database
                        });
                        mutasiLog.push({ komId, vol });
                    }
                });

                if(itemsToInsert.length === 0) throw new Error("Minimal masukkan 1 rincian barang!");

                const { error: errTrx } = await client.from('penjualan_olahan').insert(itemsToInsert);
                if(errTrx) throw errTrx;

                // 🔥 TAMBAH UANG MASUK KE KAS YANG DIPILIH 🔥
                const { data: kasData } = await client.from('kas_perusahaan').select(tujuanKas).eq('id', 1).single();
                let payloadKas = {};
                payloadKas[tujuanKas] = (Number(kasData[tujuanKas]) || 0) + totalPendapatanSemua;
                await client.from('kas_perusahaan').update(payloadKas).eq('id', 1);

                // Potong Stok Gudang & Catat Mutasi
                for (let log of mutasiLog) {
                    const { data: g } = await client.from('gudang_komoditas').select('stok').eq('id', log.komId).single();
                    await client.from('gudang_komoditas').update({ stok: g.stok - log.vol }).eq('id', log.komId);
                    await client.from('gudang_mutasi').insert([{ jenis_mutasi: 'Keluar', komoditas_id: log.komId, jumlah: -log.vol, keterangan: 'Penjualan ke Distributor' }]);
                }

                alert('Transaksi Sukses Disimpan ke Riwayat!');
                window.location.reload();
            } catch(err) { alert(err.message); btn.innerHTML = `<i class="bi bi-floppy-fill"></i>`; btn.disabled = false; }
        });

        document.getElementById('form-edit-distributor')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.innerText = "Menyimpan Perubahan..."; btn.disabled = true;

            const id = document.getElementById('edit_dist_id').value;
            try {
                const { error } = await client.from('distributor').update({
                    nama: document.getElementById('edit_dist_nama').value,
                    nomor_hp: document.getElementById('edit_dist_hp').value,
                    alamat: document.getElementById('edit_dist_alamat').value,
                    link_gmaps: document.getElementById('edit_dist_gmaps').value || null
                }).eq('id', id);

                if (error) throw error;
                alert('Data distributor berhasil diperbarui!');
                window.location.reload();
            } catch(err) { 
                alert("Gagal mengupdate: " + err.message); 
                btn.innerText = "Simpan Perubahan"; btn.disabled = false; 
            }
        });

        // ==========================================
        // 3. TETAP DI BAWAH: FETCH DATA
        // ==========================================
        async function loadDataHalaman() {
            if(!window.supabase) return;
            try {
                // 1. Fetch Distributor
                const { data: dist } = await window.supabase.from('distributor').select('*').order('nama', { ascending: true });
                const tbodyDist = document.getElementById('distributor-tbody');
                let htmlDist = '';
                let optDist = '<option value="">-- Pilih Distributor --</option>';
                dist?.forEach(d => {
                    htmlDist += `
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 text-sm font-bold text-gray-900">${d.nama}</td>
                        <td class="px-6 py-4 text-sm text-gray-600">${d.nomor_hp || '-'}</td>
                        <td class="px-6 py-4 text-sm text-gray-600">${d.alamat || '-'}</td>
                        <td class="px-6 py-4 text-center">
                            ${d.link_gmaps ? `<a href="${d.link_gmaps}" target="_blank" class="text-blue-600 text-xl"><i class="bi bi-geo-alt-fill"></i></a>` : '-'}
                        </td>
                        <td class="px-6 py-4 text-center space-x-3 whitespace-nowrap">
                            <button onclick="window.bukaModalEditDistributor('${d.id}')" class="text-yellow-600 hover:text-yellow-800" title="Edit Distributor"><i class="bi bi-pencil-square text-lg"></i></button>
                            <button onclick="window.hapusDistributor('${d.id}', '${d.nama}')" class="text-red-500 hover:text-red-700" title="Hapus Distributor"><i class="bi bi-trash text-lg"></i></button>
                        </td>
                    </tr>`;
                    optDist += `<option value="${d.id}">${d.nama}</option>`;
                });
                if(tbodyDist) tbodyDist.innerHTML = htmlDist || '<tr><td colspan="4" class="text-center py-4 text-gray-500">Kosong.</td></tr>';
                
                const distSelect = document.getElementById('pj_distributor');
                if(distSelect) distSelect.innerHTML = optDist;

                // 2. Fetch Komoditas
                const { data: kom } = await window.supabase.from('gudang_komoditas').select('id, nama_komoditas');
                kom?.forEach(k => { window.opsiKomoditasHtml += `<option value="${k.id}">${k.nama_komoditas}</option>`; });

                // 3. Fetch Penjualan (Sistem 1 Tabel Tergabung)
                const { data: jual, error: errJual } = await window.supabase.from('penjualan_olahan')
                    .select(`*, distributor:distributor_id(nama), gudang_komoditas:komoditas_id(nama_komoditas)`)
                    .order('created_at', { ascending: false });
                
                if (errJual) console.error("Error ambil data penjualan:", errJual);

                const tbodyJual = document.getElementById('penjualan-tbody');
                let htmlJual = '';
                
                jual?.forEach(p => {
                    const buyer = p.distributor?.nama || 'Distributor Dihapus';
                    const namaKomoditas = p.gudang_komoditas?.nama_komoditas || '-';
                    const ketHtml = p.keterangan ? `<span class="block text-xs text-gray-500 italic leading-tight">${p.keterangan}</span>` : '<span class="text-gray-400">-</span>';
                    
                    htmlJual += `
                    <tr class="hover:bg-gray-50 penjualan-row border-b border-gray-100" data-date="${p.tanggal}" data-total="${p.total_harga}">
                        <td class="px-4 py-3 align-top whitespace-nowrap text-sm font-medium text-gray-600">${p.tanggal}</td>
                        <td class="px-4 py-3 align-top font-bold text-gray-900">${buyer}</td>
                        <td class="px-4 py-3 align-top"><span class="bg-blue-50 text-blue-700 px-2 py-1 rounded text-[11px] font-bold">${namaKomoditas}</span></td>
                        <td class="px-4 py-3 align-top text-right text-sm font-medium">${p.volume} Kg</td>
                        <td class="px-4 py-3 align-top text-right text-sm text-gray-600">Rp ${Number(p.harga_satuan).toLocaleString('id-ID')}</td>
                        <td class="px-4 py-3 align-top">${ketHtml}</td>
                        <td class="px-4 py-3 align-top text-sm font-bold text-green-700 text-right whitespace-nowrap">Rp ${Number(p.total_harga).toLocaleString('id-ID')}</td>
                        <td class="px-4 py-3 align-top text-center space-x-1 whitespace-nowrap">
                            <button onclick="window.bukaModalEditPenjualan('${p.id}', '${p.tanggal}', '${p.distributor_id}', '${p.komoditas_id}', ${p.volume}, ${p.harga_satuan}, '${(p.keterangan || '').replace(/'/g, "\\'")}', ${p.total_harga}, '${p.tujuan_kas || 'uang_keuangan'}')" class="text-yellow-600 hover:text-yellow-800 bg-yellow-50 px-2 py-1 rounded border border-yellow-200 text-xs font-bold shadow-sm active:scale-95" title="Edit Transaksi">
                                <i class="bi bi-pencil-square"></i> Edit
                            </button>
                            <button onclick="window.hapusPenjualan('${p.id}', '${p.komoditas_id}', ${p.volume}, ${p.total_harga}, '${p.tujuan_kas || 'uang_keuangan'}')" class="text-red-500 hover:text-red-700 bg-red-50 px-2 py-1 rounded border border-red-100 text-xs font-bold shadow-sm active:scale-95" title="Batalkan Transaksi">
                                <i class="bi bi-trash"></i> Batal
                            </button>
                        </td>
                    </tr>`;
                });
                
                if(tbodyJual) tbodyJual.innerHTML = htmlJual || '<tr><td colspan="7" class="text-center py-4 text-gray-500">Belum ada riwayat transaksi.</td></tr>';

            } catch (err) { console.error(err); }
        }

        // AKHIR: EKSEKUSI DATA
        await loadDataHalaman();
    });
</script>