---
// src/components/dashboard/TransaksiKomoditasChart.astro
---

<div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline-variant shadow-md flex flex-col h-full hover:shadow-lg transition-shadow duration-300">
    
    <div class="mb-sm flex justify-between items-start">
        <div>
            <h3 class="font-headline-md text-on-surface font-bold text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">
                Transaksi Komoditas
            </h3>
            <p class="text-label-sm text-on-surface-variant font-medium">Nilai Transaksi (Rp)</p>
        </div>
        <div class="text-right">
            <span class="text-label-xs text-on-surface-variant uppercase tracking-wider block mb-1">Total Terpilih</span>
            <span id="total-rp-transaksi" class="text-title-lg font-bold text-primary">Rp 0</span>
        </div>
    </div>

    <div class="w-full mb-lg">
        <div id="filter-harian-transaksi" class="flex items-center gap-2 bg-surface-variant/20 p-2 rounded-xl border border-surface-variant/50 w-full focus-within:border-primary/50 focus-within:ring-2 focus-within:ring-primary/10 transition-all">
            <input type="date" id="start-date-transaksi" class="w-full text-label-sm bg-transparent border-none outline-none text-on-surface cursor-pointer focus:ring-0 font-medium" />
            <span class="text-label-sm text-primary font-bold bg-primary/10 px-2 py-0.5 rounded-md">-</span>
            <input type="date" id="end-date-transaksi" class="w-full text-label-sm bg-transparent border-none outline-none text-on-surface cursor-pointer focus:ring-0 font-medium" />
        </div>

        <div id="filter-mingguan-transaksi" class="hidden items-center bg-surface-variant/20 p-2 rounded-xl border border-surface-variant/50 w-full focus-within:border-primary/50 focus-within:ring-2 focus-within:ring-primary/10 transition-all">
            <input type="month" id="month-transaksi" class="w-full text-label-sm bg-transparent border-none outline-none text-on-surface cursor-pointer focus:ring-0 font-medium" />
        </div>
    </div>

    <div class="relative w-full h-64 flex-grow mb-md">
        <canvas id="chartTransaksi"></canvas>
    </div>

    <div class="mt-auto border-t border-outline-variant/60 pt-md flex flex-col gap-4">
        
        <div class="flex flex-wrap justify-center gap-2" id="commodity-filters-transaksi">
            <button data-komoditas="Minyak Jelantah" class="komoditas-btn-transaksi px-3 py-1.5 rounded-full text-xs font-bold transition-all duration-300 bg-primary text-white shadow-sm ring-2 ring-primary/20 scale-105">
                Minyak Jelantah
            </button>
            <button data-komoditas="Ampas" class="komoditas-btn-transaksi px-3 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface">
                Ampas
            </button>
            <button data-komoditas="Keriuk" class="komoditas-btn-transaksi px-3 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface">
                Keriuk
            </button>
            <button data-komoditas="Tepung" class="komoditas-btn-transaksi px-3 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface">
                Tepung
            </button>
            <button data-komoditas="Spinner" class="komoditas-btn-transaksi px-3 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface">
                Spinner
            </button>
        </div>

        <div class="flex justify-center">
            <div class="bg-surface-variant/20 p-1 rounded-xl inline-flex w-full sm:w-auto border border-surface-variant/40 shadow-inner">
                <button id="btn-harian-transaksi" class="flex-1 sm:flex-none px-6 py-1.5 rounded-lg text-label-md font-bold transition-all duration-300">
                    Harian
                </button>
                <button id="btn-mingguan-transaksi" class="flex-1 sm:flex-none px-6 py-1.5 rounded-lg text-label-md font-bold transition-all duration-300">
                    Mingguan
                </button>
            </div>
        </div>
    </div>

</div>

<script>
    import { supabase } from '../../lib/supabase';
    import Chart from 'chart.js/auto';

    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.color = '#8E8E93';
    
    // Fungsi Format Rupiah
    const formatRp = (number) => {
        return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(number);
    };

    const chartOptions = {
        responsive: true, 
        maintainAspectRatio: false,
        plugins: { 
            legend: { display: false },
            tooltip: {
                backgroundColor: 'rgba(255, 255, 255, 0.95)',
                titleColor: '#1F2937',
                bodyColor: '#4B5563',
                borderColor: '#E5E7EB',
                borderWidth: 1,
                padding: 12,
                usePointStyle: true,
                callbacks: {
                    label: function(context) {
                        return ' ' + formatRp(context.raw);
                    }
                }
            }
        },
        scales: {
            x: { grid: { display: false } },
            y: { 
                border: { dash: [4, 4] }, 
                grid: { color: '#F3F4F6' }, 
                beginAtZero: true,
                ticks: {
                    callback: function(value) {
                        // Singkat angka agar sumbu Y tidak kepanjangan (misal Rp 1Jt)
                        if (value >= 1000000) return 'Rp ' + (value / 1000000) + 'M';
                        if (value >= 1000) return 'Rp ' + (value / 1000) + 'K';
                        return 'Rp ' + value;
                    }
                }
            }
        }
    };

    async function initChartTransaksi() {
        let chartInstance = null;
        let dataHarian = [];
        let dataMingguan = [];
        
        let currentMode = 'harian';
        let currentCommodity = 'Minyak Jelantah'; 

        // Mapping nama kolom Rupiah di Database
        const kolomDatabase = {
            'Minyak Jelantah': 'minyak_jelantah_rp',
            'Ampas': 'ampas_rp',
            'Keriuk': 'keriuk_rp',
            'Tepung': 'tepung_rp',
            'Spinner': 'spinner_rp'
        };

        const ctx = document.getElementById('chartTransaksi').getContext('2d');
        chartInstance = new Chart(ctx, { type: 'line', data: { labels: [], datasets: [] }, options: chartOptions });

        const btnHarian = document.getElementById('btn-harian-transaksi');
        const btnMingguan = document.getElementById('btn-mingguan-transaksi');
        const filterHarianContainer = document.getElementById('filter-harian-transaksi');
        const filterMingguanContainer = document.getElementById('filter-mingguan-transaksi');
        const startDateInput = document.getElementById('start-date-transaksi');
        const endDateInput = document.getElementById('end-date-transaksi');
        const monthInput = document.getElementById('month-transaksi');
        const komoditasBtns = document.querySelectorAll('.komoditas-btn-transaksi');
        const elTotalRp = document.getElementById('total-rp-transaksi');

        async function fetchHarian() {
            const kolomAktif = kolomDatabase[currentCommodity];
            let query = supabase.from('rekap_transfer_harian')
                .select(`tanggal, ${kolomAktif}`)
                .order('tanggal', { ascending: true });
            
            if (startDateInput.value) query = query.gte('tanggal', startDateInput.value);
            if (endDateInput.value) query = query.lte('tanggal', endDateInput.value);
            if (!startDateInput.value && !endDateInput.value) query = query.limit(7); 

            const { data, error } = await query;
            if (!error && data) {
                dataHarian = data;
                renderChart();
            }
        }

        async function fetchMingguan() {
            const kolomAktif = kolomDatabase[currentCommodity];
            let query = supabase.from('rekap_transfer_mingguan')
                .select(`minggu_ke, periode, ${kolomAktif}`)
                .order('periode', { ascending: true })
                .order('minggu_ke', { ascending: true });
            
            if (monthInput.value) {
                query = query.ilike('periode', `%${monthInput.value}%`);
            } else {
                query = query.limit(8);
            }
            
            const { data, error } = await query;
            if (!error && data) {
                dataMingguan = data;
                renderChart();
            }
        }

        function renderChart() {
            const gradient = ctx.createLinearGradient(0, 0, 0, 300);
            let labels, values, color, hoverColor;
            const kolomAktif = kolomDatabase[currentCommodity];

            if (currentCommodity === 'Minyak Jelantah') { color = '#F59E0B'; hoverColor = 'rgba(245, 158, 11, 0.3)'; }
            else if (currentCommodity === 'Ampas') { color = '#6B7280'; hoverColor = 'rgba(107, 114, 128, 0.3)'; }
            else if (currentCommodity === 'Keriuk') { color = '#D97706'; hoverColor = 'rgba(217, 119, 6, 0.3)'; }
            else if (currentCommodity === 'Tepung') { color = '#10B981'; hoverColor = 'rgba(16, 185, 129, 0.3)'; }
            else { color = '#6366F1'; hoverColor = 'rgba(99, 102, 241, 0.3)'; }

            if (currentMode === 'harian') {
                labels = dataHarian.map(d => d.tanggal);
                values = dataHarian.map(d => d[kolomAktif] || 0); 
                gradient.addColorStop(0, hoverColor); 
                gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
                
                btnHarian.className = "flex-1 sm:flex-none px-6 py-1.5 rounded-lg text-label-md font-bold bg-primary text-white shadow-md transition-all duration-300 scale-105";
                btnMingguan.className = "flex-1 sm:flex-none px-6 py-1.5 rounded-lg text-label-md font-medium text-on-surface-variant bg-transparent hover:bg-surface-variant/40 transition-all duration-300";
            } else {
                labels = dataMingguan.map(d => `W${d.minggu_ke} ${d.periode}`);
                values = dataMingguan.map(d => d[kolomAktif] || 0);
                gradient.addColorStop(0, hoverColor); 
                gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
                
                btnMingguan.className = "flex-1 sm:flex-none px-6 py-1.5 rounded-lg text-label-md font-bold bg-primary text-white shadow-md transition-all duration-300 scale-105";
                btnHarian.className = "flex-1 sm:flex-none px-6 py-1.5 rounded-lg text-label-md font-medium text-on-surface-variant bg-transparent hover:bg-surface-variant/40 transition-all duration-300";
            }

            // Kalkulasi Total Terpilih
            const totalSum = values.reduce((acc, curr) => acc + Number(curr), 0);
            elTotalRp.textContent = formatRp(totalSum);

            chartInstance.data = {
                labels,
                datasets: [{ 
                    data: values, 
                    borderColor: color, 
                    backgroundColor: gradient, 
                    fill: true, 
                    tension: 0.4,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: color,
                    pointBorderWidth: 2,
                    pointHoverRadius: 6
                }]
            };
            chartInstance.update();
        }

        function switchMode(mode) {
            currentMode = mode;
            if (mode === 'harian') {
                filterHarianContainer.classList.remove('hidden');
                filterHarianContainer.classList.add('flex');
                filterMingguanContainer.classList.add('hidden');
                filterMingguanContainer.classList.remove('flex');
                fetchHarian();
            } else {
                filterHarianContainer.classList.add('hidden');
                filterHarianContainer.classList.remove('flex');
                filterMingguanContainer.classList.remove('hidden');
                filterMingguanContainer.classList.add('flex');
                fetchMingguan();
            }
        }

        btnHarian.addEventListener('click', () => switchMode('harian'));
        btnMingguan.addEventListener('click', () => switchMode('mingguan'));

        startDateInput.addEventListener('change', () => currentMode === 'harian' && fetchHarian());
        endDateInput.addEventListener('change', () => currentMode === 'harian' && fetchHarian());
        monthInput.addEventListener('change', () => currentMode === 'mingguan' && fetchMingguan());

        komoditasBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                currentCommodity = e.target.getAttribute('data-komoditas');
                komoditasBtns.forEach(b => {
                    b.className = "komoditas-btn-transaksi px-3 py-1.5 rounded-full text-xs font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface";
                });
                e.target.className = "komoditas-btn-transaksi px-3 py-1.5 rounded-full text-xs font-bold transition-all duration-300 bg-primary text-white shadow-sm ring-2 ring-primary/20 scale-105";
                
                if (currentMode === 'harian') fetchHarian();
                else fetchMingguan();
            });
        });

        switchMode('harian');
    }

    document.addEventListener('DOMContentLoaded', initChartTransaksi);
</script>