                                    <span class="material-symbols-outlined text-[18px]">edit</span>
                                </button>
                                <button onclick="window.nonaktifkanMitra('${l.id}', '${l.nama_mitra}')" class="w-10 h-10 flex items-center justify-center bg-surface-container text-error rounded-full hover:bg-error-container opacity-0 group-hover:opacity-100 transition-opacity" title="Pindah ke Tidak Aktif">
                                    <span class="material-symbols-outlined text-[18px]">person_off</span>
                                </button>
                            </td>
                        </tr>`;
