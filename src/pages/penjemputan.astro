        // ==========================================
        // SUBMIT TUGAS BARU ATAU UPDATE
        // ==========================================
        document.getElementById('formPenjemputan')?.addEventListener('submit', async function(e) {
            e.preventDefault();
                
            if(!isAllowed()) return alert('Akses Ditolak!');
            
            const btn = document.getElementById('btnSubmitPenjemputan');
            btn.innerHTML = 'Menyimpan...'; btn.disabled = true;

            try {
                const editId = document.getElementById('edit_penjemputan_id').value;
                const tipeKendaraan = document.getElementById('tipe_kendaraan_input').value;
                const mitra_id = document.getElementById('input_mitra').value;
                const tanggal = document.getElementById('input_tanggal').value;
                const selectedMitraObj = window.allMitra.find(m => String(m.id) === String(mitra_id));
                const wilayah = selectedMitraObj?.rute_jemput || 'Belum Diatur';
                
                let driver_id = null;
                let helper_id = null;
                let id_mobil_terpilih = null; // <-- Variabel baru
                if (tipeKendaraan === 'motor') {
                    driver_id = document.getElementById('input_driver_motor').value;
                } else {
                    driver_id = document.getElementById('input_driver_mobil').value;
                    const helper = document.getElementById('input_helper_mobil').value;
                    if(helper) helper_id = helper;
                    
                    const armadaTerpilih = document.getElementById('input_mobil_pickup').value; // <-- Ambil nilai mobil
                    if(armadaTerpilih) id_mobil_terpilih = armadaTerpilih;
                }

                if (!window.supabase) throw new Error("Supabase Client tidak ditemukan!");

                // 🔥 AMBIL DATA ESTIMASI DARI FORM 🔥
                const estMinyak = parseFloat(document.getElementById('est-minyak').value) || 0;
                const estTepung = parseFloat(document.getElementById('est-tepung').value) || 0;
                const estKriuk = parseFloat(document.getElementById('est-kriuk').value) || 0;
                const estSpinner = parseFloat(document.getElementById('est-spinner').value) || 0;
                const estAmpas = parseFloat(document.getElementById('est-ampas').value) || 0;

                // 🔥 AMBIL DATA HARGA SATUAN BARU 🔥
                const satMinyak = parseFloat(document.getElementById('satuan-minyak').value) || 0;
                const satTepung = parseFloat(document.getElementById('satuan-tepung').value) || 0;
                const satKriuk = parseFloat(document.getElementById('satuan-kriuk').value) || 0;
                const satSpinner = parseFloat(document.getElementById('satuan-spinner').value) || 0;
                const satAmpas = parseFloat(document.getElementById('satuan-ampas').value) || 0;
                
                const totalEstimasi = estMinyak + estTepung + estKriuk + estSpinner + estAmpas;
                
                const estimasiTransaksi = ((estMinyak * satMinyak) + (estTepung * satTepung) + (estKriuk * satKriuk) + (estSpinner * satSpinner) + (estAmpas * satAmpas));

                const payloadPenjemputan = {
                    mitra_id: parseInt(mitra_id), 
                    driver_id: driver_id, 
                    helper_id: helper_id || null,
                    tanggal: tanggal, 
                    kendaraan: tipeKendaraan,
                    mobil_id: id_mobil_terpilih, 
                    rute_penjemputan: wilayah,
                    estimasi_minyak: estMinyak,
                    estimasi_tepung: estTepung,
                    estimasi_kriuk: estKriuk,
                    estimasi_spinner: estSpinner,
                    estimasi_ampas: estAmpas,
                    total_estimasi: totalEstimasi,
                    estimasi_transaksi: estimasiTransaksi,
                    satuan_minyak: satMinyak,
                    satuan_tepung: satTepung,
                    satuan_kriuk: satKriuk,
                    satuan_spinner: satSpinner,
                    satuan_ampas: satAmpas
                };

                // ==========================
                // JALUR A: UPDATE JADWAL (EDIT)
                // ==========================
                if (editId) {
                    // Update Penjemputan dengan data estimasi
                    const { error: errUpdate } = await window.supabase
                        .from('penjemputan')
                        .update(payloadPenjemputan)
                        .eq('id', editId);
                    
                    if (errUpdate) throw errUpdate;

                    const p = window.allJadwalPending.find(x => x.id == editId);
                    let txId = p?.transaksi?.[0]?.id;
                    
                    if (txId) {
                        // Update Transaksi Induk
                        await window.supabase.from('transaksi').update({ 
                            kalkulator_user_id: driver_id, 
                        }).eq('id', txId);
                    } else {
                        // Buat Transaksi Baru Kalau Datanya Bolong
                        const {data: newTx} = await window.supabase.from('transaksi').insert([{
                            penjemputan_id: editId, 
                            kalkulator_user_id: driver_id, 
                            subtotal: 0, 
                            grand_total: 0
                        }]).select().single();
                        txId = newTx.id;
                    }
                    
                    alert('Jadwal dan estimasi berhasil diperbarui!');

                // ==========================
                // JALUR B: INSERT JADWAL BARU
                // ==========================
                } else {
                    // Masukkan status 'Belum' ke dalam payload untuk insert baru
                    payloadPenjemputan.status = 'Belum';

                    const { data: pickupData, error: errPickup } = await window.supabase
                        .from('penjemputan')
                        .insert([payloadPenjemputan])
                        .select()
                        .single();
                        
                    if (errPickup) throw errPickup;

                    // Buat Data Transaksi Awal Kosong
                    const { data: txData, error: errTx } = await window.supabase.from('transaksi').insert([{
                        penjemputan_id: pickupData.id, 
                        kalkulator_user_id: driver_id, 
                        subtotal: 0, 
                        grand_total: 0
                    }]).select().single();
                    
                    if (errTx) throw errTx;

                    alert('Tugas penjemputan baru beserta estimasi berhasil diterbitkan!');
                }

                window.location.reload();

            } catch (error) {
                alert('Gagal memproses penugasan: ' + error.message);
                btn.innerHTML = 'Kirim Perintah Jalan'; btn.disabled = false;
            }
        });
    });
    function nextStep(targetStep) {
