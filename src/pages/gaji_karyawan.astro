    // ==========================================
    // 🔧 FITUR EDIT SLIP GAJI DRAF (DENGAN DEBUG)
    // ==========================================

    window.openEditSlipModal = async function (slipId) {
      console.log("🚀 [DEBUG] Mulai Buka Modal Koreksi untuk Slip ID:", slipId);
      if (!window.supabase)
        return console.error("❌ [DEBUG] Supabase belum terload!");

      try {
        const slip = window.currentFilteredRiwayat.find(
          (s) => String(s.id) === String(slipId),
        );

        if (!slip) {
          console.error(
            "❌ [DEBUG] Data slip tidak ditemukan di array pencarian!",
          );
          return alert("❌ Slip tidak ditemukan!");
        }
        console.log("✅ [DEBUG] Data slip berhasil ditemukan:", slip);

        // ✅ BACA LANGSUNG DARI DATA HISTORIS SLIP
        const isJerigen =
          slip.jumlah_jerigen > 0 ||
          (slip.tarif_jerigen && slip.tarif_jerigen > 0)
            ? true
            : false;
        const tarifJerigen = slip.tarif_jerigen || 0;
        console.log(
          "📊 [DEBUG] Mode Jerigen:",
          isJerigen,
          "| Tarif:",
          tarifJerigen,
        );

        // 🛡️ ISI UI TEXT DENGAN PENGAMAN (ANTI NULL)
        console.log("🛠️ [DEBUG] Mulai memasukkan nilai ke dalam form HTML...");

        const elNama = document.getElementById("edit-emp-name");
        if (elNama) elNama.innerText = slip.profiles?.nama || "N/A";
        else
          console.warn(
            "⚠️ [DEBUG] Elemen 'edit-emp-name' tidak ditemukan di HTML!",
          );

        const elPeriode = document.getElementById("edit-slip-periode");
        if (elPeriode) elPeriode.innerText = slip.periode;

        const elJerigen = document.getElementById("edit_jumlah_jerigen");
        if (elJerigen) elJerigen.value = slip.jumlah_jerigen || 0;
        else
          console.warn(
            "⚠️ [DEBUG] Elemen 'edit_jumlah_jerigen' tidak ditemukan di HTML!",
          );

        const elKasbon = document.getElementById("edit_kasbon");
        if (elKasbon) elKasbon.value = slip.kasbon || 0;
        else
          console.warn(
            "⚠️ [DEBUG] Elemen 'edit_kasbon' tidak ditemukan di HTML!",
          );

        const elBonusManual = document.getElementById("edit_bonus_manual");
        if (elBonusManual)
          elBonusManual.value = 0; // Mulai dari 0 untuk draf
        else
          console.warn(
            "⚠️ [DEBUG] Elemen 'edit_bonus_manual' tidak ditemukan di HTML!",
          );

        // Simpan parameter hitung di window
        window.editSlipData = {
          slipId: slip.id,
          originalGrandTotal: slip.total_diterima,
          originalBonusTepat: slip.bonus_tepat_waktu || 0,
          originalBonusMingguan: slip.bonus_mingguan || 0,
          originalBonusKesehatan: slip.uang_kesehatan || 0,
          isJerigen: isJerigen,
          tarifJerigen: tarifJerigen,
        };
        console.log(
          "💾 [DEBUG] Data window.editSlipData tersimpan:",
          window.editSlipData,
        );

        // Tampilkan/Sembunyikan form berdasarkan Mode Jerigen (Dengan Pengaman)
        const wrapJerigen = document.getElementById("wrap_edit_jerigen");
        const wrapBonus = document.getElementById("wrap_edit_bonus");
        const wrapBreakdown = document.getElementById("edit_bonus_breakdown");

        if (isJerigen) {
          if (wrapJerigen) wrapJerigen.classList.remove("hidden");
          if (wrapBonus) wrapBonus.classList.add("hidden");
          if (wrapBreakdown) wrapBreakdown.classList.add("hidden");
        } else {
          if (wrapJerigen) wrapJerigen.classList.add("hidden");
          if (wrapBonus) wrapBonus.classList.remove("hidden");
          if (wrapBreakdown) wrapBreakdown.classList.remove("hidden");
        }

        window.dataLainLainRiwayat = slip.lain_lain || [];
        console.log(
          "📂 [DEBUG] Data JSONB Lain-lain di-load:",
          window.dataLainLainRiwayat,
        );

        if (typeof window.renderLainLainRiwayat === "function") {
          window.renderLainLainRiwayat();
        }

        window.hitungTotalEditSlip();
        window.openModal("modal-edit-slip");
        console.log("🎉 [DEBUG] Modal berhasil dibuka tanpa error!");
      } catch (err) {
        console.error("💥 [DEBUG] ERROR FATAL saat buka modal:", err);
        alert("❌ Error: " + err.message);
      }
    };

    // --- 2. Fungsi Hitung Otomatis Saat Ngetik ---
    window.hitungTotalEditSlip = function () {
      if (!window.editSlipData) return;
      console.log("🧮 [DEBUG] Menghitung total draf...");

      const isJerigen = window.editSlipData.isJerigen || false;

      // 🛡️ AMBIL VALUE DENGAN PENGAMAN
      const elJerigen = document.getElementById("edit_jumlah_jerigen");
      const jumlahJerigen = elJerigen ? parseInt(elJerigen.value) || 0 : 0;

      const elKasbon = document.getElementById("edit_kasbon");
      const kasbon = elKasbon ? parseFloat(elKasbon.value) || 0 : 0;

      let newGrandTotal = 0;

      if (isJerigen) {
        const tarif = window.editSlipData.tarifJerigen || 0;
        newGrandTotal = jumlahJerigen * tarif - kasbon;
        console.log(
          `🧮 [DEBUG] Mode Jerigen Kalkulasi: (${jumlahJerigen} x ${tarif}) - ${kasbon} = ${newGrandTotal}`,
        );
      } else {
        const elBonus = document.getElementById("edit_bonus_manual");
        const bonusManual = elBonus ? parseFloat(elBonus.value) || 0 : 0;

        newGrandTotal =
          window.editSlipData.originalGrandTotal + (bonusManual - kasbon);
        console.log(
          `🧮 [DEBUG] Mode Normal Kalkulasi: ${window.editSlipData.originalGrandTotal} + (${bonusManual} - ${kasbon}) = ${newGrandTotal}`,
        );

        // Render breakdown visual
        const bTepat = window.editSlipData.originalBonusTepat || 0;
        const bMinggu = window.editSlipData.originalBonusMingguan || 0;
        const bSehat = window.editSlipData.originalBonusKesehatan || 0;
        const tBonus = bTepat + bMinggu + bSehat;

        const wrapBreakdown = document.getElementById("edit_bonus_breakdown");
        if (wrapBreakdown) {
          wrapBreakdown.innerHTML = `
            <div class="text-xs space-y-1">
              <p class="font-bold text-amber-900 mb-2">📊 Bonus Sistem (Tidak Berubah)</p>
              <div class="flex justify-between text-amber-800"><span>Kehadiran Tepat Waktu:</span> <span>Rp ${bTepat.toLocaleString("id-ID")}</span></div>
              <div class="flex justify-between text-amber-800"><span>Bonus Mingguan:</span> <span>Rp ${bMinggu.toLocaleString("id-ID")}</span></div>
              <div class="flex justify-between text-amber-800"><span>Uang Kesehatan:</span> <span>Rp ${bSehat.toLocaleString("id-ID")}</span></div>
              <div class="border-t border-amber-200 pt-1.5 mt-1.5 flex justify-between font-black text-amber-900">
                <span>Total Bonus Sistem:</span> <span>Rp ${tBonus.toLocaleString("id-ID")}</span>
              </div>
            </div>`;
        }
      }

      // TAMBAHKAN JSONB LAIN-LAIN
      if (window.dataLainLainRiwayat && window.dataLainLainRiwayat.length > 0) {
        window.dataLainLainRiwayat.forEach((item) => {
          const nom = parseFloat(item.nominal) || 0;
          if (item.tipe === "penambahan") newGrandTotal += nom;
          else if (item.tipe === "potongan") newGrandTotal -= nom;
        });
        console.log(
          `🧮 [DEBUG] Grand Total setelah ditambahkan JSONB Lain-lain:`,
          newGrandTotal,
        );
      }

      const prevTotal = document.getElementById("edit_grand_total_preview");
      if (prevTotal) {
        prevTotal.innerText = `Rp ${Math.max(0, newGrandTotal).toLocaleString("id-ID")}`;
      }
    };

    // --- 3. Fungsi Simpan Ke Database ---
    window.submitEditSlip = async function () {
      console.log("📤 [DEBUG] Tombol Simpan Draf Ditekan!");
      if (!window.editSlipData) return alert("❌ Data slip tidak ditemukan!");
      if (!confirm("Yakin simpan draf koreksi ini?")) return;

      const isJerigen = window.editSlipData.isJerigen || false;

      // 🛡️ AMBIL VALUE DENGAN PENGAMAN
      const elJerigen = document.getElementById("edit_jumlah_jerigen");
      const jumlahJerigen = elJerigen ? parseInt(elJerigen.value) || 0 : 0;

      const elKasbon = document.getElementById("edit_kasbon");
      const kasbon = elKasbon ? parseFloat(elKasbon.value) || 0 : 0;

      let newTotal = 0;
      let payloadUpdate = {
        jumlah_jerigen: jumlahJerigen,
        kasbon: kasbon,
        lain_lain: window.dataLainLainRiwayat,
      };

      if (isJerigen) {
        const tarif = window.editSlipData.tarifJerigen || 0;
        newTotal = jumlahJerigen * tarif - kasbon;
        payloadUpdate.gaji_karyawan = jumlahJerigen * tarif;
      } else {
        const elBonus = document.getElementById("edit_bonus_manual");
        const bonusManual = elBonus ? parseFloat(elBonus.value) || 0 : 0;
        newTotal =
          window.editSlipData.originalGrandTotal + (bonusManual - kasbon);
      }

      if (window.dataLainLainRiwayat && window.dataLainLainRiwayat.length > 0) {
        window.dataLainLainRiwayat.forEach((item) => {
          const nom = parseFloat(item.nominal) || 0;
          if (item.tipe === "penambahan") newTotal += nom;
          else if (item.tipe === "potongan") newTotal -= nom;
        });
      }

      payloadUpdate.total_diterima = Math.max(0, newTotal);
      console.log(
        "📦 [DEBUG] Payload yang akan dikirim ke Supabase:",
        payloadUpdate,
      );

      const { error } = await window.supabase
        .from("slip_gaji")
        .update(payloadUpdate)
        .eq("id", window.editSlipData.slipId);

      if (error) {
        console.error("💥 [DEBUG] Supabase gagal update:", error);
        alert("❌ Gagal update draf: " + error.message);
        return;
      }

      console.log("✅ [DEBUG] Update draf sukses!");
      alert("✅ Draf slip berhasil dikoreksi!");
      window.closeModal("modal-edit-slip");

      const btnFilter = document.getElementById("btn-filter-gaji");
      if (btnFilter) btnFilter.click();
    };

    // ==========================================
    // ⚡ FITUR BATCH APPROVAL & PREVIEW
    // ==========================================

    window.hitungBatch = function () {
      const checkboxes = document.querySelectorAll(".batch-checkbox:checked");
      let total = 0;

      checkboxes.forEach((cb) => {
        total += parseFloat(cb.getAttribute("data-total")) || 0;
      });

      document.getElementById("batch-count").innerText = checkboxes.length;
      document.getElementById("batch-total").innerText =
        "Rp " + total.toLocaleString("id-ID");

      const bar = document.getElementById("batch-action-bar");
      if (checkboxes.length > 0) {
        bar.classList.remove("hidden");
        bar.style.display = "flex"; // Paksa flex
        setTimeout(() => bar.classList.remove("translate-y-full"), 10);
      } else {
        bar.classList.add("translate-y-full");
        setTimeout(() => {
          bar.classList.add("hidden");
          bar.style.display = "none";
        }, 300);
      }
    };

    window.previewSlip = function (slipId) {
      // Ambil data dari cache riwayat
      const slip = window.currentFilteredRiwayat.find(
        (s) => String(s.id) === String(slipId),
      );
