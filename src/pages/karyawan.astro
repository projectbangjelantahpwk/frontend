---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// 1. Tarik Data Karyawan beserta Riwayat Presensinya
const { data: daftarKaryawan, error } = await supabase
    .from('profiles')
    .select(`
        id,
        id_lapangan,
        nama,
        nomor_hp,
        role,
        tipe_kendaraan,
        presensi (
            tanggal,
            waktu_tiba,
            waktu_pulang,
            status_tiba,
            status_pulang
        )
    `)
    .order('nama', { ascending: true });

if (error) {
    console.error("Gagal menarik data karyawan:", error);
}

// 2. Fungsi kecil untuk mengecek apakah karyawan absen hari ini
const today = new Date().toISOString().split('T')[0]; // Format YYYY-MM-DD
---

<Layout title="Manajemen Karyawan - Bang Jelantah">
    <div class="max-w-7xl mx-auto flex flex-col h-full relative">
        
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-md mb-lg">
            <div>
                <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-primary">Karyawan</h1>
                <p class="font-body-md text-body-md text-on-surface-variant mt-xs">Pantau absensi dan informasi tim operasional lapangan.</p>
            </div>
            
            <div class="w-full md:w-auto flex items-center bg-surface-container-lowest rounded-full px-sm h-12 md:h-10 border border-outline-variant focus-within:border-primary focus-within:ring-1 focus-within:ring-primary transition-all shadow-sm">
                <span class="material-symbols-outlined text-on-surface-variant ml-sm">search</span>
                <input class="bg-transparent border-none focus:ring-0 text-on-surface w-full md:w-64 font-body-md text-body-md h-full placeholder:text-on-surface-variant outline-none px-2" placeholder="Cari nama, posisi..." type="text"/>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-md">
            {daftarKaryawan && daftarKaryawan.map((karyawan) => {
                // Cek status hari ini
                const absenHariIni = karyawan.presensi?.find(p => p.tanggal === today);
                const statusBadgeBg = absenHariIni ? 'bg-primary-container text-on-primary-container' : 'bg-surface-variant text-on-surface-variant';
                const statusBadgeText = absenHariIni ? (absenHariIni.status_tiba === 'Telat' ? 'Telat' : 'Hadir') : 'Belum Absen';
                
                // Format inisial nama
                const inisial = karyawan.nama.substring(0, 2).toUpperCase();

                return (
                    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-md flex items-center gap-md hover:shadow-md cursor-pointer transition-shadow relative overflow-hidden" onclick={`openEmployeeDetail('${karyawan.id}')`}>
                        {absenHariIni && <div class="absolute left-0 top-0 bottom-0 w-1 bg-primary"></div>}
                        
                        <div class="w-12 h-12 rounded-full bg-surface-variant border border-outline-variant flex items-center justify-center text-on-surface-variant font-headline-md shrink-0">
                            {inisial}
                        </div>
                        
                        <div class="flex-1 min-w-0">
                            <h3 class="font-label-lg text-label-lg text-on-surface truncate">{karyawan.nama}</h3>
                            <p class="font-body-md text-body-md text-on-surface-variant truncate capitalize">{karyawan.tipe_kendaraan?.replace('_', ' ') || karyawan.role}</p>
                        </div>
                        <div class={`${statusBadgeBg} font-label-sm text-label-sm px-2 py-1 rounded-full shrink-0`}>
                            {statusBadgeText}
                        </div>
                    </div>
                );
            })}
        </div>
    </div>

    <div id="employee-detail-backdrop" class="fixed inset-0 bg-on-background/50 z-[60] hidden transition-opacity opacity-0" onclick="closeEmployeeDetail()"></div>

    <div id="employee-detail-panel" class="fixed inset-y-0 right-0 w-full md:w-[480px] bg-surface shadow-[0_0_24px_rgba(0,0,0,0.1)] border-l border-outline-variant z-[70] flex flex-col transform transition-transform duration-300 translate-x-full">
        
        <div class="flex items-center justify-between px-lg py-md border-b border-outline-variant bg-surface-container-lowest">
            <h2 class="font-headline-md text-headline-md font-bold text-on-surface">Detail Karyawan</h2>
            <button class="w-10 h-10 rounded-full hover:bg-surface-container-low flex items-center justify-center text-on-surface-variant transition-colors" onclick="closeEmployeeDetail()">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        
        <div class="flex-1 overflow-y-auto bg-surface-container-lowest">
            <div class="p-lg flex flex-col gap-xl">
                
                <section class="flex flex-col items-center text-center gap-md">
                    <div class="w-24 h-24 rounded-full bg-surface-variant border-2 border-surface-container-high flex items-center justify-center text-on-surface-variant text-4xl font-bold" id="detail-inisial">
                        --
                    </div>
                    <div>
                        <h3 class="font-headline-md text-headline-md font-bold text-on-surface" id="detail-nama">Nama Karyawan</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant" id="detail-id">ID: ---</p>
                    </div>
                </section>

                <section class="bg-surface border border-outline-variant rounded-xl p-md flex flex-col gap-sm">
                    <div class="grid grid-cols-[100px_1fr] gap-sm py-xs border-b border-surface-variant">
                        <span class="font-label-sm text-label-sm text-on-surface-variant">Posisi</span>
                        <span class="font-body-md text-body-md text-on-surface font-medium capitalize" id="detail-posisi">-</span>
                    </div>
                    <div class="grid grid-cols-[100px_1fr] gap-sm py-xs border-b border-surface-variant">
                        <span class="font-label-sm text-label-sm text-on-surface-variant">No. HP</span>
                        <span class="font-body-md text-body-md text-on-surface font-medium" id="detail-hp">-</span>
                    </div>
                </section>

                <section>
                    <h4 class="font-label-lg text-label-lg font-bold text-on-surface mb-md">Riwayat Kehadiran Terakhir</h4>
                    <div id="riwayat-container" class="flex flex-col relative before:absolute before:left-[11px] before:top-2 before:bottom-2 before:w-[2px] before:bg-surface-variant gap-lg ml-xs">
                        </div>
                </section>
            </div>
        </div>
    </div>

    <script is:inline define:vars={{ daftarKaryawan }}>
        window.openEmployeeDetail = function(id) {
            // Cari data karyawan berdasarkan ID
            const karyawan = daftarKaryawan.find(k => k.id === id);
            if (!karyawan) return;

            // 1. Update UI Identitas
            document.getElementById('detail-nama').innerText = karyawan.nama;
            document.getElementById('detail-id').innerText = 'ID: ' + karyawan.id_lapangan;
            document.getElementById('detail-posisi').innerText = karyawan.tipe_kendaraan?.replace('_', ' ') || karyawan.role;
            document.getElementById('detail-hp').innerText = karyawan.nomor_hp || 'Belum diatur';
            document.getElementById('detail-inisial').innerText = karyawan.nama.substring(0, 2).toUpperCase();

            // 2. Render Riwayat Presensi
            const riwayatContainer = document.getElementById('riwayat-container');
            riwayatContainer.innerHTML = ''; // Bersihkan kontainer lama

            // Urutkan presensi dari yang paling baru
            const presensi = karyawan.presensi || [];
            const presensiSorted = presensi.sort((a, b) => new Date(b.tanggal) - new Date(a.tanggal));

            if (presensiSorted.length === 0) {
                riwayatContainer.innerHTML = '<p class="font-body-md text-body-md text-on-surface-variant italic">Belum ada riwayat kehadiran.</p>';
            } else {
                // Ambil maksimal 5 riwayat terakhir
                const top5Presensi = presensiSorted.slice(0, 5);
                
                let htmlRiwayat = '';
                top5Presensi.forEach(p => {
                    const isTelat = p.status_tiba?.toLowerCase().includes('telat');
                    
                    // Set warna dan icon berdasarkan status
                    const bgColorClass = isTelat ? 'bg-error' : 'bg-primary';
                    const iconText = isTelat ? 'schedule' : 'check';
                    const badgeBgClass = isTelat ? 'bg-error-container text-on-error-container' : 'bg-primary-container text-on-primary-container';
                    const statusText = p.status_tiba || 'Hadir';

                    htmlRiwayat += `
                        <div class="relative flex gap-md items-start">
                            <div class="w-6 h-6 rounded-full ${bgColorClass} flex items-center justify-center shrink-0 z-10 outline outline-4 outline-surface-container-lowest">
                                <span class="material-symbols-outlined text-[14px] text-white">${iconText}</span>
                            </div>
                            <div class="flex-1 bg-surface border border-outline-variant p-sm rounded-lg shadow-sm">
                                <div class="flex justify-between items-center mb-xs">
                                    <span class="font-label-sm text-label-sm text-on-surface font-bold">${p.tanggal} ${p.waktu_tiba ? `, ${p.waktu_tiba.substring(0,5)}` : ''}</span>
                                    <span class="${badgeBgClass} text-[10px] uppercase font-bold px-2 py-1 rounded-sm tracking-wider">${statusText}</span>
                                </div>
                                <p class="font-body-md text-body-md text-on-surface-variant">
                                    ${p.waktu_pulang ? `Pulang: ${p.waktu_pulang.substring(0,5)} (${p.status_pulang || '-'})` : 'Belum absen pulang.'}
                                </p>
                            </div>
                        </div>
                    `;
                });
                riwayatContainer.innerHTML = htmlRiwayat;
            }

            // 3. Animasi Panel Slide
            const panel = document.getElementById('employee-detail-panel');
            const backdrop = document.getElementById('employee-detail-backdrop');
            
            backdrop.classList.remove('hidden');
            setTimeout(() => { backdrop.classList.remove('opacity-0'); }, 10);
            
            panel.classList.remove('translate-x-full');
            panel.classList.add('translate-x-0');
        };

        window.closeEmployeeDetail = function() {
            const panel = document.getElementById('employee-detail-panel');
            const backdrop = document.getElementById('employee-detail-backdrop');
            
            panel.classList.remove('translate-x-0');
            panel.classList.add('translate-x-full');
            
            backdrop.classList.add('opacity-0');
            setTimeout(() => { backdrop.classList.add('hidden'); }, 300);
        };
    </script>
</Layout>