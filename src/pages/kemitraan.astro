    // Wadah penyimpanan sementara hasil kalkulasi biar pindah tab/filter jadi kilat
    // Wadah penyimpanan sementara hasil kalkulasi biar pindah tab/filter jadi kilat
    window.leaderboardCache = {
      "Juara Umum": [],
      "Minyak Jelantah": [],
      Ampas: [],
      Kriuk: [],
      Tepung: [],
      Spinner: [],
    };

    window.generateLeaderboard = async function () {
      const rawPeriode = document.getElementById(
        "input-periode-leaderboard",
      ).value;
      if (!rawPeriode || !window.supabase) return;

      // Format dari input type="month" sudah YYYY-MM (misal: 2026-06).
      // Langsung tembak ke database karena format tabelmu juga YYYY-MM.
      const periodeDB = rawPeriode;

      try {
        // 1. Tarik data dari tabel mingguan yang asli
        const { data: rekapData, error } = await window.supabase
          .from("rekap_kumulatif_mingguan_mitra")
          .select("*")
          .eq("periode", periodeDB);

        if (error) throw error;

        // 2. Reset Cache Wadah Leaderboard
        window.leaderboardCache = {
          "Juara Umum": [],
          "Minyak Jelantah": [],
          Ampas: [],
          Kriuk: [],
          Tepung: [],
          Spinner: [],
        };

        // 3. Agregasi (Kalkulasi) Kumulatif per Mitra selama 1 Bulan
        const aggregatedData = {};

        rekapData.forEach((row) => {
          // Kalau mitra belum ada di object, bikin kerangkanya
          if (!aggregatedData[row.mitra_id]) {
            aggregatedData[row.mitra_id] = {
              id: row.mitra_id,
              nama: row.nama_mitra || "Mitra Lapangan",
              minyak: 0,
              ampas: 0,
              kriuk: 0,
              tepung: 0,
              spinner: 0,
            };
          }
          // Tambahkan nilai dari tiap minggu (W1, W2, dst) ke total bulanan
          // PENTING: Nama kolom disesuaikan dengan tabel rekap_kumulatif_mingguan_mitra (tanpa _kg)
          aggregatedData[row.mitra_id].minyak += Number(
            row.minyak_jelantah || 0,
          );
          aggregatedData[row.mitra_id].ampas += Number(row.ampas || 0);
          aggregatedData[row.mitra_id].kriuk += Number(row.kriuk || 0);
          aggregatedData[row.mitra_id].tepung += Number(row.tepung || 0);
          aggregatedData[row.mitra_id].spinner += Number(row.spinner || 0);
        });

        // 4. Masukkan hasil agregasi ke dalam Cache Leaderboard
        Object.values(aggregatedData).forEach((r) => {
          // Hitung grand total (Juara Umum) secara on-the-fly
          const totalUmum = r.minyak + r.ampas + r.kriuk + r.tepung + r.spinner;

          if (totalUmum > 0)
            window.leaderboardCache["Juara Umum"].push({
              nama: r.nama,
              kg: totalUmum,
              id: r.id,
            });
          if (r.minyak > 0)
            window.leaderboardCache["Minyak Jelantah"].push({
              nama: r.nama,
              kg: r.minyak,
              id: r.id,
            });
          if (r.ampas > 0)
            window.leaderboardCache["Ampas"].push({
              nama: r.nama,
              kg: r.ampas,
              id: r.id,
            });
          if (r.kriuk > 0)
            window.leaderboardCache["Kriuk"].push({
              nama: r.nama,
              kg: r.kriuk,
              id: r.id,
            });
          if (r.tepung > 0)
            window.leaderboardCache["Tepung"].push({
              nama: r.nama,
              kg: r.tepung,
              id: r.id,
            });
          if (r.spinner > 0)
            window.leaderboardCache["Spinner"].push({
              nama: r.nama,
              kg: r.spinner,
              id: r.id,
            });
        });

        // 5. Tampilkan data sesuai tab kategori yang sedang aktif
        window.renderLeaderboardSesuaiFilter();
      } catch (e) {
        console.error("Gagal Generate Leaderboard:", e);
      }
    };

    // Variabel Pencatat Tab Aktif Saat Ini
    window.activeLeaderboardKat = "Juara Umum";

