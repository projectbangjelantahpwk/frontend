---
import GeneralLayout from '../layouts/Layout.astro';
import 'bootstrap-icons/font/bootstrap-icons.css';
---

<GeneralLayout title="Penjualan Olahan - Manajemen Bang Jelantah">
    <style is:global>
        body { display: none; }
    </style>

    <div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Penjualan Olahan</h1>
            <p class="text-gray-600">Manajemen distributor/buyer pabrik dan pencatatan transaksi keluar harian multi-item.</p>
        </div>
    </div>

    <div class="mb-6 border-b border-gray-200 overflow-x-auto hide-scrollbar">
        <div class="flex gap-8 min-w-max">
            <button class="tab-btn active px-4 py-3 font-bold transition border-b-2 border-green-700 text-green-700" data-tab="tab-distributor">
                <i class="bi bi-buildings mr-2"></i> Data Distributor / Buyer
            </button>
            <button class="tab-btn px-4 py-3 font-medium transition border-b-2 border-transparent text-gray-600 hover:text-gray-900" data-tab="tab-riwayat">
                <i class="bi bi-clock-history mr-2"></i> Riwayat Penjualan
            </button>
        </div>
    </div>

    <div id="tab-distributor" class="tab-content block">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-900">Daftar Kontak Pabrik & Distributor</h2>
            <button onclick="window.openModal('modal-tambah-distributor')" class="flex items-center gap-2 px-4 py-2 bg-blue-700 text-white rounded-lg font-medium hover:bg-blue-800 transition shadow-sm">
                <i class="bi bi-plus-circle"></i> Tambah Distributor
            </button>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-6 py-4 text-sm font-bold text-gray-900">Nama Perusahaan / Buyer</th>
                            <th class="px-6 py-4 text-sm font-bold text-gray-900">No. HP</th>
                            <th class="px-6 py-4 text-sm font-bold text-gray-900">Alamat Kirim</th>
                            <th class="px-6 py-4 text-sm font-bold text-gray-900 text-center">Maps</th>
                        </tr>
                    </thead>
                    <tbody id="distributor-tbody" class="divide-y divide-gray-100">
                        <tr><td colspan="4" class="text-center py-4 text-gray-500">Memuat data distributor...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="tab-riwayat" class="tab-content hidden">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-900">Riwayat Transaksi Keluar</h2>
            <button onclick="window.bukaModalPenjualan()" class="flex items-center gap-2 px-4 py-2 bg-green-700 text-white rounded-lg font-medium hover:bg-green-800 transition shadow-sm">
                <i class="bi bi-cart-plus"></i> Catat Penjualan Baru
            </button>
        </div>

        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm mb-6 flex flex-wrap gap-4 items-end">
            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">Mulai Tanggal</label>
                <input type="date" id="filter-start-jual" class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-600">
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-600 mb-1">Sampai Tanggal</label>
                <input type="date" id="filter-end-jual" class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-600">
            </div>
            <button onclick="window.filterTabelPenjualan()" class="bg-gray-800 text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-gray-900">Hitung Total</button>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-4 py-3 text-sm font-bold text-gray-900 whitespace-nowrap">Tanggal</th>
                            <th class="px-4 py-3 text-sm font-bold text-gray-900">Distributor / Buyer</th>
                            <th class="px-4 py-3 text-sm font-bold text-gray-900">Komoditas</th>
                            <th class="px-4 py-3 text-sm font-bold text-gray-900 text-right">Volume</th>
                            <th class="px-4 py-3 text-sm font-bold text-gray-900 text-right">Harga Satuan</th>
                            <th class="px-4 py-3 text-sm font-bold text-gray-900">Servis & Keterangan</th>
                            <th class="px-4 py-3 text-sm font-bold text-gray-900 text-right">Grand Total</th>
                        </tr>
                    </thead>
                    <tbody id="penjualan-tbody" class="divide-y divide-gray-100">
                        <tr><td colspan="7" class="text-center py-4 text-gray-500">Memuat riwayat transaksi...</td></tr>
                    </tbody>
                    <tfoot class="bg-gray-50 border-t border-gray-200 hidden" id="footer-total-jual">
                        <tr>
                            <td colspan="6" class="px-6 py-4 text-sm font-bold text-gray-900 text-right">TOTAL PENDAPATAN TERFILTER:</td>
                            <td class="px-6 py-4 text-lg font-bold text-green-700 text-right" id="text-total-jual">Rp 0</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div id="modal-tambah-distributor" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-[60] p-4 transition-opacity opacity-0">
        <div class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-blue-50">
                <h3 class="font-bold text-lg text-gray-900">Registrasi Distributor Baru</h3>
                <button onclick="window.closeModal('modal-tambah-distributor')" class="text-gray-400 hover:text-gray-900"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="form-distributor" class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Nama Perusahaan / Buyer</label>
                    <input type="text" id="dist_nama" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-blue-600" required>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Nomor Handphone</label>
                    <input type="text" id="dist_hp" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-blue-600" required>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Alamat Gudang / Kantor</label>
                    <textarea id="dist_alamat" rows="2" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-blue-600" required></textarea>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Link Google Maps Location</label>
                    <input type="url" id="dist_gmaps" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-blue-600">
                </div>
                <button type="submit" class="w-full bg-blue-700 text-white font-bold py-3 rounded-xl hover:bg-blue-800 transition mt-2">Daftarkan Buyer</button>
            </form>
        </div>
    </div>

    <div id="modal-tambah-penjualan" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-[60] p-4 transition-opacity opacity-0">
        <div class="bg-white rounded-2xl w-full max-w-lg overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh]">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-green-50 shrink-0">
                <div>
                    <h3 class="font-bold text-lg text-gray-900">Form Transaksi Keluar</h3>
                    <p id="pj-step-indicator" class="text-xs font-bold text-green-700 mt-0.5">Langkah 1 dari 3: Data Pokok</p>
                </div>
                <button onclick="window.closeModal('modal-tambah-penjualan')" class="text-gray-400 hover:text-gray-900"><i class="bi bi-x-lg"></i></button>
            </div>
            
            <form id="form-penjualan" class="p-6 overflow-y-auto flex-1 flex flex-col justify-between">
                
                <div id="pj-step-1" class="flex flex-col gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Tanggal Transaksi</label>
                        <input type="date" id="pj_tgl" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600 font-medium" required>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Distributor / Pembeli</label>
                        <select id="pj_distributor" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600 bg-white font-medium" required>
                            <option value="">-- Memuat... --</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Keterangan Umum (Opsional)</label>
                        <textarea id="pj_keterangan" rows="2" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600" placeholder="Misal: Nomor PO, Catatan Pengiriman, dsb..."></textarea>
                    </div>
                </div>

                <div id="pj-step-2" class="hidden flex-col gap-4">
                    <div class="flex justify-between items-center mb-1">
                        <label class="block text-xs font-bold text-gray-700">Rincian Barang Dijual</label>
                        <button type="button" onclick="window.tambahBarisBarang()" class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded font-bold hover:bg-green-200">+ Tambah Barang</button>
                    </div>
                    
                    <div id="pj-items-container" class="space-y-3">
                        </div>
                </div>

                <div id="pj-step-3" class="hidden flex-col gap-4">
                    <div class="bg-blue-50 p-4 rounded-xl border border-blue-200 shadow-sm">
                        <label class="block text-xs font-bold text-blue-900 mb-1"><i class="bi bi-tools mr-1"></i> Nama Servis (Opsional)</label>
                        <input type="text" id="pj_nama_servis" placeholder="Misal: Jasa Kuli Angkut / Ongkir" class="w-full border border-blue-300 rounded-lg p-2.5 text-sm outline-none focus:border-blue-600 mb-3">
                        
                        <label class="block text-xs font-bold text-blue-900 mb-1">Harga Servis (Rp)</label>
                        <input type="number" id="pj_harga_servis" value="0" class="w-full border border-blue-300 rounded-lg p-2.5 text-sm outline-none focus:border-blue-600 font-mono font-bold" oninput="window.kalkulasiTotalPj()">
                    </div>

                    <div class="bg-gray-900 p-4 rounded-xl text-right mt-2 shadow-sm">
                        <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block mb-1">Grand Total Transaksi</span>
                        <span class="font-bold text-3xl text-green-400 font-mono" id="pj_total_display">Rp 0</span>
                    </div>
                </div>

                <div id="pj-footer-1" class="mt-8 flex justify-end shrink-0">
                    <button type="button" onclick="window.cekDanLanjut(1, 2)" class="w-12 h-12 bg-gray-900 text-white font-bold rounded-xl hover:bg-black transition text-xl flex items-center justify-center shadow-sm active:scale-95">
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
                
                <div id="pj-footer-2" class="mt-8 hidden justify-between items-center shrink-0">
                    <button type="button" onclick="window.navigasiStepPj(1)" class="w-12 h-12 bg-gray-100 text-gray-700 font-bold rounded-xl hover:bg-gray-200 border border-gray-200 transition text-xl flex items-center justify-center active:scale-95">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <button type="button" onclick="window.cekDanLanjut(2, 3)" class="w-12 h-12 bg-gray-900 text-white font-bold rounded-xl hover:bg-black transition text-xl flex items-center justify-center shadow-sm active:scale-95">
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>

                <div id="pj-footer-3" class="mt-8 hidden justify-between items-center shrink-0">
                    <button type="button" onclick="window.navigasiStepPj(2)" class="w-12 h-12 bg-gray-100 text-gray-700 font-bold rounded-xl hover:bg-gray-200 border border-gray-200 transition text-xl flex items-center justify-center active:scale-95">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <button type="submit" id="btn-save-pj" class="w-12 h-12 bg-green-600 text-white font-bold rounded-xl hover:bg-green-700 transition text-xl flex items-center justify-center shadow-sm active:scale-95">
                        <i class="bi bi-floppy-fill"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</GeneralLayout>

<script>
    import { supabase } from '../lib/supabase';
    
    // Supabase Global Setup
    window.supabase = supabase;

    // Variabel Global Opsi Komoditas (Supaya Tidak Error innerHTML Null)
    window.opsiKomoditasHtml = '<option value="">Pilih...</option>';

    document.addEventListener('DOMContentLoaded', async () => {
        const allowedRoles = ['owner', 'hrd', 'keuangan', 'admin'];
        const client = window.supabase; 
        
        const { data: { session } } = await client.auth.getSession();
        if (!session) return window.location.replace('/');
        
        const { data: prof } = await client.from('profiles').select('role').eq('id', session.user.id).single();
        if (!allowedRoles.includes(prof?.role)) {
            alert("Akses Ditolak!");
            return window.location.replace('/');
        }
        document.body.style.display = 'block';

        // ==========================================
        // LOGIKA PINDAH TAB HALAMAN UTAMA
        // ==========================================
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabContents = document.querySelectorAll('.tab-content');

        tabBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const targetId = this.getAttribute('data-tab');
                tabBtns.forEach(b => {
                    b.classList.remove('active', 'border-green-700', 'text-green-700', 'font-bold');
                    b.classList.add('border-transparent', 'text-gray-600', 'font-medium');
                });
                tabContents.forEach(c => {
                    c.classList.remove('block');
                    c.classList.add('hidden');
                });

                this.classList.add('active', 'border-green-700', 'text-green-700', 'font-bold');
                this.classList.remove('border-transparent', 'text-gray-600', 'font-medium');
                document.getElementById(targetId)?.classList.replace('hidden', 'block');
            });
        });

        // ==========================================
        // FETCH DATA & RENDER TABEL (3 TABEL DATABASE)
        // ==========================================
        async function loadDataHalaman() {
            if(!window.supabase) return;
            try {
                // 1. Fetch Distributor
                const { data: dist } = await window.supabase.from('distributor').select('*').order('nama', { ascending: true });
                const tbodyDist = document.getElementById('distributor-tbody');
                let htmlDist = '';
                let optDist = '<option value="">-- Pilih Distributor --</option>';

                dist?.forEach(d => {
                    htmlDist += `
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 text-sm font-bold text-gray-900">${d.nama}</td>
                        <td class="px-6 py-4 text-sm text-gray-600">${d.nomor_hp || '-'}</td>
                        <td class="px-6 py-4 text-sm text-gray-600">${d.alamat || '-'}</td>
                        <td class="px-6 py-4 text-center">
                            ${d.link_gmaps ? `<a href="${d.link_gmaps}" target="_blank" class="text-blue-600 text-xl"><i class="bi bi-geo-alt-fill"></i></a>` : '-'}
                        </td>
                    </tr>`;
                    optDist += `<option value="${d.id}">${d.nama}</option>`;
                });
                if(tbodyDist) tbodyDist.innerHTML = htmlDist || '<tr><td colspan="4" class="text-center py-4 text-gray-500">Kosong.</td></tr>';
                
                // Set Dropdown Distributor
                const distSelect = document.getElementById('pj_distributor');
                if(distSelect) distSelect.innerHTML = optDist;

                // 2. Fetch & Persiapkan Opsi Komoditas ke Memori (Tidak nembak innerHTML ke elemen form utama)
                const { data: kom } = await window.supabase.from('gudang_komoditas').select('id, nama_komoditas');
                kom?.forEach(k => { window.opsiKomoditasHtml += `<option value="${k.id}">${k.nama_komoditas}</option>`; });

                // 3. Fetch Riwayat Penjualan beserta Rincian & Servis (JOIN 3 TABEL)
                const { data: jual, error: errJual } = await window.supabase.from('penjualan_olahan')
                    .select(`
                        *, 
                        distributor(nama), 
                        rincian_penjualan(*, gudang_komoditas(nama_komoditas)),
                        servis_penjualan(*)
                    `)
                    .order('tanggal', { ascending: false });
                
                if (errJual) console.error("Error ambil data penjualan:", errJual);

                const tbodyJual = document.getElementById('penjualan-tbody');
                let htmlJual = '';
                
                jual?.forEach(p => {
                    const buyer = p.distributor?.nama || 'Distributor Dihapus';
                    const items = p.rincian_penjualan || [];
                    const servis = p.servis_penjualan || [];
                    
                    // A. PECAH KOLOM BARANG
                    let htmlNamaKom = ''; let htmlVol = ''; let htmlHarga = '';
                    if (items.length > 0) {
                        items.forEach(i => {
                            const n = i.gudang_komoditas?.nama_komoditas || '-';
                            htmlNamaKom += `<span class="bg-blue-50 text-blue-700 px-2 py-1 rounded text-[11px] font-bold block mb-1.5 w-fit">${n}</span>`;
                            htmlVol += `<div class="text-sm font-medium mb-1.5 h-[26px] flex items-center justify-end">${i.volume} Kg</div>`;
                            htmlHarga += `<div class="text-sm text-gray-600 mb-1.5 h-[26px] flex items-center justify-end">@ Rp ${Number(i.harga_satuan).toLocaleString('id-ID')}</div>`;
                        });
                    } else {
                        htmlNamaKom = '-'; htmlVol = '-'; htmlHarga = '-';
                    }

                    // B. GABUNGKAN DATA SERVIS & KETERANGAN
                    let ketServisHtml = '';
                    servis.forEach(s => {
                        ketServisHtml += `<span class="block text-xs font-bold text-blue-800">${s.nama_servis} (+Rp ${Number(s.harga).toLocaleString('id-ID')})</span>`;
                    });
                    if(p.keterangan) {
                        ketServisHtml += `<span class="block text-xs text-gray-500 italic mt-1 leading-tight">${p.keterangan}</span>`;
                    }
                    if(!ketServisHtml) ketServisHtml = '<span class="text-gray-400">-</span>';

                    htmlJual += `
                    <tr class="hover:bg-gray-50 penjualan-row border-b border-gray-100" data-date="${p.tanggal}" data-total="${p.grand_total}">
                        <td class="px-4 py-3 align-top whitespace-nowrap text-sm font-medium text-gray-600">${p.tanggal}</td>
                        <td class="px-4 py-3 align-top font-bold text-gray-900">${buyer}</td>
                        <td class="px-4 py-3 align-top">${htmlNamaKom}</td>
                        <td class="px-4 py-3 align-top text-right">${htmlVol}</td>
                        <td class="px-4 py-3 align-top text-right">${htmlHarga}</td>
                        <td class="px-4 py-3 align-top">${ketServisHtml}</td>
                        <td class="px-4 py-3 align-top text-sm font-bold text-green-700 text-right whitespace-nowrap">Rp ${Number(p.grand_total).toLocaleString('id-ID')}</td>
                    </tr>`;
                });
                if(tbodyJual) tbodyJual.innerHTML = htmlJual || '<tr><td colspan="7" class="text-center py-4 text-gray-500">Belum ada riwayat transaksi.</td></tr>';

            } catch (err) { console.error(err); }
        }

        await loadDataHalaman();

        // ==========================================
        // KONTROL MODAL & NAVIGASI 3 STEP
        // ==========================================
        window.openModal = function(id) {
            const m = document.getElementById(id); if(!m) return;
            m.classList.remove('hidden'); m.classList.add('flex');
            setTimeout(() => { m.classList.remove('opacity-0'); m.querySelector('div').classList.remove('scale-95'); }, 10);
        }
        window.closeModal = function(id) {
            const m = document.getElementById(id); if(!m) return;
            m.classList.add('opacity-0'); m.querySelector('div').classList.add('scale-95');
            setTimeout(() => { m.classList.add('hidden'); m.classList.remove('flex'); }, 300);
        }

        window.bukaModalPenjualan = function() {
            document.getElementById('pj-items-container').innerHTML = '';
            window.tambahBarisBarang(); // Otomatis nambah 1 baris kosong
            document.getElementById('pj_keterangan').value = '';
            document.getElementById('pj_nama_servis').value = '';
            document.getElementById('pj_harga_servis').value = '0';
            window.navigasiStepPj(1);
            window.openModal('modal-tambah-penjualan');
        }

        window.navigasiStepPj = function(stepNum) {
            const steps = [1, 2, 3];
            steps.forEach(num => {
                document.getElementById(`pj-step-${num}`)?.classList.replace('flex', 'hidden');
                document.getElementById(`pj-footer-${num}`)?.classList.replace('flex', 'hidden');
            });
            document.getElementById(`pj-step-${stepNum}`)?.classList.replace('hidden', 'flex');
            document.getElementById(`pj-footer-${stepNum}`)?.classList.replace('hidden', 'flex');

            const ind = document.getElementById('pj-step-indicator');
            if(stepNum === 1) ind.innerText = "Langkah 1 dari 3: Data Pokok";
            if(stepNum === 2) ind.innerText = "Langkah 2 dari 3: Rincian Barang";
            if(stepNum === 3) ind.innerText = "Langkah 3 dari 3: Servis & Total";
        }

        // ==========================================
        // VALIDASI SEBELUM PINDAH STEP (Wajib Isi)
        // ==========================================
        window.cekDanLanjut = function(currentStep, nextStep) {
            if (currentStep === 1) {
                // Cek isi Tanggal & Distributor
                const tgl = document.getElementById('pj_tgl').value;
                const dist = document.getElementById('pj_distributor').value;
                if (!tgl || !dist) {
                    alert("Harap isi Tanggal Transaksi dan Distributor terlebih dahulu!");
                    return; // Stop di sini, nggak mau pindah halaman
                }
            } 
            else if (currentStep === 2) {
                // Cek isi Keranjang Barang
                const rows = document.querySelectorAll('.pj-item-row');
                if (rows.length === 0) {
                    alert("Minimal harus ada 1 barang yang dijual!");
                    return;
                }
                
                let isLengkap = true;
                rows.forEach(row => {
                    const kom = row.querySelector('.pj-input-komoditas').value;
                    const vol = parseFloat(row.querySelector('.pj-input-vol').value) || 0;
                    const hrg = parseFloat(row.querySelector('.pj-input-hrg').value) || 0;
                    
                    if (!kom || vol <= 0 || hrg <= 0) {
                        isLengkap = false;
                    }
                });

                if (!isLengkap) {
                    alert("Data barang belum lengkap! Pastikan Komoditas dipilih, serta Volume & Harga lebih dari 0.");
                    return;
                }
            }

            // Kalau lolos semua validasi, baru pindah step
            window.navigasiStepPj(nextStep);
        };

        // ==========================================
        // MANAJEMEN BARANG DINAMIS (MEMAKAI OPSI GLOBAL)
        // ==========================================
        window.tambahBarisBarang = function() {
            const container = document.getElementById('pj-items-container');
            const div = document.createElement('div');
            div.className = 'pj-item-row bg-gray-50 border border-gray-200 p-3 rounded-xl flex flex-wrap gap-2 items-end shadow-sm';
            
            // Gunakan window.opsiKomoditasHtml yang sudah ter-fetch tanpa kena innerHTML null error
            div.innerHTML = `
                <div class="flex-1 min-w-[120px]">
                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Komoditas</label>
                    <select class="pj-input-komoditas w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-green-600 bg-white" required>
                        ${window.opsiKomoditasHtml}
                    </select>
                </div>
                <div class="w-[80px]">
                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Vol (Kg)</label>
                    <input type="number" step="0.1" class="pj-input-vol w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-green-600 font-bold" required oninput="window.kalkulasiTotalPj()">
                </div>
                <div class="w-[100px]">
                    <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Harga (Rp)</label>
                    <input type="number" class="pj-input-hrg w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-green-600 font-bold" required oninput="window.kalkulasiTotalPj()">
                </div>
                <button type="button" onclick="this.parentElement.remove(); window.kalkulasiTotalPj();" class="w-8 h-[38px] bg-red-100 text-red-600 rounded flex items-center justify-center hover:bg-red-200 transition">
                    <i class="bi bi-trash"></i>
                </button>
            `;
            container.appendChild(div);
        }

        window.kalkulasiTotalPj = function() {
            let totalBarang = 0;
            document.querySelectorAll('.pj-item-row').forEach(row => {
                const v = parseFloat(row.querySelector('.pj-input-vol').value) || 0;
                const h = parseFloat(row.querySelector('.pj-input-hrg').value) || 0;
                totalBarang += (v * h);
            });
            const hrgServis = parseFloat(document.getElementById('pj_harga_servis').value) || 0;
            const grandTotal = totalBarang + hrgServis;
            document.getElementById('pj_total_display').innerText = `Rp ${grandTotal.toLocaleString('id-ID')}`;
        }

        // ==========================================
        // SUBMIT FORM DISTRIBUTOR
        // ==========================================
        document.getElementById('form-distributor')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.innerText = "Menyimpan..."; btn.disabled = true;
            try {
                await client.from('distributor').insert([{
                    nama: document.getElementById('dist_nama').value,
                    nomor_hp: document.getElementById('dist_hp').value,
                    alamat: document.getElementById('dist_alamat').value,
                    link_gmaps: document.getElementById('dist_gmaps').value || null
                }]);
                alert('Distributor berhasil disimpan!'); window.location.reload();
            } catch(err) { alert(err.message); btn.innerText = "Daftarkan Buyer"; btn.disabled = false; }
        });

        // ==========================================
        // SUBMIT TRANSAKSI PENJUALAN (SEBAR KE 3 TABEL)
        // ==========================================
        document.getElementById('form-penjualan')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btn-save-pj');
            btn.innerHTML = `<i class="bi bi-hourglass-split"></i>`; btn.disabled = true;

            try {
                const tgl = document.getElementById('pj_tgl').value;
                const distId = document.getElementById('pj_distributor').value;
                const ket = document.getElementById('pj_keterangan').value || null;
                
                const namaServis = document.getElementById('pj_nama_servis').value || null;
                const hargaServis = parseFloat(document.getElementById('pj_harga_servis').value) || 0;
                
                // Pungut Rincian Barang
                const itemsToInsert = [];
                let totalBarang = 0;
                const mutasiLog = [];

                document.querySelectorAll('.pj-item-row').forEach(row => {
                    const komId = row.querySelector('.pj-input-komoditas').value;
                    const vol = parseFloat(row.querySelector('.pj-input-vol').value) || 0;
                    const hrg = parseFloat(row.querySelector('.pj-input-hrg').value) || 0;
                    if(komId && vol > 0) {
                        const sub = vol * hrg;
                        totalBarang += sub;
                        itemsToInsert.push({ komoditas_id: komId, volume: vol, harga_satuan: hrg, total_harga: sub });
                        mutasiLog.push({ komId, vol });
                    }
                });

                if(itemsToInsert.length === 0) throw new Error("Minimal masukkan 1 rincian barang!");

                const grandTotal = totalBarang + hargaServis;

                // 1. Simpan Induk Transaksi (ke penjualan_olahan)
                const { data: trxData, error: errTrx } = await client.from('penjualan_olahan').insert([{
                    tanggal: tgl, distributor_id: distId, keterangan: ket, grand_total: grandTotal
                }]).select().single();
                if(errTrx) throw errTrx;

                // 2. Simpan Rincian Barang (ke rincian_penjualan)
                itemsToInsert.forEach(i => i.penjualan_id = trxData.id);
                await client.from('rincian_penjualan').insert(itemsToInsert);

                // 3. Simpan Servis JIKA ADA (ke servis_penjualan)
                if (namaServis && hargaServis > 0) {
                    await client.from('servis_penjualan').insert([{
                        penjualan_id: trxData.id, nama_servis: namaServis, harga: hargaServis
                    }]);
                }

                // 4. Potong Stok Gudang & Catat Mutasi
                for (let log of mutasiLog) {
                    const { data: g } = await client.from('gudang_komoditas').select('stok').eq('id', log.komId).single();
                    await client.from('gudang_komoditas').update({ stok: g.stok - log.vol }).eq('id', log.komId);
                    await client.from('gudang_mutasi').insert([{ jenis_mutasi: 'Keluar', komoditas_id: log.komId, jumlah: -log.vol, keterangan: 'Penjualan ke Distributor' }]);
                }

                alert('Transaksi Sukses Disimpan ke 3 Tabel!'); window.location.reload();
            } catch(err) { alert(err.message); btn.innerHTML = `<i class="bi bi-floppy-fill"></i>`; btn.disabled = false; }
        });

    });
</script>