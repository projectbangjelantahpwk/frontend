              };
            } else if (tableName === "pengeluaran_harian") {
              mappedRow = {
                tanggal:
                  row["Tanggal"] || new Date().toISOString().split("T")[0],
                gaji: parseFloat(row["Gaji"]) || 0,
                makan: parseFloat(row["Makan"]) || 0,
