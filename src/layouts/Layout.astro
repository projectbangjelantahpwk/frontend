        }
      } catch (error) {
        console.error("❌ Error FCM:", error);
      }
    }

    // Simpan token ke database (dengan check duplikasi)
    async function saveFCMTokenToDatabase(token) {
      try {
        const { data: sessionData } = await window.supabase.auth.getSession();
        if (!sessionData?.session?.user?.id) return;

        const userId = sessionData.session.user.id;

        // Cek token lama
        const { data: profile } = await window.supabase
          .from("profiles")
          .select("fcm_token")
          .eq("id", userId)
          .single();

        // Hanya update jika berbeda (HEMAT QUOTA!)
        if (profile?.fcm_token !== token) {
          await window.supabase
            .from("profiles")
            .update({ fcm_token: token })
            .eq("id", userId);
          console.log("✅ Token FCM disimpan ke database");
        }
      } catch (error) {
        console.error("❌ Error save token:", error);
      }
    }

