---
import GeneralLayout from "../layouts/Layout.astro";
import "bootstrap-icons/font/bootstrap-icons.css";

const tabs = [
  { id: "dashboard", label: "Ringkasan Stok", icon: "grid-1x2" },
  { id: "olahan", label: "Manajemen Produksi", icon: "beaker" },
  { id: "kalibrasi", label: "Kalibrasi Stok", icon: "sliders" },
  { id: "riwayat", label: "Riwayat Mutasi", icon: "clock-history" },
  { id: "galon", label: "Kelola Galon", icon: "inbox" },
];
---

<GeneralLayout title="Gudang & Stok - Manajemen Bang Jelantah">
  <style is:global>
    /* Mengunci layar menjadi blank (putih) sampai skrip memberi izin masuk */
    body {
      display: none;
    }
  </style>
  <div
    class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-end gap-4"
  >
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Manajemen Gudang</h1>
      <p class="text-gray-600">
        Pantau penerimaan mitra, proses produksi minyak olahan, dan stok barang.
      </p>
    </div>
  </div>

  <div class="mb-6 border-b border-gray-200 overflow-x-auto hide-scrollbar">
    <div class="flex gap-2 md:gap-8 min-w-max">
      {
        tabs.map((tab, idx) => (
          <button
            class={`tab-button px-4 py-3 font-medium transition border-b-2 whitespace-nowrap ${
              idx === 0
                ? "border-primary text-primary font-bold"
                : "border-transparent text-gray-600 hover:text-gray-900"
            }`}
            data-tab={tab.id}
          >
            <i class={`bi bi-${tab.icon} mr-2`} /> {tab.label}
          </button>
        ))
      }
    </div>
  </div>

  <div id="dashboard-tab" class="tab-content block">
    <div class="mb-8">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        <div
          class="bg-surface-container-lowest rounded-xl p-4 border border-outline-variant shadow-sm flex flex-col justify-between"
        >
          <div class="flex items-center gap-3 mb-3">
            <div
              class="w-10 h-10 rounded-lg bg-orange-50 flex items-center justify-center shrink-0 p-1"
            >
              <img
                src="/icon/6.png"
                alt="Jelantah"
                class="w-full h-full object-contain drop-shadow-sm"
                onerror="this.style.display='none'"
              />
            </div>
            <p class="text-sm font-semibold text-gray-700 leading-tight">
              Minyak Jelantah Kotor
            </p>
          </div>
          <p class="text-3xl font-bold text-gray-900">
            <span id="stok-minyak_jelantah">0.00</span>
            <span class="text-sm font-normal text-gray-500">Kg</span>
          </p>
        </div>

        <div
          class="bg-surface-container-lowest rounded-xl p-4 border border-outline-variant shadow-sm flex flex-col justify-between"
        >
          <div class="flex items-center gap-3 mb-3">
            <div
              class="w-10 h-10 rounded-lg bg-indigo-50 flex items-center justify-center shrink-0 p-1"
            >
              <img
                src="/icon/11.png"
                alt="Minyak Asting"
                class="w-full h-full object-contain drop-shadow-sm"
                onerror="this.style.display='none'"
              />
            </div>
            <p class="text-sm font-semibold text-gray-700 leading-tight">
              Minyak Asting
            </p>
          </div>
          <p class="text-3xl font-bold text-gray-900">
            <span id="stok-minyak_asting">0.00</span>
            <span class="text-sm font-normal text-gray-500">Kg</span>
          </p>
        </div>

        <div
          class="bg-surface-container-lowest rounded-xl p-4 border border-outline-variant shadow-sm flex flex-col justify-between"
        >
          <div class="flex items-center gap-3 mb-3">
            <div
              class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center shrink-0 p-1"
            >
              <img
                src="/icon/8.png"
                alt="Kriuk"
                class="w-full h-full object-contain drop-shadow-sm"
                onerror="this.style.display='none'"
              />
            </div>
            <p class="text-sm font-semibold text-gray-700 leading-tight">
              Kriuk
            </p>
          </div>
          <p class="text-3xl font-bold text-gray-900">
            <span id="stok-kriuk">0.00</span>
            <span class="text-sm font-normal text-gray-500">Kg</span>
          </p>
        </div>

        <div
          class="bg-surface-container-lowest rounded-xl p-4 border border-outline-variant shadow-sm flex flex-col justify-between"
        >
          <div class="flex items-center gap-3 mb-3">
            <div
              class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center shrink-0 p-1"
            >
              <img
                src="/icon/7.png"
                alt="Ampas"
                class="w-full h-full object-contain drop-shadow-sm"
                onerror="this.style.display='none'"
              />
            </div>
            <p class="text-sm font-semibold text-gray-700 leading-tight">
              Ampas
            </p>
          </div>
          <p class="text-3xl font-bold text-gray-900">
            <span id="stok-ampas">0.00</span>
            <span class="text-sm font-normal text-gray-500">Kg</span>
          </p>
        </div>

        <div
          class="bg-surface-container-lowest rounded-xl p-4 border border-outline-variant shadow-sm flex flex-col justify-between"
        >
          <div class="flex items-center gap-3 mb-3">
            <div
              class="w-10 h-10 rounded-lg bg-yellow-50 flex items-center justify-center shrink-0 p-1"
            >
              <img
                src="/icon/9.png"
                alt="Tepung"
                class="w-full h-full object-contain drop-shadow-sm"
                onerror="this.style.display='none'"
              />
            </div>
            <p class="text-sm font-semibold text-gray-700 leading-tight">
              Tepung Ayakan
            </p>
          </div>
          <p class="text-3xl font-bold text-gray-900">
            <span id="stok-tepung">0.00</span>
            <span class="text-sm font-normal text-gray-500">Kg</span>
          </p>
        </div>

        <div
          class="bg-surface-container-lowest rounded-xl p-4 border border-outline-variant shadow-sm flex flex-col justify-between"
        >
          <div class="flex items-center gap-3 mb-3">
            <div
              class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center shrink-0 p-1"
            >
              <img
                src="/icon/10.png"
                alt="Spinner"
                class="w-full h-full object-contain drop-shadow-sm"
                onerror="this.style.display='none'"
              />
            </div>
            <p class="text-sm font-semibold text-gray-700 leading-tight">
              Spinner
            </p>
          </div>
          <p class="text-3xl font-bold text-gray-900">
            <span id="stok-spinner">0.00</span>
            <span class="text-sm font-normal text-gray-500">Kg</span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div id="olahan-tab" class="tab-content hidden">
    <div
      class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm max-w-3xl mx-auto"
    >
      <h3 class="text-xl font-bold text-gray-900 mb-2">
        Formulir Manajemen Produksi
      </h3>
      <p class="text-sm text-gray-500 mb-6">
        Proses pencampuran Minyak Jelantah Kotor, Kriuk, dan Ampas untuk
        menghasilkan Minyak Olahan & Spinner.
      </p>

      <form id="olahanForm" class="space-y-6">
        <div
          class="bg-orange-50 border border-orange-200 p-5 rounded-2xl space-y-4"
        >
          <h4
            class="text-xs font-bold text-orange-950 uppercase tracking-wider flex items-center gap-1"
          >
            <i class="bi bi-box-seam"></i> 1. Bahan Baku Yang Digunakan
          </h4>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-orange-900 mb-1"
                >Minyak Jelantah (Kg)</label
              >
              <input
                type="number"
                step="0.01"
                id="input_minyak_jelantah"
                class="w-full px-3 py-2 border border-orange-300 rounded-lg outline-none bg-white font-bold"
                placeholder="0"
              />
              <span class="text-[10px] text-orange-700 block mt-1"
                >Stok Gudang: <strong id="max_minyak_jelantah">0</strong> Kg</span
              >
            </div>
            <div>
              <label class="block text-xs font-bold text-orange-900 mb-1"
                >Kriuk (Kg)</label
              >
              <input
                type="number"
                step="0.01"
                id="input_kriuk"
                class="w-full px-3 py-2 border border-orange-300 rounded-lg outline-none bg-white font-bold"
                placeholder="0"
              />
              <span class="text-[10px] text-orange-700 block mt-1"
                >Stok Gudang: <strong id="max_kriuk">0</strong> Kg</span
              >
            </div>
            <div>
              <label class="block text-xs font-bold text-orange-900 mb-1"
                >Ampas / Sludge (Kg)</label
              >
              <input
                type="number"
                step="0.01"
                id="input_ampas"
                class="w-full px-3 py-2 border border-orange-300 rounded-lg outline-none bg-white font-bold"
                placeholder="0"
              />
              <span class="text-[10px] text-orange-700 block mt-1"
                >Stok Gudang: <strong id="max_ampas">0</strong> Kg</span
              >
            </div>
          </div>
        </div>

        <div
          class="bg-green-50 border border-green-200 p-5 rounded-2xl space-y-4"
        >
          <h4
            class="text-xs font-bold text-green-950 uppercase tracking-wider flex items-center gap-1"
          >
            <i class="bi bi-stars"></i> 2. Hasil Akhir Produksi
          </h4>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-green-900 mb-1"
                >Minyak Jelantah (Kg)</label
              >
              <input
                type="number"
                step="0.01"
                id="hasil_minyak_jelantah"
                class="w-full px-3 py-2 border border-green-300 rounded-lg outline-none bg-white font-bold text-green-900"
                placeholder="0"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-green-900 mb-1"
                >Hasil Spinner (Kg)</label
              >
              <input
                type="number"
                step="0.01"
                id="hasil_spinner"
                class="w-full px-3 py-2 border border-green-300 rounded-lg outline-none bg-white font-bold text-green-900"
                placeholder="0"
              />
            </div>
          </div>
        </div>

        <div
          class="bg-gray-50 border border-gray-200 p-4 rounded-xl flex justify-between items-center"
        >
          <div>
            <p class="text-sm font-bold text-gray-700">
              Penyusutan / Loss Massa
            </p>
            <p class="text-xs text-gray-500">
              Selisih total bahan baku dengan total hasil produksi
            </p>
          </div>
          <div class="text-right">
            <p id="penyusutanDisplay" class="text-2xl font-bold text-gray-900">
              0 Kg
            </p>
          </div>
        </div>

        <button
          type="submit"
          id="btnSubmitOlahan"
          class="w-full flex items-center justify-center gap-2 px-6 py-4 bg-primary text-white rounded-xl hover:opacity-90 active:scale-95 transition font-bold text-lg shadow-sm"
        >
          <i class="bi bi-gear-fill"></i> Simpan Hasil Produksi
        </button>
      </form>
    </div>
  </div>

  <div id="kalibrasi-tab" class="tab-content hidden">
    <div
      class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm max-w-2xl mx-auto"
    >
      <h3 class="text-xl font-bold text-gray-900 mb-2">Formulir Kalibrasi</h3>
      <p class="text-sm text-gray-500 mb-6">
        Sesuaikan data sistem dengan fisik aslinya (antisipasi error
        timbangan/fraud).
      </p>

      <form id="kalibrasiForm" class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2"
            >Pilih Komoditas</label
          >
          <select
            id="kalibrasiKomoditas"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-primary"
            required
          >
            <option value="">-- Pilih Komoditas --</option>
            <option value="minyak_jelantah" data-stok="0"
              >Minyak Jelantah</option
            >
            <option value="minyak_asting" data-stok="0">Minyak Asting</option>
            <option value="kriuk" data-stok="0">Kriuk</option>
            <option value="ampas">Ampas (Sludge)</option>
            <option value="tepung">Tepung Ayakan</option>
            <option value="spinner" data-stok="0">Spinner</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2"
              >Stok di Sistem</label
            >
            <div class="relative">
              <input
                type="number"
                id="kalibrasiSistem"
                class="w-full px-4 py-3 bg-gray-100 border border-gray-300 rounded-lg text-gray-600 font-bold"
                readonly
              />
              <span class="absolute right-3 top-3 text-gray-500">Kg</span>
            </div>
          </div>
          <div>
            <label class="block text-sm font-bold text-primary mb-2"
              >Stok Fisik Real</label
            >
            <div class="relative">
              <input
                type="number"
                step="0.01"
                id="kalibrasiFisik"
                class="w-full px-4 py-3 border border-primary bg-green-50 rounded-lg font-bold text-gray-900 outline-none"
                placeholder="0"
                required
              />
              <span class="absolute right-3 top-3 text-gray-500">Kg</span>
            </div>
          </div>
        </div>

        <div
          class="bg-gray-50 p-3 rounded-lg flex justify-between items-center"
        >
          <span class="text-sm text-gray-600 font-medium"
            >Selisih Ditemukan:</span
          >
          <span id="kalibrasiSelisih" class="font-bold text-lg text-gray-900"
            >0 Kg</span
          >
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2"
            >Catatan Penyesuaian Wajib</label
          >
          <textarea
            id="kalibrasiCatatan"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-primary"
            rows="2"
            placeholder="Misal: Timbangan error, tumpah, dll..."
            required></textarea>
        </div>

        <button
          type="submit"
          id="btnSubmitKalibrasi"
          class="w-full flex items-center justify-center gap-2 px-6 py-3 bg-yellow-500 text-yellow-900 rounded-xl hover:bg-yellow-400 font-bold transition"
        >
          <i class="bi bi-sliders"></i> Simpan Penyesuaian
        </button>
      </form>
    </div>
  </div>

  <div id="riwayat-tab" class="tab-content hidden">
    <div
      class="bg-white rounded-xl border border-gray-200 p-0 shadow-sm overflow-hidden"
    >
      <div
        class="p-6 border-b border-gray-200 flex justify-between items-center"
      >
        <div>
          <h3 class="text-xl font-bold text-gray-900">Riwayat Mutasi Gudang</h3>
          <p class="text-sm text-gray-500 mt-1">
            Laporan barang masuk, produksi olahan, dan kalibrasi audit.
          </p>
        </div>
      </div>

      <!-- TAMBAHAN: UI Filter Riwayat Mutasi -->
      <div
        class="p-4 border-b border-gray-200 bg-gray-50 flex flex-wrap gap-4 items-end"
      >
        <div>
          <label class="block text-xs font-bold text-gray-600 mb-1"
            >Mulai Tanggal</label
          >
          <input
            type="date"
            id="filter-start-mutasi"
            class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-primary bg-white"
          />
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-600 mb-1"
            >Sampai Tanggal</label
          >
          <input
            type="date"
            id="filter-end-mutasi"
            class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-primary bg-white"
          />
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-600 mb-1"
            >Pilih Komoditas</label
          >
          <select
            id="filter-komoditas-mutasi"
            class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-primary bg-white min-w-40"
          >
            <option value="Semua">Semua Komoditas</option>
            <option value="minyak_jelantah">Minyak Jelantah</option>
            <option value="minyak_asting">Minyak Asting</option>
            <option value="kriuk">Kriuk</option>
            <option value="ampas">Ampas (Sludge)</option>
            <option value="tepung">Tepung Ayakan</option>
            <option value="spinner">Spinner</option>
          </select>
        </div>
        <button
          onclick="window.filterTabelMutasi()"
          class="bg-primary text-white px-4 py-2 rounded-lg text-sm font-bold hover:opacity-90 transition shadow-sm"
        >
          <i class="bi bi-funnel mr-1"></i> Filter Data
        </button>
      </div>
      <!-- BATAS TAMBAHAN UI FILTER -->

      <div
        class="px-6 py-4 bg-blue-50 border-b border-blue-200 flex justify-between items-center"
      >
        <div class="flex items-center gap-2">
          <i class="bi bi-calculator text-blue-700 text-xl"></i>
          <span class="text-sm font-bold text-blue-900 uppercase tracking-wider"
            >Total Akumulasi Filter:</span
          >
        </div>
        <span
          id="total-mutasi-display"
          class="text-2xl font-black text-blue-700">0.00 Kg</span
        >
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left" id="tabel-mutasi">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th
                class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider"
                >Tanggal</th
              >
              <th
                class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider"
                >Jenis</th
              >
              <th
                class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider"
                >Komoditas</th
              >
              <th
                class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-right"
                >Jumlah</th
              >
              <th
                class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider"
                >Keterangan</th
              >
            </tr>
          </thead>
          <tbody id="tabelRiwayat" class="divide-y divide-gray-100">
            <tr
              ><td colspan="5" class="text-center py-4 text-gray-500"
                >Memuat data riwayat...</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- 🔥 FIX: id diubah jadi galon-tab biar tombolnya berfungsi -->
  <div id="galon-tab" class="tab-content hidden space-y-6">
    <div
      class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden"
    >
      <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-bold text-gray-800">
          <i class="bi bi-plus-circle text-primary me-2"></i>Input Data Galon
        </h3>
      </div>
      <div class="p-6">
        <form
          id="galonForm"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 items-end"
        >
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1"
              >Tanggal</label
            >
            <input
              type="date"
              id="galonTanggal"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1"
              >Volume Minyak (Kg)</label
            >
            <input
              type="number"
              step="0.01"
              id="galonVolume"
              required
              placeholder="Contoh: 18.5"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1"
              >Jml Galon</label
            >
            <input
              type="number"
              id="galonJumlah"
              required
              placeholder="Contoh: 1"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary"
            />
          </div>
          <div class="lg:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1"
              >Catatan (Opsional)</label
            >
            <div class="flex gap-2">
              <input
                type="text"
                id="galonCatatan"
                placeholder="Cth: Kondisi bagus..."
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary"
              />
              <button
                type="submit"
                id="btnSubmitGalon"
                class="bg-primary hover:opacity-90 text-white px-4 py-2 rounded-lg font-medium transition-colors whitespace-nowrap"
              >
                Simpan
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <div
      class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden"
    >
      <div
        class="bg-gray-50 px-6 py-4 border-b border-gray-200 flex justify-between items-center"
      >
        <h3 class="text-lg font-bold text-gray-800">
          <i class="bi bi-clock-history text-primary me-2"></i>Riwayat Galon
        </h3>
        <button
          onclick="window.loadGalon()"
          class="text-sm text-primary hover:underline font-medium"
        >
          <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse">
          <thead class="bg-gray-100 border-b border-gray-200 text-gray-600">
            <tr>
              <th class="p-4 font-semibold">Waktu Input</th>
              <th class="p-4 font-semibold">Tanggal Data</th>
              <th class="p-4 font-semibold">Volume (Kg)</th>
              <th class="p-4 font-semibold">Jml Galon</th>
              <th class="p-4 font-semibold">Catatan</th>
            </tr>
          </thead>
          <tbody id="tbodyGalon" class="divide-y divide-gray-100">
            <tr
              ><td colspan="5" class="p-4 text-center text-gray-500"
                >Memuat data...</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </div>
  </div>
</GeneralLayout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", async () => {
    // === 🛡️ GATEKEEPER KEUANGAN ===
    const allowedRoles = ["owner", "hrd", "admin", "keuangan", "it"];
    const client = window.supabase || supabase;

    const {
      data: { session },
    } = await client.auth.getSession();
    if (!session) return window.location.replace("/"); // Tendang kalau belum login

    const { data: prof } = await client
      .from("profiles")
      .select("role")
      .eq("id", session.user.id)
      .single();
    if (!allowedRoles.includes(prof?.role)) {
      alert(
        `Akses Ditolak! Role Anda (${prof?.role || "Guest"}) dilarang masuk ke Keuangan.`,
      );
      return window.location.replace("/");
    }
    document.body.style.display = "block"; // Buka gembok CSS, tampilkan layar!

    // ==============================================================
    // 1A. FETCH DATA STOK GUDANG (Dipanggil sekali saat awal)
    // ==============================================================
    async function loadStokData() {
      if (!window.supabase) return;

      const { data: komoditas, error: errKom } = await window.supabase
        .from("gudang_komoditas")
        .select("*");
      if (!errKom && komoditas) {
        komoditas.forEach((k) => {
          const stokAngka = parseFloat(k.stok || 0);
          const stokFormatted = stokAngka.toFixed(2);

          const elStok = document.getElementById(`stok-${k.id}`);
          if (elStok) elStok.innerText = stokFormatted;

          if (k.id === "minyak_jelantah") {
            const el = document.getElementById("max_minyak_jelantah");
            if (el) el.innerText = stokFormatted;
          }
          if (k.id === "kriuk") {
            const el = document.getElementById("max_kriuk");
            if (el) el.innerText = stokFormatted;
          }
          if (k.id === "ampas") {
            const el = document.getElementById("max_ampas");
            if (el) el.innerText = stokFormatted;
          }

          const opt = document.querySelector(
            `#kalibrasiKomoditas option[value="${k.id}"]`,
          );
          if (opt) opt.setAttribute("data-stok", stokAngka);
        });
      }
    }

    // ==============================================================
    // 1B. FETCH DATA RIWAYAT MUTASI (SERVER-SIDE FILTERING)
    // ==============================================================
    async function loadMutasiData(
      filterStart = null,
      filterEnd = null,
      filterKomoditas = "Semua",
    ) {
      if (!window.supabase) return;

      const tbody = document.getElementById("tabelRiwayat");
      if (tbody)
        tbody.innerHTML =
          '<tr><td colspan="5" class="text-center py-4 text-gray-500 font-medium"><i class="bi bi-hourglass-split mr-2"></i>Memuat data riwayat...</td></tr>';

      // SET DEFAULT: 7 Hari Terakhir jika tidak ada filter tanggal
      let startDate, endDate;

      if (!filterStart || !filterEnd) {
        const today = new Date();
        const lastWeek = new Date();
        lastWeek.setDate(today.getDate() - 7);

        // Format YYYY-MM-DD
        endDate = today.toISOString().split("T")[0] + "T23:59:59.999Z";
        startDate = lastWeek.toISOString().split("T")[0] + "T00:00:00.000Z";
      } else {
        // Jika user memilih tanggal, pastikan mencakup dari jam 00:00 sampai 23:59
        startDate = filterStart + "T00:00:00.000Z";
        endDate = filterEnd + "T23:59:59.999Z";
      }

      // Susun Query Supabase secara Dinamis
      let query = window.supabase
        .from("gudang_mutasi")
        .select("*, gudang_komoditas(nama_komoditas)")
        .gte("tanggal", startDate) // Greater than or equal (Dari tanggal)
        .lte("tanggal", endDate) // Less than or equal (Sampai tanggal)
        .order("tanggal", { ascending: false });

      // Jika user memfilter komoditas spesifik, tambahkan query pencarian
      if (filterKomoditas !== "Semua") {
        query = query.eq("komoditas_id", filterKomoditas);
      }

      // Eksekusi tembakan ke database
      const { data: mutasi, error: errMut } = await query;

      if (!errMut && mutasi) {
        const getBadgeColorJs = (jenis) => {
          if (jenis === "Masuk") return "bg-green-100 text-green-700";
          if (jenis === "Keluar") return "bg-red-100 text-red-700";
          if (jenis === "Olahan") return "bg-blue-100 text-blue-700";
          return "bg-yellow-100 text-yellow-700";
        };

        let html = "";
        let totalMutasi = 0; // 🔥 Bikin wadah untuk ngitung total

        if (mutasi.length === 0) {
          html =
            '<tr><td colspan="5" class="text-center py-4 text-gray-500">Belum ada riwayat mutasi pada periode yang dipilih.</td></tr>';
        } else {
          mutasi.forEach((item) => {
            const tgl = new Date(item.tanggal).toLocaleString("id-ID");
            const badge = getBadgeColorJs(item.jenis_mutasi);
            const namaK = item.gudang_komoditas
              ? item.gudang_komoditas.nama_komoditas
              : item.komoditas_id;

            const sign = item.jumlah > 0 ? "+" : "";
            const colorNum =
              item.jumlah > 0 ? "text-green-600" : "text-red-600";
            const ket = item.keterangan ? item.keterangan : "-";
            const jumlahAsli = parseFloat(item.jumlah || 0);
            const jumlahFormatted = Math.abs(jumlahAsli).toFixed(2); // Pakai Math.abs biar minusnya nggak dobel sama colorNum

            // 🔥 Tambahkan angka ke wadah total
            totalMutasi += jumlahAsli;

            html += `
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 text-sm text-gray-600 whitespace-nowrap">${tgl}</td>
                        <td class="px-6 py-4">
                            <span class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider ${badge}">${item.jenis_mutasi}</span>
                        </td>
                        <td class="px-6 py-4 text-sm font-medium text-gray-900">${namaK}</td>
                        <td class="px-6 py-4 text-sm font-bold text-right ${colorNum}">${sign}${jumlahFormatted} Kg</td>
                        <td class="px-6 py-4 text-sm text-gray-500 max-w-[250px] truncate" title="${ket}">${ket}</td>
                    </tr>
                    `;
          });
        }

        if (tbody) tbody.innerHTML = html;

        // 🔥 UPDATE UI KOTAK TOTAL AKUMULASI 🔥
        const displayTotal = document.getElementById("total-mutasi-display");
        if (displayTotal) {
          const signTotal = totalMutasi > 0 ? "+" : "";
          // Warnanya otomatis: Plus = Hijau, Minus = Merah, Nol = Biru Gelap
          const colorTotal =
            totalMutasi > 0
              ? "text-green-600"
              : totalMutasi < 0
                ? "text-red-600"
                : "text-blue-900";

          displayTotal.className = `text-2xl font-black ${colorTotal}`;
          displayTotal.innerText = `${signTotal}${totalMutasi.toFixed(2)} Kg`;
        }
      } else if (errMut) {
        console.error("Gagal narik mutasi:", errMut.message);
        if (tbody)
          tbody.innerHTML = `<tr><td colspan="5" class="text-center py-4 text-red-500">Gagal memuat data: ${errMut.message}</td></tr>`;
      }
    }

    // Panggil kedua fungsi saat halaman pertama kali dibuka
    loadStokData();
    loadMutasiData();

    // ==============================================================
    // 2. LOGIKA TAB SWITCHING
    // ==============================================================
    const tabButtons = document.querySelectorAll(".tab-button");
    const tabContents = document.querySelectorAll(".tab-content");

    tabButtons.forEach((button) => {
      button.addEventListener("click", function () {
        const tabId = this.getAttribute("data-tab");

        tabButtons.forEach((btn) => {
          btn.classList.remove("border-primary", "text-primary", "font-bold");
          btn.classList.add("border-transparent", "text-gray-600");
        });

        this.classList.remove("border-transparent", "text-gray-600");
        this.classList.add("border-primary", "text-primary", "font-bold");

        tabContents.forEach((content) => content.classList.add("hidden"));
        document.getElementById(`${tabId}-tab`)?.classList.remove("hidden");
      });
    });

    // ==============================================================
    // 1. VARIABEL UI & KALKULASI PENYUSUTAN (Sudah Sinkron dengan HTML)
    // ==============================================================
    const inputMinyakJelantah = document.getElementById(
      "input_minyak_jelantah",
    ); // ID sudah benar!
    const inputKriuk = document.getElementById("input_kriuk");
    const inputAmpas = document.getElementById("input_ampas");
    const hasilMinyakJelantah = document.getElementById(
      "hasil_minyak_jelantah",
    );
    const hasilSpinner = document.getElementById("hasil_spinner");
    const penyusutanDisplay = document.getElementById("penyusutanDisplay");

    function hitungPenyusutan() {
      const minyakjelantah = parseFloat(inputMinyakJelantah.value) || 0;
      const kriuk = parseFloat(inputKriuk.value) || 0;
      const ampas = parseFloat(inputAmpas.value) || 0;

      const jelantah = parseFloat(hasilMinyakJelantah.value) || 0;
      const spinner = parseFloat(hasilSpinner.value) || 0; // Jangan lupa isi ini di form biar loss 0!

      const totalBahan = minyakjelantah + kriuk + ampas;
      const totalHasil = jelantah + spinner;

      const selisih = totalBahan - totalHasil;

      penyusutanDisplay.innerText = selisih.toFixed(2) + " Kg";
      penyusutanDisplay.className =
        selisih < 0
          ? "text-2xl font-bold text-red-600"
          : "text-2xl font-bold text-gray-900";
    }

    [
      inputMinyakJelantah,
      inputKriuk,
      inputAmpas,
      hasilMinyakJelantah,
      hasilSpinner,
    ].forEach((el) => {
      el?.addEventListener("input", hitungPenyusutan);
    });

    // ==============================================================
    // 2. SUBMIT FORM PRODUKSI (Anti-Crash & Kalkulasi Stok Akurat)
    // ==============================================================
    document
      .getElementById("olahanForm")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const supabaseClient = window.supabase;
        if (!supabaseClient) return alert("Supabase tidak terkoneksi!");

        // Tarik semua nilai terbaru dari form
        const minyak_jelantah = parseFloat(inputMinyakJelantah.value) || 0;
        const kriuk = parseFloat(inputKriuk.value) || 0;
        const ampas = parseFloat(inputAmpas.value) || 0;

        const spinner = parseFloat(hasilSpinner.value) || 0;
        const jelantah = parseFloat(hasilMinyakJelantah.value) || 0;
        const loss = parseFloat(penyusutanDisplay.innerText) || 0;

        // 🔥 TAMBAHKAN PENGECEKAN CERDAS DI SINI 🔥
        if (minyak_jelantah === 0 && kriuk === 0 && ampas === 0) {
          return alert(
            "❌ Gagal: Harap masukkan minimal 1 bahan baku yang akan diproses!",
          );
        }

        if (jelantah === 0 && spinner === 0) {
          return alert(
            "❌ Gagal: Harap masukkan minimal 1 hasil produksi akhir (Minyak / Spinner)!",
          );
        }

        // Lanjut ke pengecekan stok maksimal
        const maxMinyakJelantah =
          parseFloat(
            document.getElementById("max_minyak_jelantah").innerText,
          ) || 0;
        const maxKriuk =
          parseFloat(document.getElementById("max_kriuk").innerText) || 0;
        const maxAmpas =
          parseFloat(document.getElementById("max_ampas").innerText) || 0;

        if (minyak_jelantah > maxMinyakJelantah)
          return alert("Kuantitas Minyak Jelantah Kotor melebihi stok gudang!");
        if (kriuk > maxKriuk)
          return alert("Kuantitas Kriuk melebihi stok gudang!");
        if (ampas > maxAmpas)
          return alert("Kuantitas Ampas melebihi stok gudang!");

        const btn = document.getElementById("btnSubmitOlahan");
        btn.innerHTML = "Memproses...";
        btn.disabled = true;

        try {
          // A. Simpan rekam jejak (Pastikan kolom database sesuai)
          // Payload yang BENAR (Sesuai dengan kolom di tabel gudang_olahan)
          const { error: errOlahan } = await supabaseClient
            .from("gudang_olahan")
            .insert([
              {
                bahan_baku_minyak: minyak_jelantah,
                bahan_baku_kriuk: kriuk, // <--- TAMBAHIN BARIS INI BRO!
                bahan_baku_ampas: ampas,
                hasil_minyak_olahan: jelantah,
                hasil_spinner: spinner,
                penyusutan_loss: loss,
                catatan: `Mix: Jelantah(${minyak_jelantah}kg) + Kriuk(${kriuk}kg) + Ampas(${ampas}kg) -> Olahan(${jelantah}kg) & Spinner(${spinner}kg)`,
              },
            ]);
          if (errOlahan)
            throw new Error("Gagal simpan data olahan: " + errOlahan.message);

          const mutasiEntries = [];
          // Fungsi bantu (SUDAH ANTI RACE-CONDITION)
          const updateStok = async (
            id_komoditas,
            qty_perubahan,
            keterangan,
          ) => {
            if (qty_perubahan === 0) return;

            // Langsung tembak RPC, biarkan database yang menghitung secara atomik
            const { error: errUpdate } = await supabaseClient.rpc(
              "update_stok_komoditas",
              {
                p_id: id_komoditas,
                p_qty: qty_perubahan,
              },
            );
            if (errUpdate)
              throw new Error(`Update stok ${id_komoditas} gagal!`);

            mutasiEntries.push({
              jenis_mutasi: "Olahan",
              komoditas_id: id_komoditas,
              jumlah: qty_perubahan,
              keterangan: keterangan,
            });
          };

          // B. Potong bahan baku tambahan
          await updateStok("kriuk", -kriuk, "Bahan Baku Produksi");
          await updateStok("ampas", -ampas, "Bahan Baku Produksi");

          // C. RUMUS PENGGABUNGAN MINYAK (Minyak Hasil - Minyak Kotor)
          const selisihMinyak = jelantah - minyak_jelantah;
          if (selisihMinyak !== 0 || minyak_jelantah > 0 || jelantah > 0) {
            // Langsung eksekusi perubahan matematika di level database
            const { error: errUpdate } = await supabaseClient.rpc(
              "update_stok_komoditas",
              {
                p_id: "minyak_jelantah",
                p_qty: selisihMinyak,
              },
            );
            if (errUpdate)
              throw new Error("Gagal update total stok minyak_jelantah!");

            // Catat riwayat audit
            if (minyak_jelantah > 0)
              mutasiEntries.push({
                jenis_mutasi: "Olahan",
                komoditas_id: "minyak_jelantah",
                jumlah: -minyak_jelantah,
                keterangan: "Bahan Baku (Minyak Kotor)",
              });
            if (jelantah > 0)
              mutasiEntries.push({
                jenis_mutasi: "Olahan",
                komoditas_id: "minyak_jelantah",
                jumlah: jelantah,
                keterangan: "Hasil Olahan (Minyak Bersih)",
              });
          }

          // D. Tambah Stok Spinner
          await updateStok("spinner", spinner, "Hasil Akhir Produksi Spinner");

          // E. Eksekusi semua Mutasi ke Database
          if (mutasiEntries.length > 0) {
            const { error: errMutasi } = await supabaseClient
              .from("gudang_mutasi")
              .insert(mutasiEntries);
            if (errMutasi)
              throw new Error("Gagal catat mutasi: " + errMutasi.message);
          }

          alert("Proses produksi selesai & stok minyak berhasil dikalkulasi!");
          window.location.reload();
        } catch (err) {
          console.error(err);
          alert("Gagal: " + err.message);
          btn.innerHTML = `<i class="bi bi-gear-fill"></i> Simpan Hasil Produksi`;
          btn.disabled = false;
        }
      });

    // ==============================================================
    // 4. LOGIKA FORM: INPUT MANUAL SPINNER
    // ==============================================================
    document
      .getElementById("spinnerForm")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const inputQty = parseFloat(
          document.getElementById("input_spinner_qty").value,
        );
        if (!inputQty || inputQty <= 0)
          return alert("Masukkan jumlah yang valid!");

        const btn = document.getElementById("btnSubmitSpinner");
        btn.innerHTML = "Menyimpan...";
        btn.disabled = true;

        try {
          // Langsung pakai RPC untuk input manual
          const { error: errUpdate } = await window.supabase.rpc(
            "update_stok_komoditas",
            {
              p_id: "spinner",
              p_qty: inputQty,
            },
          );
          if (errUpdate) throw new Error(errUpdate.message);

          await window.supabase.from("gudang_mutasi").insert([
            {
              jenis_mutasi: "Masuk",
              komoditas_id: "spinner",
              jumlah: inputQty,
              keterangan: "Input manual stok tambahan.",
            },
          ]);

          alert("Stok Spinner berhasil ditambahkan!");
          window.location.reload();
        } catch (err) {
          alert("Gagal menyimpan Spinner: " + err.message);
          btn.innerHTML = `<i class="bi bi-arrow-down-circle-fill"></i> Masukkan ke Gudang`;
          btn.disabled = false;
        }
      });

    // ==============================================================
    // 5. LOGIKA FORM: KALIBRASI STOK
    // ==============================================================
    const selectK = document.getElementById("kalibrasiKomoditas");
    const inputSistem = document.getElementById("kalibrasiSistem");
    const inputFisik = document.getElementById("kalibrasiFisik");
    const textSelisih = document.getElementById("kalibrasiSelisih");

    selectK?.addEventListener("change", function () {
      const opt = this.options[this.selectedIndex];
      inputSistem.value = opt.getAttribute("data-stok") || 0;
      inputFisik.value = "";
      textSelisih.innerText = "0 Kg";
    });

    inputFisik?.addEventListener("input", function () {
      const sis = parseFloat(inputSistem.value) || 0;
      const fis = parseFloat(this.value) || 0;
      const selisih = fis - sis;
      textSelisih.innerText =
        (selisih > 0 ? "+" : "") + selisih.toFixed(2) + " Kg";
      textSelisih.className =
        selisih < 0
          ? "font-bold text-lg text-red-600"
          : "font-bold text-lg text-green-600";
    });

    document
      .getElementById("kalibrasiForm")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const komoditas_id = selectK.value;
        const selisih =
          (parseFloat(inputFisik.value) || 0) -
          (parseFloat(inputSistem.value) || 0);
        const catatan = document.getElementById("kalibrasiCatatan").value;

        if (selisih === 0)
          return alert("Tidak ada selisih, kalibrasi tidak diperlukan.");

        document.getElementById("btnSubmitKalibrasi").innerHTML =
          "Menyimpan...";

        try {
          await window.supabase
            .from("gudang_komoditas")
            .update({ stok: parseFloat(inputFisik.value) })
            .eq("id", komoditas_id);

          await window.supabase.from("gudang_mutasi").insert([
            {
              jenis_mutasi: "Kalibrasi",
              komoditas_id: komoditas_id,
              jumlah: selisih,
              keterangan: "Penyesuaian (Kalibrasi): " + catatan,
            },
          ]);

          alert("Kalibrasi stok berhasil!");
          window.location.reload();
        } catch (err) {
          alert("Gagal kalibrasi: " + err.message);
          document.getElementById("btnSubmitKalibrasi").innerHTML =
            `<i class="bi bi-sliders"></i> Simpan Penyesuaian`;
        }
      });

    // -----------------------------------------
    // 🔥 LOGIKA TATA KELOLA GALON
    // -----------------------------------------

    window.loadGalon = async () => {
      const tbody = document.getElementById("tbodyGalon");
      if (!tbody) return;

      try {
        const { data, error } = await window.supabase
          .from("tata_kelola_jerigen") // DB tetap aman
          .select("*")
          .order("created_at", { ascending: false })
          .limit(50);

        if (error) throw error;

        if (data && data.length > 0) {
          tbody.innerHTML = data
            .map(
              (item) => `
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="p-4 text-gray-500 whitespace-nowrap">${new Date(item.created_at).toLocaleString("id-ID")}</td>
                        <td class="p-4 font-medium whitespace-nowrap">${item.tanggal}</td>
                        <td class="p-4 text-green-700 font-bold bg-green-50/50">${item.volume_minyak_kg} Kg</td>
                        <td class="p-4">
                            <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-xs font-bold border border-blue-200">
                                ${item.jumlah_jerigen} Pcs
                            </span>
                        </td>
                        <td class="p-4 text-gray-600 min-w-[200px]">${item.catatan || "-"}</td>
                    </tr>
                `,
            )
            .join("");
        } else {
          tbody.innerHTML =
            '<tr><td colspan="5" class="p-6 text-center text-gray-500 italic">Belum ada riwayat galon.</td></tr>';
        }
      } catch (err) {
        console.error("Error load galon:", err);
        tbody.innerHTML =
          '<tr><td colspan="5" class="p-6 text-center text-red-500">Gagal memuat data.</td></tr>';
      }
    };

    const inputTglGalon = document.getElementById("galonTanggal");
    if (inputTglGalon)
      inputTglGalon.value = new Date().toISOString().split("T")[0];

    document
      .getElementById("galonForm")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitGalon");
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i>...';
        btn.disabled = true;

        try {
          const {
            data: { session },
            error: authErr,
          } = await window.supabase.auth.getSession();
          if (authErr || !session)
            throw new Error("Gagal mengambil sesi. Pastikan Anda sudah login.");

          const user_id = session.user.id;
          const tanggal = document.getElementById("galonTanggal").value;
          const volume_minyak_kg = parseFloat(
            document.getElementById("galonVolume").value,
          );
          const jumlah_jerigen = parseInt(
            document.getElementById("galonJumlah").value,
          ); // DB tetap aman pakai kolom lama
          const catatan = document.getElementById("galonCatatan").value;

          const { error } = await window.supabase
            .from("tata_kelola_jerigen")
            .insert([
              { user_id, tanggal, volume_minyak_kg, jumlah_jerigen, catatan },
            ]);

          if (error) throw error;

          alert("Data Galon berhasil disimpan!");

          document.getElementById("galonForm").reset();
          document.getElementById("galonTanggal").value = new Date()
            .toISOString()
            .split("T")[0];
          window.loadGalon();
        } catch (err) {
          console.error("Error insert galon:", err);
          alert("Gagal menyimpan data: " + err.message);
        } finally {
          btn.innerHTML = "Simpan";
          btn.disabled = false;
        }
      });

    // Jalankan auto-load saat buka halaman
    window.loadGalon();
    // ==============================================================
    // FUNGSI TRIGGER TOMBOL FILTER (SERVER-SIDE)
    // ==============================================================
    window.filterTabelMutasi = function () {
      const start = document.getElementById("filter-start-mutasi").value;
      const end = document.getElementById("filter-end-mutasi").value;
      const filterKomoditas = document.getElementById(
        "filter-komoditas-mutasi",
      ).value;

      // Peringatan jika user hanya mengisi salah satu tanggal (awal atau akhir saja)
      if ((start && !end) || (!start && end)) {
        return alert(
          "Pilih tanggal awal dan akhir untuk filter waktu, atau kosongkan keduanya jika ingin mencari komoditas dalam 7 hari terakhir!",
        );
      }

      // Tembak ulang ke Supabase menggunakan parameter filter
      loadMutasiData(start, end, filterKomoditas);
    };
  });
</script>
