          const nominal = akumulasiPotonganLain[namaItem];
          htmlPotonganDinamis += `<tr>
            <td style="color: #dc2626;">${namaItem} (Akumulasi)</td>
            <td style="text-align: right; color: #dc2626;">Rp ${nominal.toLocaleString("id-ID")}</td>
          </tr>`;
        });

        document.getElementById("slip-pot-dinamis").innerHTML =
          htmlPotonganDinamis;
        document.getElementById("slip-pot-total").innerText =
          `Rp ${grandTotalPotongan.toLocaleString("id-ID")}`;

        // ==========================================
        // 🔥 TAHAP 2: RENDER KE CANVAS & DOWNLOAD
        // ==========================================

        // 3️⃣ Jurus Kloning Mutlak (Bypass ukuran 0x0 & div hidden)
        const originalEl = document.getElementById(
          "template-slip-potongan-gambar",
        );
        if (!originalEl)
          return alert(
