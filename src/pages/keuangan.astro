        const periodeSekarang = new Date().toISOString().split('T')[0]; //YYYY-MM-DD
        
        try {
            // Cek apakah draf slip gaji untuk bulan ini sudah ada
            const { data: draft, error: errCek } = await window.supabase.from('slip_gaji')
                .select('id').eq('user_id', empId).eq('periode', periodeSekarang).eq('status', 'Menunggu').maybeSingle();
            
            if (errCek) throw errCek;

            if (draft) {
                // Kalau Draf sudah ada, update kolom uang_jalan
                const { error: errUpd } = await window.supabase.from('slip_gaji')
                    .update({ uang_jalan: uangJalan }).eq('id', draft.id);
                if (errUpd) throw errUpd;
            } else {
                // Kalau belum, bikin draf slip baru (KOLOM POTONGAN DIHAPUS TOTAL)
                const { error: errIns } = await window.supabase.from('slip_gaji').insert([{
                    user_id: empId,
                    periode: periodeSekarang,
                    uang_jalan: uangJalan,
                    status: 'Menunggu',
                    gaji_karyawan: 0, tunjangan: 0, total_diterima: 0 
                }]);
                if (errIns) throw errIns;
            }
            
            alert('Uang jalan berhasil disimpan ke Draf Slip Gaji!');
            window.location.reload(); 
        } catch (err) { 
            alert('Gagal menyimpan uang jalan: ' + err.message); 
        }
    };

    // EKSEKUSI PEMBAYARAN GAJI KE DATABASE
    window.prosesBayarGaji = async function() {
        if(!confirm('Anda yakin ingin menyetujui dan merekap gaji ini ke database?')) return;
        
        const d = window.currentSalaryData;
        const btn = document.getElementById('btn-bayar-gaji');
        btn.innerHTML = "Memproses..."; btn.disabled = true;
        const periodeSekarang = new Date().toISOString().split('T')[0]; // Format: YYYY-MM--DD

        try {
            // Struktur data final yang dikirim (BEBAS DARI KOLOM POTONGAN)
            const slipDataFinal = {
                user_id: d.empId,
                periode: periodeSekarang,
                gaji_karyawan: (d.totalNormalJam * d.tarifNormal),
                tunjangan: d.totalPengeluaranKar + (d.tepatWaktuCount * d.bonusTepatWaktu) + (d.totalLemburJam * d.tarifLembur) + (document.getElementById('m_check_bonus_mingguan').checked ? d.bonusMingguanVal : 0) + d.uangKesehatan,
                uang_jalan: d.potonganJalan, 
                total_diterima: d.grandTotal,
                status: 'ACC' 
            };

            const { data: draft, error: errDraft } = await window.supabase.from('slip_gaji')
                .select('id').eq('user_id', d.empId).eq('periode', periodeSekarang).eq('status', 'Menunggu').maybeSingle();
            
            if (errDraft) throw errDraft;

            if (draft) {
                const { error: errFinalUpd } = await window.supabase.from('slip_gaji').update(slipDataFinal).eq('id', draft.id);
                if (errFinalUpd) throw errFinalUpd;
            } else {
                const { error: errFinalIns } = await window.supabase.from('slip_gaji').insert([slipDataFinal]);
                if (errFinalIns) throw errFinalIns;
            }

            alert('Gaji berhasil dibayar dan direkap ke Riwayat!');
            window.location.reload();
        } catch (err) {
            alert('Gagal merekap gaji: ' + err.message);
            btn.innerHTML = `<i class="bi bi-check2-circle mr-2"></i> Setujui & Bayar Gaji`;
            btn.disabled = false;
        }
    };

    // FILTER TANGGAL PEMBELIAN & PENGELUARAN
    window.filterTabelPengeluaran = function() {
        const start = document.getElementById('filter-start-pengeluaran').value;
        const end = document.getElementById('filter-end-pengeluaran').value;
        if(!start || !end) return alert("Pilih tanggal awal dan akhir!");

        document.querySelectorAll('#tabel-pembelian tbody tr').forEach(tr => {
            const date = tr.getAttribute('data-date');
            if(date) tr.style.display = (date >= start && date <= end) ? '' : 'none';
        });

        document.querySelectorAll('#tabel-pengeluaran tbody tr').forEach(tr => {
            const date = tr.getAttribute('data-date');
            if(date) tr.style.display = (date >= start && date <= end) ? '' : 'none';
        });
    };

    // APPROVE/REJECT PENGELUARAN KARYAWAN
    window.approvePengeluaran = async function(id, statusText) {
        if(!confirm(`Yakin ingin mengubah status menjadi ${statusText}?`)) return;
        if(!window.supabase) return;
        try {
            await window.supabase.from('pengeluaran').update({ status_approval: statusText }).eq('id', id);
            window.location.reload();
        } catch (err) { alert(err.message); }
    };

    // VALIDASI PEMBAYARAN MITRA LUNAS
    window.validasiBayar = async function(trxId) {
        if(!confirm('Tandai transaksi ini sudah dibayar LUNAS?')) return;
        if(!window.supabase) return;
        try {
            await window.supabase.from('transaksi').update({ is_paid_by_admin: true }).eq('id', trxId);
            window.location.reload();
        } catch (err) { alert(err.message); }
    };

    // ==========================================
    // 4. PENJUALAN OLAHAN FORM
    // ==========================================
    const pjVol = document.getElementById('pj_volume');
    const pjHarga = document.getElementById('pj_harga');
    const pjTotalDisplay = document.getElementById('pj_total_display');

    function calcTotalPj() {
        const vol = parseFloat(pjVol.value) || 0;
        const hrg = parseFloat(pjHarga.value) || 0;
        pjTotalDisplay.innerText = `Total: Rp ${(vol * hrg).toLocaleString('id-ID')}`;
    }
    pjVol?.addEventListener('input', calcTotalPj);
    pjHarga?.addEventListener('input', calcTotalPj);

    document.getElementById('form-penjualan')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if(!window.supabase) return;
        
        const btnSubmit = e.target.querySelector('button[type="submit"]');
        btnSubmit.innerText = "Memproses...";
        btnSubmit.disabled = true;

        try {
            const vol = parseFloat(pjVol.value);
            const hrg = parseFloat(pjHarga.value);
            const total = vol * hrg;
            const k_id = document.getElementById('pj_komoditas').value;

            await window.supabase.from('penjualan_olahan').insert([{
                tanggal: document.getElementById('pj_tgl').value,
                pembeli: document.getElementById('pj_pembeli').value,
                komoditas_id: k_id,
                volume: vol,
                harga_satuan: hrg,
                total_harga: total
            }]);

            const { data: gudang } = await window.supabase.from('gudang_komoditas').select('stok').eq('id', k_id).single();
            await window.supabase.from('gudang_komoditas').update({ stok: gudang.stok - vol }).eq('id', k_id);
            
            await window.supabase.from('gudang_mutasi').insert([{
                jenis_mutasi: 'Keluar', komoditas_id: k_id, jumlah: -vol, keterangan: 'Penjualan ke ' + document.getElementById('pj_pembeli').value
            }]);

            alert('Penjualan berhasil dicatat & stok terpotong!');
            window.location.reload();
        } catch(err) { 
            alert(err.message); 
            btnSubmit.innerText = "Simpan Penjualan";
            btnSubmit.disabled = false;
        }
    });

    // FILTER PENJUALAN & TOTAL
    window.filterTabelPenjualan = function() {
        const start = document.getElementById('filter-start-jual').value;
        const end = document.getElementById('filter-end-jual').value;
        if(!start || !end) return alert("Pilih tanggal awal dan akhir!");

        let grandTotal = 0;
        document.querySelectorAll('.penjualan-row').forEach(tr => {
            const date = tr.getAttribute('data-date');
            if (date >= start && date <= end) {
                tr.style.display = '';
                grandTotal += parseFloat(tr.getAttribute('data-total') || 0);
            } else {
                tr.style.display = 'none';
            }
        });

        const footer = document.getElementById('footer-total-jual');
        if(footer) {
            footer.classList.remove('hidden');
            document.getElementById('text-total-jual').innerText = `Rp ${grandTotal.toLocaleString('id-ID')}`;
        }
    };
  });
  // ====================================================================
    // PERBAIKAN: FUNGSI UNTUK MENAMPILKAN RIWAYAT GAJI (SLIP GAJI)
    // ====================================================================
    async function muatRiwayatGaji() {
        const container = document.getElementById('riwayat-gaji-container');
        if (!container) return;

        const start = document.getElementById('filter-gaji-start')?.value || awalTahun;
        const end = document.getElementById('filter-gaji-end')?.value || hariIni;

        // Bikin Kunci Cache Unik berdasarkan rentang tanggal
        const cacheKey = `riwayat_gaji_${start}_${end}`;
        const cachedData = localStorage.getItem(cacheKey);

        // FUNGSI RENDER (Dipisah biar bisa dipakai 2x: oleh Cache dan oleh Database)
        const renderHTML = (dataGaji) => {
            if (!dataGaji || dataGaji.length === 0) {
                container.innerHTML = `<p class="text-gray-500 text-sm italic py-4">Tidak ada riwayat pengeluaran gaji dari tanggal ${start} sampai ${end}.</p>`;
                return;
            }

            container.innerHTML = dataGaji.map(slip => {
                const isACC = slip.status === 'ACC' || slip.status_persetujuan === 'ACC';
                const inisial = slip.profiles?.nama ? slip.profiles.nama.substring(0, 2).toUpperCase() : 'KY';

                // Avatar pakai Foto Profil jika ada
                const avatarKomponen = slip.profiles?.foto_profil 
                    ? `<img src="${slip.profiles.foto_profil}" class="w-10 h-10 rounded-full object-cover border border-gray-200 shrink-0" />`
                    : `<div class="w-10 h-10 rounded-full bg-gray-100 border border-gray-200 flex items-center justify-center text-gray-600 font-bold text-xs shrink-0">${inisial}</div>`;

                return `
                    <div class="p-4 border border-gray-200 rounded-xl mb-3 bg-white shadow-sm flex gap-3 items-center">
                        ${avatarKomponen}
                        <div class="flex-1">
                            <div class="flex justify-between items-center">
                                <div>
                                    <p class="font-bold text-gray-900">${slip.profiles?.nama || 'Karyawan'}</p>
                                    <p class="text-xs text-gray-500">Periode: ${slip.periode || '-'}</p>
                                </div>
                                <span class="px-2 py-1 rounded text-xs font-bold ${isACC ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800'}">
                                    ${slip.status || 'Menunggu'}
                                </span>
                            </div>

                            ${isACC ? `
                                <div class="mt-2 text-xs space-y-1 border-t pt-2 border-dashed border-gray-300">
                                    <div class="flex justify-between"><span>Gaji Pokok:</span> <span>Rp ${Number(slip.gaji_karyawan || 0).toLocaleString('id-ID')}</span></div>
                                    <div class="flex justify-between"><span>Tunjangan:</span> <span>Rp ${Number(slip.tunjangan || 0).toLocaleString('id-ID')}</span></div>
                                    <div class="flex justify-between text-red-600"><span>Potongan Uang Jalan:</span> <span>-Rp ${Number(slip.uang_jalan || 0).toLocaleString('id-ID')}</span></div>
                                    <div class="flex justify-between font-bold text-green-700 mt-1 pt-1 border-t">
                                        <span>Total Pengeluaran (ACC):</span> 
                                        <span>Rp ${Number(slip.total_diterima || 0).toLocaleString('id-ID')}</span>
                                    </div>
                                </div>
                            ` : `
                                <div class="mt-2 text-xs text-amber-700 italic border-t pt-2 border-dashed border-gray-300">
                                    * Rincian disembunyikan sampai status disetujui (ACC).
                                </div>
                            `}
                        </div>
                    </div>
                `;
            }).join('');
        };

        // LANGKAH 1: Tampilkan Cache Lokal Langsung (Instan 0 Detik)
        if (cachedData) {
            renderHTML(JSON.parse(cachedData));
        } else {
            // Kalau cache bener-bener kosong, baru munculin teks loading
            container.innerHTML = '<p class="text-gray-500 text-sm italic animate-pulse">Memuat data riwayat gaji...</p>';
        }

        // LANGKAH 2: Tarik Data Fresh dari Supabase secara Diam-diam (Background)
        try {
            const { data: dataGaji, error } = await supabase
                .from('slip_gaji')
                .select(`*, profiles!inner(nama, role, foto_profil)`)
                .neq('profiles.role', 'owner')
                .gte('created_at', `${start} 00:00:00`)
                .lte('created_at', `${end} 23:59:59`)
                .order('created_at', { ascending: false });

            if (error) throw error;

            // Update Cache lokal dengan data terbaru dari database
            localStorage.setItem(cacheKey, JSON.stringify(dataGaji));
            
            // Render ulang layar dengan data paling fresh
            renderHTML(dataGaji);

        } catch (error) {
            console.error("Supabase Error:", error);
            
            // Kalau lagi offline dan gak ada cache sama sekali, baru munculin error merah
            if (!cachedData) {
                container.innerHTML = `
                    <div class="p-4 bg-red-50 text-red-700 rounded-xl text-xs">
                        <p class="font-bold">Gagal sinkronisasi data dengan server:</p>
                        <p class="italic mt-1">${error.message}</p>
                    </div>
                `;
            }
        }
    }
    document.getElementById('btn-filter-gaji')?.addEventListener('click', muatRiwayatGaji);
</script>