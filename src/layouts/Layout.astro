    });

    // ==========================================
    // 3️⃣ FUNGSI MAINKAN SUARA NOTIFIKASI
    // ==========================================
    function playNotificationSound() {
      try {
        // Coba pakai audio file dulu
        const audio = new Audio("/sound/notification.mp3");
        audio.volume = 1.0;
        audio.play().catch(() => {
          // Fallback ke Web Audio jika file tidak ada
          playWebAudioBeep();
        });
      } catch (error) {
        playWebAudioBeep();
      }
    }

    // Web Audio API Beep sebagai fallback
    function playWebAudioBeep() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();

        // Beep 1
        const osc1 = ctx.createOscillator();
        const gain1 = ctx.createGain();
        osc1.connect(gain1);
        gain1.connect(ctx.destination);
        osc1.frequency.value = 1000;
        osc1.type = "square";
        gain1.gain.setValueAtTime(0.5, ctx.currentTime);
        gain1.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.2);
        osc1.start(ctx.currentTime);
        osc1.stop(ctx.currentTime + 0.2);

        // Beep 2 (delay)
        const osc2 = ctx.createOscillator();
        const gain2 = ctx.createGain();
        osc2.connect(gain2);
        gain2.connect(ctx.destination);
        osc2.frequency.value = 1200;
        osc2.type = "square";
        gain2.gain.setValueAtTime(0.5, ctx.currentTime + 0.25);
        gain2.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.45);
        osc2.start(ctx.currentTime + 0.25);
        osc2.stop(ctx.currentTime + 0.45);
      } catch (error) {
        console.warn("Suara tidak bisa diputar:", error);
      }
    }

