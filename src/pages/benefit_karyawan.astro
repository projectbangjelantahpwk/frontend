---
import GeneralLayout from '../layouts/Layout.astro';
import 'bootstrap-icons/font/bootstrap-icons.css';
---
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.default.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js" is:inline></script>
<GeneralLayout title="Benefit & Suplemen - Manajemen Bang Jelantah">
    <style is:global>
        /* Mengunci layar sampai verifikasi role beres */
        body { display: none; }
    </style>

    <div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Benefit & Suplemen Karyawan</h1>
            <p class="text-gray-600">Kelola paket nutrisi/suplemen harian dan catat riwayat distribusinya.</p>
        </div>
    </div>

    <div class="mb-6 border-b border-gray-200 overflow-x-auto hide-scrollbar">
        <div class="flex gap-8 min-w-max">
            <button class="tab-btn active px-4 py-3 font-medium transition border-b-2 border-green-700 text-green-700" data-tab="paket">
                <i class="bi bi-box2-heart mr-2"></i> Manajemen Paket
            </button>
            <button class="tab-btn px-4 py-3 font-medium transition border-b-2 border-transparent text-gray-600 hover:text-gray-900" data-tab="riwayat">
                <i class="bi bi-clock-history mr-2"></i> Riwayat Distribusi
            </button>
        </div>
    </div>

    <div id="paket" class="tab-content block">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-900">Daftar Paket Tersedia</h2>
            <button onclick="window.bukaModalPaket()" class="bg-green-700 text-white font-bold px-4 py-2.5 rounded-xl hover:bg-green-800 transition shadow-sm flex items-center gap-2 text-sm">
                <i class="bi bi-plus-lg text-lg"></i> Buat Paket Baru
            </button>
        </div>
        
        <div id="paket-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <p class="text-gray-500 italic py-4">Memuat data paket...</p>
        </div>
    </div>

    <!-- TAB 2: RIWAYAT DISTRIBUSI -->
    <div id="riwayat" class="tab-content hidden">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- FORM CATAT PENGAMBILAN -->
            <div class="lg:col-span-1 bg-white rounded-2xl border border-gray-200 shadow-sm p-6 h-fit">
                <h3 class="text-lg font-bold text-gray-900 mb-4 border-b border-gray-100 pb-2">Catat Pengambilan</h3>
                <form id="form-riwayat" onsubmit="window.simpanRiwayat(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Tanggal Diambil</label>
                        <input type="date" id="r_tanggal" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600 font-medium" required>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Pilih Karyawan</label>
                        <select id="r_karyawan" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600 bg-white" required>
                            <option value="">-- Memuat Karyawan... --</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Pilih Paket Suplemen</label>
                        <select id="r_paket" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600 bg-white" required>
                            <option value="">-- Memuat Paket... --</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Catatan (Opsional)</label>
                        <input type="text" id="r_catatan" placeholder="Misal: Diambil titip tim lapangan" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600">
                    </div>
                    <div class="pt-2">
                        <button type="submit" id="btn-save-riwayat" class="w-full bg-green-700 text-white font-bold py-3.5 rounded-xl hover:bg-green-800 transition shadow-sm uppercase tracking-wide text-sm">
                            <i class="bi bi-send mr-1"></i> Simpan Catatan
                        </button>
                    </div>
                </form>
            </div>

            <!-- DAFTAR RIWAYAT TABEL -->
            <div class="lg:col-span-2 bg-white rounded-2xl border border-gray-200 shadow-sm p-6 flex flex-col">
                <h3 class="text-lg font-bold text-gray-900 mb-4 border-b border-gray-100 pb-2">Riwayat Distribusi Suplemen</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead>
                            <tr class="bg-gray-50 text-gray-600 font-bold border-b border-gray-200">
                                <th class="p-3 rounded-tl-lg">Tanggal</th>
                                <th class="p-3">Karyawan</th>
                                <th class="p-3">Paket Diambil</th>
                                <th class="p-3 text-center rounded-tr-lg">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-riwayat" class="divide-y divide-gray-100">
                            <tr><td colspan="4" class="p-4 text-center text-gray-500 italic">Memuat data...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
        </div>
    </div>
</GeneralLayout>

<div id="modal-paket" class="fixed inset-0 bg-black/60 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0 backdrop-blur-sm">
    <div class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh] shadow-2xl">
        <div class="p-5 border-b border-gray-100 flex justify-between items-center bg-green-50 shrink-0">
            <div>
                <h3 id="modal-title-paket" class="font-bold text-lg text-green-900">Buat Paket Suplemen Baru</h3>
                <p class="text-[10px] font-bold text-green-700 uppercase tracking-wider">Kombinasi nutrisi mandiri</p>
            </div>
            <button type="button" onclick="window.closeModal('modal-paket')" class="text-green-400 hover:text-green-900"><i class="bi bi-x-lg"></i></button>
        </div>
        
        <form id="form-paket" onsubmit="window.simpanPaket(event)" class="p-6 space-y-4 overflow-y-auto">
            <input type="hidden" id="edit_paket_id" value="">
            
            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Nama Paket</label>
                <input type="text" id="p_nama" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600 font-bold" required placeholder="Contoh: Paket Sehat A">
            </div>
            
            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Isi / Deskripsi Paket</label>
                <textarea id="p_deskripsi" rows="3" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-green-600" required placeholder="Contoh: 1 Kotak Susu + 2 Buah Apel"></textarea>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Foto Paket (Opsional)</label>
                <div id="dropZonePaket" class="relative border-2 border-dashed border-gray-300 rounded-xl p-6 text-center cursor-pointer hover:border-green-600 hover:bg-green-50 transition bg-gray-50 overflow-hidden h-40 flex flex-col items-center justify-center">
                    
                    <div id="dropZonePlaceholder">
                        <i class="bi bi-cloud-upload text-3xl text-gray-400 mb-2 block"></i>
                        <p class="text-sm text-gray-600 mb-1 font-bold">Upload Foto Paket</p>
                        <p class="text-xs text-gray-500">Klik atau Tarik Gambar (JPG, PNG)</p>
                    </div>

                    <img id="previewPaket" src="" alt="Preview" class="hidden absolute inset-0 w-full h-full object-cover z-10" />
                    <input type="file" id="p_foto_file" accept="image/jpeg,image/png" class="hidden" />
                </div>
                
                <div class="flex justify-between items-center mt-2">
                    <p id="fileNamePaket" class="text-xs text-green-700 font-bold truncate"></p>
                    <button type="button" id="btnHapusPreview" class="hidden text-[10px] text-red-500 hover:text-red-700 font-bold px-2 py-1 bg-red-50 hover:bg-red-100 rounded transition" title="Batal pilih foto">Hapus Foto</button>
                </div>
            </div>

            <div class="pt-2">
                <button type="submit" id="btn-save-paket" class="w-full bg-green-700 text-white font-bold py-3.5 rounded-xl hover:bg-green-800 transition shadow-sm uppercase tracking-wide text-sm">
                    Simpan Paket Ke Database
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    import { supabase } from '../lib/supabase';
    import { uploadImageToImgbb } from '../lib/imgbb.js';
    
    // Taruh di window biar bisa dipakai oleh script inline
    if (typeof window !== 'undefined') {
        window.supabase = supabase;
        window.uploadImageToImgbb = uploadImageToImgbb;
    }
</script>

<script is:inline>
    let allPaket = [];
    let tomKaryawan, tomPaket;

    document.addEventListener('DOMContentLoaded', async () => {
        // === 🛡️ GATEKEEPER KEAMANAN ===
        const allowedRoles = ['owner', 'hrd', 'admin'];
        if (!window.supabase) return console.error("Supabase tidak ditemukan!");
        
        const { data: { session } } = await window.supabase.auth.getSession();
        if (!session) return window.location.replace('/');
        
        const { data: prof } = await window.supabase.from('profiles').select('role').eq('id', session.user.id).single();
        if (!allowedRoles.includes(prof?.role)) {
            alert(`Akses Ditolak! Anda dilarang masuk ke menu Benefit Karyawan.`);
            return window.location.replace('/');
        }
        document.body.style.display = 'block';

        // Load Data Awal
        window.loadDaftarPaket();
        // Set tanggal default hari ini
        const now = new Date();
        const offset = now.getTimezoneOffset() * 60000;
        document.getElementById('r_tanggal').value = new Date(now - offset).toISOString().split('T')[0];

        // Eksekusi fungsi Tahap 3
        await window.loadDropdownRiwayat();
        window.loadRiwayatDistribusi();
    });

    // ==========================================
    // LOGIKA TAB
    // ==========================================
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');
    tabButtons.forEach((button) => {
        button.addEventListener('click', function() {
            const tabId = this.getAttribute('data-tab');
            
            tabButtons.forEach(btn => {
                btn.classList.remove('active', 'border-green-700', 'text-green-700');
                btn.classList.add('border-transparent', 'text-gray-600');
            });
            tabContents.forEach(content => {
                content.classList.add('hidden');
                content.classList.remove('block');
            });
            
            this.classList.add('active', 'border-green-700', 'text-green-700');
            this.classList.remove('border-transparent', 'text-gray-600');
            
            const activeTab = document.getElementById(tabId);
            if(activeTab) {
                activeTab.classList.remove('hidden');
                activeTab.classList.add('block');
            }
        });
    });

    // ==========================================
    // KONTROL MODAL UMUM
    // ==========================================
    window.openModal = function(id) {
        const m = document.getElementById(id); if(!m) return;
        m.classList.remove('hidden'); m.classList.add('flex');
        setTimeout(() => { m.classList.remove('opacity-0'); const c = m.querySelector('div'); if(c) c.classList.remove('scale-95'); }, 10);
    };
    window.closeModal = function(id) {
        const m = document.getElementById(id); if(!m) return;
        m.classList.add('opacity-0'); const c = m.querySelector('div'); if(c) c.classList.add('scale-95');
        setTimeout(() => { m.classList.add('hidden'); m.classList.remove('flex'); }, 300);
    };

    // ==========================================
    // UPLOAD & PREVIEW FOTO PAKET (SAMA KAYAK ARMADA)
    // ==========================================
    const dropZonePaket = document.getElementById('dropZonePaket');
    const inputFotoPaket = document.getElementById('p_foto_file');
    const namePaketFile = document.getElementById('fileNamePaket');
    const previewPaket = document.getElementById('previewPaket');
    const dropPlaceholder = document.getElementById('dropZonePlaceholder');
    const btnHapusPrev = document.getElementById('btnHapusPreview');
    
    if (dropZonePaket && inputFotoPaket) {
        dropZonePaket.addEventListener('click', () => inputFotoPaket.click());
        inputFotoPaket.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if(file) {
                namePaketFile.innerText = "✓ Gambar siap: " + file.name;
                dropZonePaket.classList.add('border-green-600', 'border-solid');
                dropZonePaket.classList.remove('border-dashed', 'border-gray-300');
                
                const reader = new FileReader();
                reader.onload = function(event) {
                    previewPaket.src = event.target.result;
                    previewPaket.classList.remove('hidden');
                    dropPlaceholder.classList.add('hidden');
                    btnHapusPrev.classList.remove('hidden');
                }
                reader.readAsDataURL(file);
            } else {
                window.resetPreviewPaket();
            }
        });

        window.resetPreviewPaket = function() {
            inputFotoPaket.value = '';
            namePaketFile.innerText = "";
            previewPaket.src = "";
            previewPaket.classList.add('hidden');
            dropPlaceholder.classList.remove('hidden');
            btnHapusPrev.classList.add('hidden');
            dropZonePaket.classList.remove('border-green-600', 'border-solid');
            dropZonePaket.classList.add('border-gray-300', 'border-dashed');
        };

        if(btnHapusPrev) {
            btnHapusPrev.addEventListener('click', (e) => {
                e.stopPropagation(); 
                window.resetPreviewPaket();
            });
        }
    }

    // ==========================================
    // FUNGSI KOMPRESI GAMBAR (BIAR HEMAT KUOTA)
    // ==========================================
    window.kompresGambar = function(file, maxWidth = 800, quality = 0.7) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = function(event) {
                const img = new Image();
                img.src = event.target.result;
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    let width = img.width, height = img.height;
                    if (width > maxWidth) {
                        height = Math.round((height * maxWidth) / width);
                        width = maxWidth;
                    }
                    canvas.width = width; canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);
                    canvas.toBlob((blob) => {
                        if (blob) resolve(new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", { type: 'image/jpeg' }));
                        else reject(new Error('Gagal kompresi'));
                    }, 'image/jpeg', quality);
                };
                img.onerror = error => reject(error);
            };
            reader.onerror = error => reject(error);
        });
    };

    // ==========================================
    // LOGIKA RENDER & CRUD PAKET
    // ==========================================
    window.loadDaftarPaket = async function() {
        const container = document.getElementById('paket-container');
        try {
            const { data, error } = await window.supabase.from('paket_suplemen').select('*').eq('is_active', true).order('nama_paket');
            if (error) throw error;
            
            allPaket = data || [];
            
            if (allPaket.length === 0) {
                container.innerHTML = '<div class="col-span-full p-8 text-center bg-gray-50 border border-dashed border-gray-300 rounded-2xl text-gray-500"><i class="bi bi-box-seam text-3xl mb-2 block"></i>Belum ada paket suplemen yang dibuat.</div>';
                return;
            }

            let html = '';
            allPaket.forEach(p => {
                const fotoHtml = p.foto_url 
                    ? `<img src="${p.foto_url}" class="w-full h-40 object-cover" alt="Foto Paket">` 
                    : `<div class="w-full h-40 bg-gray-100 flex items-center justify-center text-gray-400"><i class="bi bi-image text-3xl"></i></div>`;
                
                html += `
                <div class="bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col">
                    ${fotoHtml}
                    <div class="p-4 flex-1 flex flex-col">
                        <h3 class="font-bold text-lg text-gray-900 mb-1 leading-tight">${p.nama_paket}</h3>
                        <p class="text-xs text-gray-600 mb-4 flex-1">${p.deskripsi}</p>
                        
                        <div class="flex gap-2 mt-auto border-t border-gray-100 pt-3">
                            <button onclick="window.editPaket('${p.id}')" class="flex-1 bg-blue-50 text-blue-700 font-bold py-2 rounded-xl text-xs hover:bg-blue-100 transition"><i class="bi bi-pencil-square mr-1"></i> Edit</button>
                            <button onclick="window.hapusPaket('${p.id}', '${p.nama_paket}')" class="bg-red-50 text-red-600 font-bold px-3 py-2 rounded-xl text-xs hover:bg-red-100 transition" title="Hapus Paket"><i class="bi bi-trash3"></i></button>
                        </div>
                    </div>
                </div>`;
            });
            container.innerHTML = html;
        } catch(e) { console.error("Error load:", e); }
    };

    window.bukaModalPaket = function() {
        document.getElementById('form-paket').reset();
        document.getElementById('edit_paket_id').value = '';
        document.getElementById('modal-title-paket').innerText = "Buat Paket Suplemen Baru";
        window.resetPreviewPaket();
        window.openModal('modal-paket');
    };

    window.editPaket = function(id) {
        const p = allPaket.find(x => String(x.id) === String(id));
        if(!p) return alert("Data tidak ditemukan!");

        document.getElementById('edit_paket_id').value = p.id;
        document.getElementById('p_nama').value = p.nama_paket;
        document.getElementById('p_deskripsi').value = p.deskripsi;
        document.getElementById('modal-title-paket').innerText = "Edit Paket Suplemen";

        window.resetPreviewPaket();

        if (p.foto_url) {
            previewPaket.src = p.foto_url;
            previewPaket.classList.remove('hidden');
            dropPlaceholder.classList.add('hidden');
            btnHapusPrev.classList.remove('hidden');
            dropZonePaket.classList.add('border-green-600', 'border-solid');
            dropZonePaket.classList.remove('border-gray-300', 'border-dashed');
        }

        window.openModal('modal-paket');
    };

    window.simpanPaket = async function(e) {
        e.preventDefault();
        const btn = document.getElementById('btn-save-paket');
        const file = document.getElementById('p_foto_file')?.files[0];
        const editId = document.getElementById('edit_paket_id').value;

        btn.innerText = "Mempersiapkan Data..."; btn.disabled = true;

        try {
            let finalImageUrl = null;

            if (file) {
                btn.innerText = "Mengkompresi Foto...";
                try {
                    const compressedFile = await window.kompresGambar(file, 800, 0.7); 
                    btn.innerText = "Mengunggah ke Server...";
                    finalImageUrl = await window.uploadImageToImgbb(compressedFile);
                } catch(err) {
                    finalImageUrl = await window.uploadImageToImgbb(file); 
                }
            }

            btn.innerText = "Menyimpan Database...";

            let payload = {
                nama_paket: document.getElementById('p_nama').value,
                deskripsi: document.getElementById('p_deskripsi').value,
            };

            if (finalImageUrl) {
                payload.foto_url = finalImageUrl;
            } else if (previewPaket.src === '' || previewPaket.classList.contains('hidden')) {
                payload.foto_url = null; 
            }

            if (editId) {
                await window.supabase.from('paket_suplemen').update(payload).eq('id', editId);
                alert("Paket berhasil diperbarui!");
            } else {
                await window.supabase.from('paket_suplemen').insert([payload]);
                alert("Paket baru berhasil ditambahkan!");
            }
            
            window.closeModal('modal-paket');
            window.loadDaftarPaket(); // Ini cuma refresh kotak-kotak paket

            // 🔥 TAMBAHKAN BARIS INI: Biar Dropdown 'Pilih Paket' ikut narik data terbaru!
            await window.loadDropdownRiwayat();
            
        } catch(err) { 
            alert("Gagal menyimpan: " + err.message);
        } finally { 
            btn.innerText = "Simpan Paket Ke Database";
            btn.disabled = false; 
        }
    };

    window.hapusPaket = async function(id, nama) {
        if(!confirm(`Yakin ingin menghapus paket "${nama}"? (Data riwayat pengambilan sebelumnya tidak akan hilang)`)) return;
        try {
            await window.supabase.from('paket_suplemen').update({ is_active: false }).eq('id', id);
            window.loadDaftarPaket();
        } catch(err) { alert("Gagal menghapus: " + err.message); }
    };

    // ==========================================
    // FUNGSI TAHAP 3: RIWAYAT PENGAMBILAN
    // ==========================================
    
    window.loadDropdownRiwayat = async function() {
        try {
            // 1. Tarik Data Karyawan
            const { data: karyawan } = await window.supabase.from('profiles').select('id, nama').neq('role', 'owner').order('nama');
            let optKaryawan = '<option value="">-- Ketik/Pilih Karyawan --</option>';
            if(karyawan) karyawan.forEach(k => optKaryawan += `<option value="${k.id}">${k.nama}</option>`);
            
            const selKaryawan = document.getElementById('r_karyawan');
            selKaryawan.innerHTML = optKaryawan;
            if(typeof TomSelect !== 'undefined') {
                if(tomKaryawan) tomKaryawan.destroy();
                tomKaryawan = new TomSelect(selKaryawan, { create: false, maxOptions: null });
            }

            // 2. Tarik Data Paket Tersedia
            const { data: paket } = await window.supabase.from('paket_suplemen').select('id, nama_paket').eq('is_active', true);
            let optPaket = '<option value="">-- Ketik/Pilih Paket --</option>';
            if(paket) paket.forEach(p => optPaket += `<option value="${p.id}">${p.nama_paket}</option>`);
            
            const selPaket = document.getElementById('r_paket');
            selPaket.innerHTML = optPaket;
            if(typeof TomSelect !== 'undefined') {
                if(tomPaket) tomPaket.destroy();
                tomPaket = new TomSelect(selPaket, { create: false, maxOptions: null });
            }
        } catch(e) { console.error("Error dropdown:", e); }
    };

    window.loadRiwayatDistribusi = async function() {
        const tbody = document.getElementById('tbody-riwayat');
        try {
            const { data, error } = await window.supabase
                .from('riwayat_suplemen')
                .select('id, tanggal_ambil, catatan, profiles(nama), paket_suplemen(nama_paket, foto_url)')
                .order('tanggal_ambil', { ascending: false })
                .order('created_at', { ascending: false })
                .limit(50); // Tampilkan 50 riwayat terakhir

            if (error) throw error;

            if(!data || data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-gray-500 italic">Belum ada catatan distribusi paket.</td></tr>';
                return;
            }

            let html = '';
            data.forEach(r => {
                const foto = r.paket_suplemen?.foto_url 
                    ? `<img src="${r.paket_suplemen.foto_url}" class="w-8 h-8 rounded object-cover shadow-sm border border-gray-200">`
                    : `<div class="w-8 h-8 bg-gray-100 border border-gray-200 rounded flex items-center justify-center text-gray-400 text-xs"><i class="bi bi-box"></i></div>`;
                
                const tgl = r.tanggal_ambil.split('-').reverse().join('/');
                const catatan = r.catatan ? `<br><span class="text-[10px] text-gray-500 font-medium bg-gray-100 px-1.5 py-0.5 rounded mt-1 inline-block"><i class="bi bi-pencil"></i> ${r.catatan}</span>` : '';

                html += `
                <tr class="hover:bg-green-50/30 transition border-b border-gray-50">
                    <td class="p-3 font-mono font-semibold text-gray-600 whitespace-nowrap text-xs">${tgl}</td>
                    <td class="p-3 font-bold text-green-800">${r.profiles?.nama || 'Unknown'}</td>
                    <td class="p-3">
                        <div class="flex items-center gap-2">
                            ${foto}
                            <div>
                                <span class="font-bold text-gray-900">${r.paket_suplemen?.nama_paket || '<span class="text-red-500">Paket Dihapus</span>'}</span>
                                ${catatan}
                            </div>
                        </div>
                    </td>
                    <td class="p-3 text-center">
                        <button onclick="window.hapusRiwayat(${r.id})" class="text-red-500 hover:text-red-700 bg-red-50 p-1.5 rounded transition shadow-sm border border-red-100" title="Hapus Catatan"><i class="bi bi-trash3"></i></button>
                    </td>
                </tr>`;
            });
            tbody.innerHTML = html;
        } catch (e) {
            console.error("Load riwayat error:", e);
            tbody.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-red-500 font-bold">Gagal memuat data riwayat</td></tr>';
        }
    };

    window.simpanRiwayat = async function(e) {
        e.preventDefault();
        const btn = document.getElementById('btn-save-riwayat');
        btn.innerText = "Menyimpan..."; btn.disabled = true;

        const payload = {
            karyawan_id: document.getElementById('r_karyawan').value,
            paket_id: document.getElementById('r_paket').value,
            tanggal_ambil: document.getElementById('r_tanggal').value,
            catatan: document.getElementById('r_catatan').value || null
        };

        try {
            const { error } = await window.supabase.from('riwayat_suplemen').insert([payload]);
            if (error) throw error;

            alert("Riwayat pengambilan suplemen berhasil dicatat!");
            
            // Bersihkan form kecuali tanggal
            document.getElementById('r_catatan').value = '';
            if(tomKaryawan) tomKaryawan.clear(); else document.getElementById('r_karyawan').value = '';
            if(tomPaket) tomPaket.clear(); else document.getElementById('r_paket').value = '';

            window.loadRiwayatDistribusi();
        } catch (err) {
            alert("Gagal mencatat: " + err.message);
        } finally {
            btn.innerHTML = '<i class="bi bi-send mr-1"></i> Simpan Catatan'; 
            btn.disabled = false;
        }
    };

    window.hapusRiwayat = async function(id) {
        if(!confirm("Yakin ingin menghapus catatan distribusi ini?")) return;
        try {
            const { error } = await window.supabase.from('riwayat_suplemen').delete().eq('id', id);
            if(error) throw error;
            window.loadRiwayatDistribusi();
        } catch(err) { alert("Gagal menghapus catatan: " + err.message); }
    };
</script>