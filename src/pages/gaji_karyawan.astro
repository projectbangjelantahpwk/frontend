    window.simpanMasterKomponen = async function () {
      const namaInput = document
        .getElementById("input-master-nama")
        .value.trim();
      const tipeInput = document.getElementById("input-master-tipe").value;

      if (!namaInput) {
        return alert("Nama komponen tidak boleh kosong bro!");
      }

      try {
        // Insert ke tabel master_komponen_gaji
        const { error } = await window.supabase
          .from("master_komponen_gaji")
          .insert([{ nama_komponen: namaInput, tipe_default: tipeInput }]);

        if (error) {
          if (error.code === "23505") {
            // Kode error duplicate PostgreSQL
            throw new Error("Nama komponen ini sudah ada di database!");
          }
          throw error;
        }

        alert(`Mantap! "${namaInput}" berhasil ditambahkan ke daftar master.`);

        // Kosongkan form setelah sukses
        document.getElementById("input-master-nama").value = "";

        // (Opsional) Refresh dropdown atau array di memori agar langsung muncul
        if (typeof window.loadMasterKomponen === "function") {
          window.loadMasterKomponen();
        }
      } catch (err) {
        alert("Gagal menyimpan: " + err.message);
      }
    };

    // Memori untuk menyimpan state
    window.pilihanMasterKomponen = [];
    window.dataLainLain = [];

    // Fungsi untuk menarik master data dari database
    window.loadMasterKomponen = async function () {
      try {
        const { data, error } = await window.supabase
          .from("master_komponen_gaji")
          .select("*")
          .order("nama_komponen", { ascending: true });

        if (!error && data) {
          window.pilihanMasterKomponen = data;
        }
        window.renderLainLain(); // Render ulang setelah data siap
      } catch (err) {
        console.error("Gagal load master komponen:", err);
      }
    };

    // Fungsi untuk menggambar UI dinamis
    // Fungsi untuk menggambar UI dinamis (SETUP GAJI)
    window.renderLainLain = function () {
      const container = document.getElementById("container-lain-lain");
      if (!container) return;

      container.innerHTML = "";

      if (window.dataLainLain.length === 0) {
        container.innerHTML = `<p class="text-[10px] text-gray-400 italic text-center py-4 bg-gray-50 rounded-lg border border-dashed border-gray-200">Belum ada komponen tambahan. Klik tombol Tambah Baris.</p>`;
        return;
      }

      window.dataLainLain.forEach((item, index) => {
        const isPenambahan = item.tipe === "penambahan";
        const colorClass = isPenambahan
          ? "text-green-700 bg-green-50 border-green-200"
          : "text-red-700 bg-red-50 border-red-200";

        // 🔥 LOGIKA ANTI-DOUBLE: Cek item yang sudah dipakai di baris lain 🔥
        let opsiHTML = `<option value="" disabled ${!item.nama_item ? "selected" : ""}>-- Pilih Komponen --</option>`;
        if (window.pilihanMasterKomponen) {
          window.pilihanMasterKomponen.forEach((master) => {
            const sudahDipakai = window.dataLainLain.some(
              (d, idx) => idx !== index && d.nama_item === master.nama_komponen,
            );
            const isTerpilihDiSini = item.nama_item === master.nama_komponen;

            if (sudahDipakai) {
              opsiHTML += `<option value="${master.nama_komponen}" disabled class="text-gray-300">❌ ${master.nama_komponen} (Sudah Dipilih)</option>`;
            } else {
              opsiHTML += `<option value="${master.nama_komponen}" data-tipe="${master.tipe_default}" ${isTerpilihDiSini ? "selected" : ""}>${master.nama_komponen}</option>`;
            }
          });
        }

        // Kalau ternyata itemnya udah nggak ada di master tapi ada di database (history)
        if (
          item.nama_item &&
          !window.pilihanMasterKomponen?.find(
            (m) => m.nama_komponen === item.nama_item,
          )
        ) {
          opsiHTML += `<option value="${item.nama_item}" selected>${item.nama_item} (Data Lama)</option>`;
        }

        const rowHTML = `
        <div class="p-2.5 rounded-lg border border-gray-200 bg-gray-50 flex flex-col sm:flex-row gap-2 relative transition-all">
          <div class="w-full sm:w-2/5">
            <select class="w-full border-gray-300 rounded p-1.5 text-xs outline-none focus:border-blue-500 font-bold text-gray-700 shadow-inner" 
                    onchange="window.pilihKomponenDariDropdown(${index}, this)">
              ${opsiHTML}
            </select>
          </div>
          <div class="w-full sm:w-1/4">
            <select class="w-full border rounded p-1.5 text-xs outline-none font-bold ${colorClass}" disabled>
              <option value="penambahan" ${isPenambahan ? "selected" : ""}>+ Nambah</option>
              <option value="potongan" ${!isPenambahan ? "selected" : ""}>- Potong</option>
            </select>
          </div>
          <div class="w-full sm:w-1/3 flex gap-2">
            <input type="number" placeholder="Nominal (Rp)" 
                   class="w-full border-gray-300 rounded p-1.5 text-xs outline-none focus:border-blue-500 shadow-inner font-mono font-bold" 
                   value="${item.nominal || ""}" oninput="window.updateLainLain(${index}, 'nominal', this.value)" />
            
            <button type="button" onclick="window.hapusLainLain(${index})" class="bg-red-100 text-red-600 px-2.5 rounded hover:bg-red-200 transition-colors shadow-sm flex items-center justify-center">
              <i class="bi bi-trash"></i>
            </button>
          </div>
        </div>`;
        container.insertAdjacentHTML("beforeend", rowHTML);
      });
    };

    // Logic Pintar: Saat milih nama, otomatis tipe (nambah/potong) ikut berubah
    window.pilihKomponenDariDropdown = function (index, elemenSelect) {
      const namaTerpilih = elemenSelect.value;
      const masterData = window.pilihanMasterKomponen.find(
        (m) => m.nama_komponen === namaTerpilih,
      );

      if (masterData) {
        window.dataLainLain[index].nama_item = masterData.nama_komponen;
        window.dataLainLain[index].tipe = masterData.tipe_default;
        window.renderLainLain(); // Render ulang biar warnanya (merah/hijau) menyesuaikan
        window.kalkulasiRealtimeGaji();
      }
    };

    window.tambahBarisLainLain = function () {
      // Tambah object kosong ke memori, lalu render
      window.dataLainLain.push({
        id: Date.now().toString(),
        nama_item: "",
        tipe: "penambahan",
        nominal: 0,
      });
      window.renderLainLain();
    };

    window.updateLainLain = function (index, field, value) {
      window.dataLainLain[index][field] =
        field === "nominal" ? parseFloat(value) || 0 : value;
      window.kalkulasiRealtimeGaji();
    };

    window.hapusLainLain = function (index) {
      window.dataLainLain.splice(index, 1);
      window.renderLainLain();
      window.kalkulasiRealtimeGaji();
    };

    // FUNGSI PENJEMBATAN (Simpan Draf ATAU Lempar ke Kasir)
    window.simpanSlipGaji = async function (statusTarget) {
      if (statusTarget === "ACC") {
        // LEMPAR KE KASIR SPLIT PAYMENT
        document.getElementById("kasir_total_tagihan").innerText =
          `Rp ${window.currentSalaryData.finalState.grandTotal.toLocaleString("id-ID")}`;
        document.getElementById("kasir_owner").value =
          window.currentSalaryData.finalState.grandTotal;
        document.getElementById("kasir_keuangan").value = 0;
        document.getElementById("kasir_gudang").value = 0;
        window.kalkulasiKasir();
        window.openModal("modal-kasir-gaji");
      } else {
        // SIMPAN SEBAGAI DRAF MENUNGGU
        if (!confirm("Simpan Slip Periode ini sebagai Draf (Menunggu)?"))
          return;
        window.eksekusiBayarGaji("Menunggu");
      }
    };

    // LOGIKA KASIR SPLIT PAYMENT (UI)
    window.kalkulasiKasir = function () {
      const uK =
        parseFloat(document.getElementById("kasir_keuangan").value) || 0;
      const uG = parseFloat(document.getElementById("kasir_gudang").value) || 0;
      const uO = parseFloat(document.getElementById("kasir_owner").value) || 0;

      const totalTagihan = window.currentSalaryData.finalState.grandTotal;
      const totalSplit = uK + uG + uO;
      const sisa = totalTagihan - totalSplit;

      const elSisa = document.getElementById("kasir_sisa");
      const boxSisa = document.getElementById("kasir_sisa_box");
      const btnBayar = document.getElementById("btn-eksekusi-bayar");

      elSisa.innerText = `Rp ${sisa.toLocaleString("id-ID")}`;

      if (sisa === 0) {
        boxSisa.classList.replace("bg-red-50", "bg-green-50");
        boxSisa.classList.replace("border-red-200", "border-green-200");
        elSisa.classList.replace("text-red-700", "text-green-700");
        btnBayar.disabled = false;
      } else {
        boxSisa.classList.replace("bg-green-50", "bg-red-50");
        boxSisa.classList.replace("border-green-200", "border-red-200");
        elSisa.classList.replace("text-green-700", "text-red-700");
        btnBayar.disabled = true;
      }
    };

    // EKSEKUSI PEMBAYARAN FINAL KE DATABASE
    window.eksekusiBayarGaji = async function (overrideStatus = "ACC") {
      if (!window.supabase) return;
      const d = window.currentSalaryData;
      const btnBayar = document.getElementById("btn-eksekusi-bayar");
      if (btnBayar) {
        btnBayar.innerText = "Memproses Ke Server...";
        btnBayar.disabled = true;
      }

      const potKasbonInput = document.getElementById(
        "potongan_kasbon_sekarang",
      )?.value;
      const potonganManual =
        potKasbonInput === "" || !potKasbonInput
          ? null
          : parseFloat(potKasbonInput);
      const jm = document.getElementById("input_jerigen_manual")?.value;

      // 🟢 1. TAMBAHKAN DUA BARIS INI (Ambil status langsung dari UI)
      const isJamBebasAktif =
        document.getElementById("chk_jam_bebas")?.checked || false;
      const inputGajiPokok =
        parseFloat(document.getElementById("setup_gaji_pokok")?.value) || 0;

      // 🔥 BACA INPUT KASIR SPLIT
      const valKeuangan =
        parseFloat(document.getElementById("kasir_keuangan")?.value) || 0;
      const valGudang =
        parseFloat(document.getElementById("kasir_gudang")?.value) || 0;
      const valOwner =
        parseFloat(document.getElementById("kasir_owner")?.value) || 0;

      try {
        const { data, error } = await window.supabase.functions.invoke(
          "gaji-karyawan",
          {
            body: {
              empId: d.empId,
              tglMulai: d.tglMulai,
              tglAkhir: d.tglAkhir,
              action: "bayar",
              statusTarget: overrideStatus,
              adminId: currentUserId,
              potonganKasbonManual: isNaN(potonganManual)
                ? null
                : potonganManual,
              siklusGaji: d.siklusGaji,
              jumlahJerigenManual: jm === "" || !jm ? null : parseFloat(jm),
              lain_lain_manual: window.dataLainLain,

              // 🟢 2. TAMBAHKAN BARIS INI KE PAYLOAD ACTION "BAYAR"
              is_jam_bebas_manual: isJamBebasAktif,
              gaji_menit_manual: inputGajiPokok,

              // 🔥 KIRIM DATA SUMBER KAS KE DENO
              kasKeuanganTerpakai: overrideStatus === "ACC" ? valKeuangan : 0,
              kasGudangTerpakai: overrideStatus === "ACC" ? valGudang : 0,
              kasOwnerTerpakai: overrideStatus === "ACC" ? valOwner : 0,
            },
          },
        );

        // 🔥 JEBAKAN ERROR: Baca error asli dari Deno dan ledakkan di layar!
        if (error) throw error;
        if (data && data.success === false) throw new Error(data.error);

        alert(
          `✅ SUKSES LUNAS!\n\nGaji berhasil dibayar dari Uang Keuangan. Rincian gaji pokok, lembur, kesehatan, total bonus, dan kasbon otomatis pecah di modul Pengeluaran.`,
        );
        window.location.reload();
      } catch (err) {
        // ERROR ASLINYA MUNCUL DI SINI NANTI!
        alert(
          "🚨 GAGAL MEMPROSES:\n\n" +
            (err.message || "Terjadi kesalahan di server Deno."),
        );
        if (btnBayar) {
          btnBayar.innerText = "POTONG KAS & BAYAR";
          btnBayar.disabled = false;
        }
      }
    };

    window.updateJamAbsenManual = () => {
      const valTiba = document.getElementById("edit_absen_tiba").value;
      const valPulang = document.getElementById("edit_absen_pulang").value;
      if (!valTiba) return;

      window.currentSalaryData.jamTibaStr = valTiba + ":00";
      window.currentSalaryData.jamPulangStr = valPulang
        ? valPulang + ":00"
        : "-";

      let masukMenit = parseJamMenit(window.currentSalaryData.jamTibaStr);
      let pulangMenit = valPulang
        ? parseJamMenit(window.currentSalaryData.jamPulangStr)
        : masukMenit;

      let totalNormalMenit = 0;
      let totalLemburMenit = 0;
      const batasPulangNormalMenit = 17 * 60;
      let actualPulangNormal = Math.min(pulangMenit, batasPulangNormalMenit);
      totalNormalMenit = Math.max(0, actualPulangNormal - masukMenit);
      if (pulangMenit > batasPulangNormalMenit) {
        totalLemburMenit = pulangMenit - batasPulangNormalMenit;
      }

      window.currentSalaryData.totalNormalMenit = totalNormalMenit;
      window.currentSalaryData.totalLemburMenit = totalLemburMenit;
      window.kalkulasiRealtimeGaji();
    };

    // FUNGSI SIMPAN SETUP KE DATABASE
    window.simpanSetupGaji = async function () {
      if (!window.supabase) return;
      const empId = document.getElementById("m_karyawan_id").value;
      const setupId = document.getElementById("m_setup_id").value;

      // ✅ SEKARANG MURNI MINGGUAN & ID ELEMEN DIPASTIKAN VALID
      const payloadSetup = {
        user_id: empId,
        siklus_gaji: document.getElementById("setup_siklus_gaji").value, // TAMBAHAN BARU
        gaji_menit:
          parseFloat(document.getElementById("setup_gaji_pokok")?.value) || 0,
        is_jam_bebas:
          document.getElementById("chk_jam_bebas")?.checked || false,
        uang_lembur_menit:
          parseFloat(document.getElementById("setup_lembur_menit")?.value) || 0,
        uang_makan:
          parseFloat(document.getElementById("setup_uang_makan")?.value) || 0,
        bonus_tepat_waktu:
          parseFloat(document.getElementById("setup_bonus_tepat")?.value) || 0,
        bonus_mingguan:
          parseFloat(document.getElementById("setup_bonus_mingguan")?.value) ||
          0,
        uang_transport:
          parseFloat(document.getElementById("setup_uang_transport")?.value) ||
          0,
        uang_kesehatan:
          parseFloat(document.getElementById("setup_uang_kesehatan")?.value) ||
          0,
        uang_rapat:
          parseFloat(document.getElementById("setup_uang_rapat")?.value) || 0,
        uang_nginep:
          parseFloat(document.getElementById("setup_uang_nginep")?.value) || 0,
        kasbon:
          parseFloat(
            document.getElementById("setup_kasbon")?.value ||
              window.currentSalaryData?.sisaKasbonDb,
          ) || 0,
        potongan_bonus_mingguan:
          parseFloat(document.getElementById("setup_potongan_absen")?.value) ||
          0,
        bypass_jam_kerja:
          document.getElementById("chk_bypass_jam_kerja")?.checked || false,
        is_gaji_jerigen:
          document.getElementById("chk_gaji_jerigen")?.checked || false,
        tarif_jerigen:
          parseFloat(document.getElementById("setup_tarif_jerigen")?.value) ||
          0,
        bonus_jerigen_manual:
          parseFloat(document.getElementById("setup_bonus_jerigen")?.value) ||
          0,
        lain_lain: window.dataLainLain,
      };

      try {
        if (setupId) {
          const { error } = await window.supabase
            .from("setup_gaji")
            .update(payloadSetup)
            .eq("id", setupId);
          if (error) throw error;
        } else {
          const { data, error } = await window.supabase
            .from("setup_gaji")
            .insert([payloadSetup])
            .select()
            .single();
          if (error) throw error;
          if (data) document.getElementById("m_setup_id").value = data.id;
        }
        alert("Mantap! Parameter Setup Gaji Bulanan Berhasil Disimpan!");
        window.kalkulasiRealtimeGaji();
      } catch (err) {
        console.error("Error Detail Supabase:", err);
        alert("Gagal simpan setup! Periksa kesalahan: " + err.message);
      }
    };

    // ==========================================
    // ✅ PERBAIKAN EXPORT EXCEL (.XLSX)
    // ✅ FORMAT UTUH + DYNAMIC COLUMNS JSONB
    // ==========================================
    window.exportExcelRiwayat = function () {
      try {
        // 🔍 Validasi: Cek apakah XLSX tersedia
        if (typeof XLSX === "undefined") {
          return alert(
            "❌ Library XLSX belum ter-load. Silakan refresh halaman!",
          );
        }

        // 🔍 Validasi: Cek data filter
        const dataTerfilter = window.currentFilteredRiwayat;
        if (!dataTerfilter || dataTerfilter.length === 0) {
          return alert(
            "⚠️ Tidak ada data riwayat yang cocok dengan filter untuk diexport!",
          );
        }

        // 🔥 STEP 1: SCAN SEMUA "NAMA ITEM" DARI SELURUH KARYAWAN 🔥
        // Untuk bikin Header Kolom Dinamis di Excel (Uang Bongkar (+), dsb)
        const dynamicHeaders = new Set();
        dataTerfilter.forEach((s) => {
          if (s.lain_lain && Array.isArray(s.lain_lain)) {
            s.lain_lain.forEach((item) => {
              if (item.nama_item) {
                const tanda = item.tipe === "penambahan" ? "(+)" : "(-)";
                dynamicHeaders.add(`${item.nama_item} ${tanda}`);
              }
            });
          }
        });
        const dynamicColumnsArray = Array.from(dynamicHeaders);

        // 🔥 STEP 2: PETAKAN DATA 🔥
        const rows = dataTerfilter.map((s, index) => {
          const totalBonus =
            Number(s.bonus_tepat_waktu || 0) +
            Number(s.bonus_mingguan || 0) +
            Number(s.uang_kesehatan || 0) +
            Number(s.uang_rapat || 0) +
            Number(s.uang_nginep || 0) +
            Number(s.bonus_penjemputan || 0);

          // Kalkulasi untuk kolom bawaan (Penambahan Lain, Potongan Lain, Rincian)
          let detailLainText = [];
          let totalPenambahanLain = 0;
          let totalPotonganLain = 0;

          if (s.lain_lain && Array.isArray(s.lain_lain)) {
            s.lain_lain.forEach((item) => {
              const nom = Number(item.nominal) || 0;
              if (item.tipe === "penambahan") {
                totalPenambahanLain += nom;
                detailLainText.push(
                  `${item.nama_item} (+${nom.toLocaleString("id-ID")})`,
                );
              } else if (item.tipe === "potongan") {
                totalPotonganLain += nom;
                detailLainText.push(
                  `${item.nama_item} (-${nom.toLocaleString("id-ID")})`,
                );
              }
            });
          }

          // 1️⃣ STRUKTUR BAWAAN LU YANG UTUH (SESUAI REQUEST)
          let rowData = {
            No: index + 1,
            "Nama Karyawan": s.profiles?.nama || "Unknown",
            Periode: s.periode || "-",
            Status: s.status || "Menunggu",
            "Gaji Pokok (Rp)": Number(s.gaji_karyawan || 0),
            "Uang Lembur (Rp)": Number(s.uang_lembur || 0),
            "Uang Makan (Rp)": Number(s.uang_makan || 0),
            "Uang Makan Malam (Rp)": Number(s.uang_makan_malam || 0),
            "Bonus Penjemputan (Rp)": Number(s.bonus_penjemputan || 0),
            "Total Bonus (Rp)": totalBonus,
            "Penambahan Lain (Rp)": totalPenambahanLain,
            "Potongan Kasbon (Rp)": Number(s.kasbon || 0),
            "Potongan Lain (Rp)": totalPotonganLain,
            "Rincian Komponen Lain": detailLainText.join(" | "),
          };

          // 2️⃣ INJEKSI KOLOM DINAMIS (Agar Akuntansi Mudah Difilter/Sum)
          // Set default 0 dulu untuk semua header dinamis yang ditemukan
          dynamicColumnsArray.forEach((col) => {
            rowData[col] = 0;
          });

          // Isi nominalnya jika karyawan ini punya item tersebut
          if (s.lain_lain && Array.isArray(s.lain_lain)) {
            s.lain_lain.forEach((item) => {
              if (item.nama_item) {
                const tanda = item.tipe === "penambahan" ? "(+)" : "(-)";
                const headerName = `${item.nama_item} ${tanda}`;
                // Gunakan += biar kalau ada 2 input bernama sama, angkanya dijumlahkan aman
                rowData[headerName] += Number(item.nominal) || 0;
              }
            });
          }

          // 3️⃣ TOTAL DITERIMA SELALU MENTOK DI KANAN
          rowData["Total Diterima (Rp)"] = Number(s.total_diterima || 0);

          return rowData;
        });

        // 3️⃣ Buat Workbook & Append Sheet
        const worksheet = XLSX.utils.json_to_sheet(rows);
        const workbook = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(
          workbook,
          worksheet,
          "Riwayat Gaji Terfilter",
        );

        // 4️⃣ Atur Lebar Kolom Biar Enak Dibaca
        const columnWidths = Object.keys(rows[0] || {}).map((key) => {
          const maxLength = Math.max(
            key.length,
            ...rows.map((row) => (row[key] ? String(row[key]).length : 0)),
          );
          return { wch: Math.min(maxLength + 3, 50) };
        });
        worksheet["!cols"] = columnWidths;

        // 5️⃣ Ambil Nama Karyawan untuk Nama File
        let namaKaryawan = "Semua Karyawan";
        const dropdownUser = document.getElementById("filter-gaji-user");
        if (dropdownUser && dropdownUser.value !== "semua") {
          namaKaryawan = dropdownUser.options[dropdownUser.selectedIndex].text;
        }

        // 6️⃣ Download File dengan Error Handling
        try {
          XLSX.writeFile(
            workbook,
            `rekap_gaji_${namaKaryawan.replace(/\s+/g, "_")}_${new Date().toISOString().split("T")[0]}.xlsx`,
          );
          alert(
            `✅ Excel berhasil diunduh!\n\nFile: rekap_gaji_${namaKaryawan.replace(/\s+/g, "_")}.xlsx\nTotal: ${rows.length} baris`,
          );
        } catch (writeErr) {
          alert(`❌ Gagal menulis file Excel: ${writeErr.message}`);
        }
      } catch (err) {
        console.error("Export Excel Error:", err);
        alert(
          `❌ GAGAL EXPORT EXCEL:\n\n${err.message || "Error tidak diketahui"}`,
        );
      }
    };

    // ==========================================
    // ✅ FUNGSI 1: DOWNLOAD SLIP GAMBAR (PNG)
    // ==========================================
    window.downloadSlipGambar = async function (slipId) {
      try {
        if (typeof html2canvas === "undefined") {
          return alert(
            "❌ Library html2canvas belum ter-load. Silakan refresh halaman!",
          );
        }

        const slip = window.currentFilteredRiwayat?.find(
          (s) => String(s.id) === String(slipId),
        );
        if (!slip) {
          return alert("⚠️ Data slip tidak ditemukan dalam filter!");
        }

        // ============================================================
        // STEP 1️⃣: Set semua KOMPONEN STATIC (gaji, lembur, makan, dll)
        // ============================================================
        document.getElementById("slip-nama").innerText =
          `: ${slip.profiles?.nama || "Unknown"}`;
        document.getElementById("slip-periode").innerText = `: ${slip.periode}`;
        document.getElementById("slip-status").innerText = `: ${slip.status}`;

        // 🔥 FIX 1: Tampilkan Range Tanggal "Dari - Sampai"
        const startDate =
          document.getElementById("filter-gaji-start")?.value || "-";
        const endDate =
          document.getElementById("filter-gaji-end")?.value || "-";
        document.getElementById("slip-tanggal-range").innerText =
          `: ${startDate} s/d ${endDate}`;

        document.getElementById("slip-gaji").parentElement.style.display =
          "table-row";
        document.getElementById("slip-gaji").innerText =
          `Rp ${Number(slip.gaji_karyawan || 0).toLocaleString("id-ID")}`;

        const slipLembur = document.getElementById("slip-lembur");
        if (Number(slip.uang_lembur || 0) > 0) {
          slipLembur.innerText = `Rp ${Number(slip.uang_lembur || 0).toLocaleString("id-ID")}`;
          slipLembur.parentElement.style.display = "table-row";
        } else {
          slipLembur.parentElement.style.display = "none";
        }

        const slipMakan = document.getElementById("slip-makan");
        if (Number(slip.uang_makan || 0) > 0) {
          slipMakan.innerText = `Rp ${Number(slip.uang_makan || 0).toLocaleString("id-ID")}`;
          slipMakan.parentElement.style.display = "table-row";
        } else {
          slipMakan.parentElement.style.display = "none";
        }

        const slipMakanMalam = document.getElementById("slip-makan-malam");
        if (Number(slip.uang_makan_malam || 0) > 0) {
          slipMakanMalam.innerText = `Rp ${Number(slip.uang_makan_malam || 0).toLocaleString("id-ID")}`;
          slipMakanMalam.parentElement.style.display = "table-row";
        } else {
          slipMakanMalam.parentElement.style.display = "none";
        }

        const slipBonusTepat = document.getElementById("slip-bonus-tepat");
        if (Number(slip.bonus_tepat_waktu || 0) > 0) {
          slipBonusTepat.innerText = `Rp ${Number(slip.bonus_tepat_waktu || 0).toLocaleString("id-ID")}`;
          slipBonusTepat.parentElement.style.display = "table-row";
        } else {
          slipBonusTepat.parentElement.style.display = "none";
        }

        const slipBonusMingguan = document.getElementById(
