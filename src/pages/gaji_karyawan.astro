<script
  src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"
  is:inline></script>
<script
  src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"
  is:inline></script>
<script is:inline>
  let dataGlobalGaji = null;
  let dataKaryawan = [];
  let currentUserId = null;

  document.addEventListener("DOMContentLoaded", async () => {
    // === 🛡️ GATEKEEPER KEUANGAN ===
    const allowedRoles = ["owner", "hrd", "keuangan", "it"];
    const client = window.supabase || supabase;

    const {
      data: { session },
    } = await client.auth.getSession();
    if (!session) return window.location.replace("/");
    currentUserId = session.user.id;

    const { data: prof } = await client
      .from("profiles")
      .select("role")
      .eq("id", session.user.id)
      .single();

    if (!allowedRoles.includes(prof?.role)) {
      alert(
        `Akses Ditolak! Role Anda (${prof?.role || "Guest"}) dilarang masuk ke Keuangan.`,
      );
      return window.location.replace("/");
    }
    document.body.style.display = "block";

    // Setup Batasan Tanggal Otomatis
    const tahunAktif = new Date().getFullYear();
    const awalTahun = `${tahunAktif}-01-01`;
    const waktuLokal = new Date();
    const offset = waktuLokal.getTimezoneOffset() * 60000;
    const hariIni = new Date(waktuLokal - offset).toISOString().split("T")[0];

    const inputStart = document.getElementById("filter-gaji-start");
    const inputEnd = document.getElementById("filter-gaji-end");
    if (inputStart && inputEnd) {
      inputStart.min = awalTahun;
      inputStart.max = hariIni;
      inputStart.value = awalTahun;

      inputEnd.min = awalTahun;
      inputEnd.max = hariIni;
      inputEnd.value = hariIni;
    }

    // ==========================================
    // 1. FETCH DATA KEUANGAN (CLIENT-SIDE)
    // ==========================================
    async function loadKeuanganData() {
      if (!window.supabase) return;
      try {
        const { data: listMitra } = await window.supabase
          .from("mitra")
          .select("id, nama_mitra")
          .order("nama_mitra", { ascending: true });
        window.allMitraGlobal = listMitra || [];
        const { data: globalGaji } = await window.supabase
          .from("pengaturan_gaji_global")
          .select("*")
          .single();
        dataGlobalGaji = globalGaji;
        if (globalGaji) {
          document.getElementById("g_kesehatan").value =
            globalGaji.uang_kesehatan || 0;
          document.getElementById("g_tepatwaktu").value =
            globalGaji.bonus_tepat_waktu || 0;
          document.getElementById("g_mingguan").value =
            globalGaji.bonus_mingguan || 0;
          document.getElementById("g_lembur").value =
            globalGaji.tarif_lembur_perjam || 0;
        }

        const { data: karyawan, error: errKaryawan } = await window.supabase
          .from("profiles")
          .select(
            "id, nama, role, foto_profil, setup_gaji(*), presensi(tanggal, status_tiba, waktu_tiba, waktu_pulang), slip_gaji(*)",
          )
          .neq("role", "owner");

        if (errKaryawan) {
          alert("Error Supabase (Data Karyawan): " + errKaryawan.message);
          console.error("Detail Error:", errKaryawan);
        }

        dataKaryawan = karyawan || [];
        const contKaryawan = document.getElementById("gaji-karyawan-container");
        let htmlKaryawan = "";
        if (dataKaryawan.length > 0) {
          dataKaryawan.forEach((k) => {
            const jumlahHadir = k.presensi?.length || 0;
            // 🔥 Ambil 2 huruf depan untuk inisial (misal: "Budi Santoso" -> "BS")
            const inisial = k.nama
              ? k.nama
                  .split(" ")
                  .map((n) => n[0])
                  .join("")
                  .substring(0, 2)
                  .toUpperCase()
              : "U";

            // 🔥 Beri warna hijau elegan khas Keuangan jika pakai inisial
            const avatarKomponen = k.foto_profil
              ? `<img src="${k.foto_profil}" class="w-12 h-12 rounded-full object-cover border-2 border-green-200 shadow-sm shrink-0" />`
              : `<div class="w-12 h-12 rounded-full bg-green-100 border border-green-200 flex items-center justify-center text-green-700 font-bold text-lg shadow-sm shrink-0">${inisial}</div>`;

            const peran = k.tipe_kendaraan
              ? k.tipe_kendaraan.replace("_", " ")
              : k.role || "Karyawan";
            const setup =
              k.setup_gaji && k.setup_gaji.length > 0 ? k.setup_gaji[0] : {};
            const tarif = Number(setup.gaji_menit || 0).toLocaleString("id-ID");

            // 🔥 TAHAP 2: BIKIN BADGE INDIKATOR GAJI FLAT / BYPASS
            const badgeBypass = setup.bypass_jam_kerja
              ? `<span class="px-2 py-0.5 rounded text-[9px] font-black bg-purple-100 text-purple-700 border border-purple-200 uppercase tracking-wider shadow-sm flex items-center gap-0.5 font-sans"><i class="bi bi-lightning-charge-fill"></i> Gaji Flat</span>`
              : "";

            htmlKaryawan += `
                    <div class="karyawan-card bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden flex flex-col transition-all" data-periode="Bulanan">
                        <div class="bg-gradient-to-r from-green-50 to-green-100 px-6 py-4 flex items-center justify-between border-b border-green-200">
                            <div class="flex items-center gap-4">
                                ${avatarKomponen} 
                                <div>
                                    <h3 class="font-bold text-gray-900 flex items-center gap-1.5 flex-wrap">
                                        ${k.nama} 
                                        <span class="px-2 py-0.5 rounded text-[9px] font-black bg-blue-200 text-blue-800 uppercase tracking-wider shadow-sm">MINGGUAN</span>
                                        ${badgeBypass}
                                    </h3>
                                    <p class="text-xs font-semibold text-gray-600 capitalize mt-0.5">${peran}</p>
                                </div>
                            </div>
                        </div>
                        <div class="p-6 flex-1 flex flex-col">
                            <div class="space-y-2 mb-6 text-sm">
                                <div class="flex justify-between"><span class="text-gray-500">Gaji per Mingguan:</span> <span class="font-medium text-gray-900">Rp ${tarif}</span></div>
                                <div class="flex justify-between"><span class="text-gray-500">Hadir Bulan Ini:</span> <span class="font-medium text-green-600">${jumlahHadir} Hari</span></div>
                            </div>
                            <button onclick="window.openModalGaji('${k.id}')" class="mt-auto w-full flex items-center justify-center gap-2 px-4 py-3 bg-white border-2 border-green-700 text-green-700 rounded-xl font-bold hover:bg-green-50 transition active:scale-95">
                                <i class="bi bi-calculator"></i> Setup & Slip Gaji
                            </button>
                        </div>
                    </div>`;
          });
        } else {
          htmlKaryawan =
            '<p class="text-gray-500">Belum ada data karyawan.</p>';
        }
        contKaryawan.innerHTML = htmlKaryawan;

        // TAMBAHAN: Isi dropdown filter riwayat otomatis
        const filterUserEl = document.getElementById("filter-gaji-user");
        if (filterUserEl && dataKaryawan.length > 0) {
          let userOptions = '<option value="semua">Semua Karyawan</option>';
          dataKaryawan.forEach((k) => {
