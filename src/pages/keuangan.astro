    window.nextEditStep = function() {
        document.getElementById('edit-step-1').classList.replace('flex', 'hidden');
        document.getElementById('footer-edit-1').classList.replace('flex', 'hidden');
        document.getElementById('edit-step-2').classList.replace('hidden', 'flex');
        document.getElementById('footer-edit-2').classList.replace('hidden', 'flex');
    };
    
    window.prevEditStep = function() {
        document.getElementById('edit-step-2').classList.replace('flex', 'hidden');
        document.getElementById('footer-edit-2').classList.replace('flex', 'hidden');
        document.getElementById('edit-step-1').classList.replace('hidden', 'flex');
        document.getElementById('footer-edit-1').classList.replace('hidden', 'flex');
    };

    // ==========================================
    // FUNGSI PENGATUR NAVIGASI 3 STEP EDIT
    // ==========================================
    window.goToEditStep = function(stepNum) {
        // Sembunyikan semua step dan footer
        const steps = [1, 2, 3];
        steps.forEach(num => {
            const stepEl = document.getElementById(`edit-step-${num}`);
            const footEl = document.getElementById(`footer-edit-${num}`);
            if(stepEl) stepEl.classList.replace('flex', 'hidden');
            
            // 🔥 FIX: Footer diubah dari flex kembali ke hidden
            if(footEl) footEl.classList.replace('flex', 'hidden'); 
        });

        // Tampilkan step aktif
        const activeStep = document.getElementById(`edit-step-${stepNum}`);
        const activeFoot = document.getElementById(`footer-edit-${stepNum}`);
        if(activeStep) activeStep.classList.replace('hidden', 'flex');
        
        // 🔥 FIX: Footer yang tadinya hidden diubah jadi flex (Biar ujung ketemu ujung)
        if(activeFoot) activeFoot.classList.replace('hidden', 'flex'); 

        // Update Teks Indikator Judul
        const indicator = document.getElementById('edit-step-indicator');
        if(indicator) {
            if(stepNum === 1) indicator.innerText = "Langkah 1 dari 3: Data Pokok";
            if(stepNum === 2) indicator.innerText = "Langkah 2 dari 3: Komoditas & Harga";
            if(stepNum === 3) indicator.innerText = "Langkah 3 dari 3: Informasi Pembayaran";
        }
    };

