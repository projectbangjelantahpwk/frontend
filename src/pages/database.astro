    // ==========================================
    let historyGajiMap = {};
    let slipGajiLengkap = [];
    let manualDatePicker = null;

    window.initGajiManual = async function () {
      const client = window.supabase || supabase;
      const selEmp = document.getElementById("manual_emp_id");

      try {
        // 1. Tarik Data Karyawan
        const { data: karyawan } = await client
          .from("profiles")
          .select("id, nama, role")
          .neq("role", "owner");
        if (selEmp && karyawan) {
          selEmp.innerHTML =
            '<option value="" disabled selected>-- Pilih Karyawan --</option>';
          karyawan.forEach((k) => {
            selEmp.innerHTML += `<option value="${k.id}">${k.nama} (${k.role})</option>`;
          });
        }

        // 2. Tarik Seluruh Data Slip Gaji (SUPER LENGKAP BUAT EDIT)
        const { data: semuaSlip } = await client
          .from("slip_gaji")
          .select(
            "id, user_id, periode, gaji_karyawan, uang_lembur, uang_makan, uang_kesehatan, bonus_tepat_waktu, bonus_mingguan, uang_transport, uang_talangan, kasbon, total_diterima, status",
          )
          .order("periode", { ascending: false });

        slipGajiLengkap = semuaSlip || [];
        historyGajiMap = {};

        slipGajiLengkap.forEach((slip) => {
          if (!historyGajiMap[slip.user_id]) historyGajiMap[slip.user_id] = [];
          if (slip.periode) historyGajiMap[slip.user_id].push(slip.periode);
        });
      } catch (e) {
        console.error("Gagal meload data gaji manual:", e);
      }

      // Siapkan Flatpickr Kalender Kosong
      const tglInput = document.getElementById("manual_periode");
      if (tglInput) {
        const kemarin = new Date();
        kemarin.setDate(kemarin.getDate() - 1);

        if (manualDatePicker) manualDatePicker.destroy();
        manualDatePicker = flatpickr(tglInput, {
          dateFormat: "Y-m-d",
          maxDate: kemarin,
          disable: [],
        });
      }
    };

    // Sensor Dropdown Karyawan
    document
      .getElementById("manual_emp_id")
      ?.addEventListener("change", function () {
        const empId = this.value;
        const namaKaryawan = this.options[this.selectedIndex].text;

        // Reset ID Edit jika pindah karyawan
        document.getElementById("manual_edit_slip_id").value = "";
        resetTombolSubmit();

        const tglInput = document.getElementById("manual_periode");
        tglInput.disabled = false;
        tglInput.placeholder = "Pilih Tanggal...";
        tglInput.value = "";

        const disabledDates = historyGajiMap[empId] || [];
        if (manualDatePicker) {
          manualDatePicker.set("disable", disabledDates);
        }

        // Render Riwayat di Panel Kanan (+ TOMBOL EDIT)
        document.getElementById("label_riwayat_nama").innerText = namaKaryawan;
        const containerRiwayat = document.getElementById(
          "container_riwayat_manual",
        );
        const riwayatKaryawan = slipGajiLengkap.filter(
          (s) => s.user_id === empId,
        );

        if (riwayatKaryawan.length === 0) {
          containerRiwayat.innerHTML = `<p class="text-center text-gray-500 text-xs mt-4 italic">Belum ada riwayat gaji.</p>`;
        } else {
          containerRiwayat.innerHTML = riwayatKaryawan
            .map(
              (slip) => `
                <div class="bg-white p-3 rounded-lg border border-gray-200 shadow-sm flex justify-between items-center hover:bg-gray-50 transition">
                    <div>
                        <p class="text-xs font-bold text-gray-900 mb-0.5">${slip.periode}</p>
                        <p class="text-[10px] text-gray-500 font-mono">Rp ${Number(slip.total_diterima).toLocaleString("id-ID")}</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded text-[9px] font-bold tracking-wider ${slip.status === "ACC" || slip.status === "Disetujui" ? "bg-green-100 text-green-800" : "bg-amber-100 text-amber-800"} uppercase">
                            ${slip.status}
                        </span>
                        <button type="button" onclick="window.editRiwayatManual(${slip.id})" class="text-blue-600 hover:text-blue-800 bg-blue-50 px-2 py-1 rounded text-[10px] font-bold border border-blue-200 transition shadow-sm">
                            <i class="bi bi-pencil-square"></i> Edit
                        </button>
                    </div>
                </div>
            `,
            )
            .join("");
        }
      });

    // 🔥 FUNGSI BARU: TARIK DATA LAMA KE FORM KIRI 🔥
    window.editRiwayatManual = function (slipId) {
      const slip = slipGajiLengkap.find((s) => String(s.id) === String(slipId));
      if (!slip) return;

      // 1. Simpan ID ke input rahasia
      document.getElementById("manual_edit_slip_id").value = slip.id;

      // 2. Set Kalender ke tanggal yang mau diedit
      if (manualDatePicker) {
        manualDatePicker.setDate(slip.periode);
      }
      document.getElementById("manual_periode").value = slip.periode;

      // 3. Isi semua form
      document.getElementById("manual_gaji").value = slip.gaji_karyawan || 0;
      document.getElementById("manual_lembur").value = slip.uang_lembur || 0;
      document.getElementById("manual_makan").value = slip.uang_makan || 0;
      document.getElementById("manual_kesehatan").value =
        slip.uang_kesehatan || 0;
      document.getElementById("manual_bonus_tepat").value =
        slip.bonus_tepat_waktu || 0;
      document.getElementById("manual_bonus_mingguan").value =
        slip.bonus_mingguan || 0;
      document.getElementById("manual_transport").value =
        slip.uang_transport || 0;
      document.getElementById("manual_talangan").value =
        slip.uang_talangan || 0;
      document.getElementById("manual_kasbon").value = slip.kasbon || 0;

      hitungGrandTotalManual();

      // 4. Ubah Tombol Submit jadi Mode Update
      const btn = document.getElementById("btn-submit-manual");
      btn.innerHTML = `<i class="bi bi-pencil-square"></i> Update Data Gaji`;
      btn.classList.replace("bg-gray-900", "bg-blue-700");
      btn.classList.replace("hover:bg-black", "hover:bg-blue-800");

      // Gulir layar ke form (Buat user HP biar enak)
      document
        .getElementById("form-gaji-manual")
        .scrollIntoView({ behavior: "smooth" });
    };

    // Fungsi Pembantu: Kembalikan tombol ke mode Insert
    function resetTombolSubmit() {
      const btn = document.getElementById("btn-submit-manual");
      btn.innerHTML = `<i class="bi bi-cloud-arrow-up"></i> Simpan ke slip_gaji`;
      btn.classList.replace("bg-blue-700", "bg-gray-900");
      btn.classList.replace("hover:bg-blue-800", "hover:bg-black");
      document.getElementById("manual_edit_slip_id").value = "";
    }

    // Kalkulator Realtime UI
    const hitungGrandTotalManual = () => {
      const pGaji =
        parseFloat(document.getElementById("manual_gaji").value) || 0;
      const pLembur =
        parseFloat(document.getElementById("manual_lembur").value) || 0;
      const pMakan =
        parseFloat(document.getElementById("manual_makan").value) || 0;
      const pTransport =
        parseFloat(document.getElementById("manual_transport").value) || 0;
      const pTalangan =
        parseFloat(document.getElementById("manual_talangan").value) || 0;
      const pKes =
        parseFloat(document.getElementById("manual_kesehatan").value) || 0;
      const pBTepat =
        parseFloat(document.getElementById("manual_bonus_tepat").value) || 0;
      const pBMinggu =
        parseFloat(document.getElementById("manual_bonus_mingguan").value) || 0;
      const pKasbon =
        parseFloat(document.getElementById("manual_kasbon").value) || 0;

      let total =
        pGaji +
        pLembur +
        pMakan +
        pKes +
        pBTepat +
        pBMinggu +
        pKes +
        pBTepat +
        pBMinggu -
        pKasbon;
      if (total < 0) total = 0;

      document.getElementById("manual_grandtotal").innerText =
        `Rp ${total.toLocaleString("id-ID")}`;
      return total;
    };

    [
      "manual_gaji",
      "manual_lembur",
      "manual_makan",
      "manual_transport",
      "manual_talangan",
      "manual_kesehatan",
      "manual_bonus_tepat",
      "manual_bonus_mingguan",
      "manual_kasbon",
    ].forEach((id) => {
      document
        .getElementById(id)
        ?.addEventListener("input", hitungGrandTotalManual);
    });

    // EKSEKUSI INSERT ATAU UPDATE KE DATABASE SUPABASE
    document
      .getElementById("form-gaji-manual")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const client = window.supabase || supabase;
        const empId = document.getElementById("manual_emp_id").value;
        const periode = document.getElementById("manual_periode").value;
        const editSlipId = document.getElementById("manual_edit_slip_id").value; // Cek Mode

        if (!empId || !periode)
          return alert("Pilih Karyawan dan Tanggal Periode dulu!");

        const aksiTeks = editSlipId ? "meng-update" : "menembak";
        if (
          !confirm(
            `Yakin ingin ${aksiTeks} data gaji lampau untuk periode ${periode}?`,
          )
        )
          return;

        const btn = document.getElementById("btn-submit-manual");
        const oldText = btn.innerHTML;
        btn.innerHTML = `<i class="bi bi-hourglass-split animate-spin"></i> Memproses...`;
        btn.disabled = true;

        const grandTotal = hitungGrandTotalManual();

        try {
          const payload = {
            user_id: empId,
            periode: periode,
            gaji_karyawan:
              parseFloat(document.getElementById("manual_gaji").value) || 0,
            uang_lembur:
              parseFloat(document.getElementById("manual_lembur").value) || 0,
            uang_makan:
              parseFloat(document.getElementById("manual_makan").value) || 0,
            uang_transport:
              parseFloat(document.getElementById("manual_transport").value) ||
              0,
            uang_talangan:
              parseFloat(document.getElementById("manual_talangan").value) || 0,
            uang_kesehatan:
              parseFloat(document.getElementById("manual_kesehatan").value) ||
              0,
            bonus_tepat_waktu:
              parseFloat(document.getElementById("manual_bonus_tepat").value) ||
              0,
            bonus_mingguan:
              parseFloat(
                document.getElementById("manual_bonus_mingguan").value,
              ) || 0,
            kasbon:
              parseFloat(document.getElementById("manual_kasbon").value) || 0,
            total_diterima: grandTotal,
            status: "ACC",
            is_paid_by_admin: true,
            kas_keuangan_terpakai: grandTotal,
            kas_gudang_terpakai: 0,
            kas_owner_terpakai: 0,
          };

          if (editSlipId) {
            // JIKA MODE EDIT (UPDATE)
            const { error } = await client
              .from("slip_gaji")
              .update(payload)
              .eq("id", editSlipId);
            if (error) throw error;
            alert("✅ Data gaji lampau berhasil di-UPDATE!");
          } else {
            // JIKA MODE BARU (INSERT)
            const { error } = await client.from("slip_gaji").insert([payload]);
            if (error) throw error;
            alert("✅ Data gaji lampau berhasil ditambahkan!");
          }

          // Bersihkan form & segarkan riwayat
          await initGajiManual();
          document.getElementById("form-gaji-manual").reset();
          document.getElementById("manual_grandtotal").innerText = `Rp 0`;
          resetTombolSubmit();

          // Trigger ulang dropdown biar panel kanan langsung refresh datanya
          const event = new Event("change");
          document.getElementById("manual_emp_id").dispatchEvent(event);
        } catch (err) {
          alert("Gagal memproses data: " + err.message);
        } finally {
          btn.innerHTML = oldText;
          btn.disabled = false;
        }
      });
  </script>
</GeneralLayout>
