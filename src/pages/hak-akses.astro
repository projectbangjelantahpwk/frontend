---
import GeneralLayout from "../layouts/Layout.astro";
import "bootstrap-icons/font/bootstrap-icons.css";

// Ambil data Profiles dari Supabase

const roles = [
  { value: "owner", label: "Owner" },
  { value: "hrd", label: "HRD" },
  { value: "keuangan", label: "Keuangan" },
  { value: "admin", label: "Admin Oprasional" },
  { value: "it", label: "IT Support" },
  { value: "buzzer", label: "Buzzer" },
  { value: "sosmed", label: "Social Media" },
  { value: "periklanan", label: "Periklanan (Marketing)" },
  { value: "gudang", label: "Gudang" },
  { value: "lapangan", label: "Lapangan (Supir/Kenek)" },
  { value: "canvasser", label: "Canvasser" },
  { value: "guest", label: "Guest (Read-Only)" },
];

const getRoleColor = (role) => {
  if (role === "owner") return "bg-purple-100 text-purple-700";
  if (role === "hrd") return "bg-pink-100 text-pink-700";
  if (role === "keuangan") return "bg-blue-100 text-blue-700";
  if (role === "admin") return "bg-orange-100 text-orange-700";
  if (role === "it") return "bg-gray-800 text-white";
  if (role === "buzzer") return "bg-yellow-100 text-yellow-800";
  if (role === "sosmed") return "bg-rose-100 text-rose-700";
  if (role === "gudang") return "bg-blue-200 text-orange-700";
  if (role === "periklanan") return "bg-teal-100 text-teal-700";
  if (role === "lapangan") return "bg-green-100 text-green-700";
  if (role === "canvasser") return "bg-green-200 text-green-800";
  return "bg-gray-100 text-gray-700";
};
---

<GeneralLayout title="Hak Akses & Akun - Manajemen Bang Jelantah">
  <style is:global>
    /* Mengunci layar menjadi blank (putih) sampai skrip memberi izin masuk */
    body {
      display: none;
    }
  </style>
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        Manajemen Hak Akses & Akun
      </h1>
      <p class="text-gray-600">
        Kelola profil, foto, role, dan izin login karyawan.
      </p>
    </div>
    <button
      id="openFormBtn"
      class="flex items-center gap-2 px-6 py-2 bg-green-700 text-white rounded-lg hover:bg-green-800 transition font-medium"
    >
      <i class="bi bi-person-plus-fill"></i>
      <span>Buat Akun Karyawan</span>
    </button>
  </div>

  <div
    class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm"
  >
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200">
            <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
              >Pengguna</th
            >
            <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
              >Username / ID</th
            >
            <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
              >Kontak & Alamat</th
            >
            <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
              >Role Sistem</th
            >
            <th class="px-6 py-4 text-left text-sm font-bold text-gray-900"
              >Aksi</th
            >
          </tr>
        </thead>
        <tbody id="tabelKaryawan">
          <tr
            ><td colspan="5" class="text-center py-4"
              >Memuat data karyawan...</td
            ></tr
          >
        </tbody>
      </table>
    </div>
  </div>
</GeneralLayout>

<div
  id="formModal"
  class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0"
>
  <div
    class="bg-white rounded-2xl max-w-xl w-full max-h-screen overflow-y-auto transform scale-95 transition-transform duration-300"
  >
    <div
      class="sticky top-0 bg-white border-b border-gray-100 px-6 py-4 flex items-center justify-between z-10"
    >
      <h2 id="modalTitle" class="text-xl font-bold text-gray-900">
        Buat Akun Karyawan
      </h2>
      <button id="closeFormBtn" class="text-gray-400 hover:text-gray-600"
        ><i class="bi bi-x-lg text-xl"></i></button
      >
    </div>

    <form id="employeeForm" class="p-6 space-y-6">
      <input type="hidden" id="editId" value="" />

      <div class="flex flex-col items-center gap-3">
        <div
          class="w-24 h-24 rounded-full bg-gray-100 border-2 border-dashed border-gray-300 flex items-center justify-center overflow-hidden relative cursor-pointer hover:border-green-600 transition"
          id="photoContainer"
        >
          <i class="bi bi-camera text-2xl text-gray-400" id="photoIcon"></i>
          <img
            id="photoPreview"
            class="absolute inset-0 w-full h-full object-cover hidden"
          />
        </div>
        <input type="file" id="fotoInput" accept="image/*" class="hidden" />
        <button
          type="button"
          class="text-xs font-bold text-green-700 hover:underline"
          onclick="document.getElementById('fotoInput').click()"
          >Pilih Foto Profil</button
        >
      </div>

      <div>
        <h3 class="text-sm font-bold text-gray-900 mb-3 border-b pb-2">
          Identitas Personal
        </h3>
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Nama Lengkap</label
            >
            <input
              type="text"
              id="namaInput"
              placeholder="Contoh: Budi Jelantah"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:border-green-700 focus:ring-1 focus:ring-green-700"
              required
            />
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >No. Handphone / WhatsApp</label
            >
            <input
              type="tel"
              id="teleponInput"
              placeholder="0812xxxx"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:border-green-700 focus:ring-1 focus:ring-green-700"
              required
            />
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Alamat Domisili</label
            >
            <textarea
              id="alamatInput"
              placeholder="Jl. Raya Purwakarta No. 123"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:border-green-700 focus:ring-1 focus:ring-green-700"
              rows="2"
              required></textarea>
          </div>
        </div>
      </div>

      <div>
        <h3 class="text-sm font-bold text-gray-900 mb-3 border-b pb-2">
          Role & Kredensial Sistem
        </h3>
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Role / Peran</label
            >
            <select
              id="roleInput"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:border-green-700 focus:ring-1 focus:ring-green-700 bg-green-50"
              required
            >
              <option value="">-- Pilih Role Terlebih Dahulu --</option>
              {
                roles.map((role) => (
                  <option value={role.value}>{role.label}</option>
                ))
              }
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Username / ID Karyawan (Otomatis)</label
            >
            <input
              type="text"
              id="usernameInput"
              placeholder="Pilih Role untuk generate ID..."
              class="w-full px-4 py-2 border border-gray-300 bg-gray-100 rounded-lg outline-none font-bold text-gray-600"
              readonly
              required
            />
            <p class="text-[10px] text-gray-500 mt-1">
              Digunakan sebagai Username login aplikasi.
            </p>
          </div>

          <div id="passwordFieldContainer">
            <label class="block text-xs font-bold text-gray-700 mb-1"
              >Password Baru</label
            >
            <div class="relative">
              <input
                type="password"
                id="passwordInput"
                placeholder="Minimal 6 karakter"
                class="w-full px-4 py-2 pr-20 border border-gray-300 rounded-lg outline-none focus:border-green-700 focus:ring-1 focus:ring-green-700"
              />
              <div class="absolute right-3 top-1.5 flex items-center gap-1">
                <button
                  type="button"
                  id="togglePassBtn"
                  class="text-gray-500 hover:text-green-700"
                  title="Tampilkan/Sembunyikan password"
                  ><i class="bi bi-eye font-bold text-lg"></i></button
                >
                <button
                  type="button"
                  id="generatePassBtn"
                  class="text-gray-600 hover:text-green-700"
                  ><i class="bi bi-arrow-repeat font-bold text-lg"></i></button
                >
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="flex gap-3 pt-4">
        <button
          type="button"
          id="cancelBtn"
          class="flex-1 px-6 py-3 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 font-bold transition"
          >Batal</button
        >
        <button
          type="submit"
          id="submitBtn"
          class="flex-1 px-6 py-3 bg-green-700 text-white rounded-xl hover:bg-green-800 font-bold transition shadow-sm"
          >Simpan Akun</button
        >
      </div>
    </form>
  </div>
</div>

<script>
  import { supabase } from "../lib/supabase.js";
  import { createClient } from "@supabase/supabase-js";

  document.addEventListener("DOMContentLoaded", async function () {
    // === 🛡️ GATEKEEPER KEUANGAN ===
    const allowedRoles = ["owner", "hrd", "it"];
    const client = window.supabase || supabase;

    const {
      data: { session },
    } = await client.auth.getSession();
    if (!session) return window.location.replace("/"); // Tendang kalau belum login

    const { data: prof } = await client
      .from("profiles")
      .select("role")
      .eq("id", session.user.id)
      .single();
    if (!allowedRoles.includes(prof?.role)) {
      alert(
        `Akses Ditolak! Role Anda (${prof?.role || "Guest"}) dilarang masuk ke Halaman Ini.`,
      );
      return window.location.replace("/");
    }
    document.body.style.display = "block"; // Buka gembok CSS, tampilkan layar!

    // 1. Ambil Role Current User (Langsung gunakan 'prof' dari Gatekeeper)
    if (!window.supabase) return;
    let currentUserRole = prof?.role || "admin";

    // 2. Fungsi Warna Role untuk Client-Side
    const getRoleColorJs = (role) => {
      if (role === "owner") return "bg-purple-100 text-purple-700";
      if (role === "hrd") return "bg-pink-100 text-pink-700";
      if (role === "keuangan") return "bg-blue-100 text-blue-700";
      if (role === "admin") return "bg-orange-100 text-orange-700";
      if (role === "it") return "bg-gray-800 text-white";
      if (role === "buzzer") return "bg-yellow-100 text-yellow-800";
      if (role === "sosmed") return "bg-rose-100 text-rose-700";
      if (role === "gudang") return "bg-blue-200 text-orange-700"; // Memperbaiki nama class dari sky-blue-400
      if (role === "periklanan") return "bg-teal-100 text-teal-700";
      if (role === "lapangan") return "bg-green-100 text-green-700";
      if (role === "canvasser") return "bg-green-200 text-green-800";
      return "bg-gray-100 text-gray-700";
    };

    // 3. Modals & Forms Elements
    const formModal = document.getElementById("formModal");
    const openFormBtn = document.getElementById("openFormBtn");
    const closeFormBtn = document.getElementById("closeFormBtn");
    const cancelBtn = document.getElementById("cancelBtn");
    const employeeForm = document.getElementById("employeeForm");

    // 4. Fetch dan Render Data Karyawan
    async function loadKaryawan() {
      const { data: karyawan, error } = await window.supabase
        .from("profiles")
        .select("*")
        .order("created_at", { ascending: false });

      if (error) {
        console.error("Gagal ambil data", error);
        document.getElementById("tabelKaryawan").innerHTML =
          '<tr><td colspan="5" class="text-center py-4 text-red-500 font-bold">Gagal memuat data!</td></tr>';
        return;
      }

      const tbody = document.getElementById("tabelKaryawan");
      let html = "";

      karyawan.forEach((item) => {
        // Fungsi escape HTML untuk cegah XSS
        function escH(str) {
          if (!str) return "";
          const d = document.createElement("div");
          d.appendChild(document.createTextNode(str));
          return d.innerHTML;
        }

        const roleColor = getRoleColorJs(item.role);
        const initial = item.nama
          ? item.nama.substring(0, 2).toUpperCase()
          : "US";
        const safeNama = escH(item.nama || "");
        const safeFoto = escH(item.foto_profil || "");
        const safeIdLap = escH(item.id_lapangan || "");
        const safeTelp = escH(item.nomor_hp || "");
        const safeAlamat = escH(item.alamat || "");
        const safeRole = escH(item.role || "");
        const safeTipe = escH(
          item.tipe_kendaraan
            ? item.tipe_kendaraan.replace("_", " ")
            : item.role,
        );

        const avatarHtml = item.foto_profil
          ? `<img src="${safeFoto}" alt="Avatar" class="w-10 h-10 rounded-full object-cover border border-gray-200" />`
          : `<div class="w-10 h-10 rounded-full bg-green-700 text-white flex items-center justify-center font-bold text-sm">${initial}</div>`;

        const alamatTeks = item.alamat ? item.alamat : "Alamat belum diatur";
        const teleponTeks = item.nomor_hp ? item.nomor_hp : "-";

        html += `
            <tr class="border-b border-gray-200 hover:bg-gray-50 transition">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  ${avatarHtml}
                  <div>
                    <p class="font-bold text-gray-900">${safeNama}</p>
                    <p class="text-xs text-gray-500 capitalize">${safeTipe}</p>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm font-bold text-gray-800 bg-gray-100 px-3 py-1 rounded w-fit border border-gray-200">
                    <i class="bi bi-person-badge mr-1 text-gray-500"></i>${safeIdLap}
                </div>
              </td>
              <td class="px-6 py-4">
                <p class="text-sm text-gray-700 flex items-center gap-2 font-medium mb-1">
                  <i class="bi bi-telephone text-green-600"></i> ${safeTelp}
                </p>
                <p class="text-xs text-gray-500 line-clamp-1 max-w-[200px]" title="${escH(alamatTeks)}">${safeAlamat}</p>
              </td>
              <td class="px-6 py-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${roleColor}">
                  ${safeRole}
                </span>
              </td>
              <td class="px-6 py-4">
                <div class="flex flex-wrap gap-2">
                  <button class="edit-btn px-3 py-1 text-blue-600 hover:bg-blue-50 border border-blue-200 rounded transition font-medium text-sm shadow-sm" 
                    data-emp="${escH(item.id)}" data-nama="${safeNama}" data-username="${safeIdLap}" data-telepon="${safeTelp}" data-alamat="${safeAlamat}" data-role="${safeRole}">
                    <i class="bi bi-pencil mr-1"></i> Edit
                  </button>
                  
                  <button class="btn-reset-pass px-3 py-1 text-orange-600 hover:bg-orange-50 border border-orange-200 rounded transition font-medium text-sm shadow-sm" title="Reset Password"
                    data-emp-id="${escH(item.id)}" data-emp-nama="${safeNama}">
                    <i class="bi bi-key mr-1"></i> Reset Pass
                  </button>

                  <button class="btn-hapus-akun px-3 py-1 text-red-600 hover:bg-red-50 border border-red-200 rounded transition font-medium text-sm shadow-sm" title="Hapus Akun Permanen"
                    data-emp-id="${escH(item.id)}" data-emp-nama="${safeNama}">
                    <i class="bi bi-trash mr-1"></i> Hapus
                  </button>
                </div>
              </td>
            </tr>
            `;
      });

      tbody.innerHTML = html;

      document.querySelectorAll(".edit-btn").forEach((btn) => {
        btn.addEventListener("click", function () {
          if (currentUserRole !== "owner" && currentUserRole !== "hrd") {
            return alert(
              "Akses Ditolak: Hanya Owner dan HRD yang berhak mengedit data profil!",
            );
          }

          document.getElementById("modalTitle").textContent = "Edit Karyawan";
          document.getElementById("editId").value =
            this.getAttribute("data-emp");
          document.getElementById("namaInput").value =
            this.getAttribute("data-nama");
          document.getElementById("usernameInput").value =
            this.getAttribute("data-username");
          document.getElementById("teleponInput").value =
            this.getAttribute("data-telepon");
          document.getElementById("alamatInput").value =
            this.getAttribute("data-alamat");
          document.getElementById("roleInput").value =
            this.getAttribute("data-role");

          document.getElementById("passwordInput").required = false;
          document.getElementById("passwordFieldContainer").style.display =
            "none";

          formModal.classList.remove("hidden");
          formModal.classList.add("flex");
          setTimeout(() => {
            formModal.classList.remove("opacity-0");
            formModal.querySelector("div").classList.remove("scale-95");
          }, 10);
        });
      });
    }

    // Panggil fungsi render utama
    loadKaryawan();

    // =======================================================
    // SISA LOGIKA FORM, ID GENERATOR, DAN SUBMIT
    // =======================================================

    document
      .getElementById("roleInput")
      .addEventListener("change", async function () {
        const role = this.value;
        const usernameInput = document.getElementById("usernameInput");
        if (document.getElementById("editId").value !== "") return;
        if (!role) {
          usernameInput.value = "";
          return;
        }

        usernameInput.value = "Membuat ID...";

        // Pengecekan prefix berdasarkan array role lapangan
        const lapRoles = ["lapangan", "canvasser", "gudang"];
        // CUSTOM DI SINI: Ubah format teks ID untuk Lapangan dan CMS
        const formatLap = "LAP-";
        const formatCms = "CMS-";

        const prefix = lapRoles.includes(role) ? formatLap : formatCms;

        try {
          const { data, error } = await window.supabase
            .from("profiles")
            .select("id_lapangan")
            .like("id_lapangan", `${prefix}%`)
            .order("id_lapangan", { ascending: false })
            .limit(1);

          let nextNum = 1;
          if (data && data.length > 0 && data[0].id_lapangan) {
            const numPart = data[0].id_lapangan.split("-")[1];
            if (numPart && !isNaN(parseInt(numPart)))
              nextNum = parseInt(numPart) + 1;
          }
          usernameInput.value = prefix + String(nextNum).padStart(3, "0");
        } catch (err) {
          console.error("Gagal generate ID:", err);
          usernameInput.value = prefix + "ERR";
        }
      });

    const fotoInput = document.getElementById("fotoInput");
    const photoPreview = document.getElementById("photoPreview");
    const photoIcon = document.getElementById("photoIcon");

    fotoInput.addEventListener("change", function (e) {
      if (this.files && this.files[0]) {
        const reader = new FileReader();
        reader.onload = function (e) {
          photoPreview.src = e.target.result;
          photoPreview.classList.remove("hidden");
          photoIcon.classList.add("hidden");
        };
        reader.readAsDataURL(this.files[0]);
      }
    });

    openFormBtn.addEventListener("click", () => {
      if (currentUserRole !== "owner" && currentUserRole !== "hrd")
        return alert(
          "Akses Ditolak: Hanya Owner dan HRD yang berhak membuat akun baru!",
        );

      document.getElementById("modalTitle").textContent = "Buat Akun Karyawan";
      document.getElementById("editId").value = "";
      document.getElementById("passwordInput").required = true;
      document.getElementById("passwordFieldContainer").style.display = "block";
      photoPreview.classList.add("hidden");
      photoIcon.classList.remove("hidden");
      fotoInput.value = "";
      employeeForm.reset();

      formModal.classList.remove("hidden");
      formModal.classList.add("flex");
      setTimeout(() => {
        formModal.classList.remove("opacity-0");
        formModal.querySelector("div").classList.remove("scale-95");
      }, 10);
    });

    const closeModal = () => {
      formModal.classList.add("opacity-0");
      formModal.querySelector("div").classList.add("scale-95");
      setTimeout(() => {
        formModal.classList.add("hidden");
        formModal.classList.remove("flex");
      }, 300);
    };
    closeFormBtn.addEventListener("click", closeModal);
    cancelBtn.addEventListener("click", closeModal);

    document.getElementById("togglePassBtn").addEventListener("click", () => {
      const passInput = document.getElementById("passwordInput");
      const icon = document.querySelector("#togglePassBtn i");
      if (passInput.type === "password") {
        passInput.type = "text";
        icon.classList.replace("bi-eye", "bi-eye-slash");
      } else {
        passInput.type = "password";
        icon.classList.replace("bi-eye-slash", "bi-eye");
      }
    });

    document.getElementById("generatePassBtn").addEventListener("click", () => {
      const chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789";
      let password = "";
      for (let i = 0; i < 8; i++)
        password += chars.charAt(Math.floor(Math.random() * chars.length));
      document.getElementById("passwordInput").value = password;
      // Tampilkan password setelah generate agar user bisa lihat
      const passInput = document.getElementById("passwordInput");
      const icon = document.querySelector("#togglePassBtn i");
      passInput.type = "text";
      icon.classList.replace("bi-eye", "bi-eye-slash");
    });

    // ==========================================
    // FUNGSI KOMPRESI GAMBAR (JADI KECIL & CEPAT)
    // ==========================================
    async function compressImage(file) {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = (event) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement("canvas");

            // Batasi ukuran maksimal (Resolusi) jadi 400x400 pixel (cukup banget buat Avatar)
            const MAX_SIZE = 400;
            let width = img.width;
            let height = img.height;

            if (width > height) {
              if (width > MAX_SIZE) {
                height *= MAX_SIZE / width;
                width = MAX_SIZE;
              }
            } else {
              if (height > MAX_SIZE) {
                width *= MAX_SIZE / height;
                height = MAX_SIZE;
              }
            }

            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext("2d");
            ctx.drawImage(img, 0, 0, width, height);

            // Kompresi ke format WebP (Kualitas 80%) - Dijamin < 100kb
            canvas.toBlob(
              (blob) => {
                const compressedFile = new File([blob], "avatar.webp", {
                  type: "image/webp",
                  lastModified: Date.now(),
                });
                resolve(compressedFile);
              },
              "image/webp",
              0.8,
            );
          };
          img.src = event.target.result;
        };
        reader.readAsDataURL(file);
      });
    }

    // ==========================================
    // SUBMIT DATA (DENGAN UPSERT & CACHE)
    // ==========================================
    employeeForm.addEventListener("submit", async function (e) {
      e.preventDefault();
      if (!window.supabase) return alert("Supabase tidak terhubung!");

      const btn = document.getElementById("submitBtn");
      btn.innerText = "Memproses...";
      btn.disabled = true;

      const editId = document.getElementById("editId").value;
      const nama = document.getElementById("namaInput").value;
      const username = document.getElementById("usernameInput").value;
      const password = document.getElementById("passwordInput").value;
      const telepon = document.getElementById("teleponInput").value;
      const alamat = document.getElementById("alamatInput").value;
      const role = document.getElementById("roleInput").value;
      const file = fotoInput.files[0];

      try {
        let finalAvatarUrl = null;

        if (file) {
          const compressedFile = await compressImage(file);
          const fileName = `${username}.webp`;

          // Pake supabase dari import aja biar bersih
          const { error: uploadErr } = await supabase.storage
            .from("avatars")
            .upload(fileName, compressedFile, {
              upsert: true,
              cacheControl: "31536000",
              contentType: "image/webp",
            });

          if (uploadErr) throw uploadErr;

          const { data: publicUrlData } = supabase.storage
            .from("avatars")
            .getPublicUrl(fileName);
          finalAvatarUrl = `${publicUrlData.publicUrl}?t=${Date.now()}`;
        }

        if (editId) {
          const updateData = { nama, nomor_hp: telepon, alamat, role };
          if (finalAvatarUrl) updateData.foto_profil = finalAvatarUrl;

          const { error } = await supabase
            .from("profiles")
            .update(updateData)
            .eq("id", editId);
          if (error) throw error;
          alert("Profil Karyawan berhasil diperbarui!");
        } else {
          // CUSTOM DI SINI: Atur nama domain email berdasarkan prefix Username-nya
          let emailDomain = "bangjelantah.local"; // Default

          if (username.startsWith("LAP-")) {
            // Jika akun lapangan
            emailDomain = "lap.bangjelantah.local";
          } else if (username.startsWith("CMS-")) {
            // Jika akun manajemen
            emailDomain = "cms.bangjelantah.local";
          }

          const dummyEmail = `${username}@bangjelantah.local`.toLowerCase();

          // 2. BIKIN CLIENT SEMENTARA LANGSUNG DARI ENV
          // Lu bisa panggil import.meta.env langsung di sini karena script ini udah di-bundle Astro
          const tempClient = createClient(
            import.meta.env.PUBLIC_SUPABASE_URL,
            import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
            {
              auth: {
                persistSession: false, // Aman dari auto-logout!
                autoRefreshToken: false,
              },
            },
          );

          // 3. Daftar pakai tempClient
          const { data: authData, error: authError } =
            await tempClient.auth.signUp({
              email: dummyEmail,
              password: password,
              options: {
                data: {
                  nama: nama,
                  role: role,
                  telepon: telepon,
                  alamat: alamat,
                },
              },
            });

          if (authError) throw authError;

          // 4. Update profil pakai client utama
          if (finalAvatarUrl) {
            await supabase
              .from("profiles")
              .update({ foto_profil: finalAvatarUrl })
              .eq("id", authData.user.id);
          }
          alert(
            `Karyawan berhasil didaftarkan!\n\nUsername Login: ${username}\nPassword: ${password}`,
          );
        }

        window.location.reload();
      } catch (err) {
        alert("Gagal: " + err.message);
        btn.innerText = "Simpan Akun";
        btn.disabled = false;
      }
    });
    // ==========================================
    // FUNGSI RESET PASSWORD (VIA RPC SUPABASE)
    // ==========================================
    window.resetPasswordKaryawan = async function (id, nama) {
      if (currentUserRole !== "owner" && currentUserRole !== "hrd")
        return alert(
          "Akses Ditolak: Hanya Owner dan HRD yang berhak mereset password!",
        );

      const newPass = prompt(
        `Masukkan password baru untuk ${nama}:\n(Minimal 6 karakter)`,
      );
      if (!newPass) return; // Batal jika kosong
      if (newPass.length < 6)
        return alert("Password gagal diubah: Minimal harus 6 karakter!");

      try {
        // Memanggil fungsi SQL yang sudah kita buat tadi
        const { error } = await window.supabase.rpc("reset_password_karyawan", {
          target_id: id,
          new_password: newPass,
        });
        if (error) throw error;

        alert(
          `Sukses! Password untuk ${nama} berhasil direset menjadi:\n\n${newPass}\n\nSilakan berikan password baru ini kepada yang bersangkutan.`,
        );
      } catch (err) {
        alert("Gagal mereset password: " + err.message);
      }
    };

    // ==========================================
    // FUNGSI HAPUS AKUN (VIA RPC SUPABASE)
    // ==========================================
    window.hapusAkunKaryawan = async function (id, nama) {
      if (currentUserRole !== "owner" && currentUserRole !== "hrd")
        return alert(
          "Akses Ditolak: Hanya Owner dan HRD yang berhak menghapus akun!",
        );

      if (
        !confirm(
          `YAKIN INGIN MENGHAPUS AKUN "${nama}"?\n\nPERINGATAN: Semua data profil, hak akses login, dan riwayat yang terhubung akan terhapus secara permanen!`,
        )
      )
        return;

      try {
        // Memanggil fungsi SQL penghapusan
        const { error } = await window.supabase.rpc("hapus_akun_karyawan", {
          uid: id,
        });
        if (error) throw error;

        alert(`Akun ${nama} berhasil dihapus permanen dari sistem.`);
        window.location.reload();
      } catch (err) {
        alert("Gagal menghapus akun: " + err.message);
      }
    };
  });
</script>
