---
import GeneralLayout from '../layouts/Layout.astro';
///import { supabase } from '../lib/supabase';
import 'bootstrap-icons/font/bootstrap-icons.css';

// Ambil data Profiles dari Supabase

const roles = [
  { value: 'owner', label: 'Owner' },
  { value: 'hrd', label: 'HRD' },
  { value: 'keuangan', label: 'Keuangan' },
  { value: 'admin', label: 'Admin (Gudang/Ops)' },
  { value: 'periklanan', label: 'Periklanan (Marketing)' },
  { value: 'lapangan', label: 'Lapangan (Supir/Kenek)' }
];

const getRoleColor = (role) => {
    if(role === 'owner') return 'bg-purple-100 text-purple-700';
    if(role === 'hrd') return 'bg-pink-100 text-pink-700';
    if(role === 'keuangan') return 'bg-blue-100 text-blue-700';
    if(role === 'admin') return 'bg-orange-100 text-orange-700';
    if(role === 'periklanan') return 'bg-teal-100 text-teal-700';
    if(role === 'lapangan') return 'bg-green-100 text-green-700';
    return 'bg-gray-100 text-gray-700';
};
---

<GeneralLayout title="Hak Akses & Akun - Manajemen Bang Jelantah">
  <style is:global>
    /* Mengunci layar menjadi blank (putih) sampai skrip memberi izin masuk */
    body { display: none; }
</style>
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Manajemen Hak Akses & Akun</h1>
      <p class="text-gray-600">Kelola profil, foto, role, dan izin login karyawan.</p>
    </div>
    <button id="openFormBtn" class="flex items-center gap-2 px-6 py-2 bg-green-700 text-white rounded-lg hover:bg-green-800 transition font-medium">
      <i class="bi bi-person-plus-fill"></i>
      <span>Buat Akun Karyawan</span>
    </button>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200">
            <th class="px-6 py-4 text-left text-sm font-bold text-gray-900">Pengguna</th>
            <th class="px-6 py-4 text-left text-sm font-bold text-gray-900">Username / ID</th>
            <th class="px-6 py-4 text-left text-sm font-bold text-gray-900">Kontak & Alamat</th>
            <th class="px-6 py-4 text-left text-sm font-bold text-gray-900">Role Sistem</th>
            <th class="px-6 py-4 text-left text-sm font-bold text-gray-900">Aksi</th>
          </tr>
        </thead>
        <tbody id="tabelKaryawan">
           <tr><td colspan="5" class="text-center py-4">Memuat data karyawan...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</GeneralLayout>

<div id="formModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0">
  <div class="bg-white rounded-2xl max-w-xl w-full max-h-screen overflow-y-auto transform scale-95 transition-transform duration-300">
    <div class="sticky top-0 bg-white border-b border-gray-100 px-6 py-4 flex items-center justify-between z-10">
      <h2 id="modalTitle" class="text-xl font-bold text-gray-900">Buat Akun Karyawan</h2>
      <button id="closeFormBtn" class="text-gray-400 hover:text-gray-600"><i class="bi bi-x-lg text-xl"></i></button>
    </div>

    <form id="employeeForm" class="p-6 space-y-6">
      <input type="hidden" id="editId" value="">

      <div class="flex flex-col items-center gap-3">
          <div class="w-24 h-24 rounded-full bg-gray-100 border-2 border-dashed border-gray-300 flex items-center justify-center overflow-hidden relative cursor-pointer hover:border-green-600 transition" id="photoContainer">
              <i class="bi bi-camera text-2xl text-gray-400" id="photoIcon"></i>
              <img id="photoPreview" class="absolute inset-0 w-full h-full object-cover hidden" />
          </div>
          <input type="file" id="fotoInput" accept="image/*" class="hidden">
          <button type="button" class="text-xs font-bold text-green-700 hover:underline" onclick="document.getElementById('fotoInput').click()">Pilih Foto Profil</button>
      </div>

      <div>
        <h3 class="text-sm font-bold text-gray-900 mb-3 border-b pb-2">Identitas Personal</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Nama Lengkap</label>
            <input type="text" id="namaInput" placeholder="Contoh: Budi Jelantah" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:border-green-700 focus:ring-1 focus:ring-green-700" required />
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">No. Handphone / WhatsApp</label>
            <input type="tel" id="teleponInput" placeholder="0812xxxx" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:border-green-700 focus:ring-1 focus:ring-green-700" required />
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Alamat Domisili</label>
            <textarea id="alamatInput" placeholder="Jl. Raya Purwakarta No. 123" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:border-green-700 focus:ring-1 focus:ring-green-700" rows="2" required></textarea>
          </div>
        </div>
      </div>

      <div>
        <h3 class="text-sm font-bold text-gray-900 mb-3 border-b pb-2">Role & Kredensial Sistem</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Role / Peran</label>
            <select id="roleInput" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:border-green-700 focus:ring-1 focus:ring-green-700 bg-green-50" required>
              <option value="">-- Pilih Role Terlebih Dahulu --</option>
              {roles.map((role) => <option value={role.value}>{role.label}</option>)}
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Username / ID Karyawan (Otomatis)</label>
            <input type="text" id="usernameInput" placeholder="Pilih Role untuk generate ID..." class="w-full px-4 py-2 border border-gray-300 bg-gray-100 rounded-lg outline-none font-bold text-gray-600" readonly required />
            <p class="text-[10px] text-gray-500 mt-1">Digunakan sebagai Username login aplikasi.</p>
          </div>

          <div id="passwordFieldContainer">
            <label class="block text-xs font-bold text-gray-700 mb-1">Password Baru</label>
            <div class="relative">
              <input type="text" id="passwordInput" placeholder="Minimal 6 karakter" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none focus:border-green-700 focus:ring-1 focus:ring-green-700" />
              <button type="button" id="generatePassBtn" class="absolute right-3 top-2 text-gray-600 hover:text-green-700"><i class="bi bi-arrow-repeat font-bold text-lg"></i></button>
            </div>
          </div>
        </div>
      </div>

      <div class="flex gap-3 pt-4">
        <button type="button" id="cancelBtn" class="flex-1 px-6 py-3 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 font-bold transition">Batal</button>
        <button type="submit" id="submitBtn" class="flex-1 px-6 py-3 bg-green-700 text-white rounded-xl hover:bg-green-800 font-bold transition shadow-sm">Simpan Akun</button>
      </div>
    </form>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', async function() {
    // === 🛡️ GATEKEEPER KEUANGAN ===
      const allowedRoles = ['owner', 'hrd', 'keuangan'];
      const client = window.supabase || supabase;
      
      const { data: { session } } = await client.auth.getSession();
      if (!session) return window.location.replace('/'); // Tendang kalau belum login
      
      const { data: prof } = await client.from('profiles').select('role').eq('id', session.user.id).single();
      if (!allowedRoles.includes(prof?.role)) {
          alert(`Akses Ditolak! Role Anda (${prof?.role || 'Guest'}) dilarang masuk ke Keuangan.`);
          return window.location.replace('/');
      }
      document.body.style.display = 'block'; // Buka gembok CSS, tampilkan layar!
    
    // 1. Cek Supabase & Sesi Login
    if (!window.supabase) return;
    
    let currentUserRole = 'admin';
    const { data: { session } } = await window.supabase.auth.getSession();
    if(session) {
        const { data: prof } = await window.supabase.from('profiles').select('role').eq('id', session.user.id).single();
        currentUserRole = prof?.role || 'admin';
    }

    // 2. Fungsi Warna Role untuk Client-Side
    const getRoleColorJs = (role) => {
        if(role === 'owner') return 'bg-purple-100 text-purple-700';
        if(role === 'hrd') return 'bg-pink-100 text-pink-700';
        if(role === 'keuangan') return 'bg-blue-100 text-blue-700';
        if(role === 'admin') return 'bg-orange-100 text-orange-700';
        if(role === 'periklanan') return 'bg-teal-100 text-teal-700';
        if(role === 'lapangan') return 'bg-green-100 text-green-700';
        return 'bg-gray-100 text-gray-700';
    };

    // 3. Modals & Forms Elements
    const formModal = document.getElementById('formModal');
    const openFormBtn = document.getElementById('openFormBtn');
    const closeFormBtn = document.getElementById('closeFormBtn');
    const cancelBtn = document.getElementById('cancelBtn');
    const employeeForm = document.getElementById('employeeForm');

    // 4. Fetch dan Render Data Karyawan
    async function loadKaryawan() {
        const { data: karyawan, error } = await window.supabase
            .from('profiles')
            .select('*')
            .order('created_at', { ascending: false });

        if (error) {
            console.error("Gagal ambil data", error);
            document.getElementById('tabelKaryawan').innerHTML = '<tr><td colspan="5" class="text-center py-4 text-red-500 font-bold">Gagal memuat data!</td></tr>';
            return;
        }

        const tbody = document.getElementById('tabelKaryawan');
        let html = '';

        karyawan.forEach(item => {
            const roleColor = getRoleColorJs(item.role);
            const initial = item.nama ? item.nama.substring(0, 2).toUpperCase() : 'US';
            const avatarHtml = item.foto_profil 
                ? `<img src="${item.foto_profil}" alt="Avatar" class="w-10 h-10 rounded-full object-cover border border-gray-200" />`
                : `<div class="w-10 h-10 rounded-full bg-green-700 text-white flex items-center justify-center font-bold text-sm">${initial}</div>`;
            
            const tipeKendaraan = item.tipe_kendaraan ? item.tipe_kendaraan.replace('_', ' ') : item.role;
            const alamatTeks = item.alamat ? item.alamat : 'Alamat belum diatur';
            const teleponTeks = item.nomor_hp ? item.nomor_hp : '-';

            html += `
            <tr class="border-b border-gray-200 hover:bg-gray-50 transition">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  ${avatarHtml}
                  <div>
                    <p class="font-bold text-gray-900">${item.nama}</p>
                    <p class="text-xs text-gray-500 capitalize">${tipeKendaraan}</p>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="text-sm font-bold text-gray-800 bg-gray-100 px-3 py-1 rounded w-fit border border-gray-200">
                    <i class="bi bi-person-badge mr-1 text-gray-500"></i>${item.id_lapangan}
                </div>
              </td>
              <td class="px-6 py-4">
                <p class="text-sm text-gray-700 flex items-center gap-2 font-medium mb-1">
                  <i class="bi bi-telephone text-green-600"></i> ${teleponTeks}
                </p>
                <p class="text-xs text-gray-500 line-clamp-1 max-w-[200px]" title="${alamatTeks}">${alamatTeks}</p>
              </td>
              <td class="px-6 py-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${roleColor}">
                  ${item.role}
                </span>
              </td>
              <td class="px-6 py-4">
                <button class="edit-btn px-3 py-1 text-blue-600 hover:bg-blue-50 border border-blue-200 rounded transition font-medium text-sm shadow-sm" 
                  data-emp="${item.id}" data-nama="${item.nama}" data-username="${item.id_lapangan}" data-telepon="${item.nomor_hp || ''}" data-alamat="${item.alamat || ''}" data-role="${item.role}">
                  <i class="bi bi-pencil mr-1"></i> Edit
                </button>
              </td>
            </tr>
            `;
        });

        tbody.innerHTML = html;

        // PENTING: Pasang event listener Edit SETELAH HTML di-render
        document.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                if(currentUserRole !== 'owner' && currentUserRole !== 'hrd') {
                    return alert('Akses Ditolak: Hanya Owner dan HRD yang berhak mengedit data profil!');
                }

                document.getElementById('modalTitle').textContent = 'Edit Karyawan';
                document.getElementById('editId').value = this.getAttribute('data-emp');
                document.getElementById('namaInput').value = this.getAttribute('data-nama');
                document.getElementById('usernameInput').value = this.getAttribute('data-username');
                document.getElementById('teleponInput').value = this.getAttribute('data-telepon');
                document.getElementById('alamatInput').value = this.getAttribute('data-alamat');
                document.getElementById('roleInput').value = this.getAttribute('data-role');
                
                document.getElementById('passwordInput').required = false;
                document.getElementById('passwordFieldContainer').style.display = 'none';

                formModal.classList.remove('hidden');
                formModal.classList.add('flex');
                setTimeout(() => { formModal.classList.remove('opacity-0'); formModal.querySelector('div').classList.remove('scale-95'); }, 10);
            });
        });
    }

    // Panggil fungsi render utama
    loadKaryawan();

    // =======================================================
    // SISA LOGIKA FORM, ID GENERATOR, DAN SUBMIT (TIDAK BERUBAH)
    // =======================================================
    
    document.getElementById('roleInput').addEventListener('change', async function() {
        const role = this.value;
        const usernameInput = document.getElementById('usernameInput');
        if(document.getElementById('editId').value !== '') return;
        if(!role) { usernameInput.value = ''; return; }

        usernameInput.value = "Membuat ID...";
        const prefix = (role === 'lapangan') ? 'LAP-' : 'CMS-';

        try {
            const { data, error } = await window.supabase
                .from('profiles').select('id_lapangan').like('id_lapangan', `${prefix}%`).order('id_lapangan', { ascending: false }).limit(1);
            
            let nextNum = 1;
            if(data && data.length > 0 && data[0].id_lapangan) {
                const numPart = data[0].id_lapangan.split('-')[1];
                if(numPart && !isNaN(parseInt(numPart))) nextNum = parseInt(numPart) + 1;
            }
            usernameInput.value = prefix + String(nextNum).padStart(3, '0');
        } catch(err) {
            console.error("Gagal generate ID:", err);
            usernameInput.value = prefix + 'ERR';
        }
    });

    const fotoInput = document.getElementById('fotoInput');
    const photoPreview = document.getElementById('photoPreview');
    const photoIcon = document.getElementById('photoIcon');

    fotoInput.addEventListener('change', function(e) {
        if (this.files && this.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                photoPreview.src = e.target.result;
                photoPreview.classList.remove('hidden');
                photoIcon.classList.add('hidden');
            }
            reader.readAsDataURL(this.files[0]);
        }
    });

    openFormBtn.addEventListener('click', () => {
      if(currentUserRole !== 'owner' && currentUserRole !== 'hrd') return alert('Akses Ditolak: Hanya Owner dan HRD yang berhak membuat akun baru!');

      document.getElementById('modalTitle').textContent = 'Buat Akun Karyawan';
      document.getElementById('editId').value = '';
      document.getElementById('passwordInput').required = true;
      document.getElementById('passwordFieldContainer').style.display = 'block';
      photoPreview.classList.add('hidden');
      photoIcon.classList.remove('hidden');
      fotoInput.value = '';
      employeeForm.reset();
      
      formModal.classList.remove('hidden'); formModal.classList.add('flex');
      setTimeout(() => { formModal.classList.remove('opacity-0'); formModal.querySelector('div').classList.remove('scale-95'); }, 10);
    });

    const closeModal = () => {
      formModal.classList.add('opacity-0'); formModal.querySelector('div').classList.add('scale-95');
      setTimeout(() => { formModal.classList.add('hidden'); formModal.classList.remove('flex'); }, 300);
    };
    closeFormBtn.addEventListener('click', closeModal);
    cancelBtn.addEventListener('click', closeModal);

    document.getElementById('generatePassBtn').addEventListener('click', () => {
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789';
      let password = '';
      for (let i = 0; i < 8; i++) password += chars.charAt(Math.floor(Math.random() * chars.length));
      document.getElementById('passwordInput').value = password;
    });

    // ==========================================
    // FUNGSI KOMPRESI GAMBAR (JADI KECIL & CEPAT)
    // ==========================================
    async function compressImage(file) {
        return new Promise((resolve) => {
            const reader = new FileReader();
            reader.onload = (event) => {
                const img = new Image();
                img.onload = () => {
                    const canvas = document.createElement('canvas');
                    
                    // Batasi ukuran maksimal (Resolusi) jadi 400x400 pixel (cukup banget buat Avatar)
                    const MAX_SIZE = 400;
                    let width = img.width;
                    let height = img.height;

                    if (width > height) {
                        if (width > MAX_SIZE) { height *= MAX_SIZE / width; width = MAX_SIZE; }
                    } else {
                        if (height > MAX_SIZE) { width *= MAX_SIZE / height; height = MAX_SIZE; }
                    }

                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    // Kompresi ke format WebP (Kualitas 80%) - Dijamin < 100kb
                    canvas.toBlob((blob) => {
                        const compressedFile = new File([blob], "avatar.webp", {
                            type: 'image/webp',
                            lastModified: Date.now(),
                        });
                        resolve(compressedFile);
                    }, 'image/webp', 0.8); 
                };
                img.src = event.target.result;
            };
            reader.readAsDataURL(file);
        });
    }

    // ==========================================
    // SUBMIT DATA (DENGAN UPSERT & CACHE)
    // ==========================================
    employeeForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      if(!window.supabase) return alert('Supabase tidak terhubung!');

      const btn = document.getElementById('submitBtn');
      btn.innerText = "Memproses..."; btn.disabled = true;

      const editId = document.getElementById('editId').value;
      const nama = document.getElementById('namaInput').value;
      const username = document.getElementById('usernameInput').value; 
      const password = document.getElementById('passwordInput').value;
      const telepon = document.getElementById('teleponInput').value;
      const alamat = document.getElementById('alamatInput').value;
      const role = document.getElementById('roleInput').value;
      const file = fotoInput.files[0];

      try {
        let finalAvatarUrl = null;

        // JIKA ADA FILE FOTO YANG DIUPLOAD
        if (file) {
            // 1. Kompres gambar dulu sebelum dikirim
            const compressedFile = await compressImage(file);
            
            // 2. Buat nama file STATIS agar SALING TIMPA (Contoh: CMS-001.webp)
            const fileName = `${username}.webp`;

            // 3. Upload dengan Upsert dan Cache Control
            const { error: uploadErr } = await window.supabase.storage.from('avatars').upload(fileName, compressedFile, {
                upsert: true, // INI YANG BIKIN SALING TIMPA (Overwrite)
                cacheControl: '31536000', // Cache di browser pengunjung selama 1 Tahun (Website jadi ngebut)
                contentType: 'image/webp'
            });
            
            if(uploadErr) throw uploadErr;

            // 4. Ambil URL dan tambahkan Cache Buster (?t=...) 
            // Biar walau di-cache 1 tahun, kalau upload baru, fotonya tetep refresh!
            const { data: publicUrlData } = window.supabase.storage.from('avatars').getPublicUrl(fileName);
            finalAvatarUrl = `${publicUrlData.publicUrl}?t=${Date.now()}`;
        }

        if(editId) {
            const updateData = { nama, nomor_hp: telepon, alamat, role };
            if(finalAvatarUrl) updateData.foto_profil = finalAvatarUrl;

            const { error } = await window.supabase.from('profiles').update(updateData).eq('id', editId);
            if(error) throw error;
            alert('Profil Karyawan berhasil diperbarui!');
        } else {
            const dummyEmail = `${username}@bangjelantah.local`.toLowerCase();
            const { data: authData, error: authError } = await window.supabase.auth.signUp({
                email: dummyEmail, password: password, options: { data: { nama: nama, role: role, telepon: telepon, alamat: alamat } }
            });
            if(authError) throw authError;

            if(finalAvatarUrl) {
                await window.supabase.from('profiles').update({ foto_profil: finalAvatarUrl }).eq('id', authData.user.id);
            }
            alert(`Karyawan berhasil didaftarkan!\n\nUsername Login: ${username}\nPassword: ${password}`);
        }

        window.location.reload();

      } catch (err) {
        alert('Gagal: ' + err.message);
        btn.innerText = "Simpan Akun"; btn.disabled = false;
      }
    });

  });
</script>