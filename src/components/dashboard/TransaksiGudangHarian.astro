---
// src/components/dashboard/TransaksiGudangHarian.astro
const now = new Date();
const yyyy = now.getFullYear();
const mm = String(now.getMonth() + 1).padStart(2, "0");
const defaultMonth = `${yyyy}-${mm}`;
---

<div
  class="bg-surface-container-lowest rounded-2xl p-lg border border-outline-variant shadow-md flex flex-col h-full hover:shadow-lg transition-shadow duration-300"
>
  <div
    class="mb-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4"
  >
    <div>
      <h3
        class="font-headline-md text-on-surface font-bold text-transparent bg-clip-text bg-linear-to-r from-primary to-secondary"
      >
        Rincian Transaksi Harian
      </h3>
      <p
        class="text-label-sm text-on-surface-variant font-medium"
        id="teks-ringkasan-gudang"
      >
        Bulan Ini
      </p>
    </div>

    <div
      class="flex flex-col sm:flex-row items-end sm:items-center gap-3 w-full sm:w-auto"
    >
      <div
        class="text-right w-full sm:w-auto flex sm:block justify-between items-center bg-primary/5 sm:bg-transparent p-2 sm:p-0 rounded-lg"
      >
        <span
          class="text-label-xs text-primary/80 uppercase tracking-wider block mb-0 sm:mb-1 font-bold"
          >Total Pembelian</span
        >
        <span id="total-rp-gudang" class="text-title-md font-black text-primary"
          >Rp 0</span
        >
      </div>

      <div
        class="bg-surface-variant/20 p-2 rounded-xl border border-surface-variant/50 focus-within:border-primary/50 focus-within:ring-2 focus-within:ring-primary/10 transition-all shadow-inner w-full sm:w-auto"
      >
        <input
          type="month"
          id="month-gudang"
          value={defaultMonth}
          class="w-full text-label-md bg-transparent border-none outline-none text-on-surface font-bold cursor-pointer focus:ring-0"
        />
      </div>
    </div>
  </div>

  <div
    class="w-full border border-gray-100 rounded-xl overflow-hidden mb-md flex-grow shadow-sm"
  >
    <div class="max-h-[350px] overflow-y-auto hide-scrollbar bg-gray-50/30">
      <table class="w-full text-left border-collapse">
        <thead
          class="bg-surface-variant/30 border-b border-gray-100 text-on-surface-variant text-xs"
        >
          <tr>
            <th class="p-3 text-left font-semibold w-16">Tanggal</th>
            <th class="p-3 text-right font-semibold">Volume (Kg)</th>
            <th
              class="p-3 text-right font-semibold hidden md:table-cell"
              title="Harga Beli per Kg">Harga Satuan Beli</th
            >
            <th class="p-3 text-right font-semibold text-primary"
              >Total Pembelian (Rp)</th
            >
            <th
              class="p-3 text-right font-semibold hidden md:table-cell text-orange-600"
              title="Harga Jual per Kg">Harga Satuan Jual</th
            >
            <th class="p-3 text-right font-semibold text-blue-600">Bruto</th>
            <th class="p-3 text-right font-semibold text-green-600">Margin</th>
          </tr>
        </thead>
        <tbody id="tbody-gudang" class="text-sm bg-white"> </tbody>
      </table>
    </div>
  </div>

  <div
    class="mt-auto border-t border-outline-variant/60 pt-md flex flex-col gap-5"
  >
    <div class="flex flex-col gap-1.5">
      <span
        class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest text-center"
        >Pilih Komoditas</span
      >
      <div class="flex flex-wrap justify-center gap-2">
        <button
          data-komoditas="Minyak Jelantah"
          class="btn-komoditas-gudang px-3 py-1.5 rounded-full text-[11px] font-bold transition-all duration-300 bg-surface-variant/80 text-on-surface shadow-sm scale-105"
        >
          Minyak Jelantah
        </button>
        <button
          data-komoditas="Minyak Asting"
          class="btn-komoditas-gudang px-3 py-1.5 rounded-full text-[11px] font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface"
        >
          Minyak Asting
        </button>
        <button
          data-komoditas="Ampas"
          class="btn-komoditas-gudang px-3 py-1.5 rounded-full text-[11px] font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface"
        >
          Ampas
        </button>
        <button
          data-komoditas="Kriuk"
          class="btn-komoditas-gudang px-3 py-1.5 rounded-full text-[11px] font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface"
        >
          Kriuk
        </button>
        <button
          data-komoditas="Tepung"
          class="btn-komoditas-gudang px-3 py-1.5 rounded-full text-[11px] font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface"
        >
          Tepung
        </button>
        <button
          data-komoditas="Spinner"
          class="btn-komoditas-gudang px-3 py-1.5 rounded-full text-[11px] font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface"
        >
          Spinner
        </button>
      </div>
      <button
        onclick="window.bukaModalBruto()"
        class="bg-gray-100 text-gray-600 border border-gray-300 px-4 py-2 rounded-lg text-sm font-bold hover:bg-gray-200 hover:text-gray-800 transition shadow-sm flex items-center justify-center text-center gap-2 mt-2"
      >
        <i class="bi bi-tags"></i> Set Harga Modal (Bruto)
      </button>
    </div>
  </div>
</div>

<div
  id="modal-set-bruto"
  class="fixed inset-0 bg-black/60 hidden items-center justify-center z-[70] p-4 transition-opacity opacity-0 backdrop-blur-sm"
>
  <div
    class="bg-white rounded-2xl w-full max-w-lg overflow-hidden transform scale-95 transition-transform duration-300 shadow-2xl"
  >
    <div
      class="p-4 border-b border-gray-100 bg-blue-50 flex justify-between items-center"
    >
      <div>
        <h3 class="font-bold text-lg text-blue-900">Set Harga Modal (Bruto)</h3>
        <p class="text-[10px] font-bold text-blue-700 uppercase tracking-wider">
          Kalkulasi Margin Otomatis
        </p>
      </div>
      <button
        onclick="window.tutupModalBruto()"
        class="text-blue-400 hover:text-blue-900 transition"
        ><i class="bi bi-x-lg text-xl"></i></button
      >
    </div>

    <div class="p-5 space-y-4 max-h-[70vh] overflow-y-auto custom-scrollbar">
      <div class="bg-gray-50 p-3 rounded-xl border border-gray-200">
        <label class="block text-xs font-bold text-gray-700 mb-1"
          ><i class="bi bi-calendar-event mr-1"></i> Pilih Tanggal Transaksi</label
        >
        <input
          type="date"
          id="modal_tanggal_bruto"
          onchange="window.fetchBrutoByDate(this.value)"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-600 font-medium text-gray-800"
        />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label
            class="block text-[10px] font-bold text-gray-600 mb-1 uppercase"
            >Minyak Jelantah (Rp/Kg)</label
          >
          <input
            type="number"
            id="m_bruto_minyak"
            value="0"
            class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
          />
        </div>
        <div>
          <label
            class="block text-[10px] font-bold text-gray-600 mb-1 uppercase"
            >Minyak Asting (Rp/Kg)</label
          >
          <input
            type="number"
            id="m_bruto_asting"
            value="0"
            class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
          />
        </div>
        <div>
          <label
            class="block text-[10px] font-bold text-gray-600 mb-1 uppercase"
            >Ampas Goreng (Rp/Kg)</label
          >
          <input
            type="number"
            id="m_bruto_ampas"
            value="0"
            class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
          />
        </div>
        <div>
          <label
            class="block text-[10px] font-bold text-gray-600 mb-1 uppercase"
            >Kriuk (Rp/Kg)</label
          >
          <input
            type="number"
            id="m_bruto_kriuk"
            value="0"
            class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
          />
        </div>
        <div>
          <label
            class="block text-[10px] font-bold text-gray-600 mb-1 uppercase"
            >Tepung Ayakan (Rp/Kg)</label
          >
          <input
            type="number"
            id="m_bruto_tepung"
            value="0"
            class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
          />
        </div>
        <div>
          <label
            class="block text-[10px] font-bold text-gray-600 mb-1 uppercase"
            >Spinner (Rp/Kg)</label
          >
          <input
            type="number"
            id="m_bruto_spinner"
            value="0"
            class="w-full border border-gray-300 rounded-lg p-2 text-sm outline-none focus:border-blue-600"
          />
        </div>
      </div>
    </div>

    <div class="p-4 border-t border-gray-100 bg-gray-50 flex gap-3">
      <button
        onclick="window.tutupModalBruto()"
        class="flex-1 bg-white border border-gray-300 text-gray-700 font-bold py-2.5 rounded-xl hover:bg-gray-100 transition text-sm"
        >Batal</button
      >
      <button
        onclick="window.simpanBrutoViaModal()"
        id="btn-save-modal-bruto"
        class="flex-1 bg-blue-700 text-white font-bold py-2.5 rounded-xl hover:bg-blue-800 transition shadow-sm text-sm flex items-center justify-center gap-2"
      >
        <i class="bi bi-floppy"></i> Simpan & Hitung
      </button>
    </div>
  </div>
</div>

<script>
  import { supabase } from "../../lib/supabase";

  // 🛠️ FIX 1: Expose supabase ke global window supaya bisa diakses oleh <script is:inline>
  if (typeof window !== "undefined") {
    (window as any).supabase = supabase;
  }

  type KomoditasKey =
    | "Minyak Jelantah"
    | "Minyak Asting"
    | "Ampas"
    | "Kriuk"
    | "Tepung"
    | "Spinner";
  type DataGlobalT = { tanggal: string; [key: string]: any };

  const formatRp = (num: number) =>
    new Intl.NumberFormat("id-ID", {
      style: "currency",
      currency: "IDR",
      minimumFractionDigits: 0,
    }).format(num || 0);

  const formatVol = (num: number) =>
    new Intl.NumberFormat("id-ID", { maximumFractionDigits: 2 }).format(
      num || 0,
    );

  async function initTabelGudang() {
    let currentCommodity: KomoditasKey = "Minyak Jelantah";
    let dataGlobal: DataGlobalT[] = [];

    const kolomDatabase: Record<
      KomoditasKey,
      { rp: string; vol: string; bruto: string; margin: string }
    > = {
      "Minyak Jelantah": {
        rp: "minyak_jelantah_rp",
        vol: "minyak_jelantah_vol",
        bruto: "bruto_minyak_jelantah",
        margin: "margin_minyak_jelantah",
      },
      "Minyak Asting": {
        rp: "minyak_asting_rp",
        vol: "minyak_asting_vol",
        bruto: "bruto_minyak_asting",
        margin: "margin_minyak_asting",
      },
      Ampas: {
        rp: "ampas_rp",
        vol: "ampas_vol",
        bruto: "bruto_ampas",
        margin: "margin_ampas",
      },
      Kriuk: {
        rp: "kriuk_rp",
        vol: "kriuk_vol",
        bruto: "bruto_kriuk",
        margin: "margin_kriuk",
      },
      Tepung: {
        rp: "tepung_rp",
        vol: "tepung_vol",
        bruto: "bruto_tepung",
        margin: "margin_tepung",
      },
      Spinner: {
        rp: "spinner_rp",
        vol: "spinner_vol",
        bruto: "bruto_spinner",
        margin: "margin_spinner",
      },
    };

    const monthInput = document.getElementById(
      "month-gudang",
    ) as HTMLInputElement | null;
    const btnsKomoditas = document.querySelectorAll(".btn-komoditas-gudang");
    const tbody = document.getElementById(
      "tbody-gudang",
    ) as HTMLTableSectionElement | null;
    const elTotalRp = document.getElementById(
      "total-rp-gudang",
    ) as HTMLElement | null;
    const teksRingkasan = document.getElementById(
      "teks-ringkasan-gudang",
    ) as HTMLElement | null;

    if (!monthInput || !tbody || !elTotalRp || !teksRingkasan) return;

    async function fetchDataSebulan() {
      if (!monthInput) return;
      const val = monthInput.value;
      if (!val) return;

      const [y, m] = val.split("-");
      const lastDay = new Date(Number(y), Number(m), 0).getDate();
      const startDate = `${y}-${m}-01`;
      const endDate = `${y}-${m}-${lastDay}`;

      const kolomAktif = kolomDatabase[currentCommodity];

      const { data, error } = await supabase
        .from("transaksi_gudang_harian")
        .select(
          `tanggal, ${kolomAktif.rp}, ${kolomAktif.vol}, ${kolomAktif.bruto}, ${kolomAktif.margin}`,
        )
        .gte("tanggal", startDate)
        .lte("tanggal", endDate);

      if (!error && data) {
        dataGlobal = data as unknown as DataGlobalT[];
        renderTabel(lastDay, y, m);
      }
    }

    function renderTabel(lastDay: number, year: string, month: string) {
      if (!tbody || !elTotalRp || !teksRingkasan) return;
      tbody.innerHTML = "";
      const kolomAktif = kolomDatabase[currentCommodity];
      let grandTotalRp = 0;
      let grandTotalVol = 0;
      let grandTotalMargin = 0;

      let rekapHarian = Array.from({ length: lastDay }, () => ({
        rp: 0,
        vol: 0,
        bruto: 0,
        bruto_hasil: 0,
        margin: 0,
      }));

      dataGlobal.forEach((item) => {
        const rp = Number(item[kolomAktif.rp]) || 0;
        const vol = Number(item[kolomAktif.vol]) || 0;
        const bruto = Number(item[kolomAktif.bruto]) || 0;
        let margin = item[kolomAktif.margin] || 0;

        const dayIdx = parseInt(item.tanggal.split("-")[2]) - 1;

        if (dayIdx >= 0 && dayIdx < lastDay) {
          rekapHarian[dayIdx].rp += rp;
          rekapHarian[dayIdx].vol += vol;
          rekapHarian[dayIdx].bruto += bruto;
          rekapHarian[dayIdx].bruto_hasil += bruto * vol;
          rekapHarian[dayIdx].margin += margin;

          grandTotalRp += rp;
          grandTotalVol += vol;
          grandTotalMargin += margin;
        }
      });

      for (let i = 0; i < lastDay; i++) {
        const tglNum = i + 1;
        const dataHariIni = rekapHarian[i];

        const hrgSatuan =
          dataHariIni.vol > 0 ? dataHariIni.rp / dataHariIni.vol : 0;
        const bgClass = dataHariIni.vol > 0 ? "bg-green-50/50" : "";
        const textClass =
          dataHariIni.vol > 0 ? "text-gray-900 font-bold" : "text-gray-400";

        const brutoBaru = dataHariIni.bruto * dataHariIni.vol;

        tbody.innerHTML += `
    <tr class="border-b border-gray-100 transition-colors hover:bg-surface-variant/20 ${bgClass}">
        <td class="p-3 whitespace-nowrap">
            <span class="inline-block w-6 text-center bg-gray-100 rounded text-xs font-bold mr-2">${tglNum}</span>
        </td>
        <td class="p-3 text-right font-medium ${textClass}">${formatVol(dataHariIni.vol)} <span class="text-[10px]">Kg</span></td>
        <td class="p-3 text-right text-xs text-gray-500 hidden md:table-cell">${formatRp(hrgSatuan)}</td>
        <td class="p-3 text-right font-bold ${dataHariIni.rp > 0 ? "text-primary" : "text-gray-400"}">
            ${formatRp(dataHariIni.rp)}
        </td>
        <td class="p-3 text-right text-xs text-orange-600 hidden md:table-cell font-medium">${formatRp(dataHariIni.bruto)}</td>
        <td class="p-3 text-right font-bold text-blue-600">
            ${formatRp(brutoBaru)}
        </td>
        <td class="p-3 text-right font-bold ${dataHariIni.margin > 0 ? "text-green-600" : dataHariIni.margin < 0 ? "text-red-600" : "text-gray-400"}">
            ${formatRp(dataHariIni.margin)}
        </td>
    </tr>
`;
      }

      elTotalRp.textContent = formatRp(grandTotalRp);
      teksRingkasan.innerHTML = `Total Keseluruhan: <b>${formatVol(grandTotalVol)} Kg</b> (${currentCommodity})`;

      if (typeof window !== "undefined") {
        (window as any).dataHarianGudang = {
          ...(window as any).dataHarianGudang,
          [`vol_${currentCommodity.toLowerCase().split(" ")[0]}`]:
            grandTotalVol,
          [`rp_${currentCommodity.toLowerCase().split(" ")[0]}`]: grandTotalRp,
        };
      }
    }

    monthInput.addEventListener("change", fetchDataSebulan);

    btnsKomoditas.forEach((btn) => {
      btn.addEventListener("click", (e: Event) => {
        const target = e.target as HTMLButtonElement;
        const attrKomoditas = target.getAttribute("data-komoditas");

        if (attrKomoditas) {
          currentCommodity = attrKomoditas as KomoditasKey;
          btnsKomoditas.forEach((b) => {
            b.className =
              "btn-komoditas-gudang px-3 py-1.5 rounded-full text-[11px] font-semibold transition-all duration-300 bg-surface-variant/30 text-on-surface-variant hover:bg-surface-variant/60 hover:text-on-surface";
          });
          target.className =
            "btn-komoditas-gudang px-3 py-1.5 rounded-full text-[11px] font-bold transition-all duration-300 bg-surface-variant/80 text-on-surface shadow-sm scale-105";

          fetchDataSebulan();
        }
      });
    });

    fetchDataSebulan();
  }

  document.addEventListener("DOMContentLoaded", initTabelGudang);
</script>

<script is:inline>
  // Fungsi Buka Tutup Modal
  window.bukaModalBruto = function () {
    const m = document.getElementById("modal-set-bruto");
    if (!m) return;

    const waktuLokal = new Date();
    const offset = waktuLokal.getTimezoneOffset() * 60000;
    const hariIni = new Date(waktuLokal - offset).toISOString().split("T")[0];
    document.getElementById("modal_tanggal_bruto").value = hariIni;

    // 🛠️ FIX 2: Langsung fetch data sesuai tanggal hari ini secara otomatis!
    window.fetchBrutoByDate(hariIni);

    m.classList.remove("hidden");
    m.classList.add("flex");
    setTimeout(() => {
      m.classList.remove("opacity-0");
      m.querySelector("div").classList.remove("scale-95");

      // 🛠️ FIX 3: Auto-focus ke input pertama biar bener-bener "langsung bisa diinput" (gak usah klik dulu)
      const inputMinyak = document.getElementById("m_bruto_minyak");
      if (inputMinyak) {
        inputMinyak.focus();
        inputMinyak.select(); // Highlight angka "0" biar kalau ngetik langsung ke-replace
      }
    }, 50); // Kasih delay dikit biar animasi modal selesai

    document.body.style.overflow = "hidden";
  };

  window.tutupModalBruto = function () {
    const m = document.getElementById("modal-set-bruto");
    if (!m) return;
    m.classList.add("opacity-0");
    m.querySelector("div").classList.add("scale-95");
    setTimeout(() => {
      m.classList.add("hidden");
      m.classList.remove("flex");
    }, 300);
    document.body.style.overflow = "";
  };

  // Fungsi Eksekusi Simpan Bruto dan Kalkulasi Margin via Frontend
  // Fungsi Eksekusi Simpan Bruto (DENGAN DEBUGGING LENGKAP)
  window.simpanBrutoViaModal = async function () {
    console.log("=== 🐛 DEBUG START: SIMPAN BRUTO ===");

    // 1. Cek apakah objek Supabase terbaca
    console.log(
      "1. Status window.supabase:",
      window.supabase ? "TERHUBUNG" : "KOSONG/UNDEFINED",
    );
    if (!window.supabase) {
      alert(
        "Supabase tidak terhubung! Buka Inspect Element -> Console untuk cek error.",
      );
      return;
    }

    const btn = document.getElementById("btn-save-modal-bruto");
    const tglPilih = document.getElementById("modal_tanggal_bruto").value;

    // 2. Cek tanggal
    console.log("2. Tanggal yang dipilih:", tglPilih);
    if (!tglPilih) {
      alert("Pilih tanggal terlebih dahulu!");
      return;
    }

    btn.innerHTML =
      '<i class="bi bi-arrow-repeat animate-spin"></i> Memproses...';
    btn.disabled = true;

    try {
      const getBrutoAman = (id) => {
        const val = document.getElementById(id)?.value;
        return val ? parseFloat(val) : 0;
      };

      // 3. Susun Payload (Hanya kirim Bruto)
      const payloadBruto = {
        bruto_minyak_jelantah: getBrutoAman("m_bruto_minyak"),
        bruto_minyak_asting: getBrutoAman("m_bruto_asting"),
        bruto_ampas: getBrutoAman("m_bruto_ampas"),
        bruto_kriuk: getBrutoAman("m_bruto_kriuk"),
        bruto_tepung: getBrutoAman("m_bruto_tepung"),
        bruto_spinner: getBrutoAman("m_bruto_spinner"),
      };

      console.log(
        "3. Payload Data Bruto yang mau dikirim ke Database:",
        payloadBruto,
      );

      // 4. Kirim ke Supabase
      console.log("4. Mengirim request ke tabel 'transaksi_gudang_harian'...");
      const response = await window.supabase
        .from("transaksi_gudang_harian")
        .update(payloadBruto)
        .eq("tanggal", tglPilih);

      // 5. Cek Respons Mentah dari Supabase
      console.log("5. RAW Response dari Supabase:", response);

      // Jika Supabase mengembalikan error (seperti masalah RLS policy atau kolom ga match)
      if (response.error) {
        console.error("❌ ERROR DARI SUPABASE:", response.error);
        throw response.error;
      }

      console.log("✅ BERHASIL! Data tersimpan tanpa error.");
      alert("✅ Sukses menyimpan harga modal (bruto)!");
      window.tutupModalBruto();
      window.location.reload();
    } catch (err) {
      console.error("=== ❌ FATAL ERROR CATCHED ===", err);
      // Munculin detail pesan errornya ke alert biar langsung keliatan
      alert(
        "❌ Gagal menyimpan bruto: " + (err.message || JSON.stringify(err)),
      );
    } finally {
      btn.innerHTML = '<i class="bi bi-floppy"></i> Simpan & Hitung';
      btn.disabled = false;
      console.log("=== 🏁 DEBUG END ===");
    }
  };

  // Fungsi untuk narik data Bruto pas tanggal dipilih
  window.fetchBrutoByDate = async function (tanggal) {
    if (!tanggal || !window.supabase) return;

    try {
      const { data, error } = await window.supabase
        .from("transaksi_gudang_harian")
        .select(
          "bruto_minyak_jelantah, bruto_minyak_asting, bruto_ampas, bruto_kriuk, bruto_tepung, bruto_spinner",
        )
        .eq("tanggal", tanggal)
        .single();

      const setInput = (id, val) => {
        const el = document.getElementById(id);
        if (el) el.value = val || "";
      };

      if (data && !error) {
        setInput("m_bruto_minyak", data.bruto_minyak_jelantah);
        setInput("m_bruto_asting", data.bruto_minyak_asting);
        setInput("m_bruto_ampas", data.bruto_ampas);
        setInput("m_bruto_kriuk", data.bruto_kriuk);
        setInput("m_bruto_tepung", data.bruto_tepung);
        setInput("m_bruto_spinner", data.bruto_spinner);
      } else {
        setInput("m_bruto_minyak", "");
        setInput("m_bruto_asting", "");
        setInput("m_bruto_ampas", "");
        setInput("m_bruto_kriuk", "");
        setInput("m_bruto_tepung", "");
        setInput("m_bruto_spinner", "");
      }
    } catch (err) {
      console.error("Gagal menarik data harga bruto:", err.message);
    }
  };
</script>
