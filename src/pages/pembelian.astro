---
// [cite: 1]
import GeneralLayout from "../layouts/Layout.astro";
import "bootstrap-icons/font/bootstrap-icons.css";
---

<GeneralLayout title="Pembelian & Validasi - Manajemen Bang Jelantah">
  <style is:global>
    /* [cite: 1, 2] Mengunci layar menjadi blank (putih) sampai skrip memberi izin masuk */
    body {
      display: none;
    }
  </style>
  <div
    class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-4"
  >
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Pembelian Mitra</h1>
      <p class="text-gray-600">
        Kelola riwayat pembelian komoditas mitra dan validasi pembayaran.
      </p>
    </div>
  </div>

  <div class="mb-6 border-b border-gray-200 overflow-x-auto hide-scrollbar">
    <div class="flex gap-8 min-w-max">
      <button
        class="tab-btn active px-4 py-3 font-medium transition border-b-2 border-green-700 text-green-700"
        data-tab="validasi"
      >
        <i class="bi bi-shield-check mr-2"></i> Validasi Bayar
        <span
          id="badge-validasi"
          class="hidden ml-2 items-center justify-center w-5 h-5 rounded-full bg-red-100 text-red-700 text-xs font-bold"
          >0</span
        >
      </button>

      <button
        class="tab-btn px-4 py-3 font-medium transition border-b-2 border-transparent text-gray-600 hover:text-gray-900"
        data-tab="riwayat"
      >
        <i class="bi bi-clock-history mr-2"></i> Riwayat Lunas
      </button>

      <button
        class="tab-btn px-4 py-3 font-medium transition border-b-2 border-transparent text-gray-600 hover:text-gray-900"
        data-tab="pembelian"
      >
        <i class="bi bi-cart-check mr-2"></i> Pembelian Komoditas
      </button>
    </div>
  </div>

  <div id="validasi" class="tab-content block">
    <div class="mb-8">
      <div class="flex items-center gap-2 mb-6">
        <i class="bi bi-exclamation-triangle text-red-600 text-xl"></i>
        <h2 class="text-xl font-bold text-gray-900">
          Menunggu Validasi (<span id="title-validasi-count">0</span>)
        </h2>
      </div>

      <div
        id="validasi-container"
        class="grid grid-cols-1 lg:grid-cols-2 gap-6"
      >
        <p class="text-gray-500">Memuat data validasi...</p>
      </div>
    </div>
  </div>

  <div id="riwayat" class="tab-content hidden">
    <div class="flex items-center gap-2 mb-6">
      <i class="bi bi-clock-history text-blue-600 text-xl"></i>
      <h2 class="text-xl font-bold text-gray-900">
        Riwayat Pembayaran Selesai
      </h2>
    </div>

    <div
      class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm"
    >
      <table class="w-full text-left">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="px-6 py-4 text-sm font-bold text-gray-900">Mitra</th>
            <th class="px-6 py-4 text-sm font-bold text-gray-900">Tanggal</th>
            <th class="px-6 py-4 text-sm font-bold text-gray-900"
              >Metode Bayar</th
            >
            <th class="px-6 py-4 text-sm font-bold text-gray-900 text-right"
              >Nominal</th
            >
            <th class="px-6 py-4 text-sm font-bold text-gray-900 text-center"
              >Aksi</th
            >
          </tr>
        </thead>
        <tbody id="riwayat-lunas-tbody" class="divide-y divide-gray-100">
          <tr><td colspan="5" class="text-center py-4">Memuat...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div id="pembelian" class="tab-content hidden">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-bold text-gray-900">
        Pembelian Komoditas (Mitra)
      </h2>
    </div>

    <div
      class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm mb-6 flex flex-wrap gap-4 items-end"
    >
      <div>
        <label class="block text-xs font-bold text-gray-600 mb-1"
          >Mulai Tanggal</label
        >
        <input
          type="date"
          id="filter-start-beli"
          class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-600"
        />
      </div>
      <div>
        <label class="block text-xs font-bold text-gray-600 mb-1"
          >Sampai Tanggal</label
        >
        <input
          type="date"
          id="filter-end-beli"
          class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-600"
        />
      </div>

      <!-- DROPDOWN KOMODITAS BARU -->
      <div>
        <label class="block text-xs font-bold text-gray-600 mb-1"
          >Pilih Komoditas</label
        >
        <select
          id="filter-komoditas-beli"
          class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-600 bg-white min-w-40"
        >
          <option value="Semua">Semua Komoditas</option>
          <option value="Minyak Jelantah">Minyak Jelantah</option>
          <option value="Minyak Asting">Minyak Asting</option>
          <option value="Ampas">Ampas</option>
          <option value="Kriuk">Kriuk</option>
          <option value="Tepung">Tepung</option>
          <option value="Spinner">Spinner</option>
        </select>
      </div>

      <button
        onclick="filterTabelBeli()"
        class="bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-green-800"
      >
        Filter Data
      </button>
    </div>
    <!-- CARD RINGKASAN PEMBELIAN -->
    <div class="mt-6 grid grid-cols-3 gap-4">
      <div
        class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg border border-blue-200 p-6 shadow-sm"
      >
        <p
          class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-1"
        >
          Total Berat
        </p>
        <p class="text-3xl font-bold text-blue-900" id="summary-total-kg">0</p>
        <p class="text-xs text-blue-700 mt-2">Kilogram</p>
      </div>

      <div
        class="bg-gradient-to-br from-orange-50 to-orange-100 rounded-lg border border-orange-200 p-6 shadow-sm"
      >
        <p
          class="text-xs font-bold text-orange-600 uppercase tracking-wider mb-1"
        >
          Harga Satuan Rata-rata
        </p>
        <p
          class="text-2xl font-bold text-orange-900"
          id="summary-avg-harga-satuan"
        >
          Rp 0
        </p>
        <p class="text-xs text-orange-700 mt-2">Per kilogram</p>
      </div>

      <div
        class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg border border-purple-200 p-6 shadow-sm"
      >
        <p
          class="text-xs font-bold text-purple-600 uppercase tracking-wider mb-1"
        >
          Total Pembelian
        </p>
        <p
          class="text-2xl font-bold text-purple-900"
          id="summary-total-nominal"
        >
          Rp 0
        </p>
        <p class="text-xs text-purple-700 mt-2">Nominal keseluruhan</p>
      </div>
    </div>
    <div
      class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm"
    >
      <div class="overflow-x-auto max-h-150">
        <table class="w-full text-left" id="tabel-pembelian">
          <thead class="bg-gray-50 sticky top-0 border-b border-gray-200">
            <tr>
              <th
                class="px-6 py-4 text-sm font-bold text-gray-900 whitespace-nowrap"
                >Tanggal</th
              >
              <th class="px-6 py-4 text-sm font-bold text-gray-900">Mitra</th>
              <th class="px-6 py-4 text-sm font-bold text-gray-900"
                >Komoditas</th
              >
              <th
                class="px-6 py-4 text-sm font-bold text-gray-900 text-right whitespace-nowrap"
                >Berat (Kg)</th
              >
              <th
                class="px-6 py-4 text-sm font-bold text-gray-900 text-right whitespace-nowrap"
                >Harga Satuan</th
              >
              <th
                class="px-6 py-4 text-sm font-bold text-gray-900 text-right whitespace-nowrap"
                >Subtotal Harga</th
              >
            </tr>
          </thead>
          <tbody id="pembelian-tbody" class="divide-y divide-gray-200">
            <tr
              ><td colspan="6" class="text-center py-4 text-gray-500"
                >Memuat...</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </div>
  </div>
</GeneralLayout>

<div
  id="modal-edit-transaksi"
  class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0"
>
  <div
    class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh]"
  >
    <div
      class="p-6 border-b border-gray-100 flex justify-between items-center bg-blue-50 shrink-0"
    >
      <div>
        <h3 class="font-bold text-lg text-gray-900">Edit Data Transaksi</h3>
        <p
          id="edit-step-indicator"
          class="text-xs text-blue-700 font-medium mt-0.5"
        >
          Langkah 1 dari 3: Data Pokok
        </p>
      </div>
      <button
        type="button"
        onclick="closeModal('modal-edit-transaksi')"
        class="text-gray-400 hover:text-gray-900"
        ><i class="bi bi-x-lg"></i></button
      >
    </div>

    <form
      id="form-edit-transaksi"
      novalidate
      onsubmit="window.simpanEditTransaksi(event)"
      class="p-6 overflow-y-auto flex-1 flex flex-col justify-between"
    >
      <input type="hidden" id="edit_trx_id" />
      <input type="hidden" id="edit_penjemputan_id" />
      <input type="hidden" id="edit_mitra_id" />

      <div id="edit-step-1" class="flex flex-col gap-4">
        <div class="w-full">
          <label
            class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1"
            >Tanggal Transaksi</label
          >
          <input
            type="date"
            id="edit_trx_tgl"
            class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-blue-600 font-medium"
            required
          />
        </div>

        <div class="w-full">
          <label
            class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1"
            >Nama Mitra Pengumpul</label
          >
          <select
            id="edit_trx_mitra_select"
            onchange="window.toggleMitraManual()"
            class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-blue-600 font-medium bg-white"
            required
          >
          </select>
        </div>

        <div id="container_mitra_manual" class="w-full hidden">
          <label
            class="block text-xs font-bold text-amber-700 uppercase tracking-wider mb-1 mt-2"
            >Nama Mitra Manual / Tidak Terdaftar</label
          >
          <input
            type="text"
            id="edit_nama_mitra_manual"
            class="w-full border border-amber-300 bg-amber-50 rounded-xl p-3 text-sm outline-none focus:border-amber-600 font-bold text-amber-900"
            placeholder="Ketik nama mitra kustom..."
          />
        </div>

        <div class="w-full">
          <label
            class="block text-xs font-bold text-red-600 uppercase tracking-wider mb-1"
            >Potongan DP / Kasbon (Rp)</label
          >
          <input
            type="number"
            id="edit_trx_dp"
            class="w-full border border-red-300 bg-red-50 rounded-xl p-3 outline-none focus:border-red-600 text-red-900 font-bold font-mono"
            placeholder="0"
          />
        </div>
      </div>

      <div id="edit-step-2" class="hidden flex-col gap-5">
        <div id="edit_items_container" class="space-y-4"></div>

        <div class="w-full pt-3 border-t border-gray-100">
          <label
            class="block text-xs font-bold text-green-700 uppercase tracking-wider mb-1"
            >Total Harga Transaksi (Rp)</label
          >
          <input
            type="number"
            id="edit_trx_grand_total"
            class="w-full border border-green-300 bg-green-50 rounded-xl p-3 outline-none focus:border-green-600 text-green-900 font-bold font-mono text-lg"
            required
          />
        </div>
      </div>

      <div id="edit-step-3" class="hidden flex-col gap-4">
        <div
          class="w-full bg-blue-50 p-3 rounded-xl border border-blue-200 shadow-sm"
        >
          <label
            class="block text-xs font-bold text-blue-800 uppercase tracking-wider mb-1"
            >Metode Pembayaran 1</label
          >
          <select
            id="edit_metode_bayar"
            onchange="window.renderMetodeDetails()"
            class="w-full border border-blue-300 rounded-lg p-2.5 text-sm bg-white outline-none focus:border-blue-600 font-bold mb-3"
          >
            <option value="Cash (Dana UMKM)">Cash (Dana UMKM)</option>
            <option value="Cash (Talangan Karyawan)"
              >Cash (Talangan Karyawan)</option
            >
            <option value="Transfer">Transfer Bank/E-Wallet</option>
            <option value="QRIS">QRIS</option>
            <option value="Full Deposit">Full Deposit (Potong Saldo)</option>
          </select>

          <label class="flex items-center gap-2 cursor-pointer mb-2">
            <input
              type="checkbox"
              id="cb_split_payment"
              onchange="window.toggleMetode2()"
              class="w-4 h-4 text-blue-600 rounded"
            />
            <span class="text-xs font-bold text-blue-900"
              >Ada kekurangan? (Tambah metode ke-2)</span
            >
          </label>

          <div
            id="container_metode_2"
            style="display: none; margin-bottom: 12px;"
          >
            <select
              id="edit_metode_bayar_2"
              onchange="window.renderMetodeDetails()"
              class="w-full border border-blue-300 rounded-lg p-2.5 text-sm bg-white outline-none focus:border-blue-600 font-bold"
            >
              <option value="Cash (Dana UMKM)">Cash (Dana UMKM)</option>
              <option value="Cash (Talangan Karyawan)"
                >Cash (Talangan Karyawan)</option
              >
              <option value="Transfer">Transfer Bank/E-Wallet</option>
              <option value="QRIS">QRIS</option>
              <option value="Full Deposit">Full Deposit (Potong Saldo)</option>
            </select>
          </div>

          <div id="container_toggle_3" style="display: none;">
            <label class="flex items-center gap-2 cursor-pointer mb-2">
              <input
                type="checkbox"
                id="cb_split_payment_3"
                onchange="window.toggleMetode3()"
                class="w-4 h-4 text-blue-600 rounded"
              />
              <span class="text-xs font-bold text-blue-900"
                >Masih kurang? (Tambah metode ke-3)</span
              >
            </label>
          </div>

          <div id="container_metode_3" style="display: none;">
            <select
              id="edit_metode_bayar_3"
              onchange="window.renderMetodeDetails()"
              class="w-full border border-blue-300 rounded-lg p-2.5 text-sm bg-white outline-none focus:border-blue-600 font-bold"
            >
              <option value="Cash (Dana UMKM)">Cash (Dana UMKM)</option>
              <option value="Cash (Talangan Karyawan)"
                >Cash (Talangan Karyawan)</option
              >
              <option value="Transfer">Transfer Bank/E-Wallet</option>
              <option value="QRIS">QRIS</option>
              <option value="Full Deposit">Full Deposit (Potong Saldo)</option>
            </select>
          </div>
        </div>

        <div
          id="edit_payment_details_container"
          class="w-full transition-all duration-300 space-y-3"
        >
        </div>
      </div>

      <div id="footer-edit-1" class="mt-8 flex justify-end shrink-0">
        <button
          type="button"
          onclick="window.goToEditStep(2)"
          class="w-12 h-12 bg-gray-900 text-white font-bold rounded-xl hover:bg-black transition text-xl flex items-center justify-center shadow-sm active:scale-95"
          title="Selanjutnya"
        >
          <i class="bi bi-arrow-right"></i>
        </button>
      </div>

      <div
        id="footer-edit-2"
        class="mt-8 hidden w-full justify-between items-center shrink-0"
      >
        <button
          type="button"
          onclick="window.goToEditStep(1)"
          class="w-12 h-12 bg-gray-100 text-gray-700 font-bold rounded-xl hover:bg-gray-200 border border-gray-200 transition text-xl flex items-center justify-center active:scale-95"
          title="Kembali"
        >
          <i class="bi bi-arrow-left"></i>
        </button>
        <button
          type="button"
          onclick="window.goToEditStep(3)"
          class="w-12 h-12 bg-gray-900 text-white font-bold rounded-xl hover:bg-black transition text-xl flex items-center justify-center shadow-sm active:scale-95"
          title="Selanjutnya"
        >
          <i class="bi bi-arrow-right"></i>
        </button>
      </div>

      <div
        id="footer-edit-3"
        class="mt-8 hidden w-full justify-between items-center shrink-0"
      >
        <button
          type="button"
          onclick="window.goToEditStep(2)"
          class="w-12 h-12 bg-gray-100 text-gray-700 font-bold rounded-xl hover:bg-gray-200 border border-gray-200 transition text-xl flex items-center justify-center active:scale-95"
          title="Kembali"
        >
          <i class="bi bi-arrow-left"></i>
        </button>
        <button
          type="submit"
          id="btn-save-trx"
          class="w-12 h-12 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition text-xl flex items-center justify-center shadow-sm active:scale-95"
          title="Simpan Perubahan"
        >
          <i class="bi bi-floppy-fill"></i>
        </button>
      </div>
    </form>
  </div>
</div>
<div class="hidden">
  <div
    id="struk-wa-template"
    style="width: 340px; background-color: #ffffff; padding: 20px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #333; box-sizing: border-box; line-height: 1.4;"
  >
    <div style="text-align: center; margin-bottom: 15px; width: 100%;">
      <img
        src="/3.png"
        alt="Logo Bang Jelantah"
        style="display: block; margin: 0 auto 8px auto; width: 80px; height: auto;"
      />

      <div
        style="font-size: 18px; font-weight: 800; color: #4CAF50; margin: 0 0 4px 0; letter-spacing: 0.5px;"
      >
        BANG JELANTAH
      </div>
      <div
        style="font-size: 11px; font-weight: bold; margin: 0 0 10px 0; color: #444;"
      >
        STRUK PENJEMPUTAN MINYAK JELANTAH
      </div>
      <div style="font-size: 10px; color: #666; line-height: 1.4;">
        Kp. Pasar Minggu No 39. RT/RW 08/03<br />
        Desa/Kec Campaka. Kab Purwakarta, Jawa Barat<br />
        0896-5507-6318
      </div>
    </div>

    <div style="border-top: 1px dashed #bbb; margin: 12px 0;"></div>

    <div
      style="font-size: 10px; font-weight: bold; color: #888; margin-bottom: 8px; text-transform: uppercase;"
    >
      Informasi Transaksi
    </div>
    <div style="display: flex; font-size: 11px; margin-bottom: 4px;">
      <div style="width: 30%; color: #666;">Tanggal</div>
      <div id="str-target-tanggal" style="width: 70%; font-weight: 600;">
        : -
      </div>
    </div>
    <div style="display: flex; font-size: 11px; margin-bottom: 4px;">
      <div style="width: 30%; color: #666;">Penjual</div>
      <div id="str-target-penjual" style="width: 70%; font-weight: 600;">
        : -
      </div>
    </div>
    <div style="display: flex; font-size: 11px; margin-bottom: 4px;">
      <div style="width: 30%; color: #666;">Driver</div>
      <div id="str-target-driver" style="width: 70%; font-weight: 600;">
        : -
      </div>
    </div>

    <div style="border-top: 1px dashed #bbb; margin: 12px 0;"></div>

    <div
      style="font-size: 10px; font-weight: bold; color: #888; margin-bottom: 8px; text-transform: uppercase;"
    >
      Detail Barang
    </div>
    <div id="str-target-items" style="width: 100%; margin-bottom: 10px;"></div>

    <div style="border-top: 1px dashed #bbb; margin: 12px 0;"></div>

    <div
      style="font-size: 10px; font-weight: bold; color: #888; margin-bottom: 8px; text-transform: uppercase;"
    >
      Ringkasan Pembayaran
    </div>
    <div style="width: 100%;">
      <div
        style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 11px;"
      >
        <div style="color: #666;">Total</div>
        <div id="str-target-total" style="font-weight: 600;">Rp 0</div>
      </div>
      <div
        style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 11px;"
      >
        <div style="color: #666;">DP (Sudah Dibayar)</div>
        <div id="str-target-dp" style="font-weight: 600;">Rp 0</div>
      </div>
      <div
        style="display: flex; justify-content: space-between; font-size: 14px; color: #4CAF50; margin-top: 8px; padding-top: 8px; border-top: 1px dashed #bbb; font-weight: 800;"
      >
        <div>SISA</div>
        <div id="str-target-sisa">Rp 0</div>
      </div>
      <div
        style="display: flex; justify-content: space-between; margin-top: 6px; font-size: 11px;"
      >
        <div style="color: #666;">Metode</div>
        <div id="str-target-metode" style="font-weight: 600;">-</div>
      </div>
    </div>

    <div style="border-top: 1px dashed #bbb; margin: 12px 0;"></div>

    <div style="text-align: center; margin-top: 20px;">
      <div
        style="font-size: 11px; font-style: italic; font-weight: 800; color: #4CAF50; margin-bottom: 2px;"
      >
        "Minyak lama, energi baru!"
      </div>
      <div style="font-size: 10px; color: #555; margin-bottom: 12px;">
        Bersama jaga bumi Indonesia 💚
      </div>
      <div
        id="str-target-id"
        style="background: #f9f9f9; border: 1px solid #ccc; padding: 6px 0; border-radius: 4px; font-family: monospace; font-size: 10px; color: #333; letter-spacing: 1px;"
      >
        ID: -
      </div>
    </div>
  </div>
</div>
<script
  src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"
  is:inline></script>
<script is:inline>
  document.addEventListener("DOMContentLoaded", async () => {
    // === 🛡️ GATEKEEPER KEUANGAN ===
    const allowedRoles = ["owner", "hrd", "keuangan", "admin", "it"];
    const client = window.supabase || supabase;

    // === 🔒 DOUBLE-CLICK RACE GUARD ===
    const processingIds = new Set();

    const {
      data: { session },
    } = await client.auth.getSession();
    if (!session) return window.location.replace("/"); // Tendang kalau belum login

    const { data: prof } = await client
      .from("profiles")
      .select("role")
      .eq("id", session.user.id)
      .single();
    if (!allowedRoles.includes(prof?.role)) {
      alert(
        `Akses Ditolak! Role Anda (${prof?.role || "Guest"}) dilarang masuk ke Keuangan.`,
      );
      return window.location.replace("/");
    }
    document.body.style.display = "block"; // Buka gembok CSS, tampilkan layar!

    // ==========================================
    // 1. FETCH DATA PEMBELIAN & VALIDASI
    // ==========================================
    async function loadData() {
      if (!window.supabase) return;
      try {
        const { data: listMitra } = await window.supabase
          .from("mitra")
          .select("id, nama_mitra")
          .order("nama_mitra", { ascending: true });
        window.allMitraGlobal = listMitra || [];

        const { data: transaksi, error: errTransaksi } = await window.supabase
          .from("transaksi")
          .select(
            "*, transaksi_item(komoditas, volume, harga_unit, id), penjemputan(tanggal, mitra(nama_mitra, id, nomor_hp), mitra_id), driver:profiles!kalkulator_user_id(nama)",
          )
          .order("created_at", { ascending: false });

        if (errTransaksi) {
          alert("Error Supabase (Transaksi): " + errTransaksi.message);
          console.error("Detail Error Transaksi:", errTransaksi);
        }

        // Render Tabel Pembelian
        const tbodyPembelian = document.getElementById("pembelian-tbody");
        let htmlPembelian = "";
        transaksi?.forEach((t) => {
          const tanggal = t.penjemputan?.tanggal || t.tanggal_transaksi || "-";
          const jam = t.created_at
            ? new Date(t.created_at).toLocaleTimeString("id-ID", {
                hour: "2-digit",
                minute: "2-digit",
                timeZone: "Asia/Jakarta",
              })
            : "";
          const waktuTampil = jam ? `${jam} WIB` : "";
          const namaMitra =
            t.penjemputan?.mitra?.nama_mitra ||
            t.nama_mitra_tidak_terdaftar ||
            "Tanpa Nama Mitra";
          if (t.transaksi_item && t.transaksi_item.length > 0) {
            t.transaksi_item.forEach((item) => {
              const hargaSatuan = item.harga_unit || 0;
              const subtotal = item.volume * hargaSatuan;

              // PERBAHARUAN TAHAP 1:
              // Memasukkan variabel 'tanggal' langsung ke data-date
              // Menambahkan atribut data-komoditas
              htmlPembelian += ` 
                        <tr class="hover:bg-gray-50" data-date="${tanggal}" data-komoditas="${item.komoditas || ""}" data-berat="${item.volume || 0}" data-subtotal="${subtotal || 0}">
                            <td class="px-6 py-4 text-sm text-gray-600 whitespace-nowrap">
                                <div class="font-medium text-gray-900">${tanggal}</div>
                                ${jam ? `<div class="text-[11px] text-gray-400 font-mono mt-0.5">${waktuTampil}</div>` : ""}
                            </td>
                            <td class="px-6 py-4 text-sm font-bold text-gray-900 whitespace-nowrap">${namaMitra}</td> 
                            <td class="px-6 py-4 text-sm font-medium text-blue-700 whitespace-nowrap">${item.komoditas}</td>
                            <td class="px-6 py-4 text-sm text-gray-700 text-right">${item.volume} Kg</td>
                            <td class="px-6 py-4 text-sm text-gray-600 text-right">Rp ${hargaSatuan.toLocaleString("id-ID")}</td> 
                            <td class="px-6 py-4 text-sm font-bold text-right text-green-700">Rp ${subtotal.toLocaleString("id-ID")}</td>
                        </tr>`;
            });
          }
        });
        tbodyPembelian.innerHTML =
          htmlPembelian ||
          '<tr><td colspan="6" class="text-center py-4 text-gray-500 italic">Data pembelian kosong</td></tr>';

        // ⭐ Tambahkan baris ini:
        window.hitungRingkasanPembelian();

        // Pisahkan Data Validasi
        const trxMenunggu =
          transaksi?.filter((t) => !t.is_paid_by_admin && t.metode_bayar) || [];
        const trxSelesai = transaksi?.filter((t) => t.is_paid_by_admin) || [];
        window.dataTransaksiGlobal = trxMenunggu;
        window.riwayatLunasGlobal = trxSelesai;

        const badge = document.getElementById("badge-validasi");
        const countEl = document.getElementById("title-validasi-count");
        if (badge && countEl) {
          countEl.innerText = trxMenunggu.length;
          if (trxMenunggu.length > 0) {
            badge.innerText = trxMenunggu.length;
            badge.classList.remove("hidden");
            badge.classList.add("inline-flex"); // <--- Tambahkan baris ini
          }
        }

        const valContainer = document.getElementById("validasi-container");
        let htmlVal = "";
        trxMenunggu.forEach((trx) => {
          const jam = trx.created_at
            ? new Date(trx.created_at).toLocaleTimeString("id-ID", {
