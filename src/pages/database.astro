      // ===== MODAL FUNCTIONS =====
      function openModal() {
        const formModal = document.getElementById("formModal");
        formModal.classList.remove("hidden");
        formModal.classList.add("flex");
        setTimeout(() => {
          formModal.classList.remove("opacity-0");
          formModal.querySelector("div").classList.remove("scale-95");
        }, 10);
      }

      function closeModal() {
        const formModal = document.getElementById("formModal");
        formModal.classList.add("opacity-0");
        formModal.querySelector("div").classList.add("scale-95");
        setTimeout(() => {
          formModal.classList.add("hidden");
          formModal.classList.remove("flex");
        }, 300);
      }

      document
        .getElementById("closeFormBtn")
        .addEventListener("click", closeModal);
      document
        .getElementById("cancelBtn")
        .addEventListener("click", closeModal);

      // ===== ADD BUTTON =====
      document
        .getElementById("openFormBtn")
        .addEventListener("click", function () {
          const activeTab = document.querySelector(".tab-btn.bg-green-700");
          const tabName = activeTab.getAttribute("data-tab");

          document.getElementById("editId").value = "";
          document.getElementById("currentTab").value = tabName;

          if (tabName === "mitra") {
            document.getElementById("modalTitle").textContent = "Tambah Mitra";
            renderMitraForm();
          } else if (tabName === "gudang") {
            document.getElementById("modalTitle").textContent =
              "Saya tidak bisa menambah gudang (data fixed)";
            return alert(
              "Gudang Komoditas sudah di-set otomatis. Hanya bisa mengedit stok!",
            );
          } else if (tabName === "stock_harian") {
            document.getElementById("modalTitle").textContent =
              "Tambah Stok Gudang Harian";
            renderStockHarianForm();
          } else if (tabName === "pembelian") {
            document.getElementById("modalTitle").textContent =
              "Tambah Pembelian Barang";
            renderPembelianForm();
          } else if (tabName === "penjualan") {
            document.getElementById("modalTitle").textContent =
              "Tambah Penjualan Barang";
            renderPenjualanForm();
          } else if (tabName === "pengeluaran") {
            document.getElementById("modalTitle").textContent =
              "Tambah Pengeluaran Harian";
            renderPengeluaranForm();
          }

          openModal();
        });

      // ===== FORM SUBMIT =====
      document
        .getElementById("dynamicForm")
        .addEventListener("submit", async function (e) {
          e.preventDefault();

          const editId = document.getElementById("editId").value;
          const currentTab = document.getElementById("currentTab").value;
          const btn = document.getElementById("submitBtn");

          btn.innerText = "Memproses...";
          btn.disabled = true;

          try {
            const formData = new FormData(this);
            const data = Object.fromEntries(formData);

            // 🔥 1. PISAHKAN DATA REKENING (PASTIKAN ANGKA 0 DI DEPAN AMAN JADI STRING) 🔥
            const dataRekening = {
              nama_bank: data.nama_bank || null,
              no_rek: data.no_rek ? String(data.no_rek) : null, // Dijamin jadi teks/String
              atas_nama: data.atas_nama || null,
            };

            // Hapus property rekening dari object 'data' induk agar tidak error saat nyimpan ke tabel mitra
            delete data.nama_bank;
            delete data.no_rek;
            delete data.atas_nama;

            // Convert numeric fields (Ini tidak akan menyentuh no_rek karena sudah kita cabut di atas)
            Object.keys(data).forEach((key) => {
              if (
                key !== "sumber" &&
                key !== "nama_mitra" &&
                key !== "alamat" &&
                key !== "link_gmaps" &&
                key !== "nomor_hp" &&
                key !== "rute_jemput" &&
                key !== "sumber_mitra" &&
                key !== "tanggal"
              ) {
                if (data[key] !== "" && !isNaN(data[key])) {
                  data[key] = parseFloat(data[key]);
                }
              }
            });

            // =======================================================
            // 🚀 A. LOGIKA KHUSUS TAB MITRA (Simpan ke 2 Tabel)
            // =======================================================
            if (currentTab === "mitra") {
              data.activated =
                document.querySelector('input[name="activated"]')?.checked ||
                false;
              let mitraIdSaved = editId;

              // 1. Simpan ke tabel 'mitra'
              if (editId) {
                const { error: errMitra } = await window.supabase
                  .from("mitra")
                  .update(data)
                  .eq("id", editId);
                if (errMitra) throw errMitra;
              } else {
                // Insert baru dan tarik kembali ID-nya
                const { data: newMitra, error: errMitra } =
                  await window.supabase
                    .from("mitra")
                    .insert([data])
                    .select("id")
                    .single();
                if (errMitra) throw errMitra;
                mitraIdSaved = newMitra.id;
              }

              // 2. Simpan ke tabel 'rek_mitra' (Opsional)
              const isRekeningDiisi =
                dataRekening.nama_bank ||
                dataRekening.no_rek ||
                dataRekening.atas_nama;

              if (isRekeningDiisi) {
                dataRekening.mitra_id = mitraIdSaved;

                // Cek apakah mitra ini sudah punya data rekening
                const { data: cekRek } = await window.supabase
                  .from("rek_mitra")
                  .select("id")
                  .eq("mitra_id", mitraIdSaved)
                  .maybeSingle();

                if (cekRek) {
                  // Jika sudah ada -> UPDATE
                  const { error: errRek } = await window.supabase
                    .from("rek_mitra")
                    .update(dataRekening)
                    .eq("id", cekRek.id);
                  if (errRek) throw errRek;
                } else {
                  // Jika belum ada -> INSERT
                  const { error: errRek } = await window.supabase
                    .from("rek_mitra")
                    .insert([dataRekening]);
                  if (errRek) throw errRek;
                }
              } else if (editId) {
                // Jika form rekening dikosongkan saat ngedit, hapus data rekening dari database
                await window.supabase
                  .from("rek_mitra")
                  .delete()
                  .eq("mitra_id", mitraIdSaved);
              }

              alert(
                editId
                  ? "Profil Mitra & Rekening berhasil diperbarui!"
                  : "Profil Mitra & Rekening berhasil ditambahkan!",
              );
              closeModal();
              loadMitra();
              return; // 🛑 Hentikan kode agar tidak lanjut ke logika tab lain di bawah
            }

            // =======================================================
            // 🚀 B. LOGIKA UNTUK TAB LAINNYA (Gudang, Pembelian, dll)
            // =======================================================
            let targetTable =
              currentTab === "gudang"
                ? "gudang_komoditas"
                : currentTab === "stock_harian"
                  ? "stock_gudang_harian"
                  : currentTab === "pembelian"
                    ? "pembelian_barang_harian"
                    : currentTab === "penjualan"
                      ? "penjualan_barang_harian"
                      : currentTab === "pengeluaran"
                        ? "pengeluaran_harian"
                        : "";

            if (!targetTable) throw new Error("Tabel tujuan tidak ditemukan!");

            let result;
            if (editId) {
              result = await window.supabase
                .from(targetTable)
                .update(data)
                .eq("id", editId);
            } else {
              result = await window.supabase.from(targetTable).insert([data]);
            }

            if (result.error) throw result.error;

            alert(
              editId
                ? "Data berhasil diperbarui!"
                : "Data berhasil ditambahkan!",
            );
            closeModal();

            if (currentTab === "gudang") loadGudang();
            else if (currentTab === "stock_harian") loadStockHarian();
            else if (currentTab === "pembelian") loadPembelian();
            else if (currentTab === "penjualan") loadPenjualan();
            else if (currentTab === "pengeluaran") loadPengeluaran();
          } catch (err) {
            alert("Gagal memproses data: " + err.message);
          } finally {
            btn.innerText = "Simpan";
            btn.disabled = false;
          }
        });

      // ===== HAPUS DATA FUNCTION =====
      window.hapusData = async function (table, id, nama) {
        if (!confirm(`Yakin ingin menghapus "${nama}"?`)) return;

        try {
          const { error } = await supabase.from(table).delete().eq("id", id);
          if (error) throw error;

          alert("Data berhasil dihapus!");

          if (table === "mitra") loadMitra();
          else if (table === "stock_gudang_harian") loadStockHarian();
          else if (table === "pembelian_barang_harian") loadPembelian();
          else if (table === "penjualan_barang_harian") loadPenjualan();
          else if (table === "pengeluaran_harian") loadPengeluaran();
          else if (table === "rek_mitra") loadRekening(); // <--- TARUH DI SINI BRO
        } catch (err) {
          alert("Gagal: " + err.message);
        }
      };

      // ==========================================
