---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// 1. Tarik Data Jadwal Penjemputan + Join Transaksi & Transaksi Item (Komoditas & Volume)
const { data: jadwalPenjemputan, error: errJadwal } = await supabase
    .from('penjemputan')
    .select(`
        id,
        status,
        tanggal,
        mitra ( id, nama_mitra, alamat ),
        driver:driver_id ( id, nama, tipe_kendaraan ),
        helper:helper_id ( id, nama ),
        transaksi (
            id,
            potongan_dp,
            transaksi_item (
                id,
                komoditas,
                volume
            )
        )
    `)
    .order('tanggal', { ascending: false });

if (errJadwal) {
    console.error("Gagal menarik jadwal operasional:", errJadwal);
}

// 2. Tarik Daftar Mitra untuk Dropdown Pilihan di Modal Penjemputan Baru
const { data: daftarMitra } = await supabase
    .from('mitra')
    .select('id, nama_mitra, alamat')
    .order('nama_mitra', { ascending: true });

// 3. Tarik Karyawan Lapangan untuk Dropdown Tim Penjemput
const { data: karyawanLapangan } = await supabase
    .from('profiles')
    .select('id, nama, tipe_kendaraan')
    .eq('role', 'lapangan');

const kurirMotor = karyawanLapangan?.filter(k => k.tipe_kendaraan === 'motor') || [];
const supirMobil = karyawanLapangan?.filter(k => k.tipe_kendaraan === 'mobil_driver') || [];
const kenekMobil = karyawanLapangan?.filter(k => k.tipe_kendaraan === 'mobil_helper') || [];

// Pisahkan data berdasarkan status untuk masing-masing Tab
const pending = jadwalPenjemputan?.filter(j => j.status === 'Belum') || [];
const onProgress = jadwalPenjemputan?.filter(j => j.status === 'OTW' || j.status === 'Proses') || [];
const history = jadwalPenjemputan?.filter(j => j.status === 'Selesai') || [];
---

<Layout title="Operasional Penjemputan - Manajemen Bang Jelantah">
    <style>
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .modal { display: none; }
        .modal.active { display: flex; }
        
        /* Mobile Table Cards Style */
        @media (max-width: 768px) {
            .mobile-table-card thead { display: none; }
            .mobile-table-card tbody tr {
                display: flex;
                flex-direction: column;
                margin-bottom: 1rem;
                border: 1px solid #bfcaba;
                border-radius: 0.5rem;
                background-color: #ffffff;
            }
            .mobile-table-card tbody td {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 8px 16px;
                border-bottom: 1px solid #e3e2e2;
            }
            .mobile-table-card tbody td:last-child {
                border-bottom: none;
            }
            .mobile-table-card tbody td::before {
                content: attr(data-label);
                font-weight: 600;
                color: #40493d;
                font-size: 12px;
            }
        }
    </style>

    <div class="max-w-7xl mx-auto flex flex-col h-full">
        <div class="mb-lg flex flex-col md:flex-row md:items-end justify-between gap-md">
            <div>
                <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary">Operasional Penjemputan</h1>
                <p class="font-body-md text-body-md text-on-surface-variant mt-xs">Manajemen lapangan, komoditas masuk, dan monitoring tim harian.</p>
            </div>
            <div class="flex gap-md">
                <button class="bg-surface-container border border-outline-variant text-on-surface font-label-lg text-label-lg rounded-full px-lg py-sm flex items-center gap-sm hover:bg-surface-container-high transition-colors min-h-touch-target">
                    <span class="material-symbols-outlined text-[18px]">filter_list</span> Filter
                </button>
                <button class="bg-primary text-on-primary font-label-lg text-label-lg rounded-full px-lg py-sm flex items-center gap-sm hover:opacity-90 shadow-sm transition-all min-h-touch-target active:scale-95" onclick="openModal()">
                    <span class="material-symbols-outlined text-[18px]">add</span> Buat Penjemputan Baru
                </button>
            </div>
        </div>

        <div class="flex border-b border-outline-variant mb-md overflow-x-auto hide-scrollbar">
            <button class="px-md py-sm font-label-lg text-primary border-b-2 border-primary whitespace-nowrap" id="tab-pending" onclick="switchTab('pending')">Belum Diproses ({pending.length})</button>
            <button class="px-md py-sm font-label-lg text-on-surface-variant border-b-2 border-transparent hover:bg-surface-container-low transition-colors whitespace-nowrap" id="tab-progress" onclick="switchTab('progress')">Sedang Diproses ({onProgress.length})</button>
            <button class="px-md py-sm font-label-lg text-on-surface-variant border-b-2 border-transparent hover:bg-surface-container-low transition-colors whitespace-nowrap" id="tab-history" onclick="switchTab('history')">Riwayat Selesai</button>
        </div>

        <div class="tab-content active" id="content-pending">
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden flex flex-col">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse mobile-table-card min-w-[800px]">
                        <thead>
                            <tr class="bg-surface-container-low border-b border-outline-variant">
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase">Nama Mitra</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase">Alamat Pengambilan</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase">Kendaraan</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase">Kurir Ditugaskan</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase">Status</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant font-body-md text-body-md text-on-surface bg-surface-container-lowest">
                            {pending.length > 0 ? pending.map((jadwal) => (
                                <tr class="hover:bg-surface-container-low transition-colors">
                                    <td class="px-md py-md whitespace-nowrap font-semibold" data-label="Nama Mitra">{jadwal.mitra?.nama_mitra}</td>
                                    <td class="px-md py-md truncate max-w-[200px]" data-label="Alamat">{jadwal.mitra?.alamat || '-'}</td> 
                                    <td class="px-md py-md capitalize" data-label="Kendaraan">{jadwal.driver?.tipe_kendaraan === 'motor' ? 'Motor' : 'Mobil'}</td>
                                    <td class="px-md py-md" data-label="Kurir">
                                        {jadwal.driver?.nama} {jadwal.helper?.nama ? `& ${jadwal.helper.nama}` : ''}
                                    </td>
                                    <td class="px-md py-md" data-label="Status">
                                        <span class="inline-flex items-center gap-xs px-2 py-1 rounded-full bg-amber-100 text-amber-800 font-label-sm text-[11px]">
                                            <span class="w-2 h-2 rounded-full bg-amber-500"></span> {jadwal.status}
                                        </span>
                                    </td>
                                    <td class="px-md py-md text-right" data-label="Aksi">
                                        <span class="text-xs text-on-surface-variant italic">Menunggu Lapangan...</span>
                                    </td>
                                </tr>
                            )) : <tr><td colspan="6" class="p-4 text-center text-on-surface-variant">Tidak ada jadwal penjemputan baru.</td></tr>}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-content" id="content-progress">
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden flex flex-col">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse mobile-table-card min-w-[800px]">
                        <thead>
                            <tr class="bg-surface-container-low border-b border-outline-variant">
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase">Nama Mitra</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase">Alamat</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase">Kendaraan</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase">Kurir</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase">Status Operasional</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant font-body-md text-body-md text-on-surface bg-surface-container-lowest">
                            {onProgress.length > 0 ? onProgress.map((jadwal) => (
                                <tr class="hover:bg-surface-container-low transition-colors">
                                    <td class="px-md py-md whitespace-nowrap font-semibold" data-label="Nama Mitra">{jadwal.mitra?.nama_mitra}</td>
                                    <td class="px-md py-md truncate max-w-[200px]" data-label="Alamat">{jadwal.mitra?.alamat || '-'}</td>
                                    <td class="px-md py-md capitalize" data-label="Kendaraan">{jadwal.driver?.tipe_kendaraan === 'motor' ? 'Motor' : 'Mobil'}</td>
                                    <td class="px-md py-md" data-label="Kurir">
                                        {jadwal.driver?.nama} {jadwal.helper?.nama ? `& ${jadwal.helper.nama}` : ''}
                                    </td>
                                    <td class="px-md py-md" data-label="Status">
                                        <span class="inline-flex items-center gap-xs px-2 py-1 rounded-full bg-blue-100 text-blue-800 font-label-sm text-[11px]">
                                            <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span> {jadwal.status}
                                        </span>
                                    </td>
                                    <td class="px-md py-md text-right" data-label="Aksi">
                                        <button class="bg-secondary text-on-secondary font-label-sm rounded-full px-4 py-1 hover:opacity-90 transition-all">Pantau Rute</button>
                                    </td>
                                </tr>
                            )) : <tr><td colspan="6" class="p-4 text-center text-on-surface-variant">Tidak ada armada yang sedang di perjalanan.</td></tr>}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="tab-content" id="content-history">
            <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden flex flex-col">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse mobile-table-card min-w-[900px]">
                        <thead>
                            <tr class="bg-surface-container-low border-b border-outline-variant">
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase">Nama Mitra</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase">Tanggal Selesai</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase">Rincian Komoditas (Real)</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase text-right">Potongan DP</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase text-right">Total Berat Real</th>
                                <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant uppercase">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant font-body-md text-body-md text-on-surface bg-surface-container-lowest">
                            {history.length > 0 ? history.map((jadwal) => {
                                const tData = jadwal.transaksi?.[0];
                                const items = tData?.transaksi_item || [];
                                const totalRealKg = items.reduce((acc, curr) => acc + parseFloat(curr.volume || 0), 0);

                                return (
                                    <tr class="hover:bg-surface-container-low transition-colors">
                                        <td class="px-md py-md whitespace-nowrap font-semibold" data-label="Nama Mitra">{jadwal.mitra?.nama_mitra}</td>
                                        <td class="px-md py-md whitespace-nowrap" data-label="Tanggal Selesai">{jadwal.tanggal}</td>
                                        <td class="px-md py-md" data-label="Rincian Komoditas">
                                            <div class="flex flex-col gap-xs my-1">
                                                {items.length > 0 ? items.map((item) => (
                                                    <span class="inline-flex items-center gap-1 text-xs font-medium text-on-surface-variant bg-surface-container px-2 py-0.5 rounded border border-outline-variant w-fit">
                                                        📦 <strong class="text-primary">{item.komoditas}:</strong> {item.volume} Kg
                                                    </span>
                                                )) : <span class="text-xs italic text-red-600">Data belum diinput lapangan</span>}
                                            </div>
                                        </td>
                                        <td class="px-md py-md text-right text-amber-700 font-medium" data-label="Potongan DP">
                                            {tData?.potongan_dp ? `Rp ${Number(tData.potongan_dp).toLocaleString('id-ID')}` : '-'}
                                        </td>
                                        <td class="px-md py-md font-bold text-right text-primary" data-label="Total Berat Real">
                                            {totalRealKg} KG
                                        </td>
                                        <td class="px-md py-md" data-label="Status">
                                            <span class="inline-flex items-center gap-xs px-2 py-1 rounded-full bg-emerald-100 text-emerald-800 font-label-sm text-[11px]">
                                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Selesai
                                            </span>
                                        </td>
                                    </tr>
                                );
                            }) : <tr><td colspan="6" class="p-4 text-center text-on-surface-variant">Riwayat transaksi operasional kosong.</td></tr>}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fixed inset-0 z-[100] bg-on-background/50 items-center justify-center p-md transition-opacity" id="new-pickup-modal">
        <div class="bg-surface rounded-xl shadow-lg w-full max-w-md flex flex-col max-h-[90vh]">
            <div class="p-md border-b border-outline-variant flex justify-between items-center bg-surface-container-low rounded-t-xl">
                <h2 class="font-headline-md text-on-surface">Tugaskan Jadwal Baru</h2>
                <button class="text-on-surface-variant hover:text-on-surface transition-colors p-sm rounded-full hover:bg-surface-variant flex items-center justify-center" onclick="closeModal()">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            
            <form id="formPenjemputan" class="flex flex-col h-full overflow-hidden">
                <div class="p-md overflow-y-auto flex-1 flex flex-col gap-md">
                    
                    <div>
                        <label class="block font-label-sm text-on-surface-variant mb-xs">Pilih Lokasi Mitra</label>
                        <select id="input_mitra" class="w-full px-sm py-sm border border-outline-variant rounded-md bg-surface-container focus:border-primary focus:ring-1 focus:ring-primary font-body-md outline-none" required>
                            <option value="">-- Pilih Mitra Pengumpul --</option>
                            {daftarMitra && daftarMitra.map(m => (
                                <option value={m.id}>{m.nama_mitra} - {m.alamat?.substring(0,30)}...</option>
                            ))}
                        </select>
                    </div>

                    <div>
                        <label class="block font-label-sm text-on-surface-variant mb-xs">Jenis Armada</label>
                        <input type="hidden" id="tipe_kendaraan_input" value="motor">
                        <div class="flex bg-surface-container-low rounded-lg p-1 gap-1">
                            <button type="button" class="flex-1 py-2 rounded-md font-label-sm bg-surface shadow text-primary font-bold transition-all" id="btn-motor" onclick="setVehicle('motor')">Motor Lapangan</button>
                            <button type="button" class="flex-1 py-2 rounded-md font-label-sm text-on-surface-variant hover:bg-surface-variant transition-all" id="btn-mobil" onclick="setVehicle('mobil')">Mobil Box</button>
                        </div>
                    </div>

                    <div class="block" id="kurir-motor-select">
                        <label class="block font-label-sm text-on-surface-variant mb-xs">Pilih Driver Motor</label>
                        <select id="input_driver_motor" class="w-full px-sm py-sm border border-outline-variant rounded-md bg-surface-container focus:border-primary focus:ring-1 focus:ring-primary font-body-md outline-none" required>
                            <option value="">-- Pilih Kurir --</option>
                            {kurirMotor.map(d => <option value={d.id}>{d.nama}</option>)}
                        </select>
                    </div>

                    <div class="hidden gap-md flex-col" id="kurir-mobil-select">
                        <div class="flex-1">
                            <label class="block font-label-sm text-on-surface-variant mb-xs">Pilih Supir (Driver)</label>
                            <select id="input_driver_mobil" class="w-full px-sm py-sm border border-outline-variant rounded-md bg-surface-container focus:border-primary focus:ring-1 focus:ring-primary font-body-md outline-none">
                                <option value="">-- Pilih Supir --</option>
                                {supirMobil.map(d => <option value={d.id}>{d.nama}</option>)}
                            </select>
                        </div>
                        <div class="flex-1 mt-2">
                            <label class="block font-label-sm text-on-surface-variant mb-xs">Pilih Pendamping (Helper)</label>
                            <select id="input_helper_mobil" class="w-full px-sm py-sm border border-outline-variant rounded-md bg-surface-container focus:border-primary focus:ring-1 focus:ring-primary font-body-md outline-none">
                                <option value="">-- Tanpa Helper --</option>
                                {kenekMobil.map(h => <option value={h.id}>{h.nama}</option>)}
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block font-label-sm text-on-surface-variant mb-xs">Tanggal Eksekusi</label>
                        <input id="input_tanggal" type="date" class="w-full px-sm py-sm border border-outline-variant rounded-md bg-surface-container focus:border-primary focus:ring-1 focus:ring-primary font-body-md outline-none" required>
                    </div>

                    <div>
                        <label class="block font-label-sm text-on-surface-variant mb-xs">Potongan DP (Optional - Rupiah)</label>
                        <input id="input_dp" type="number" placeholder="Contoh: 50000" class="w-full px-sm py-sm border border-outline-variant rounded-md bg-surface-container focus:border-primary focus:ring-1 focus:ring-primary font-body-md outline-none">
                    </div>

                    <div class="border-t border-outline-variant pt-3">
                        <div class="flex justify-between items-center mb-xs">
                            <label class="block font-label-sm text-on-surface-variant font-bold">Rincian Barang yang Diambil</label>
                            <button type="button" onclick="addBarangRow()" class="text-xs font-bold text-primary hover:underline flex items-center gap-0.5">+ Tambah</button>
                        </div>
                        
                        <div id="barang-rows-container" class="flex flex-col gap-xs">
                            <div class="flex gap-xs barang-row items-center">
                                <select class="row-komoditas flex-1 h-9 px-xs border border-outline-variant rounded bg-surface-container text-xs outline-none focus:border-primary" required>
                                    <option value="Minyak Jelantah Kotor">Minyak Jelantah Kotor</option>
                                    <option value="Tepung">Tepung</option>
                                    <option value="Kriuk">Kriuk</option>
                                </select>
                                <input type="number" step="0.1" placeholder="Jumlah (Kg)" class="row-volume w-28 h-9 px-xs border border-outline-variant rounded bg-surface-container text-xs outline-none focus:border-primary" required />
                                <button type="button" onclick="removeBarangRow(this)" class="text-error hover:bg-error-container/20 w-8 h-9 rounded flex items-center justify-center text-sm">✕</button>
                            </div>
                        </div>
                    </div>

                </div>
                
                <div class="p-md border-t border-outline-variant bg-surface-container-lowest rounded-b-xl flex gap-sm shrink-0">
                    <button type="button" class="flex-1 bg-surface-container-low text-on-surface-variant font-label-lg rounded-full py-md hover:bg-surface-variant transition-all" onclick="closeModal()">Batal</button>
                    <button type="submit" id="btnSubmitPenjemputan" class="flex-1 bg-primary text-on-primary font-label-lg rounded-full py-md hover:opacity-90 transition-all shadow-sm active:scale-95">
                        Kirim Perintah Jalan
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script is:inline>
        window.switchTab = function(tabId) {
            document.querySelectorAll('[id^="tab-"]').forEach(btn => {
                btn.className = 'px-md py-sm font-label-lg text-on-surface-variant border-b-2 border-transparent hover:bg-surface-container-low transition-colors whitespace-nowrap';
            });
            const activeBtn = document.getElementById('tab-' + tabId);
            activeBtn.className = 'px-md py-sm font-label-lg text-primary border-b-2 border-primary whitespace-nowrap';

            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.remove('active');
            });
            document.getElementById('content-' + tabId).classList.add('active');
        };

        window.openModal = function() {
            document.getElementById('new-pickup-modal').classList.add('active');
            document.getElementById('input_tanggal').valueAsDate = new Date();
            // Reset container barang ke default satu baris kosong saat modal dibuka kembali
            document.getElementById('barang-rows-container').innerHTML = `
                <div class="flex gap-xs barang-row items-center">
                    <select class="row-komoditas flex-1 h-9 px-xs border border-outline-variant rounded bg-surface-container text-xs outline-none focus:border-primary" required>
                        <option value="Minyak Jelantah Kotor">Minyak Jelantah Kotor</option>
                        <option value="Tepung">Tepung</option>
                        <option value="Kriuk">Kriuk</option>
                    </select>
                    <input type="number" step="0.1" placeholder="Jumlah (Kg)" class="row-volume w-28 h-9 px-xs border border-outline-variant rounded bg-surface-container text-xs outline-none focus:border-primary" required />
                    <button type="button" onclick="removeBarangRow(this)" class="text-error hover:bg-error-container/20 w-8 h-9 rounded flex items-center justify-center text-sm">✕</button>
                </div>
            `;
            document.getElementById('input_dp').value = '';
        };
        
        window.closeModal = function() {
            document.getElementById('new-pickup-modal').classList.remove('active');
        };

        // Tambah Baris Rincian Barang Dinamis
        window.addBarangRow = function() {
            const container = document.getElementById('barang-rows-container');
            const div = document.createElement('div');
            div.className = 'flex gap-xs barang-row items-center';
            div.innerHTML = `
                <select class="row-komoditas flex-1 h-9 px-xs border border-outline-variant rounded bg-surface-container text-xs outline-none focus:border-primary" required>
                    <option value="Minyak Jelantah Kotor">Minyak Jelantah Kotor</option>
                    <option value="Tepung">Tepung</option>
                    <option value="Kriuk">Kriuk</option>
                </select>
                <input type="number" step="0.1" placeholder="Jumlah (Kg)" class="row-volume w-28 h-9 px-xs border border-outline-variant rounded bg-surface-container text-xs outline-none focus:border-primary" required />
                <button type="button" onclick="removeBarangRow(this)" class="text-error hover:bg-error-container/20 w-8 h-9 rounded flex items-center justify-center text-sm">✕</button>
            `;
            container.appendChild(div);
        };

        // Hapus Baris Rincian Barang
        window.removeBarangRow = function(button) {
            const container = document.getElementById('barang-rows-container');
            if (container.children.length > 1) {
                button.parentElement.remove();
            } else {
                alert('Minimal harus ada 1 rincian barang yang dicatat!');
            }
        };

        window.setVehicle = function(type) {
            document.getElementById('tipe_kendaraan_input').value = type;
            const btnMotor = document.getElementById('btn-motor');
            const btnMobil = document.getElementById('btn-mobil');
            const selectMotor = document.getElementById('kurir-motor-select');
            const selectMobil = document.getElementById('kurir-mobil-select');

            if (type === 'motor') {
                btnMotor.className = 'flex-1 py-2 rounded-md font-label-sm bg-surface shadow text-primary font-bold transition-all';
                btnMobil.className = 'flex-1 py-2 rounded-md font-label-sm text-on-surface-variant hover:bg-surface-variant transition-all';
                selectMotor.classList.replace('hidden', 'block');
                selectMobil.classList.replace('flex', 'hidden');
                
                document.getElementById('input_driver_motor').required = true;
                document.getElementById('input_driver_mobil').required = false;
            } else {
                btnMobil.className = 'flex-1 py-2 rounded-md font-label-sm bg-surface shadow text-primary font-bold transition-all';
                btnMotor.className = 'flex-1 py-2 rounded-md font-label-sm text-on-surface-variant hover:bg-surface-variant transition-all';
                selectMotor.classList.replace('block', 'hidden');
                selectMobil.classList.replace('hidden', 'flex');
                
                document.getElementById('input_driver_motor').required = false;
                document.getElementById('input_driver_mobil').required = true;
            }
        };

        // Submit Tugas Baru & Menyimpan Rincian ke Supabase
        document.getElementById('formPenjemputan')?.addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitPenjemputan');
            btn.innerHTML = 'Menyimpan...';
            btn.disabled = true;

            try {
                const tipeKendaraan = document.getElementById('tipe_kendaraan_input').value;
                const mitra_id = document.getElementById('input_mitra').value;
                const tanggal = document.getElementById('input_tanggal').value;
                const dpValue = document.getElementById('input_dp').value;
                
                let driver_id = null;
                let helper_id = null;

                if (tipeKendaraan === 'motor') {
                    driver_id = document.getElementById('input_driver_motor').value;
                } else {
                    driver_id = document.getElementById('input_driver_mobil').value;
                    const helper = document.getElementById('input_helper_mobil').value;
                    if(helper) helper_id = helper;
                }

                if (!window.supabase) throw new Error("Supabase Client tidak ditemukan!");

                // 1. Simpan data utama ke tabel 'penjemputan'
                const { data: pickupData, error: errPickup } = await window.supabase
                    .from('penjemputan')
                    .insert([{
                        mitra_id: parseInt(mitra_id),
                        driver_id: driver_id,
                        helper_id: helper_id || null,
                        tanggal: tanggal,
                        status: 'Belum'
                    }])
                    .select()
                    .single();

                if (errPickup) throw errPickup;

                // 2. Simpan induk data 'transaksi' (untuk mencatat DP)
                const { data: txData, error: errTx } = await window.supabase
                    .from('transaksi')
                    .insert([{
                        penjemputan_id: pickupData.id,
                        kalkulator_user_id: driver_id,
                        potongan_dp: dpValue ? parseFloat(dpValue) : 0,
                        subtotal: 0,
                        grand_total: 0
                    }])
                    .select()
                    .single();

                if (errTx) throw errTx;

                // 3. Loop & kumpulkan data rincian barang dari elemen input DOM dinamis
                const rows = document.querySelectorAll('.barang-row');
                const itemsToInsert = [];

                rows.forEach(row => {
                    const komoditas = row.querySelector('.row-komoditas').value;
                    const volume = row.querySelector('.row-volume').value;
                    
                    if(komoditas && volume) {
                        itemsToInsert.push({
                            transaksi_id: txData.id,
                            komoditas: komoditas,
                            volume: parseFloat(volume),
                            harga_unit: 0 // Default awal sebelum di-audit admin keuangan
                        });
                    }
                });

                // 4. Masukkan array rincian barang sekaligus ke tabel 'transaksi_item'
                if(itemsToInsert.length > 0) {
                    const { error: errItems } = await window.supabase
                        .from('transaksi_item')
                        .insert(itemsToInsert);
                        
                    if (errItems) throw errItems;
                }
                
                alert('Tugas penjemputan dan rincian kuantitas berhasil diterbitkan!');
                window.location.reload();
                
            } catch (error) {
                alert('Gagal memproses penugasan: ' + error.message);
                btn.innerHTML = 'Kirim Perintah Jalan';
                btn.disabled = false;
            }
        });
    </script>
</Layout>