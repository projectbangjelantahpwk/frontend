---
// components/dashboard/KPICard.astro

// 1. Data Konfigurasi Card ditaruh di sini
const kpiCards = [
  {
    id: "minyak_jelantah",
    title: "Minyak Jelantah",
    icon: "/icons/6.png",
    gradient: "from-primary-container to-primary-container/70",
    border: "border-primary/20",
    text: "text-on-primary-container",
  },

  {
    id: "minyak_asting",
    title: "Minyak Asting",
    icon: "/icons/11.png",
    gradient: "from-indigo-container to-indigo-container/70",
    border: "border-indigo/20",
    text: "text-on-indigo-container",
  },
  {
    id: "ampas",
    title: "Ampas",
    icon: "/icons/7.png",
    gradient: "from-secondary-container to-secondary-container/70",
    border: "border-secondary/20",
    text: "text-on-secondary-container",
  },
  {
    id: "kriuk",
    title: "Kriuk",
    icon: "/icons/8.png",
    gradient: "from-tertiary-container to-tertiary-container/70",
    border: "border-tertiary/20",
    text: "text-on-tertiary-container",
  },
  {
    id: "spinner",
    title: "Spinner",
    icon: "/icons/9.png",
    gradient: "from-error-container to-error-container/70",
    border: "border-error/20",
    text: "text-on-error-container",
  },
  {
    id: "tepung",
    title: "Tepung",
    icon: "/icons/10.png",
    gradient: "from-success-container to-success-container/70",
    border: "border-success/20",
    text: "text-on-success-container",
  },
];
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-md">
  {
    kpiCards.map((card) => (
      <div
        class={`bg-gradient-to-br ${card.gradient} rounded-2xl p-lg border ${card.border} shadow-lg hover:shadow-xl transition-all duration-300 relative overflow-hidden group`}
      >
        <div class="absolute -right-6 -top-6 w-32 h-32 bg-white/5 rounded-full blur-2xl group-hover:scale-110 transition-transform" />
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-md">
            <span class={`font-label-lg ${card.text} opacity-90`}>
              {card.title}
            </span>
            <div class="w-12 h-12 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center">
              <img
                src={card.icon}
                alt={card.title}
                class="w-7 h-7 object-contain drop-shadow-sm"
              />
            </div>
          </div>

          <p class={`font-display-data text-display-data ${card.text}`}>
            <span id={`stok-${card.id}`}>...</span>{" "}
            <span class="text-headline-sm font-medium opacity-80">KG</span>
          </p>

          <p
            class={`text-label-sm ${card.text}/70 mt-sm`}
            id={`mutasi-${card.id}`}
          >
            Loading mutasi...
          </p>
        </div>
      </div>
    ))
  }
</div>

<script>
  import { supabase } from "../../lib/supabase"; // Pastikan path ini benar

  const komoditasIds = [
    "minyak_jelantah",
    "minyak_asting",
    "ampas",
    "kriuk",
    "spinner",
    "tepung",
  ];

  async function fetchRealtimeDashboard() {
    try {
      // 1. Ambil stok utama dari gudang_komoditas (Aman, gak perlu dirubah)
      const { data: komoditasData, error: errStok } = await supabase
        .from("gudang_komoditas")
        .select("id, stok");

      if (!errStok && komoditasData) {
        komoditasData.forEach((item) => {
          const el = document.getElementById(`stok-${item.id}`);
          if (el) el.textContent = item.stok.toLocaleString("id-ID");
        });
      }

      // 2. Set waktu rentang HARI INI (WIB) untuk filter mutasi harian
      const now = new Date();
      const offset = now.getTimezoneOffset() * 60000;
      const todayStr = new Date(now - offset).toISOString().split("T")[0];
      const startOfDay = `${todayStr}T00:00:00+07:00`;
      const endOfDay = `${todayStr}T23:59:59+07:00`;

      // 3. Fungsi Pintar Narik dan Ngitung Mutasi Harian Per Item
      const fetchMutasi = async (id: string) => {
        const el = document.getElementById(`mutasi-${id}`);
        if (!el) return;

        // Ambil SEMUA aktivitas mutasi si komoditas ini khusus hari ini saja
        const { data, error } = await supabase
          .from("gudang_mutasi")
          .select("jumlah, jenis_mutasi") // 🔥 FIX: Pakai kolom 'jumlah', bukan 'volume'
          .eq("komoditas_id", id)
          .gte("tanggal", startOfDay)
          .lte("tanggal", endOfDay);

        if (!error && data && data.length > 0) {
          let totalMasuk = 0;
          let totalKeluar = 0;

          // Kalkulasi barang masuk dan keluar
          data.forEach((m: any) => {
            const nominal = parseFloat(String(m.jumlah) || "0");
            if (m.jenis_mutasi === "Masuk") {
              totalMasuk += nominal;
            } else if (m.jenis_mutasi === "Keluar") {
              totalKeluar += nominal;
            }
          });

          // Cetak ke layar
          el.innerHTML = `
                        <span class="text-green-800 font-bold">Masuk: ${totalMasuk.toLocaleString("id-ID")} Kg</span> | 
                        <span class="text-red-800 font-bold">Keluar: ${totalKeluar.toLocaleString("id-ID")} Kg</span>
                    `;
        } else {
          el.textContent = "Belum ada mutasi hari ini";
        }
      };

      // Jalankan fetching mutasi paralel biar kenceng
      await Promise.all(komoditasIds.map((id) => fetchMutasi(id)));
    } catch (error) {
      console.error("Error fetching dashboard data:", error);
    }
  }

  // Trigger script saat halaman dimuat
  document.addEventListener("DOMContentLoaded", fetchRealtimeDashboard);
</script>
