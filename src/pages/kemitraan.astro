            // Wadah penyimpanan sementara hasil kalkulasi biar pindah tab/filter jadi kilat
            window.leaderboardCache = { "Juara Umum": [], "Minyak Jelantah": [], "Ampas": [], "Kriuk": [], "Tepung": [], "Spinner": [] };
            
            window.generateLeaderboard = async function() {
                const periode = document.getElementById('input-periode-leaderboard').value;
                if (!periode || !window.supabase) return;

                try {
                    // Tarik data dari tabel kumulatif mingguan yang baru
                    const { data: rekapData, error } = await window.supabase
                        .from('rekap_kumulatif_mingguan_mitra')
                        .select('*')
                        .eq('periode', periode)
                        // Urutkan minggu_ke dari yang terbesar (terbaru)
                        .order('minggu_ke', { ascending: false });

                    if(error) throw error;

                    // Reset Cache
                    window.leaderboardCache = { "Juara Umum": [], "Minyak Jelantah": [], "Ampas": [], "Kriuk": [], "Tepung": [], "Spinner": [] };

                    // Karena kita narik per periode (bulan), bisa jadi ada data minggu ke-1, 2, 3 untuk mitra yang sama.
                    // Kita hanya butuh data di minggu_ke TERAKHIR untuk tiap mitra sebagai hasil final bulan tersebut.
                    const latestDataMap = new Map();
                    rekapData.forEach(row => {
                        if (!latestDataMap.has(row.mitra_id)) {
                            latestDataMap.set(row.mitra_id, row);
                        }
                    });
                    
                    const latestData = Array.from(latestDataMap.values());

                    latestData.forEach(r => {
                        const nama = r.nama_mitra || 'Mitra Lapangan';
                        const id = r.mitra_id;

                        // Langsung petakan dari kolom ke cache (Jauh lebih cepat tanpa looping IF)
                        if (r.total_keseluruhan > 0) window.leaderboardCache["Juara Umum"].push({ nama, kg: r.total_keseluruhan, id });
                        if (r.minyak_jelantah > 0) window.leaderboardCache["Minyak Jelantah"].push({ nama, kg: r.minyak_jelantah, id });
                        if (r.ampas > 0) window.leaderboardCache["Ampas"].push({ nama, kg: r.ampas, id });
                        if (r.kriuk > 0) window.leaderboardCache["Kriuk"].push({ nama, kg: r.kriuk, id });
                        if (r.tepung > 0) window.leaderboardCache["Tepung"].push({ nama, kg: r.tepung, id });
                        if (r.spinner > 0) window.leaderboardCache["Spinner"].push({ nama, kg: r.spinner, id });
                    });

                    // Tampilkan data sesuai tab kategori yang sedang aktif
                    window.renderLeaderboardSesuaiFilter();
                } catch (e) { console.error("Gagal Generate Leaderboard:", e); }
            };

            // Variabel Pencatat Tab Aktif Saat Ini
            window.activeLeaderboardKat = 'Juara Umum';
            
