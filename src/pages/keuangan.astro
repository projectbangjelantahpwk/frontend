        const d = window.currentSalaryData;
        const btn = document.getElementById('btn-bayar-gaji');
        btn.innerHTML = "Memproses..."; btn.disabled = true;
        const periodeSekarang = new Date().toISOString().split('T')[0]; // Format: YYYY-MM--DD

        try {
            // Struktur data final yang dikirim (BEBAS DARI KOLOM POTONGAN)
            const slipDataFinal = {
                user_id: d.empId,
                periode: periodeSekarang,
                gaji_karyawan: (d.totalNormalJam * d.tarifNormal),
                tunjangan: d.totalPengeluaranKar + (d.tepatWaktuCount * d.bonusTepatWaktu) + (d.totalLemburJam * d.tarifLembur) + (document.getElementById('m_check_bonus_mingguan').checked ? d.bonusMingguanVal : 0) + d.uangKesehatan,
                uang_jalan: d.potonganJalan, 
                total_diterima: d.grandTotal,
                status: 'ACC' 
            };

            const { data: draft, error: errDraft } = await window.supabase.from('slip_gaji')
                .select('id').eq('user_id', d.empId).eq('periode', periodeSekarang).eq('status', 'Menunggu').maybeSingle();
            
            if (errDraft) throw errDraft;

            if (draft) {
                const { error: errFinalUpd } = await window.supabase.from('slip_gaji').update(slipDataFinal).eq('id', draft.id);
                if (errFinalUpd) throw errFinalUpd;
            } else {
                const { error: errFinalIns } = await window.supabase.from('slip_gaji').insert([slipDataFinal]);
                if (errFinalIns) throw errFinalIns;
            }

            alert('Gaji berhasil dibayar dan direkap ke Riwayat!');
            window.location.reload();
        } catch (err) {
            alert('Gagal merekap gaji: ' + err.message);
            btn.innerHTML = `<i class="bi bi-check2-circle mr-2"></i> Setujui & Bayar Gaji`;
            btn.disabled = false;
