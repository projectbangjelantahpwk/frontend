        // 🔥 3. RENDER ULANG UI SLIP GAJI (DENGAN VARIABEL htmlLainLainPreview) 🔥
        document.getElementById("m_rincian_list").innerHTML = `
            <div class="bg-blue-50/50 p-2.5 rounded mb-3 border border-blue-200">
                <div class="text-[11px] font-bold text-blue-900 uppercase tracking-widest text-center"><i class="bi bi-calendar-range mr-1"></i> ${res.teksPeriode}</div>
                <div class="text-[10px] font-semibold text-blue-700 text-center mt-1">Total Kehadiran: ${res.totalHariHadir} Hari (Termasuk ${res.hariMingguMasuk} Hr Minggu)</div>
            </div>
            
            <div class="flex justify-between text-xs"><span>${labelGajiPokok}</span> <span class="font-bold text-gray-900">Rp ${(res.valGajiNormal || 0).toLocaleString("id-ID")}</span></div>
            
            ${res.valGajiMinggu > 0 ? `<div class="flex justify-between text-xs text-purple-700 font-bold bg-purple-50 p-1 rounded mt-1"><span>⭐ Extra Masuk Hari Minggu (${res.hariMingguMasuk} Hari)</span> <span>+ Rp ${res.valGajiMinggu.toLocaleString("id-ID")}</span></div>` : ""}
            
            ${res.valLembur > 0 ? `<div class="flex justify-between text-xs mt-1"><span>Uang Lembur (${res.totalMenitLembur} Menit)</span> <span class="font-bold text-gray-900">+ Rp ${res.valLembur.toLocaleString("id-ID")}</span></div>` : ""}
            ${res.valMakan > 0 ? `<div class="flex justify-between text-xs text-green-700 mt-1"><span>Uang Makan (${res.totalHariHadir} Hari)</span> <span class="font-bold">+ Rp ${res.valMakan.toLocaleString("id-ID")}</span></div>` : ""}
            ${res.valTransport > 0 ? `<div class="flex justify-between text-xs text-blue-700 mt-1"><span>Uang Transport (${res.totalHariHadir} Hari)</span> <span class="font-bold">+ Rp ${res.valTransport.toLocaleString("id-ID")}</span></div>` : ""}
            
            ${res.valPotonganAbsen > 0 ? `<div class="flex justify-between text-xs text-red-600 font-bold mt-1"><span>Potongan Bonus/Hari Absen (${res.totalHariAbsen} Hari)</span> <span>- Rp ${res.valPotonganAbsen.toLocaleString("id-ID")}</span></div>` : ""}

            ${res.valBonusTepat > 0 ? `<div class="flex justify-between text-xs text-green-700 mt-1"><span>Bonus Tepat Waktu (${res.tepatWaktuCount}x)</span> <span class="font-bold">+ Rp ${res.valBonusTepat.toLocaleString("id-ID")}</span></div>` : ""}
            ${res.valBonusMingguan > 0 ? `<div class="flex justify-between text-xs text-green-700 mt-1"><span>${labelBonus}</span> <span class="font-bold">+ Rp ${res.valBonusMingguan.toLocaleString("id-ID")}</span></div>` : ""}
