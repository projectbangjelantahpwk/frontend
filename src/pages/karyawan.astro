      // Set tanggal hari ini sebagai default
      const wkt = new Date();
      const offset = wkt.getTimezoneOffset() * 60000;
      document.getElementById("input_tgl_libur").value = new Date(wkt - offset)
        .toISOString()
        .split("T")[0];
      document.getElementById("input_ket_libur").value = "";

      const m = document.getElementById("modal-hari-libur");
      m.classList.remove("hidden");
      m.classList.add("flex");
      setTimeout(() => {
        m.classList.remove("opacity-0");
        m.querySelector("div").classList.remove("scale-95");
      }, 10);
    };

    // Simpan ke Database
    window.simpanHariLibur = async function (e) {
      e.preventDefault();
      const tgl = document.getElementById("input_tgl_libur").value;
      const ket = document.getElementById("input_ket_libur").value;
      const btn = document.getElementById("btn-save-libur");

      btn.innerText = "Menyimpan...";
      btn.disabled = true;

      try {
        // Tembak ke tabel hari_libur
        const { error } = await window.supabase.from("hari_libur").insert([
          {
            tanggal: tgl,
            keterangan: ket,
          },
        ]);

        if (error) {
          // Kalau error duplikat (tanggal udah pernah diinput)
          if (error.code === "23505")
            throw new Error("Tanggal ini sudah terdaftar sebagai hari libur!");
          throw error;
        }

        alert(
          "Mantap! Hari libur berhasil ditambahkan. Sistem gaji akan otomatis memberi absen gratis di tanggal tersebut.",
        );
        window.closeModal("modal-hari-libur");
      } catch (err) {
        alert("Gagal menyimpan: " + err.message);
      } finally {
        btn.innerText = "Simpan Tanggal Libur";
        btn.disabled = false;
      }
    };

