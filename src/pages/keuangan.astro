---
import GeneralLayout from '../layouts/Layout.astro';
import 'bootstrap-icons/font/bootstrap-icons.css';
---

<GeneralLayout title="Keuangan - Manajemen Bang Jelantah">
    <style is:global>
        /* Mengunci layar menjadi blank (putih) sampai skrip memberi izin masuk */
        body { display: none; }
    </style>
  <div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Manajemen Keuangan</h1>
      <p class="text-gray-600">Kelola arus kas, penggajian, validasi operasional, dan penjualan pabrik.</p>
    </div>
  </div>

  <div class="mb-6 border-b border-gray-200 overflow-x-auto hide-scrollbar">
    <div class="flex gap-8 min-w-max">
      <button class="tab-btn active px-4 py-3 font-medium transition border-b-2 border-green-700 text-green-700" data-tab="gaji">
        <i class="bi bi-wallet2 mr-2"></i> Gaji Karyawan
      </button>
      <button class="tab-btn px-4 py-3 font-medium transition border-b-2 border-transparent text-gray-600 hover:text-gray-900" data-tab="riwayat-gaji">
        <i class="bi bi-clock-history mr-2"></i> Riwayat Gaji Karyawan
      </button>
      <button class="tab-btn px-4 py-3 font-medium transition border-b-2 border-transparent text-gray-600 hover:text-gray-900" data-tab="validasi">
        <i class="bi bi-shield-check mr-2"></i> Validasi Bayar
        <span id="badge-validasi" class="hidden ml-2 inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-100 text-red-700 text-xs font-bold">0</span>
      </button>
      <button class="tab-btn px-4 py-3 font-medium transition border-b-2 border-transparent text-gray-600 hover:text-gray-900" data-tab="pembelian">
        <i class="bi bi-cart-check mr-2"></i> Pembelian Komoditas
      </button>
      <button class="tab-btn px-4 py-3 font-medium transition border-b-2 border-transparent text-gray-600 hover:text-gray-900" data-tab="pengeluaran">
        <i class="bi bi-wallet2 mr-2"></i> Pengeluaran Ops
      </button>
    </div>
  </div>

  <div id="gaji" class="tab-content block">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-900">Rekapitulasi Gaji Karyawan</h2>
    </div>
    <div id="gaji-karyawan-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <p class="text-gray-500">Memuat data gaji...</p>
    </div>
  </div>

    <div class="tab-content hidden" id="riwayat-gaji-tab">
      <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm mb-6">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Filter Riwayat Gaji Tahun Berjalan</h3>

        <div class="flex flex-wrap gap-4 items-end">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Dari Tanggal</label>
            <input type="date" id="filter-gaji-start" class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-700" />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-1">Sampai Tanggal</label>
            <input type="date" id="filter-gaji-end" class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-700" />
          </div>
          <button id="btn-filter-gaji" class="bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-800 transition">
            Saring Riwayat
          </button>
        </div>
      </div>

      <div id="riwayat-gaji-container" class="space-y-4">
        <p class="text-gray-500 text-sm italic">Pilih filter tanggal untuk memuat riwayat.</p>
      </div>
    </div>

  <div id="pembelian" class="tab-content hidden">
    <div class="flex justify-between items-center mb-4">
        <h2 class="text-xl font-bold text-gray-900">Pembelian Komoditas (Mitra)</h2>
    </div>
    
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm mb-6 flex flex-wrap gap-4 items-end">
        <div>
            <label class="block text-xs font-bold text-gray-600 mb-1">Mulai Tanggal</label>
            <input type="date" id="filter-start-beli" class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-600">
        </div>
        <div>
            <label class="block text-xs font-bold text-gray-600 mb-1">Sampai Tanggal</label>
            <input type="date" id="filter-end-beli" class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-600">
        </div>
        <button onclick="filterTabelBeli()" class="bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-green-800">Filter Data Pembelian</button>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm">
        <div class="overflow-x-auto max-h-[600px]">
            <table class="w-full text-left" id="tabel-pembelian">
                <thead class="bg-gray-50 sticky top-0 border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-4 text-sm font-bold text-gray-900 whitespace-nowrap">Tanggal</th>
                        <th class="px-6 py-4 text-sm font-bold text-gray-900">Mitra</th>
                        <th class="px-6 py-4 text-sm font-bold text-gray-900">Komoditas</th>
                        <th class="px-6 py-4 text-sm font-bold text-gray-900 text-right whitespace-nowrap">Berat (Kg)</th>
                        <th class="px-6 py-4 text-sm font-bold text-gray-900 text-right whitespace-nowrap">Harga Satuan</th>
                        <th class="px-6 py-4 text-sm font-bold text-gray-900 text-right whitespace-nowrap">Subtotal Harga</th>
                    </tr>
                </thead>
                <tbody id="pembelian-tbody" class="divide-y divide-gray-200">
                    <tr><td colspan="6" class="text-center py-4 text-gray-500">Memuat...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
  </div>

  <div id="pengeluaran" class="tab-content hidden">
    <div class="flex justify-between items-center mb-4">
        <h2 class="text-xl font-bold text-gray-900">Pengeluaran Operasional</h2>
    </div>
    
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm mb-6 flex flex-wrap gap-4 items-end">
        <div>
            <label class="block text-xs font-bold text-gray-600 mb-1">Mulai Tanggal</label>
            <input type="date" id="filter-start-pengeluaran" class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-600">
        </div>
        <div>
            <label class="block text-xs font-bold text-gray-600 mb-1">Sampai Tanggal</label>
            <input type="date" id="filter-end-pengeluaran" class="border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-green-600">
        </div>
        <button onclick="filterTabelPengeluaran()" class="bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-bold hover:bg-green-800">Filter Data Pengeluaran</button>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm">
        <div class="overflow-x-auto max-h-[600px]">
            <table class="w-full text-left" id="tabel-pengeluaran">
                <thead class="bg-gray-50 sticky top-0">
                    <tr>
                        <th class="px-6 py-4 text-sm font-bold text-gray-900">Tgl & Pengaju</th>
                        <th class="px-6 py-4 text-sm font-bold text-gray-900">Detail Rincian</th>
                        <th class="px-6 py-4 text-sm font-bold text-gray-900 text-center">Status</th>
                    </tr>
                </thead>
                <tbody id="pengeluaran-tbody" class="divide-y divide-gray-200">
                    <tr><td colspan="3" class="text-center py-4">Memuat...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
  </div>

  <div id="validasi" class="tab-content hidden">
    <div class="mb-8">
      <div class="flex items-center gap-2 mb-6">
        <i class="bi bi-exclamation-triangle text-red-600 text-xl"></i>
        <h2 class="text-xl font-bold text-gray-900">Menunggu Validasi (<span id="title-validasi-count">0</span>)</h2>
      </div>

      <div id="validasi-container" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
         <p class="text-gray-500">Memuat data validasi...</p>
      </div>
    </div>

    <div class="mt-12 border-t border-gray-200 pt-8">
      <div class="flex items-center gap-2 mb-6">
        <i class="bi bi-clock-history text-blue-600 text-xl"></i>
        <h2 class="text-xl font-bold text-gray-900">Riwayat Pembayaran Selesai</h2>
      </div>

      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm">
          <table class="w-full text-left">
              <thead class="bg-gray-50 border-b border-gray-200">
                  <tr>
                      <th class="px-6 py-4 text-sm font-bold text-gray-900">Mitra</th>
                      <th class="px-6 py-4 text-sm font-bold text-gray-900">Tanggal</th>
                      <th class="px-6 py-4 text-sm font-bold text-gray-900">Metode Bayar</th>
                      <th class="px-6 py-4 text-sm font-bold text-gray-900 text-right">Nominal</th>
                  </tr>
              </thead>
              <tbody id="riwayat-lunas-tbody" class="divide-y divide-gray-100">
                  <tr><td colspan="4" class="text-center py-4">Memuat...</td></tr>
              </tbody>
          </table>
       </div>
    </div>
  </div>
</GeneralLayout>

<div id="modal-pengaturan-global" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0">
    <div class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
            <h3 class="font-bold text-lg text-gray-900">Pengaturan Gaji Global</h3>
            <button onclick="closeModal('modal-pengaturan-global')" class="text-gray-400 hover:text-gray-900"><i class="bi bi-x-lg"></i></button>
        </div>
        <form id="form-global-gaji" class="p-6 space-y-4">
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Uang Kesehatan (Rp)</label>
                <input type="number" id="g_kesehatan" value="0" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600">
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Bonus Tepat Waktu (Rp)</label>
                <input type="number" id="g_tepatwaktu" value="0" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600">
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Bonus Mingguan (Rp)</label>
                <input type="number" id="g_mingguan" value="0" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600">
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Tarif Lembur per Jam (Rp)</label>
                <input type="number" id="g_lembur" value="0" class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:border-green-600">
            </div>
            <button type="submit" class="w-full bg-gray-900 text-white font-bold py-3 rounded-xl hover:bg-black transition">Simpan Pengaturan</button>
        </form>
    </div>
</div>

<div id="modal-detail-gaji" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0">
    <div class="bg-white rounded-2xl w-full max-w-2xl overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[95vh]">
        <div class="p-5 border-b border-gray-100 flex justify-between items-center bg-green-50">
            <div>
                <h3 class="font-bold text-lg text-gray-900" id="m_nama_karyawan">Nama Karyawan</h3>
                <p class="text-xs text-green-700 font-medium">Setup & Slip Gaji Karyawan</p>
            </div>
            <button onclick="closeModal('modal-detail-gaji')" class="text-gray-400 hover:text-gray-900"><i class="bi bi-x-lg"></i></button>
        </div>
        
        <div class="p-5 overflow-y-auto flex-1 space-y-6">
            <input type="hidden" id="m_karyawan_id">
            <input type="hidden" id="m_setup_id">
            <input type="hidden" id="m_slip_id">
            
            <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
                <h4 class="text-sm font-bold text-gray-900 mb-3 border-b pb-2"><i class="bi bi-sliders mr-2"></i>Parameter Setup Gaji Personal</h4>
                <div class="grid grid-cols-2 gap-3 mb-3">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Gaji per Menit (Rp)</label>
                        <input type="number" id="setup_gaji_menit" class="w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-green-600">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Uang Lembur per Menit (Rp)</label>
                        <input type="number" id="setup_lembur_menit" class="w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-green-600">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Uang Kesehatan (Rp)</label>
                        <input type="number" id="setup_uang_kesehatan" class="w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-green-600">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Uang Makan (Rp)</label>
                        <input type="number" id="setup_uang_makan" class="w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-green-600">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Bonus Tepat Waktu (Rp)</label>
                        <input type="number" id="setup_bonus_tepat" class="w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-green-600">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Bonus Mingguan (Rp)</label>
                        <input type="number" id="setup_bonus_mingguan" class="w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-green-600">
                    </div>
                </div>
                <button onclick="simpanSetupGaji()" class="w-full bg-gray-800 text-white px-3 py-2 rounded-lg font-bold text-sm hover:bg-black transition">
                    <i class="bi bi-floppy mr-1"></i> Simpan Parameter Setup
                </button>
            </div>

            <div>
                <h4 class="font-bold text-gray-900 mb-3 border-b pb-2"><i class="bi bi-calculator mr-2"></i>Kalkulasi Slip Gaji Bulan Ini</h4>
                
                <div class="bg-blue-50 p-3 rounded-lg border border-blue-100 flex flex-wrap gap-4 mb-4">
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="chk_uang_kesehatan" onchange="kalkulasiRealtimeGaji()" class="w-4 h-4 text-blue-600 rounded">
                        <label class="text-xs font-bold text-gray-700">Berikan Uang Kesehatan</label>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="chk_bonus_tepat" onchange="kalkulasiRealtimeGaji()" class="w-4 h-4 text-blue-600 rounded">
                        <label class="text-xs font-bold text-gray-700">Berikan Bonus Tepat Waktu</label>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="chk_bonus_mingguan" onchange="kalkulasiRealtimeGaji()" class="w-4 h-4 text-blue-600 rounded">
                        <label class="text-xs font-bold text-gray-700">Berikan Bonus Mingguan</label>
                    </div>
                </div>

                <div class="space-y-2 text-sm bg-white border border-gray-200 p-4 rounded-xl" id="m_rincian_list">
                    </div>

                <div class="bg-green-700 text-white p-4 rounded-xl flex justify-between items-center mt-3 shadow-sm">
                    <span class="font-bold">Total Diterima:</span>
                    <span class="text-2xl font-bold" id="m_total_gaji">Rp 0</span>
                </div>
            </div>
        </div>
        
        <div class="p-4 border-t border-gray-100 bg-gray-50 flex gap-3">
             <button id="btn-draf-gaji" onclick="simpanSlipGaji('Menunggu')" class="flex-1 bg-white border border-gray-300 text-gray-700 font-bold py-3 rounded-xl hover:bg-gray-100 transition shadow-sm">
                <i class="bi bi-clock-history mr-2"></i> Simpan Saja
            </button>
             <button id="btn-bayar-gaji" onclick="simpanSlipGaji('ACC')" class="flex-1 bg-green-700 text-white font-bold py-3 rounded-xl hover:bg-green-800 transition shadow-sm">
                <i class="bi bi-check-circle-fill mr-2"></i> Approve & Lunas
            </button>
        </div>
    </div>
</div>

<div id="modal-edit-transaksi" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4 transition-opacity opacity-0">
    <div class="bg-white rounded-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[90vh]">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-blue-50 shrink-0">
            <div>
                <h3 class="font-bold text-lg text-gray-900">Edit Data Transaksi</h3>
                <p id="edit-step-indicator" class="text-xs text-blue-700 font-medium mt-0.5">Langkah 1 dari 3: Data Pokok</p>
            </div>
            <button type="button" onclick="closeModal('modal-edit-transaksi')" class="text-gray-400 hover:text-gray-900"><i class="bi bi-x-lg"></i></button>
        </div>
        
        <form id="form-edit-transaksi" onsubmit="window.simpanEditTransaksi(event)" class="p-6 overflow-y-auto flex-1 flex flex-col justify-between">
            <input type="hidden" id="edit_trx_id">
            <input type="hidden" id="edit_penjemputan_id">
            <input type="hidden" id="edit_mitra_id">
            <input type="hidden" id="edit_metode_bayar">

            <div id="edit-step-1" class="flex flex-col gap-4">
                <div class="w-full">
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Tanggal Transaksi</label>
                    <input type="date" id="edit_trx_tgl" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-blue-600 font-medium" required>
                </div>
                
                <div class="w-full">
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Nama Mitra Pengumpul</label>
                    <select id="edit_trx_mitra_select" class="w-full border border-gray-300 rounded-xl p-3 text-sm outline-none focus:border-blue-600 font-medium bg-white" required>
                        </select>
                </div>
                
                <div class="w-full">
                    <label class="block text-xs font-bold text-red-600 uppercase tracking-wider mb-1">Potongan DP / Kasbon (Rp)</label>
                    <input type="number" id="edit_trx_dp" class="w-full border border-red-300 bg-red-50 rounded-xl p-3 outline-none focus:border-red-600 text-red-900 font-bold font-mono" placeholder="0">
                </div>
            </div>

            <div id="edit-step-2" class="hidden flex-col gap-5">
                <div id="edit_items_container" class="space-y-4"></div>

                <div class="w-full pt-3 border-t border-gray-100">
                    <label class="block text-xs font-bold text-green-700 uppercase tracking-wider mb-1">Total Harga Transaksi (Rp)</label>
                    <input type="number" id="edit_trx_grand_total" class="w-full border border-green-300 bg-green-50 rounded-xl p-3 outline-none focus:border-green-600 text-green-900 font-bold font-mono text-lg" required>
                </div>
            </div>

            <div id="edit-step-3" class="hidden flex-col gap-4">
                <div class="w-full bg-gray-100 p-3 rounded-xl border border-gray-200">
                    <span class="text-xs text-gray-500 font-bold uppercase tracking-wider">Metode Pembayaran Asli:</span>
                    <p id="edit_trx_metode_label" class="text-sm font-bold text-gray-800 mt-0.5 capitalize">-</p>
                </div>
                
                <div id="edit_payment_details_container" class="w-full"></div>
            </div>

            <div id="footer-edit-1" class="mt-8 flex justify-end shrink-0">
                <button type="button" onclick="window.goToEditStep(2)" class="w-12 h-12 bg-gray-900 text-white font-bold rounded-xl hover:bg-black transition text-xl flex items-center justify-center shadow-sm active:scale-95" title="Selanjutnya">
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>
            
            <div id="footer-edit-2" class="mt-8 hidden w-full justify-between items-center shrink-0">
                <button type="button" onclick="window.goToEditStep(1)" class="w-12 h-12 bg-gray-100 text-gray-700 font-bold rounded-xl hover:bg-gray-200 border border-gray-200 transition text-xl flex items-center justify-center active:scale-95" title="Kembali">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <button type="button" onclick="window.goToEditStep(3)" class="w-12 h-12 bg-gray-900 text-white font-bold rounded-xl hover:bg-black transition text-xl flex items-center justify-center shadow-sm active:scale-95" title="Selanjutnya">
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>

            <div id="footer-edit-3" class="mt-8 hidden w-full justify-between items-center shrink-0">
                <button type="button" onclick="window.goToEditStep(2)" class="w-12 h-12 bg-gray-100 text-gray-700 font-bold rounded-xl hover:bg-gray-200 border border-gray-200 transition text-xl flex items-center justify-center active:scale-95" title="Kembali">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <button type="submit" id="btn-save-trx" class="w-12 h-12 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition text-xl flex items-center justify-center shadow-sm active:scale-95" title="Simpan Perubahan">
                    <i class="bi bi-floppy-fill"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<script is:inline>
  // Variabel Global untuk nyimpen data yang di-fetch
  let dataGlobalGaji = null;
  let dataKaryawan = [];

  document.addEventListener('DOMContentLoaded', async () => {
    // === 🛡️ GATEKEEPER KEUANGAN ===
      const allowedRoles = ['owner', 'hrd', 'keuangan'];
      const client = window.supabase || supabase;
      
      const { data: { session } } = await client.auth.getSession();
      if (!session) return window.location.replace('/'); // Tendang kalau belum login
      
      const { data: prof } = await client.from('profiles').select('role').eq('id', session.user.id).single();
      if (!allowedRoles.includes(prof?.role)) {
          alert(`Akses Ditolak! Role Anda (${prof?.role || 'Guest'}) dilarang masuk ke Keuangan.`);
          return window.location.replace('/');
      }
      document.body.style.display = 'block'; // Buka gembok CSS, tampilkan layar!
      
    //Setup Batasan Tanggal Otomatis
    const tahunAktif = new Date().getFullYear();
        const awalTahun = `${tahunAktif}-01-01`; 
        const hariIni = new Date().toISOString().split('T')[0];

        const inputStart = document.getElementById('filter-gaji-start');
        const inputEnd = document.getElementById('filter-gaji-end');

        if (inputStart && inputEnd) {
