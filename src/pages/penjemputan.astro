            document.getElementById('form-step-2').classList.replace('flex', 'hidden');
            document.getElementById('footer-step-2').classList.replace('flex', 'hidden');
            document.getElementById('form-step-3').classList.replace('hidden', 'flex');
            document.getElementById('footer-step-3').classList.replace('hidden', 'flex');
        }
    }

    // 🔥 FUNGSI HITUNG OTOMATIS ESTIMASI TRANSAKSI 🔥
        function hitungEstimasiTransaksi() {
            const estMinyak = parseFloat(document.getElementById('est-minyak')?.value) || 0;
            const estTepung = parseFloat(document.getElementById('est-tepung')?.value) || 0;
            const estKriuk = parseFloat(document.getElementById('est-kriuk')?.value) || 0;
            const estSpinner = parseFloat(document.getElementById('est-spinner')?.value) || 0;
            const estAmpas = parseFloat(document.getElementById('est-ampas')?.value) || 0;

            const satMinyak = parseFloat(document.getElementById('satuan-minyak')?.value) || 0;
            const satTepung = parseFloat(document.getElementById('satuan-tepung')?.value) || 0;
            const satKriuk = parseFloat(document.getElementById('satuan-kriuk')?.value) || 0;
            const satSpinner = parseFloat(document.getElementById('satuan-spinner')?.value) || 0;
            const satAmpas = parseFloat(document.getElementById('satuan-ampas')?.value) || 0;

            // Kalkulasi nominal
            const estimasiTransaksi = (estMinyak * satMinyak) + (estTepung * satTepung) + (estKriuk * satKriuk) + (estSpinner * satSpinner) + (estAmpas * satAmpas);

            // Tampilkan hasil total akhir bersih
            const displayEl = document.getElementById('display-estimasi-transaksi');
            if (displayEl) {
                displayEl.innerText = 'Rp ' + estimasiTransaksi.toLocaleString('id-ID');
            }
        }

        // Daftarkan trigger ke semua input volume dan harga satuan
        document.addEventListener('DOMContentLoaded', () => {
            const inputIds = ['est-minyak', 'est-tepung', 'est-kriuk', 'est-spinner', 'est-ampas', 'satuan-minyak', 'satuan-tepung', 'satuan-kriuk', 'satuan-spinner', 'satuan-ampas'];
            inputIds.forEach(id => {
                document.getElementById(id)?.addEventListener('input', hitungEstimasiTransaksi);
            });
        });

    function prevStep(targetStep) {
        if (targetStep === 1) {
            document.getElementById('form-step-2').classList.replace('flex', 'hidden');
            document.getElementById('footer-step-2').classList.replace('flex', 'hidden');
            document.getElementById('form-step-1').classList.replace('hidden', 'flex');
            document.getElementById('footer-step-1').classList.replace('hidden', 'flex');
        } else if (targetStep === 2) {
            document.getElementById('form-step-3').classList.replace('flex', 'hidden');
            document.getElementById('footer-step-3').classList.replace('flex', 'hidden');
            document.getElementById('form-step-2').classList.replace('hidden', 'flex');
            document.getElementById('footer-step-2').classList.replace('hidden', 'flex');
        }
    }
    // ==========================================
        // FITUR MANAJEMEN RUTE INLINE (TAB)
        // ==========================================
        async function loadTabelRute() {
            if(!window.supabase) return;
            const { data: daftarRute } = await window.supabase.from('rute_jemput').select('*').order('id', { ascending: true });
            
            let html = '';
            let optRute = '<option value="">-- Pilih Wilayah --</option>'; // Sekalian buat form penjemputan
            
            if(daftarRute && daftarRute.length > 0) {
                daftarRute.forEach((r, idx) => {
                    html += `
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="px-md py-md text-center font-semibold" data-label="No">${idx + 1}</td>
                        <td class="px-md py-md font-semibold" data-label="Wilayah">${r.nama_rute}</td>
                        <td class="px-md py-md text-center" data-label="Status">
                            <span class="inline-flex items-center gap-xs px-2 py-1 rounded-full bg-emerald-100 text-emerald-800 font-label-sm text-[11px]">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> ${r.status}
                            </span>
                        </td>
                        <td class="px-md py-md text-right" data-label="Aksi">
                            <div class="flex gap-2 justify-end">
                                <button onclick="window.hapusPenjemputan(${r.id}, '${r.nama_rute}')" class="bg-red-50 text-red-600 border border-red-200 px-2 py-1 rounded text-[11px] font-bold hover:bg-red-100 transition shadow-sm" title="Hapus">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>`;
                    
                    if(r.status === 'Aktif') {
                        optRute += `<option value="${r.nama_rute}">${r.nama_rute}</option>`;
                    }
                });
            } else {
                html = '<tr><td colspan="4" class="p-4 text-center text-on-surface-variant">Belum ada rute terdaftar.</td></tr>';
            }
            
            document.getElementById('tbody-rute').innerHTML = html;
            
            // Update dropdown di Form Penjemputan sekalian
            const elWilayah = document.getElementById('input-wilayah');
            if(elWilayah) elWilayah.innerHTML = optRute;
        }

        window.tambahBarisRute = function() {
            // Jangan izinkan nambah kalau belum save baris sebelumnya
            if(document.getElementById('input-rute-baru')) return document.getElementById('input-rute-baru').focus();
            
            const tbody = document.getElementById('tbody-rute');
            
            // Hapus pesan kosong kalau ada
            if(tbody.innerHTML.includes('Belum ada rute')) tbody.innerHTML = '';
            
            const barisBaru = `
            <tr class="bg-surface-container-low animate-in fade-in zoom-in duration-300">
                <td class="px-md py-md text-center font-bold text-primary">*</td>
                <td class="px-md py-md">
                    <input type="text" id="input-rute-baru" class="w-full px-3 py-1.5 border border-primary rounded text-sm outline-none focus:ring-2 focus:ring-primary/50" placeholder="Ketik nama rute..." autofocus required>
                </td>
                <td class="px-md py-md text-center">
                    <span class="inline-flex items-center gap-xs px-2 py-1 rounded-full bg-surface-variant text-on-surface-variant font-label-sm text-[11px]">Draft</span>
                </td>
                <td class="px-md py-md text-right">
                    <div class="flex gap-2 justify-end">
                        <button class="bg-blue-50 text-blue-700 border border-blue-200 px-2 py-1 rounded text-[11px] font-bold hover:bg-blue-100 transition shadow-sm" onclick="window.simpanRuteBaru()" title="Simpan">
                            <i class="bi bi-check-lg"></i>
                        </button>
                        <button class="bg-red-50 text-red-600 border border-red-200 px-2 py-1 rounded text-[11px] font-bold hover:bg-red-100 transition shadow-sm" onclick="loadTabelRute()" title="Batal">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </td>
            </tr>`;
            
            // Sisipkan baris di urutan paling atas
            tbody.insertAdjacentHTML('afterbegin', barisBaru);
        };

        window.simpanRuteBaru = async function() {
            if(!['owner', 'hrd', 'admin'].includes(currentUserRole)) return alert('Akses Ditolak!');
            
            const input = document.getElementById('input-rute-baru');
            if(!input || input.value.trim() === '') return alert('Nama rute tidak boleh kosong!');
            
            try {
                input.disabled = true;
                const { error } = await window.supabase
                    .from('rute_jemput')
                    .insert([{ nama_rute: input.value.trim(), status: 'Aktif' }]);
                
                if (error) throw error;
                
                // Tarik ulang data supaya rapi
                await loadTabelRute();
            } catch (error) {
                alert('Gagal menambah rute: ' + error.message);
                input.disabled = false;
            }
        };
        // ==========================================
        // 3. HAPUS PENJEMPUTAN (DELETE CASCADE BERANTAI)
        // ==========================================
        window.hapusPenjemputan = async function(id) {
            // 🔍 [FREEZE 1]: Cek ID yang masuk
            console.log("⏸️ [FREEZE ACTIVATED] Memulai proses hapus penjemputan dengan ID:", id);
            debugger; // Buka F12 / Inspect Element untuk melihat ini!
        
            if(!isAllowed()) return alert('Akses Ditolak!');
            if(!confirm("Yakin ingin membatalkan/menghapus penugasan ini secara permanen?")) return;
        
            try {
                // 🔥 PASTIKAN STRING KE STRING AGAR MATCH 🔥
                const p = window.allJadwalPending.find(x => String(x.id) === String(id));
                console.log("1. Data penjemputan yang akan dibersihkan:", p);
            
                // Hapus SEMUA transaksi & item transaksi yang terikat
                if(p && p.transaksi && p.transaksi.length > 0) {
                    console.log(`2. Ditemukan ${p.transaksi.length} transaksi terkait. Memulai sapu bersih...`);
                    for (const tx of p.transaksi) {
                        console.log(`   -> Menghapus item dari transaksi: ${tx.id}`);
                        const { error: errItem } = await window.supabase.from('transaksi_item').delete().eq('transaksi_id', tx.id);
                        if(errItem) console.error("      ❌ Gagal hapus item:", errItem);
                    
                        console.log(`   -> Menghapus transaksi: ${tx.id}`);
                        const { error: errTx } = await window.supabase.from('transaksi').delete().eq('id', tx.id);
                        if(errTx) console.error("      ❌ Gagal hapus transaksi:", errTx);
                    }
                } else {
                    console.log("2. Aman: Tidak ada transaksi anak yang nyangkut.");
                }

                console.log("3. Mengeksekusi tembakan DELETE ke tabel Penjemputan...");

                // 🔥 TAMBAH .select() AGAR KITA TAHU BENAR-BENAR TERHAPUS ATAU DIBLOKIR RLS 🔥
                const { data: hapusData, error } = await window.supabase
                    .from('penjemputan')
                    .delete()
                    .eq('id', id)
                    .select();

                // 🔍 [FREEZE 2]: Cek Respons Balikan Supabase
                console.log("4. Hasil balikan hapus penjemputan:", { hapusData, error });
                debugger; // Script akan beku lagi di sini! Cek tab Console!
            
                if(error) throw error;
            
                // Jika array kosong, artinya Supabase menolak perintah DELETE (biasanya karena RLS)
                if (!hapusData || hapusData.length === 0) {
                    console.warn("⚠️ Data penjemputan gagal dihapus! Supabase memblokir eksekusi (Silent Fail).");
                    alert("❌ Penghapusan Gagal: Baris tidak terhapus. Cek Policy RLS (Delete) di tabel 'penjemputan' pada Supabase Anda!");
                    return;
                }

                alert('Jadwal penjemputan berhasil dihapus bersih!');
                window.location.reload();

            } catch(e) {
                console.error("💥 Error Detail Hapus Penjemputan:", e);
                alert('Gagal menghapus jadwal: ' + e.message);
            }
        };

        // ==========================================
        // 🔥 KONTROL MODAL, RIWAYAT, & MANAJEMEN DUET 🔥
        // ==========================================
        window.bukaModalDuet = async function() {
            window.openModal('modal-pengaturan-duet');
            
            // Set tanggal hari ini sebagai default
            const now = new Date();
            const offset = now.getTimezoneOffset() * 60000;
            document.getElementById('duet_tanggal').value = new Date(now - offset).toISOString().split('T')[0];

            // 1. Fetch Mobil Aktif
            try {
                const { data: mobilData } = await window.supabase
                    .from('mobil')
                    .select('id, nama_kendaraan, plat_nomor')
                    .eq('is_active', true);

                let optMobil = '<option value="">-- Pilih Armada --</option>';
                if(mobilData) {
                    mobilData.forEach(m => {
                        optMobil += `<option value="${m.id}">${m.nama_kendaraan} (${m.plat_nomor})</option>`;
                    });
                }
                document.getElementById('duet_mobil').innerHTML = optMobil;
                
                // 🔥 SUNTIKAN TOMSELECT ARMADA 🔥
                if(tomDuetMobil) tomDuetMobil.destroy();
                tomDuetMobil = new TomSelect('#duet_mobil', { create: false, maxOptions: null });

            } catch(err) { console.error("Gagal load mobil", err); }
        
            // 2. Fetch Driver & Helper
            let optDriver = '<option value="">-- Pilih Driver --</option>';
            let optHelper = '<option value="">-- Pilih Helper --</option>';
            if (window.allKaryawan) {
                window.allKaryawan.forEach(k => {
                    optDriver += `<option value="${k.id}">${k.nama}</option>`;
                    optHelper += `<option value="${k.id}">${k.nama}</option>`;
                });
            }
            document.getElementById('duet_driver').innerHTML = optDriver;
            document.getElementById('duet_helper').innerHTML = optHelper;

            // 🔥 SUNTIKAN TOMSELECT DRIVER & HELPER 🔥
            if(tomDuetDriver) tomDuetDriver.destroy();
            tomDuetDriver = new TomSelect('#duet_driver', { create: false, maxOptions: null });
            
            if(tomDuetHelper) tomDuetHelper.destroy();
            tomDuetHelper = new TomSelect('#duet_helper', { create: false, maxOptions: null });

            // 3. Load Daftar Duet Terkini
            window.loadDaftarDuet();
        };

        // Fungsi Load Data Hasil Pasangan Harian
        window.loadDaftarDuet = async function() {
            const tbody = document.getElementById('tbody-list-duet');
            tbody.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-gray-400 italic">Memuat data...</td></tr>';
                
            try {
                // Jangan lupa join ke tabel mobil
                const { data, error } = await window.supabase
                    .from('partner_kendaraan')
                    .select(`
                        id, tanggal, 
                        driver:driver_id(nama), 
                        helper:helper_id(nama),
                        mobil(nama_kendaraan, plat_nomor)
                    `)
                    .order('tanggal', { ascending: false })
                    .limit(15);
                    
                if (error) throw error;
                
                let htmlList = '';
                if (data && data.length > 0) {
                    data.forEach(d => {
                        const armada = d.mobil ? `${d.mobil.nama_kendaraan} <br><span class="text-[10px] bg-gray-200 px-1 rounded">${d.mobil.plat_nomor}</span>` : '-';
                        htmlList += `
                            <tr>
                                <td class="p-3 font-semibold">${d.tanggal}</td>
                                <td class="p-3 leading-tight">${armada}</td>
                                <td class="p-3 text-blue-700 font-semibold">${d.driver?.nama || '-'}</td>
                                <td class="p-3">${d.helper?.nama || '-'}</td>
                                <td class="p-3 text-center">
                                    <button type="button" onclick="window.hapusDuet('${d.id}')" class="text-red-500 hover:text-red-700 bg-red-50 p-1.5 rounded" title="Hapus"><i class="bi bi-trash3"></i></button>
                                </td>
                            </tr>
                        `;
                    });
                } else {
                    htmlList = '<tr><td colspan="5" class="p-4 text-center text-gray-400 italic">Belum ada pengaturan duet.</td></tr>';
                }
                tbody.innerHTML = htmlList;
            } catch (err) {
                console.error("Gagal load daftar duet:", err.message || err);
                // Tambahin alert biar lu langsung tau errornya apa tanpa buka console F12
                alert("Gagal memuat daftar duet: " + (err.message || "Cek Console F12"));
            }
        };

        // Fungsi Eksekusi Hapus Pasangan Duet
        window.hapusDuet = async function(id) {
            if(!confirm("Hapus data pasangan duet kendaraan untuk tanggal ini?")) return;
            try {
                const { error } = await window.supabase
                    .from('partner_kendaraan')
                    .delete()
                    .eq('id', id);

                if(error) throw error;
                
                alert("Data pasangan berhasil dihapus bersih!");
                await window.loadDaftarDuet();
                // Refresh form penjemputan sekalian
                document.getElementById('input_driver_mobil').dispatchEvent(new Event('change'));
            } catch(err) {
                alert("Waduh, gagal menghapus data: " + err.message);
            }
        };

        window.simpanDuet = async function(e) {
            e.preventDefault();
            const btn = document.getElementById('btn-save-duet');
            btn.innerText = "Menyimpan...";
            btn.disabled = true;

            const payload = {
                tanggal: document.getElementById('duet_tanggal').value,
                mobil_id: document.getElementById('duet_mobil').value, // Simpan ID Mobil
                driver_id: document.getElementById('duet_driver').value,
                helper_id: document.getElementById('duet_helper').value,
            };
        
            try {
                const { error } = await window.supabase.from('partner_kendaraan').insert([payload]);
                if (error) throw error;

                alert("Pasangan duet & armada berhasil disimpan!");
                window.loadDaftarDuet(); // Refresh tabel bawah
            } catch (err) {
                alert("Gagal menyimpan duet: " + err.message);
            } finally {
                btn.innerText = "Simpan Pasangan";
                btn.disabled = false;
            }
        };

        // Eksekusi penarikan data rute saat halaman dimuat
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(loadTabelRute, 800); // Panggil fungsi yang benar
        });
        // ==========================================
        // 🔥 FUNGSI BROADCAST WA KONFIRMASI PENJEMPUTAN 🔥
        // ==========================================
        window.broadcastWAOperasional = function(id) {
            const j = window.allJadwalPending.find(x => String(x.id) === String(id));
            if(!j) return alert("Data jadwal tidak ditemukan!");
        
            const hp = j.mitra?.nomor_hp;
            if (!hp || hp === '-') return alert(`Nomor HP untuk mitra ${j.mitra?.nama_mitra} belum diisi di database Kemitraan!`);
        
            // Bersihkan karakter aneh pada nomor HP dan set ke 62
            let waNumber = hp.replace(/\D/g, '');
            if (waNumber.startsWith('0')) waNumber = '62' + waNumber.substring(1);
        
            // 1. Susun Rincian Estimasi (Hanya munculkan yang > 0)
            let listEstimasi = [];
            if (j.estimasi_minyak > 0) listEstimasi.push(`- Minyak Jelantah Kotor: ${j.estimasi_minyak} Kg`);
            if (j.estimasi_tepung > 0) listEstimasi.push(`- Tepung: ${j.estimasi_tepung} Kg`);
            if (j.estimasi_kriuk > 0) listEstimasi.push(`- Kriuk: ${j.estimasi_kriuk} Kg`);
            if (j.estimasi_spinner > 0) listEstimasi.push(`- Jasa Spinner: ${j.estimasi_spinner} Kg`);
            if (j.estimasi_ampas > 0) listEstimasi.push(`- Ampas: ${j.estimasi_ampas} Kg`);
        
            let textEstimasi = listEstimasi.length > 0 ? listEstimasi.join('\n') : '- (Belum ada estimasi diinput)';
        
            // 2. Format Nama Kurir/Supir
            let namaKurir = j.driver?.nama || 'Tim Bang Jelantah';
            if (j.helper?.nama) namaKurir += ` & ${j.helper.nama}`;
        
            // 3. Format Tanggal menjadi format Indo (DD/MM/YYYY)
            const tglArr = j.tanggal ? j.tanggal.split('-') : [];
            const tglIndo = tglArr.length === 3 ? `${tglArr[2]}/${tglArr[1]}/${tglArr[0]}` : j.tanggal;
        
            // 4. Nama Admin yang klik
            const adminName = window.currentUserName || 'Admin';
        
            // 5. RAKIT PESAN WHATSAPP
            const textPesan = `Halo Kak *${j.mitra?.nama_mitra || ''}*! 👋\nSaya *${adminName}* dari Bang Jelantah Purwakarta.\n\nMenginformasikan bahwa tim kami akan melakukan penjemputan pada:\n📅 Tanggal: *${tglIndo}*\n🚚 Kurir: *${namaKurir}*\n📍 Alamat: ${j.mitra?.alamat || '-'}\n\n📦 *Perkiraan Barang yang Akan Dijemput:*\n${textEstimasi}\n\nMohon ditunggu kedatangan tim kami ya Kak! 🌿\nTerima kasih sudah ikut bantu jaga lingkungan bareng Bang Jelantah Purwakarta! 💚`;
        
            // 6. Buka Tab WA
            const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(textPesan)}`;
            window.open(waLink, '_blank');
        };
    </script>
