    window.currentSalaryData = null;

    // BUKA MODAL DETAIL GAJI KARYAWAN
    window.openModalGaji = function(empId) {
        // Pakaikan String() biar tipe data Angka dan Teks bisa nyocok!
        const emp = dataKaryawan.find(k => String(k.id) === String(empId));
        
        if(!emp) {
            alert('Waduh, data karyawan gak ketemu bro! Coba refresh.');
            return;
        }

        document.getElementById('m_karyawan_id').value = emp.id;
        document.getElementById('m_nama_karyawan').innerText = emp.nama;
        document.getElementById('m_tarif_jam').value = emp.tarif_gaji_perjam || 0;

        // Cari draf slip gaji bulan ini yang statusnya masih 'Menunggu'
        const periodeSekarang = new Date().toISOString().split('T')[0];// Format: YYYY-MM--DD
        const draftSlip = (emp.slip_gaji || []).find(s => s.status === 'Menunggu' && s.periode === periodeSekarang);

        // Isi otomatis uang jalan dari kolom 'uang_jalan' draf slip gaji
        document.getElementById('m_input_uang_jalan').value = draftSlip ? (draftSlip.uang_jalan || 0) : 0;
        document.getElementById('m_check_bonus_mingguan').checked = false;

        let totalNormalJam = 0;
        let totalLemburJam = 0;
        let tepatWaktuCount = 0;

        // 1. Hitung Jam Kerja & Lembur dari Presensi
        (emp.presensi || []).forEach(p => {
            if (p.status_tiba === 'Tepat Waktu') tepatWaktuCount++;
            
            // Konversi string jam (Misal "08:30" -> 8)
            const getJam = (timeStr) => {
                if(!timeStr) return 0;
                return parseInt(timeStr.split(':')[0], 10);
            };

            let masuk = getJam(p.waktu_masuk) || 8; // Default anggap masuk jam 8
            let pulang = getJam(p.waktu_pulang) || 17; // Default anggap pulang jam 17

            // Logika Pembulatan Jam Kerja
            let batasPulangNormal = Math.min(pulang, 17); // Maksimal jam 17
            let jamKerjaNormal = Math.max(0, batasPulangNormal - masuk);
            totalNormalJam += jamKerjaNormal;

            // Logika Lembur (Di atas jam 17)
            if (pulang > 17) {
                totalLemburJam += (pulang - 17);
            }
        });

        // 2. Hitung Pengeluaran Karyawan (Hanya yang di-ACC)
        const totalPengeluaranKar = (emp.pengeluaran || [])
            .filter(peng => peng.status_approval === 'Disetujui')
            .reduce((sum, peng) => sum + Number(peng.total_harian || 0), 0);

        // 3. Simpan state untuk diakses realtime
        window.currentSalaryData = {
            empId: emp.id,
            nama: emp.nama,
            tarifNormal: emp.tarif_gaji_perjam || 0,
            tarifLembur: dataGlobalGaji?.tarif_lembur_perjam || 0,
            totalNormalJam,
            totalLemburJam,
            tepatWaktuCount,
            bonusTepatWaktu: dataGlobalGaji?.bonus_tepat_waktu || 0,
            uangKesehatan: dataGlobalGaji?.uang_kesehatan || 0,
            bonusMingguanVal: dataGlobalGaji?.bonus_mingguan || 0,
            totalPengeluaranKar
        };

        // Panggil kalkulasi UI
        kalkulasiRealtimeGaji();
        window.openModal('modal-detail-gaji');
    };

    // FUNGSI KALKULASI REAL-TIME SAAT INPUT DIUBAH
    window.kalkulasiRealtimeGaji = function() {
        const d = window.currentSalaryData;
        if(!d) return;

        const useBonusMingguan = document.getElementById('m_check_bonus_mingguan').checked;
        const uangJalan = Number(document.getElementById('m_input_uang_jalan').value) || 0;

        const hitungGajiPokok = d.totalNormalJam * d.tarifNormal;
        const hitungLembur = d.totalLemburJam * d.tarifLembur;
        const hitungTepatWaktu = d.tepatWaktuCount * d.bonusTepatWaktu;
        const hitungMingguan = useBonusMingguan ? d.bonusMingguanVal : 0;

        // TOTAL BERSIH
        const grandTotal = hitungGajiPokok + d.totalPengeluaranKar + hitungTepatWaktu + hitungLembur + hitungMingguan + d.uangKesehatan - uangJalan;
        
        // Update Objek Data untuk disave nanti
        d.grandTotal = grandTotal;
        d.potonganJalan = uangJalan;

        // Render Rincian List ke HTML
        document.getElementById('m_rincian_list').innerHTML = `
            <div class="flex justify-between"><span>Gaji Pokok (${d.totalNormalJam} Jam)</span> <span class="font-medium text-gray-900">Rp ${hitungGajiPokok.toLocaleString('id-ID')}</span></div>
            <div class="flex justify-between"><span>Pengeluaran (Di-ACC)</span> <span class="font-medium text-green-600">+ Rp ${d.totalPengeluaranKar.toLocaleString('id-ID')}</span></div>
            <div class="flex justify-between"><span>Bonus Tepat Waktu (${d.tepatWaktuCount}x)</span> <span class="font-medium text-green-600">+ Rp ${hitungTepatWaktu.toLocaleString('id-ID')}</span></div>
            <div class="flex justify-between"><span>Lembur (${d.totalLemburJam} Jam)</span> <span class="font-medium text-green-600">+ Rp ${hitungLembur.toLocaleString('id-ID')}</span></div>
            ${useBonusMingguan ? `<div class="flex justify-between"><span>Bonus Mingguan</span> <span class="font-medium text-green-600">+ Rp ${hitungMingguan.toLocaleString('id-ID')}</span></div>` : ''}
            <div class="flex justify-between border-b pb-2"><span>Uang Kesehatan (Global)</span> <span class="font-medium text-green-600">+ Rp ${d.uangKesehatan.toLocaleString('id-ID')}</span></div>
            ${uangJalan > 0 ? `<div class="flex justify-between text-red-600 pt-1"><span>Potongan Kasbon/Jalan</span> <span class="font-bold">- Rp ${uangJalan.toLocaleString('id-ID')}</span></div>` : ''}
        `;
        document.getElementById('m_total_gaji').innerText = `Rp ${grandTotal.toLocaleString('id-ID')}`;
    };

