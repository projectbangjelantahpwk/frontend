                  <i class="bi bi-pencil mr-1"></i>Edit
                </button>
                <button onclick="window.hapusData('stock_gudang_harian', ${item.id}, '${item.tanggal}')" class="px-3 py-1 text-red-600 hover:bg-red-50 border border-red-200 rounded text-sm font-medium">
                  <i class="bi bi-trash mr-1"></i>Hapus
                </button>
              </div>
            </td>
          </tr>
