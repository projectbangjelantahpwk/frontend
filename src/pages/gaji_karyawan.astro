    // ==========================================
    // ✅ PERBAIKAN EXPORT SLIP AKUMULASI FILTER
    // ✅ BONUS DIRINCI + HANYA TAMPIL YANG > 0
    // ==========================================
    window.exportSlipAkumulasiFilter = async function () {
      try {
        // 🔍 Validasi: Cek html2canvas
        if (typeof html2canvas === "undefined") {
          return alert(
            "❌ Library html2canvas belum ter-load. Silakan refresh halaman!",
          );
        }

        // 🔍 Validasi: Cek data filter
        const dataTerfilter = window.currentFilteredRiwayat;
        if (!dataTerfilter || dataTerfilter.length === 0) {
          return alert(
            "⚠️ Tidak ada data riwayat yang cocok dengan filter untuk diunduh!",
          );
        }

        // 1️⃣ Akumulasi nilai dari data ACC
        let totalGaji = 0,
          totalLembur = 0,
          totalMakan = 0,
          totalMakanMalam = 0,
          totalTransport = 0;
        let totalTalangan = 0;
        let totalBonusTepat = 0,
          totalBonusMingguan = 0,
          totalKesehatan = 0,
          totalRapat = 0,
          totalNginep = 0,
          totalBonusPenjemputan = 0;
        let totalKasbon = 0;
        let namaKaryawan = "";

        dataTerfilter.forEach((slip) => {
          const isACC =
            slip.status === "ACC" || slip.status_persetujuan === "ACC";
          if (!isACC) return;

          totalGaji += Number(slip.gaji_karyawan || 0);
          totalLembur += Number(slip.uang_lembur || 0);
          totalMakan += Number(slip.uang_makan || 0);
          totalMakanMalam += Number(slip.uang_makan_malam || 0);
          totalTransport += Number(slip.uang_transport || 0);
          totalTalangan += Number(slip.uang_talangan || 0);
          totalBonusTepat += Number(slip.bonus_tepat_waktu || 0);
          totalBonusMingguan += Number(slip.bonus_mingguan || 0);
          totalKesehatan += Number(slip.uang_kesehatan || 0);
          totalRapat += Number(slip.uang_rapat || 0);
          totalNginep += Number(slip.uang_nginep || 0);
          totalBonusPenjemputan += Number(slip.bonus_penjemputan || 0);
          totalKasbon += Number(slip.kasbon || 0);

          if (!namaKaryawan && slip.profiles?.nama) {
            namaKaryawan = slip.profiles.nama;
          }
        });

        const grandTotal =
          totalGaji +
          totalLembur +
          totalMakan +
          totalMakanMalam +
          totalTransport +
          totalTalangan +
          totalBonusTepat +
          totalBonusMingguan +
          totalKesehatan +
          totalRapat +
          totalNginep +
          totalBonusPenjemputan -
          totalKasbon;

        // 2️⃣ Suntik nilai ke template HANYA YANG > 0
        document.getElementById("slip-nama").innerText =
          `: ${namaKaryawan || "Akumulasi Filter"}`;
        document.getElementById("slip-periode").innerText =
          `: AKUMULASI (${dataTerfilter.length} Periode)`;

        const startDate =
          document.getElementById("filter-gaji-start")?.value || "-";
        const endDate =
          document.getElementById("filter-gaji-end")?.value || "-";
        document.getElementById("slip-tanggal-range").innerText =
          `: ${startDate} s/d ${endDate}`;

        document.getElementById("slip-status").innerText = `: ACC`;

        // Gaji Pokok (selalu tampil)
        document.getElementById("slip-gaji").innerText =
          `Rp ${totalGaji.toLocaleString("id-ID")}`;
        document.getElementById("slip-gaji").parentElement.style.display =
          "table-row";

        // Lembur
        const slipLembur = document.getElementById("slip-lembur");
